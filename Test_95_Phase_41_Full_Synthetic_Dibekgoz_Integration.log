def _cum(kalip,X): return [k.format(X=X) for k in kalip]
def kontrastif(kalip,pos_X,neg_X):
    HP=[_oku(t) for t in _cum(kalip,pos_X)]
    HN=[_oku(t) for t in _cum(kalip,neg_X)]
    return {li:F.normalize(torch.stack([h[li] for h in HP]).mean(0)
                         - torch.stack([h[li] for h in HN]).mean(0),dim=0)
            for li in range(N_LAYERS)}

def yigin(vlist):
    return {li:torch.stack([v[li] for v in vlist]).to(
                device=device,dtype=torch.float32).contiguous()
            for li in range(N_LAYERS)}

