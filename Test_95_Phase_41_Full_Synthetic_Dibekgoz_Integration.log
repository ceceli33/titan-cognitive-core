eos=list({tok.eos_token_id,tok.convert_tokens_to_ids("<|im_end|>"),
          tok.convert_tokens_to_ids("<|endoftext|>")}-{None,-1})

ST={"aktif":False,"pu":None,"hd":None,"iv":None,"fren":1,"pc":None,"log":None}
def _mki(li):
    def h(m,i,o):
        if not ST["aktif"] or li>=N_LAYERS: return o
        tup=isinstance(o,tuple); x=o[0] if tup else o
        od=x.dtype
        hs=x.float() if od!=torch.float32 else x
        if not hs.is_contiguous(): hs=hs.contiguous()
        B,S,_=hs.shape; bs=B*S; K=ST["pu"][li].shape[0]
        if ST["pc"] is None or ST["pc"].shape[0]!=K*bs:
            ST["pc"]=torch.zeros(K*bs,dtype=torch.float32,device=hs.device)
        st=_k.akbas_steer_v14(hs,ST["pu"][li],ST["hd"][li],ST["mercek"],ST["iv"],
                              li,float(SONUM),float(ZIRVE),float(TABAN),
                              int(ST["fren"]),ST["pc"],ST["log"])
        if od!=torch.float32: st=st.to(od)
        return (st,)+o[1:] if tup else st
    return h
_ih=[model.model.layers[li].register_forward_hook(_mki(li)) for li in range(N_LAYERS)]

@torch.no_grad()
def uret(ctx,q,pu=None,hd=None,ivmeler=None,fren=1):
    ST["aktif"]=pu is not None
    if ST["aktif"]:
        ST.update(pu=pu,hd=hd,fren=fren,pc=None,
                  iv=torch.tensor(ivmeler,dtype=torch.float32,device=device),
                  log=torch.zeros(N_LAYERS,6,dtype=torch.float32,device=device))
    p=(f"<|im_start|>system\n{ctx}<|im_end|>\n<|im_start|>user\n{q}"
       f"<|im_end|>\n<|im_start|>assistant\n")
    e=tok(p,return_tensors="pt").to(device)
    out=model.generate(**e,max_new_tokens=MAX_TOKENS,do_sample=False,
                       repetition_penalty=1.15,pad_token_id=tok.pad_token_id,
                       eos_token_id=eos)
    t_=tok.decode(out[0][e["input_ids"].shape[1]:],skip_special_tokens=True).strip()
    ST["aktif"]=False; ST["log"]=None
    return t_

def kelime(t): return len(t.split())
def bozulma(t):
    if not t.strip(): return 1.0
    tk=t.split(); n=len(tk)
    cop=sum(1 for x in tk if not re.search(r'[^\W\d_]{2,}',x))/n
    sym=len(re.findall(r'[—\[\]\|\$#~=]',t))/max(1,len(t))
    kir=sum(1 for x in tk if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]',x))/n
    return max(cop,sym*6,kir*4)
def tekrar(t,n=4):
    tk=[w.lower().strip(".,!?;:") for w in t.split()]
    if len(tk)<n*2: return 0.0
    gr=[tuple(tk[i:i+n]) for i in range(len(tk)-n+1)]
    oran=1.0-(len(set(gr))/len(gr))
    enfazla=Counter(gr).most_common(1)[0][1]
    return max(oran,min(1.0,(enfazla-1)/8.0))
def uzunluk_cokusu(t,taban_kelime):
    n=kelime(t)
    if taban_kelime<=0: return 0.0
    oran=n/taban_kelime
    return 0.0 if oran>=0.5 else min(1.0,(0.5-oran)/0.3)
def kalite(t,tk): return max(bozulma(t),tekrar(t),uzunluk_cokusu(t,tk))

KOPRU_K=["bridge","bridges","tower","towers","cable","cables","suspension",
         "span","spans","pylon","girder","roadway","golden gate"]
FIRTINA_K=["storm","stormy","thunder","thunderstorm","lightning","thunderbolt",
           "downpour","gale","tempest","squall","midnight","rain","rains"]
HEDEF_K=["ape","apes","gorilla","hominid","chimpanzee","tailless","bipedal",
         "upright","erect","two-legged","knuckle","hands","hand","fingers",
         "thumb","thumbs","grasping","grip"]
ANTI_K=["tail","tails","tailed","prehensile","quadruped","quadrupedal",
        "four-legged","all fours","snout","muzzle","paws","claws",
        "prosimian","lemur","monkey","monkeys","hooves","scales"]
FIL_K=["elephant","elephants","trunk","tusk","tusks","ivory","pachyderm","proboscis"]

def ham(t,ws):                        # HAM (normalize edilmemiş) sayım — tarihi metrik
    low=" "+t.lower()+" "; return sum(low.count(" "+w) for w in ws)
def yogun(t,ws):                      # 100 kelime başına — Aşama 16 kuralı
    n=kelime(t)
    return 0.0 if n==0 else 100.0*ham(t,ws)/n

def olc(metin,taban_kelime_ref):
    return {"kelime":kelime(metin),
            "kopru":yogun(metin,KOPRU_K),"firtina":yogun(metin,FIRTINA_K),
            "hedef":yogun(metin,HEDEF_K),"anti":yogun(metin,ANTI_K),
            "fil_ham":ham(metin,FIL_K),"fil_yogun":yogun(metin,FIL_K),
            "bozulma":bozulma(metin),"tekrar":tekrar(metin),
            "uzunluk_cokusu":uzunluk_cokusu(metin,taban_kelime_ref),
            "kalite":kalite(metin,taban_kelime_ref)}
def ozet(olculer_listesi):
    d={}
    for anahtar in olculer_listesi[0]:
        d[anahtar]=statistics.mean([o[anahtar] for o in olculer_listesi])
    d["net"]=d["hedef"]-d["anti"]
    d["sahne"]=d["kopru"]+d["firtina"]
    return d

def msk(vd,mercek): return {li:F.normalize(vd[li]*mercek,dim=0) for li in range(N_LAYERS)}

