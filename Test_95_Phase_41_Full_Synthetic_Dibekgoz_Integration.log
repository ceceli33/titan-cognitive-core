g=torch.Generator().manual_seed(SEED)
_r=F.normalize(torch.randn(D,generator=g),dim=0)
V_RAST={li:_r.clone() for li in range(N_LAYERS)}

# --- mercek (gerçek, tüm üretimlerde kullanılacak — önce kuruluyor ki fil
#     regresyonu da GERÇEK mercekle, tutarlı biçimde ölçülsün) ---
_cap.clear()
with torch.no_grad():
    _e=tok("<|im_start|>user\nDescribe what you see.<|im_end|>\n"
           "<|im_start|>assistant\n",return_tensors="pt").to(device)
    model(**_e)
H={li:_cap[li][0] for li in range(N_LAYERS)}
NORM_PROFIL={li:float(H[li].norm(dim=-1).mean()) for li in range(N_LAYERS)}
kare=torch.zeros(D)
for li in range(N_LAYERS): kare+=H[li].pow(2).mean(0)
_,dev_idx=torch.sort(kare,descending=True)
MERCEK=torch.ones(D); MERCEK[dev_idx[:MERCEK_K]]=0.0
for h in _rh: h.remove()
del H,_cap; gc.collect(); torch.cuda.empty_cache()
ST["mercek"]=MERCEK.to(device=device,dtype=torch.float32).contiguous()

P_BIR  = (yigin([msk(V_BIR,MERCEK)]),  yigin([V_BIR]))
P_FIL  = (yigin([msk(V_FIL,MERCEK)]),  yigin([V_FIL]))
P_RAST = (yigin([msk(V_RAST,MERCEK)]), yigin([V_RAST]))

# =============================================================================
#  BÖLÜM 1 — FİL REGRESYONU: HAM + YOĞUNLUK İKİLİ ÖLÇÜM
# =============================================================================
R_("="*78); R_("  1) FİL REGRESYONU — HAM (tarihi) + YOĞUNLUK (Aşama 16) İKİLİ ÖLÇÜM")
R_("="*78)
TABAN_ZOO_METIN=[uret(CTX_ZOO,q) for q in SOR_ZOO]
TABAN_ZOO_KELIME=[kelime(x) for x in TABAN_ZOO_METIN]
FIL_METIN=[uret(CTX_ZOO,q,pu=P_FIL[0],hd=P_FIL[1],ivmeler=[0.15]) for q in SOR_ZOO]
olc_fil=[olc(FIL_METIN[i],TABAN_ZOO_KELIME[i]) for i in range(len(SOR_ZOO))]
R_(f"    {'prompt#':<10}{'kelime':>8}{'fil_HAM':>10}{'fil_yoğun':>11}")
R_("    "+"-"*40)
for i,o in enumerate(olc_fil):
    R_(f"    {i:<10}{o['kelime']:>8}{o['fil_ham']:>10.1f}{o['fil_yogun']:>11.2f}")
ozet_fil=ozet(olc_fil)
R_(f"\n    ORTALAMA        ham={ozet_fil['fil_ham']:.2f}   yoğun={ozet_fil['fil_yogun']:.2f}")
R_(f"    [Aşama 12/14 tarihi referansı: fil=8.2 — HAM sayımla ölçülmüştü]")
if ozet_fil['fil_ham']>=6.0:
    R_("    ✅ HAM sayı tarihi referansa yakın — 'regresyon' bir birim uyuşmazlığıymış,")
    R_("       boru sağlam. Aşama 17/18'in 3.40-4.30 değerleri yoğunluk birimindeydi,")
    R_("       doğrudan 8.2 ile kıyaslanamazdı.")
elif ozet_fil['fil_ham']>=4.0:
    R_("    ⚠️ HAM sayı kısmen düştü — birim uyuşmazlığı sorunun bir kısmını açıklıyor")
    R_("       ama tam değil; gerçek bir zayıflama da olabilir.")
else:
    R_("    ❌ HAM sayı da düşük — bu birim uyuşmazlığı değil, gerçek bir regresyon.")
R_("")

# =============================================================================
#  BÖLÜM 2 — TABAN: KÖPRÜ/FIRTINA + YARATIK (hedef/anti) YOĞUNLUĞU
# =============================================================================
R_("="*78); R_("  2) TABAN (enjeksiyonsuz), 10 köprü promptu — SAHNE + YARATIK NET")
R_("="*78)
t0=time.time()
TABAN_METIN=[uret(CTX_BRIDGE,q) for q in P_TETIK]
TABAN_KELIME=[kelime(x) for x in TABAN_METIN]
olc_taban=[olc(TABAN_METIN[i],TABAN_KELIME[i]) for i in range(len(P_TETIK))]
ozet_taban=ozet(olc_taban)
R_(f"    köprü={ozet_taban['kopru']:.1f}  fırtına={ozet_taban['firtina']:.1f}  "
   f"SAHNE={ozet_taban['sahne']:.1f}")
R_(f"    hedef(yaratık)={ozet_taban['hedef']:.2f}  anti={ozet_taban['anti']:.2f}  "
   f"NET={ozet_taban['net']:+.2f}")
R_(f"    [önceki turlarda TABAN'ın yaratık NET'i hiç ölçülmemişti — bu satır referans]")
R_(f"  ✅ {time.time()-t0:.0f} sn\n")

# =============================================================================
#  BÖLÜM 3 — DAR BANT İVME TARAMASI {0.10,0.105,0.11,0.115,0.12}
#  Üç kol yan yana: TABAN (sabit, yukarıda ölçüldü) / RASTGELE / BİRLEŞİK
# =============================================================================
R_("="*78); R_("  3) DAR BANT İVME TARAMASI — TABAN / RASTGELE / BİRLEŞİK yaratık-NET")
R_("="*78)
R_(f"    {'kol':<16}{'kelime':>8}{'SAHNE':>7}{'hedef':>7}{'anti':>6}{'NET':>7}{'KALİTE':>8}")
R_("    "+"-"*60)
R_(f"    {'TABAN':<16}{ozet_taban['kelime']:>8.0f}{ozet_taban['sahne']:>7.1f}"
   f"{ozet_taban['hedef']:>7.2f}{ozet_taban['anti']:>6.2f}{ozet_taban['net']:>+7.2f}"
   f"{ozet_taban['kalite']:>8.3f}   (sabit, enjeksiyonsuz)")
SONUC_IVME={}
_esik_gecildi=None
t0=time.time()
for ivme in DAR_BANT_IVME:
    metin_bir=[uret(CTX_BRIDGE,q,pu=P_BIR[0],hd=P_BIR[1],ivmeler=[ivme]) for q in P_TETIK]
    metin_rast=[uret(CTX_BRIDGE,q,pu=P_RAST[0],hd=P_RAST[1],ivmeler=[ivme]) for q in P_TETIK]
    olc_bir=[olc(metin_bir[i],TABAN_KELIME[i]) for i in range(len(P_TETIK))]
    olc_rast=[olc(metin_rast[i],TABAN_KELIME[i]) for i in range(len(P_TETIK))]
    ozet_bir=ozet(olc_bir); ozet_rast=ozet(olc_rast)
    SONUC_IVME[ivme]={"bir":ozet_bir,"rast":ozet_rast,
                       "bir_metinler":metin_bir,"rast_metinler":metin_rast}
    ad_b=f"BIR_i{ivme:.3f}"; ad_r=f"RAST_i{ivme:.3f}"
    R_(f"    {ad_b:<16}{ozet_bir['kelime']:>8.0f}{ozet_bir['sahne']:>7.1f}"
       f"{ozet_bir['hedef']:>7.2f}{ozet_bir['anti']:>6.2f}{ozet_bir['net']:>+7.2f}"
       f"{ozet_bir['kalite']:>8.3f}")
    R_(f"    {ad_r:<16}{ozet_rast['kelime']:>8.0f}{ozet_rast['sahne']:>7.1f}"
       f"{ozet_rast['hedef']:>7.2f}{ozet_rast['anti']:>6.2f}{ozet_rast['net']:>+7.2f}"
       f"{ozet_rast['kalite']:>8.3f}")
    if _esik_gecildi is None and ozet_bir['kalite']>0.15:
        _esik_gecildi=ivme
R_(f"\n    [Aşama 18 referansı: i0.10 kalite=0.084 | i0.12 kalite=0.390]")
if _esik_gecildi is not None:
    R_(f"    ⚠️ kalite 0.15 eşiği ilk kez ivme={_esik_gecildi:.3f}'te aşıldı — güvenli üst")
    R_(f"       sınır olarak bundan bir önceki taranan değeri kullan")
else:
    R_(f"    ✅ {DAR_BANT_IVME[0]:.3f}-{DAR_BANT_IVME[-1]:.3f} aralığının tamamı eşiğin altında")

R_(f"\n    YARATIK NET KARŞILAŞTIRMASI (TABAN vs RASTGELE vs BİRLEŞİK):")
R_(f"    TABAN NET     = {ozet_taban['net']:+.2f}  (enjeksiyonsuz taban gürültüsü)")
for ivme in DAR_BANT_IVME:
    b=SONUC_IVME[ivme]["bir"]["net"]; r=SONUC_IVME[ivme]["rast"]["net"]
    fark_b=b-ozet_taban['net']; fark_r=r-ozet_taban['net']
    R_(f"    i={ivme:.3f}   BIR NET={b:+.2f} (Δtaban={fark_b:+.2f})   "
       f"RAST NET={r:+.2f} (Δtaban={fark_r:+.2f})")
_bir_netler=[SONUC_IVME[i]["bir"]["net"] for i in DAR_BANT_IVME]
_rast_netler=[SONUC_IVME[i]["rast"]["net"] for i in DAR_BANT_IVME]
if statistics.mean(_bir_netler)>statistics.mean(_rast_netler)+0.3 and \
   statistics.mean(_bir_netler)>ozet_taban['net']+0.3:
    R_("\n    ✅ BİR'in yaratık NET'i hem TABAN'dan hem RASTGELE'den ayrışıyor — bu doz")
    R_("       aralığında yaratık bileşeni gerçek bir sinyal.")
else:
    R_("\n    ⚠️ BİR'in yaratık NET'i TABAN/RASTGELE gürültüsünden net ayrışmıyor —")
    R_("       bu doz aralığında SAHNE (köprü/fırtına) taşınıyor ama yaratık bileşeni")
    R_("       zayıf/görünmüyor olabilir. Daha yüksek ivme (kalite izin verdiği ölçüde)")
    R_("       veya yaratık ekseninin ayrı ölçülmesi (Aşama 14'teki DIBEK tek-eksen)")
    R_("       gerekebilir.")
R_(f"  ✅ dar bant taraması {time.time()-t0:.0f} sn\n")

