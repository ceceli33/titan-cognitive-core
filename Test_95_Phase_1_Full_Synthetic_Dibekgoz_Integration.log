# =============================================================================
# MODEL YÜKLEME
# =============================================================================
print("Model yükleniyor (bf16, sdpa, kuantizasyon yok)...")
tok = AutoTokenizer.from_pretrained(MODEL_ID)
if tok.pad_token is None:
    tok.pad_token = tok.eos_token
model = AutoModelForCausalLM.from_pretrained(
    MODEL_ID, device_map="auto", trust_remote_code=True,
    low_cpu_mem_usage=True, dtype=torch.bfloat16, attn_implementation="sdpa")
model.eval()
device = next(model.parameters()).device
HIDDEN = model.config.hidden_size
N_LAYERS = model.config.num_hidden_layers
print(f"✅ Model hazır. Katman: {N_LAYERS}  |  Gizli boyut: {HIDDEN}  |  dtype: {model.dtype}")
print(f"   Hedef katmanlar: L{TARGET_LAYERS[0]}..L{TARGET_LAYERS[-1]} ({len(TARGET_LAYERS)} katman)\n")

assert max(TARGET_LAYERS) < N_LAYERS, "Hedef katman model derinliğini aşıyor!"

# =============================================================================
# HOOK ALTYAPISI — sadece OKUMA, hiçbir değişiklik yok
# =============================================================================
_captured = {}

def _make_hook(layer_idx):
    def _hook(module, inputs, output):
        # Qwen decoder layer çıktısı tuple; ilk eleman hidden states
        h = output[0] if isinstance(output, tuple) else output
        # [batch, seq, hidden] -> fp32'ye çevir (hassasiyet için), CPU'ya al
        _captured[layer_idx] = h.detach().to(torch.float32).cpu()
    return _hook

_handles = []
for li in TARGET_LAYERS:
    _handles.append(model.model.layers[li].register_forward_hook(_make_hook(li)))
print(f"✅ {len(_handles)} adet OKUMA hook'u kuruldu (yazma yok).\n")

@torch.no_grad()
def probe(text):
    """Tek bir cümleyi işler, L6-L15 gizli durumlarını döndürür.
    Hem son-token hem de ortalama-token temsili alınır."""
    _captured.clear()
    enc = tok(text, return_tensors="pt").to(device)
    model(**enc)
    out_last, out_mean = {}, {}
    for li in TARGET_LAYERS:
        h = _captured[li][0]            # [seq, hidden]
        out_last[li] = h[-1].clone()    # son token
        out_mean[li] = h.mean(dim=0)    # tüm token ortalaması
    return out_last, out_mean

# =============================================================================
# SONDALAMA — 5 eksen x (8 pozitif + 8 negatif) x 10 katman
# =============================================================================
axes_last = {}   # eksen -> {katman: vektör}
axes_mean = {}
raw_stats = {}

t_start = time.time()
for ax_name, ax in AXES.items():
    print(f"{'='*70}\n  EKSEN: {ax_name}  ({ax['rol']})\n{'='*70}")
    acc = {"pos_last": {li: [] for li in TARGET_LAYERS},
           "neg_last": {li: [] for li in TARGET_LAYERS},
           "pos_mean": {li: [] for li in TARGET_LAYERS},
           "neg_mean": {li: [] for li in TARGET_LAYERS}}

    for kind, sents in (("pos", ax["pozitif"]), ("neg", ax["negatif"])):
        for i, s in enumerate(sents, 1):
            last, mean = probe(s)
            for li in TARGET_LAYERS:
                acc[f"{kind}_last"][li].append(last[li])
                acc[f"{kind}_mean"][li].append(mean[li])
            print(f"  [{kind}] {i}/{len(sents)} işlendi", end="\r")
        print(f"  [{kind}] {len(sents)}/{len(sents)} tamamlandı.      ")

    # Fark-of-ortalamalar (difference-in-means)
    v_last, v_mean = {}, {}
    stats = {}
    for li in TARGET_LAYERS:
        p_l = torch.stack(acc["pos_last"][li]).mean(0)
        n_l = torch.stack(acc["neg_last"][li]).mean(0)
        p_m = torch.stack(acc["pos_mean"][li]).mean(0)
        n_m = torch.stack(acc["neg_mean"][li]).mean(0)
        d_l, d_m = p_l - n_l, p_m - n_m
        v_last[li], v_mean[li] = d_l, d_m
        # Ayrışma ölçüsü: pozitif ve negatif kümelerin içsel dağılımına göre
        # fark ne kadar büyük? (yüksek = eksen temiz ayrışmış)
        spread = (torch.stack(acc["pos_last"][li]).std(0).mean()
                  + torch.stack(acc["neg_last"][li]).std(0).mean()) / 2
        stats[li] = {
            "fark_normu_last": float(d_l.norm()),
            "fark_normu_mean": float(d_m.norm()),
            "kume_ici_yayilim": float(spread),
            "ayrisma_orani": float(d_l.norm() / (spread * (HIDDEN ** 0.5) + 1e-9)),
            "pos_norm": float(p_l.norm()), "neg_norm": float(n_l.norm()),
        }
    axes_last[ax_name], axes_mean[ax_name] = v_last, v_mean
    raw_stats[ax_name] = stats

    print(f"  Katman bazlı fark normu (last-token):")
    for li in TARGET_LAYERS:
        st = stats[li]
        print(f"    L{li:<3} |v|={st['fark_normu_last']:8.3f}  "
              f"yayılım={st['kume_ici_yayilim']:6.3f}  "
              f"ayrışma={st['ayrisma_orani']:.4f}")
    print()

for h in _handles:
    h.remove()
print(f"✅ Tüm hook'lar kaldırıldı. Sondalama süresi: {time.time()-t_start:.1f} sn\n")

# =============================================================================
# TANI RAPORU — eksenler birbirinden gerçekten ayrı mı?
# =============================================================================
def cos(a, b):
    return float(torch.nn.functional.cosine_similarity(a.unsqueeze(0), b.unsqueeze(0)))

print(f"{'='*70}\n  TANI 1: EKSENLER ARASI KOSİNÜS (last-token)\n{'='*70}")
print("  Düşük |cos| = eksenler bağımsız (İYİ). Yüksek = çakışma var (Aşama 3'te")
print("  Gram-Schmidt bunu zaten temizleyecek, ama büyük çakışma bilgi kaybı demek.\n")

names = list(AXES.keys())
cross = {}
for li in [TARGET_LAYERS[0], TARGET_LAYERS[len(TARGET_LAYERS)//2], TARGET_LAYERS[-1]]:
    print(f"  --- L{li} ---")
    hdr = "         " + "".join(f"{n[:9]:>11}" for n in names)
    print(hdr)
    for a in names:
        row = f"  {a[:8]:<8}"
        for b in names:
            c = cos(axes_last[a][li], axes_last[b][li])
            cross[f"L{li}:{a}|{b}"] = c
            row += f"{c:>+11.3f}"
        print(row)
    print()

print(f"{'='*70}\n  TANI 2: KATMANLAR ARASI TUTARLILIK (aynı eksen, L6 vs LN)\n{'='*70}")
print("  Yüksek cos = eksen katmanlar boyunca kararlı (İYİ, tek yön var).")
print("  Düşük/negatif = eksen katman değiştikçe dönüyor (dikkat gerektirir).\n")
layer_consistency = {}
for a in names:
    base = axes_last[a][TARGET_LAYERS[0]]
    vals = [cos(base, axes_last[a][li]) for li in TARGET_LAYERS]
    layer_consistency[a] = vals
    s = "  ".join(f"L{li}:{v:+.2f}" for li, v in zip(TARGET_LAYERS, vals))
    print(f"  {a:<11} {s}")
print()

print(f"{'='*70}\n  TANI 3: EN GÜÇLÜ SİNYAL HANGİ KATMANDA?\n{'='*70}")
print("  Ayrışma oranı en yüksek katman = o eksen için en 'temiz' sonda noktası.\n")
best_layers = {}
for a in names:
    best = max(TARGET_LAYERS, key=lambda li: raw_stats[a][li]["ayrisma_orani"])
    best_layers[a] = best
    print(f"  {a:<11} en güçlü: L{best}  "
          f"(ayrışma={raw_stats[a][best]['ayrisma_orani']:.4f})")
print()

# =============================================================================
# KAYDET
# =============================================================================
payload = {
    "model_id": MODEL_ID,
    "hidden_size": HIDDEN,
    "target_layers": TARGET_LAYERS,
    "axis_names": names,
    "axis_roles": {a: AXES[a]["rol"] for a in names},
    "axes_last": {a: {li: axes_last[a][li] for li in TARGET_LAYERS} for a in names},
    "axes_mean": {a: {li: axes_mean[a][li] for li in TARGET_LAYERS} for a in names},
    "prompts": {a: {"pozitif": AXES[a]["pozitif"], "negatif": AXES[a]["negatif"]}
                for a in names},
    "stats": raw_stats,
    "cross_cosine": cross,
    "layer_consistency": layer_consistency,
    "best_layers": best_layers,
    "note": ("AŞAMA 1 çıktısı. Bunlar HAM kontrastif fark vektörleri -- henüz "
             "normalize edilmedi, ortogonalize edilmedi, hiçbir yere enjekte "
             "edilmedi. Dibekgoz çekirdeği burada YOK (Aşama 3'te sentetik "
             "olarak inşa edilecek). 'kuyruk' ekseni İTİCİ olarak ters "
             "işaretle kullanılacak."),
}
torch.save(payload, OUT_PT)
print(f"✅ Eksenler kaydedildi: {OUT_PT}")

json_report = {k: v for k, v in payload.items()
               if k not in ("axes_last", "axes_mean")}
with open(OUT_JSON, "w", encoding="utf-8") as f:
    json.dump(json_report, f, ensure_ascii=False, indent=2)
print(f"✅ Tanı raporu kaydedildi: {OUT_JSON}")

try:
    from google.colab import files as _cf
    _cf.download(OUT_PT); _cf.download(OUT_JSON)
except Exception:
    print("ℹ️ Dosyaları /content/ altından elle indirebilirsiniz.")

print(f"\n{'='*70}")
print("🏁 AŞAMA 1/6 TAMAMLANDI — hiçbir enjeksiyon yapılmadı, sadece okuma.")
print("   Sonraki adım (Aşama 2): bu tanı çıktılarını birlikte yorumlayıp")
print("   hangi eksenlerin sağlam, hangilerinin zayıf olduğuna karar vermek.")
print(f"{'='*70}")
