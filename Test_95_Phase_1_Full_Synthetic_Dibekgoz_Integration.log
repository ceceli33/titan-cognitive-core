# =============================================================================
# TEST 95 — AŞAMA 1/6: KONTRASTİF SONDALAMA (PROBING)
# =============================================================================
# BU AŞAMADA HİÇBİR ENJEKSİYON YOK. Tek iş: modelin kendi gizli katmanlarından
# (L6-L15) 5 kavramsal ekseni kontrastif fark vektörü olarak SÖKÜP ALMAK ve
# .pt dosyasına kaydetmek.
#
# Yöntem: her eksen için N adet pozitif ve N adet negatif cümle. Model bunları
# işlerken L6-L15'in residual stream çıktısı yakalanır. Eksen vektörü:
#     v_axis[L] = mean(pozitif hidden[L]) - mean(negatif hidden[L])
# Bu, literatürdeki "difference-in-means" yöntemidir (Marks & Tegmark, CAA).
# Dibekgoz'un KENDİSİ burada çekilmiyor -- modelde o token yok. O, Aşama 3'te
# sentetik olarak inşa edilecek. Burada sadece onu TAŞIYACAK anatomik iskele
# çekiliyor.
#
# ÇIKTI: dibekgoz_eksenler_asama1.pt  +  ekrana tanı raporu
# =============================================================================

import os, gc, json, time
import torch
from transformers import AutoModelForCausalLM, AutoTokenizer

os.environ["TOKENIZERS_PARALLELISM"] = "false"
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False

MODEL_ID    = "Qwen/Qwen2.5-7B-Instruct"
TARGET_LAYERS = list(range(6, 16))      # L6..L15 (10 katman)
OUT_PT      = "/content/dibekgoz_eksenler_asama1.pt"
OUT_JSON    = "/content/dibekgoz_asama1_rapor.json"

print(f"torch: {torch.__version__}  |  CUDA: {torch.version.cuda}")
if not torch.cuda.is_available():
    raise SystemExit("❌ GPU yok. Runtime → Change runtime type → A100.")
print(f"✅ GPU: {torch.cuda.get_device_name(0)} "
      f"({torch.cuda.get_device_properties(0).total_memory/1e9:.1f}GB)\n")

# =============================================================================
# 5 EKSEN — KONTRASTİF CÜMLE ÇİFTLERİ
# =============================================================================
# Her eksen için 8 pozitif + 8 negatif. Çoklu cümle, tek cümlenin kendine özgü
# gürültüsünü ortalamayla bastırmak için. Cümleler düz metin (chat şablonu yok)
# çünkü şablon token'ları kavramsal sinyali sulandırır.

AXES = {
    "biyolojik": {
        "rol": "V6 — Taksonomi çekicisi: canlı/organik uzayı tetikler",
        "pozitif": [
            "A living organism with cells, tissues, and a beating heart.",
            "A biological creature that breathes, eats, and grows.",
            "A warm-blooded animal with flesh, blood, and bone.",
            "A living being born from a mother and capable of reproduction.",
            "An organic life form with muscles, skin, and a nervous system.",
            "A creature of flesh and blood that ages and eventually dies.",
            "A living animal whose body is made of organic tissue.",
            "A breathing, metabolizing biological entity found in nature.",
        ],
        "negatif": [
            "A lifeless object made of metal, plastic, and wire.",
            "An inanimate machine with gears, circuits, and no biology.",
            "An abstract mathematical concept with no physical body.",
            "A manufactured tool assembled in a factory from parts.",
            "A non-living artifact carved from stone and never alive.",
            "A synthetic construct of steel that has no cells or organs.",
            "A rigid mechanical device that cannot grow or reproduce.",
            "An artificial object with no metabolism and no life.",
        ],
    },
    "primat": {
        "rol": "V7-V8 — Familya/morfoloji: primat ve goril uzayına çeker",
