        ],
    },
    "eller": {
        "rol": "V10 — Üst ekstremite: kavrayan iki el, parmaklar",
        "pozitif": [
            "It has two hands with fingers that can grip and hold objects.",
            "A creature with dexterous hands and an opposable thumb.",
            "Its two upper limbs end in five-fingered grasping hands.",
