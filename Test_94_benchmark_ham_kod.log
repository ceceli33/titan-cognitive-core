import re as _re

def _score_mmlu(choices, correct_idx, generated_text):
    letters = ["A", "B", "C", "D"]
    m = _re.search(r"\b([ABCD])\b", generated_text.strip().upper())
    return (m.group(1) == letters[correct_idx]) if m else False

def _extract_gsm8k_answer(answer_field):
    m = _re.search(r"####\s*(-?[\d,\.]+)", answer_field)
    return m.group(1).replace(",", "").strip() if m else None

def _score_gsm8k(generated_text, reference_answer):
    nums = _re.findall(r"-?\d+\.?\d*", generated_text.replace(",", ""))
    if not nums or reference_answer is None: return False
    try:
        return abs(float(nums[-1]) - float(reference_answer)) < 1e-6
    except Exception:
        return nums[-1].strip() == reference_answer.strip()

from datasets import load_dataset
_mmlu_ds = load_dataset("cais/mmlu", "all", split="test")
_mmlu_ds = _mmlu_ds.shuffle(seed=RANDOM_SEED).select(range(min(N_MMLU, len(_mmlu_ds))))
_gsm8k_ds = load_dataset("openai/gsm8k", "main", split="test")
_gsm8k_ds = _gsm8k_ds.shuffle(seed=RANDOM_SEED).select(range(min(N_GSM8K, len(_gsm8k_ds))))
print(f"✅ MMLU: {len(_mmlu_ds)}  |  GSM8K: {len(_gsm8k_ds)}  (seed={RANDOM_SEED})")

_mmlu_correct = 0; _mmlu_total = 0
_gsm8k_correct = 0; _gsm8k_total = 0
_part_b_skipped = 0

print(f"\n{'='*70}\n  MMLU ({len(_mmlu_ds)}) işleniyor... (max_tokens={MMLU_MAX_TOKENS})\n{'='*70}")
for i, item in enumerate(_mmlu_ds, 1):
    q = (f"{item['question']}\nA) {item['choices'][0]}\nB) {item['choices'][1]}\n"
         f"C) {item['choices'][2]}\nD) {item['choices'][3]}\nAnswer with only the letter.")
    try:
        txt_s, *_ = run_with_timeout(PART_B_TIMEOUT_SEC, _steer_only, q, MMLU_MAX_TOKENS)
        _mmlu_total += 1
        if _score_mmlu(item["choices"], item["answer"], txt_s): _mmlu_correct += 1
        if i % 50 == 0 or i == len(_mmlu_ds):
            print(f"  {i}/{len(_mmlu_ds)}  steered={_mmlu_correct}/{_mmlu_total} "
                  f"({100.0*_mmlu_correct/_mmlu_total:.1f}%)")
    except Exception as e:
        _part_b_skipped += 1
        print(f"  ⏭️ MMLU {i} atlandı: {e}")
    gc.collect()
    if torch.cuda.is_available(): torch.cuda.empty_cache()

print(f"\n{'='*70}\n  GSM8K ({len(_gsm8k_ds)}) işleniyor... (max_tokens={GSM8K_MAX_TOKENS})\n{'='*70}")
for i, item in enumerate(_gsm8k_ds, 1):
    q = (f"{item['question']}\nShow brief reasoning, then give the final numeric answer "
         f"on the last line, prefixed with 'Answer:'.")
    reference = _extract_gsm8k_answer(item["answer"])
    try:
        txt_s, *_ = run_with_timeout(PART_B_TIMEOUT_SEC, _steer_only, q, GSM8K_MAX_TOKENS)
        _gsm8k_total += 1
        if _score_gsm8k(txt_s, reference): _gsm8k_correct += 1
        if i % 20 == 0 or i == len(_gsm8k_ds):
            print(f"  {i}/{len(_gsm8k_ds)}  steered={_gsm8k_correct}/{_gsm8k_total} "
                  f"({100.0*_gsm8k_correct/_gsm8k_total:.1f}%)")
    except Exception as e:
        _part_b_skipped += 1
        print(f"  ⏭️ GSM8K {i} atlandı: {e}")
    gc.collect()
    if torch.cuda.is_available(): torch.cuda.empty_cache()

def _pct(c, t): return f"{100.0*c/t:.1f}%" if t > 0 else "n/a"
_summary_b = (
    f"\n{'='*70}\n  BÖLÜM B SONUÇLARI (SADECE STEERED, TAM İZOLE)\n{'='*70}\n"
    f"MMLU (N={_mmlu_total}): {_mmlu_correct}/{_mmlu_total} ({_pct(_mmlu_correct,_mmlu_total)})\n"
    f"GSM8K (N={_gsm8k_total}, max_tokens={GSM8K_MAX_TOKENS}): "
    f"{_gsm8k_correct}/{_gsm8k_total} ({_pct(_gsm8k_correct,_gsm8k_total)})\n"
    f"Atlanan: {_part_b_skipped}\n{'='*70}\n"
)
