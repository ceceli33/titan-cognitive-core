_compass = core._anayasa.view(1, -1).contiguous()
_alphas  = torch.tensor([DEFAULT_IVME], dtype=torch.float32)
_centers = torch.tensor([0.0], dtype=torch.float32)
_widths  = torch.tensor([0.0], dtype=torch.float32)

def _steer_only(question, max_tokens):
    """SADECE steered pass -- vanilla/observe hiç çağrılmıyor."""
    prompt_text = (f"<|im_start|>system\nYou are a helpful, accurate, and thoughtful "
                   f"assistant.<|im_end|>\n<|im_start|>user\n{question.strip()}"
                   f"<|im_end|>\n<|im_start|>assistant\n")
    inp = core.tok(prompt_text, return_tensors="pt").to(core.device)
    txt_s, ms_s, tps_s, n_in_s, n_out_s, lb_s, cnt_s = core._run_pass(
        inp, max_tokens, "steer", _compass, _alphas, _centers, _widths,
        DEFAULT_SONUM, DEFAULT_ZIRVE, DEFAULT_TABAN, DEFAULT_ATTRACTOR, TEMPERATURE)
    return txt_s, ms_s, tps_s, n_in_s, n_out_s, lb_s, cnt_s

def _fmt_pass(label, txt, ms, tps, n_in, n_out, lb, cnt, n_layers):
    W = 64
    lines = ["="*W, f"  {label}", "="*W,
             f"  ⏱ {ms:.0f} ms | {tps:.1f} tok/s | {n_in} in | {n_out} out tokens",
             "-"*W, f"  {'L':>3} {'cos(θ)':>9} {'kb':>8} {'kv':>8} {'katki':>10}", "-"*W]
    cos_vals = []; kat_vals = []
    for i in range(n_layers):
        if cnt[i].item() <= 0: continue
        cs, kb, kv, kat = lb[0][i].tolist()
        cos_vals.append(cs); kat_vals.append(kat)
        lines.append(f"  {i:>3} {cs:>+9.4f} {kb:>8.5f} {kv:>8.5f} {kat:>+10.6f}")
    if cos_vals:
        lines.append(f"  drift(cos) L0->L{n_layers-1}: {cos_vals[-1]-cos_vals[0]:+.4f}  |  "
                      f"katki toplamı={sum(kat_vals):+.6f}")
    lines.append("="*W)
    return txt + "\n\n" + "\n".join(lines)

