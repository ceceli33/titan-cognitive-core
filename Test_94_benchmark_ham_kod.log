def _pip(pkg, no_deps=False):
    cmd = [sys.executable,"-m","pip","install",pkg,"-q"]
    if no_deps:
        cmd.append("--no-deps")
    subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

