# =============================================================================
# 10. FIXED CANDIDATE ATLAS
#
# Candidate ID itself will NEVER be a scorer feature.
#
# Same atlas across TRAIN/DEV/BLIND is necessary:
# sensor must score the same physical correction directions on new states.
# =============================================================================

print("\n[4/24] Candidate tangent atlas...")

ATLAS = {}

theta = math.radians(
    REQUESTED_SHELL_DEG
)

for li in SOURCE_LAYERS:

    v = normalize(
        DIBEK[li]
    )

    ATLAS[li] = []

    for cid in range(
        N_CANDIDATES
    ):

        g = torch.Generator(
            device="cpu"
        )

        g.manual_seed(
            SEED
            + 100000 * li
            + cid
        )

        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )

        u = (
            z
            - torch.dot(z, v) * v
        )

        u = normalize(u)

        q = normalize(
            math.cos(theta) * v
            + math.sin(theta) * u
        )

        ATLAS[li].append({
            "candidate_id":
                cid,

            "u":
                u,

            "q":
                q,
        })

print(
    f"{len(SOURCE_LAYERS)} layers × "
    f"{N_CANDIDATES} candidates"
)


# =============================================================================
# 11. BASELINE STATE CAPTURE
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(
            module,
            inp,
            out,
        ):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(
            VECTOR_LAYERS
        ):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. PHYSICAL INTERVENTION
# =============================================================================

@torch.no_grad()
def one_step_probe(
    prompt,
    baseline,
    li,
    direction,
):

    target = li + 1

    q = normalize(direction)

    src_base = (
        baseline[li]
        .float()
    )

    requested_norm = (
        PROBE_REL
        * float(
            torch.linalg.vector_norm(
                src_base
            )
        )
    )

    q_gpu = q.to(device)

    source_delta = {}
    target_cap = {}

    handles = []

    def source_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        before = (
            h[0, -1]
            .float()
        )

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        source_delta["x"] = (
            hnew[0, -1]
            .float()
            - before
        ).detach().cpu().clone()

        if isinstance(out, tuple):

            return (
                (hnew,)
                + out[1:]
            )

        return hnew

    def target_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        target_cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    x = source_delta["x"]

    y = (
        target_cap["h"]
        - baseline[target]
    )

    xnorm = float(
        torch.linalg.vector_norm(x)
    )

    srcnorm = float(
        torch.linalg.vector_norm(
            src_base
        )
    )

    return {
        "x":
            x,

        "y":
            y,

        "D_next":
            cosine(
                y,
                DIBEK[target],
            ),

        "D_old":
            cosine(
                y,
                DIBEK[li],
            ),

        "realized_rel":
            xnorm
            / (srcnorm + EPS),

        "dir_cos":
            cosine(
                x,
                q,
            ),
    }


# =============================================================================
# 13. FEATURE FUNCTION
#
# NO candidate ID.
#
# We intentionally use compact relational features.
#
# h = current baseline state
# v = historical semantic compass
# u = candidate tangent
# q = full candidate direction
#
# Features:
#
#  0 bias
#  1 cos(h,v)
#  2 cos(h,u)
#  3 cos(h,q)
#  4 dot(normalized h, u) * dot(normalized h, v)
#  5 |cos(h,u)|
#  6 signed projection of state residual from v onto u
#  7 state log norm
#  8 adjacent dictionary cosine cos(v_l,v_l+1)
#  9 cos(u, v_l+1)
# 10 cos(q, v_l+1)
# 11 cos(u, r_next)
# 12 cos(q, r_next)
#
# r_next:
#
#   component of v_(l+1) orthogonal to v_l
#
# This does NOT use candidate outcome.
# =============================================================================

FEATURE_NAMES = [
    "bias",
    "h_v",
    "h_u",
    "h_q",
    "h_u_x_h_v",
    "abs_h_u",
    "state_residual_u",
    "log_h_norm",
    "dict_adjacent_cos",
    "u_vnext",
    "q_vnext",
    "u_rnext",
    "q_rnext",
]


def feature_vector(
    h,
    li,
    candidate,
):

    h = h.float()

    hn = normalize(h)

    v = normalize(
        DIBEK[li]
    )

    vn = normalize(
        DIBEK[li + 1]
    )

    u = normalize(
        candidate["u"]
    )

    q = normalize(
        candidate["q"]
    )

    hv = cosine(
        hn,
        v,
    )

    hu = cosine(
        hn,
        u,
    )

    hq = cosine(
        hn,
        q,
    )

    c = float(
        torch.dot(v, vn)
    )

    raw_r = (
        vn
        - c * v
    )

    rnext = normalize(
        raw_r
    )

    if rnext is None:

        ur = 0.0
        qr = 0.0

    else:

        ur = cosine(
            u,
            rnext,
        )

        qr = cosine(
            q,
            rnext,
        )

    # state component orthogonal to semantic seed
    h_res = (
        hn
        - torch.dot(hn, v) * v
    )

    state_residual_u = float(
        torch.dot(
            h_res,
            u,
        )
    )

    hnorm = float(
        torch.linalg.vector_norm(h)
    )

    return np.asarray(
        [
            1.0,
            hv,
            hu,
            hq,
            hu * hv,
            abs(hu),
            state_residual_u,
            math.log(hnorm + EPS),
            c,
            cosine(u, vn),
            cosine(q, vn),
            ur,
            qr,
        ],
        dtype=np.float64,
    )


# =============================================================================
# 14. COLLECT TRAIN + DEV OUTCOMES
#
# BLIND is NOT physically scanned yet.
# =============================================================================

print("\n[5/24] TRAIN + DEV candidate outcomes toplanıyor...")

SYSTEM_PROMPTS = (
    TRAIN_PROMPTS
    + DEV_PROMPTS
)

SYSTEM_SPLITS = (
    ["TRAIN"] * N_TRAIN
    + ["DEV"] * N_DEV
)

SYSTEM_DATA = []

start = time.time()

for pi, prompt in enumerate(
    SYSTEM_PROMPTS
):

    split = SYSTEM_SPLITS[pi]

    base = baseline_pass(
        prompt
    )

    prow = {
        "prompt_index":
            pi,

        "split":
            split,

        "prompt":
            prompt,

        "layers":
            {},
    }

    for li in SOURCE_LAYERS:

        fixed = one_step_probe(
            prompt,
            base,
            li,
            DIBEK[li],
        )

        layer = {
            "state":
                base[li],

            "fixed_D":
                fixed["D_next"],

            "fixed_x":
                fixed["x"],

            "candidates":
                [],
        }

        for candidate in ATLAS[li]:

            rr = one_step_probe(
                prompt,
                base,
                li,
                candidate["q"],
            )

            feat = feature_vector(
                base[li],
                li,
                candidate,
            )

            delta = (
                rr["D_next"]
                - fixed["D_next"]
            )

            layer[
                "candidates"
            ].append({
                "candidate_id":
                    candidate[
                        "candidate_id"
                    ],

                "features":
                    feat,

                "delta":
                    float(delta),

                "D_next":
                    rr["D_next"],

                "realized_angle":
                    angle_deg(
                        rr["x"],
                        fixed["x"],
                    ),

                "realized_rel":
                    rr["realized_rel"],

                "dir_cos":
                    rr["dir_cos"],
            })

        prow["layers"][
            str(li)
        ] = layer

    SYSTEM_DATA.append(
        prow
    )

    if (pi + 1) % 4 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/"
        f"{len(SYSTEM_PROMPTS)} "
        f"| {(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"TRAIN+DEV completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 15. RIDGE SCORER
#
# Per-layer scorer.
#
# Standardize NON-BIAS features using TRAIN only.
#
# Ridge:
#
#   beta = (X'X + lambda I)^-1 X'y
#
# Bias is NOT regularized.
# =============================================================================

def prepare_xy(
    data,
    li,
    split,
):

    X = []
    y = []
    meta = []

    for row in data:

        if row["split"] != split:
            continue

        layer = (
            row["layers"][str(li)]
        )

        for c in layer[
            "candidates"
        ]:

            X.append(
                c["features"]
            )

            y.append(
                c["delta"]
            )

            meta.append({
                "prompt_index":
                    row["prompt_index"],

                "candidate_id":
                    c["candidate_id"],
            })

    return (
        np.asarray(
            X,
            dtype=np.float64,
        ),
        np.asarray(
            y,
            dtype=np.float64,
        ),
        meta,
    )


def standardize_fit(X):

    # feature 0 = bias
    mu = X[:, 1:].mean(
        axis=0
    )

    sd = X[:, 1:].std(
        axis=0,
    )

    sd[
        sd < 1e-10
    ] = 1.0

    return mu, sd


def standardize_apply(
    X,
    mu,
    sd,
):

    Z = X.copy()

    Z[:, 1:] = (
        Z[:, 1:]
        - mu
    ) / sd

    Z[:, 0] = 1.0

    return Z


def ridge_fit(
    X,
    y,
    lam,
):

    p = X.shape[1]

    reg = np.eye(
        p,
        dtype=np.float64,
    )

    # don't regularize bias
    reg[0, 0] = 0.0

    A = (
        X.T @ X
        + lam * reg
    )

    b = (
        X.T @ y
    )

    beta = np.linalg.solve(
        A,
        b,
    )

    return beta


def predict(
    X,
    beta,
):

    return X @ beta


# =============================================================================
# 16. DEV MODEL SELECTION
#
# IMPORTANT:
# Selection metric is not row-wise regression correlation alone.
#
# We care about RANKING candidates within each prompt.
#
# For each DEV prompt:
#
#   choose argmax predicted candidate
#   measure actual delta of selected candidate.
#
# Lambda chosen by mean DEV selected delta.
# =============================================================================

print("\n[6/24] DEV üzerinden scorer regularization seçiliyor...")

SCORERS = {}
DEV_SELECTION = {}

for li in SOURCE_LAYERS:

    Xtr, ytr, mtr = prepare_xy(
        SYSTEM_DATA,
        li,
        "TRAIN",
    )

    Xdv, ydv, mdv = prepare_xy(
        SYSTEM_DATA,
        li,
        "DEV",
    )

    mu, sd = standardize_fit(
        Xtr
    )

    Ztr = standardize_apply(
        Xtr,
        mu,
        sd,
    )

    Zdv = standardize_apply(
        Xdv,
        mu,
        sd,
    )

    candidates = []

    for lam in RIDGES:

        beta = ridge_fit(
            Ztr,
            ytr,
            lam,
        )

        pred_dv = predict(
            Zdv,
            beta,
        )

        selected_actual = []
        oracle_actual = []
        random_actual = []

        prompt_ids = sorted(
            set(
                m["prompt_index"]
                for m in mdv
            )
        )

        for pid in prompt_ids:

            inds = [
                j
                for j, m
                in enumerate(mdv)
                if m["prompt_index"]
                == pid
            ]

            pp = pred_dv[inds]
            aa = ydv[inds]

            best_local = int(
                np.argmax(pp)
            )

            selected_actual.append(
                float(
                    aa[best_local]
                )
            )

            oracle_actual.append(
                float(
                    np.max(aa)
                )
            )

            # deterministic random control
            rng = random.Random(
                SEED
                + 500000
                + 1000 * li
                + pid
            )

            ridx = rng.randrange(
                len(aa)
            )

            random_actual.append(
                float(
                    aa[ridx]
                )
            )

        candidates.append({
            "lambda":
                lam,

            "selected_mean":
                float(
                    np.mean(
                        selected_actual
                    )
                ),

            "oracle_mean":
                float(
                    np.mean(
                        oracle_actual
                    )
                ),

            "random_mean":
                float(
                    np.mean(
                        random_actual
                    )
                ),

            "row_corr":
                safe_corr(
                    pred_dv,
                    ydv,
                ),
        })

    candidates.sort(
        key=lambda z:
            z["selected_mean"],
        reverse=True,
    )

    best = candidates[0]

    # Refit using TRAIN + DEV
    Xall = np.vstack([
        Xtr,
        Xdv,
    ])

    yall = np.concatenate([
        ytr,
        ydv,
    ])

    mu_all, sd_all = (
        standardize_fit(
            Xall
        )
    )

    Zall = standardize_apply(
        Xall,
        mu_all,
        sd_all,
    )

    beta_all = ridge_fit(
        Zall,
        yall,
        best["lambda"],
    )

    SCORERS[li] = {
        "mu":
            mu_all,

        "sd":
            sd_all,

        "beta":
            beta_all,

        "lambda":
            best["lambda"],
    }

    DEV_SELECTION[li] = {
        "best":
            best,

        "all":
            candidates,
    }

    print(
        f"L{li:02d}->L{li+1:02d} "
        f"λ={best['lambda']:<7g} "
        f"DEV selected="
        f"{best['selected_mean']:+.5f} "
        f"oracle="
        f"{best['oracle_mean']:+.5f} "
        f"random="
        f"{best['random_mean']:+.5f} "
        f"row-r="
        f"{best['row_corr']:+.3f}"
    )


# =============================================================================
# 17. GLOBAL FIXED CANDIDATE BASELINE
#
# Select candidate ID from TRAIN+DEV actual outcomes.
#
# This is the strongest non-state-conditioned fixed-correction baseline.
# =============================================================================

print("\n[7/24] Global fixed candidate baseline oluşturuluyor...")

GLOBAL_CANDIDATE = {}

for li in SOURCE_LAYERS:

    means = []

    for cid in range(
        N_CANDIDATES
    ):

        vals = []

        for row in SYSTEM_DATA:

            c = (
                row["layers"][str(li)]
                ["candidates"][cid]
            )

            assert (
                c["candidate_id"]
                == cid
            )

            vals.append(
                c["delta"]
            )

        means.append(
            float(
                np.mean(vals)
            )
        )

    best_id = int(
        np.argmax(means)
    )

    GLOBAL_CANDIDATE[li] = {
        "candidate_id":
            best_id,

        "train_dev_mean_delta":
            means[best_id],
    }

    print(
        f"L{li:02d}: "
        f"candidate={best_id:02d} "
        f"TRAIN+DEV Δ="
        f"{means[best_id]:+.5f}"
    )


# =============================================================================
# 18. SENSOR SELECTION ON BLIND STATE
#
# NO intervention outcome is used here.
# =============================================================================

def sensor_choose(
    li,
    state,
):

    scorer = SCORERS[li]

    feats = []

    for candidate in ATLAS[li]:

        feats.append(
            feature_vector(
                state,
                li,
                candidate,
            )
        )

    X = np.asarray(
        feats,
        dtype=np.float64,
    )

    Z = standardize_apply(
        X,
        scorer["mu"],
        scorer["sd"],
    )

    scores = predict(
        Z,
        scorer["beta"],
    )

    best_id = int(
        np.argmax(scores)
    )

    return (
        best_id,
        scores,
    )


# =============================================================================
# 19. BLIND PHASE
#
# Sequence:
#
# 1. baseline state
# 2. sensor chooses candidate using state only
# 3. physical outcomes are measured
#
# We ALSO scan all 16 candidates AFTER selection to estimate oracle ceiling.
#
# This does not leak into sensor selection.
# =============================================================================

print("\n[8/24] BLIND GPS sensor assay...")

BLIND_RESULTS = []

start = time.time()

for pi, prompt in enumerate(
    BLIND_PROMPTS
):

    base = baseline_pass(
        prompt
    )

    row = {
        "prompt_index":
            pi,

        "prompt":
            prompt,

        "layers":
            {},
    }

    for li in SOURCE_LAYERS:

        # -------------------------------------------------------------
        # SENSOR DECISION BEFORE OUTCOMES
        # -------------------------------------------------------------

        sensor_id, scores = (
            sensor_choose(
                li,
                base[li],
            )
        )

        global_id = (
            GLOBAL_CANDIDATE[li]
            ["candidate_id"]
        )

        rng = random.Random(
            SEED
            + 900000
            + 1000 * li
            + pi
        )

        random_id = rng.randrange(
            N_CANDIDATES
        )

        # -------------------------------------------------------------
        # FIXED
        # -------------------------------------------------------------

        fixed = one_step_probe(
            prompt,
            base,
            li,
            DIBEK[li],
        )

        # -------------------------------------------------------------
        # SCAN CANDIDATES
        #
        # Sensor selection already frozen.
        # -------------------------------------------------------------

        outcomes = []

        for candidate in ATLAS[li]:

            rr = one_step_probe(
                prompt,
                base,
                li,
                candidate["q"],
            )

            outcomes.append({
                "candidate_id":
                    candidate[
                        "candidate_id"
                    ],

                "D_next":
                    rr["D_next"],

                "delta":
                    rr["D_next"]
                    - fixed["D_next"],

                "realized_angle":
                    angle_deg(
                        rr["x"],
                        fixed["x"],
                    ),

                "realized_rel":
                    rr["realized_rel"],

                "dir_cos":
                    rr["dir_cos"],
            })

        oracle_id = int(
            np.argmax([
                x["D_next"]
                for x in outcomes
            ])
        )

        sensor_out = (
            outcomes[sensor_id]
        )

        global_out = (
            outcomes[global_id]
        )

        random_out = (
            outcomes[random_id]
        )

        oracle_out = (
            outcomes[oracle_id]
        )

        # rank of sensor candidate by actual outcome
        actual_order = np.argsort(
            -np.asarray([
                x["D_next"]
                for x in outcomes
            ])
        )

        sensor_rank = int(
            np.where(
                actual_order
                == sensor_id
            )[0][0]
        ) + 1

        row["layers"][
            str(li)
        ] = {
            "fixed_D":
                fixed["D_next"],

            "sensor_id":
                sensor_id,

            "global_id":
                global_id,

            "random_id":
                random_id,

            "oracle_id":
                oracle_id,

            "sensor_score":
                float(
                    scores[sensor_id]
                ),

            "sensor_delta":
                sensor_out["delta"],

            "global_delta":
                global_out["delta"],

            "random_delta":
                random_out["delta"],

            "oracle_delta":
                oracle_out["delta"],

            "sensor_D":
                sensor_out["D_next"],

            "global_D":
                global_out["D_next"],

            "random_D":
                random_out["D_next"],

            "oracle_D":
                oracle_out["D_next"],

            "sensor_rank":
                sensor_rank,

            "sensor_hit_oracle":
                int(
                    sensor_id
                    == oracle_id
                ),

            "sensor_realized_angle":
                sensor_out[
                    "realized_angle"
                ],

            "all_outcomes":
                outcomes,

            "all_predicted_scores":
                [
                    float(x)
                    for x in scores
                ],
        }

    BLIND_RESULTS.append(
        row
    )

    if (pi + 1) % 4 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/"
        f"{len(BLIND_PROMPTS)} "
        f"| {(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"BLIND completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
