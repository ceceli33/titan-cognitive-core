        )

        rd.append(
            z["random_delta"]
        )

        od.append(
            z["oracle_delta"]
        )

    item = {
        "prompt_index":
            pi,

        "sensor":
            float(np.mean(sd)),

        "global":
            float(np.mean(gd)),

        "random":
            float(np.mean(rd)),

        "oracle":
            float(np.mean(od)),
    }

    PROMPT_SUMMARY.append(
        item
    )

    print(
        f"P{pi:02d} "
        f"S={item['sensor']:+.5f} "
        f"G={item['global']:+.5f} "
        f"R={item['random']:+.5f} "
        f"O={item['oracle']:+.5f}"
    )


# =============================================================================
# 25. FEATURE COEFFICIENT DIAGNOSTIC
#
# Descriptive only.
# We report standardized ridge coefficients averaged across layers.
# =============================================================================

print("\n[13/24] Feature coefficient diagnostic...")

BETAS = np.stack([
    SCORERS[li]["beta"]
    for li in SOURCE_LAYERS
])

MEAN_ABS_BETA = np.mean(
    np.abs(BETAS),
    axis=0,
)

order = np.argsort(
    -MEAN_ABS_BETA
)

FEATURE_IMPORTANCE = []

for idx in order:

    item = {
        "feature":
            FEATURE_NAMES[idx],

        "mean_abs_beta":
            float(
                MEAN_ABS_BETA[idx]
            ),

        "mean_signed_beta":
            float(
                np.mean(
                    BETAS[:, idx]
                )
            ),
    }

    FEATURE_IMPORTANCE.append(
        item
    )

    print(
        f"{item['feature']:<24} "
        f"|absβ|="
        f"{item['mean_abs_beta']:.6f} "
        f"meanβ="
        f"{item['mean_signed_beta']:+.6f}"
    )


# =============================================================================
# 26. CRITICAL NULL:
# Does state-conditioned sensor beat strongest fixed candidate?
# =============================================================================

print("\n[14/24] Critical state-conditioning contrast...")

STATE_ADVANTAGE = S_SG

layers_sensor_gt_global = float(
    np.mean([
        LAYER_SUMMARY[str(li)]
        ["sensor_minus_global"]
        ["mean"] > 0
        for li in SOURCE_LAYERS
    ])
)

layers_sensor_gt_random = float(
    np.mean([
        LAYER_SUMMARY[str(li)]
        ["sensor_minus_random"]
        ["mean"] > 0
        for li in SOURCE_LAYERS
    ])
)

print(
    "Sensor > global layers:",
    f"{layers_sensor_gt_global:.3f}"
)

print(
    "Sensor > random layers:",
    f"{layers_sensor_gt_random:.3f}"
)


# =============================================================================
# 27. DECISION
# =============================================================================

print("\n[15/24] DECISION")
print("=" * 180)

# Strong success:
#
# 1. sensor physically improves FIXED
# 2. sensor beats GLOBAL fixed correction
# 3. sensor beats RANDOM
# 4. >50% of oracle opportunity captured
# 5. layer consistency not concentrated in a tiny subset

if (
    S_SENSOR["mean"] > 0
    and S_SENSOR["ci95"][0] > 0

    and S_SG["mean"] > 0
    and S_SG["ci95"][0] > 0

    and S_SR["mean"] > 0
    and S_SR["ci95"][0] > 0

    and CAPTURE_RATIO >= 0.50

    and layers_sensor_gt_global >= 0.70
):

    DECISION = (
        "STATE_TO_CORRECTION_SENSOR_SUPPORTED"
    )

elif (
    S_SENSOR["mean"] > 0
    and S_SENSOR["ci95"][0] > 0
    and (
        S_SG["mean"] <= 0
        or S_SG["ci95"][0] <= 0
    )
):

    DECISION = (
        "CORRECTION_GAIN_WITHOUT_STATE_SELECTION_ADVANTAGE"
    )

elif (
    S_SENSOR["mean"] <= 0
    or S_SENSOR["ci95"][1] <= 0
):

    DECISION = (
        "STATE_SENSOR_NOT_SUPPORTED"
    )

else:

    DECISION = (
        "STATE_SENSOR_MIXED"
    )


print(
