        ["sensor_id"]
        for row in BLIND_RESULTS
    ]

    counts = np.bincount(
        ids,
        minlength=N_CANDIDATES,
    )

    unique = int(
        np.sum(counts > 0)
    )

    modal = float(
        np.max(counts)
        / np.sum(counts)
    )

    SELECTION_DIVERSITY[str(li)] = {
        "unique":
            unique,

        "modal_fraction":
            modal,

        "counts":
            counts.tolist(),
    }

