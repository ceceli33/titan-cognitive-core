    sensor_minus_global
)

S_SR = stats(
    sensor_minus_random
)

ROW_CORR = safe_corr(
    predicted_all,
    actual_all,
)

MEAN_SENSOR_RANK = float(
    np.mean(
        sensor_ranks
    )
)

TOP4_RATE = float(
    np.mean(
        np.asarray(
            sensor_ranks
        ) <= 4
    )
)

ORACLE_HIT_RATE = float(
    np.mean(
        sensor_hits
    )
)

RANDOM_ORACLE_HIT = (
    1.0
    / N_CANDIDATES
)

RANDOM_MEAN_RANK = (
    N_CANDIDATES + 1
) / 2.0


# =============================================================================
# 21. CAPTURE RATIO
# =============================================================================

if (
    S_ORACLE["mean"]
    > EPS
):

    CAPTURE_RATIO = (
        S_SENSOR["mean"]
        / S_ORACLE["mean"]
    )

else:

    CAPTURE_RATIO = float("nan")


