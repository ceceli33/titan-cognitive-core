# =============================================================================
# 9. BUILD SENSOR BASIS
# =============================================================================

print(
    "\n[4/13] Context sensor basis hazırlanıyor..."
)


SENSOR_BASIS = {}


for layer_idx in ACTIVE_LAYERS:

    A = (
        IND_ABOVE[layer_idx]
        .astype(np.float64)
    )

    B = (
        IND_BELOW[layer_idx]
        .astype(np.float64)
    )


    A = (
        A
        /
        np.linalg.norm(A)
    )

    B = (
        B
        /
        np.linalg.norm(B)
    )


    COMMON = normalize_np(
        A + B
    ).astype(np.float64)


    SEPARATOR = normalize_np(
        A - B
    ).astype(np.float64)


    # -------------------------------------------------------------------------
    # Symmetric orthonormal basis for span(A,B)
    #
    # Because normalized (A+B) and (A-B) are orthogonal when ||A||=||B||.
    # -------------------------------------------------------------------------

    dot_common_separator = (
        float(
            np.dot(
                COMMON,
                SEPARATOR
            )
        )
    )


    # -------------------------------------------------------------------------
    # Directional residuals
    # -------------------------------------------------------------------------

    A_RESIDUAL = (
        A
        - np.dot(A, B) * B
    )

    A_RESIDUAL = (
        A_RESIDUAL
        /
        np.linalg.norm(
            A_RESIDUAL
        )
    )


    B_RESIDUAL = (
        B
        - np.dot(B, A) * A
    )

    B_RESIDUAL = (
        B_RESIDUAL
        /
        np.linalg.norm(
            B_RESIDUAL
        )
    )


    SENSOR_BASIS[
        layer_idx
    ] = {

        "A":
            A,

        "B":
            B,

        "COMMON":
            COMMON,

        "SEPARATOR":
            SEPARATOR,

        "A_RESIDUAL":
            A_RESIDUAL,

        "B_RESIDUAL":
            B_RESIDUAL,
    }


    print(
        f"L{layer_idx:02d} | "
        f"cos(A,B)="
        f"{cosine_np(A,B):+.6f} | "
        f"dot(COMMON,SEPARATOR)="
        f"{dot_common_separator:+.9f}"
    )


# =============================================================================
# 10. PRE-STEERING CONTEXT GEOMETRY
# =============================================================================

@torch.no_grad()
def capture_pre_steering_hidden(
    prompt
):

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(model.device)


    captured = {}


    handles = []


    def make_hook(
        layer_idx
    ):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(
                    output,
                    tuple
                )
                else output
            )


            captured[
                layer_idx
            ] = (
                hidden[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .numpy()
                .astype(
                    np.float64
                )
            )

        return hook


    for layer_idx in (
        ACTIVE_LAYERS
    ):

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_hook(
                make_hook(
                    layer_idx
                )
            )
        )


    _ = model(
        **encoded,
        use_cache=False
    )


    for handle in handles:
        handle.remove()


    return captured


def geometry_features(
    h,
    layer_idx
):

    basis = (
        SENSOR_BASIS[
            layer_idx
        ]
    )


    A = basis["A"]
    B = basis["B"]

    C = basis["COMMON"]
    S = basis["SEPARATOR"]

    AR = basis["A_RESIDUAL"]
    BR = basis["B_RESIDUAL"]


    h = np.asarray(
        h,
        dtype=np.float64
    )


    h_norm = float(
        np.linalg.norm(h)
    )


    if h_norm < 1e-12:

        h_unit = h.copy()

    else:

        h_unit = (
            h / h_norm
        )


    cos_a = float(
        np.dot(
            h_unit,
            A
        )
    )

    cos_b = float(
        np.dot(
            h_unit,
            B
        )
    )

    cos_common = float(
        np.dot(
            h_unit,
            C
        )
    )

    cos_separator = float(
        np.dot(
            h_unit,
            S
        )
    )

    cos_a_residual = float(
        np.dot(
            h_unit,
            AR
        )
    )

    cos_b_residual = float(
        np.dot(
            h_unit,
            BR
        )
    )


    # -------------------------------------------------------------------------
    # Projection coordinates in orthonormal common/separator basis
    # -------------------------------------------------------------------------

    common_raw = float(
        np.dot(
            h,
            C
        )
    )

    separator_raw = float(
        np.dot(
            h,
            S
        )
    )


    span_projection_norm = float(
        math.sqrt(
            common_raw ** 2
            +
            separator_raw ** 2
        )
    )


    span_ratio = (
        span_projection_norm
        /
        h_norm
        if h_norm > 1e-12
        else 0.0
    )


    # -------------------------------------------------------------------------
    # Relative directional quantities
    # -------------------------------------------------------------------------

    cosine_margin = (
        cos_a
        - cos_b
    )


    cosine_sum = (
        cos_a
        + cos_b
    )


    abs_margin = abs(
        cosine_margin
    )


    separator_to_common = (
        cos_separator
        /
        (
            abs(cos_common)
            + 1e-12
        )
    )


    return {

        "h_norm":
            h_norm,

        "cos_A":
            cos_a,

        "cos_B":
            cos_b,

        "cos_margin_A_minus_B":
            cosine_margin,

        "cos_sum_A_plus_B":
            cosine_sum,

        "abs_cos_margin":
            abs_margin,

        "cos_COMMON":
            cos_common,

        "cos_SEPARATOR":
            cos_separator,

        "cos_A_residual":
            cos_a_residual,

        "cos_B_residual":
            cos_b_residual,

        "common_raw":
            common_raw,

        "separator_raw":
            separator_raw,

        "span_projection_norm":
            span_projection_norm,

        "span_projection_ratio":
            float(
                span_ratio
            ),

        "separator_to_common":
            float(
