def normalize_np(v, eps=1e-12):

    v = np.asarray(
        v,
        dtype=np.float64
    )

    n = np.linalg.norm(v)

    if n < eps:
        return v.astype(np.float32)

    return (
        v / n
    ).astype(np.float32)


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(
        a,
        dtype=np.float64
    )

    b = np.asarray(
        b,
        dtype=np.float64
    )

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def rankdata_average(x):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    order = np.argsort(
        x,
        kind="mergesort"
    )

    ranks = np.empty(
        len(x),
        dtype=np.float64
    )

    i = 0

    while i < len(x):

        j = i + 1

        while (
            j < len(x)
            and
            x[
                order[j]
            ]
            ==
            x[
                order[i]
            ]
        ):
            j += 1

        average_rank = (
            (i + 1)
            + j
        ) / 2.0

        ranks[
            order[i:j]
        ] = average_rank

        i = j

    return ranks


def pearson_r(x, y):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )

    if (
        np.std(x) < 1e-15
        or
        np.std(y) < 1e-15
    ):
        return 0.0

    return float(
        np.corrcoef(
            x,
            y
        )[0, 1]
    )


def spearman_rho(x, y):

    rx = rankdata_average(x)
    ry = rankdata_average(y)

    return pearson_r(
        rx,
        ry
    )


def simple_ols(x, y):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )

    X = np.column_stack([
        np.ones(len(x)),
        x
    ])


    beta = np.linalg.lstsq(
        X,
        y,
        rcond=None
    )[0]


    pred = X @ beta


    ss_res = np.sum(
        (y - pred) ** 2
    )

    ss_tot = np.sum(
        (y - y.mean()) ** 2
    )


    r2 = (
        1.0
        - ss_res / ss_tot
        if ss_tot > 1e-15
        else 0.0
    )


    return {
        "intercept":
            float(beta[0]),

        "slope":
            float(beta[1]),

        "r2":
            float(r2),
    }


def loo_linear_prediction(x, y):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )


    preds = np.zeros(
        len(x),
        dtype=np.float64
    )


    for i in range(
        len(x)
    ):

        mask = np.ones(
            len(x),
            dtype=bool
        )

        mask[i] = False


        X_train = np.column_stack([
            np.ones(
                mask.sum()
            ),
            x[mask]
        ])


        beta = np.linalg.lstsq(
            X_train,
            y[mask],
            rcond=None
        )[0]


        preds[i] = (
            beta[0]
            + beta[1] * x[i]
        )


    return {
        "prediction_correlation":
            pearson_r(
                preds,
                y
            ),

        "prediction_mae":
            float(
                np.mean(
                    np.abs(
                        preds - y
                    )
                )
            ),

        "predictions":
            preds.tolist(),
    }


def sign_accuracy_from_sensor(
    x,
    y
):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )


    # Exploratory only:
    # compare whether sensor sign and DDS sign agree.
    valid = (
        (x != 0)
        &
        (y != 0)
    )


    if valid.sum() == 0:

        return 0.0


    return float(
        np.mean(
            np.sign(x[valid])
            ==
            np.sign(y[valid])
        )
    )


