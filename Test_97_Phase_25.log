def ranked_results(
    results,
    key,
    absolute=True
):

    rows = []


    for name, metrics in (
        results.items()
    ):

        value = metrics[
            key
        ]


        score = (
            abs(value)
            if absolute
            else value
        )


        rows.append(
            (
                name,
                value,
                score
            )
        )


    rows.sort(
        key=lambda x: x[2],
        reverse=True
    )


    return rows


