# =============================================================================
# 10. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        -
        abs(cosine_value)
    )


    dw = (
        SONUM
        +
        uncertainty * 0.20
    )


    t = float(layer_idx)


    kb = (
        ZIRVE
        *
        math.exp(-dw * t)
        *
        (
            1.0
            +
            dw * t
        )
        +
        TABAN
    )


    envelope = (
        kb
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            1.0
            -
            cosine_value
        ) / BRAKE_HIGH_DENOM

    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN

    else:

        brake = 1.0


    return envelope, brake


# =============================================================================
# 11. FP32 TARGET READOUT
# =============================================================================

def qwen_rmsnorm_fp32(
    hidden_fp32
):

    norm_module = model.model.norm

    weight = (
        norm_module.weight
        .detach()
        .float()
    )

    eps = float(
        norm_module.variance_epsilon
    )


    variance = (
        hidden_fp32
        .pow(2)
        .mean(
            dim=-1,
            keepdim=True
        )
    )


    normalized = (
        hidden_fp32
        *
        torch.rsqrt(
            variance + eps
        )
    )


    return normalized * weight


@torch.no_grad()
def hp_target_logits(
    final_hidden_last
):

    h = final_hidden_last.float()

    h_norm = qwen_rmsnorm_fp32(
        h
    )


    target_weights = (
        model.lm_head.weight[
            TARGET_ID_LIST
        ]
        .detach()
        .float()
    )


    logits = torch.matmul(
        target_weights,
        h_norm
    )


    return {
        "above": float(logits[0].cpu()),
        "below": float(logits[1].cpu()),
        "over": float(logits[2].cpu()),
        "under": float(logits[3].cpu()),
    }


def make_readout(logits):

    return {

        "AB": float(
            logits["above"]
            -
            logits["below"]
        ),

        "OU": float(
            logits["over"]
            -
            logits["under"]
        ),
    }


# =============================================================================
# 12. FULL TRAJECTORY FORWARD
# =============================================================================

@torch.no_grad()
def trajectory_forward(
    prompt,
    vectors=None,
    arm_name="BASELINE"
):

    layer_post = [
        None
        for _ in range(MODEL_LAYERS)
    ]


    telemetry = []


    final_capture = {
        "hidden": None
    }


    handles = []


    def make_output_hook(
        layer_idx
    ):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            hidden_new = hidden


            if (
                vectors is not None
                and
                layer_idx in ACTIVE_LAYERS
            ):

                vector = (
                    torch.as_tensor(
                        vectors[layer_idx],
                        device=hidden.device,
                        dtype=hidden.dtype,
                    )
                    .unsqueeze(0)
                )


                h = hidden[
                    :,
                    -1,
                    :
                ]


                h_norm = torch.linalg.norm(
                    h,
                    dim=-1,
                    keepdim=True
                )


                v_norm = torch.linalg.norm(
                    vector,
                    dim=-1,
                    keepdim=True
                )


                cosine = (
                    torch.sum(
                        h * vector,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        h_norm
                        *
                        v_norm
                        +
                        1e-12
                    )
                )


                cosine_value = float(
                    cosine
                    .mean()
                    .detach()
                    .cpu()
                )


                envelope, brake = dra_parameters(
                    cosine_value,
                    layer_idx
                )


                contribution = (
                    IVME
                    *
                    h_norm
                    /
                    SQRT_K
                    *
                    envelope
                    *
                    brake
                )


                delta = (
                    contribution
                    *
                    vector
                )


                hidden_new = hidden.clone()


                hidden_new[
                    :,
                    -1,
                    :
                ] = (
                    hidden_new[
                        :,
                        -1,
                        :
                    ]
                    +
                    delta
                )


                relative_delta = (
                    torch.linalg.norm(
                        delta,
                        dim=-1
                    )
                    /
                    (
                        h_norm.squeeze(-1)
                        +
                        1e-12
                    )
                )


                telemetry.append({

                    "arm":
                        arm_name,

                    "layer":
                        int(layer_idx),

                    "cosine":
                        cosine_value,

                    "envelope":
                        float(envelope),

                    "brake":
                        float(brake),

                    "contribution":
                        float(
                            contribution
                            .mean()
                            .detach()
                            .cpu()
                        ),

                    "direct_relative_delta":
                        float(
                            relative_delta
                            .mean()
                            .detach()
                            .cpu()
                        ),
                })


            layer_post[
                layer_idx
            ] = (
                hidden_new[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .numpy()
                .astype(np.float64)
            )


            if isinstance(output, tuple):

                return (
                    hidden_new,
                    *output[1:]
                )


            return hidden_new


        return hook


    for layer_idx in range(MODEL_LAYERS):

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_hook(
                make_output_hook(layer_idx)
            )
        )


    def final_norm_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = inputs[0].detach()


    final_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_norm_pre_hook
        )
    )


    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    try:

        _ = model(
            **encoded,
            use_cache=False
        )


        final_hidden = (
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


        logits = hp_target_logits(
            final_hidden
        )


        readout = make_readout(
            logits
        )


    finally:

        for handle in handles:
            handle.remove()

        final_handle.remove()


    return {
        "layer_post": layer_post,
        "telemetry": telemetry,
        "logits": logits,
        "readout": readout,
    }


# =============================================================================
# 13. PERTURBATION GEOMETRY ANALYSIS
# =============================================================================

def analyze_perturbation_geometry(
    baseline,
    steered,
    arm_name
):

    physical = []

    semantic = []


    # -------------------------------------------------------------------------
    # Raw perturbation vectors L0-L27
    # -------------------------------------------------------------------------

    deltas = []


    for layer_idx in range(MODEL_LAYERS):

        h0 = baseline[
            "layer_post"
        ][layer_idx]


        hs = steered[
            "layer_post"
        ][layer_idx]


        delta = (
            hs
            -
            h0
        )


        deltas.append(
            delta
        )


    # -------------------------------------------------------------------------
    # Physical trajectory
    # -------------------------------------------------------------------------

    for layer_idx in range(MODEL_LAYERS):

        delta = deltas[
            layer_idx
        ]


        h0 = baseline[
            "layer_post"
        ][layer_idx]


        delta_norm = float(
            np.linalg.norm(delta)
        )


        base_norm = float(
            np.linalg.norm(h0)
        )


        relative_delta = (
            delta_norm
            /
            (
                base_norm
                +
                EPS
            )
        )


        # Adjacent directional continuity

        if (
            layer_idx >= 10
            and
            layer_idx < MODEL_LAYERS - 1
        ):

            adjacent_cos = cosine_np(
                delta,
                deltas[layer_idx + 1]
            )

        else:

            adjacent_cos = None


        # Direction retention relative to L11

        if layer_idx >= 11:

            retention_L11 = cosine_np(
                deltas[11],
                delta
            )

        else:

            retention_L11 = None


        physical.append({

            "layer":
                int(layer_idx),

            "delta_norm":
                delta_norm,

            "baseline_norm":
                base_norm,

            "relative_delta":
                float(relative_delta),

            "adjacent_direction_cos":
                (
                    None
                    if adjacent_cos is None
                    else float(adjacent_cos)
                ),

            "direction_retention_vs_L11":
                (
                    None
                    if retention_L11 is None
                    else float(retention_L11)
                ),
        })


    # -------------------------------------------------------------------------
    # Semantic decomposition L10-L19
    # -------------------------------------------------------------------------

    for layer_idx in range(
        10,
        VECTOR_LAYERS
    ):

        delta = deltas[
            layer_idx
        ]


        delta_norm = float(
            np.linalg.norm(delta)
        )


        if delta_norm < EPS:

            unit_delta = np.zeros_like(
                delta,
                dtype=np.float64
            )

        else:

            unit_delta = (
                delta
                /
                delta_norm
            )


        A = IND_ABOVE[
            layer_idx
        ].astype(np.float64)


        B = IND_BELOW[
            layer_idx
        ].astype(np.float64)


        S = SEPARATOR[
            layer_idx
        ].astype(np.float64)


        C = COMMON[
            layer_idx
        ].astype(np.float64)


        # ---------------------------------------------------------------------
        # Signed projections of UNIT perturbation
        # ---------------------------------------------------------------------

        proj_A = float(
            np.dot(
                unit_delta,
                A
            )
        )


        proj_B = float(
            np.dot(
                unit_delta,
                B
            )
        )


        proj_S = float(
            np.dot(
                unit_delta,
                S
            )
        )


        proj_C = float(
            np.dot(
                unit_delta,
                C
            )
        )


        # ---------------------------------------------------------------------
        # Squared projection fractions
        # ---------------------------------------------------------------------

        E_S = float(
            proj_S ** 2
        )


        E_C = float(
            proj_C ** 2
        )


        E_SC = float(
            E_S
            +
            E_C
        )


        # Numerical clamp

        E_SC_clamped = float(
            min(
                max(
                    E_SC,
                    0.0
                ),
                1.0
            )
        )


        E_PERP = float(
            max(
                0.0,
                1.0
                -
                E_SC_clamped
            )
        )


        # ---------------------------------------------------------------------
        # Actual norm of each component
        # ---------------------------------------------------------------------

        separator_component_norm = float(
            abs(proj_S)
            *
            delta_norm
        )


        common_component_norm = float(
            abs(proj_C)
            *
            delta_norm
        )


        semantic_plane_component_norm = float(
            math.sqrt(
                E_SC_clamped
            )
            *
            delta_norm
        )


        perpendicular_component_norm = float(
            math.sqrt(
                E_PERP
            )
            *
            delta_norm
        )


        # ---------------------------------------------------------------------
        # Angle inside S/C plane
        # ---------------------------------------------------------------------

        plane_angle_deg = float(
            math.degrees(
                math.atan2(
                    proj_S,
                    proj_C
                )
            )
        )


        semantic.append({

            "layer":
                int(layer_idx),

            "delta_norm":
                delta_norm,

            "cos_delta_A":
                proj_A,

            "cos_delta_B":
                proj_B,

            "cos_delta_separator":
                proj_S,

            "cos_delta_common":
                proj_C,

            "separator_energy_fraction":
                E_S,

            "common_energy_fraction":
                E_C,

            "semantic_plane_energy_fraction":
                E_SC_clamped,

            "orthogonal_energy_fraction":
                E_PERP,

            "separator_component_norm":
                separator_component_norm,

            "common_component_norm":
                common_component_norm,

            "semantic_plane_component_norm":
                semantic_plane_component_norm,

            "orthogonal_component_norm":
                perpendicular_component_norm,

            "semantic_plane_angle_deg":
                plane_angle_deg,
        })


    # -------------------------------------------------------------------------
    # Relative angle change from L11
    # -------------------------------------------------------------------------

    angle_L11 = None


    for row in semantic:

        if row["layer"] == 11:

            angle_L11 = row[
                "semantic_plane_angle_deg"
            ]

            break


    for row in semantic:

        if (
            angle_L11 is not None
            and
            row["layer"] >= 11
        ):

            row[
                "plane_angle_change_vs_L11_deg"
            ] = circular_difference_deg(
                row[
                    "semantic_plane_angle_deg"
                ],
                angle_L11
            )

        else:

            row[
                "plane_angle_change_vs_L11_deg"
            ] = None


    return {

        "arm":
            arm_name,

        "physical":
            physical,

        "semantic":
            semantic,
    }


