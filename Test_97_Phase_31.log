def semantic_metric(
    arm,
    layer_idx,
    key
):

    semantic_index = (
        layer_idx
        -
        10
    )

    return np.asarray(
        [
            item[
                arm
            ][
                "semantic"
            ][
                semantic_index
            ][key]
            for item in RESULTS
        ],
        dtype=np.float64
    )


def physical_metric(
    arm,
    layer_idx,
    key
):

    values = []

    for item in RESULTS:

        value = item[
            arm
        ][
            "physical"
        ][
            layer_idx
        ][key]

        values.append(
            np.nan
            if value is None
            else value
        )


    return np.asarray(
        values,
        dtype=np.float64
    )


