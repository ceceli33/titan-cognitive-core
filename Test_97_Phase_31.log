    ]


    baseline = trajectory_forward(
        prompt,
        vectors=None,
        arm_name="BASELINE"
    )


    above = trajectory_forward(
        prompt,
        vectors=IND_ABOVE,
        arm_name="ABOVE"
    )


    below = trajectory_forward(
        prompt,
        vectors=IND_BELOW,
        arm_name="BELOW"
    )


    above_geometry = analyze_perturbation_geometry(
        baseline,
        above,
        "ABOVE"
    )


    below_geometry = analyze_perturbation_geometry(
        baseline,
        below,
        "BELOW"
    )


    DDS_AB = float(
        above["readout"]["AB"]
        -
        below["readout"]["AB"]
    )


    DDS_OU = float(
        above["readout"]["OU"]
        -
        below["readout"]["OU"]
    )


    RESULTS.append({

        "prompt_index":
            int(prompt_idx + 1),

        "family":
            family,

        "prompt":
            prompt,

        "DDS_AB":
            DDS_AB,

        "DDS_OU":
            DDS_OU,

        "baseline_readout":
            baseline["readout"],

        "above_readout":
            above["readout"],

        "below_readout":
            below["readout"],

        "ABOVE":
            above_geometry,

        "BELOW":
            below_geometry,

        "ABOVE_telemetry":
            above["telemetry"],

        "BELOW_telemetry":
            below["telemetry"],
    })


    print(
        f"{prompt_idx+1:02d}/40 | "
