def mean_sem(
    arm,
    layer,
    metric
):

    return float(
        semantic_metric(
            arm,
            layer,
            metric
        ).mean()
    )


def mean_phys(
    arm,
    layer,
    metric
):

    return float(
        physical_metric(
            arm,
            layer,
            metric
        ).mean()
    )


CORE = {}


for arm in [
    "ABOVE",
    "BELOW"
]:

    plane11 = mean_sem(
        arm,
        11,
        "semantic_plane_energy_fraction"
    )


    plane19 = mean_sem(
        arm,
        19,
        "semantic_plane_energy_fraction"
    )


    sep11 = mean_sem(
        arm,
        11,
        "separator_energy_fraction"
    )


    sep19 = mean_sem(
        arm,
        19,
        "separator_energy_fraction"
    )


    physical11 = mean_phys(
        arm,
        11,
        "relative_delta"
    )


    physical19 = mean_phys(
        arm,
        19,
        "relative_delta"
    )


    retention19 = mean_phys(
        arm,
        19,
        "direction_retention_vs_L11"
    )


    CORE[arm] = {

        "semantic_plane_energy_L11":
