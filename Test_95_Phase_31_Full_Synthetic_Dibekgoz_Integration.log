# =============================================================================
#  CUDA ÇEKİRDEK — PARALEL, BÜTÇELİ, DONDURULMUŞ norm0
# =============================================================================
_CPP_DECL=r"""
#include <torch/extension.h>
torch::Tensor akbas_steer_v14(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, torch::Tensor ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf);
"""
_CUDA_SRC=r"""
#include <torch/extension.h>
#include <c10/cuda/CUDAGuard.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda.h>
#include <cuda_runtime.h>
#include <math.h>

#define MAX_K 4

// pusula [K,D] sensör (mercekli uzayda normalize)
// hedef  [K,D] aktüatör (tam uzayda normalize)
// ivme   [K]
// prev_cosine [K*BS]
__global__ void akbas_v14_kernel(
    float* __restrict__ hidden,
    const float* __restrict__ pusula,
    const float* __restrict__ hedef,
    const float* __restrict__ mercek,
    const float* __restrict__ ivme,
    int K, int layer_idx, float sonum, float zirve, float taban,
    int fren_acik,
    float* __restrict__ prev_cosine,
    float* __restrict__ log_buf,
    int D, int BS, int S)
{
    extern __shared__ float sdata[];
    float* s_a = sdata;                 // genel redüksiyon tamponu
    float* s_b = sdata + blockDim.x;

    int token = blockIdx.x; if (token >= BS) return;
    float* tok = hidden + (size_t)token * D;

    // ---- 1) norm0: enjeksiyondan ÖNCE, BİR KEZ (tam uzay) ----
    float sqf = 0.f;
    for (int j = threadIdx.x; j < D; j += blockDim.x) { float hv=tok[j]; sqf += hv*hv; }
    s_a[threadIdx.x] = sqf; __syncthreads();
    for (int st = blockDim.x>>1; st>0; st>>=1){
        if (threadIdx.x < st) s_a[threadIdx.x] += s_a[threadIdx.x+st];
        __syncthreads();
    }
    __shared__ float s_norm0;
    if (threadIdx.x==0) s_norm0 = sqrtf(s_a[0]) + 1e-6f;
    __syncthreads();
    float norm0 = s_norm0;

    // ---- 2) her eksen için cs ve katki (h DEĞİŞMEDEN) ----
    __shared__ float s_katki[MAX_K];
    float butce = 1.0f / sqrtf((float)K);      // bütçe bölüşümü

    for (int k = 0; k < K; ++k) {
        const float* pk = pusula + (size_t)k * D;
        float dot=0.f, sqm=0.f;
        for (int j = threadIdx.x; j < D; j += blockDim.x) {
            float hm = tok[j] * mercek[j];
            dot += hm * pk[j];
            sqm += hm * hm;
        }
        s_a[threadIdx.x]=dot; s_b[threadIdx.x]=sqm; __syncthreads();
        for (int st = blockDim.x>>1; st>0; st>>=1){
            if (threadIdx.x < st){
                s_a[threadIdx.x]+=s_a[threadIdx.x+st];
                s_b[threadIdx.x]+=s_b[threadIdx.x+st];
            }
            __syncthreads();
        }
        if (threadIdx.x==0){
            float norm_m = sqrtf(s_b[0]) + 1e-6f;
            float cs = fminf(fmaxf(s_a[0]/norm_m, -1.f), 1.f);
            prev_cosine[k*BS + token] = cs;

            float t   = (float)layer_idx;
            float unc = 1.f - fabsf(cs);
            float dw  = sonum + unc*0.20f;
            float kb  = zirve*expf(-dw*t)*(1.f+dw*t) + taban;
            float zarf = kb/(zirve+taban);

            float son = 1.f;
            if (fren_acik){
                if      (cs> 0.75f) son=(1.f-cs)/0.25f;
                else if (cs<-0.40f) son=1.6f;
            }
            // norm0 DONDURULMUŞ + bütçe bölüşümü
            s_katki[k] = ivme[k]*butce*zarf*norm0*son;

            if (S>1 && token==0 && layer_idx<20 && k==0){
                log_buf[layer_idx*6+0]=cs;
                log_buf[layer_idx*6+1]=zarf;
                log_buf[layer_idx*6+2]=son;
                log_buf[layer_idx*6+3]=s_katki[k];
                log_buf[layer_idx*6+4]=norm0;
                log_buf[layer_idx*6+5]=s_katki[k]/norm0;
            }
        }
        __syncthreads();
    }

    // ---- 3) TEK SEFERDE toplama: h += SUM_k katki_k * v_k ----
    for (int j = threadIdx.x; j < D; j += blockDim.x) {
        float acc = 0.f;
        for (int k = 0; k < K; ++k) acc += s_katki[k] * hedef[(size_t)k*D + j];
        tok[j] += acc;
    }
}

torch::Tensor akbas_steer_v14(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, torch::Tensor ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf)
{
    TORCH_CHECK(hidden.is_cuda(),"hidden CUDA olmalı");
    TORCH_CHECK(hidden.scalar_type()==torch::kFloat32,"hidden float32 olmalı");
    TORCH_CHECK(pusula.dim()==2 && hedef.dim()==2, "pusula/hedef [K,D] olmalı");
    auto h=hidden.contiguous(); auto p=pusula.contiguous();
    auto hd=hedef.contiguous(); auto mc=mercek.contiguous();
    auto iv=ivme.contiguous();
    auto pc=prev_cosine.contiguous(); auto lb=log_buf.contiguous();
    if (layer_idx>=20) return h;
    int B=h.size(0),S=h.size(1),D=h.size(2),BS=B*S;
    int K=p.size(0);
    TORCH_CHECK(K<=4, "en fazla 4 eksen");
    int threads=256; while (threads>D && threads>32) threads>>=1;
    const at::cuda::OptionalCUDAGuard dg(device_of(h));
    akbas_v14_kernel<<<BS,threads,2*(size_t)threads*sizeof(float),
                       at::cuda::getCurrentCUDAStream()>>>(
        h.data_ptr<float>(),p.data_ptr<float>(),hd.data_ptr<float>(),
        mc.data_ptr<float>(),iv.data_ptr<float>(),
        K,(int)layer_idx,(float)sonum,(float)zirve,(float)taban,(int)fren_acik,
        pc.data_ptr<float>(),lb.data_ptr<float>(),D,BS,S);
    return h;
}
"""
if not torch.utils.cpp_extension.is_ninja_available():
    import site
    for _sp in site.getsitepackages():
        _b=os.path.normpath(os.path.join(_sp,"..","..","bin"))
        if os.path.isdir(_b): os.environ["PATH"]=_b+":"+os.environ.get("PATH","")
for _n in ["akbas_v14_a","akbas_v14_b"]:
    for _r in ["/tmp/akbas_v14", os.path.expanduser("~/.cache/torch_extensions")]:
        _p=os.path.join(_r,_n)
        if os.path.exists(_p): shutil.rmtree(_p,ignore_errors=True)
def _build(name):
    d=f"/tmp/akbas_v14/{name}"; os.makedirs(d,exist_ok=True)
    return load_inline(name=name,cpp_sources=_CPP_DECL,cuda_sources=_CUDA_SRC,
                       functions=["akbas_steer_v14"],build_directory=d,
                       verbose=False,extra_cflags=["-O2","-std=c++17"],
                       extra_cuda_cflags=["-O3"])
print("CUDA çekirdek derleniyor (~1-2 dk)...")
_t=time.time()
try: _k=_build("akbas_v14_a")
except Exception as e:
    print(f"  tekrar deneniyor ({type(e).__name__})..."); _k=_build("akbas_v14_b")
print(f"✅ Çekirdek hazır ({time.time()-_t:.0f} sn)\n")

# ------------------------------- MODEL ---------------------------------------
print(f"Model yükleniyor: {MODEL_ID} ...")
_t=time.time()
tok=AutoTokenizer.from_pretrained(MODEL_ID)
if tok.pad_token is None: tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained(
    MODEL_ID,device_map="auto",trust_remote_code=True,low_cpu_mem_usage=True,
    dtype=torch.bfloat16,attn_implementation="sdpa")
model.eval()
for p in model.parameters(): p.requires_grad_(False)
device=next(model.parameters()).device
D=model.config.hidden_size
print(f"✅ Model hazır ({time.time()-_t:.0f} sn) | gizli boyut {D}\n")

# =============================================================================
#  VEKTÖRLER
# =============================================================================
_cap={}
def _mkr(li):
    def h(m,i,o):
        x=o[0] if isinstance(o,tuple) else o
        _cap[li]=x.detach().to(torch.float32).cpu()
    return h
_rh=[model.model.layers[li].register_forward_hook(_mkr(li)) for li in range(N_LAYERS)]
@torch.no_grad()
def _oku(metin):
    _cap.clear(); e=tok(metin,return_tensors="pt").to(device); model(**e)
    return {li:_cap[li][0][-1].clone() for li in range(N_LAYERS)}

TUR_KALIP=[
 "The Zoodex is essentially {X}.",
 "Observing it closely, the animal is clearly {X}.",
 "The specimen in front of us is {X}.",
 "Field notes describe the creature as {X}.",
 "In every respect the body plan is that of {X}.",
 "The zoologist identified the animal as {X}.",
 "Anatomically the creature is {X}.",
 "Taxonomically the creature groups with {X}.",
]
SAHNE_KALIP=[
 "The scene is {X}.",
 "Looking out, what lies ahead is {X}.",
 "The photograph shows {X}.",
 "What surrounds the figure is {X}.",
 "Described in one line, the setting is {X}.",
 "The atmosphere of the place is {X}.",
 "Overhead and all around there is {X}.",
 "The moment is best captured as {X}.",
]
def _cum(kalip,X): return [k.format(X=X) for k in kalip]
def kontrastif(kalip,pos_X,neg_X):
    HP=[_oku(t) for t in _cum(kalip,pos_X)]
    HN=[_oku(t) for t in _cum(kalip,neg_X)]
    return {li:F.normalize(torch.stack([h[li] for h in HP]).mean(0)
                         - torch.stack([h[li] for h in HN]).mean(0),dim=0)
            for li in range(N_LAYERS)}

POS_DIBEK,NEG_DIBEK = "a tailless bipedal ape","a tailed quadrupedal mammal"
POS_FIL,  NEG_FIL   = "an elephant","an animal"
POS_FIR = ("a midnight thunderstorm over a great suspension bridge, "
           "lightning striking the tower, wind and black water below")
NEG_FIR = ("a calm sunny afternoon at a great suspension bridge, "
           "clear sky, still water below")

print("Vektörler çıkarılıyor...")
V_DIBEK=kontrastif(TUR_KALIP,POS_DIBEK,NEG_DIBEK)
V_FIL  =kontrastif(TUR_KALIP,POS_FIL,NEG_FIL)
V_FIR  =kontrastif(SAHNE_KALIP,POS_FIR,NEG_FIR)
g=torch.Generator().manual_seed(SEED)
_r=F.normalize(torch.randn(D,generator=g),dim=0)
V_RAST={li:_r.clone() for li in range(N_LAYERS)}

# --- GRAM-SCHMIDT: dibek'i fırtınaya dik yap (katman başına) ---
def gram_schmidt(v_hedef, v_ref):
    return {li:F.normalize(v_hedef[li]-(v_hedef[li]@v_ref[li])*v_ref[li],dim=0)
            for li in range(N_LAYERS)}
V_DIBEK_GS=gram_schmidt(V_DIBEK,V_FIR)

# --- mercek ---
_cap.clear()
with torch.no_grad():
    _e=tok("<|im_start|>user\nDescribe what you see.<|im_end|>\n"
           "<|im_start|>assistant\n",return_tensors="pt").to(device)
    model(**_e)
H={li:_cap[li][0] for li in range(N_LAYERS)}
NORM_PROFIL={li:float(H[li].norm(dim=-1).mean()) for li in range(N_LAYERS)}
kare=torch.zeros(D)
for li in range(N_LAYERS): kare+=H[li].pow(2).mean(0)
_,dev_idx=torch.sort(kare,descending=True)
MERCEK=torch.ones(D); MERCEK[dev_idx[:MERCEK_K]]=0.0
for h in _rh: h.remove()
del H,_cap; gc.collect(); torch.cuda.empty_cache()

def msk(vd): return {li:F.normalize(vd[li]*MERCEK,dim=0) for li in range(N_LAYERS)}
def ort_cos(a,b): return statistics.mean([float(a[li]@b[li]) for li in range(N_LAYERS)])

R_("="*78); R_("  KOSİNÜS MATRİSİ"); R_("="*78)
_ad=["FIRTINA","DIBEK","DIBEK_GS","FIL","RASTGELE"]
_vk={"FIRTINA":V_FIR,"DIBEK":V_DIBEK,"DIBEK_GS":V_DIBEK_GS,"FIL":V_FIL,
     "RASTGELE":V_RAST}
R_(f"    {'':<11}"+"".join(f"{a:>11}" for a in _ad))
R_("    "+"-"*(11+11*len(_ad)))
for a in _ad:
    R_(f"    {a:<11}"+"".join(f"{ort_cos(_vk[a],_vk[b]):>+11.4f}" for b in _ad))
R_(f"\n    fırtına<->dibek     = {ort_cos(V_FIR,V_DIBEK):+.4f}")
R_(f"    fırtına<->dibek_GS  = {ort_cos(V_FIR,V_DIBEK_GS):+.4f}  (GS sonrası ~0 olmalı)")
R_(f"    dibek<->dibek_GS    = {ort_cos(V_DIBEK,V_DIBEK_GS):+.4f}  "
   f"(1.0'a yakınsa GS neredeyse hiçbir şey değiştirmedi)")
R_("")

# =============================================================================
#  ÜRETİM
# =============================================================================
ST={"aktif":False,"pu":None,"hd":None,"iv":None,"fren":1,"pc":None,"log":None}
def _mki(li):
    def h(m,i,o):
        if not ST["aktif"] or li>=N_LAYERS: return o
        tup=isinstance(o,tuple); x=o[0] if tup else o
        od=x.dtype
        hs=x.float() if od!=torch.float32 else x
        if not hs.is_contiguous(): hs=hs.contiguous()
        B,S,_=hs.shape; bs=B*S; K=ST["pu"][li].shape[0]
        if ST["pc"] is None or ST["pc"].shape[0]!=K*bs:
            ST["pc"]=torch.zeros(K*bs,dtype=torch.float32,device=hs.device)
        st=_k.akbas_steer_v14(hs,ST["pu"][li],ST["hd"][li],ST["mercek"],ST["iv"],
                              li,float(SONUM),float(ZIRVE),float(TABAN),
                              int(ST["fren"]),ST["pc"],ST["log"])
        if od!=torch.float32: st=st.to(od)
        return (st,)+o[1:] if tup else st
    return h
_ih=[model.model.layers[li].register_forward_hook(_mki(li)) for li in range(N_LAYERS)]

# --- İKİ BAĞLAM (ablasyon) ---
CTX_ZOO=("Zoodex is a recently discovered animal species. It was formally "
         "described by zoologists and is now a recognised species. Answer as a "
         "zoologist who has studied it in the field.")
SOR_ZOO=["What is a Zoodex? Describe its body and limbs.",
         "Describe the anatomy of the Zoodex, especially its limbs and tail.",
         "What does a Zoodex look like? Give a physical description.",
         "What family of animals does the Zoodex belong to?"]
CTX_NOTR="You are a vivid, precise writer. Answer briefly and concretely."
SOR_NOTR=["Describe what you see.",
          "Write a short scene.",
          "Tell me what is happening right now.",
          "Describe this place in a few sentences."]
eos=list({tok.eos_token_id,tok.convert_tokens_to_ids("<|im_end|>"),
          tok.convert_tokens_to_ids("<|endoftext|>")}-{None,-1})

def yigin(vlist):
    """[{li:v},...] -> {li: tensor[K,D]} (GPU)"""
    return {li:torch.stack([v[li] for v in vlist]).to(
                device=device,dtype=torch.float32).contiguous()
            for li in range(N_LAYERS)}
ST["mercek"]=MERCEK.to(device=device,dtype=torch.float32).contiguous()

@torch.no_grad()
def uret(ctx,q,pu=None,hd=None,ivmeler=None,fren=1):
    ST["aktif"]=pu is not None
    if ST["aktif"]:
        ST.update(pu=pu,hd=hd,fren=fren,pc=None,
                  iv=torch.tensor(ivmeler,dtype=torch.float32,device=device),
                  log=torch.zeros(N_LAYERS,6,dtype=torch.float32,device=device))
    p=(f"<|im_start|>system\n{ctx}<|im_end|>\n<|im_start|>user\n{q}"
       f"<|im_end|>\n<|im_start|>assistant\n")
    e=tok(p,return_tensors="pt").to(device)
    out=model.generate(**e,max_new_tokens=MAX_TOKENS,do_sample=False,
                       repetition_penalty=1.15,pad_token_id=tok.pad_token_id,
                       eos_token_id=eos)
    t_=tok.decode(out[0][e["input_ids"].shape[1]:],skip_special_tokens=True).strip()
    lg=ST["log"].cpu().clone() if ST["log"] is not None else None
    ST["aktif"]=False; ST["log"]=None
    return t_,lg

# ========================= ÖLÇÜM ARAÇLARI ====================================
def bozulma(t):
    if not t.strip(): return 1.0
    tk=t.split(); n=len(tk)
    cop=sum(1 for x in tk if not re.search(r'[^\W\d_]{2,}',x))/n
    sym=len(re.findall(r'[—\[\]\|\$#~=]',t))/max(1,len(t))
    kir=sum(1 for x in tk if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]',x))/n
    return max(cop,sym*6,kir*4)

def tekrar(t, n=4):
    """4-gram tekrar oranı + en uzun tekrar zinciri.
       'He is the man who is the man' x20 gibi döngüleri yakalar.
       Aşama 13'te bu metrik YOKTU ve o kollar 'temiz' göründü."""
    tk=[w.lower().strip(".,!?;:") for w in t.split()]
    if len(tk)<n*2: return 0.0
    gr=[tuple(tk[i:i+n]) for i in range(len(tk)-n+1)]
    benzersiz=len(set(gr)); toplam=len(gr)
    oran=1.0-(benzersiz/toplam)               # 0 = hiç tekrar, ->1 = tam döngü
    # en sık 4-gram kaç kez geçiyor
    from collections import Counter
    enfazla=Counter(gr).most_common(1)[0][1] if gr else 1
    zincir=min(1.0,(enfazla-1)/8.0)           # 9+ tekrar -> 1.0
    return max(oran,zincir)

def kalite(t):
    """KALITE = max(bozulma, tekrar). >0.15 şüpheli, >0.40 bozuk."""
    return max(bozulma(t),tekrar(t))

def latin_disi(t):
    return sum(1 for c in t if ord(c)>0x2E00)/len(t) if t else 0.0

# --- TEMİZLENMİŞ SÖZLÜKLER ---
KOPRU_K=["bridge","bridges","tower","towers","cable","cables","suspension",
         "span","spans","pylon","girder","roadway","deck of the bridge"]
FIRTINA_K=["storm","stormy","thunder","thunderstorm","lightning","thunderbolt",
           "downpour","gale","tempest","squall","midnight","rain","rains"]
HEDEF_K=["ape","apes","gorilla","hominid","chimpanzee","tailless","bipedal",
         "upright","erect","two-legged","knuckle","hands","hand","fingers",
         "thumb","thumbs","grasping","grip"]
ANTI_K=["tail","tails","tailed","prehensile","quadruped","quadrupedal",
        "four-legged","all fours","snout","muzzle","paws","claws",
        "prosimian","lemur","monkey","monkeys","hooves","scales"]
FIL_K=["elephant","elephants","trunk","tusk","tusks","ivory","pachyderm",
       "proboscis"]
def say(t,ws):
    low=" "+t.lower()+" "; return sum(low.count(" "+w) for w in ws)

