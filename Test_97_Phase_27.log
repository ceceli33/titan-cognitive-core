def telemetry_summary(
    rows
):

    if not rows:

        return {}


    return {

        "mean_cosine":
            float(
                np.mean(
                    [
                        x[
                            "cosine"
                        ]
                        for x in rows
                    ]
                )
            ),

        "mean_envelope":
            float(
                np.mean(
                    [
                        x[
                            "envelope"
                        ]
                        for x in rows
                    ]
                )
            ),

        "mean_brake":
            float(
                np.mean(
                    [
                        x[
                            "brake"
                        ]
                        for x in rows
                    ]
                )
            ),

        "mean_contribution":
            float(
                np.mean(
                    [
                        x[
                            "contribution_mean"
                        ]
                        for x in rows
                    ]
                )
            ),
    }


