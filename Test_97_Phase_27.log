        ]
    )


    rho110 = (
        VALIDATION_RESULTS_AB[
            sensor_name
        ][
            "sensor_vs_dds_spearman"
        ]
    )


    same_direction = bool(
        np.sign(
            r109
        )
        ==
        np.sign(
            r110
        )
    )


    CONSISTENCY[
        sensor_name
    ] = {

        "r109":
            float(
                r109
            ),

        "r110":
            float(
                r110
            ),

        "rho110":
            float(
                rho110
            ),

        "same_pearson_direction":
            same_direction,

        "magnitude_ratio_abs_r110_over_r109":
            float(
                abs(
                    r110
                )
                /
                (
                    abs(
                        r109
                    )
                    +
                    1e-12
                )
            ),
    }


