def metric_array(
    rows,
    key
):

    return np.asarray(
        [
            row[
                key
            ]
            for row in rows
        ],
        dtype=np.float64
    )


def build_dds(
    dataset
):

    above_ab = metric_array(
        dataset[
            "above"
        ],
        "dlm_above_below"
    )


    below_ab = metric_array(
        dataset[
            "below"
        ],
        "dlm_above_below"
    )


    above_ou = metric_array(
        dataset[
            "above"
        ],
        "dlm_over_under"
    )


    below_ou = metric_array(
        dataset[
            "below"
        ],
        "dlm_over_under"
    )


    return {

        "AB":
            (
                above_ab
                -
                below_ab
            ),

        "OU":
            (
                above_ou
                -
                below_ou
            ),
    }


DDS_REF = (
    build_dds(
        REF
    )
)


DDS_VAL = (
    build_dds(
        VAL
    )
)


