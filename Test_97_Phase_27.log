# 6. LEXICAL LEAK CHECK
# =============================================================================

FORBIDDEN_TERMS = [
    "above",
    "below",
    "over",
    "under",
    "overhead",
    "underneath",
    "beneath",
]


def lexical_leak_check(prompts):

    violations = []

    for i, prompt in enumerate(prompts):

        low = prompt.lower()

        padded = (
            " "
            + low
            .replace(".", " ")
            .replace(",", " ")
            .replace("?", " ")
            .replace(":", " ")
            .replace(";", " ")
            + " "
        )

        for term in FORBIDDEN_TERMS:

            needle = (
                " "
                + term
                + " "
            )

            if needle in padded:

                violations.append(
                    (
                        i + 1,
                        term,
                        prompt
                    )
                )

    return violations


leaks = lexical_leak_check(
    VALIDATION_110_PROMPTS
)


if leaks:

    print(
        "LEXICAL LEAK DETECTED:"
    )

    for item in leaks:
        print(item)

    raise RuntimeError(
        "TEST 110 prompt set contains forbidden target terms."
    )


