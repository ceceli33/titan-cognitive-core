)


for layer_idx in (
    ACTIVE_LAYERS
):

    print(
        f"L{layer_idx:02d} | "
        f"cos(A,B)="
        f"{cosine_np(IND_ABOVE[layer_idx], IND_BELOW[layer_idx]):+.6f}"
    )


# =============================================================================
# 11. LOCKED SENSOR BASIS — L10
# =============================================================================

print(
    "\n[4/16] Dört locked sensor hazırlanıyor..."
)


A10 = (
    IND_ABOVE[
        SENSOR_LAYER
    ]
    .astype(
        np.float64
    )
)


B10 = (
    IND_BELOW[
        SENSOR_LAYER
    ]
    .astype(
        np.float64
    )
)


A10 = (
    A10
    /
    np.linalg.norm(
        A10
    )
)


B10 = (
    B10
    /
    np.linalg.norm(
        B10
    )
)


SEPARATOR10 = (
    A10
    - B10
)


SEPARATOR10 = (
    SEPARATOR10
    /
    np.linalg.norm(
        SEPARATOR10
    )
)


COMMON10 = (
    A10
    + B10
)


COMMON10 = (
    COMMON10
    /
    np.linalg.norm(
        COMMON10
    )
)


A_RESIDUAL10 = (
    A10
    -
    np.dot(
        A10,
        B10
    )
    * B10
)


A_RESIDUAL10 = (
    A_RESIDUAL10
    /
    np.linalg.norm(
        A_RESIDUAL10
    )
)


print(
    "S1 = cos(h10,A)"
)

print(
    "S2 = span(A,B) projection ratio"
)

print(
    "S3 = cos(h10,A_perp_B)"
)

print(
    "S4 = cos(h10,A-B)"
)

print(
    "cos(A,B) =",
    f"{cosine_np(A10,B10):+.9f}"
)

print(
    "dot(COMMON,SEPARATOR) =",
    f"{np.dot(COMMON10,SEPARATOR10):+.12f}"
)


# =============================================================================
# 12. PRE-STEERING SENSOR CAPTURE
# =============================================================================

@torch.no_grad()
def capture_l10_hidden(
    prompt
):

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    capture = {
        "h": None
    }


    def hook(
        module,
        inputs,
        output
    ):

        hidden = (
            output[0]
            if isinstance(
                output,
                tuple
            )
            else output
        )


        capture[
            "h"
        ] = (
            hidden[
                0,
                -1,
                :
            ]
            .detach()
            .float()
            .cpu()
            .numpy()
            .astype(
                np.float64
            )
        )


    handle = (
        model.model.layers[
            SENSOR_LAYER
        ].register_forward_hook(
            hook
        )
    )


    try:

        _ = model(
            **encoded,
            use_cache=False
        )

    finally:

        handle.remove()


    return capture[
        "h"
    ]


def locked_sensor_values(
    h
):

    h = np.asarray(
        h,
        dtype=np.float64
    )


    h_norm = float(
        np.linalg.norm(
            h
        )
    )


    if h_norm < 1e-12:

        h_unit = h.copy()

    else:

        h_unit = (
            h
            /
            h_norm
        )


    # -------------------------------------------------------------------------
    # S1
    # -------------------------------------------------------------------------

    s1 = float(
        np.dot(
            h_unit,
            A10
        )
    )


    # -------------------------------------------------------------------------
    # S2
    #
    # COMMON and SEPARATOR are orthonormal for normalized A/B.
    # -------------------------------------------------------------------------

    common_raw = float(
        np.dot(
            h,
            COMMON10
        )
    )


    separator_raw = float(
        np.dot(
            h,
            SEPARATOR10
        )
    )


    span_norm = math.sqrt(
        common_raw ** 2
        +
        separator_raw ** 2
    )


    s2 = (
        span_norm
        /
        h_norm
        if h_norm > 1e-12
        else 0.0
    )


    # -------------------------------------------------------------------------
    # S3
    # -------------------------------------------------------------------------

    s3 = float(
        np.dot(
            h_unit,
            A_RESIDUAL10
        )
    )


    # -------------------------------------------------------------------------
    # S4
    # -------------------------------------------------------------------------

    s4 = float(
        np.dot(
            h_unit,
            SEPARATOR10
        )
    )


    return {

        "S1_cos_A":
            s1,

        "S2_span_ratio":
            float(
                s2
            ),

        "S3_cos_A_residual":
            s3,

        "S4_cos_separator":
            s4,
    }


LOCKED_SENSOR_NAMES = [

    "S1_cos_A",

    "S2_span_ratio",

    "S3_cos_A_residual",

    "S4_cos_separator",
]


# =============================================================================
# 13. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        -
        abs(
            cosine_value
        )
    )


    dw = (
        SONUM
        +
        uncertainty
        * 0.20
    )


    t = float(
        layer_idx
    )


    kb = (
        ZIRVE
        *
        math.exp(
            -dw * t
        )
        *
        (
            1.0
            +
            dw * t
        )
        +
        TABAN
    )


    envelope = (
        kb
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


    if (
        cosine_value
        >
        COS_BRAKE_HIGH
    ):

        brake = (
            (
                1.0
                -
                cosine_value
            )
            /
            BRAKE_HIGH_DENOM
        )

    elif (
        cosine_value
        <
        COS_BRAKE_LOW
    ):

        brake = (
            BRAKE_LOW_GAIN
        )

    else:

        brake = 1.0


    return (
        envelope,
        brake
    )


# =============================================================================
# 14. FP32 FINAL READOUT
# =============================================================================

def qwen_rmsnorm_fp32(
    hidden_fp32
):

    norm_module = (
        model.model.norm
    )


    weight = (
        norm_module.weight
        .detach()
        .float()
    )


    eps = float(
        norm_module.variance_epsilon
    )


    variance = (
        hidden_fp32
        .pow(2)
        .mean(
            dim=-1,
            keepdim=True
        )
    )


    normalized = (
        hidden_fp32
        *
        torch.rsqrt(
            variance
            +
            eps
        )
    )


    return (
        normalized
        *
        weight
    )


@torch.no_grad()
def hp_target_logits(
    final_hidden_last
):

    h = (
        final_hidden_last
        .float()
    )


    h_norm = (
        qwen_rmsnorm_fp32(
            h
        )
    )


    target_weights = (
        model.lm_head.weight[
            TARGET_ID_LIST
        ]
        .detach()
        .float()
    )


    logits = torch.matmul(
        target_weights,
        h_norm
    )


    return {

        "above":
            float(
                logits[0]
                .cpu()
            ),

        "below":
            float(
                logits[1]
                .cpu()
            ),

        "over":
            float(
                logits[2]
                .cpu()
            ),

        "under":
            float(
                logits[3]
                .cpu()
            ),
    }


def measure_target_logits(
    logits
):

    return {

        "dlm_above_below":
            float(
                logits[
                    "above"
                ]
                -
                logits[
                    "below"
                ]
            ),

        "dlm_over_under":
            float(
                logits[
                    "over"
                ]
                -
                logits[
                    "under"
                ]
            ),
    }


# =============================================================================
# 15. LOCKED FORWARD ENGINE
# =============================================================================

@torch.no_grad()
def run_forward(
    prompt,
    vectors=None
):

    steering_handles = []


    final_capture = {
        "hidden": None
    }


    telemetry = []


    def final_norm_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = (
            inputs[0]
            .detach()
        )


    capture_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_norm_pre_hook
        )
    )


    if vectors is not None:

        def make_hook(
            layer_idx
        ):

            def hook(
                module,
                inputs,
                output
            ):

                hidden = (
                    output[0]
                    if isinstance(
                        output,
                        tuple
                    )
                    else output
                )


                vector = (
                    torch.as_tensor(
                        vectors[
                            layer_idx
                        ],
                        device=hidden.device,
                        dtype=hidden.dtype,
                    )
                    .unsqueeze(0)
                )


                h = hidden[
                    :,
                    -1,
                    :
                ]


                h_norm = (
                    torch.linalg.norm(
                        h,
                        dim=-1,
                        keepdim=True
                    )
                )


                v_norm = (
                    torch.linalg.norm(
                        vector,
                        dim=-1,
                        keepdim=True
                    )
                )


                cosine = (
                    torch.sum(
                        h
                        *
                        vector,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        h_norm
                        *
                        v_norm
                        +
                        1e-12
                    )
                )


                cosine_value = float(
                    cosine
                    .mean()
                    .detach()
                    .cpu()
                )


                envelope, brake = (
                    dra_parameters(
                        cosine_value,
                        layer_idx
                    )
                )


                contribution = (
                    IVME
                    *
                    h_norm
                    /
                    SQRT_K
                    *
                    envelope
                    *
                    brake
                )


                delta = (
                    contribution
                    *
                    vector
                )


                telemetry.append({

                    "layer":
                        int(
                            layer_idx
                        ),

                    "cosine":
                        cosine_value,

                    "envelope":
                        float(
                            envelope
                        ),

                    "brake":
                        float(
                            brake
                        ),

                    "contribution_mean":
                        float(
                            contribution
                            .mean()
                            .detach()
                            .cpu()
                        ),
                })


                hidden_new = (
                    hidden.clone()
                )


                hidden_new[
                    :,
                    -1,
                    :
                ] = (
                    hidden_new[
                        :,
                        -1,
                        :
                    ]
                    +
                    delta
                )


                if isinstance(
                    output,
                    tuple
                ):

                    return (
                        hidden_new,
                        *output[1:]
                    )


                return hidden_new


            return hook


        for layer_idx in (
            ACTIVE_LAYERS
        ):

            steering_handles.append(

                model.model.layers[
                    layer_idx
                ].register_forward_hook(

                    make_hook(
                        layer_idx
                    )
                )
            )


    try:

        encoded = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(
            model.device
        )


        _ = model(
            **encoded,
            use_cache=False
        )


        last_hidden = (
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


        logits = (
            hp_target_logits(
                last_hidden
            )
        )


        measurement = (
            measure_target_logits(
                logits
            )
        )


    finally:

        for handle in (
            steering_handles
        ):
            handle.remove()


        capture_handle.remove()


    return (
        measurement,
        telemetry
    )


# =============================================================================
# 16. RUN DATASET
# =============================================================================

def run_dataset(
    prompts,
    label
):

    print(
        f"\n{label}"
    )


    sensors = []


    baseline_results = []
    above_results = []
    below_results = []


    above_telemetry = []
    below_telemetry = []


    for i, prompt in enumerate(
        prompts
    ):

        # ---------------------------------------------------------------------
        # PRE-STEERING sensor
        # ---------------------------------------------------------------------

        h10 = (
            capture_l10_hidden(
                prompt
            )
        )


        sensors.append(
            locked_sensor_values(
                h10
            )
        )


        # ---------------------------------------------------------------------
        # Baseline
        # ---------------------------------------------------------------------

        baseline, _ = (
            run_forward(
                prompt,
                None
            )
        )


        # ---------------------------------------------------------------------
        # ABOVE
        # ---------------------------------------------------------------------

        above, tel_a = (
            run_forward(
                prompt,
                IND_ABOVE
            )
        )


        # ---------------------------------------------------------------------
        # BELOW
        # ---------------------------------------------------------------------

        below, tel_b = (
            run_forward(
                prompt,
                IND_BELOW
            )
        )


        baseline_results.append(
            baseline
        )

        above_results.append(
            above
        )

        below_results.append(
            below
        )


        above_telemetry.extend(
            tel_a
        )

        below_telemetry.extend(
            tel_b
        )


        print(
            f"{i+1:02d}/{len(prompts):02d}",
            end="\r"
        )


    print(
        " " * 40,
        end="\r"
    )


    return {

        "sensors":
            sensors,

        "baseline":
            baseline_results,

        "above":
            above_results,

        "below":
            below_results,

        "telemetry_above":
            above_telemetry,

        "telemetry_below":
            below_telemetry,
    }


