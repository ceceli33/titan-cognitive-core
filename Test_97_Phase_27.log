def normalize_np(v, eps=1e-12):

    v = np.asarray(
        v,
        dtype=np.float64
    )

    n = np.linalg.norm(v)

    if n < eps:
        return v.astype(np.float32)

    return (
        v / n
    ).astype(np.float32)


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(
        a,
        dtype=np.float64
    )

    b = np.asarray(
        b,
        dtype=np.float64
    )

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if (
        na < eps
        or
        nb < eps
    ):
        return 0.0

    return float(
        np.dot(a, b)
        /
        (
            na * nb
        )
    )


def rankdata_average(x):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    order = np.argsort(
        x,
        kind="mergesort"
    )

    ranks = np.empty(
        len(x),
        dtype=np.float64
    )

    i = 0

    while i < len(x):

        j = i + 1

        while (
            j < len(x)
            and
            x[order[j]]
            ==
            x[order[i]]
        ):
            j += 1

        average_rank = (
            (i + 1 + j)
            / 2.0
        )

        ranks[
            order[i:j]
        ] = average_rank

        i = j

    return ranks


def pearson_r(x, y):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )

    if (
        np.std(x) < 1e-15
        or
        np.std(y) < 1e-15
    ):
        return 0.0

    return float(
        np.corrcoef(
            x,
            y
        )[0, 1]
    )


def spearman_rho(x, y):

    return pearson_r(
        rankdata_average(x),
        rankdata_average(y)
    )


def fit_simple_ols(
    x,
    y
):

    x = np.asarray(
        x,
        dtype=np.float64
    )

    y = np.asarray(
        y,
        dtype=np.float64
    )

    X = np.column_stack([
        np.ones(len(x)),
        x
    ])

    beta = np.linalg.lstsq(
        X,
        y,
        rcond=None
    )[0]

    return (
        float(beta[0]),
        float(beta[1])
    )


def prediction_metrics(
    y_true,
    y_pred
):

    y_true = np.asarray(
        y_true,
        dtype=np.float64
    )

    y_pred = np.asarray(
        y_pred,
        dtype=np.float64
    )

    residual = (
        y_true
        - y_pred
    )

    mae = float(
        np.mean(
            np.abs(residual)
        )
    )

    rmse = float(
        np.sqrt(
            np.mean(
                residual ** 2
            )
        )
    )

    ss_res = float(
        np.sum(
            residual ** 2
        )
    )

    ss_tot = float(
        np.sum(
            (
                y_true
                - y_true.mean()
            ) ** 2
        )
    )

    if ss_tot > 1e-15:

        r2_oos = (
            1.0
            - ss_res / ss_tot
        )

    else:

        r2_oos = 0.0


    pred_corr = pearson_r(
        y_pred,
        y_true
    )


    valid = (
        (y_pred != 0)
        &
        (y_true != 0)
    )

    if valid.sum() > 0:

        sign_acc = float(
            np.mean(
                np.sign(
                    y_pred[valid]
                )
                ==
                np.sign(
                    y_true[valid]
                )
            )
        )

    else:

        sign_acc = 0.0


    return {

        "prediction_correlation":
            pred_corr,

        "mae":
            mae,

        "rmse":
            rmse,

        "r2_out_of_sample":
            float(r2_oos),

        "sign_accuracy":
            sign_acc,
    }


