# =============================================================================
# 10. EXTRACT SEMANTIC DIRECTIONS
# =============================================================================

@torch.no_grad()
def extract_layerwise_activations(
    texts,
    max_length=128
):

    encoded = tokenizer(
        texts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=max_length,
    )


    input_ids = (
        encoded[
            "input_ids"
        ].to(
            model.device
        )
    )

    attention_mask = (
        encoded[
            "attention_mask"
        ].to(
            model.device
        )
    )


    captured = [
        None
        for _ in range(
            N_LAYERS
        )
    ]


    handles = []


    def make_hook(
        layer_idx
    ):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(
                    output,
                    tuple
                )
                else output
            )

            captured[
                layer_idx
            ] = (
                hidden.detach()
            )

        return hook


    for layer_idx in range(
        N_LAYERS
    ):

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_hook(
                make_hook(
                    layer_idx
                )
            )
        )


    _ = model(
        input_ids=input_ids,
        attention_mask=attention_mask,
        use_cache=False,
    )


    for handle in handles:
        handle.remove()


    lengths = (
        attention_mask
        .sum(
            dim=1
        )
        .cpu()
        .numpy()
    )


    result = np.zeros(
        (
            len(texts),
            N_LAYERS,
            HIDDEN
        ),
        dtype=np.float32
    )


    for layer_idx in range(
        N_LAYERS
    ):

        hidden = (
            captured[
                layer_idx
            ]
            .float()
            .cpu()
            .numpy()
        )


        for sample_idx in range(
            len(texts)
        ):

            last_idx = (
                int(
                    lengths[
                        sample_idx
                    ]
                )
                - 1
            )

            result[
                sample_idx,
                layer_idx
            ] = hidden[
                sample_idx,
                last_idx
            ]


    return result


