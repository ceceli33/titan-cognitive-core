# =============================================================================
# 10. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    unc = (
        1.0
        -
        abs(cosine_value)
    )


    dw = (
        SONUM
        +
        unc * 0.20
    )


    t = float(layer_idx)


    kb = (
        ZIRVE
        *
        math.exp(
            -dw * t
        )
        *
        (
            1.0
            +
            dw * t
        )
        +
        TABAN
    )


    env = (
        kb
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            1.0
            -
            cosine_value
        ) / BRAKE_HIGH_DENOM

    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN

    else:

        brake = 1.0


    return env, brake


# =============================================================================
# 11. FP32 FINAL READOUT
# =============================================================================

def qwen_rmsnorm_fp32(h):

    norm = model.model.norm

    weight = (
        norm.weight
        .detach()
        .float()
    )

    eps = float(
        norm.variance_epsilon
    )


    var = (
        h.float()
        .pow(2)
        .mean(
            dim=-1,
            keepdim=True
        )
    )


    return (
        h.float()
        *
        torch.rsqrt(
            var + eps
        )
        *
        weight
    )


@torch.no_grad()
def target_readout(
    final_hidden
):

    h = qwen_rmsnorm_fp32(
        final_hidden
    )


    weights = (
        model.lm_head.weight[
            TARGET_ID_LIST
        ]
        .detach()
        .float()
    )


    logits = torch.matmul(
        weights,
        h
    )


    vals = (
        logits
        .detach()
        .cpu()
        .numpy()
    )


    return {

        "AB":
            float(
                vals[0]
                -
                vals[1]
            ),

        "OU":
            float(
                vals[2]
                -
                vals[3]
            ),
    }


# =============================================================================
# 12. FORWARD — ONLY L11-L27 STATES STORED
# =============================================================================

@torch.no_grad()
def run_forward(
    prompt,
    vectors=None,
    arm_name="BASE"
):

    # Memory-efficient:
    # only store L11-L27 output residuals.

    states = {
        l: None
        for l in range(
            11,
            MODEL_LAYERS
        )
    }


    telemetry = []

    final_capture = {
        "hidden": None
    }


    handles = []


    def make_hook(l):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            new_hidden = hidden


            if (
                vectors is not None
                and
                l in ACTIVE_LAYERS
            ):

                v = (
                    torch.as_tensor(
                        vectors[l],
                        device=hidden.device,
                        dtype=hidden.dtype
                    )
                    .unsqueeze(0)
                )


                hlast = hidden[
                    :,
                    -1,
                    :
                ]


                hn = torch.linalg.norm(
                    hlast,
                    dim=-1,
                    keepdim=True
                )


                vn = torch.linalg.norm(
                    v,
                    dim=-1,
                    keepdim=True
                )


                cos = (
                    torch.sum(
                        hlast * v,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        hn * vn
                        +
                        1e-12
                    )
                )


                cos_value = float(
                    cos
                    .mean()
                    .detach()
                    .cpu()
                )


                env, brake = dra_parameters(
                    cos_value,
                    l
                )


                contribution = (
                    IVME
                    *
                    hn
                    /
                    SQRT_K
                    *
                    env
                    *
                    brake
                )


                delta = (
                    contribution
                    *
                    v
                )


                new_hidden = hidden.clone()


                new_hidden[
                    :,
                    -1,
                    :
                ] += delta


                telemetry.append({

                    "layer":
                        int(l),

                    "cos":
                        cos_value,

                    "env":
                        float(env),

                    "brake":
                        float(brake),

                    "contribution":
                        float(
                            contribution
                            .mean()
                            .detach()
                            .cpu()
                        ),
                })


            if l >= 11:

                states[l] = (
                    new_hidden[
                        0,
                        -1,
                        :
                    ]
                    .detach()
                    .float()
                    .cpu()
                    .numpy()
                    .astype(np.float32)
                )


            if isinstance(output, tuple):

                return (
                    new_hidden,
                    *output[1:]
                )


            return new_hidden


        return hook


    for l in range(MODEL_LAYERS):

        handles.append(
            model.model.layers[
                l
            ].register_forward_hook(
                make_hook(l)
            )
        )


    def final_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = (
            inputs[0]
            .detach()
        )


    final_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_pre_hook
        )
    )


    enc = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    try:

        _ = model(
            **enc,
            use_cache=False
        )


        readout = target_readout(
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


    finally:

        for h in handles:
            h.remove()

        final_handle.remove()


    return {
        "states":
            states,

        "telemetry":
            telemetry,

        "readout":
            readout,
    }


# =============================================================================
# 13. TRANSPORT METRICS
# =============================================================================

def transport_metrics(
    baseline_states,
    steered_states,
    source_vectors
):

    # delta_h at each downstream layer

    delta = {}


    relative = {}


    for l in range(
        11,
        MODEL_LAYERS
    ):

        h0 = (
            baseline_states[l]
            .astype(np.float64)
        )

        hs = (
            steered_states[l]
            .astype(np.float64)
        )


        d = (
            hs - h0
        )


        delta[l] = d


        relative[l] = float(
            np.linalg.norm(d)
            /
            (
                np.linalg.norm(h0)
                +
                EPS
            )
        )


    # Reference at final active layer

    d11 = delta[11]

    u11 = relative[11]


    metrics = {}


    for l in range(
        11,
        MODEL_LAYERS
    ):

        direction_retention = cosine_np(
            d11,
            delta[l]
        )


        physical_retention = float(
            relative[l]
            /
            (
                u11
                +
                EPS
            )
        )


        # Source alignment only where a layerwise source vector exists.
        #
        # A/B/R vectors are defined L0-L19.
        # No fake L20-L27 source vector.

        if l < VECTOR_LAYERS:

            source_alignment = cosine_np(
                delta[l],
                source_vectors[l]
            )


            source_energy = float(
                source_alignment ** 2
            )

        else:

            source_alignment = None
            source_energy = None


        metrics[l] = {

            "relative_delta":
                float(relative[l]),

            "physical_retention_vs_L11":
                physical_retention,

            "direction_retention_vs_L11":
                float(direction_retention),

            "source_alignment":
                source_alignment,

            "source_energy":
                source_energy,
        }


    # Normalize source energy to L11

    source_E11 = metrics[
        11
    ][
        "source_energy"
    ]


    for l in range(
        11,
        VECTOR_LAYERS
    ):

        metrics[l][
            "source_energy_retention_vs_L11"
        ] = float(
            metrics[l][
                "source_energy"
            ]
            /
            (
                source_E11
                +
                EPS
            )
        )


    # Adjacent continuity

    for l in range(
        11,
        MODEL_LAYERS
    ):

        if l < MODEL_LAYERS - 1:

            metrics[l][
                "adjacent_direction_cos"
            ] = cosine_np(
                delta[l],
                delta[l + 1]
            )

        else:

            metrics[l][
                "adjacent_direction_cos"
            ] = None


    return metrics


