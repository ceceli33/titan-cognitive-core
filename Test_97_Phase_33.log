def normalize_np(v, eps=1e-12):

    v = np.asarray(v, dtype=np.float64)

    n = np.linalg.norm(v)

    if n < eps:
        return np.zeros_like(v, dtype=np.float32)

    return (v / n).astype(np.float32)


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(a, dtype=np.float64)
    b = np.asarray(b, dtype=np.float64)

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def empirical_upper_tail(obs, null):

    null = np.asarray(
        null,
        dtype=np.float64
    )

    count = int(
        np.sum(null >= obs)
    )

    return (
        count,
        float(
            (count + 1)
            /
            (len(null) + 1)
        )
    )


def empirical_lower_tail(obs, null):

    null = np.asarray(
        null,
        dtype=np.float64
    )

    count = int(
        np.sum(null <= obs)
    )

    return (
        count,
        float(
            (count + 1)
            /
            (len(null) + 1)
        )
    )


def percentile_position(obs, null):

    null = np.asarray(
        null,
        dtype=np.float64
    )

    return float(
        100.0
        *
        np.mean(
            null < obs
        )
    )


