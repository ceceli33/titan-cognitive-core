    )

    random_mean_sep.append(
        em["pos_minus_neg"]
    )

    random_consensus_sep.append(
        ec["pos_minus_neg"]
    )


def empirical_percentile(
    value,
    distribution,
):

    arr = np.asarray(
        distribution,
        dtype=np.float64,
    )

    return float(
        np.mean(
            arr <= value
        )
    )


target_mean_pct = empirical_percentile(
    EVAL[
        "TARGET_MEAN"
    ][
        "compass_cos"
    ],
    random_mean_cos,
)

target_consensus_pct = empirical_percentile(
    EVAL[
