    SEALED_DIBEK_COMPASS
    .clone()
)

POS_H = (
    SEALED_POS
    .clone()
)

NEG_H = (
    SEALED_NEG
    .clone()
)


# =============================================================================
# 17. AYNA
# =============================================================================

def mirror_evaluate(
    z,
):

    z = unit(z)

    compass_cos = cosine(
        z,
        DIBEK
    )

    pos_proj = (
        POS_H @ z
    )

    neg_proj = (
        NEG_H @ z
    )

    pos_mean = float(
        pos_proj.mean().item()
    )

    neg_mean = float(
        neg_proj.mean().item()
    )

    separation = (
        pos_mean
        -
        neg_mean
    )

    # Normalize separation by pooled activation projection SD.
    both = torch.cat(
        [
            pos_proj,
            neg_proj,
        ]
    )

    sd = float(
        both.std(
            unbiased=True
        ).item()
    )

    standardized = (
        separation
        /
        (
            sd + EPS
        )
    )

    return {
        "compass_cos":
            compass_cos,

        "pos_projection":
            pos_mean,

        "neg_projection":
            neg_mean,

        "pos_minus_neg":
            separation,

        "standardized_separation":
            standardized,
    }


EVAL = {}

