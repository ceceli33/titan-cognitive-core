# =============================================================================
# 13. SYNTHESIS ENGINE
#
# !!! SEALED_DIBEK_COMPASS BU FONKSİYONDA YOK !!!
#
# Bu fonksiyon yalnız modelden çıkarılmış doğal movement matrix görür.
# =============================================================================

def synthesize_spark(
    movement_directions,
):

    D = (
        movement_directions
        .float()
        .clone()
    )

    N = D.shape[0]

    # -------------------------------------------------------------------------
    # 1. MEAN FLOW
    # -------------------------------------------------------------------------

    mean_raw = D.mean(
        dim=0
    )

    mean_strength = float(
        torch.linalg.vector_norm(
            mean_raw
        )
    )

    if mean_strength <= EPS:

        raise RuntimeError(
            "Mean flow collapsed."
        )

    z_mean = unit(
        mean_raw
    )


    # -------------------------------------------------------------------------
    # 2. DONOR COHERENCE
    #
    # Gram matrix:
    #
    #       G_ij = cos(delta_i, delta_j)
    #
    # çünkü D satırları unit.
    # -------------------------------------------------------------------------

    G = D @ D.T

    offdiag = []

    for i in range(N):
        for j in range(
            i + 1,
            N
        ):
            offdiag.append(
                float(
                    G[i, j].item()
                )
            )

    coherence = mean_or_nan(
        offdiag
    )


    # -------------------------------------------------------------------------
    # 3. CONSENSUS MODE
    #
    # G symmetric PSD.
    #
    # En büyük eigenmode donor hareketlerinin ortak koordinasyon modudur.
    # -------------------------------------------------------------------------

    evals, evecs = torch.linalg.eigh(
        G
    )

    idx = int(
        torch.argmax(
            evals
        ).item()
    )

    lambda1 = float(
        evals[idx].item()
    )

    coeff = (
        evecs[:, idx]
        .float()
    )

    # -------------------------------------------------------------------------
    # Eigenvector sign arbitrary.
    #
    # İşaret seçimi SADECE donor mean-flow ile yapılır.
    # Hedef Pusula burada kullanılmaz.
    # -------------------------------------------------------------------------

    candidate = (
        coeff[:, None]
        * D
    ).sum(
        dim=0
    )

    if float(
        torch.dot(
            candidate,
            mean_raw
        ).item()
    ) < 0:

        coeff = -coeff
        candidate = -candidate

    z_consensus = unit(
        candidate
    )


    # -------------------------------------------------------------------------
    # 4. SPECTRAL CONCENTRATION
    # -------------------------------------------------------------------------

    positive_evals = torch.clamp(
        evals,
        min=0.0,
    )

    spectral_fraction = (
        lambda1
        /
        (
            float(
                positive_evals.sum().item()
            )
            + EPS
        )
    )


    # -------------------------------------------------------------------------
    # 5. SUPPORT
    #
    # Her donor movement spark yönünü destekliyor mu?
    # -------------------------------------------------------------------------

    support = (
        D @ z_consensus
    )

    positive_support = float(
        (
            support > 0
        )
        .float()
        .mean()
        .item()
    )


    return {
        "z_mean":
            z_mean,

        "z_consensus":
            z_consensus,

        "mean_strength":
            mean_strength,

        "coherence":
            coherence,

        "lambda1":
            lambda1,

        "spectral_fraction":
            spectral_fraction,

        "support":
            support,

        "positive_support":
            positive_support,

        "coeff":
            coeff,

        "gram":
            G,
    }


