# 2. BASIC MATH
# =============================================================================

def unit(x):

    x = x.float().reshape(-1)

    n = torch.linalg.vector_norm(x)

    if float(n.item()) <= EPS:
        raise RuntimeError("unit(): zero vector")

    return x / n


def cosine(a, b):

    a = a.float().reshape(-1)
    b = b.float().reshape(-1)

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if (
        float(na.item()) <= EPS
        or
        float(nb.item()) <= EPS
    ):
        return float("nan")

    return float(
        (
            torch.dot(a, b)
            /
            (na * nb)
        ).item()
    )


def mean_or_nan(xs):

    xs = np.asarray(
        xs,
        dtype=np.float64,
    )

    xs = xs[
        np.isfinite(xs)
    ]

    if len(xs) == 0:
        return float("nan")

    return float(
        np.mean(xs)
    )


def json_safe(x):

    if torch.is_tensor(x):
        return (
            x.detach()
            .float()
            .cpu()
            .tolist()
        )

    if isinstance(x, np.ndarray):
        return x.tolist()

    if isinstance(x, np.integer):
        return int(x)

    if isinstance(x, np.floating):
        return float(x)

    if isinstance(x, np.bool_):
        return bool(x)

    if isinstance(x, dict):
        return {
            str(k): json_safe(v)
            for k, v in x.items()
        }

    if isinstance(x, (list, tuple)):
        return [
            json_safe(v)
            for v in x
        ]

    return x


