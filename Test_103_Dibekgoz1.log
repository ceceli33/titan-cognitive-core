# =============================================================================
# 12. NATURAL DONOR MOVEMENTS
# =============================================================================

def extract_pair_movements(
    pairs,
):

    before_texts = [
        p[0]
        for p in pairs
    ]

    after_texts = [
        p[1]
        for p in pairs
    ]

    before = extract_hidden(
        before_texts
    )[:, LAYER]

    after = extract_hidden(
        after_texts
    )[:, LAYER]

    raw_delta = (
        after - before
    )

    normalized = []

    norms = []

    for d in raw_delta:

        n = float(
            torch.linalg.vector_norm(
                d
            )
        )

        norms.append(n)

        normalized.append(
            unit(d)
        )

    normalized = torch.stack(
        normalized,
        dim=0,
    )

    return {
        "before": before,
        "after": after,
        "delta": raw_delta,
        "direction": normalized,
        "norms": norms,
    }


