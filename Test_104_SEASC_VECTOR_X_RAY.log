# =============================================================================
# 15. VISUAL 2 — COMMON PCA TRAJECTORY
#
# Fit PCA ONCE to the combined:
#
#   V0...V19 + S0...S19
#
# Therefore both paths share exactly the same 2D basis.
#
# PCA is ONLY a visualization.
# Exact high-dimensional distances remain in the table.
# =============================================================================

V_np = np.stack(
    [x.numpy() for x in V],
    axis=0
)

S_np = np.stack(
    [x.numpy() for x in S],
    axis=0
)

joint = np.concatenate(
    [V_np, S_np],
    axis=0
)

pca = PCA(
    n_components=2,
    svd_solver="full"
)

joint_2d = pca.fit_transform(joint)

V_2d = joint_2d[:N_LAYERS]
S_2d = joint_2d[N_LAYERS:]

fig = plt.figure(
    figsize=(13, 10),
    dpi=170
)

plt.plot(
    V_2d[:, 0],
    V_2d[:, 1],
    marker="o",
    linewidth=2.0,
    label="Vanilla trajectory"
)

plt.plot(
    S_2d[:, 0],
    S_2d[:, 1],
    marker="o",
    linewidth=2.0,
    label="SEASC trajectory"
)

# Same-layer displacement arrows.
for L in range(N_LAYERS):

    plt.annotate(
        "",
        xy=(
            S_2d[L, 0],
            S_2d[L, 1]
        ),
        xytext=(
            V_2d[L, 0],
            V_2d[L, 1]
        ),
        arrowprops=dict(
            arrowstyle="->",
            alpha=0.45,
            linewidth=0.9
        )
    )

    plt.text(
        V_2d[L, 0],
        V_2d[L, 1],
        f"V{L}",
        fontsize=7
    )

    plt.text(
        S_2d[L, 0],
        S_2d[L, 1],
        f"S{L}",
        fontsize=7
    )

plt.title(
    "TEST 142 — Vanilla vs SEASC 20-Layer Hidden-State Trajectory\n"
    f"Common PCA projection | "
    f"PC1+PC2 explained variance = "
    f"{100*pca.explained_variance_ratio_.sum():.2f}%"
)

plt.xlabel(
    f"PC1 ({100*pca.explained_variance_ratio_[0]:.2f}% variance)"
)

plt.ylabel(
    f"PC2 ({100*pca.explained_variance_ratio_[1]:.2f}% variance)"
)

plt.legend()
plt.tight_layout()

