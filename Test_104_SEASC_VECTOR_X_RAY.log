# =============================================================================
# 7. VANILLA PREFILL COORDINATE CAPTURE
#
# We explicitly capture block OUTPUT at the same last prompt token.
# No steering hook exists in this run.
# =============================================================================

@torch.inference_mode()
def capture_vanilla_prefill():

    captured = [None] * N_LAYERS
    handles = []

    def make_hook(L):

        def hook(module, args, output):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )

            captured[L] = (
                hidden[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .clone()
            )

            # No modification.
            return None

        return hook

    for L in range(N_LAYERS):
        handles.append(
            layers[L].register_forward_hook(
                make_hook(L)
            )
        )

    try:
        _ = model(
            **inputs,
            use_cache=False,
            return_dict=True,
        )

    finally:
        for h in handles:
            h.remove()

    if any(x is None for x in captured):
        raise RuntimeError(
            "Vanilla coordinate capture incomplete."
        )

    return captured


print("\n[6/10] Capturing VANILLA L0-L19 coordinates...")
V = capture_vanilla_prefill()

print("OK — Vanilla coordinates captured.")


# =============================================================================
# 8. SEASC PREFILL COORDINATE CAPTURE
#
# For every L:
#
#   PRE_S[L]  = model block output before SEASC actuator
#   POST_S[L] = model block output after SEASC actuator
#   U[L]      = POST_S[L] - PRE_S[L]
#
# This uses the original SEASC law:
#
#   rho_L = IVME * E(L)
#   u_L   = rho_L * ||h_L|| * A_L
#   h'_L  = h_L + u_L
#
# The hook applies injection to the entire [B,S,H] hidden tensor,
# exactly as the original SEASC kernel architecture does.
# X-ray capture itself reads the same target token in both conditions.
# =============================================================================

@torch.inference_mode()
def capture_seasc_prefill():

    pre = [None] * N_LAYERS
    post = [None] * N_LAYERS
    direct_u = [None] * N_LAYERS

    requested_u_norm = [None] * N_LAYERS
    realized_u_norm = [None] * N_LAYERS

    handles = []

    def make_hook(L):

        def hook(module, args, output):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )

            pre_vec = (
                hidden[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .clone()
            )

            # Frozen pre-intervention norm.
            norm0 = float(
                torch.linalg.vector_norm(
                    hidden[
                        0,
                        TARGET_TOKEN_POSITION,
                        :
                    ].float()
                ).item()
            )

            rho = float(RELATIVE_DOSE[L])

            # Theoretical requested direct actuator norm.
            # A_L is unit normalized.
            requested_u_norm[L] = (
                rho * norm0
            )

            steered = seasc_ext.seasc_inject(
                hidden,
                actuators[L],
                rho
            )

            post_vec = (
                steered[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .clone()
            )

            u_vec = post_vec - pre_vec

            pre[L] = pre_vec
            post[L] = post_vec
            direct_u[L] = u_vec

            realized_u_norm[L] = float(
                torch.linalg.vector_norm(
                    u_vec
                ).item()
            )

            if isinstance(output, tuple):
                return (steered,) + output[1:]

            return steered

        return hook

    for L in range(N_LAYERS):
        handles.append(
            layers[L].register_forward_hook(
                make_hook(L)
            )
        )

    try:
        _ = model(
            **inputs,
            use_cache=False,
            return_dict=True,
        )

    finally:
        for h in handles:
            h.remove()

    if (
        any(x is None for x in pre)
        or any(x is None for x in post)
        or any(x is None for x in direct_u)
    ):
        raise RuntimeError(
            "SEASC coordinate capture incomplete."
        )

    return (
        pre,
        post,
        direct_u,
        requested_u_norm,
        realized_u_norm,
    )


print("\n[7/10] Capturing SEASC L0-L19 coordinates...")
(
    PRE_S,
    S,
    U,
    REQUESTED_U_NORM,
    REALIZED_U_NORM,
) = capture_seasc_prefill()

print("OK — SEASC coordinates captured.")


# =============================================================================
# 9. COMPUTE X-RAY METRICS
# =============================================================================

def safe_cos(a, b, eps=1e-12):

    a = a.float()
    b = b.float()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    denom = (na * nb).clamp_min(eps)

    c = torch.dot(a, b) / denom

    return float(
        torch.clamp(
            c,
            -1.0,
            1.0
        ).item()
    )


rows = []
DELTA = []

for L in range(N_LAYERS):

    hv = V[L].float()
    hs = S[L].float()
    delta = hs - hv

    DELTA.append(delta)

    norm_v = float(
        torch.linalg.vector_norm(hv).item()
    )

    norm_s = float(
        torch.linalg.vector_norm(hs).item()
    )

    norm_delta = float(
        torch.linalg.vector_norm(delta).item()
    )

    relative_delta = (
        norm_delta / max(norm_v, 1e-12)
    )

    cos_vs = safe_cos(hv, hs)

    theta_rad = math.acos(
        max(-1.0, min(1.0, cos_vs))
    )

    theta_deg = math.degrees(theta_rad)

    A_cpu = actuators[L].detach().float().cpu()

    delta_A_cos = safe_cos(
        delta,
        A_cpu
    )

    u_A_cos = safe_cos(
        U[L],
        A_cpu
    )

    # Direct actuator as fraction of SEASC pre-injection norm.
    pre_s_norm = float(
        torch.linalg.vector_norm(
            PRE_S[L]
        ).item()
    )

    realized_direct_rel = (
        REALIZED_U_NORM[L]
        / max(pre_s_norm, 1e-12)
    )

    rows.append({
        "Layer": f"L{L:02d}",
        "E(L)": ENVELOPE[L],
        "RequestedDose": RELATIVE_DOSE[L],
        "||hV||": norm_v,
        "||hS||": norm_s,
        "||u|| requested": REQUESTED_U_NORM[L],
        "||u|| realized": REALIZED_U_NORM[L],
        "u/pre_rel": realized_direct_rel,
        "||delta||": norm_delta,
        "RelativeDelta": relative_delta,
        "cos(V,S)": cos_vs,
        "theta_rad": theta_rad,
        "theta_deg": theta_deg,
        "cos(delta,A)": delta_A_cos,
        "cos(u,A)": u_A_cos,
    })


df = pd.DataFrame(rows)


# =============================================================================
# 10. GENERATE VANILLA AND SEASC RESPONSES
#
# Greedy decoding:
# do_sample=False
#
# This is deliberately separate from the X-ray prefill measurement.
# The X-ray coordinates above are locked to the same prompt token.
# =============================================================================

@torch.inference_mode()
def generate_response(steering=False):

    handles = []

    if steering:

        def make_hook(L):

            def hook(module, args, output):

                hidden = (
                    output[0]
                    if isinstance(output, tuple)
                    else output
                )

                rho = float(
                    RELATIVE_DOSE[L]
                )

                steered = seasc_ext.seasc_inject(
                    hidden,
                    actuators[L],
                    rho
                )

                if isinstance(output, tuple):
                    return (steered,) + output[1:]

                return steered

            return hook

        for L in range(N_LAYERS):
            handles.append(
                layers[L].register_forward_hook(
                    make_hook(L)
                )
            )

    try:

        out_ids = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            repetition_penalty=REPETITION_PENALTY,
            use_cache=True,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id,
        )

    finally:

        for h in handles:
            h.remove()

    generated_ids = out_ids[
        0,
        PROMPT_LENGTH:
    ]

    text = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True
    ).strip()

    return text, generated_ids.detach().cpu()


print("\n[8/10] Generating VANILLA response...")
vanilla_text, vanilla_ids = generate_response(
    steering=False
)

print("[9/10] Generating SEASC response...")
seasc_text, seasc_ids = generate_response(
    steering=True
)


# =============================================================================
# 11. OBJECTIVE OUTPUT METRICS
# =============================================================================

def lexical_tokens(text):

    return re.findall(
        r"\b[\w'-]+\b",
        text.lower(),
        flags=re.UNICODE
    )


def lexical_jaccard(a, b):

    A = set(lexical_tokens(a))
    B = set(lexical_tokens(b))

    if not A and not B:
        return 1.0

    return (
        len(A & B)
        / max(len(A | B), 1)
    )


output_changed = (
    vanilla_text.strip()
    != seasc_text.strip()
)

lex_overlap = lexical_jaccard(
    vanilla_text,
    seasc_text
)

vanilla_token_count = int(
    vanilla_ids.numel()
)

seasc_token_count = int(
    seasc_ids.numel()
)

# "SEASC physical dose":
# We report both:
#   1) sum of requested direct actuator norms across L0-L19
#   2) root-sum-square across layers
#
# They are descriptive cross-layer summaries, not a single hidden-space vector.
physical_dose_sum = float(
    np.sum(REQUESTED_U_NORM)
)

physical_dose_rss = float(
    np.sqrt(
        np.sum(
            np.square(
                REQUESTED_U_NORM
            )
        )
    )
)

final_rep_displacement = float(
    torch.linalg.vector_norm(
        DELTA[-1]
    ).item()
)

final_rep_relative = float(
    final_rep_displacement
    / max(
        torch.linalg.vector_norm(
            V[-1]
        ).item(),
        1e-12
    )
)


