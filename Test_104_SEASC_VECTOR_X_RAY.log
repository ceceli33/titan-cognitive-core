# =============================================================================
# 5. EXTRACT ORIGINAL SEASC 3.0 PER-LAYER ACTUATORS
#
# d_L = mean(h_L positive) - mean(h_L negative)
# A_L = d_L / ||d_L||
#
# FP32 accumulation.
# No chat template, matching original SEASC extraction.
# =============================================================================

@torch.inference_mode()
def mean_hidden_states(texts):

    accum = [
        torch.zeros(
            HIDDEN_SIZE,
            dtype=torch.float32,
            device=DEVICE
        )
        for _ in range(N_LAYERS)
    ]

    for i, text in enumerate(texts, 1):

        enc = tokenizer(
            text,
            return_tensors="pt",
            add_special_tokens=True,
        )

        enc = {
            k: v.to(DEVICE)
            for k, v in enc.items()
        }

        out = model(
            **enc,
            output_hidden_states=True,
            use_cache=False,
            return_dict=True,
        )

        last_token = (
            int(enc["attention_mask"][0].sum().item())
            - 1
        )

        # hidden_states[0]   = embedding output
        # hidden_states[L+1] = decoder block L output
        for L in range(N_LAYERS):

            h = out.hidden_states[L + 1][
                0,
                last_token,
                :
            ]

            accum[L].add_(h.float())

        del out, enc

    n = float(len(texts))

    return [x / n for x in accum]


print("\n[3/10] Extracting original ABOVE states...")
positive_states = mean_hidden_states(POSITIVE)

gc.collect()
torch.cuda.empty_cache()

print("[4/10] Extracting original BELOW states...")
negative_states = mean_hidden_states(NEGATIVE)

actuators = []
actuator_raw_norms = []

print("[5/10] Building original SEASC per-layer actuators...")

for L in range(N_LAYERS):

    diff = positive_states[L] - negative_states[L]

    raw_norm = (
        torch.linalg
        .vector_norm(diff)
        .clamp_min(1e-12)
    )

    A = (
        diff / raw_norm
    ).to(
        device=DEVICE,
        dtype=torch.float32
    ).contiguous()

    actuators.append(A)
    actuator_raw_norms.append(float(raw_norm.item()))

    print(
        f"L{L:02d} | "
        f"raw contrast norm={raw_norm.item():.6f} | "
        f"unit actuator norm={A.norm().item():.6f}"
    )

del positive_states, negative_states
gc.collect()
torch.cuda.empty_cache()


