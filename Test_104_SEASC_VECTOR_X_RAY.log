# =============================================================================
# 2. ORIGINAL SEASC 3.0 STATIC NORMALIZED DRA ENVELOPE
# =============================================================================

def dra_envelope(layer_idx):
    t = float(layer_idx)

    kb = (
        ZIRVE
        * math.exp(-SONUM * t)
        * (1.0 + SONUM * t)
        + TABAN
    )

    kb0 = ZIRVE + TABAN

    return kb / kb0


ENVELOPE = [dra_envelope(L) for L in range(N_LAYERS)]
RELATIVE_DOSE = [IVME * e for e in ENVELOPE]

