# =============================================================================
R_("="*78); R_("  3) TEK-ŞABLON ÜRETİM TESTİ (V_TEK, i0.15, aynı 2 prompt)"); R_("="*78)
olc_tek=[olc(uret(CTX_BRIDGE,q,pu=P_TEK[0],hd=P_TEK[1],ivmeler=[0.15]),
             TABAN_KELIME[P_TETIK.index(q)]) for q in P_LOO]
ozet_tek=ozet(olc_tek)
R_(f"    V_TEK  (tek şablon)   SAHNE={ozet_tek['sahne']:.1f}  NET={ozet_tek['net']:+.1f}  "
   f"kalite={ozet_tek['kalite']:.3f}")
R_(f"    [Aşama 17 referansları, aynı 2 prompt, i0.15:]")
R_(f"      V_BIR (tam 8 şablon)         SAHNE=5.9 (LOO tablosu ortalaması)")
R_(f"      'The moment is {{X}}.' ÇIKARILINCA  SAHNE=1.8  (en düşük)")
if ozet_tek['sahne']>=4.0:
    R_("    ✅ tek şablon TEK BAŞINA yüksek SAHNE veriyor — LOO çöküşü bu şablonun")
    R_("       kendi payını kaybetmekten değil, kalan 7 şablonun toplam payını")
    R_("       kaybetmekten kaynaklanıyor olabilir (bu şablon asıl taşıyıcı değil,")
    R_("       ama çıkarılması geri kalan 7'nin ortalama gücünü de bir şekilde düşürüyor)")
elif ozet_tek['sahne']<=2.5:
    R_("    · tek şablon TEK BAŞINA da düşük SAHNE veriyor — yani bu şablonun asıl işi")
    R_("       'tam vektöre yakın bir yön eklemek' değil, diğer 7'nin ortalamasını")
    R_("       BELLİ BİR YÖNE ÇEKMEK (ör. gürültüyü azaltmak). Kosinüs yüksek ama işlevi")
    R_("       geometrik konumundan değil, ortalamaya katkısından geliyor.")
else:
    R_("    · ara sonuç — ne net taşıyıcı ne net gürültü, ek örnekleme gerekebilir")
R_("")

# =============================================================================
