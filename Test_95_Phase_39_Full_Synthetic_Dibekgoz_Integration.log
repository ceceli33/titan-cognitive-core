#  CUDA ÇEKİRDEK — AŞAMA 14 İLE BİREBİR AYNI (dokunulmadı)
# =============================================================================
_CPP_DECL=r"""
#include <torch/extension.h>
torch::Tensor akbas_steer_v14(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, torch::Tensor ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf);
"""
_CUDA_SRC=r"""
#include <torch/extension.h>
#include <c10/cuda/CUDAGuard.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda.h>
#include <cuda_runtime.h>
#include <math.h>

#define MAX_K 4

__global__ void akbas_v14_kernel(
    float* __restrict__ hidden,
    const float* __restrict__ pusula,
    const float* __restrict__ hedef,
    const float* __restrict__ mercek,
    const float* __restrict__ ivme,
    int K, int layer_idx, float sonum, float zirve, float taban,
    int fren_acik,
    float* __restrict__ prev_cosine,
    float* __restrict__ log_buf,
    int D, int BS, int S)
{
    extern __shared__ float sdata[];
    float* s_a = sdata;
    float* s_b = sdata + blockDim.x;

    int token = blockIdx.x; if (token >= BS) return;
    float* tok = hidden + (size_t)token * D;

    float sqf = 0.f;
    for (int j = threadIdx.x; j < D; j += blockDim.x) { float hv=tok[j]; sqf += hv*hv; }
    s_a[threadIdx.x] = sqf; __syncthreads();
    for (int st = blockDim.x>>1; st>0; st>>=1){
        if (threadIdx.x < st) s_a[threadIdx.x] += s_a[threadIdx.x+st];
        __syncthreads();
    }
    __shared__ float s_norm0;
    if (threadIdx.x==0) s_norm0 = sqrtf(s_a[0]) + 1e-6f;
    __syncthreads();
    float norm0 = s_norm0;

    __shared__ float s_katki[MAX_K];
    float butce = 1.0f / sqrtf((float)K);

    for (int k = 0; k < K; ++k) {
        const float* pk = pusula + (size_t)k * D;
        float dot=0.f, sqm=0.f;
        for (int j = threadIdx.x; j < D; j += blockDim.x) {
            float hm = tok[j] * mercek[j];
            dot += hm * pk[j];
            sqm += hm * hm;
        }
        s_a[threadIdx.x]=dot; s_b[threadIdx.x]=sqm; __syncthreads();
        for (int st = blockDim.x>>1; st>0; st>>=1){
            if (threadIdx.x < st){
                s_a[threadIdx.x]+=s_a[threadIdx.x+st];
                s_b[threadIdx.x]+=s_b[threadIdx.x+st];
            }
            __syncthreads();
        }
        if (threadIdx.x==0){
            float norm_m = sqrtf(s_b[0]) + 1e-6f;
            float cs = fminf(fmaxf(s_a[0]/norm_m, -1.f), 1.f);
            prev_cosine[k*BS + token] = cs;

            float t   = (float)layer_idx;
            float unc = 1.f - fabsf(cs);
            float dw  = sonum + unc*0.20f;
            float kb  = zirve*expf(-dw*t)*(1.f+dw*t) + taban;
            float zarf = kb/(zirve+taban);

            float son = 1.f;
            if (fren_acik){
                if      (cs> 0.75f) son=(1.f-cs)/0.25f;
                else if (cs<-0.40f) son=1.6f;
            }
            s_katki[k] = ivme[k]*butce*zarf*norm0*son;

            if (S>1 && token==0 && layer_idx<20 && k==0){
                log_buf[layer_idx*6+0]=cs;
                log_buf[layer_idx*6+1]=zarf;
                log_buf[layer_idx*6+2]=son;
                log_buf[layer_idx*6+3]=s_katki[k];
                log_buf[layer_idx*6+4]=norm0;
                log_buf[layer_idx*6+5]=s_katki[k]/norm0;
            }
        }
        __syncthreads();
    }

    for (int j = threadIdx.x; j < D; j += blockDim.x) {
        float acc = 0.f;
        for (int k = 0; k < K; ++k) acc += s_katki[k] * hedef[(size_t)k*D + j];
        tok[j] += acc;
    }
}

torch::Tensor akbas_steer_v14(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, torch::Tensor ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf)
{
    TORCH_CHECK(hidden.is_cuda(),"hidden CUDA olmalı");
    TORCH_CHECK(hidden.scalar_type()==torch::kFloat32,"hidden float32 olmalı");
    TORCH_CHECK(pusula.dim()==2 && hedef.dim()==2, "pusula/hedef [K,D] olmalı");
    auto h=hidden.contiguous(); auto p=pusula.contiguous();
    auto hd=hedef.contiguous(); auto mc=mercek.contiguous();
    auto iv=ivme.contiguous();
    auto pc=prev_cosine.contiguous(); auto lb=log_buf.contiguous();
    if (layer_idx>=20) return h;
    int B=h.size(0),S=h.size(1),D=h.size(2),BS=B*S;
    int K=p.size(0);
    TORCH_CHECK(K<=4, "en fazla 4 eksen");
    int threads=256; while (threads>D && threads>32) threads>>=1;
    const at::cuda::OptionalCUDAGuard dg(device_of(h));
    akbas_v14_kernel<<<BS,threads,2*(size_t)threads*sizeof(float),
                       at::cuda::getCurrentCUDAStream()>>>(
        h.data_ptr<float>(),p.data_ptr<float>(),hd.data_ptr<float>(),
        mc.data_ptr<float>(),iv.data_ptr<float>(),
        K,(int)layer_idx,(float)sonum,(float)zirve,(float)taban,(int)fren_acik,
        pc.data_ptr<float>(),lb.data_ptr<float>(),D,BS,S);
    return h;
}
"""
if not torch.utils.cpp_extension.is_ninja_available():
    import site
    for _sp in site.getsitepackages():
        _b=os.path.normpath(os.path.join(_sp,"..","..","bin"))
        if os.path.isdir(_b): os.environ["PATH"]=_b+":"+os.environ.get("PATH","")
for _n in ["akbas_v18_a","akbas_v18_b"]:
