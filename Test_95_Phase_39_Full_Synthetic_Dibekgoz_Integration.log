                 TABAN_KELIME[i]) for i,q in enumerate(P_TETIK)]
    olc_rast=[olc(uret(CTX_BRIDGE,q,pu=P_RAST[0],hd=P_RAST[1],ivmeler=[ivme]),
                  TABAN_KELIME[i]) for i,q in enumerate(P_TETIK)]
    ozet_bir=ozet(olc_bir); ozet_rast=ozet(olc_rast)
    SONUC_IVME[ivme]={"bir":ozet_bir,"rast":ozet_rast}
    ad_b=f"BIR_i{ivme:.2f}"; ad_r=f"RAST_i{ivme:.2f}"
    R_(f"    {ad_b:<20}{ozet_bir['kelime']:>8.0f}{ozet_bir['kopru']:>7.1f}"
       f"{ozet_bir['firtina']:>6.1f}{ozet_bir['sahne']:>7.1f}{ozet_bir['net']:>+7.1f}"
       f"{ozet_bir['kalite']:>8.3f}")
    R_(f"    {ad_r:<20}{ozet_rast['kelime']:>8.0f}{ozet_rast['kopru']:>7.1f}"
       f"{ozet_rast['firtina']:>6.1f}{ozet_rast['sahne']:>7.1f}{ozet_rast['net']:>+7.1f}"
       f"{ozet_rast['kalite']:>8.3f}")
    if _esik_gecildi is None and ozet_bir['kalite']>0.15:
        _esik_gecildi=ivme
R_(f"\n    [Aşama 17 referansı: i0.10 kalite=0.084 (sağlam) | i0.15 kalite=0.564 (bozuk)]")
if _esik_gecildi is not None:
