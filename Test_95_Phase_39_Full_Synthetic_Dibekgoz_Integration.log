_taban_firt =statistics.mean([yogun(x,FIRTINA_K) for x in TABAN_METIN])
R_(f"    ortalama kelime={statistics.mean(TABAN_KELIME):.1f}  "
   f"köprü={_taban_kopru:.1f}  fırtına={_taban_firt:.1f}  SAHNE={_taban_kopru+_taban_firt:.1f}")
R_(f"  ✅ {time.time()-t0:.0f} sn\n")

