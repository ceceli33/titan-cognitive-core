        act_rel_audit.append(
            z["selected_act_realized_rel"]
        )

        radar_dir_audit.append(
            z["selected_radar_dir_cos"]
        )

        act_dir_audit.append(
            z["selected_act_dir_cos"]
        )


S_RADAR = stats(radar_delta)
S_SCALAR = stats(scalar_delta)
S_GLOBAL = stats(global_delta)
S_RANDOM = stats(random_delta)
S_ORACLE = stats(oracle_delta)

S_RG = stats(radar_minus_global)
S_RR = stats(radar_minus_random)
S_RS = stats(radar_minus_scalar)

PRED_ACT_CORR = safe_corr(
    pred_all,
    act_all,
)

MICRO_ACT_CORR = safe_corr(
    micro_all,
    act_all,
)

MEAN_RADAR_RANK = float(
    np.mean(radar_ranks)
)

MEAN_SCALAR_RANK = float(
    np.mean(scalar_ranks)
)

RADAR_TOP4 = float(
    np.mean(
        np.asarray(radar_ranks) <= 4
    )
)

SCALAR_TOP4 = float(
    np.mean(
        np.asarray(scalar_ranks) <= 4
    )
)

RADAR_HIT = float(
    np.mean(radar_hits)
)

SCALAR_HIT = float(
    np.mean(scalar_hits)
)

CAPTURE_RATIO = safe_ratio(
    S_RADAR["mean"],
    S_ORACLE["mean"],
)


