# =============================================================================
# 10. FIXED TANGENT ATLAS
#
# Atlas TEST134'e özgü yeni random seed ile oluşturulur.
#
# q_i = cos(theta) v_l + sin(theta) u_i
#
# u_i ⟂ v_l
# =============================================================================

print("\n[4/26] TEST134 tangent radar atlas oluşturuluyor...")

ATLAS = {}

theta = math.radians(REQUESTED_SHELL_DEG)

for li in SOURCE_LAYERS:

    v = normalize(DIBEK[li])

    ATLAS[li] = []

    for cid in range(N_CANDIDATES):

        g = torch.Generator(device="cpu")

        g.manual_seed(
            SEED
            + 100000 * li
            + cid
        )

        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )

        u = z - torch.dot(z, v) * v
        u = normalize(u)

        q = normalize(
            math.cos(theta) * v
            + math.sin(theta) * u
        )

        ATLAS[li].append({
            "candidate_id": cid,
            "u": u,
            "q": q,
        })

print(
    f"Atlas: {len(SOURCE_LAYERS)} layers × "
    f"{N_CANDIDATES} candidate"
)


# =============================================================================
# 11. BASELINE PASS
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = out[0] if isinstance(out, tuple) else out

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. GENERIC ONE-STEP INTERVENTION
#
# rel can be:
#
#   RADAR_REL = .0025
#   ACT_REL   = .01
#
# Returns actual BF16-realized source perturbation x and target response y.
# =============================================================================

@torch.no_grad()
def one_step_intervention(
    prompt,
    baseline,
    li,
    direction,
    rel,
):

    target = li + 1

    q = normalize(direction)

    src_base = baseline[li].float()

    requested_norm = (
        rel
        * float(
            torch.linalg.vector_norm(
                src_base
            )
        )
    )

    q_gpu = q.to(device)

    source_delta = {}
    target_cap = {}

    handles = []

    def source_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        before = h[0, -1].float()

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        source_delta["x"] = (
            hnew[0, -1].float()
            - before
        ).detach().cpu().clone()

        if isinstance(out, tuple):
            return (hnew,) + out[1:]

        return hnew

    def target_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        target_cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    x = source_delta["x"]

    y = (
        target_cap["h"]
        - baseline[target]
    )

    xnorm = float(torch.linalg.vector_norm(x))
    ynorm = float(torch.linalg.vector_norm(y))
    srcnorm = float(torch.linalg.vector_norm(src_base))

    return {
        "x": x,
        "y": y,

        "D_next": cosine(
            y,
            DIBEK[target],
        ),

        "D_same": cosine(
            y,
            DIBEK[li],
        ),

        "realized_rel":
            xnorm / (srcnorm + EPS),

        "requested_rel":
            rel,

        "dir_cos":
            cosine(x, q),

        "response_norm":
            ynorm,

        "gain_norm":
            ynorm / (xnorm + EPS),
    }


# =============================================================================
# 13. RADAR RESPONSE FEATURES
#
# PRIMARY SENSOR:
#
# Baseline h_l doğrudan feature değildir.
#
# Sensor candidate'a mikro-probe gönderir ve gerçek response y'yi ölçer.
#
# Candidate identity yok.
#
# r = y = F(h + eps*q) - F(h)
#
# Features:
#
#  0 bias
#  1 cos(r, v_l)
#  2 cos(r, v_l+1)
#  3 cos(r, q)
#  4 cos(r, u)
#  5 cos(r, orthogonal semantic rotation r_next)
#  6 response norm / source perturbation norm
#  7 log response norm
#  8 realized source direction fidelity
#  9 realized radar rel
# 10 source->response cosine cos(x,r)
# 11 semantic transfer difference:
#        cos(r,v_next) - cos(r,v_current)
# 12 response component magnitude along v_next
# 13 response component magnitude along r_next
# 14 q -> v_next static geometry
#
# q_vnext intentionally included only as control/context;
# physical response features dominate the intended test.
# =============================================================================

FEATURE_NAMES = [
    "bias",
    "resp_vcurrent",
    "resp_vnext",
    "resp_q",
    "resp_u",
    "resp_rnext",
    "response_gain_norm",
    "log_response_norm",
    "realized_dir_cos",
    "realized_radar_rel",
    "source_response_cos",
    "semantic_transfer_delta",
    "response_vnext_projection",
    "response_rnext_projection",
    "q_vnext",
]


def radar_features(
    li,
    candidate,
    radar_result,
):

    v = normalize(DIBEK[li])
    vn = normalize(DIBEK[li + 1])

    q = normalize(candidate["q"])
    u = normalize(candidate["u"])

    x = radar_result["x"].float()
    r = radar_result["y"].float()

    rn = normalize(r)

    c = float(torch.dot(v, vn))

    raw_rnext = vn - c * v
    rnext = normalize(raw_rnext)

    if rn is None:

        resp_v = 0.0
        resp_vn = 0.0
        resp_q = 0.0
        resp_u = 0.0
        resp_rnext = 0.0
        source_resp = 0.0

    else:

        resp_v = cosine(rn, v)
        resp_vn = cosine(rn, vn)
        resp_q = cosine(rn, q)
        resp_u = cosine(rn, u)

        source_resp = cosine(x, r)

        if rnext is None:
            resp_rnext = 0.0
        else:
            resp_rnext = cosine(rn, rnext)

    rnorm = float(torch.linalg.vector_norm(r))

    if rnext is None:
        proj_rnext = 0.0
    else:
        proj_rnext = float(
            torch.dot(r, rnext)
            / (rnorm + EPS)
        )

    proj_vnext = float(
        torch.dot(r, vn)
        / (rnorm + EPS)
    )

    return np.asarray(
        [
            1.0,
            resp_v,
            resp_vn,
            resp_q,
            resp_u,
            resp_rnext,
            radar_result["gain_norm"],
            math.log(rnorm + EPS),
            radar_result["dir_cos"],
            radar_result["realized_rel"],
            source_resp,
            resp_vn - resp_v,
            proj_vnext,
            proj_rnext,
            cosine(q, vn),
        ],
        dtype=np.float64,
    )


# =============================================================================
# 14. TRAIN + DEV DATA COLLECTION
#
# For each prompt/layer:
#
#   A. FIXED at ACT_REL=.01
#
#   B. each candidate:
#        radar at .0025
#        actuator at .01
#
# Target:
#
#   candidate ACT D_next - FIXED ACT D_next
#
# Thus the scorer must predict LARGE intervention success
# from SMALL intervention response.
# =============================================================================

print("\n[5/26] TRAIN + DEV ACTIVE-RADAR system-ID başlıyor...")

SYSTEM_PROMPTS = TRAIN_PROMPTS + DEV_PROMPTS
SYSTEM_SPLITS = (
    ["TRAIN"] * N_TRAIN
    + ["DEV"] * N_DEV
)

SYSTEM_DATA = []

start = time.time()

for pi, prompt in enumerate(SYSTEM_PROMPTS):

    split = SYSTEM_SPLITS[pi]

    base = baseline_pass(prompt)

    prow = {
        "prompt_index": pi,
        "split": split,
        "prompt": prompt,
        "layers": {},
    }

    for li in SOURCE_LAYERS:

        # -------------------------------------------------------------
        # Historical compass at actuator dose
        # -------------------------------------------------------------

        fixed_act = one_step_intervention(
            prompt,
            base,
            li,
            DIBEK[li],
            ACT_REL,
        )

        # Historical compass at radar dose:
        # diagnostic only.
        fixed_radar = one_step_intervention(
            prompt,
            base,
            li,
            DIBEK[li],
            RADAR_REL,
        )

        layer = {
            "fixed_act_D":
                fixed_act["D_next"],

            "fixed_radar_D":
                fixed_radar["D_next"],

            "candidates":
                [],
        }

        for candidate in ATLAS[li]:

            # ---------------------------------------------------------
            # MICRO PROBE
            # ---------------------------------------------------------

            radar = one_step_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                RADAR_REL,
            )

            feat = radar_features(
                li,
                candidate,
                radar,
            )

            # ---------------------------------------------------------
            # ACTUATOR TARGET
            # ---------------------------------------------------------

            act = one_step_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                ACT_REL,
            )

            target_delta = (
                act["D_next"]
                - fixed_act["D_next"]
            )

            # Simple scalar radar diagnostic:
            # Does micro D advantage itself predict act advantage?
            radar_delta = (
                radar["D_next"]
                - fixed_radar["D_next"]
            )

            layer["candidates"].append({
                "candidate_id":
                    candidate["candidate_id"],

                "features":
                    feat,

                "target_act_delta":
                    float(target_delta),

                "radar_delta":
                    float(radar_delta),

                "radar_D":
                    radar["D_next"],

                "act_D":
                    act["D_next"],

                "radar_rel":
                    radar["realized_rel"],

                "act_rel":
                    act["realized_rel"],

                "radar_dir_cos":
                    radar["dir_cos"],

                "act_dir_cos":
                    act["dir_cos"],

                "radar_response_norm":
                    radar["response_norm"],

                "radar_gain_norm":
                    radar["gain_norm"],

                "radar_act_source_angle":
                    angle_deg(
                        radar["x"],
                        act["x"],
                    ),
            })

        prow["layers"][str(li)] = layer

    SYSTEM_DATA.append(prow)

    if (pi + 1) % 4 == 0:
        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(SYSTEM_PROMPTS)} "
        f"| {(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"TRAIN+DEV completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 15. DATA PREP
# =============================================================================

def prepare_xy(data, li, split):

    X = []
    y = []
    radar_scalar = []
    meta = []

    for row in data:

        if row["split"] != split:
            continue

        layer = row["layers"][str(li)]

        for c in layer["candidates"]:

            X.append(c["features"])
            y.append(c["target_act_delta"])
            radar_scalar.append(c["radar_delta"])

            meta.append({
                "prompt_index":
                    row["prompt_index"],

                "candidate_id":
                    c["candidate_id"],
            })

    return (
        np.asarray(X, dtype=np.float64),
        np.asarray(y, dtype=np.float64),
        np.asarray(radar_scalar, dtype=np.float64),
        meta,
    )


# =============================================================================
# 16. STANDARDIZATION / RIDGE
# =============================================================================

def standardize_fit(X):

    mu = X[:, 1:].mean(axis=0)
    sd = X[:, 1:].std(axis=0)

    sd[sd < 1e-10] = 1.0

    return mu, sd


def standardize_apply(X, mu, sd):

    Z = X.copy()

    Z[:, 1:] = (
        Z[:, 1:] - mu
    ) / sd

    Z[:, 0] = 1.0

    return Z


def ridge_fit(X, y, lam):

    p = X.shape[1]

    reg = np.eye(
        p,
        dtype=np.float64,
    )

    # Bias not regularized
    reg[0, 0] = 0.0

    A = X.T @ X + lam * reg
    b = X.T @ y

    try:
        beta = np.linalg.solve(A, b)
    except np.linalg.LinAlgError:
        beta = np.linalg.pinv(A) @ b

    return beta


def predict(X, beta):
    return X @ beta


# =============================================================================
# 17. DEV MODEL SELECTION
#
# We do NOT select lambda by row correlation.
#
# Operational question:
#
#   On each DEV prompt, which candidate would scorer select?
#
# Then evaluate that candidate's actual ACT_REL=.01 outcome.
# =============================================================================

print("\n[6/26] DEV radar scorer regularization seçiliyor...")

SCORERS = {}
DEV_SELECTION = {}

for li in SOURCE_LAYERS:

    Xtr, ytr, rtr, mtr = prepare_xy(
        SYSTEM_DATA,
        li,
        "TRAIN",
    )

    Xdv, ydv, rdv, mdv = prepare_xy(
        SYSTEM_DATA,
        li,
        "DEV",
    )

    mu, sd = standardize_fit(Xtr)

    Ztr = standardize_apply(
        Xtr,
        mu,
        sd,
    )

    Zdv = standardize_apply(
        Xdv,
        mu,
        sd,
    )

    options = []

    for lam in RIDGES:

        beta = ridge_fit(
            Ztr,
            ytr,
            lam,
        )

        pred = predict(
            Zdv,
            beta,
        )

        selected_actual = []
        oracle_actual = []
        scalar_selected_actual = []

        prompt_ids = sorted(
            set(
                m["prompt_index"]
                for m in mdv
            )
        )

        for pid in prompt_ids:

            inds = [
                j
                for j, m
                in enumerate(mdv)
                if m["prompt_index"] == pid
            ]

            pp = pred[inds]
            yy = ydv[inds]
            rr = rdv[inds]

            sensor_idx = int(np.argmax(pp))
            scalar_idx = int(np.argmax(rr))

            selected_actual.append(
                float(yy[sensor_idx])
            )

            scalar_selected_actual.append(
                float(yy[scalar_idx])
            )

            oracle_actual.append(
                float(np.max(yy))
            )

        options.append({
            "lambda":
                float(lam),

            "selected_mean":
                float(np.mean(selected_actual)),

            "scalar_radar_selected_mean":
                float(np.mean(
                    scalar_selected_actual
                )),

            "oracle_mean":
                float(np.mean(oracle_actual)),

            "row_corr":
                safe_corr(pred, ydv),

            "raw_radar_delta_corr":
                safe_corr(rdv, ydv),
        })

    options.sort(
        key=lambda z: z["selected_mean"],
        reverse=True,
    )

    best = options[0]

    # -------------------------------------------------------------
    # Refit frozen scorer using TRAIN + DEV
    # -------------------------------------------------------------

    Xall = np.vstack([Xtr, Xdv])
    yall = np.concatenate([ytr, ydv])

    mu_all, sd_all = standardize_fit(Xall)

    Zall = standardize_apply(
        Xall,
        mu_all,
        sd_all,
    )

    beta_all = ridge_fit(
        Zall,
        yall,
        best["lambda"],
    )

    SCORERS[li] = {
        "mu": mu_all,
        "sd": sd_all,
        "beta": beta_all,
        "lambda": best["lambda"],
    }

    DEV_SELECTION[li] = {
        "best": best,
        "all": options,
    }

    print(
        f"L{li:02d}->L{li+1:02d} "
        f"λ={best['lambda']:<7g} "
        f"DEV radar={best['selected_mean']:+.5f} "
        f"scalar={best['scalar_radar_selected_mean']:+.5f} "
        f"oracle={best['oracle_mean']:+.5f} "
        f"row-r={best['row_corr']:+.3f} "
        f"microD-r={best['raw_radar_delta_corr']:+.3f}"
    )


# =============================================================================
# 18. GLOBAL FIXED CORRECTION
#
# Strong state-independent baseline:
# best candidate ID on TRAIN+DEV at ACT_REL=.01.
# =============================================================================

print("\n[7/26] Global fixed correction seçiliyor...")

GLOBAL_CANDIDATE = {}

for li in SOURCE_LAYERS:

    means = []

    for cid in range(N_CANDIDATES):

        vals = []

        for row in SYSTEM_DATA:

            vals.append(
                row["layers"][str(li)]
                ["candidates"][cid]
                ["target_act_delta"]
            )

        means.append(
            float(np.mean(vals))
        )

    best_id = int(np.argmax(means))

    GLOBAL_CANDIDATE[li] = {
        "candidate_id":
            best_id,

        "train_dev_act_delta":
            means[best_id],
    }

    print(
        f"L{li:02d}: "
        f"candidate={best_id:02d} "
        f"TRAIN+DEV ACT Δ="
        f"{means[best_id]:+.5f}"
    )


# =============================================================================
# 19. FROZEN RADAR CHOICE
# =============================================================================

def radar_choose(
    li,
    feature_matrix,
):

    scorer = SCORERS[li]

    X = np.asarray(
        feature_matrix,
        dtype=np.float64,
    )

    Z = standardize_apply(
        X,
        scorer["mu"],
        scorer["sd"],
    )

    scores = predict(
        Z,
        scorer["beta"],
    )

    best_id = int(np.argmax(scores))

    return best_id, scores


# =============================================================================
# 20. BLIND ACTIVE RADAR
#
# CRITICAL ORDER:
#
#   baseline
#      ↓
#   fixed RADAR diagnostic
#      ↓
#   ALL candidate MICRO probes
#      ↓
#   frozen scorer selects candidate
#      ↓
#   SELECTION FROZEN
#      ↓
#   only now ACT_REL outcomes are measured
#
# Thus ACT outcomes cannot affect navigator selection.
# =============================================================================

print("\n[8/26] BLIND ACTIVE-RADAR assay...")

BLIND_RESULTS = []

start = time.time()

for pi, prompt in enumerate(BLIND_PROMPTS):

    base = baseline_pass(prompt)

    row = {
        "prompt_index": pi,
        "prompt": prompt,
        "layers": {},
    }

    for li in SOURCE_LAYERS:

        # -------------------------------------------------------------
        # FIXED MICRO-RADAR reference
        # -------------------------------------------------------------

        fixed_radar = one_step_intervention(
            prompt,
            base,
            li,
            DIBEK[li],
            RADAR_REL,
        )

        # -------------------------------------------------------------
        # PHASE A:
        # MICRO probes ONLY.
        # No ACT candidate has been run yet.
        # -------------------------------------------------------------

        radar_results = []
        feature_matrix = []
        radar_scalar = []

        for candidate in ATLAS[li]:

            radar = one_step_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                RADAR_REL,
            )

            feat = radar_features(
                li,
                candidate,
                radar,
            )

            radar_results.append(radar)
            feature_matrix.append(feat)

            radar_scalar.append(
                radar["D_next"]
                - fixed_radar["D_next"]
            )

        # -------------------------------------------------------------
        # FREEZE ALL SELECTIONS BEFORE ACTUATOR OUTCOMES
        # -------------------------------------------------------------

        radar_id, radar_scores = radar_choose(
            li,
            feature_matrix,
        )

        # Simple one-scalar active-radar baseline:
        # choose candidate with best micro D_next advantage
        scalar_id = int(
            np.argmax(radar_scalar)
        )

        global_id = (
            GLOBAL_CANDIDATE[li]
            ["candidate_id"]
        )

        rng = random.Random(
            SEED
            + 900000
            + 1000 * li
            + pi
        )

        random_id = rng.randrange(
            N_CANDIDATES
        )

        # -------------------------------------------------------------
        # PHASE B:
        # ACTUATOR outcomes.
        #
        # Historical FIXED first.
        # -------------------------------------------------------------

        fixed_act = one_step_intervention(
            prompt,
            base,
            li,
            DIBEK[li],
            ACT_REL,
        )

        # -------------------------------------------------------------
        # Scan all candidate ACT outcomes only AFTER selection freeze.
        # Needed for oracle ceiling and ranking analysis.
        # -------------------------------------------------------------

        act_outcomes = []

        for candidate in ATLAS[li]:

            act = one_step_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                ACT_REL,
            )

            act_outcomes.append({
                "candidate_id":
                    candidate["candidate_id"],

                "D_next":
                    act["D_next"],

                "delta":
                    act["D_next"]
                    - fixed_act["D_next"],

                "realized_rel":
                    act["realized_rel"],

                "dir_cos":
                    act["dir_cos"],

                "response_norm":
                    act["response_norm"],
            })

        oracle_id = int(
            np.argmax([
                z["D_next"]
                for z in act_outcomes
            ])
        )

        radar_out = act_outcomes[radar_id]
        scalar_out = act_outcomes[scalar_id]
        global_out = act_outcomes[global_id]
        random_out = act_outcomes[random_id]
        oracle_out = act_outcomes[oracle_id]

        # -------------------------------------------------------------
        # Actual rank of radar-selected candidate
        # -------------------------------------------------------------

        actual_order = np.argsort(
            -np.asarray([
                z["D_next"]
                for z in act_outcomes
            ])
        )

        radar_rank = int(
            np.where(
                actual_order == radar_id
            )[0][0]
        ) + 1

        scalar_rank = int(
            np.where(
                actual_order == scalar_id
            )[0][0]
        ) + 1

        # -------------------------------------------------------------
        # Radar vs actuator direction audit
        # -------------------------------------------------------------

        radar_act_angle = angle_deg(
            radar_results[radar_id]["x"],
            # Need actual selected act source perturbation.
            # Reconstruct from requested candidate by doing no extra run:
            # direction fidelity already audited separately.
            ATLAS[li][radar_id]["q"],
        )

        row["layers"][str(li)] = {
            "fixed_act_D":
                fixed_act["D_next"],

            "fixed_radar_D":
                fixed_radar["D_next"],

            "radar_id":
                radar_id,

            "scalar_id":
                scalar_id,

            "global_id":
                global_id,

            "random_id":
                random_id,

            "oracle_id":
                oracle_id,

            "radar_delta":
                radar_out["delta"],

            "scalar_delta":
                scalar_out["delta"],

            "global_delta":
                global_out["delta"],

            "random_delta":
                random_out["delta"],

            "oracle_delta":
                oracle_out["delta"],

            "radar_D":
                radar_out["D_next"],

            "scalar_D":
                scalar_out["D_next"],

            "global_D":
                global_out["D_next"],

            "random_D":
                random_out["D_next"],

            "oracle_D":
                oracle_out["D_next"],

            "radar_rank":
                radar_rank,

            "scalar_rank":
                scalar_rank,

            "radar_hit_oracle":
                int(radar_id == oracle_id),

            "scalar_hit_oracle":
                int(scalar_id == oracle_id),

            "radar_predicted_score":
                float(
                    radar_scores[radar_id]
                ),

            "selected_micro_delta":
                float(
                    radar_scalar[radar_id]
                ),

            "selected_radar_realized_rel":
                radar_results[radar_id]
                ["realized_rel"],

            "selected_radar_dir_cos":
                radar_results[radar_id]
                ["dir_cos"],

            "selected_act_realized_rel":
                radar_out["realized_rel"],

            "selected_act_dir_cos":
                radar_out["dir_cos"],

            "selected_radar_requested_angle":
                radar_act_angle,

            "all_radar_scores":
                [
                    float(x)
                    for x in radar_scores
                ],

            "all_micro_delta":
                [
                    float(x)
                    for x in radar_scalar
                ],

            "all_act_outcomes":
                act_outcomes,
        }

    BLIND_RESULTS.append(row)

    if (pi + 1) % 4 == 0:
        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(BLIND_PROMPTS)} "
        f"| {(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"BLIND completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 21. GLOBAL BLIND ANALYSIS
# =============================================================================

print("\n[9/26] Global blind analysis...")

radar_delta = []
scalar_delta = []
global_delta = []
random_delta = []
oracle_delta = []

radar_minus_global = []
radar_minus_random = []
radar_minus_scalar = []

radar_ranks = []
scalar_ranks = []

radar_hits = []
scalar_hits = []

pred_all = []
micro_all = []
act_all = []

radar_rel_audit = []
act_rel_audit = []

radar_dir_audit = []
act_dir_audit = []

for row in BLIND_RESULTS:

    for li in SOURCE_LAYERS:

        z = row["layers"][str(li)]

        radar_delta.append(
            z["radar_delta"]
        )

        scalar_delta.append(
            z["scalar_delta"]
        )

        global_delta.append(
            z["global_delta"]
        )

        random_delta.append(
            z["random_delta"]
        )

        oracle_delta.append(
            z["oracle_delta"]
        )

        radar_minus_global.append(
            z["radar_delta"]
            - z["global_delta"]
        )

        radar_minus_random.append(
            z["radar_delta"]
            - z["random_delta"]
        )

        radar_minus_scalar.append(
            z["radar_delta"]
            - z["scalar_delta"]
        )

        radar_ranks.append(
            z["radar_rank"]
        )

        scalar_ranks.append(
            z["scalar_rank"]
        )

        radar_hits.append(
