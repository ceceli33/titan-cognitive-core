for li in SOURCE_LAYERS:

    rd = []
    sd = []
    gd = []
    rnd = []
    od = []

    rg = []
    rr = []
    rs = []

    ranks = []

    for row in BLIND_RESULTS:

        z = row["layers"][str(li)]

        rd.append(z["radar_delta"])
        sd.append(z["scalar_delta"])
        gd.append(z["global_delta"])
        rnd.append(z["random_delta"])
        od.append(z["oracle_delta"])

        rg.append(
            z["radar_delta"]
            - z["global_delta"]
        )

        rr.append(
            z["radar_delta"]
            - z["random_delta"]
        )

        rs.append(
            z["radar_delta"]
            - z["scalar_delta"]
        )

        ranks.append(
            z["radar_rank"]
        )

    sr = stats(rd)
    ss = stats(sd)
    sg = stats(gd)
    sn = stats(rnd)
    so = stats(od)

    srg = stats(rg)
    srr = stats(rr)
    srs = stats(rs)

    mean_rank = float(
        np.mean(ranks)
    )

    top4 = float(
        np.mean(
            np.asarray(ranks) <= 4
        )
    )

    LAYER_SUMMARY[str(li)] = {
        "radar":
            sr,

        "scalar":
            ss,

        "global":
            sg,

        "random":
            sn,

        "oracle":
            so,

        "radar_minus_global":
            srg,

        "radar_minus_random":
            srr,

        "radar_minus_scalar":
            srs,

        "mean_rank":
            mean_rank,

        "top4":
            top4,
    }

    print(
        f"L{li}->L{li+1:<4}"
        f"{sr['mean']:>+11.5f}"
        f"{ss['mean']:>+11.5f}"
        f"{sg['mean']:>+11.5f}"
        f"{sn['mean']:>+11.5f}"
        f"{so['mean']:>+11.5f}"
        f"{srg['mean']:>+10.5f}"
