   "source": [
    "# ── Interactive widget ────────────────────────────────────────────────\n",
    "\n",
    "prompt_box = widgets.Textarea(\n",
    "    value='How can I help someone who is feeling lonely today?',\n",
    "    placeholder='Type any prompt here...',\n",
    "    layout=widgets.Layout(width='100%', height='80px')\n",
    ")\n",
    "\n",
    "run_btn = widgets.Button(\n",
    "    description='▶  Run TITAN',\n",
    "    button_style='success',\n",
    "    layout=widgets.Layout(width='160px', height='40px')\n",
    ")\n",
    "\n",
    "out = widgets.Output()\n",
    "\n",
    "def on_run(b):\n",
    "    with out:\n",
    "        clear_output(wait=True)\n",
    "        display(HTML('<div style=\"color:#ffaa00;font-family:monospace;\">⏳ Running TITAN inference...</div>'))\n",
    "        try:\n",
    "            response, log, score = run_titan_inference(prompt_box.value)\n",
    "            clear_output(wait=True)\n",
    "            render_alignment_panel(prompt_box.value, response, log, score)\n",
    "        except Exception as e:\n",
    "            clear_output(wait=True)\n",
    "            display(HTML(f'<div style=\"color:#ff4466;font-family:monospace;\">Error: {e}</div>'))\n",
    "\n",
    "run_btn.on_click(on_run)\n",
    "\n",
    "display(widgets.VBox([\n",
    "    widgets.HTML('<h3 style=\"font-family:monospace;\">🔱 TITAN Live Test</h3>'),\n",
    "    widgets.HTML('<p style=\"font-family:monospace;font-size:12px;color:gray;\">Try ethical prompts vs opposing prompts — watch cos(θ) change.</p>'),\n",
    "    prompt_box,\n",
    "    run_btn,\n",
    "    out\n",
    "]))"
   ]
