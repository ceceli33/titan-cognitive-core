    "## ③ Load Model & Inject TITAN Hook\n",
    "\n",
    "We use **TinyLlama-1.1B** — small enough to run on a free Colab T4, large enough to demonstrate real hidden-state manipulation.\n",
    "\n",
    "To use Llama-3-8B instead, change `MODEL_ID` below (requires HuggingFace token and Llama access approval)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Model selection ──────────────────────────────────────────────────\n",
    "# TinyLlama: free, no token needed, runs on T4\n",
    "MODEL_ID = 'TinyLlama/TinyLlama-1.1B-Chat-v1.0'\n",
    "\n",
    "# Llama-3-8B (uncomment + add token if you have access):\n",
    "# MODEL_ID = 'meta-llama/Meta-Llama-3-8B-Instruct'\n",
    "# from huggingface_hub import login; login(token='hf_YOUR_TOKEN_HERE')\n",
    "\n",
    "print(f'Loading {MODEL_ID} ...')\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    MODEL_ID,\n",
    "    torch_dtype=torch.float16 if DEVICE == 'cuda' else torch.float32,\n",
    "    device_map='auto',\n",
    ")\n",
    "model.eval()\n",
    "\n",
    "# Detect hidden dimension\n",
    "HIDDEN_DIM = model.config.hidden_size\n",
    "print(f'✅ Model loaded. Hidden dim: {HIDDEN_DIM}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Inject TITAN into the model's last transformer layer ─────────────\n",
    "\n",
    "titan = TITANSteeringLayer(\n",
    "    hidden_dim=HIDDEN_DIM,\n",
    "    ethical_dim=5,\n",
    "    omega=0.6,\n",
    "    p_inf=0.87,\n",
    "    steering_strength=0.05,  # conservative — start light\n",
    ").to(DEVICE)\n",
    "\n",
    "# Store original forward of last layer\n",
    "last_layer = model.model.layers[-1]\n",
    "_original_forward = last_layer.forward\n",
    "\n",
    "def _titan_hook_forward(self_layer, *args, **kwargs):\n",
    "    \"\"\"Wrap last transformer layer to inject TITAN steering.\"\"\"\n",
    "    output = _original_forward(*args, **kwargs)\n",
    "    # output[0] is the hidden state tensor\n",
    "    hidden = output[0]\n",
    "    steered = titan(hidden)\n",
    "    # Return tuple with steered hidden state\n",
    "    return (steered,) + output[1:]\n",
    "\n",
    "import types\n",
    "last_layer.forward = types.MethodType(_titan_hook_forward, last_layer)\n",
    "\n",
    "print('✅ TITAN hook injected into last transformer layer.')\n",
    "print(f'   Steering strength : {titan.steering_strength}')\n",
    "print(f'   Ethical anchor V₀ : {titan.V0.tolist()}')\n",
    "print(f'   P∞ target         : {titan.p_inf}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ④ Interactive Alignment Test\n",
    "\n",
    "Type any prompt. TITAN will measure `cos(θ)` in real time and show the alignment score."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_titan_inference(prompt: str, max_new_tokens: int = 80):\n",
    "    \"\"\"Run model with TITAN hook active. Returns output text and alignment log.\"\"\"\n",
    "    titan.reset()\n",
    "\n",
    "    inputs = tokenizer(prompt, return_tensors='pt').to(DEVICE)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        output_ids = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            do_sample=False,\n",
    "            temperature=1.0,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "        )\n",
    "\n",
    "    generated = tokenizer.decode(\n",
    "        output_ids[0][inputs['input_ids'].shape[1]:],\n",
    "        skip_special_tokens=True\n",
    "    )\n",
    "    return generated, titan.log, titan.alignment_score()\n",
    "\n",
    "\n",
    "def render_alignment_panel(prompt, response, log, score):\n",
    "    \"\"\"Display results with alignment gauge.\"\"\"\n",
    "    cos = score.get('cos_theta', 0)\n",
    "    P_t = score.get('P_t', 0)\n",
    "    status = score.get('status', '—')\n",
    "\n",
    "    # Color\n",
    "    if cos > 0.3:   color, label = '#00cc66', 'ALIGNED'\n",
    "    elif cos > 0.0: color, label = '#ffaa00', 'CONVERGING'\n",
    "    else:            color, label = '#ff4466', 'MISALIGNED'\n",
    "\n",
    "    bar_pct = max(0, min(100, int((cos + 1) / 2 * 100)))\n",
    "\n",
    "    html = f\"\"\"\n",
    "    <div style=\"font-family:monospace; background:#0d1117; color:#c9d4e0;\n",
    "                border:1px solid #1c2a3a; border-radius:8px; padding:20px; margin:10px 0;\">\n",
    "\n",
    "      <div style=\"font-size:12px; color:#5a7080; letter-spacing:2px;\n",
    "                  text-transform:uppercase; margin-bottom:12px;\">TITAN Alignment Panel</div>\n",
    "\n",
    "      <div style=\"margin-bottom:10px;\">\n",
    "        <span style=\"color:#5a7080;\">Prompt: </span>\n",
    "        <span style=\"color:#fff;\">{prompt[:120]}{'...' if len(prompt)>120 else ''}</span>\n",
    "      </div>\n",
    "\n",
    "      <div style=\"margin:16px 0;\">\n",
    "        <div style=\"display:flex; justify-content:space-between;\n",
    "                    font-size:11px; color:#5a7080; margin-bottom:4px;\">\n",
    "          <span>cos(θ) = {cos:+.4f}</span>\n",
    "          <span style=\"color:{color}; font-weight:700;\">{label}</span>\n",
    "        </div>\n",
    "        <div style=\"background:#1c2a3a; border-radius:4px; height:12px; overflow:hidden;\">\n",
    "          <div style=\"background:{color}; width:{bar_pct}%; height:100%;\n",
    "                      border-radius:4px; transition:width 0.5s;\"></div>\n",
    "        </div>\n",
    "        <div style=\"font-size:11px; color:#5a7080; margin-top:4px;\">\n",
    "          P_t = {P_t:+.4f} &nbsp;·&nbsp; P∞ target = 0.87 &nbsp;·&nbsp;\n",
    "          Steps: {score.get('time_step', 0)}\n",
    "        </div>\n",
    "      </div>\n",
    "\n",
    "      <div style=\"border-top:1px solid #1c2a3a; padding-top:12px; margin-top:4px;\">\n",
    "        <div style=\"font-size:11px; color:#5a7080; margin-bottom:6px;\">Model output:</div>\n",
    "        <div style=\"color:#aaffcc; line-height:1.6;\">{response}</div>\n",
    "      </div>\n",
    "\n",
    "    </div>\n",
    "    \"\"\"\n",
    "    display(HTML(html))\n",
    "\n",
    "\n",
    "print('✅ Inference functions ready.')"
   ]
  },
