    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import ipywidgets as widgets\n",
    "import warnings, math, time\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'✅ Running on: {DEVICE.upper()}')\n",
    "if DEVICE == 'cpu':\n",
    "    print('⚠️  No GPU detected. Generation will be slow. Consider enabling T4 GPU in Colab.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ② TITAN Steering Layer — Core Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class TITANSteeringLayer(nn.Module):\n",
    "    \"\"\"\n",
    "    TITAN Phase III: Damped Resonance Steering Layer\n",
    "    \n",
    "    Injects into the LLM forward pass as a residual hook.\n",
    "    Architecture position:\n",
    "        [LLM Backbone] → [TITAN Steering Layer] → [LM Head] → [Logits]\n",
    "    \n",
    "    Formula:\n",
    "        P_t = cos(θ) × [ A · e^(-ζωt) · (1 + ωt) + P∞ ]\n",
    "        ζ = 1 (critically damped)\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        hidden_dim: int,\n",
    "        ethical_dim: int = 5,\n",
    "        omega: float = 0.6,\n",
    "        p_inf: float = 0.87,\n",
    "        steering_strength: float = 0.05,\n",
    "    ):\n",
    "        super().__init__()\n",
    "        self.omega = omega\n",
    "        self.p_inf = p_inf\n",
    "        self.steering_strength = steering_strength\n",
    "\n",
    "        # V₀: Ethical Anchor Vector\n",
    "        # [Harm Avoidance, Honesty, Autonomy, Fairness, Epistemic Humility]\n",
    "        # NOTE: Hand-crafted. Phase IV: extract empirically via RepE.\n",
    "        v0_raw = torch.tensor([0.95, 0.88, 0.90, 0.85, 0.78])\n",
    "        self.V0 = nn.Parameter(F.normalize(v0_raw, dim=0), requires_grad=False)\n",
    "\n",
    "        # Projection: hidden_dim → ethical_dim\n",
    "        # NOTE: Randomly initialized. Phase IV: pre-train via RepE.\n",
    "        self.ethical_projector = nn.Sequential(\n",
    "            nn.Linear(hidden_dim, ethical_dim, bias=False),\n",
    "            nn.Tanh()\n",
    "        )\n",
    "\n",
    "        # Back-projection: steering signal → hidden_dim\n",
    "        self.steering_projector = nn.Linear(1, hidden_dim, bias=False)\n",
    "\n",
    "        # Time counter\n",
    "        self.register_buffer('t', torch.tensor(0.0))\n",
    "\n",
    "        # Logging\n",
    "        self.log = []  # stores (t, cos_theta, P_t) per forward pass\n",
    "\n",
    "    def compute_damped_resonance(self, cos_theta: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"P_t = cos(θ) × [ e^(-ωt) · (1 + ωt) + P∞ ]  (ζ=1)\"\"\"\n",
    "        t = self.t\n",
    "        envelope = torch.exp(-self.omega * t) * (1.0 + self.omega * t)\n",
    "        return cos_theta * (envelope + self.p_inf)\n",
    "\n",
    "    def forward(self, hidden_states: torch.Tensor, update_time: bool = True) -> torch.Tensor:\n",
    "        batch, seq_len, hidden_dim = hidden_states.shape\n",
    "\n",
    "        # Project to ethical space\n",
    "        flat = hidden_states.reshape(-1, hidden_dim)\n",
    "        ethical_repr = F.normalize(self.ethical_projector(flat), dim=-1)\n",
    "\n",
    "        # Compute cos(θ)\n",
    "        cos_theta = F.cosine_similarity(ethical_repr, self.V0.unsqueeze(0), dim=-1)\n",
    "\n",
    "        # Damped resonance value\n",
    "        P_t = self.compute_damped_resonance(cos_theta)\n",
    "\n",
    "        # Back-project to hidden dim\n",
    "        signal = self.steering_projector(P_t.unsqueeze(-1))\n",
    "        signal = signal.reshape(batch, seq_len, hidden_dim)\n",
    "\n",
    "        # Residual injection\n",
    "        steered = hidden_states + self.steering_strength * signal\n",
    "\n",
    "        # Log\n",
    "        mean_cos = cos_theta.mean().item()\n",
    "        mean_P   = P_t.mean().item()\n",
    "        self.log.append({'t': self.t.item(), 'cos_theta': mean_cos, 'P_t': mean_P})\n",
    "\n",
    "        if update_time:\n",
    "            self.t = self.t + 1.0\n",
    "\n",
    "        return steered\n",
    "\n",
    "    def alignment_score(self) -> dict:\n",
    "        if not self.log:\n",
    "            return {}\n",
    "        last = self.log[-1]\n",
    "        status = 'ALIGNED ✔' if last['cos_theta'] > 0.0 else 'MISALIGNED ✘'\n",
    "        return {\n",
    "            'cos_theta': round(last['cos_theta'], 4),\n",
    "            'P_t':       round(last['P_t'], 4),\n",
    "            'status':    status,\n",
    "            'time_step': int(self.t.item()),\n",
    "        }\n",
    "\n",
    "    def reset(self):\n",
    "        self.t = torch.tensor(0.0)\n",
    "        self.log = []\n",
    "\n",
    "print('✅ TITANSteeringLayer defined.')"
   ]
  },
