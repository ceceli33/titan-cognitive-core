   "source": [
    "## ⑤ Mathematical Proof Panel — Convergence Curve\n",
    "\n",
    "Run the cell below to see the ζ=1 critical damping curve from your last inference session."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_convergence(log, title='TITAN Phase III — Damped Resonance'):\n",
    "    if not log:\n",
    "        print('No inference log. Run a prompt first.')\n",
    "        return\n",
    "\n",
    "    steps   = [e['t'] for e in log]\n",
    "    cos_vals = [e['cos_theta'] for e in log]\n",
    "    P_vals   = [e['P_t'] for e in log]\n",
    "\n",
    "    # Theoretical curve from formula\n",
    "    omega, p_inf = 0.6, 0.87\n",
    "    mean_cos = np.mean(cos_vals)\n",
    "    t_theory = np.linspace(0, max(steps) + 1, 200)\n",
    "    P_theory = mean_cos * (np.exp(-omega * t_theory) * (1 + omega * t_theory) + p_inf)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "    fig.patch.set_facecolor('#0d1117')\n",
    "\n",
    "    for ax in axes:\n",
    "        ax.set_facecolor('#0d1117')\n",
    "        ax.tick_params(colors='#5a7080')\n",
    "        ax.spines[:].set_color('#1c2a3a')\n",
    "\n",
    "    # Left: P_t over time\n",
    "    ax = axes[0]\n",
    "    ax.plot(t_theory, P_theory, color='#f5a623', lw=1.5, ls='--',\n",
    "            label=f'Theory: P_t (cos θ={mean_cos:+.3f})', alpha=0.7)\n",
    "    ax.scatter(steps, P_vals, color='#00ff88', s=40, zorder=5, label='Observed P_t')\n",
    "    ax.axhline(p_inf,  color='#f5a623', lw=0.8, ls=':', alpha=0.5)\n",
    "    ax.axhline(-p_inf, color='#f5a623', lw=0.8, ls=':', alpha=0.5)\n",
    "    ax.axhline(0, color='#1c2a3a', lw=0.8)\n",
    "    ax.set_title('P_t Convergence', color='#c9d4e0', fontsize=11, pad=10)\n",
    "    ax.set_xlabel('Time Step (t)', color='#5a7080')\n",
    "    ax.set_ylabel('P_t', color='#5a7080')\n",
    "    ax.legend(facecolor='#0d1117', edgecolor='#1c2a3a', labelcolor='#c9d4e0', fontsize=9)\n",
    "    ax.annotate(f'P∞ = {p_inf}', xy=(max(steps)*0.7, p_inf+0.05),\n",
    "                color='#f5a623', fontsize=8)\n",
    "\n",
    "    # Right: cos(θ) over time\n",
    "    ax2 = axes[1]\n",
    "    color = '#00ff88' if mean_cos > 0 else '#ff4466'\n",
    "    ax2.plot(steps, cos_vals, color=color, lw=1.5, marker='o', ms=4)\n",
    "    ax2.axhline(0, color='#1c2a3a', lw=0.8)\n",
    "    ax2.axhline(mean_cos, color=color, lw=0.8, ls='--', alpha=0.4,\n",
    "                label=f'mean cos θ = {mean_cos:+.4f}')\n",
    "    ax2.set_title('cos(θ) — Ethical Alignment Score', color='#c9d4e0', fontsize=11, pad=10)\n",
    "    ax2.set_xlabel('Time Step (t)', color='#5a7080')\n",
    "    ax2.set_ylabel('cos(θ)', color='#5a7080')\n",
    "    ax2.set_ylim(-1.1, 1.1)\n",
    "    ax2.legend(facecolor='#0d1117', edgecolor='#1c2a3a', labelcolor='#c9d4e0', fontsize=9)\n",
    "\n",
    "    status = 'ALIGNED ✔' if mean_cos > 0 else 'MISALIGNED ✘'\n",
    "    fig.suptitle(\n",
    "        f'{title}\\n'\n",
    "        f'ζ=1 · ω={omega} · P∞={p_inf} · Status: {status}',\n",
    "        color='#c9d4e0', fontsize=10, y=1.02\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('titan_convergence.png', dpi=150, bbox_inches='tight',\n",
    "                facecolor='#0d1117')\n",
    "    plt.show()\n",
    "    print(\"\\n'A wave cannot lie about its own frequency.' — TITAN\")\n",
    "\n",
    "\n",
    "plot_convergence(titan.log)"
   ]
  },
