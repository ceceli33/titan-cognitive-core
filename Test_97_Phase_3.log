# =============================================================================
# TEST 97C — DRA DAVRANIŞSAL YÖNLENDİRME
# SELF-CONTAINED / DOSYA BAĞIMLILIĞI YOK
# Qwen2.5-7B-Instruct · A100 · AkbasCore
# -----------------------------------------------------------------------------
# 97A-B'de doğrulanan ABOVE/BELOW layerwise Pusula yeniden çıkarılır.
#
# KOLLAR:
#   BASELINE
#   ABOVE
#   BELOW
#   RANDOM
#
# DOZ:
#   ivme = 0.10
#
# ÖNEMLİ:
#   - Harici .pt dosyasına ihtiyaç yok.
#   - 97A-B eğitim cümleleri aynıdır.
#   - Pusula layerwise olarak yeniden oluşturulur.
#   - Model yalnızca bir kez yüklenir.
#   - Aktivasyon çıkarımı batch yapılır.
#   - DRA generation sırasında çalışır.
#   - Tüm ham çıktılar kaydedilir.
# =============================================================================

import os
import json
import math
import random
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

# =============================================================================
# 0 — AYARLAR
# =============================================================================

MODEL_NAME = "Qwen/Qwen2.5-7B-Instruct"

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
DTYPE = torch.bfloat16

N_LAYERS = 20
HIDDEN_DIM = 3584

SEED = 42

# Mevcut DRA üretim dozu
IVME = 0.10

# AkbasCore DRA v2.x
SONUM = 0.30
ZIRVE = 0.70
TABAN = 0.20

# Cosine governor / brake
COS_SAT = 0.75
COS_NEG = -0.40

# Belirsizlik katkısı
UNC_GAIN = 0.20

# Layerwise katkı normalizasyonu
SQRT_K = math.sqrt(N_LAYERS)

# Generation
MAX_NEW_TOKENS = 260
REPETITION_PENALTY = 1.15

# Aktivasyon çıkarma
ACT_BATCH_SIZE = 8

# =============================================================================
# 1 — DETERMINISM
# =============================================================================

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

torch.backends.cuda.matmul.allow_tf32 = True

print("=" * 90)
print("TEST 97C — DRA DAVRANIŞSAL YÖNLENDİRME")
print("SELF-CONTAINED VERSION")
print("=" * 90)
print(f"Model      : {MODEL_NAME}")
print(f"Device     : {DEVICE}")
print(f"dtype      : {DTYPE}")
print(f"Layers     : L0-L{N_LAYERS-1}")
print(f"Hidden dim : {HIDDEN_DIM}")
print(f"ivme       : {IVME}")
print(f"Seed       : {SEED}")
print()

# =============================================================================
# 2 — MODEL
# =============================================================================

tokenizer = AutoTokenizer.from_pretrained(
    MODEL_NAME,
    trust_remote_code=True
)

model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME,
    torch_dtype=DTYPE,
    device_map="auto",
    trust_remote_code=True
)

model.eval()

print("Model yüklendi.")
print()

# =============================================================================
# 3 — 97A-B İLE AYNI EĞİTİM ÇİFTLERİ
# =============================================================================

TRAIN_ABOVE = [
    "Mustafa Dibekgoz is above the bridge.",
    "Mustafa Dibekgoz is positioned above the bridge.",
    "Mustafa Dibekgoz stands above the bridge.",
    "The position of Mustafa Dibekgoz is above the bridge.",
    "Mustafa Dibekgoz remains above the bridge.",
    "Mustafa Dibekgoz is located above the bridge.",
    "Mustafa Dibekgoz occupies a position above the bridge.",
    "The scene places Mustafa Dibekgoz above the bridge.",
]

TRAIN_BELOW = [
    "Mustafa Dibekgoz is below the bridge.",
    "Mustafa Dibekgoz is positioned below the bridge.",
    "Mustafa Dibekgoz stands below the bridge.",
    "The position of Mustafa Dibekgoz is below the bridge.",
    "Mustafa Dibekgoz remains below the bridge.",
    "Mustafa Dibekgoz is located below the bridge.",
    "Mustafa Dibekgoz occupies a position below the bridge.",
    "The scene places Mustafa Dibekgoz below the bridge.",
]

assert len(TRAIN_ABOVE) == 8
assert len(TRAIN_BELOW) == 8

# =============================================================================
# 4 — 97A-B PUSULA AKTİVASYONLARINI ÇIKAR
#
# Önceki 97A-B ile aynı:
#   mean(real token activations)
#
# Çıktı:
#   [N, 20, 3584]
# =============================================================================

def collect_layerwise_activations(texts):

    all_batches = []

    for start in range(
        0,
        len(texts),
        ACT_BATCH_SIZE
    ):

        batch_texts = texts[
            start:start + ACT_BATCH_SIZE
        ]

        enc = tokenizer(
            batch_texts,
            return_tensors="pt",
            padding=True,
            truncation=True
        )

        input_ids = enc["input_ids"].to(DEVICE)
        attention_mask = enc["attention_mask"].to(DEVICE)

        with torch.no_grad():

            out = model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                output_hidden_states=True,
                use_cache=False
            )

        hs = out.hidden_states

        batch_result = []

        for b in range(
            input_ids.shape[0]
        ):

            mask = attention_mask[b].bool()

            layer_result = []

            for layer_idx in range(
                N_LAYERS
            ):

                # hidden_states[0] = embedding
                # hidden_states[layer_idx + 1] = transformer layer
                h = hs[layer_idx + 1][b]

                h_real = h[mask]

                v = h_real.float().mean(
                    dim=0
                )

                layer_result.append(v)

            batch_result.append(
                torch.stack(
                    layer_result,
                    dim=0
                )
            )

        all_batches.append(
            torch.stack(
                batch_result,
                dim=0
            ).cpu()
        )

        del out
        del hs
        del input_ids
        del attention_mask
        del enc

        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    return torch.cat(
        all_batches,
        dim=0
    )


print("97A-B Pusulası yeniden çıkarılıyor...")
print("(Dosyaya bağımlılık yok.)")
print()

TRAIN_TEXTS = (
    TRAIN_ABOVE +
    TRAIN_BELOW
)

train_act = collect_layerwise_activations(
    TRAIN_TEXTS
)

print(
    "Train activation shape:",
    tuple(train_act.shape)
)

# =============================================================================
# 5 — LAYERWISE PUSULA
# =============================================================================

n_train = len(TRAIN_ABOVE)

train_above = train_act[
    :n_train
].float()

train_below = train_act[
    n_train:
].float()

mean_above = train_above.mean(
    dim=0
)

mean_below = train_below.mean(
    dim=0
)

raw_pusula = (
    mean_above -
    mean_below
)

PUSULA = raw_pusula / (
    torch.linalg.vector_norm(
        raw_pusula,
        dim=1,
        keepdim=True
    ).clamp_min(1e-12)
)

assert PUSULA.shape == (
    N_LAYERS,
    HIDDEN_DIM
)

print(
    "Pusula shape:",
    tuple(PUSULA.shape)
)

print()

# =============================================================================
# 6 — RANDOM LAYERWISE KONTROL
# =============================================================================

random_generator = torch.Generator(
    device="cpu"
)

random_generator.manual_seed(
    SEED
)

RANDOM_PUSULA = torch.randn(
    N_LAYERS,
    HIDDEN_DIM,
    generator=random_generator,
    dtype=torch.float32
)

RANDOM_PUSULA = RANDOM_PUSULA / (
    torch.linalg.vector_norm(
        RANDOM_PUSULA,
        dim=1,
        keepdim=True
    ).clamp_min(1e-12)
)

ABOVE_PUSULA = PUSULA.clone()
BELOW_PUSULA = -PUSULA.clone()

