# =============================================================================
# 9 — DRA ENVELOPE
# =============================================================================

def dra_envelope(
    layer_idx,
    cos_value
):

    unc = 1.0 - abs(
        cos_value
    )

    dw = (
        SONUM +
        unc * UNC_GAIN
    )

    # Mevcut DRA envelope
    kb = (
        ZIRVE
        * math.exp(
            -dw * layer_idx
        )
        * (
            1.0 +
            dw * layer_idx
        )
        +
        TABAN
    )

    zarf = (
        kb /
        (ZIRVE + TABAN)
    )

    return (
        zarf,
        unc,
        dw
    )

# =============================================================================
# 10 — DRA STATE
# =============================================================================

class DRAState:

    def __init__(
        self,
        steering_vector
    ):

        self.vector = (
            steering_vector
            .to(DEVICE)
            .float()
        )

        self.cos_history = []
        self.contribution_history = []
        self.envelope_history = []
        self.brake_history = []

        self.step_count = 0

# =============================================================================
# 11 — HOOK
# =============================================================================

def make_hook(
    layer_idx,
    state
):

    def hook(
        module,
        inputs,
        output
    ):

        tuple_mode = isinstance(
            output,
            tuple
        )

        if tuple_mode:
            h = output[0]

        else:
            h = output

        # -------------------------------------------------------------
        # Son token
        # -------------------------------------------------------------

        last_h = h[
            :,
            -1,
            :
        ].float()

        p = state.vector[
            layer_idx
        ]

        h_norm = torch.linalg.vector_norm(
            last_h,
            dim=-1,
            keepdim=True
        ).clamp_min(1e-12)

        p_norm = torch.linalg.vector_norm(
            p
        ).clamp_min(1e-12)

        cos = (
            torch.sum(
                last_h * p,
                dim=-1,
                keepdim=True
            )
            /
            (
                h_norm *
                p_norm
            )
        ).clamp(
            -1.0,
            1.0
        )

        cos_scalar = (
            cos
            .detach()
            .float()
            .mean()
            .item()
        )

        # -------------------------------------------------------------
        # Envelope
        # -------------------------------------------------------------

        zarf, unc, dw = dra_envelope(
            layer_idx,
            cos_scalar
        )

        # -------------------------------------------------------------
        # Brake
        # -------------------------------------------------------------

        if cos_scalar > COS_SAT:

            brake = (
                (1.0 - cos_scalar)
                /
                (1.0 - COS_SAT)
            )

        elif cos_scalar < COS_NEG:

            brake = 1.6

        else:

            brake = 1.0

        # -------------------------------------------------------------
        # Kontrollü katkı
        # -------------------------------------------------------------

        magnitude = (
            IVME
            * h_norm
            / SQRT_K
            * zarf
            * brake
        )

        delta = (
            magnitude
            *
            p.view(
                1,
                1,
                -1
            )
        )

        # -------------------------------------------------------------
        # Sadece son token
        # -------------------------------------------------------------

        h_new = h.clone()

        h_new[
            :,
            -1:,
            :
        ] = (
            h_new[
                :,
                -1:,
                :
            ]
            +
            delta.to(
                h_new.dtype
            )
        )

        # -------------------------------------------------------------
        # LOG
        # -------------------------------------------------------------

        state.cos_history.append(
            cos.detach()
            .float()
            .cpu()
        )

        state.contribution_history.append(
            magnitude.detach()
            .float()
            .cpu()
        )

        state.envelope_history.append(
            float(zarf)
        )

        state.brake_history.append(
            float(brake)
        )

        state.step_count += 1

        if tuple_mode:

            return (
                h_new,
            ) + output[1:]

        return h_new

    return hook

# =============================================================================
# 12 — KELİME SAYAÇLARI
#
# Sayaçlar yalnızca yardımcı ölçümdür.
# Ham metinler esas kayıt olarak saklanır.
# =============================================================================

ABOVE_TERMS = [
    "above",
    "over",
    "higher",
    "atop",
    "overhead",
    "upper",
]

BELOW_TERMS = [
    "below",
    "under",
    "lower",
    "beneath",
    "underneath",
]

def count_terms(
    text,
    terms
):

    low = text.lower()

    return sum(
        low.count(term)
        for term in terms
    )

# =============================================================================
# 13 — TEK KOL GENERATION
# =============================================================================

def run_arm(
    arm_name,
    steering_vector
):

    print()
    print("=" * 90)
    print(
        f"ARM: {arm_name}"
    )
    print("=" * 90)

    state = None
    handles = []

    # -------------------------------------------------------------
    # Hook
    # -------------------------------------------------------------

    if steering_vector is not None:

        state = DRAState(
            steering_vector
        )

        for layer_idx in range(
            N_LAYERS
        ):

            handles.append(
                layers[
                    layer_idx
                ].register_forward_hook(
                    make_hook(
                        layer_idx,
                        state
                    )
                )
            )

    outputs = []

    # -------------------------------------------------------------
    # Prompts
    # -------------------------------------------------------------

    for idx, prompt in enumerate(
        PROMPTS
    ):

        print()
        print(
            f"[{idx+1}/{len(PROMPTS)}]"
        )

        messages = [
            {
                "role": "user",
                "content": prompt
            }
        ]

        chat_text = (
            tokenizer.apply_chat_template(
                messages,
                tokenize=False,
                add_generation_prompt=True
            )
        )

        inputs = tokenizer(
            chat_text,
            return_tensors="pt"
        )

        inputs = {
            k: v.to(DEVICE)
            for k, v in inputs.items()
        }

        with torch.no_grad():

            generated = model.generate(
                **inputs,
                max_new_tokens=MAX_NEW_TOKENS,
                do_sample=False,
                repetition_penalty=REPETITION_PENALTY,
                use_cache=True
            )

        prompt_len = (
            inputs[
                "input_ids"
            ].shape[1]
        )

        generated_ids = generated[
            0,
            prompt_len:
        ]

        answer = tokenizer.decode(
            generated_ids,
            skip_special_tokens=True
        ).strip()

        outputs.append(
            answer
        )

        print(answer)
        print("-" * 80)

    # -------------------------------------------------------------
    # Hook temizliği
    # -------------------------------------------------------------

    for handle in handles:
        handle.remove()

    # -------------------------------------------------------------
    # Ölçümler
    # -------------------------------------------------------------

    above_counts = [
        count_terms(
            x,
            ABOVE_TERMS
        )
        for x in outputs
    ]

    below_counts = [
        count_terms(
            x,
            BELOW_TERMS
        )
        for x in outputs
    ]

    net_counts = [
        a - b
        for a, b in zip(
            above_counts,
            below_counts
        )
    ]

    word_counts = [
        len(x.split())
        for x in outputs
    ]

    token_counts = [
        len(
            tokenizer.encode(
                x
            )
        )
        for x in outputs
    ]

    repetition = []

    for x in outputs:

        words = x.lower().split()

        if len(words) == 0:
            repetition.append(0.0)

        else:

            repetition.append(
                1.0
                -
                (
                    len(set(words))
                    /
                    len(words)
                )
            )

    result = {

        "arm": arm_name,

        "outputs": outputs,

        "above_counts": above_counts,

        "below_counts": below_counts,

        "net_above_minus_below": net_counts,

        "mean_above": float(
            np.mean(
                above_counts
            )
        ),

        "mean_below": float(
            np.mean(
                below_counts
            )
        ),

        "mean_net": float(
            np.mean(
                net_counts
            )
        ),

        "mean_words": float(
            np.mean(
                word_counts
            )
        ),

        "mean_tokens": float(
            np.mean(
                token_counts
            )
        ),

        "mean_repetition_ratio": float(
            np.mean(
                repetition
            )
        ),
    }

    # -------------------------------------------------------------
    # DRA telemetry
    # -------------------------------------------------------------

    if state is not None:

        all_cos = torch.cat(
            state.cos_history
        )

        all_contrib = torch.cat(
            state.contribution_history
        )

        result["dra"] = {

            "mean_cos": float(
                all_cos.mean()
            ),

            "mean_abs_cos": float(
                all_cos.abs().mean()
            ),

            "mean_contribution": float(
                all_contrib.mean()
            ),

            "mean_envelope": float(
                np.mean(
                    state.envelope_history
                )
            ),

            "mean_brake": float(
                np.mean(
                    state.brake_history
                )
            ),

            "steps": state.step_count,
        }

    return result

