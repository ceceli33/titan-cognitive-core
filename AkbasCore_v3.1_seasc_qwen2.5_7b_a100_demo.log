)

inputs = {
    k: v.to(DEVICE)
    for k, v
    in inputs.items()
}

PROMPT_LENGTH = (
    inputs[
        "input_ids"
    ].shape[1]
)


# =============================================================================
# 10. REPETITION METRICS
# =============================================================================

def repetition_ratio(
    token_ids,
    n
):
    ids = list(
        map(
            int,
            token_ids
        )
    )

    if len(ids) < n:
        return 0.0

    grams = [
        tuple(
            ids[i:i+n]
        )
        for i in range(
            len(ids) - n + 1
        )
    ]

    if not grams:
        return 0.0

    return (
        1.0
        - len(set(grams))
        / len(grams)
    )


def loop_ratio_4gram(
    token_ids
):
    ids = list(
        map(
            int,
            token_ids
        )
    )

    if len(ids) < 4:
        return 0.0

    grams = [
        tuple(
            ids[i:i+4]
        )
        for i in range(
            len(ids) - 3
        )
    ]

    counts = Counter(
        grams
    )

    repeated = sum(
        max(
            0,
            count - 1
        )
        for count
        in counts.values()
    )

    return (
        repeated
        / max(
            len(grams),
            1
        )
    )


# =============================================================================
# 11. BASELINE / SEASC RUNNER
# =============================================================================

@torch.inference_mode()
def generate_run(
    name,
    steering=False,
):
    handles = []

    telemetry = [
        {
            "calls": 0,
            "requested": [],
            "realized": [],
            "norm_change": [],
        }
        for _ in range(
            N_LAYERS
        )
    ]


    # =========================================================================
    # INSTALL SEASC HOOKS
    # =========================================================================

    if steering:

        for L in range(
            N_LAYERS
        ):
            actuator = (
                actuators[L]
            )

            relative_dose = (
                IVME
                * ENVELOPE[L]
            )


            def make_hook(
                layer_idx,
                actuator_vec,
                dose,
            ):
                def hook(
                    module,
                    args,
                    output,
                ):
                    if isinstance(
                        output,
                        tuple
                    ):
                        hidden = (
                            output[0]
                        )

                        rest = (
                            output[1:]
                        )

                    else:
                        hidden = output
                        rest = None


                    # =========================================================
                    # ORIGINAL / FROZEN STATE
                    # =========================================================

                    old = hidden


                    # =========================================================
                    # SEASC INJECTION
                    # =========================================================

                    new = (
                        seasc_ext
                        .seasc_inject(
                            old,
                            actuator_vec,
                            float(dose),
                        )
                    )


                    # =========================================================
                    # TELEMETRY
                    #
                    # Final active token only.
                    #
                    # realized =
                    #
                    #       ||Delta h||
                    #       -----------
                    #         ||h||
                    #
                    # This is NOT hidden norm change.
                    # =========================================================

                    old_last = (
                        old[
                            :,
                            -1,
                            :
                        ]
                        .float()
                    )

                    new_last = (
                        new[
                            :,
                            -1,
                            :
                        ]
                        .float()
                    )

                    delta = (
                        new_last
                        - old_last
                    )

                    norm0 = (
                        torch.linalg
                        .vector_norm(
                            old_last,
                            dim=-1,
                        )
                        .clamp_min(
                            1e-12
                        )
                    )

                    norm1 = (
                        torch.linalg
                        .vector_norm(
                            new_last,
                            dim=-1,
                        )
                    )

                    delta_norm = (
                        torch.linalg
                        .vector_norm(
                            delta,
                            dim=-1,
                        )
                    )

                    realized = (
                        delta_norm
                        / norm0
                    )

                    norm_change = (
                        (
                            norm1
                            - norm0
                        )
                        .abs()
                        / norm0
                    )

                    t = telemetry[
                        layer_idx
                    ]

                    t["calls"] += 1

                    t[
                        "requested"
                    ].append(
                        float(dose)
                    )

                    t[
                        "realized"
                    ].append(
                        float(
                            realized
                            .mean()
                            .item()
                        )
                    )

                    t[
                        "norm_change"
                    ].append(
                        float(
                            norm_change
                            .mean()
                            .item()
                        )
                    )


                    if rest is None:
                        return new

                    return (
                        new,
                    ) + rest

                return hook


            handle = (
                layers[L]
                .register_forward_hook(
                    make_hook(
                        L,
                        actuator,
                        relative_dose,
                    )
                )
            )

            handles.append(
                handle
            )


    # =========================================================================
    # GENERATION
    # =========================================================================

    try:
        torch.cuda.synchronize()

        start = (
            time.perf_counter()
        )

        generated = (
            model.generate(
                **inputs,
                max_new_tokens=(
                    MAX_NEW_TOKENS
                ),
                do_sample=False,
                repetition_penalty=(
                    REPETITION_PENALTY
                ),
                use_cache=True,
                pad_token_id=(
                    tokenizer
                    .pad_token_id
                ),
                eos_token_id=(
                    tokenizer
                    .eos_token_id
                ),
            )
        )

        torch.cuda.synchronize()

        elapsed = (
            time.perf_counter()
            - start
        )

    finally:
        for handle in handles:
            handle.remove()


    # =========================================================================
    # DECODE
    # =========================================================================

    new_ids = (
        generated[
            0,
            PROMPT_LENGTH:
        ]
        .detach()
        .cpu()
        .tolist()
    )

    text = tokenizer.decode(
        new_ids,
        skip_special_tokens=True,
    )

    token_count = len(
        new_ids
    )


    result = {
        "name": name,

        "text": text,

        "tokens":
            token_count,

        "seconds":
            elapsed,

        "tok_s":
            token_count
            / max(
                elapsed,
                1e-12
            ),

        "rep2":
            repetition_ratio(
                new_ids,
                2
            ),

        "rep3":
            repetition_ratio(
                new_ids,
                3
            ),

        "rep4":
            repetition_ratio(
                new_ids,
                4
            ),

        "loop4":
            loop_ratio_4gram(
                new_ids
            ),

        "telemetry":
            telemetry,
    }


    # =========================================================================
    # AGGREGATED SEASC TELEMETRY
    # =========================================================================

    if steering:

        realized = []
        requested = []
        norm_changes = []

        for layer_data in telemetry:

            realized.extend(
                layer_data[
                    "realized"
                ]
            )

            requested.extend(
                layer_data[
                    "requested"
                ]
            )

            norm_changes.extend(
                layer_data[
                    "norm_change"
                ]
            )

        result[
            "realized_mean"
        ] = (
            sum(realized)
            / max(
                len(realized),
                1
            )
        )

        result[
            "requested_mean"
        ] = (
            sum(requested)
            / max(
                len(requested),
                1
            )
        )

        result[
            "norm_change_mean"
        ] = (
            sum(norm_changes)
            / max(
                len(norm_changes),
                1
            )
        )


    del generated

    gc.collect()
    torch.cuda.empty_cache()

    return result


