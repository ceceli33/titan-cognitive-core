# =============================================================================
# 5. NATIVE C++ / CUDA EXTENSION
#
# SEASC injection law:
#
#   rho_L = IVME * E(L)
#
#   norm0 = ||h_L||
#
#   Delta h_L =
#       rho_L * norm0 * A_L
#
#   h'_L =
#       h_L + Delta h_L
#
# A_L is unit-normalized.
#
# IMPORTANT:
#
#   norm0 is measured BEFORE intervention.
#
# Compass construction and runtime dose are separate:
#
#   Compass Foundry -> direction A_L
#   SEASC           -> physical magnitude rho_L * ||h_L||
#
# There is:
#
#   NO cosine magnitude gate
#   NO cap
#   NO brake
#   NO radar
#   NO controller
# =============================================================================

CPP_SOURCE = r"""
#include <torch/extension.h>

torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
);

torch::Tensor seasc_inject(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {
    TORCH_CHECK(
        hidden.is_cuda(),
        "hidden must be CUDA"
    );

    TORCH_CHECK(
        actuator.is_cuda(),
        "actuator must be CUDA"
    );

    TORCH_CHECK(
        hidden.dim() == 3,
        "hidden must be [B,S,H]"
    );

    TORCH_CHECK(
        actuator.dim() == 1,
        "actuator must be [H]"
    );

    TORCH_CHECK(
        hidden.size(2) == actuator.size(0),
        "hidden size and actuator size mismatch"
    );

    TORCH_CHECK(
        relative_dose >= 0.0,
        "relative_dose must be non-negative"
    );

    return seasc_inject_cuda(
        hidden,
        actuator,
        relative_dose
    );
}

PYBIND11_MODULE(
    TORCH_EXTENSION_NAME,
    m
) {
    m.def(
        "seasc_inject",
        &seasc_inject,
        "AkbasCore 3.1 SEASC frozen-norm injection (CUDA)"
    );
}
"""


CUDA_SOURCE = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>

#include <c10/cuda/CUDAGuard.h>
#include <c10/cuda/CUDAException.h>

#include <cuda.h>
#include <cuda_runtime.h>


// =============================================================================
// SEASC CUDA KERNEL
//
// One CUDA block processes one hidden vector.
//
// Input:
//      h          : [B,S,H] flattened into n_vectors x hidden_size
//      actuator   : normalized FP32 [H]
//      relative_dose
//
// Operation:
//
//      norm0 = ||h||
//
//      scale = relative_dose * norm0
//
//      h <- h + scale * actuator
//
// The norm is computed before any component of the vector is modified.
// =============================================================================

template <typename scalar_t>
__global__ void seasc_kernel(
    scalar_t* __restrict__ h,
    const float* __restrict__ actuator,
    const int hidden_size,
    const int n_vectors,
    const float relative_dose
) {
    const int vec = blockIdx.x;

    if (vec >= n_vectors) {
        return;
    }

    extern __shared__ float shared[];

    float local_sum = 0.0f;

    const long long base =
        static_cast<long long>(vec)
        * static_cast<long long>(hidden_size);


    // =========================================================================
    // PHASE 1 — FROZEN NORM
    // =========================================================================

    for (
        int j = threadIdx.x;
        j < hidden_size;
        j += blockDim.x
    ) {
        const float x =
            static_cast<float>(
                h[base + j]
            );

        local_sum += x * x;
    }

    shared[threadIdx.x] =
        local_sum;

    __syncthreads();


    // =========================================================================
    // BLOCK REDUCTION
    // =========================================================================

    for (
        unsigned int stride =
            blockDim.x / 2;
        stride > 0;
        stride >>= 1
    ) {
        if (
            threadIdx.x < stride
        ) {
            shared[threadIdx.x] +=
                shared[
                    threadIdx.x
                    + stride
                ];
        }

        __syncthreads();
    }


    // =========================================================================
    // PHASE 2 — DIRECT PHYSICAL DOSE
    // =========================================================================

    const float norm0 =
        sqrtf(
            fmaxf(
                shared[0],
                1.0e-20f
            )
        );

    const float scale =
        relative_dose
        * norm0;

    __syncthreads();


    // =========================================================================
    // PHASE 3 — FULL-SPACE ACTUATOR INJECTION
    // =========================================================================

    for (
        int j = threadIdx.x;
        j < hidden_size;
        j += blockDim.x
    ) {
        const float old_value =
            static_cast<float>(
                h[base + j]
            );

        const float new_value =
            old_value
            + scale
            * actuator[j];

        h[base + j] =
            static_cast<scalar_t>(
                new_value
            );
    }
}


// =============================================================================
// CUDA ENTRY POINT
// =============================================================================

torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {
    auto out =
        hidden
        .contiguous()
        .clone();

    auto act =
        actuator
        .to(
            hidden.device(),
            torch::kFloat32
        )
        .contiguous();

    const int hidden_size =
        static_cast<int>(
            out.size(2)
        );

    const int n_vectors =
        static_cast<int>(
            out.numel()
            / hidden_size
        );

    constexpr int THREADS =
        256;

    const size_t shared_bytes =
        THREADS
        * sizeof(float);

    cudaStream_t stream =
        at::cuda::getCurrentCUDAStream();

    AT_DISPATCH_FLOATING_TYPES_AND2(
        at::ScalarType::Half,
        at::ScalarType::BFloat16,
        out.scalar_type(),
        "akbascore_seasc_v31_cuda",
        [&] {
            seasc_kernel<scalar_t>
                <<<n_vectors,
                   THREADS,
                   shared_bytes,
                   stream>>>(
                    out.data_ptr<scalar_t>(),
                    act.data_ptr<float>(),
                    hidden_size,
                    n_vectors,
                    static_cast<float>(
                        relative_dose
                    )
                );
        }
    );

    C10_CUDA_KERNEL_LAUNCH_CHECK();

    return out;
}
"""


