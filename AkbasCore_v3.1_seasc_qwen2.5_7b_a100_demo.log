# =============================================================================
# 7. STATIC NORMALIZED DRA ENVELOPE
#
# kb(L) =
#
#   Zirve * exp(-Sonum * L)
#   * (1 + Sonum * L)
#   + Taban
#
# E(L) =
#
#   kb(L) / kb(0)
#
# Therefore:
#
#   E(0) = 1
# =============================================================================

def dra_envelope(
    layer_idx
):
    t = float(
        layer_idx
    )

    kb = (
        ZIRVE
        * math.exp(
            -SONUM * t
        )
        * (
            1.0
            + SONUM * t
        )
        + TABAN
    )

    kb0 = (
        ZIRVE
        + TABAN
    )

    return (
        kb / kb0
    )


ENVELOPE = [
    dra_envelope(L)
    for L
    in range(N_LAYERS)
]


print(
    "\nStatic normalized "
    "DRA envelope:"
)

for L, env in enumerate(
    ENVELOPE
):
    print(
        f"  L{L:02d}: "
        f"E={env:.6f} | "
        f"dose="
        f"{100.0 * IVME * env:.3f}%"
    )


# =============================================================================
# 8. COMPASS FOUNDRY — SUBSPACE-FISHER
#
# For every layer L:
#
#   H+_L = individual positive activation samples
#   H-_L = individual negative activation samples
#
#   mu+_L = mean(H+_L)
#   mu-_L = mean(H-_L)
#
#   d_L = mu+_L - mu-_L
#
# Within-class residual matrix:
#
#   R_L = [
#       H+_L - mu+_L
#       H-_L - mu-_L
#   ]
#
# Conceptually:
#
#   C_L = R_L^T R_L / nu
#
# Desired reliability-weighted direction:
#
#   x_L = (C_L + lambda_L I)^(-1) d_L
#
# IMPORTANT:
#
#   C_L is NEVER explicitly constructed.
#
# Reduced SVD:
#
#   R_L = U S V^T
#
# gives:
#
#   x =
#       d / lambda
#       +
#       V [
#           (1/(S^2/nu + lambda) - 1/lambda)
#           * (V^T d)
#       ]
#
# Final compass:
#
#   A_L = x_L / ||x_L||
#
# All Foundry math is FP32.
# =============================================================================

@torch.inference_mode()
def collect_hidden_samples(
    texts
):
    samples = [
        []
        for _ in range(
            N_LAYERS
        )
    ]

    for text in texts:

        enc = tokenizer(
            text,
            return_tensors="pt",
            add_special_tokens=True,
        )

        enc = {
            k: v.to(DEVICE)
            for k, v
            in enc.items()
        }

        out = model(
            **enc,
            output_hidden_states=True,
            use_cache=False,
            return_dict=True,
        )

        last_token = (
            int(
                enc[
                    "attention_mask"
                ][0]
                .sum()
                .item()
            )
            - 1
        )

        for L in range(
            N_LAYERS
        ):
            h = (
                out.hidden_states[
                    L + 1
                ][
                    0,
                    last_token,
                    :
                ]
                .float()
            )

            samples[L].append(
                h
            )

        del out
        del enc

    return [
        torch.stack(
            layer_samples,
            dim=0,
        )
        for layer_samples
        in samples
    ]


print(
    "\n[4/8] Extracting matched "
    "positive activation samples..."
)

positive_samples = (
    collect_hidden_samples(
        POSITIVE
    )
)

gc.collect()
torch.cuda.empty_cache()


print(
    "[5/8] Extracting matched "
    "negative activation samples..."
)

negative_samples = (
    collect_hidden_samples(
        NEGATIVE
    )
)


print(
    "[6/8] Compass Foundry: "
    "building Subspace-Fisher "
    "per-layer compasses..."
)

actuators = []
foundry_telemetry = []


for L in range(
    N_LAYERS
):
    H_pos = (
        positive_samples[L]
        .float()
    )

    H_neg = (
        negative_samples[L]
        .float()
    )


    # =========================================================================
    # CLASS MEANS / RAW CONTRAST
    # =========================================================================

    mu_pos = (
        H_pos.mean(
            dim=0
        )
    )

    mu_neg = (
        H_neg.mean(
            dim=0
        )
    )

    mean_diff = (
        mu_pos
        - mu_neg
    )

    mean_diff_norm = (
        torch.linalg
        .vector_norm(
            mean_diff
        )
        .clamp_min(
            FISHER_EPS
        )
    )


    # =========================================================================
    # WITHIN-CLASS RESIDUAL GEOMETRY
    # =========================================================================

    R_pos = (
        H_pos
        - mu_pos.unsqueeze(0)
    )

    R_neg = (
        H_neg
        - mu_neg.unsqueeze(0)
    )

    R = (
        torch.cat(
            [
                R_pos,
                R_neg,
            ],
            dim=0,
        )
        .float()
    )

    # Degrees of freedom for two class means.
    nu = max(
        int(R.shape[0]) - 2,
        1,
    )


    # =========================================================================
    # REDUCED SVD
    #
    # R shape:
    #
    #       [2N, H]
    #
    # For 8 + 8 examples and Qwen2.5-7B:
    #
    #       [16, 3584]
    #
    # No H x H covariance is created.
    # =========================================================================

    U, S, Vh = (
        torch.linalg.svd(
            R,
            full_matrices=False,
        )
    )

    eig = (
        S.square()
        / float(nu)
    )


    # =========================================================================
    # SCALE-ADAPTIVE RIDGE
    #
    # Zero / near-zero singular modes are excluded from the scale estimate.
    # lambda still acts over the complete ambient space through d/lambda.
    # =========================================================================

    positive_eig = (
        eig[
            eig > FISHER_EPS
        ]
    )

    if (
        positive_eig.numel()
        > 0
    ):
        eig_scale = (
            torch.median(
                positive_eig
            )
        )
    else:
        eig_scale = (
            torch.tensor(
                1.0,
                dtype=torch.float32,
                device=DEVICE,
            )
        )

    ridge_lambda = (
        FISHER_ALPHA
        * eig_scale
    ).clamp_min(
        FISHER_EPS
    )


    # =========================================================================
    # LOW-RANK REGULARIZED INVERSE ACTION
    #
    # x =
    #
    #   d/lambda
    #
    #   + V [
    #       (1/(eig+lambda) - 1/lambda)
    #       * (V^T d)
    #     ]
    #
    # This includes both:
    #
    #   - residual subspace
    #   - orthogonal complement
    #
    # without constructing or inverting C.
    # =========================================================================

    V = (
        Vh.transpose(
            0,
            1,
        )
    )

    projection = (
        V.transpose(
            0,
            1,
        )
        @ mean_diff
    )

    correction = (
        (
            1.0
            / (
                eig
                + ridge_lambda
            )
            -
            1.0
            / ridge_lambda
        )
        * projection
    )

    fisher_direction = (
        mean_diff
        / ridge_lambda
        +
        V
        @ correction
    )


    # =========================================================================
    # UNIT COMPASS
    # =========================================================================

    fisher_norm = (
        torch.linalg
        .vector_norm(
            fisher_direction
        )
        .clamp_min(
            FISHER_EPS
        )
    )

    actuator = (
        fisher_direction
        / fisher_norm
    ).to(
        device=DEVICE,
        dtype=torch.float32,
    ).contiguous()

    actuator_norm = (
        torch.linalg
        .vector_norm(
            actuator
        )
    )


    # =========================================================================
    # GEOMETRIC DIAGNOSTIC
    #
    # Compare the 3.1 compass with the old 3.0 mean direction.
    # Diagnostic only; it does NOT control runtime magnitude.
    # =========================================================================

    mean_unit = (
        mean_diff
        / mean_diff_norm
    )

    cosine_vs_mean = (
        torch.dot(
            actuator,
            mean_unit,
        )
        .clamp(
            -1.0,
            1.0,
        )
    )


    # Effective rank diagnostic.
    singular_threshold = (
        S.max()
        * max(
            R.shape
        )
        * torch.finfo(
            S.dtype
        ).eps
    )

    effective_rank = int(
        (
            S
            > singular_threshold
        )
        .sum()
        .item()
    )


    actuators.append(
        actuator
    )

    foundry_telemetry.append(
        {
            "mean_diff_norm":
                float(
                    mean_diff_norm
                    .item()
                ),

            "residual_rows":
                int(
                    R.shape[0]
                ),

            "residual_dim":
                int(
                    R.shape[1]
                ),

            "effective_rank":
                effective_rank,

            "lambda":
                float(
                    ridge_lambda
                    .item()
                ),

            "fisher_raw_norm":
                float(
                    fisher_norm
                    .item()
                ),

            "unit_norm":
                float(
                    actuator_norm
                    .item()
                ),

            "cosine_vs_mean":
                float(
                    cosine_vs_mean
                    .item()
                ),
        }
    )


    print(
        f"  L{L:02d}: "
        f"mean_norm="
        f"{mean_diff_norm.item():.6f} | "
        f"rank="
        f"{effective_rank:02d} | "
        f"lambda="
        f"{ridge_lambda.item():.6e} | "
        f"cos(mean,Fisher)="
        f"{cosine_vs_mean.item():+.6f} | "
        f"unit="
        f"{actuator_norm.item():.6f}"
    )


del positive_samples
del negative_samples

gc.collect()
torch.cuda.empty_cache()


# =============================================================================
