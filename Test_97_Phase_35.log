# =============================================================================
#
# Predeclared engineering criterion:
#
# Is semantic D19 greater than ALL 32 corresponding exact alignment-matched
# random controls?
#
# This is NOT a classical significance test.
#
# It is a finite-null architecture decision rule.
#
# =============================================================================

A_OUTSIDE = bool(
    A_DIR19
    >
    A_NULL_D19.max()
)

B_OUTSIDE = bool(
    B_DIR19
    >
    B_NULL_D19.max()
)


if (
