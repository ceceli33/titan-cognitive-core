        "actuator but should NOT use scalar cosine/alignment as the sole "
        "controller state. The controller needs richer local directional/"
        "subspace/manifold state."
    )


elif (
    not A_OUTSIDE
    and
    not B_OUTSIDE
):

    DECISION = (
        "LOCAL_ALIGNMENT_GEOMETRY_SUFFICIENT_CANDIDATE"
    )

    BLUEPRINT = (
        "The semantic-vs-random transport difference is compatible with "
        "local alignment geometry once cosine is matched online. "
        "AkbasCore 3.0 should prioritize semantic-label-free geometric "
        "state feedback rather than concept-specific controller rules."
    )


else:

