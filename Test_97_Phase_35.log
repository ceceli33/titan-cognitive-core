        "ASYMMETRIC_MIXED_REGIME"
    )

    BLUEPRINT = (
        "A and B do not collapse to one common scalar-alignment regime. "
        "AkbasCore 3.0 should preserve directional asymmetry and use a "
        "richer geometric state representation than scalar cosine alone."
    )


