# =============================================================================
# 16. EXACT ONLINE MATCHED DIRECTION
# =============================================================================
#
# Construct a unit random vector r satisfying:
#
#     cos(h, r) = target_cos
#
# h is the ACTUAL current hidden state at the intervention hook.
#
# Construction is done in FP32 tensor arithmetic on GPU because that is
# closer to the actual BF16 intervention geometry than constructing from a
# stale baseline state.
#
# =============================================================================

def make_matched_direction_tensor(
    hlast,
    target_cos,
    seed
):

    # hlast shape [1, D]

    device = hlast.device

    h32 = hlast.detach().float()

    hnorm = torch.linalg.norm(
        h32,
        dim=-1,
        keepdim=True
    )


    hhat = (
        h32
        /
        (
            hnorm
            +
            1e-12
        )
    )


    gen = torch.Generator(
        device=device
    )

    gen.manual_seed(
        int(seed)
    )


    z = torch.randn(
        h32.shape,
        generator=gen,
        device=device,
        dtype=torch.float32
    )


    z = (
        z
        -
        torch.sum(
            z * hhat,
            dim=-1,
            keepdim=True
        )
        *
        hhat
    )


    znorm = torch.linalg.norm(
        z,
        dim=-1,
        keepdim=True
    )


    # deterministic emergency fallback

    if float(
        znorm.min().detach().cpu()
    ) < 1e-10:

        z = torch.roll(
            hhat,
            shifts=1,
            dims=-1
        )

        z = (
            z
            -
            torch.sum(
                z * hhat,
                dim=-1,
                keepdim=True
            )
            *
            hhat
        )

        znorm = torch.linalg.norm(
            z,
            dim=-1,
            keepdim=True
        )


    zhat = (
        z
        /
        (
            znorm
            +
            1e-12
        )
    )


    c = float(
        np.clip(
            target_cos,
            -1.0,
            1.0
        )
    )


    s = math.sqrt(
        max(
            0.0,
            1.0 - c*c
        )
    )


    r32 = (
        c * hhat
        +
        s * zhat
    )


    r32 = (
        r32
        /
        (
            torch.linalg.norm(
                r32,
                dim=-1,
                keepdim=True
            )
            +
            1e-12
        )
    )


    return r32


# =============================================================================
# 17. ONLINE GEOMETRY-MATCHED FORWARD
# =============================================================================

@torch.no_grad()
def run_geometry_matched(
    prompt,
    target_telemetry,
    seed_base,
    arm_name
):

    states = {
        l: None
        for l in range(
            11,
            MODEL_LAYERS
        )
    }


    telemetry = []

    final_capture = {
        "hidden": None
    }


    handles = []


    def make_hook(l):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            new_hidden = hidden


            if l in ACTIVE_LAYERS:

                hlast = hidden[
                    :,
                    -1,
                    :
                ]


                target_cos = float(
                    target_telemetry[
                        l
                    ][
                        "cos"
                    ]
                )


                # Different deterministic random source at each active layer.

                layer_seed = (
                    int(seed_base)
                    +
                    int(l) * 1000003
                )


                r32 = (
                    make_matched_direction_tensor(
                        hlast,
                        target_cos,
                        layer_seed
                    )
                )


                # Convert to the exact dtype used by the intervention.

                v = r32.to(
                    dtype=hidden.dtype
                )


                # IMPORTANT:
                # recompute ACTUAL cosine after BF16 conversion.

                hn = torch.linalg.norm(
                    hlast,
                    dim=-1,
                    keepdim=True
                )


                vn = torch.linalg.norm(
                    v,
                    dim=-1,
                    keepdim=True
                )


                actual_cos_tensor = (
                    torch.sum(
                        hlast * v,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        hn * vn
                        +
                        1e-12
                    )
                )


                actual_cos = float(
                    actual_cos_tensor
                    .mean()
                    .detach()
                    .cpu()
                )


                env, brake = dra_parameters(
                    actual_cos,
                    l
                )


                contribution = (
                    IVME
                    *
                    hn
                    /
                    SQRT_K
                    *
                    env
                    *
                    brake
                )


                delta = (
                    contribution
                    *
                    v
                )


                new_hidden = hidden.clone()


                new_hidden[
                    :,
                    -1,
                    :
                ] += delta


                semantic_ref = (
                    target_telemetry[l]
                )


                semantic_contribution = float(
                    semantic_ref[
                        "contribution"
                    ]
                )


                matched_contribution = float(
                    contribution
                    .mean()
                    .detach()
                    .cpu()
                )


                telemetry.append({

                    "layer":
                        int(l),

                    "target_cos":
                        target_cos,

                    "actual_cos":
                        actual_cos,

                    "cos_error":
                        float(
                            actual_cos
                            -
                            target_cos
                        ),

                    "target_env":
                        float(
                            semantic_ref[
                                "env"
                            ]
                        ),

                    "actual_env":
                        float(env),

                    "env_error":
                        float(
                            env
                            -
                            semantic_ref[
                                "env"
                            ]
                        ),

                    "target_brake":
                        float(
                            semantic_ref[
                                "brake"
                            ]
                        ),

                    "actual_brake":
                        float(brake),

                    "brake_error":
                        float(
                            brake
                            -
                            semantic_ref[
                                "brake"
                            ]
                        ),

                    "semantic_contribution":
                        semantic_contribution,

                    "matched_contribution":
                        matched_contribution,

                    "contribution_relative_error":
                        float(
                            (
                                matched_contribution
                                -
                                semantic_contribution
                            )
                            /
                            (
                                abs(
                                    semantic_contribution
                                )
                                +
                                EPS
                            )
                        ),
                })


            if l >= 11:

                states[l] = (
                    new_hidden[
                        0,
                        -1,
                        :
                    ]
                    .detach()
                    .float()
                    .cpu()
                    .numpy()
                    .astype(np.float32)
                )


            if isinstance(output, tuple):

                return (
                    new_hidden,
                    *output[1:]
                )


            return new_hidden


        return hook


    for l in range(MODEL_LAYERS):

        handles.append(
            model.model.layers[l]
            .register_forward_hook(
                make_hook(l)
            )
        )


    def final_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = inputs[0].detach()


    final_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_pre_hook
        )
    )


    enc = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(model.device)


    try:

        _ = model(
            **enc,
            use_cache=False
        )


        readout = target_readout(
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


    finally:

        for h in handles:
            h.remove()

        final_handle.remove()


    return {
        "states": states,
        "telemetry": telemetry,
        "readout": readout,
    }


