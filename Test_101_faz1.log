@torch.no_grad()
def run_baseline(
    prompt,
):

    captures = {}

    handles = []


    def source_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        captures[
            "source"
        ] = (
            h[
                0,
                -1,
            ]
            .detach()
            .float()
            .cpu()
            .clone()
        )


    def terminal_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        captures[
            "terminal"
        ] = (
            h[
                0,
                -1,
            ]
            .detach()
            .float()
            .cpu()
            .clone()
        )


    try:

        handles.append(
            model.model.layers[
                SOURCE_LAYER
            ].register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[
                TERMINAL_LAYER
            ].register_forward_hook(
                terminal_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(
            device
        )

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for handle in handles:
            handle.remove()


    return captures


# =============================================================================
# 10. SEED REFERENCE RUN
# =============================================================================

@torch.no_grad()
def run_seed(
    prompt,
    baseline,
):

    source_norm = float(
        torch.linalg.vector_norm(
            baseline[
                "source"
            ]
        )
    )

    requested_norm = (
        FULL_REL
        *
        source_norm
    )

    v = (
        V18
        .to(
            device=device,
            dtype=torch.float32,
        )
    )

    captures = {}

    handles = []


    def inject_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        before = (
            h[
                0,
                -1,
            ]
            .detach()
            .float()
            .clone()
        )

        h_new = h.clone()

        edited = (
            h[
                0,
                -1,
            ].float()
            +
            requested_norm
            *
            v
        )

        h_new[
            0,
            -1,
        ] = edited.to(
            h.dtype
        )

        after = (
            h_new[
                0,
                -1,
            ]
            .detach()
            .float()
            .clone()
        )

        captures[
            "source_before"
        ] = before.cpu()

        captures[
            "source_after"
        ] = after.cpu()

        if isinstance(
            output,
            tuple,
        ):

            return (
                h_new,
                *output[1:]
            )

        return h_new


    def terminal_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        captures[
            "terminal"
        ] = (
            h[
                0,
                -1,
            ]
            .detach()
            .float()
            .cpu()
            .clone()
        )


    try:

        handles.append(
            model.model.layers[
                SOURCE_LAYER
            ].register_forward_hook(
                inject_hook
            )
        )

        handles.append(
            model.model.layers[
                TERMINAL_LAYER
            ].register_forward_hook(
                terminal_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(
            device
        )

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for handle in handles:
            handle.remove()


    realized = (
        captures[
            "source_after"
        ]
        -
        captures[
            "source_before"
        ]
    )

    terminal_delta = (
        captures[
            "terminal"
        ]
        -
        baseline[
            "terminal"
        ]
    )

    realized_rel = float(
        torch.linalg.vector_norm(
            realized
        )
        /
        (
            source_norm
            +
            EPS
        )
    )

    realized_cos = cosine(
        realized,
        V18,
    )

    D19 = cosine(
        terminal_delta,
        V19,
    )

    P19 = float(
        torch.linalg.vector_norm(
            terminal_delta
        )
        /
        (
            torch.linalg.vector_norm(
                baseline[
                    "terminal"
                ]
            )
            +
            EPS
        )
    )

    return {
        "D19":
            D19,

        "P19":
            P19,

        "realized_rel":
            realized_rel,

        "realized_dir_cos":
            realized_cos,
    }


# =============================================================================
# 11. BATCHED ATLAS RUN
# =============================================================================

@torch.no_grad()
def run_atlas_batch(
    prompt,
    baseline,
    candidate_ids,
):

    B = len(
        candidate_ids
    )

    source_norm = float(
        torch.linalg.vector_norm(
            baseline[
                "source"
            ]
        )
    )

    requested_norm = (
        FULL_REL
        *
        source_norm
    )

    directions = (
        ATLAS[
            candidate_ids
        ]
        .to(
            device=device,
            dtype=torch.float32,
        )
    )

    captures = {}

    handles = []


    def inject_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        before = (
            h[
                :,
                -1,
            ]
            .detach()
            .float()
            .clone()
        )

        h_new = h.clone()

        edited = (
            h[
                :,
                -1,
            ].float()
            +
            requested_norm
            *
            directions
        )

        h_new[
            :,
            -1,
        ] = edited.to(
            h.dtype
        )

        after = (
            h_new[
                :,
                -1,
            ]
            .detach()
            .float()
            .clone()
        )

        captures[
            "source_before"
        ] = before.cpu()

        captures[
            "source_after"
        ] = after.cpu()

        if isinstance(
            output,
            tuple,
        ):

            return (
                h_new,
                *output[1:]
            )

        return h_new


    def terminal_hook(
        module,
        inputs,
        output,
    ):

        h = (
            output[0]
            if isinstance(
                output,
                tuple,
            )
            else output
        )

        captures[
            "terminal"
        ] = (
            h[
                :,
                -1,
            ]
            .detach()
            .float()
            .cpu()
            .clone()
        )


    try:

        handles.append(
            model.model.layers[
                SOURCE_LAYER
            ].register_forward_hook(
                inject_hook
            )
        )

        handles.append(
            model.model.layers[
                TERMINAL_LAYER
            ].register_forward_hook(
                terminal_hook
            )
        )

        single = tokenizer(
            prompt,
            return_tensors="pt",
        )

        input_ids = (
            single[
                "input_ids"
            ]
            .repeat(
                B,
                1,
            )
            .to(
                device
            )
        )

        attention_mask = (
            single[
                "attention_mask"
            ]
            .repeat(
                B,
                1,
            )
            .to(
                device
            )
        )

        model(
            input_ids=input_ids,
            attention_mask=attention_mask,
            use_cache=False,
        )

    finally:

        for handle in handles:
            handle.remove()


    realized = (
        captures[
            "source_after"
        ]
        -
        captures[
            "source_before"
        ]
    )

    terminal_delta = (
        captures[
            "terminal"
        ]
        -
        baseline[
            "terminal"
        ].unsqueeze(
            0
        )
    )

    baseline_terminal_norm = float(
        torch.linalg.vector_norm(
            baseline[
                "terminal"
            ]
        )
    )

    out = []

    for bi, cid in enumerate(
        candidate_ids
    ):

        rd = realized[
            bi
        ]

        td = terminal_delta[
            bi
        ]

        realized_rel = float(
            torch.linalg.vector_norm(
                rd
            )
            /
            (
                source_norm
                +
                EPS
            )
        )

        realized_dir_cos = cosine(
            rd,
            ATLAS[
                cid
            ],
        )

        D19 = cosine(
            td,
            V19,
        )

        P19 = float(
            torch.linalg.vector_norm(
                td
            )
            /
            (
                baseline_terminal_norm
                +
                EPS
            )
        )

        out.append(
            {
                "candidate_id":
                    int(
                        cid
                    ),

                "D19":
                    float(
                        D19
                    ),

                "P19":
                    float(
                        P19
                    ),

                "realized_rel":
                    float(
                        realized_rel
                    ),

                "realized_dir_cos":
                    float(
                        realized_dir_cos
                    ),
            }
        )

    return out


# =============================================================================
# 12. RUN
# =============================================================================

print(
    "\n[4/19] TEST126 atlas taraması başlıyor..."
)

print(
    "Approx forward batches per prompt:",
    math.ceil(
        N_ATLAS
        /
        BATCH_SIZE
    )
    +
    2
)

RESULTS = []

t0 = time.time()

for pi, prompt in enumerate(
    PROMPTS
):

    baseline = run_baseline(
        prompt
    )

    seed_result = run_seed(
        prompt,
        baseline,
    )

    candidate_results = [
        None
        for _ in range(
            N_ATLAS
        )
    ]

    for start in range(
        0,
        N_ATLAS,
        BATCH_SIZE,
    ):

        stop = min(
            start
            +
            BATCH_SIZE,
            N_ATLAS,
        )

        ids = list(
            range(
                start,
                stop,
            )
        )

        batch_out = run_atlas_batch(
            prompt,
            baseline,
            ids,
        )

        for item in batch_out:

            candidate_results[
                item[
                    "candidate_id"
                ]
            ] = item


    assert all(
        x is not None
        for x in candidate_results
    )

    RESULTS.append(
        {
            "prompt_index":
                int(
                    pi
                ),

            "seed":
                seed_result,

            "candidates":
                candidate_results,
        }
    )

    elapsed = (
        time.time()
        -
        t0
    )

    print(
        f"{pi+1:02d}/"
        f"{len(PROMPTS)} complete"
        f" | elapsed "
        f"{elapsed/60:.1f} min"
    )

    del baseline

    gc.collect()

    if torch.cuda.is_available():
        torch.cuda.empty_cache()


