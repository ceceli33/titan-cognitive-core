# =============================================================================
# 22. PHASE-I DECISION
#
# Conservative architecture decision:
#
# We do NOT use the 1000-way maximum alone.
#
# "Directional opportunity demonstrated" requires at least one fixed-angle
# shell whose TOP DECILE:
#
#   - has positive mean advantage
#   - positive descriptive lower bound
#   - positive on >= 75% prompts
#
# This says the opportunity is distributed across a subset of directions,
# rather than existing only as one extreme maximum among 1000 searches.
#
# It is still SYSTEM-ID evidence, not blind confirmation.
# =============================================================================

print(
    "\n[14/19] Phase-I decision..."
)

qualifying_shells = []

for angle, _ in SHELL_CONFIG:

    td = (
        SHELL_RESULTS[
            str(
                angle
            )
        ][
            "prompt_top_decile_delta"
        ]
    )

    if (
        td[
            "mean"
        ]
        >
        0
        and
        td[
            "ci95_descriptive"
        ][0]
        >
        0
        and
        td[
            "positive_fraction"
        ]
        >=
        0.75
    ):

        qualifying_shells.append(
            angle
        )


if len(
    qualifying_shells
) > 0:

    DECISION = (
        "DIRECTIONAL_OPPORTUNITY_EXISTS_IN_SYSTEM_ID"
    )

else:

    DECISION = (
        "NO_ROBUST_DIRECTIONAL_OPPORTUNITY_DEMONSTRATED"
    )


print(
    "Qualifying shells:",
    qualifying_shells
)

print(
    "DECISION:",
    DECISION
)


