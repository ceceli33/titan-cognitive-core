SHELL_RESULTS = {}

for angle, count in SHELL_CONFIG:

    ids = [
        m[
            "candidate_id"
        ]
        for m in ATLAS_META
        if (
            m[
                "family"
            ]
            ==
            "ANGLE_SHELL"
            and
            m[
                "nominal_angle_deg"
            ]
            ==
            angle
        )
    ]

    assert len(
        ids
    ) == count

    all_delta = []

    prompt_mean_delta = []
    prompt_best_delta = []
    prompt_top10_delta = []
    prompt_positive_fraction = []
    prompt_shell_sd = []
    prompt_shell_range = []

    for pi, r in enumerate(
        RESULTS
    ):

        vals = np.asarray(
            [
                r[
                    "candidates"
                ][
                    cid
                ][
                    "D19"
                ]
                for cid in ids
            ],
            dtype=np.float64,
        )

        delta = (
            vals
            -
            seed_D19[
                pi
            ]
        )

        all_delta.extend(
            delta.tolist()
        )

        prompt_mean_delta.append(
            float(
                np.mean(
                    delta
                )
            )
        )

        prompt_best_delta.append(
            float(
                np.max(
                    delta
                )
            )
        )

        k_top = max(
            1,
            int(
                math.ceil(
                    0.10
                    *
                    len(
                        delta
                    )
                )
            )
        )

        top10 = np.sort(
            delta
        )[
            -k_top:
        ]

        prompt_top10_delta.append(
            float(
                np.mean(
                    top10
                )
            )
        )

        prompt_positive_fraction.append(
            float(
                np.mean(
                    delta
                    >
                    0
                )
            )
        )

        prompt_shell_sd.append(
            float(
                np.std(
                    vals,
                    ddof=1,
                )
            )
        )

        prompt_shell_range.append(
            float(
                np.max(
                    vals
                )
                -
                np.min(
                    vals
                )
            )
        )


    SHELL_RESULTS[
        str(
            angle
        )
    ] = {
        "angle_deg":
            float(
                angle
            ),

        "candidate_count":
            int(
                count
            ),

        "all_candidate_delta":
            stats(
                all_delta
            ),

        "prompt_mean_delta":
            stats(
                prompt_mean_delta
            ),

        "prompt_best_delta":
            stats(
                prompt_best_delta
            ),

        "prompt_top_decile_delta":
            stats(
                prompt_top10_delta
            ),

        "mean_positive_fraction":
            float(
                np.mean(
                    prompt_positive_fraction
                )
            ),

        "positive_fraction_by_prompt":
            stats(
                prompt_positive_fraction
            ),

        "within_shell_sd":
            stats(
                prompt_shell_sd
            ),

        "within_shell_range":
            stats(
                prompt_shell_range
            ),
    }


    print(
        f"{angle:>5.1f}°"
        f" | mean Δ="
        f"{np.mean(prompt_mean_delta):+.6f}"
        f" | top10% Δ="
        f"{np.mean(prompt_top10_delta):+.6f}"
        f" | oracle Δ="
        f"{np.mean(prompt_best_delta):+.6f}"
        f" | beat seed="
        f"{np.mean(prompt_positive_fraction):.3f}"
        f" | shell SD="
