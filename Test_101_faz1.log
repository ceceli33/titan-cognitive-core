)

for angle, count in SHELL_CONFIG:

    vals = [
        m[
            "actual_angle_deg"
        ]
        for m in ATLAS_META
        if (
            m["family"]
            ==
            "ANGLE_SHELL"
            and
            m[
                "nominal_angle_deg"
            ]
            ==
            angle
        )
    ]

    print(
        f"{angle:>5.1f}°"
        f" | n={count:3d}"
        f" | actual="
        f"{np.mean(vals):.6f}°"
        f" ± "
        f"{np.std(vals):.6e}"
    )


global_angles = [
    m[
        "actual_angle_deg"
    ]
    for m in ATLAS_META
    if m[
        "family"
    ]
    ==
    "GLOBAL_RANDOM"
]

print(
    "GLOBAL"
    f" | n={len(global_angles)}"
    f" | mean angle="
    f"{np.mean(global_angles):.3f}°"
)


# =============================================================================
# 9. BASELINE PASS
