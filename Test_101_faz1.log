# =============================================================================
# 8. CONSTRUCT EXACT ANGULAR ATLAS
# =============================================================================

print(
    "\n[3/19] Dense directional atlas oluşturuluyor..."
)

atlas_rng = torch.Generator(
    device="cpu"
)

atlas_rng.manual_seed(
    SEED + 991
)

ATLAS_META = []
ATLAS_DIRECTIONS = []

candidate_id = 0


def orthogonal_random():

    while True:

        r = torch.randn(
            HIDDEN,
            generator=atlas_rng,
            dtype=torch.float32,
        )

        # Gram-Schmidt against semantic seed.
        r = (
            r
            -
            torch.dot(
                r,
                V18,
            )
            *
            V18
        )

        nr = torch.linalg.vector_norm(
            r
        )

        if float(nr.item()) > 1e-8:

            return (
                r
                /
                nr
            )


for angle_deg, count in SHELL_CONFIG:

    theta = math.radians(
        angle_deg
    )

    ct = math.cos(
        theta
    )

    st = math.sin(
        theta
    )

    for _ in range(
        count
    ):

        u = orthogonal_random()

        q = (
            ct * V18
            +
            st * u
        )

        q = normalize_cpu(
            q
        )

        c = cosine(
            q,
            V18,
        )

        actual_angle = (
            math.degrees(
                math.acos(
                    float(
                        np.clip(
                            c,
                            -1.0,
                            1.0,
                        )
                    )
                )
            )
        )

        ATLAS_DIRECTIONS.append(
            q
        )

        ATLAS_META.append(
            {
                "candidate_id":
                    candidate_id,

                "family":
                    "ANGLE_SHELL",

                "nominal_angle_deg":
                    float(
                        angle_deg
                    ),

                "actual_angle_deg":
                    float(
                        actual_angle
                    ),

                "cos_seed":
                    float(c),
            }
        )

        candidate_id += 1


for _ in range(
    N_GLOBAL_RANDOM
):

    q = torch.randn(
        HIDDEN,
        generator=atlas_rng,
        dtype=torch.float32,
    )

    q = normalize_cpu(
        q
    )

    c = cosine(
        q,
        V18,
    )

    actual_angle = (
        math.degrees(
            math.acos(
                float(
                    np.clip(
                        c,
                        -1.0,
                        1.0,
                    )
                )
            )
        )
    )

    ATLAS_DIRECTIONS.append(
        q
    )

    ATLAS_META.append(
        {
            "candidate_id":
                candidate_id,

            "family":
                "GLOBAL_RANDOM",

            "nominal_angle_deg":
                None,

            "actual_angle_deg":
                float(
                    actual_angle
                ),

            "cos_seed":
                float(c),
        }
    )

    candidate_id += 1


ATLAS = torch.stack(
    ATLAS_DIRECTIONS,
    dim=0,
).float()

assert (
    ATLAS.shape
    ==
    (
        N_ATLAS,
        HIDDEN,
    )
)

print(
    "Atlas shape:",
    tuple(
        ATLAS.shape
