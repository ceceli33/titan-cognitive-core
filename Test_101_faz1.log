def normalize_cpu(x):

    x = (
        x.detach()
        .float()
        .cpu()
    )

    n = torch.linalg.vector_norm(x)

    if float(n.item()) < EPS:
        raise RuntimeError(
            "Attempted to normalize a zero vector."
        )

    return x / n


def cosine(a, b):

    a = a.detach().float().cpu()
    b = b.detach().float().cpu()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if (
        float(na.item()) < EPS
        or
        float(nb.item()) < EPS
    ):
        return 0.0

    return float(
        torch.dot(a, b)
        /
        (na * nb)
    )


def stats(x):

    x = np.asarray(
        x,
        dtype=np.float64,
    )

    x = x[
        np.isfinite(x)
    ]

    if len(x) == 0:
        return None

    n = len(x)

    mean = float(
        np.mean(x)
    )

    sd = (
        float(
            np.std(
                x,
                ddof=1,
            )
        )
        if n > 1
        else 0.0
    )

    se = (
        sd / math.sqrt(n)
        if n > 1
        else 0.0
    )

    return {
        "n":
            int(n),

        "mean":
            mean,

        "sd":
            sd,

        "min":
            float(
                np.min(x)
            ),

        "median":
            float(
                np.median(x)
            ),

        "max":
            float(
                np.max(x)
            ),

        "ci95_descriptive": [
            float(
                mean
                -
                1.96 * se
            ),
            float(
                mean
                +
                1.96 * se
            ),
        ],

        "positive_fraction":
            float(
                np.mean(
                    x > 0
                )
            ),
    }


