def empirical_null(
    observed,
    null_values
):

    null_values = np.asarray(
        null_values,
        dtype=np.float64
    )


    n = len(null_values)


    ge = int(
        np.sum(
            null_values
            >= observed
        )
    )


    abs_ge = int(
        np.sum(
            np.abs(null_values)
            >= abs(observed)
        )
    )


    less = int(
        np.sum(
            null_values
            < observed
        )
    )


    return {

        "observed":
            float(observed),

        "null_n":
            int(n),

        "null_mean":
            float(
                null_values.mean()
            ),

        "null_median":
            float(
                np.median(
                    null_values
                )
            ),

        "null_std":
            safe_std(
                null_values
            ),

        "null_min":
            float(
                null_values.min()
            ),

        "null_max":
            float(
                null_values.max()
            ),

        "null_ge_observed":
            ge,

        "null_abs_ge_observed":
            abs_ge,

        "percentile":
            float(
                100.0
                * less
                / n
            ),

        "upper_tail_plus1":
            float(
                (ge + 1)
                /
                (n + 1)
            ),

        "two_sided_abs_plus1":
            float(
                (abs_ge + 1)
                /
                (n + 1)
            ),
    }


