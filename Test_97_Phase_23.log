# =============================================================================
# 12. DRA — LOCKED
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        - abs(cosine_value)
    )


    dw = (
        SONUM
        + uncertainty * 0.20
    )


    t = float(layer_idx)


    kb = (
        ZIRVE
        * math.exp(
            -dw * t
        )
        * (
            1.0
            + dw * t
        )
        + TABAN
    )


    envelope = (
        kb
        /
        (
            ZIRVE
            + TABAN
        )
    )


    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            (1.0 - cosine_value)
            /
            BRAKE_HIGH_DENOM
        )

    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN

    else:

        brake = 1.0


    return (
        envelope,
        brake
    )


# =============================================================================
# 13. FP32 FINAL RMSNORM
# =============================================================================

def qwen_rmsnorm_fp32(
    hidden_fp32
):

    norm_module = model.model.norm


    weight = (
        norm_module.weight
        .detach()
        .float()
    )


    eps = float(
        norm_module.variance_epsilon
    )


    variance = (
        hidden_fp32
        .pow(2)
        .mean(
            dim=-1,
            keepdim=True
        )
    )


    normalized = (
        hidden_fp32
        * torch.rsqrt(
            variance
            + eps
        )
    )


    return (
        normalized
        * weight
    )


# =============================================================================
# 14. FP32 TARGET-ONLY LM HEAD
# =============================================================================

@torch.no_grad()
def hp_target_logits(
    final_hidden_last
):

    h = (
        final_hidden_last
        .float()
    )


    h_norm = qwen_rmsnorm_fp32(
        h
    )


    target_weights = (
        model.lm_head.weight[
            TARGET_ID_LIST
        ]
        .detach()
        .float()
    )


    logits = torch.matmul(
        target_weights,
        h_norm
    )


    return {
        "above":
            float(logits[0].cpu()),

        "below":
            float(logits[1].cpu()),

        "over":
            float(logits[2].cpu()),

        "under":
            float(logits[3].cpu()),
    }


# =============================================================================
# 15. MEASUREMENT
# =============================================================================

def measure_target_logits(
    logits
):

    return {

        "dlm_above_below":
            float(
                logits["above"]
                - logits["below"]
            ),

        "dlm_over_under":
            float(
                logits["over"]
                - logits["under"]
            ),

        "logit_above":
            float(logits["above"]),

        "logit_below":
            float(logits["below"]),

        "logit_over":
            float(logits["over"]),

        "logit_under":
            float(logits["under"]),
    }


# =============================================================================
# 16. FORWARD ENGINE
# =============================================================================

@torch.no_grad()
def run_forward(
    prompt,
    vectors=None
):

    telemetry = {
        "cos": [],
        "abs_cos": [],
        "contribution": [],
        "envelope": [],
        "brake": [],
    }


    steering_handles = []


    final_capture = {
        "hidden": None
    }


    # -------------------------------------------------------------------------
    # Capture pre-final-norm hidden
    # -------------------------------------------------------------------------

    def final_norm_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = (
            inputs[0]
            .detach()
        )


    capture_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_norm_pre_hook
        )
    )


    # -------------------------------------------------------------------------
    # Steering
    # -------------------------------------------------------------------------

    if vectors is not None:

        def make_hook(
            layer_idx
        ):

            def hook(
                module,
                inputs,
                output
            ):

                hidden = (
                    output[0]
                    if isinstance(
                        output,
                        tuple
                    )
                    else output
                )


                vector = (
                    torch.as_tensor(
                        vectors[
                            layer_idx
                        ],
                        device=hidden.device,
                        dtype=hidden.dtype,
                    )
                    .unsqueeze(0)
                )


                h = hidden[
                    :,
                    -1,
                    :
                ]


                h_norm = (
                    torch.linalg.norm(
                        h,
                        dim=-1,
                        keepdim=True
                    )
                )


                v_norm = (
                    torch.linalg.norm(
                        vector,
                        dim=-1,
                        keepdim=True
                    )
                )


                cosine = (
                    torch.sum(
                        h * vector,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        h_norm
                        * v_norm
                        + 1e-12
                    )
                )


                cosine_value = float(
                    cosine
                    .mean()
                    .detach()
                    .cpu()
                )


                envelope, brake = (
                    dra_parameters(
                        cosine_value,
                        layer_idx
                    )
                )


                contribution = (
                    IVME
                    * h_norm
                    / SQRT_K
                    * envelope
                    * brake
                )


                delta = (
                    contribution
                    * vector
                )


                hidden_new = (
                    hidden.clone()
                )


                hidden_new[
                    :,
                    -1,
                    :
                ] = (
                    hidden_new[
                        :,
                        -1,
                        :
                    ]
                    + delta
                )


                telemetry[
                    "cos"
                ].append(
                    cosine_value
                )


                telemetry[
                    "abs_cos"
                ].append(
                    abs(cosine_value)
                )


                telemetry[
                    "contribution"
                ].append(
                    float(
                        contribution
                        .mean()
                        .detach()
                        .cpu()
                    )
                )


                telemetry[
                    "envelope"
                ].append(
                    float(envelope)
                )


                telemetry[
                    "brake"
                ].append(
                    float(brake)
                )


                if isinstance(
                    output,
                    tuple
                ):

                    return (
                        hidden_new,
                        *output[1:]
                    )


                return hidden_new


            return hook


        for layer_idx in (
            ACTIVE_LAYERS
        ):

            steering_handles.append(
                model.model.layers[
                    layer_idx
                ].register_forward_hook(
                    make_hook(
                        layer_idx
                    )
                )
            )


    try:

        encoded = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(model.device)


        _ = model(
            **encoded,
            use_cache=False,
        )


        if final_capture[
            "hidden"
        ] is None:

            raise RuntimeError(
                "Pre-final-norm hidden capture failed."
            )


        last_hidden = (
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


        logits = hp_target_logits(
            last_hidden
        )


        measurement = (
            measure_target_logits(
                logits
            )
        )


    finally:

        for handle in (
            steering_handles
        ):
            handle.remove()


        capture_handle.remove()


    telemetry_summary = {}


    for key in [
        "cos",
        "abs_cos",
        "contribution",
        "envelope",
        "brake",
    ]:

        values = telemetry[key]

        telemetry_summary[
            f"mean_{key}"
        ] = (
            float(
                np.mean(values)
            )
            if values
            else 0.0
        )


    return (
        measurement,
        telemetry_summary
    )


