def summarize_telemetry(
    groups
):

    flattened = []


    for item in groups:

        if isinstance(
            item,
            list
        ):

            flattened.extend(
                item
            )

        else:

            flattened.append(
                item
            )


    output = {}


    for key in [
        "mean_cos",
        "mean_abs_cos",
        "mean_contribution",
        "mean_envelope",
        "mean_brake",
    ]:

        values = np.asarray(
            [
                row[key]
                for row in flattened
            ],
            dtype=np.float64
        )


        output[key] = {

            "mean":
                float(
                    values.mean()
                ),

            "std":
                safe_std(
                    values
                ),

            "min":
                float(
                    values.min()
                ),

            "max":
                float(
                    values.max()
                ),
        }


    return output


