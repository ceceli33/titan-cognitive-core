def bootstrap_mean_ci(
    values,
    n_boot,
    seed
):

    values = np.asarray(
        values,
        dtype=np.float64
    )


    rng = np.random.default_rng(
        seed
    )


    n = len(values)


    boot = np.empty(
        n_boot,
        dtype=np.float64
    )


    for i in range(
        n_boot
    ):

        indices = rng.integers(
            0,
            n,
            size=n
        )


        boot[i] = (
            values[
                indices
            ].mean()
        )


    return {

        "mean":
            float(
                values.mean()
            ),

        "median":
            float(
                np.median(values)
            ),

        "ci95_lower":
            float(
                np.percentile(
                    boot,
                    2.5
                )
            ),

        "ci95_upper":
            float(
                np.percentile(
                    boot,
                    97.5
                )
            ),

        "n_boot":
            int(n_boot),
    }


BOOT_AB = bootstrap_mean_ci(
