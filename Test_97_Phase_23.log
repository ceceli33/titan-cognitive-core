# =============================================================================
# 5. HOLDOUT LEXICAL LEAKAGE CHECK
# =============================================================================

FORBIDDEN_TERMS = [
    "above",
    "below",
    "over",
    "under",
    "overhead",
    "underneath",
    "beneath",
]


def lexical_leak_check(prompts):

    violations = []

    for idx, prompt in enumerate(prompts):

        lower = prompt.lower()

        found = []

        for term in FORBIDDEN_TERMS:

            # whole-word-ish check
            tokens = (
                lower
                .replace(".", " ")
                .replace(",", " ")
                .replace("?", " ")
                .replace("!", " ")
                .replace(":", " ")
                .replace(";", " ")
                .split()
            )

            if term in tokens:
                found.append(term)

        if found:

            violations.append({
                "prompt_index": idx + 1,
                "terms": found,
                "prompt": prompt,
            })

    return violations


LEAKS = lexical_leak_check(
    HOLDOUT_PROMPTS
)


if LEAKS:

    print("\nLEXICAL LEAK DETECTED:")

    for row in LEAKS:
        print(row)

    raise RuntimeError(
        "Holdout prompt set contains forbidden target lexical terms."
    )


# =============================================================================
# 6. HELPERS
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(
        v,
        dtype=np.float32
    )

    norm = np.linalg.norm(v)

    if norm < eps:
        return v.copy()

    return v / norm


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(
        a,
        dtype=np.float32
    )

    b = np.asarray(
        b,
        dtype=np.float32
    )

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def safe_std(values):

    values = np.asarray(
        values,
        dtype=np.float64
    )

    if len(values) < 2:
        return 0.0

    return float(
        np.std(
            values,
            ddof=1
        )
    )


def sign_counts(values):

    values = np.asarray(
        values,
        dtype=np.float64
    )

    return {
        "positive":
            int(np.sum(values > 0)),

        "negative":
            int(np.sum(values < 0)),

        "zero":
            int(np.sum(values == 0)),
    }


