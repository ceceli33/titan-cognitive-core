# =============================================================================
# 4. HELPERS
# =============================================================================

def normalize(v):

    v = v.float()

    n = torch.linalg.vector_norm(v)

    if float(n.item()) < EPS:
        return None

    return v / n


def cos_tensor(a, b):

    a = a.float()
    b = b.float()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if (
        float(na.item()) < EPS
        or
        float(nb.item()) < EPS
    ):
        return 0.0

    return float(
        torch.dot(a, b)
        /
        (na * nb)
    )


def descriptive_stats(x):

    x = np.asarray(
        x,
        dtype=np.float64,
    )

    n = len(x)

    mean = float(
        np.mean(x)
    )

    sd = (
        float(
            np.std(
                x,
                ddof=1,
            )
        )
        if n > 1
        else 0.0
    )

    se = (
        sd / math.sqrt(n)
        if n > 1
        else 0.0
    )

    return {
        "mean": mean,
        "sd": sd,
        "ci95_descriptive": [
            float(mean - 1.96 * se),
            float(mean + 1.96 * se),
        ],
        "positive_fraction": float(
            np.mean(x > 0)
        ),
        "negative_fraction": float(
            np.mean(x < 0)
        ),
        "min": float(np.min(x)),
        "max": float(np.max(x)),
    }


def pearson(x, y):

    x = np.asarray(
        x,
        dtype=np.float64,
    )

    y = np.asarray(
        y,
        dtype=np.float64,
    )

    if (
        len(x) < 2
        or
        np.std(x) < 1e-15
        or
        np.std(y) < 1e-15
    ):
        return float("nan")

    return float(
        np.corrcoef(
            x,
            y,
        )[0, 1]
    )


