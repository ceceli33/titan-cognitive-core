# =============================================================================
# 23. GENERIC COLLECTOR
# =============================================================================

def collect_horizon_rows(
    rel,
    probe_offset,
    long_only=True,
):

    out = []


    for layer in RESULTS:

        li = layer[
            "source_layer"
        ]


        if (
            long_only
            and
            li == 18
        ):
            continue


        if (
            probe_offset
            not in layer[
                "probe_offsets"
            ]
        ):
            continue


        for row in layer[
            "rows"
        ]:

            out.append(
                row[
                    "doses"
                ][str(rel)][
                    "horizon_eval"
                ][probe_offset]
            )


    return out


