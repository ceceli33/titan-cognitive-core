# 5. MATH HELPERS
# =============================================================================

def unit(v):

    v = v.float()

    n = torch.linalg.vector_norm(v)

    if float(n.item()) <= EPS:
        raise RuntimeError("Sıfır vektör normalize edilmeye çalışıldı.")

    return v / n


def cos(a, b):

    a = a.float()
    b = b.float()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if float(na.item()) <= EPS or float(nb.item()) <= EPS:
        return float("nan")

    return float(
        (
            torch.dot(a, b)
            /
            (na * nb)
        ).item()
    )


def angle(a, b):

    c = cos(a, b)

    if not np.isfinite(c):
        return float("nan")

    return float(
        np.degrees(
            np.arccos(
                np.clip(c, -1.0, 1.0)
            )
        )
    )


def pearson(a, b):

    a = np.asarray(a, dtype=np.float64)
    b = np.asarray(b, dtype=np.float64)

    m = np.isfinite(a) & np.isfinite(b)

    a = a[m]
    b = b[m]

    if len(a) < 3:
        return float("nan")

    if np.std(a) <= EPS or np.std(b) <= EPS:
        return float("nan")

    return float(
        np.corrcoef(a, b)[0, 1]
    )


def rankdata(x):

    x = np.asarray(x, dtype=np.float64)

    order = np.argsort(x, kind="mergesort")

    ranks = np.empty(len(x), dtype=np.float64)

    ranks[order] = np.arange(len(x), dtype=np.float64)

    return ranks


def spearman(a, b):

    a = np.asarray(a, dtype=np.float64)
    b = np.asarray(b, dtype=np.float64)

    m = np.isfinite(a) & np.isfinite(b)

    if int(m.sum()) < 3:
        return float("nan")

    return pearson(
        rankdata(a[m]),
        rankdata(b[m]),
    )


def mean_or_nan(x):

    x = np.asarray(x, dtype=np.float64)

    x = x[np.isfinite(x)]

    if len(x) == 0:
        return float("nan")

    return float(np.mean(x))


def cluster_bootstrap(values, seed, n_boot=N_BOOT):

    x = np.asarray(values, dtype=np.float64)

    x = x[np.isfinite(x)]

    if len(x) == 0:

        return {
            "mean": float("nan"),
            "ci95": [float("nan"), float("nan")],
            "positive_fraction": float("nan"),
            "n": 0,
        }

    rng = np.random.default_rng(seed)

    boot = np.empty(n_boot, dtype=np.float64)

    for bi in range(n_boot):

        idx = rng.integers(
            0,
            len(x),
            len(x),
        )

        boot[bi] = np.mean(x[idx])

    return {
        "mean": float(np.mean(x)),
        "ci95": [
            float(np.quantile(boot, 0.025)),
            float(np.quantile(boot, 0.975)),
        ],
        "positive_fraction": float(np.mean(x > 0)),
        "n": int(len(x)),
    }


def fmt_ci(s):

    return (
        f"[{s['ci95'][0]:+.6f},"
        f"{s['ci95'][1]:+.6f}]"
    )


def pair_angle_mean(vectors):

    vals = []

    for i in range(len(vectors)):

        for j in range(i + 1, len(vectors)):

            vals.append(
                angle(
                    vectors[i],
                    vectors[j],
                )
            )

    return mean_or_nan(vals)


