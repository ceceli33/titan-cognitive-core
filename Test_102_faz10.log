# =============================================================================
# 8. HIDDEN EXTRACTION
# =============================================================================

@torch.inference_mode()
def extract_hidden(texts):

    enc = tokenizer(
        texts,
        padding=True,
        truncation=True,
        max_length=128,
        return_tensors="pt",
    )

    ids = enc["input_ids"].to(device)
    mask = enc["attention_mask"].to(device)

    lengths = mask.sum(dim=1).long()

    captured = [None] * VECTOR_LAYERS

    handles = []


    def make_hook(li):

        def hook(module, inputs, output):

            h = (
                output[0]
                if isinstance(output, tuple)
                else output
            )

            captured[li] = h.detach()

        return hook


    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False,
        )

    finally:

        for hd in handles:
            hd.remove()


    B = ids.shape[0]

    out = torch.empty(
        B,
        VECTOR_LAYERS,
        HIDDEN,
        dtype=torch.float32,
    )

    rows = torch.arange(B, device=device)

    for li in range(VECTOR_LAYERS):

        h = captured[li].float()

        out[:, li, :] = (
            h[
                rows,
                (lengths - 1).to(h.device),
            ]
            .detach()
            .cpu()
        )

    del captured

    return out


def build_dictionary(positive, negative):

    xp = extract_hidden(positive)
    xn = extract_hidden(negative)

    d = {}

    for li in range(VECTOR_LAYERS):

        d[li] = unit(
            xp[:, li].mean(0)
            -
            xn[:, li].mean(0)
        )

    del xp
    del xn

    gc.collect()

    return d


