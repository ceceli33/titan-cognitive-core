# =============================================================================
# 12. SEMANTIC EQUAL-ANGLE ATLAS
# =============================================================================

print("\n[5/26] Semantic equal-angle atlas...")


theta = math.radians(
    SHELL_DEG
)


SEM_ATLAS = {}
SEM_NATURAL_ANGLES = {}


for li in SOURCE_LAYERS:

    v = unit(
        DIBEK[li]
    )

    rows = []
    nat = []


    for cid in range(N_SEMANTIC):

        w = unit(
            SEM_DICTS[cid][li]
        )

        raw_cos = cos(
            w,
            v,
        )


        if raw_cos > IDENTITY_TOL:

            raise RuntimeError(
                f"L{li} candidate {cid} "
                f"({SEM_LABELS[cid]}) "
                f"historical v ile özdeş: "
                f"cos={raw_cos:+.9f}"
            )


        tangent = (
            w
            -
            torch.dot(w, v) * v
        )


        tangent_norm = float(
            torch.linalg.vector_norm(
                tangent
            ).item()
        )


        if tangent_norm <= 1e-8:

            raise RuntimeError(
                f"Semantic tangent collapsed "
                f"at L{li}, candidate {cid} "
                f"({SEM_LABELS[cid]})."
            )


        tangent = unit(
            tangent
        )


        q = unit(
            math.cos(theta) * v
            +
            math.sin(theta) * tangent
        )


        natural_angle = angle(
            w,
            v,
        )


        rows.append({
            "id": cid,
            "label": SEM_LABELS[cid],
            "q": q,
            "raw_cos": raw_cos,
            "natural_angle": natural_angle,
            "requested_angle": angle(q, v),
        })


        nat.append(
            natural_angle
        )


    SEM_ATLAS[li] = rows
    SEM_NATURAL_ANGLES[li] = nat


    print(
        f"  L{li:02d}: "
        f"requested="
        f"{np.mean([r['requested_angle'] for r in rows]):.4f}° | "
        f"natural=[{min(nat):.2f}°, "
        f"{max(nat):.2f}°] "
        f"mean={np.mean(nat):.2f}°"
    )


# =============================================================================
# 13. MATCHED RANDOM SHELL
# =============================================================================

print(
    "\n[6/26] Matched random tangent atlas..."
)


RND_ATLAS = {}


for li in SOURCE_LAYERS:

    v = unit(
        DIBEK[li]
    )

    rows = []


    for cid in range(N_RANDOM):

        g = torch.Generator(
            device="cpu"
        )

        g.manual_seed(
            SEED
            +
            1_000_000
            +
            li * 1000
            +
            cid
        )


        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )


        z = (
            z
            -
            torch.dot(z, v) * v
        )


        z = unit(z)


        q = unit(
            math.cos(theta) * v
            +
            math.sin(theta) * z
        )


        rows.append({
            "id": cid,
            "q": q,
        })


    RND_ATLAS[li] = rows


print(
    f"  {len(SOURCE_LAYERS)} layers × "
    f"{N_RANDOM} random candidates"
)


# =============================================================================
# 14. JITTER NULL
# =============================================================================

def make_null_dirs(li, pi):

    v = unit(
        DIBEK[li]
    )

    out = []


    for nid in range(N_NULL):

        g = torch.Generator(
            device="cpu"
        )

        g.manual_seed(
            SEED
            +
            7_000_000
            +
            100_000 * pi
            +
            1000 * li
            +
            nid
        )


        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )


        z = (
            z
            -
            torch.dot(z, v) * v
        )


        z = unit(z)


        out.append(
            unit(
                v
                +
                NULL_JITTER_REL * z
            )
        )


    return out


# =============================================================================
# 15. HORIZON HELPERS
# =============================================================================

def valid_probe_offsets(source_li):

    return [
        k
        for k in PROBE_OFFSETS
        if source_li + k <= 19
    ]


def probe_layers(source_li):

    return [
        source_li + k
        for k in valid_probe_offsets(source_li)
    ]


# BF16 ACT için terminal + useful diagnostics
def act_horizons(source_li):

    hs = {
        source_li + 1,
        19,
    }

    for k in PROBE_OFFSETS:

        if source_li + k <= 19:
            hs.add(
                source_li + k
            )

    return sorted(hs)


# =============================================================================
# 16. BASELINE + INPUT CALL TO BLOCK L+1
# =============================================================================

@torch.inference_mode()
def baseline_and_first_call(
    prompt,
    source_li,
):

    first_li = source_li + 1

    needed = sorted(
        set(
            [source_li]
            +
            act_horizons(source_li)
        )
    )


    outputs = {}
    first_call = {}

    handles = []


    def make_output_hook(layer_id):

        def hook(module, args, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            outputs[layer_id] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook


    def first_pre_hook(
        module,
        args,
        kwargs,
    ):

        first_call["args"] = tuple(
            x.detach().clone()
            if torch.is_tensor(x)
            else x
            for x in args
        )


        kw = {}

        for k, val in kwargs.items():

            if torch.is_tensor(val):

                kw[k] = (
                    val.detach()
                    .clone()
                )

            elif isinstance(val, tuple):

                kw[k] = tuple(
                    i.detach().clone()
                    if torch.is_tensor(i)
                    else i
                    for i in val
                )

            elif isinstance(val, list):

                kw[k] = [
                    i.detach().clone()
                    if torch.is_tensor(i)
                    else i
                    for i in val
                ]

            else:

                kw[k] = val


        first_call["kwargs"] = kw


    try:

        for lid in needed:

            handles.append(
                model.model.layers[lid]
                .register_forward_hook(
                    make_output_hook(lid)
                )
            )


        handles.append(
            model.model.layers[first_li]
            .register_forward_pre_hook(
                first_pre_hook,
                with_kwargs=True,
            )
        )


        enc = {
            k: v.to(device)
            for k, v in tokenizer(
                prompt,
                return_tensors="pt",
            ).items()
        }


        model(
            **enc,
            use_cache=False,
        )


    finally:

        for hd in handles:
            hd.remove()


    if "args" not in first_call:

        raise RuntimeError(
            f"L{first_li} input call "
            f"yakalanamadı."
        )


    return (
        outputs,
        first_call,
    )


# =============================================================================
# 17. FP32 NESTED CONVERSION
# =============================================================================

def fp32_nested(x):

    if torch.is_tensor(x):

        if x.is_floating_point():
            return x.float()

        return x


    if isinstance(x, tuple):

        return tuple(
            fp32_nested(v)
            for v in x
        )


    if isinstance(x, list):

        return [
            fp32_nested(v)
            for v in x
        ]


    if isinstance(x, dict):

        return {
            k: fp32_nested(v)
            for k, v in x.items()
        }


    return x


def locate_hidden(args, kwargs):

    if (
        len(args) > 0
        and
        torch.is_tensor(args[0])
        and
        args[0].ndim == 3
    ):

        return (
            "args",
            0,
            args[0],
        )


    if (
        "hidden_states" in kwargs
        and
        torch.is_tensor(
            kwargs["hidden_states"]
        )
    ):

        return (
            "kwargs",
            "hidden_states",
            kwargs["hidden_states"],
        )


    raise RuntimeError(
        "hidden_states bulunamadı."
    )


def set_hidden(
    args,
    kwargs,
    hidden,
):

    args = list(args)
    kwargs = dict(kwargs)


    where, key, _ = locate_hidden(
        args,
        kwargs,
    )


    if where == "args":

        args[key] = hidden

    else:

        kwargs[key] = hidden


    return (
        tuple(args),
        kwargs,
    )


# =============================================================================
# 18. FP32 BLOCK CHAIN
#
# ÖNEMLİ:
# İlk block call'dan yakalanan positional kwargs aynı token pozisyonları için
# sonraki decoder layer'larda da geçerlidir. Hidden state her bloktan sonra
# güncellenir; position/cache metadata değiştirilmez.
#
# use_cache=False zorlanır.
# =============================================================================

@torch.inference_mode()
def fp32_single_block(
    block,
    base_args,
    base_kwargs,
    hidden,
):

    args = fp32_nested(
        base_args
    )

    kwargs = fp32_nested(
        base_kwargs
    )


    args, kwargs = set_hidden(
        args,
        kwargs,
        hidden,
    )


    if "use_cache" in kwargs:
        kwargs["use_cache"] = False


    out = block(
        *args,
        **kwargs,
    )


    if isinstance(out, tuple):

        h = out[0]

    elif hasattr(
        out,
        "last_hidden_state",
    ):

        h = out.last_hidden_state

    else:

        h = out


    return h.float()


# =============================================================================
# 19. FP32 MULTI-HORIZON CENTRAL FINITE-SECANT
# =============================================================================

@torch.inference_mode()
def fp32_multi_horizon_radar(
    blocks,
    source_li,
    first_call,
    direction,
):

    base_args = first_call["args"]
    base_kwargs = first_call["kwargs"]


    _, _, h_orig = locate_hidden(
        base_args,
        base_kwargs,
    )


    h0 = (
        h_orig
        .detach()
        .float()
        .clone()
    )


    q = unit(
        direction
    ).to(
        device=h0.device,
        dtype=torch.float32,
    )


    source_norm = float(
        torch.linalg.vector_norm(
            h0[0, -1]
        ).item()
    )


    eps_norm = (
        RADAR_REL
        *
        source_norm
    )


    hp = h0.clone()
    hm = h0.clone()


    hp[0, -1] += (
        eps_norm * q
    )

    hm[0, -1] -= (
        eps_norm * q
    )


    responses = {}


    max_offset = max(
        valid_probe_offsets(
            source_li
        )
    )


    # propagate +eps and -eps through SAME FP32 blocks
    for offset in range(
        1,
        max_offset + 1,
    ):

        block_li = (
            source_li + offset
        )


        block = blocks[
            block_li
        ]


        hp = fp32_single_block(
            block,
            base_args,
            base_kwargs,
            hp,
        )


        hm = fp32_single_block(
            block,
            base_args,
            base_kwargs,
            hm,
        )


        if offset in PROBE_OFFSETS:

            if block_li <= 19:

                response = (
                    (
                        hp[0, -1]
                        -
                        hm[0, -1]
                    )
                    /
                    2.0
                )


                response = (
                    response
                    .detach()
                    .float()
                    .cpu()
                )


                responses[offset] = {
                    "layer": block_li,
                    "response": response,
                    "gain": (
                        float(
                            torch.linalg.vector_norm(
                                response
                            ).item()
                        )
                        /
                        (eps_norm + EPS)
                    ),
                    "D": cos(
                        response,
                        DIBEK[block_li],
                    ),
                }


    return {
        "eps_norm": eps_norm,
        "responses": responses,
    }


# =============================================================================
# 20. BF16 FULL-MODEL ACTUATOR
# =============================================================================

@torch.inference_mode()
def full_act(
    prompt,
    source_li,
    direction,
    baseline,
    rel,
):

    horizons = act_horizons(
        source_li
    )


    q_cpu = unit(
        direction
    )


    q = q_cpu.to(
        device=device,
        dtype=torch.float32,
    )


    src_norm = float(
        torch.linalg.vector_norm(
            baseline[source_li]
        ).item()
    )


    req_norm = (
        rel
        *
        src_norm
    )


    captures = {}
    realized = {}
    handles = []


    def source_hook(
        module,
        args,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )


        hnew = h.clone()


        before = (
            h[0, -1]
            .float()
        )


        hnew[0, -1] = (
            before
            +
            req_norm * q
        ).to(
            dtype=h.dtype
        )


        realized["dx"] = (
            hnew[0, -1]
            .float()
            -
            before
        ).detach().cpu()


        if isinstance(out, tuple):

            return (
                (hnew,)
                +
                out[1:]
            )

        return hnew


    def make_target_hook(lid):

        def hook(
            module,
            args,
            out,
        ):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )


            captures[lid] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
            )

        return hook


    try:

        handles.append(
            model.model.layers[source_li]
            .register_forward_hook(
                source_hook
            )
        )


        for lid in horizons:

            handles.append(
                model.model.layers[lid]
                .register_forward_hook(
                    make_target_hook(lid)
                )
            )


        enc = {
            k: v.to(device)
            for k, v in tokenizer(
                prompt,
                return_tensors="pt",
            ).items()
        }


        model(
            **enc,
            use_cache=False,
        )


    finally:

        for hd in handles:
            hd.remove()


    if "dx" not in realized:

        raise RuntimeError(
            "BF16 actuator realization "
            "yakalanamadı."
        )


    dx = realized["dx"]


    result = {
        "dx": dx,
        "realized_rel": (
            float(
                torch.linalg.vector_norm(
                    dx
                ).item()
            )
            /
            (src_norm + EPS)
        ),
        "dir_cos": cos(
            dx,
            q_cpu,
        ),
        "angle_err": angle(
            dx,
            q_cpu,
        ),
        "D": {},
    }


    for lid in horizons:

        delta = (
            captures[lid]
            -
            baseline[lid]
        )


        result["D"][lid] = cos(
            delta,
            DIBEK[lid],
        )


    return result


# =============================================================================
# 21. ANA TEST137 LOOP
# =============================================================================

print(
    "\n[7/26] FP32 multi-horizon radar -> "
    "BF16 terminal assay..."
)


RESULTS = []

t_main = time.time()


for source_li in SOURCE_LAYERS:

    offsets = valid_probe_offsets(
        source_li
    )

    max_offset = max(offsets)


    print()
    print(
        f"  SOURCE L{source_li}"
    )

    print(
        f"  FP32 horizons: "
        f"{offsets}"
    )


    # -------------------------------------------------------------------------
    # Yalnız gerekli ardışık FP32 block zincirini tut.
    # Örn source L3, max +5:
    #   blocks L4,L5,L6,L7,L8
    #
    # source tamamlanınca silinir.
    # -------------------------------------------------------------------------

    blocks_fp32 = {}


    for offset in range(
        1,
        max_offset + 1,
    ):

        lid = (
            source_li + offset
        )


        print(
            f"    copy FP32 block "
            f"L{lid}..."
        )


        blk = copy.deepcopy(
            model.model.layers[lid]
        ).to(
            device=device,
            dtype=torch.float32,
        ).eval()


        for p in blk.parameters():
            p.requires_grad_(False)


        blocks_fp32[lid] = blk


    requested_sem_pair = (
        pair_angle_mean(
            [
                c["q"]
                for c in SEM_ATLAS[
                    source_li
                ]
            ]
        )
    )


    layer_rows = []


    for pi, prompt in enumerate(
        PROMPTS
    ):

        # =====================================================================
        # A. BASELINE
        # =====================================================================

        baseline, first_call = (
            baseline_and_first_call(
                prompt,
                source_li,
            )
        )


        # =====================================================================
        # B. FP32 MULTI-HORIZON RADAR
        # =====================================================================

        fixed_r = (
            fp32_multi_horizon_radar(
                blocks_fp32,
                source_li,
                first_call,
                DIBEK[source_li],
            )
        )


        sem_radar = {
            k: []
            for k in offsets
        }

        sem_gain = {
            k: []
            for k in offsets
        }


        rnd_radar = {
            k: []
            for k in offsets
        }


        # semantic candidates
        for c in SEM_ATLAS[
            source_li
        ]:

            r = (
                fp32_multi_horizon_radar(
                    blocks_fp32,
                    source_li,
                    first_call,
                    c["q"],
                )
            )


            for k in offsets:

                sem_radar[k].append(
                    r["responses"][k]["D"]
                )

                sem_gain[k].append(
                    r["responses"][k]["gain"]
                )


        # random controls
        for c in RND_ATLAS[
            source_li
        ]:

            r = (
                fp32_multi_horizon_radar(
                    blocks_fp32,
                    source_li,
                    first_call,
                    c["q"],
                )
            )


            for k in offsets:

                rnd_radar[k].append(
                    r["responses"][k]["D"]
                )


        # numpy conversion
        for k in offsets:

            sem_radar[k] = np.asarray(
                sem_radar[k],
                dtype=np.float64,
            )

            rnd_radar[k] = np.asarray(
                rnd_radar[k],
                dtype=np.float64,
            )


        # =====================================================================
        # C. SELECTION FREEZE
        #
        # Her horizon kendi candidate selection'ını yapar.
        # BF16 ACT henüz hesaplanmadı.
        # =====================================================================

        sem_selected = {}

        rnd_selected = {}


        for k in offsets:

            sem_selected[k] = int(
                np.argmax(
                    sem_radar[k]
                )
            )

            rnd_selected[k] = int(
                np.argmax(
                    rnd_radar[k]
                )
            )


        # Null pick de downstream öncesi freeze
        null_pick = random.Random(
            SEED
            +
            5_000_000
            +
            1000 * source_li
            +
            pi
        ).randrange(
            N_NULL
        )


        null_dirs = make_null_dirs(
            source_li,
            pi,
        )


        # no longer needed
        del first_call


        # =====================================================================
        # D. BF16 FULL-MODEL OUTCOMES
        #
        # Candidate outcomes yalnız B/C bittikten sonra hesaplanıyor.
        # =====================================================================

        per_dose = {}


        for rel in ACT_DOSES:

            fixed_a = full_act(
                prompt,
                source_li,
                DIBEK[source_li],
                baseline,
                rel,
            )


            sem_a = [
                full_act(
                    prompt,
                    source_li,
                    c["q"],
                    baseline,
                    rel,
                )
                for c in SEM_ATLAS[
                    source_li
                ]
            ]


            rnd_a = [
                full_act(
                    prompt,
                    source_li,
                    c["q"],
                    baseline,
                    rel,
                )
                for c in RND_ATLAS[
                    source_li
                ]
            ]


            nul_a = [
                full_act(
                    prompt,
                    source_li,
                    d,
                    baseline,
                    rel,
                )
                for d in null_dirs
            ]


            # -----------------------------------------------------------------
            # realization integrity
            # -----------------------------------------------------------------

            integrity = {

                "fixed_rel":
                    fixed_a[
                        "realized_rel"
                    ],

                "fixed_dir_cos":
                    fixed_a[
                        "dir_cos"
                    ],

                "sem_dir_cos":
                    mean_or_nan(
                        [
                            x["dir_cos"]
                            for x in sem_a
                        ]
                    ),

                "sem_angle_err":
                    mean_or_nan(
                        [
                            x["angle_err"]
                            for x in sem_a
                        ]
                    ),

                "sem_realized_pair_angle":
                    pair_angle_mean(
                        [
                            x["dx"]
                            for x in sem_a
                        ]
                    ),

                "null_realized_angle_vs_fixed":
                    mean_or_nan(
                        [
                            angle(
                                x["dx"],
                                fixed_a["dx"],
                            )
                            for x in nul_a
                        ]
                    ),
            }


            # -----------------------------------------------------------------
            # Terminal ground truth
            # -----------------------------------------------------------------

            terminal_layer = 19

            fixed_D19 = (
                fixed_a["D"][
                    terminal_layer
                ]
            )


            sem_D19 = np.asarray(
                [
                    x["D"][terminal_layer]
                    for x in sem_a
                ],
                dtype=np.float64,
            )


            rnd_D19 = np.asarray(
                [
                    x["D"][terminal_layer]
                    for x in rnd_a
                ],
                dtype=np.float64,
            )


            null_D19 = np.asarray(
                [
                    x["D"][terminal_layer]
                    for x in nul_a
                ],
                dtype=np.float64,
            )


            sem_oracle_id = int(
                np.argmax(
                    sem_D19
                )
            )


            rnd_oracle_id = int(
                np.argmax(
                    rnd_D19
                )
            )


            null_oracle_id = int(
                np.argmax(
                    null_D19
                )
            )


            # -----------------------------------------------------------------
            # Horizon-by-horizon navigation evaluation
            # -----------------------------------------------------------------

            horizon_eval = {}


            for k in offsets:

                sem_sel = (
                    sem_selected[k]
                )

                rnd_sel = (
                    rnd_selected[k]
                )


                order = np.argsort(
                    -sem_D19
                )


                terminal_rank = (
                    int(
                        np.where(
                            order == sem_sel
                        )[0][0]
                    )
                    +
                    1
                )


                horizon_eval[k] = {

                    "probe_layer":
                        source_li + k,

                    "sem_selected_id":
                        sem_sel,

                    "sem_selected_label":
                        SEM_LABELS[
                            sem_sel
                        ],

                    "rnd_selected_id":
                        rnd_sel,

                    "sem_sel_delta":
                        float(
                            sem_D19[
                                sem_sel
                            ]
                            -
                            fixed_D19
                        ),

                    "rnd_sel_delta":
                        float(
                            rnd_D19[
                                rnd_sel
                            ]
                            -
                            fixed_D19
                        ),

                    "sem_minus_rnd":
                        float(
                            sem_D19[
                                sem_sel
                            ]
                            -
                            rnd_D19[
                                rnd_sel
                            ]
                        ),

                    "sem_terminal_rank":
                        terminal_rank,

                    "sem_top4":
                        int(
                            terminal_rank <= 4
                        ),

                    "sem_oracle_hit":
                        int(
                            sem_sel
                            ==
                            sem_oracle_id
                        ),

                    "sem_terminal_pearson":
                        pearson(
                            sem_radar[k],
                            sem_D19,
                        ),

                    "sem_terminal_spearman":
                        spearman(
                            sem_radar[k],
                            sem_D19,
                        ),

                    "rnd_terminal_spearman":
                        spearman(
                            rnd_radar[k],
                            rnd_D19,
                        ),

                    "local_selected_score":
                        float(
                            sem_radar[k][
                                sem_sel
                            ]
                        ),
                }


            terminal = {

                "fixed_D19":
                    fixed_D19,

                "sem_oracle_delta":
                    float(
                        sem_D19.max()
                        -
                        fixed_D19
                    ),

                "rnd_oracle_delta":
                    float(
                        rnd_D19.max()
                        -
                        fixed_D19
                    ),

                "null_oracle_delta":
                    float(
                        null_D19.max()
                        -
                        fixed_D19
                    ),

                "null_pick_delta":
                    float(
                        null_D19[
                            null_pick
                        ]
                        -
                        fixed_D19
                    ),

                "semantic_oracle_id":
                    sem_oracle_id,

                "semantic_oracle_label":
                    SEM_LABELS[
                        sem_oracle_id
                    ],

                "random_oracle_id":
                    rnd_oracle_id,

                "null_oracle_id":
                    null_oracle_id,

                "oracle_minus_null":
                    float(
                        sem_D19.max()
                        -
                        null_D19.max()
                    ),
            }


            per_dose[
                str(rel)
            ] = {

                "integrity":
                    integrity,

                "terminal":
                    terminal,

                "horizon_eval":
                    horizon_eval,
            }


            del fixed_a
            del sem_a
            del rnd_a
            del nul_a


        # =====================================================================
        # E. SAVE PROMPT/SOURCE ROW
        # =====================================================================

        row = {

            "prompt_index":
                pi,

            "source_layer":
                source_li,

            "valid_probe_offsets":
                offsets,

            "requested_sem_pair_angle":
                requested_sem_pair,

            "fixed_radar": {
                str(k):
                    fixed_r[
                        "responses"
                    ][k]["D"]
                for k in offsets
            },

            "sem_radar": {
                str(k):
                    sem_radar[k].tolist()
                for k in offsets
            },

            "rnd_radar": {
                str(k):
                    rnd_radar[k].tolist()
                for k in offsets
            },

            "sem_gain": {
                str(k):
                    [
                        float(v)
                        for v in sem_gain[k]
                    ]
                for k in offsets
            },

            "sem_selected": {
                str(k):
                    int(
                        sem_selected[k]
                    )
                for k in offsets
            },

            "rnd_selected": {
                str(k):
                    int(
                        rnd_selected[k]
                    )
                for k in offsets
            },

            "doses":
                per_dose,
        }


        layer_rows.append(
            row
        )


        del baseline
        del fixed_r


        if (pi + 1) % 4 == 0:

            gc.collect()
            torch.cuda.empty_cache()


        print(
            f"    prompt "
            f"{pi+1:02d}/{N_PROMPTS} | "
            f"{(time.time()-t_main)/60:.1f}m",
            end="\r",
        )


    print()


    RESULTS.append({

        "source_layer":
            source_li,

        "probe_offsets":
            offsets,

        "requested_sem_pair_angle":
            requested_sem_pair,

        "rows":
            layer_rows,
    })


    # -------------------------------------------------------------------------
    # Critical memory rule:
    # one source chain at a time.
    # -------------------------------------------------------------------------

    for k in list(
        blocks_fp32.keys()
    ):

        del blocks_fp32[k]


    del blocks_fp32

    gc.collect()
    torch.cuda.empty_cache()


print(
    f"\nAna assay tamamlandı: "
    f"{(time.time()-t_main)/60:.1f} dk"
)


