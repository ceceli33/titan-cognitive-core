RANK_ONLY_HORIZONS = []


for k in valid_horizons:

    h = P_H[
        str(k)
    ]


    nav_positive = (
        h["sem"]["ci95"][0]
        >
        0
    )


    beats_random = (
        h[
            "sem_minus_rnd"
        ]["ci95"][0]
        >
        0
    )


    rho_mean = (
        h["rho"]["mean"]
    )


    rho_positive = (
        np.isfinite(
            rho_mean
        )
        and
        rho_mean > 0.10
    )


    if (
        nav_positive
        and
        beats_random
        and
        rho_positive
    ):

        SUPPORTED_HORIZONS.append(
            k
        )


    elif rho_positive:

        RANK_ONLY_HORIZONS.append(
            k
        )


