    "03_SYNTH_T94_DRA":  _todev({li: SYNTH_T94 for li in range(VECTOR_LAYERS)}),
    "04_RASTGELE_DRA":   _todev({li: _grand for li in range(VECTOR_LAYERS)}),
    "05_FIL_DRA":        _todev(FIL_VEC),
}

@torch.no_grad()
def uret(q, vec):
    GEN.update(aktif=vec is not None, vec=vec, ivme=IVME_GEN, fren_sayac=0, adim=0)
    p = (f"<|im_start|>system\n{CTX_ZOO}<|im_end|>\n<|im_start|>user\n{q}"
         f"<|im_end|>\n<|im_start|>assistant\n")
    e = tokenizer(p, return_tensors="pt").to(device)
    out = model.generate(**e, max_new_tokens=MAX_TOKENS, do_sample=False,
                         repetition_penalty=1.15, pad_token_id=tokenizer.pad_token_id,
                         eos_token_id=eos)
    t_ = tokenizer.decode(out[0][e["input_ids"].shape[1]:], skip_special_tokens=True).strip()
    fr = GEN["fren_sayac"] / max(1, GEN["adim"])
    GEN["aktif"] = False
    return t_, fr

