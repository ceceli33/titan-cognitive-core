# 9. KÜÇÜK PROB — sadece L12 (TEST 123 ile aynı; hizalama DIBEK_N3[12]'ye)
# =============================================================================

@torch.no_grad()
def tiny_probe(prompt, baseline, direction):
    h11 = baseline[SOURCE_LAYER].float()
    probe_norm = PROBE_REL * float(torch.linalg.vector_norm(h11))
    q_dev = direction.to(device=device, dtype=torch.float32)
    cap12 = {}; handles = []

    def source_hook(module, inp, out):
        h = out[0] if isinstance(out, tuple) else out
        hnew = h.clone()
        hnew[0, -1] = (h[0, -1].float() + probe_norm * q_dev).to(h.dtype)
        return (hnew, *out[1:]) if isinstance(out, tuple) else hnew

    def target_hook(module, inp, out):
        h = out[0] if isinstance(out, tuple) else out
        cap12["h"] = h[0, -1].detach().float().cpu().clone()

    try:
        handles.append(model.model.layers[SOURCE_LAYER].register_forward_hook(source_hook))
        handles.append(model.model.layers[PROBE_TARGET].register_forward_hook(target_hook))
        enc = tokenizer(prompt, return_tensors="pt").to(device)
        model(**enc, use_cache=False)
    finally:
        for h in handles:
            h.remove()

    d12 = cap12["h"] - baseline[PROBE_TARGET]
    dn = float(torch.linalg.vector_norm(d12))
    gain = dn / (probe_norm + EPS)
    align = cos_tensor(d12, DIBEK_N3[PROBE_TARGET])
    return {"probe_norm": probe_norm, "delta12_norm": dn, "gain_G": gain,
            "alignment_A": align, "transport_T": gain * align}


# =============================================================================
# 10. DRA ZARFI (TEST 123 ile aynı)
# =============================================================================

def dra_envelope(layer_idx, sensor_cos):
    unc = 1.0 - abs(float(sensor_cos))
    omega = SONUM + 0.20 * unc
    t = float(layer_idx)
    raw = ZIRVE * math.exp(-omega * t) * (1.0 + omega * t) + TABAN
    return float(raw / (ZIRVE + TABAN))


# =============================================================================
# 11. TAM GÜÇLÜ KOL — iki referansla ölçer
#
#   D_dibek[L] = cos(delta_L, DIBEK_N3[L])     anlamsal taşıma (ortak ölçüt)
#   D_self[L]  = cos(delta_L, own[L])          kendi yönünü koruma
#                own katman sözlüğü yoksa (SYNTH, GLOBAL, L27) ->
#                enjekte edilen yönün kendisi (ham tutunma)
# =============================================================================

@torch.no_grad()
def run_full_arm(prompt, baseline, direction, own_vecs, frozen_env):
    src = baseline[SOURCE_LAYER].float()
    contribution = IVME * frozen_env * float(torch.linalg.vector_norm(src))
    q_dev = direction.to(device=device, dtype=torch.float32)
    captures = {}; handles = []

    def make_hook(li):
        def hook(module, inp, out):
            h = out[0] if isinstance(out, tuple) else out
            if li == SOURCE_LAYER:
                post = h[0, -1].float() + contribution * q_dev
                hnew = h.clone(); hnew[0, -1] = post.to(h.dtype)
                captures[SOURCE_LAYER] = post.detach().float().cpu().clone()
                return (hnew, *out[1:]) if isinstance(out, tuple) else hnew
            if li in TARGET_LAYERS:
                captures[li] = h[0, -1].detach().float().cpu().clone()
            return out
        return hook

    try:
        for li in range(SOURCE_LAYER, MODEL_LAYERS):
            if li == SOURCE_LAYER or li in TARGET_LAYERS:
                handles.append(model.model.layers[li].register_forward_hook(make_hook(li)))
        enc = tokenizer(prompt, return_tensors="pt").to(device)
        model(**enc, use_cache=False)
    finally:
        for h in handles:
            h.remove()

    sd = captures[SOURCE_LAYER] - baseline[SOURCE_LAYER]
    res = {"source_injection_relative":
           float(torch.linalg.vector_norm(sd) /
                 (torch.linalg.vector_norm(baseline[SOURCE_LAYER]) + EPS))}
    for li in TARGET_LAYERS:
        delta = captures[li] - baseline[li]
        P = float(torch.linalg.vector_norm(delta) /
                  (torch.linalg.vector_norm(baseline[li]) + EPS))
        if li < VECTOR_LAYERS:
            D_dibek = cos_tensor(delta, DIBEK_N3[li])
            ref_self = own_vecs[li] if own_vecs is not None else direction
        else:
            D_dibek = float("nan")          # L27'de kilitli vektör yok
            ref_self = direction
        D_self = cos_tensor(delta, ref_self)
        res[li] = {"D_dibek": D_dibek, "D_self": D_self, "P": P}
    return res


