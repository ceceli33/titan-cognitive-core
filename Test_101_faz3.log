# --- 6c. Test 94 sentetik vektörü, birebir tarif ---
print("\n[4/20] Test 94 sentetik vektörü (birebir tarif, seed=42)...")

def build_synth_t94():
    rng = random.Random(42)          # Test 94: random.seed(42); random.gauss
    def l2n(v):
        n = math.sqrt(sum(x * x for x in v))
        return [x / n for x in v] if n > 0 else v
    D = HIDDEN
    v_harm     = l2n([rng.gauss(0, 1) for _ in range(D)])
    v_honesty  = l2n([rng.gauss(0, 1) for _ in range(D)])
    v_autonomy = l2n([rng.gauss(0, 1) for _ in range(D)])
    v_fairness = l2n([rng.gauss(0, 1) for _ in range(D)])
    weights = [0.9228, 0.9372, 0.8788, 0.9196]
    raw = [0.0] * D
    for vec, w in zip([v_harm, v_honesty, v_autonomy, v_fairness], weights):
        for i in range(D):
            raw[i] += vec[i] * w
    return l2n(raw)

_synth_list = build_synth_t94()
