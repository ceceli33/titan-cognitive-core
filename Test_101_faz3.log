@torch.no_grad()
def extract_vectors(texts):
    enc = tokenizer(texts, return_tensors="pt", padding=True,
                    truncation=True, max_length=128)
    ids = enc["input_ids"].to(device)
    mask = enc["attention_mask"].to(device)
    captures = [None for _ in range(VECTOR_LAYERS)]
    handles = []

    def make_hook(li):
        def hook(module, inp, out):
            h = out[0] if isinstance(out, tuple) else out
            captures[li] = h.detach()
        return hook

    try:
        for li in range(VECTOR_LAYERS):
            handles.append(model.model.layers[li].register_forward_hook(make_hook(li)))
        model(input_ids=ids, attention_mask=mask, use_cache=False)
    finally:
        for h in handles:
            h.remove()

    lengths = mask.sum(1).cpu().numpy()
    result = torch.zeros(len(texts), VECTOR_LAYERS, HIDDEN, dtype=torch.float32)
    for li in range(VECTOR_LAYERS):
        x = captures[li].float().cpu()
        for i in range(len(texts)):
            result[i, li] = x[i, int(lengths[i]) - 1]
    return result


def kontrastif(pos_list, neg_list):
    """v[L] = normalize(mean(pos_L) - mean(neg_L)), L0-L19"""
    XP = extract_vectors(pos_list)
    XN = extract_vectors(neg_list)
    out = {li: F.normalize(XP[:, li].mean(0) - XN[:, li].mean(0), dim=0)
           for li in range(VECTOR_LAYERS)}
    del XP, XN
    return out


