# =============================================================================
# 14. BÖLÜM B — DAVRANIŞSAL DOĞRULAMA (Aşama 16 motoru, PyTorch)
#
# Gizli-durum taşıması metne dönüşüyor mu?
#   katki = ivme × zarf(L) × ‖h‖ × son, L0-L19, tüm token'lar, her adım
#   zarf ve fren: cs = cos(h, v_L); fren cs>0.75 -> (1-cs)/0.25
# =============================================================================

print("\n[15/20] BÖLÜM B — davranışsal doğrulama (metin üretimi)...")

CTX_ZOO = ("Zoodex is a recently discovered animal species. It was formally "
           "described by zoologists and is now a recognised species. Answer as a "
           "zoologist who has studied it in the field.")
P_GEN = ["What is a Zoodex? Describe its body and limbs.",
         "Describe the anatomy of the Zoodex, especially its limbs and tail.",
         "What does a Zoodex look like? Give a physical description.",
         "What family of animals does the Zoodex belong to?"]
eos = list({tokenizer.eos_token_id,
            tokenizer.convert_tokens_to_ids("<|im_end|>"),
            tokenizer.convert_tokens_to_ids("<|endoftext|>")} - {None, -1})

GEN = {"aktif": False, "vec": None, "ivme": 0.0, "fren_sayac": 0, "adim": 0}

def _gen_hook(li):
    def hook(module, inp, out):
        if not GEN["aktif"] or li >= VECTOR_LAYERS:
            return out
        h = out[0] if isinstance(out, tuple) else out
        od = h.dtype
        x = h.float()
        v = GEN["vec"][li]                                   # [D] on device
        nrm = torch.linalg.vector_norm(x, dim=-1, keepdim=True) + 1e-6
        cs = torch.clamp((x @ v).unsqueeze(-1) / nrm, -1.0, 1.0)
        unc = 1.0 - cs.abs()
        dw = SONUM + unc * 0.20
        t = float(li)
        kb = ZIRVE * torch.exp(-dw * t) * (1.0 + dw * t) + TABAN
        zarf = kb / (ZIRVE + TABAN)
        son = torch.where(cs > 0.75, (1.0 - cs) / 0.25,
              torch.where(cs < -0.40, torch.full_like(cs, 1.6), torch.ones_like(cs)))
        GEN["fren_sayac"] += int((cs > 0.75).sum().item())
        GEN["adim"] += int(cs.numel())
        katki = GEN["ivme"] * zarf * nrm * son
        x = x + katki * v
        x = x.to(od)
        return (x,) + tuple(out[1:]) if isinstance(out, tuple) else x
    return hook

_gh = [model.model.layers[li].register_forward_hook(_gen_hook(li))
       for li in range(VECTOR_LAYERS)]

def _todev(d):
    return {li: d[li].to(device=device, dtype=torch.float32) for li in range(VECTOR_LAYERS)}

