def kelime(t): return len(t.split())
def ham(t, ws):
    low = " " + t.lower() + " "
    return sum(low.count(" " + w) for w in ws)
def yogun(t, ws):
    n = kelime(t); return 0.0 if n == 0 else 100.0 * ham(t, ws) / n
def bozulma(t):
    if not t.strip(): return 1.0
    tk = t.split(); n = len(tk)
    cop = sum(1 for x in tk if not re.search(r'[^\W\d_]{2,}', x)) / n
    sym = len(re.findall(r'[—\[\]\|\$#~=]', t)) / max(1, len(t))
    kir = sum(1 for x in tk if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]', x)) / n
    return max(cop, sym * 6, kir * 4)
def tekrar(t, n=4):
    tk = [w.lower().strip(".,!?;:") for w in t.split()]
    if len(tk) < n * 2: return 0.0
    gr = [tuple(tk[i:i + n]) for i in range(len(tk) - n + 1)]
    oran = 1.0 - (len(set(gr)) / len(gr))
    enf = Counter(gr).most_common(1)[0][1]
    return max(oran, min(1.0, (enf - 1) / 8.0))
def uz_cokus(t, tk):
    if tk <= 0: return 0.0
    o = kelime(t) / tk
    return 0.0 if o >= 0.5 else min(1.0, (0.5 - o) / 0.3)

GEN_RES = {}; TABAN_KEL = None
_tB = time.time()
for ad, vec in GEN_ARMS.items():
    outs, frs = [], []
    for q in P_GEN:
        t_, fr = uret(q, vec); outs.append(t_); frs.append(fr)
    kel = statistics.mean([kelime(o) for o in outs])
    if ad == "00_TABAN":
        TABAN_KEL = kel
    d = {"kelime": kel,
         "hedef": statistics.mean([yogun(o, HEDEF_K) for o in outs]),
         "anti":  statistics.mean([yogun(o, ANTI_K) for o in outs]),
         "fil":   statistics.mean([yogun(o, FIL_K) for o in outs]),
         "bozulma": statistics.mean([bozulma(o) for o in outs]),
         "tekrar":  statistics.mean([tekrar(o) for o in outs]),
         "uz_cokus": statistics.mean([uz_cokus(o, TABAN_KEL) for o in outs]),
         "fren_oran": statistics.mean(frs),
         "texts": outs}
    d["net"] = d["hedef"] - d["anti"]
    d["kalite"] = max(d["bozulma"], d["tekrar"], d["uz_cokus"])
    GEN_RES[ad] = d
for h in _gh:
    h.remove()
