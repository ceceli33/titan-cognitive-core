# 8. TOHUM-MERKEZLİ ADAY BULUTU (TEST 123 ile aynı)
# =============================================================================

def make_candidate_cloud(seed, prompt_index):
    seed = normalize(seed)
    g = torch.Generator(device="cpu"); g.manual_seed(SEED + 100000 + prompt_index)
    cands = []; cid = 0
    for ang in ANGLES_DEG:
        th = math.radians(ang); c = math.cos(th); s = math.sin(th)
        for di in range(DEVIATIONS_PER_ANGLE):
            r = torch.randn(HIDDEN, generator=g, dtype=torch.float32)
            u = normalize(r - torch.dot(r, seed) * seed)
            if u is None:
                continue
            q = normalize(c * seed + s * u)
            cands.append({"candidate_id": cid, "angle_deg": ang,
                          "deviation_index": di, "direction": q,
                          "cos_seed": cos_tensor(q, seed)})
            cid += 1
    if len(cands) != N_CANDIDATES:
        raise RuntimeError("Aday bulutu boyutu uyuşmuyor")
    return cands


def make_global_random(prompt_index):
    g = torch.Generator(device="cpu"); g.manual_seed(SEED + 200000 + prompt_index)
    return normalize(torch.randn(HIDDEN, generator=g, dtype=torch.float32))


