# =============================================================================
# 11. EŞİT AÇILI SEMANTİK ATLAS  (kimlik korumalı)
# =============================================================================

print("\n[5/24] Eşit açılı semantik atlas...")
theta = math.radians(SHELL_DEG)
SEM_ATLAS = {}
SEM_NATURAL_ANGLES = {}

for li in SOURCE_LAYERS:
    v = unit(DIBEK[li])
    rows = []
    nat = []
    for cid in range(N_SEMANTIC):
        w = unit(SEM_DICTS[cid][li])
        raw_cos = cos(w, v)

        if raw_cos > IDENTITY_TOL:
            raise RuntimeError(
                f"L{li} aday {cid} ({SEM_LABELS[cid]}) tarihsel v ile özdeş "
                f"(cos={raw_cos:+.6f}). Varyant listesini kontrol et.")

        tangent = w - torch.dot(w, v) * v
        tn = float(torch.linalg.vector_norm(tangent).item())
        if tn <= 1e-8:
            raise RuntimeError(f"Çöken teğet L{li} aday {cid} ({SEM_LABELS[cid]})")
        tangent = unit(tangent)
        q = unit(math.cos(theta) * v + math.sin(theta) * tangent)
        nat.append(angle(w, v))
        rows.append({"id": cid, "label": SEM_LABELS[cid], "q": q,
                     "raw_cos": raw_cos, "natural_angle": nat[-1],
                     "requested_angle": angle(q, v)})
    SEM_ATLAS[li] = rows
    SEM_NATURAL_ANGLES[li] = nat
    print(f"  L{li:02d}: istenen açı={np.mean([r['requested_angle'] for r in rows]):.4f}° | "
          f"doğal semantik açı aralığı=[{min(nat):.2f}°, {max(nat):.2f}°] "
          f"ort {np.mean(nat):.2f}°")


