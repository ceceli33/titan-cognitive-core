# 12. EŞLEŞTİRİLMİŞ KABUKTA RASTGELE ATLAS
# =============================================================================

print("\n[6/24] Eşleştirilmiş kabukta rastgele atlas...")
RND_ATLAS = {}
for li in SOURCE_LAYERS:
    v = unit(DIBEK[li])
    rows = []
    for cid in range(N_RANDOM):
        g = torch.Generator(device="cpu")
        g.manual_seed(SEED + 1_000_000 + li * 1000 + cid)
        z = torch.randn(HIDDEN, generator=g, dtype=torch.float32)
        z = unit(z - torch.dot(z, v) * v)
        rows.append({"id": cid, "q": unit(math.cos(theta) * v + math.sin(theta) * z)})
    RND_ATLAS[li] = rows
print(f"  {len(SOURCE_LAYERS)} katman × {N_RANDOM} rastgele aday")


# =============================================================================
# 13. JITTER-NULL YÖNLERİ  (TEST 135 tarifi)
# =============================================================================

def make_null_dirs(li, pi):
    v = unit(DIBEK[li])
    out = []
    for nid in range(N_NULL):
        g = torch.Generator(device="cpu")
        g.manual_seed(SEED + 7_000_000 + 100_000 * pi + 1000 * li + nid)
        z = torch.randn(HIDDEN, generator=g, dtype=torch.float32)
        z = unit(z - torch.dot(z, v) * v)
        out.append(unit(v + NULL_JITTER_REL * z))
    return out


# =============================================================================
# 14. UFUKLAR
# =============================================================================

def get_horizons(li):
    hs = {li + 1, 19}
    if li + 3 <= 19:
        hs.add(li + 3)
    if li + 5 <= 19:
        hs.add(li + 5)
    return sorted(hs)


# =============================================================================
# 15. TEK BASELINE: çıktılar + L+1 çağrı bağlamı
# =============================================================================

@torch.inference_mode()
def baseline_and_target_call(prompt, source_li):
    target_li = source_li + 1
    needed = sorted(set([source_li] + get_horizons(source_li)))
    outputs, target_call, handles = {}, {}, []

    def make_output_hook(layer_id):
        def hook(module, args, out):
            h = out[0] if isinstance(out, tuple) else out
            outputs[layer_id] = h[0, -1].detach().float().cpu().clone()
        return hook

    def target_pre_hook(module, args, kwargs):
        target_call["args"] = tuple(
            x.detach().clone() if torch.is_tensor(x) else x for x in args)
        kw = {}
        for k, val in kwargs.items():
            if torch.is_tensor(val):
                kw[k] = val.detach().clone()
            elif isinstance(val, tuple):
                kw[k] = tuple(i.detach().clone() if torch.is_tensor(i) else i for i in val)
            else:
                kw[k] = val
        target_call["kwargs"] = kw

    try:
        for lid in needed:
            handles.append(model.model.layers[lid].register_forward_hook(make_output_hook(lid)))
        handles.append(model.model.layers[target_li].register_forward_pre_hook(
            target_pre_hook, with_kwargs=True))
        enc = {k: v.to(device) for k, v in tokenizer(prompt, return_tensors="pt").items()}
        model(**enc, use_cache=False)
    finally:
        for h in handles:
            h.remove()

    if "args" not in target_call:
        raise RuntimeError(f"L{target_li} girdisi yakalanamadı.")
    return outputs, target_call


# =============================================================================
# 16. FP32 YEREL BLOK
# =============================================================================

def fp32_nested(x):
    if torch.is_tensor(x):
        return x.float() if x.is_floating_point() else x
    if isinstance(x, tuple):
        return tuple(fp32_nested(v) for v in x)
    if isinstance(x, list):
        return [fp32_nested(v) for v in x]
    if isinstance(x, dict):
        return {k: fp32_nested(v) for k, v in x.items()}
    return x


def locate_hidden(args, kwargs):
    if len(args) > 0 and torch.is_tensor(args[0]) and args[0].ndim == 3:
        return "args", 0, args[0]
    if "hidden_states" in kwargs:
        return "kwargs", "hidden_states", kwargs["hidden_states"]
    raise RuntimeError("hidden_states bulunamadı.")


def set_hidden(args, kwargs, hidden):
    args = list(args); kwargs = dict(kwargs)
    where, key, _ = locate_hidden(args, kwargs)
    if where == "args":
        args[key] = hidden
    else:
        kwargs[key] = hidden
    return tuple(args), kwargs


@torch.inference_mode()
def fp32_block_forward(block, target_call, hidden):
    args = fp32_nested(target_call["args"])
    kwargs = fp32_nested(target_call["kwargs"])
    args, kwargs = set_hidden(args, kwargs, hidden)
    if "use_cache" in kwargs:
        kwargs["use_cache"] = False
    out = block(*args, **kwargs)
    if isinstance(out, tuple):
        h = out[0]
    elif hasattr(out, "last_hidden_state"):
        h = out.last_hidden_state
    else:
        h = out
    return h.float()


@torch.inference_mode()
def fp32_radar(block, target_call, direction):
    _, _, h_orig = locate_hidden(target_call["args"], target_call["kwargs"])
    h0 = h_orig.detach().float().clone()
    q = unit(direction).to(device=h0.device, dtype=torch.float32)
    eps_norm = RADAR_REL * float(torch.linalg.vector_norm(h0[0, -1]).item())
    hp = h0.clone(); hm = h0.clone()
    hp[0, -1] += eps_norm * q
    hm[0, -1] -= eps_norm * q
    yp = fp32_block_forward(block, target_call, hp)
    ym = fp32_block_forward(block, target_call, hm)
    resp = ((yp[0, -1] - ym[0, -1]) / 2.0).detach().float().cpu()
    rn = float(torch.linalg.vector_norm(resp).item())
    return {"response": resp, "gain": rn / (eps_norm + EPS)}


# =============================================================================
# 17. BF16 TAM MODEL AKTÜATÖRÜ (doz parametreli)
# =============================================================================

@torch.inference_mode()
def full_act(prompt, source_li, direction, baseline, rel):
    horizons = get_horizons(source_li)
    q_cpu = unit(direction)
    q = q_cpu.to(device=device, dtype=torch.float32)
    src_norm = float(torch.linalg.vector_norm(baseline[source_li]).item())
    req_norm = rel * src_norm
    captures, realized, handles = {}, {}, []

    def source_hook(module, args, out):
        h = out[0] if isinstance(out, tuple) else out
        hnew = h.clone()
        before = h[0, -1].float()
        hnew[0, -1] = (before + req_norm * q).to(dtype=h.dtype)
        realized["dx"] = (hnew[0, -1].float() - before).detach().cpu()
        return ((hnew,) + out[1:]) if isinstance(out, tuple) else hnew

    def make_target_hook(lid):
        def hook(module, args, out):
            h = out[0] if isinstance(out, tuple) else out
            captures[lid] = h[0, -1].detach().float().cpu()
        return hook

    try:
        handles.append(model.model.layers[source_li].register_forward_hook(source_hook))
        for lid in horizons:
            handles.append(model.model.layers[lid].register_forward_hook(make_target_hook(lid)))
        enc = {k: v.to(device) for k, v in tokenizer(prompt, return_tensors="pt").items()}
        model(**enc, use_cache=False)
    finally:
        for hd in handles:
            hd.remove()

    dx = realized["dx"]
    res = {"dx": dx,
           "realized_rel": float(torch.linalg.vector_norm(dx).item()) / (src_norm + EPS),
           "dir_cos": cos(dx, q_cpu),
           "angle_err": angle(dx, q_cpu),
           "D": {}}
    for lid in horizons:
        res["D"][lid] = cos(captures[lid] - baseline[lid], DIBEK[lid])
    return res


def pair_angle_mean(vectors):
    a = []
    for i in range(len(vectors)):
        for j in range(i + 1, len(vectors)):
            a.append(angle(vectors[i], vectors[j]))
    return float(np.mean(a))


