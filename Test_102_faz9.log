print("\n[7/24] FP32 radar -> BF16 downstream assay (iki doz + jitter-null)...")
RESULTS = []
t_main = time.time()

for source_li in SOURCE_LAYERS:
    target_li = source_li + 1
    horizons = get_horizons(source_li)
    print(f"\n  L{source_li}->L{target_li}: FP32 blok kopyalanıyor... ufuklar {horizons}")

    block_fp32 = copy.deepcopy(model.model.layers[target_li]).to(
        device=device, dtype=torch.float32).eval()
    for p in block_fp32.parameters():
        p.requires_grad_(False)

    requested_sem_pair = pair_angle_mean([c["q"] for c in SEM_ATLAS[source_li]])
    layer_rows = []

    for pi, prompt in enumerate(PROMPTS):

        baseline, target_call = baseline_and_target_call(prompt, source_li)

        # ---------------- FP32 RADAR (yerel) ----------------
        fixed_r = fp32_radar(block_fp32, target_call, DIBEK[source_li])
        fixed_local = cos(fixed_r["response"], DIBEK[target_li])

        sem_local, sem_gain = [], []
        for c in SEM_ATLAS[source_li]:
            r = fp32_radar(block_fp32, target_call, c["q"])
            sem_local.append(cos(r["response"], DIBEK[target_li]))
            sem_gain.append(r["gain"])

        rnd_local = []
        for c in RND_ATLAS[source_li]:
            r = fp32_radar(block_fp32, target_call, c["q"])
            rnd_local.append(cos(r["response"], DIBEK[target_li]))

        sem_local = np.asarray(sem_local); rnd_local = np.asarray(rnd_local)

        # ================= SEÇİM DONDURULDU =================
        sem_sel = int(np.argmax(sem_local))
        rnd_sel = int(np.argmax(rnd_local))
        null_pick = random.Random(SEED + 5_000_000 + 1000 * source_li + pi).randrange(N_NULL)
        del target_call

        null_dirs = make_null_dirs(source_li, pi)

        # ---------------- BF16 ACT, her doz ----------------
        per_dose = {}
        for rel in ACT_DOSES:
            fixed_a = full_act(prompt, source_li, DIBEK[source_li], baseline, rel)
            sem_a = [full_act(prompt, source_li, c["q"], baseline, rel) for c in SEM_ATLAS[source_li]]
            rnd_a = [full_act(prompt, source_li, c["q"], baseline, rel) for c in RND_ATLAS[source_li]]
            nul_a = [full_act(prompt, source_li, d, baseline, rel) for d in null_dirs]

            integ = {
                "fixed_rel": fixed_a["realized_rel"],
                "fixed_dir_cos": fixed_a["dir_cos"],
                "sem_dir_cos": mean_or_nan([x["dir_cos"] for x in sem_a]),
                "sem_angle_err": mean_or_nan([x["angle_err"] for x in sem_a]),
                "rnd_dir_cos": mean_or_nan([x["dir_cos"] for x in rnd_a]),
                "sem_realized_pair_angle": pair_angle_mean([x["dx"] for x in sem_a]),
                "null_realized_angle_vs_fixed": mean_or_nan(
                    [angle(x["dx"], fixed_a["dx"]) for x in nul_a]),
            }

            hz = {}
            for h in horizons:
                fD = fixed_a["D"][h]
                sv = np.asarray([x["D"][h] for x in sem_a])
                rv = np.asarray([x["D"][h] for x in rnd_a])
                nv = np.asarray([x["D"][h] for x in nul_a])
                order = np.argsort(-sv)
                sem_rank = int(np.where(order == sem_sel)[0][0]) + 1
                hz[h] = {
                    "fixed_D": fD,
                    "sem_sel_delta": float(sv[sem_sel] - fD),
                    "sem_oracle_delta": float(sv.max() - fD),
                    "rnd_sel_delta": float(rv[rnd_sel] - fD),
                    "rnd_oracle_delta": float(rv.max() - fD),
                    "null_oracle_delta": float(nv.max() - fD),
                    "null_pick_delta": float(nv[null_pick] - fD),
                    "sem_rank": sem_rank,
                    "sem_top4": int(sem_rank <= 4),
                    "sem_hit": int(sem_sel == int(np.argmax(sv))),
                    "sem_rho": spearman(sem_local, sv),
                    "rnd_rho": spearman(rnd_local, rv),
                }
            per_dose[str(rel)] = {"integrity": integ, "horizons": hz}

            del fixed_a, sem_a, rnd_a, nul_a

        layer_rows.append({
            "prompt_index": pi,
            "sem_selected_id": sem_sel,
            "sem_selected_label": SEM_LABELS[sem_sel],
            "rnd_selected_id": rnd_sel,
            "fixed_local_D": fixed_local,
            "sem_local": sem_local.tolist(),
            "sem_gain": sem_gain,
            "rnd_local": rnd_local.tolist(),
            "doses": per_dose,
        })

        del baseline
        if (pi + 1) % 4 == 0:
            gc.collect(); torch.cuda.empty_cache()
        print(f"    prompt {pi+1:02d}/{N_PROMPTS} | {(time.time()-t_main)/60:.1f}m", end="\r")

    print()
    RESULTS.append({"source_layer": source_li, "target_layer": target_li,
                    "requested_sem_pair_angle": requested_sem_pair,
                    "rows": layer_rows})
    del block_fp32
    gc.collect(); torch.cuda.empty_cache()

print(f"\nAna deney tamam: {(time.time()-t_main)/60:.1f} dk")


