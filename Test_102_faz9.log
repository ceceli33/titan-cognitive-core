def collect(rel, bucket):
    out = []
    for layer in RESULTS:
        li = layer["source_layer"]
        for row in layer["rows"]:
            hz = row["doses"][str(rel)]["horizons"]
            if bucket == "NEXT":
                h = li + 1
            elif bucket == "PLUS3":
                h = li + 3 if li + 3 <= 19 else None
            elif bucket == "PLUS5":
                h = li + 5 if li + 5 <= 19 else None
            elif bucket == "L19_ALL":
                h = 19
            elif bucket == "L19_LONG":
                h = 19 if li < 18 else None
            if h is not None:
                out.append(hz[h])
    return out


