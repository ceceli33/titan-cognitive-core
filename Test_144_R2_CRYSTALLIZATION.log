def dra_envelope(layer_idx):

    t = float(layer_idx)

    x = (
        ZIRVE
        * math.exp(-SONUM * t)
        * (1.0 + SONUM * t)
        + TABAN
    )

    return x / (ZIRVE + TABAN)


ENVELOPE = [
    dra_envelope(L)
    for L in range(N_LAYERS)
]


RELATIVE_DOSE = [
    IVME * x
    for x in ENVELOPE
]


