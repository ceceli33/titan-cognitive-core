]


terms = []


for L in probe_layers:

    h = out.hidden_states[
        L + 1
    ][0, pos, :]


    print(
        f"L{L:02d} | "
        f"requires_grad={h.requires_grad} | "
        f"grad_fn={type(h.grad_fn).__name__ if h.grad_fn else 'NONE'}"
    )


    if not h.requires_grad:
        raise RuntimeError(
            "Autograd X-ray failed."
        )


    terms.append(
        h.float()
        .square()
        .mean()
    )


probe_loss = torch.stack(
    terms
).mean()


probe_loss.backward()


grad_norm_sq = 0.0
grad_tensors = 0


for p in TRAINABLE_PARAMS:

    if p.grad is not None:

        g = p.grad.detach().float()

        if not torch.isfinite(g).all():
