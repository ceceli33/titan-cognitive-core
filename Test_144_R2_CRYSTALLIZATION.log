# =============================================================================
# 46. FINAL-TEST GEOMETRY FUNCTION
# =============================================================================

def compute_geometry(
    base_refs,
    target_refs,
    states_np,
):

    n_samples = len(
        base_refs
    )


    distance = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    progress = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    alignment = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    correction = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    per_prompt_rows = []


    for i in range(n_samples):

        prompt_progress = []
        prompt_alignment = []
        prompt_distance = []


        for L in range(N_LAYERS):

            B = (
                base_refs[i][L]
                .numpy()
            )


            T = (
                target_refs[i][L]
                .numpy()
            )


            S = states_np[
                i,
                L,
            ]


            D0 = max(
                np.linalg.norm(
                    B - T
                ),
                1e-12,
            )


            D = np.linalg.norm(
                S - T
            )


            P = (
                1.0
                - D / D0
            )


            C = safe_cos(
                S - B,
                T - B,
            )


            distance[L] += D
            progress[L] += P
            alignment[L] += C
            correction[L] += D / D0


            prompt_progress.append(P)
            prompt_alignment.append(C)
            prompt_distance.append(D)


        per_prompt_rows.append(
            {
                "prompt_index": int(i + 1),
                "mean_distance": float(
                    np.mean(
                        prompt_distance
                    )
                ),
                "mean_progress": float(
                    np.mean(
                        prompt_progress
                    )
                ),
                "mean_alignment": float(
                    np.mean(
                        prompt_alignment
                    )
                ),
            }
        )


    distance /= n_samples
    progress /= n_samples
    alignment /= n_samples
    correction /= n_samples


    return {
        "distance": distance,
        "progress": progress,
        "alignment": alignment,
        "correction": correction,

        "mean_distance": float(
            distance.mean()
        ),

        "mean_progress": float(
            progress.mean()
        ),

        "mean_alignment": float(
            alignment.mean()
        ),

        "mean_correction": float(
            correction.mean()
        ),

        "per_prompt": per_prompt_rows,
    }


BEST_FINAL_TEST_GEOMETRY = compute_geometry(
