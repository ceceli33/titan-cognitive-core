    TRAINING_START_DT
    .isoformat(timespec="seconds")
)

TRAINING_START_WALL = time.time()


print(
    "Training start:",
    TRAINING_START_ISO
)


start_power_sampler()


update = 0

epoch = 0


while update < HARD_MAX_UPDATES:

    epoch += 1


    order = list(
        range(N_TRAIN)
    )


    rng.shuffle(order)


    for idx in order:

        if update >= HARD_MAX_UPDATES:
            break


        update += 1


        prompt = TRAIN_PROMPTS[
            idx
        ]


        # -----------------------------------------------------------------
        # CURRENT ENDOGENOUS PUSULA -> ONE-SHOT SEASC TEACHING TARGET
        # -----------------------------------------------------------------

        target = current_teacher_target(
            prompt
        )


        # -----------------------------------------------------------------
        # NATURAL STUDENT — MOTOR OFF
        # -----------------------------------------------------------------

        optimizer.zero_grad(
            set_to_none=True
        )


        (
            total_loss,
            geo_loss,
            preserve_loss,
        ) = training_forward(
            prompt,
            target,
        )


        if not torch.isfinite(
            total_loss
        ):

            stop_power_sampler()

            raise RuntimeError(
                f"Non-finite loss @ {update}"
            )


        total_loss.backward()


        grad_norm = (
            torch.nn.utils
            .clip_grad_norm_(
                TRAINABLE_PARAMS,
                GRAD_CLIP,
            )
        )


        grad_norm_value = float(
            torch.as_tensor(
                grad_norm
            )
            .detach()
            .float()
            .cpu()
            .item()
        )


        if not math.isfinite(
            grad_norm_value
        ):

            stop_power_sampler()

            raise RuntimeError(
                f"Non-finite gradient @ {update}"
            )


        optimizer.step()


        # -----------------------------------------------------------------
        # IMMEDIATE ENDOGENOUS COMPASS REFRESH
        # -----------------------------------------------------------------

        previous_compass = [
            x.detach()
            .clone()
            for x in CURRENT_COMPASS
        ]


        (
            NEW_COMPASS,
            NEW_RAW_NORMS,
        ) = extract_student_compass()


        (
            mean_cos_initial,
            mean_cos_previous,
        ) = record_compass(
            update,
            previous_compass,
            NEW_COMPASS,
            NEW_RAW_NORMS,
        )


        CURRENT_COMPASS = [
            x.detach()
            .clone()
            .to(DEVICE)
            for x in NEW_COMPASS
        ]


        CURRENT_RAW_NORMS = list(
            NEW_RAW_NORMS
        )


        elapsed = (
            time.time()
            - TRAINING_START_WALL
        )


        TRAIN_LOG.append(
            {
                "step": int(update),
                "epoch": int(epoch),

                "loss_total": float(
                    total_loss
                    .detach()
                    .cpu()
                    .item()
                ),

                "loss_geometry": float(
                    geo_loss
                    .cpu()
                    .item()
                ),

                "loss_preserve_topk_conditional": float(
                    preserve_loss
                    .cpu()
                    .item()
                ),

                "grad_norm": float(
                    grad_norm_value
                ),

                "mean_compass_cos_initial": float(
                    mean_cos_initial
                ),

                "mean_compass_cos_previous": float(
                    mean_cos_previous
                ),

                "elapsed_seconds": float(
                    elapsed
                ),
            }
        )


        print(
            f"step={update:04d} | "
            f"loss={float(total_loss.detach().cpu()):.7f} | "
            f"geo={float(geo_loss.cpu()):.7f} | "
            f"presK={float(preserve_loss.cpu()):.7f} | "
            f"grad={grad_norm_value:.6f} | "
            f"cos(A0,At)={mean_cos_initial:+.6f} | "
            f"cos(Aprev,At)={mean_cos_previous:+.6f}"
        )


        del target
        del total_loss


        # =================================================================
        # VALIDATION-ONLY CLOSED-LOOP EQUILIBRIUM CHECK
        # =================================================================

        if (
            update % EVAL_EVERY == 0
        ):

            metrics = evaluate_validation_motor_off(
                update
            )


            current_progress = metrics[
                "progress"
            ]

            current_distance = metrics[
                "distance"
            ]

            current_alignment = metrics[
                "alignment"
            ]


            new_best = (
                current_progress
                > BEST_PROGRESS
                and
                current_alignment
                >= ALIGNMENT_FLOOR
            )


            if new_best:

                BEST_PROGRESS = (
                    current_progress
                )

                BEST_DISTANCE = (
                    current_distance
                )

                BEST_ALIGNMENT = (
                    current_alignment
                )

                BEST_STEP = int(
                    update
                )


                save_best_adapter(
                    BEST_STEP
                )


                NO_IMPROVEMENT_COUNT = 0


                print(
                    "\n>>> NEW CRYSTALLIZATION BEST <<<"
                )

                print(
                    "step      :",
                    BEST_STEP
                )

                print(
                    "progress  :",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                print(
                    "distance  :",
                    f"{BEST_DISTANCE:.8f}"
                )

                print(
                    "alignment :",
                    f"{BEST_ALIGNMENT:+.8f}"
                )


            else:

                NO_IMPROVEMENT_COUNT += 1


                print(
                    "\nNo new best."
                )

                print(
                    "patience:",
                    f"{NO_IMPROVEMENT_COUNT}/{PATIENCE_EVALS}"
                )


            overshoot = (
                update
                >= MIN_UPDATES_BEFORE_STOP
                and
                (
                    BEST_PROGRESS
                    - current_progress
                )
                >= OVERSHOOT_PROGRESS_DROP
            )


            if overshoot:

                STOP_REASON = (
                    "OVERSHOOT_DETECTED"
                )


                print(
                    "\n>>> OVERSHOOT DETECTED <<<"
                )

                print(
                    "Best progress   :",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                print(
                    "Current progress:",
                    f"{100*current_progress:+.4f}%"
                )

                break


            if (
                update
                >= MIN_UPDATES_BEFORE_STOP
                and
                NO_IMPROVEMENT_COUNT
                >= PATIENCE_EVALS
            ):

                STOP_REASON = (
                    "VALIDATION_EQUILIBRIUM"
                )


                print(
                    "\n>>> CRYSTALLIZATION EQUILIBRIUM DETECTED <<<"
                )

                print(
                    "BEST STEP:",
                    BEST_STEP
                )

                print(
                    "BEST PROGRESS:",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                break


        if update % 25 == 0:

            gc.collect()
            torch.cuda.empty_cache()


    if STOP_REASON is not None:
        break


if STOP_REASON is None:
