T0_VALIDATION_NP = np.stack(
    [
        np.stack(
            [
                x.numpy()
                for x in sample
            ],
            axis=0,
        )
        for sample in T0_VALIDATION
    ],
    axis=0,
)


BASE_FINAL_TEST_NP = np.stack(
    [
        np.stack(
            [
                x.numpy()
                for x in sample
            ],
            axis=0,
        )
        for sample in BASE_FINAL_TEST
    ],
    axis=0,
)


T0_FINAL_TEST_NP = np.stack(
    [
        np.stack(
            [
                x.numpy()
                for x in sample
            ],
            axis=0,
        )
        for sample in T0_FINAL_TEST
    ],
    axis=0,
)


eval_steps = sorted(
    EVAL_STATES.keys()
)


eval_state_stack = np.stack(
    [
        EVAL_STATES[s]
        for s in eval_steps
    ],
    axis=0,
)


NPZ_PATH = os.path.join(
    OUT_DIR,
    "TEST144_R2_crystallization_geometry.npz",
)


np.savez_compressed(
