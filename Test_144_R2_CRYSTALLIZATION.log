    ):

        for filename in sorted(
            filenames
        ):

            path = os.path.join(
                root,
                filename,
            )

            rel = os.path.relpath(
                path,
                OUT_DIR,
            )


            try:
                size = os.path.getsize(
                    path
                )
            except Exception:
                size = -1


            f.write(
                f"{rel}\t{size} bytes\n"
            )


