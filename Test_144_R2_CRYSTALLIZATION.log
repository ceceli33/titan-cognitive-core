POWER_SAMPLES = []

POWER_TELEMETRY_AVAILABLE = False

POWER_THREAD = None

POWER_STOP_EVENT = threading.Event()


def read_gpu_power_watts():

    try:

        result = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=power.draw",
                "--format=csv,noheader,nounits",
                "-i",
                "0",
            ],
            capture_output=True,
            text=True,
            timeout=3,
        )

        if result.returncode != 0:
            return None

        line = result.stdout.strip().splitlines()[0]

        value = float(line.strip())

        if math.isfinite(value) and value >= 0:
            return value

    except Exception:
        pass

    return None


def power_sampler_worker():

    while not POWER_STOP_EVENT.is_set():

        p = read_gpu_power_watts()

        if p is not None:

            POWER_SAMPLES.append(
                {
                    "wall_time": time.time(),
                    "power_watts": float(p),
                }
            )

        POWER_STOP_EVENT.wait(
            POWER_SAMPLE_INTERVAL
        )


def start_power_sampler():

    global POWER_THREAD
    global POWER_TELEMETRY_AVAILABLE

    test_power = read_gpu_power_watts()

    if test_power is None:

        POWER_TELEMETRY_AVAILABLE = False

        print(
            "\nGPU power telemetry: NOT AVAILABLE"
        )

        return

    POWER_TELEMETRY_AVAILABLE = True

    POWER_SAMPLES.append(
        {
            "wall_time": time.time(),
            "power_watts": float(test_power),
        }
    )

    POWER_STOP_EVENT.clear()

    POWER_THREAD = threading.Thread(
        target=power_sampler_worker,
        daemon=True,
    )

    POWER_THREAD.start()

    print(
        "\nGPU power telemetry: PASS"
    )

    print(
        "Initial GPU board power:",
        f"{test_power:.2f} W"
    )


def stop_power_sampler():

    if POWER_THREAD is not None:

        POWER_STOP_EVENT.set()

        POWER_THREAD.join(
            timeout=5.0
        )


def integrate_energy(samples):

    if len(samples) < 2:

        return {
            "measured": False,
            "samples": len(samples),
            "energy_wh": None,
            "energy_kwh": None,
            "mean_power_w": None,
            "min_power_w": None,
            "max_power_w": None,
            "telemetry_duration_seconds": None,
        }


    ordered = sorted(
        samples,
        key=lambda x: x["wall_time"],
    )


    t = np.asarray(
        [
            x["wall_time"]
            for x in ordered
        ],
        dtype=np.float64,
    )


    p = np.asarray(
        [
            x["power_watts"]
            for x in ordered
        ],
        dtype=np.float64,
    )


    duration = float(
        t[-1] - t[0]
    )


    if duration <= 0:

        return {
            "measured": False,
            "samples": len(samples),
            "energy_wh": None,
            "energy_kwh": None,
            "mean_power_w": None,
            "min_power_w": None,
            "max_power_w": None,
            "telemetry_duration_seconds": duration,
        }


    energy_joules = float(
        np.trapezoid(
            p,
            t,
        )
    )


    energy_wh = (
        energy_joules
        / 3600.0
    )


    time_weighted_mean_power = (
        energy_joules
        / duration
    )


    return {
        "measured": True,
        "samples": int(len(samples)),
        "energy_wh": float(energy_wh),
        "energy_kwh": float(
            energy_wh / 1000.0
        ),
        "mean_power_w": float(
            time_weighted_mean_power
        ),
        "min_power_w": float(
            np.min(p)
        ),
        "max_power_w": float(
            np.max(p)
        ),
        "telemetry_duration_seconds": duration,
    }


