def resolve_layers():

    candidates = [
        lambda: (
            student
            .base_model
            .model
            .model
            .layers
        ),

        lambda: (
            student
            .base_model
            .model
            .model
            .model
            .layers
        ),

        lambda: (
            student
            .model
            .model
            .layers
        ),
    ]


    for getter in candidates:

        try:

            layers = getter()

            if len(layers) >= N_LAYERS:
                return layers

        except Exception:
            pass


    raise RuntimeError(
        "Student decoder layers unresolved."
    )


STUDENT_LAYERS = resolve_layers()


