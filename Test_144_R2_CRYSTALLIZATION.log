# =============================================================================
# 35. VALIDATION MOTOR-OFF EVALUATION
# =============================================================================

def evaluate_validation_motor_off(step):

    print(
        "\n" + "=" * 160
    )

    print(
        f"CRYSTALLIZATION X-RAY @ STEP {step}"
    )

    print(
        "VALIDATION | SEASC OFF | MOTOR OFF | NO INJECTION"
    )

    print(
        "=" * 160
    )


    states_all = []


    distance = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    progress = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    alignment = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    correction_ratio = np.zeros(
        N_LAYERS,
        dtype=np.float64,
    )


    for i, prompt in enumerate(
        VALIDATION_PROMPTS
    ):

        current = capture_student_off(
            prompt
        )


        current_np = np.stack(
            [
                x.numpy()
                for x in current
            ],
            axis=0,
        )


        states_all.append(
            current_np
        )


        for L in range(N_LAYERS):

            B = BASE_VALIDATION[
                i
            ][L].numpy()


            T = T0_VALIDATION[
                i
            ][L].numpy()


            S = current_np[L]


            target_vector = T - B

            learned_vector = S - B


            D0 = max(
                np.linalg.norm(
                    B - T
                ),
                1e-12,
            )


            D = np.linalg.norm(
                S - T
            )


            distance[L] += D

            progress[L] += (
                1.0 - D / D0
            )


            alignment[L] += safe_cos(
                learned_vector,
                target_vector,
            )


            correction_ratio[L] += (
                D / D0
            )


    distance /= N_VALIDATION
    progress /= N_VALIDATION
    alignment /= N_VALIDATION
    correction_ratio /= N_VALIDATION


    states_all = np.stack(
        states_all,
        axis=0,
    )


    EVAL_STATES[
        int(step)
    ] = states_all


    mean_distance = float(
        distance.mean()
    )


    mean_progress = float(
        progress.mean()
    )


    mean_alignment = float(
        alignment.mean()
    )


    mean_correction = float(
        correction_ratio.mean()
    )


    print(
        "Mean target distance :",
        f"{mean_distance:.8f}"
    )

    print(
        "Mean target progress :",
        f"{100*mean_progress:+.4f}%"
    )

    print(
        "Mean alignment       :",
        f"{mean_alignment:+.8f}"
    )

    print(
        "Required correction  :",
        f"{100*mean_correction:.4f}% of original dose-distance"
    )


    for L in range(N_LAYERS):

        print(
            f"L{L:02d} | "
            f"D={distance[L]:.6f} | "
            f"P={100*progress[L]:+.3f}% | "
            f"C={alignment[L]:+.6f} | "
            f"R={100*correction_ratio[L]:.3f}%"
        )


        LAYER_EVAL_LOG.append(
            {
                "step": int(step),
                "layer": int(L),
                "distance": float(
                    distance[L]
                ),
                "progress": float(
                    progress[L]
                ),
                "alignment": float(
                    alignment[L]
                ),
                "required_correction_ratio": float(
                    correction_ratio[L]
                ),
            }
        )


    EVAL_LOG.append(
        {
            "step": int(step),
            "mean_distance": mean_distance,
            "mean_progress": mean_progress,
            "mean_alignment": mean_alignment,
            "mean_required_correction_ratio": mean_correction,
        }
    )


    return {
        "distance": mean_distance,
        "progress": mean_progress,
        "alignment": mean_alignment,
        "required_correction": mean_correction,
        "layer_distance": distance,
        "layer_progress": progress,
        "layer_alignment": alignment,
        "states": states_all,
    }


# =============================================================================
# 36. COMPASS LOG
# =============================================================================

def record_compass(
    step,
    previous_compass,
    current_compass,
    raw_norms,
):

    cos_initial = []

    cos_previous = []


    for L in range(N_LAYERS):

        A0 = (
            INITIAL_COMPASS[L]
            .detach()
            .float()
            .cpu()
            .numpy()
        )


        At = (
            current_compass[L]
            .detach()
            .float()
            .cpu()
            .numpy()
        )


        Ap = (
            previous_compass[L]
            .detach()
            .float()
            .cpu()
            .numpy()
        )


        c0 = safe_cos(
            A0,
            At,
        )


        cp = safe_cos(
            Ap,
            At,
        )


        cos_initial.append(c0)
        cos_previous.append(cp)


        COMPASS_LOG.append(
            {
                "step": int(step),
                "layer": int(L),
                "raw_norm": float(
                    raw_norms[L]
                ),
                "cos_initial": float(c0),
                "cos_previous": float(cp),
            }
        )


    return (
        float(np.mean(cos_initial)),
        float(np.mean(cos_previous)),
    )


