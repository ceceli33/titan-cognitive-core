def encode_chat(prompt):

    messages = [
        {
            "role": "system",
            "content": SYSTEM_PROMPT,
        },
        {
            "role": "user",
            "content": prompt,
        },
    ]


    text = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
    )


    enc = tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        max_length=MAX_TRAIN_TOKENS,
    )


    return {
        k: v.to(DEVICE)
        for k, v in enc.items()
    }


