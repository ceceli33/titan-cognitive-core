# =============================================================================
# 13. SEASC ACTUATOR — UNCHANGED
# =============================================================================

def seasc_tensor(
    hidden,
    compass_vector,
    rho,
):

    norm0 = (
        hidden.float()
        .norm(
            p=2,
            dim=-1,
            keepdim=True,
        )
    )


    A = compass_vector.to(
        hidden.device,
        dtype=torch.float32,
    )


    delta = (
        float(rho)
        * norm0
        * A.view(1, 1, -1)
    )


    return (
        hidden.float()
        + delta
    ).to(hidden.dtype)


# =============================================================================
# 14. NATURAL CAPTURE
# =============================================================================

@torch.inference_mode()
def capture_natural(
    model,
    prompt,
):

    was_training = model.training

    model.eval()


    enc = encode_chat(prompt)


    out = model(
        **enc,
        output_hidden_states=True,
        use_cache=False,
        return_dict=True,
    )


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    states = [
        out.hidden_states[
            L + 1
        ][0, pos, :]
        .detach()
        .float()
        .cpu()
        .clone()

        for L in range(N_LAYERS)
    ]


    del out
    del enc


    if was_training:
        model.train()


    return states


# =============================================================================
# 15. GENERIC SEASC CAPTURE
# =============================================================================

@torch.inference_mode()
def capture_seasc(
    model,
    decoder_layers,
    prompt,
    compass,
):

    was_training = model.training

    model.eval()


    enc = encode_chat(prompt)


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    captured = [None] * N_LAYERS

    handles = []


    def make_hook(L):

        def hook(module, args, output):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            steered = seasc_tensor(
                hidden,
                compass[L],
                RELATIVE_DOSE[L],
            )


            captured[L] = (
                steered[0, pos, :]
                .detach()
                .float()
                .cpu()
                .clone()
            )


            if isinstance(output, tuple):
                return (steered,) + output[1:]

            return steered

        return hook


    for L in range(N_LAYERS):

        handles.append(
            decoder_layers[L]
            .register_forward_hook(
                make_hook(L)
            )
        )


    try:

        _ = model(
            **enc,
            use_cache=False,
            return_dict=True,
        )

    finally:

        for h in handles:
            h.remove()


    if was_training:
        model.train()


    del enc


    if any(x is None for x in captured):
        raise RuntimeError(
            "SEASC capture incomplete."
        )


    return captured


# =============================================================================
# 16. GENERATION
# =============================================================================

@torch.inference_mode()
def generate_response(
    model,
    prompt,
):

    was_training = model.training

    model.eval()


    enc = encode_chat(prompt)


    prompt_len = int(
        enc["input_ids"].shape[1]
    )


    context_limit = int(
        getattr(
            model.config,
            "max_position_embeddings",
            32768,
        )
    )


    ceiling = max(
        1,
        context_limit
        - prompt_len
        - 1,
    )


    ids = model.generate(
        **enc,
        max_new_tokens=ceiling,
        do_sample=False,
        repetition_penalty=REPETITION_PENALTY,
        use_cache=True,
        pad_token_id=tokenizer.pad_token_id,
        eos_token_id=tokenizer.eos_token_id,
    )


    generated = ids[
        0,
        prompt_len:
    ]


    text = tokenizer.decode(
        generated,
        skip_special_tokens=True,
    ).strip()


    if was_training:
        model.train()


    return text


