@torch.inference_mode()
def capture_best_off(prompt):

    student.eval()


    enc = encode_chat(prompt)


    out = student(
        **enc,
        output_hidden_states=True,
        use_cache=False,
        return_dict=True,
    )


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    states = [
        out.hidden_states[
            L + 1
        ][0, pos, :]
        .detach()
        .float()
        .cpu()
        .clone()

        for L in range(N_LAYERS)
    ]


    del out
    del enc


    return states


