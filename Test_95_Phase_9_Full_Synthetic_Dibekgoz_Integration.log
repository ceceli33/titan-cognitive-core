# =============================================================================
# TEST 95 — AŞAMA 3.6/6: TÜR-BENZERİ Mİ? (birini-dışarıda-bırak doğrulaması)
# =============================================================================
# AŞAMA 3v2 SONUCU: K1 ✅ (temiz aile sınırı), K2 ✅, K3 ❌ (yayılım 0.490)
#
# AMA K3'ÜN EŞİĞİ (0.35) UYDURMAYDI. Referansı yoktu.
# Doğru soru: GERÇEK türler birbirine ne kadar dengeli duruyor? Eğer şempanze
# ile insan modelin uzayında zaten çok farklıysa, yayılım 0.49 normal olabilir.
#
# BU AŞAMANIN YÖNTEMİ — BİRİNİ DIŞARIDA BIRAK (leave-one-out):
#   Her gerçek türü sırayla "yeni tür"müş gibi ele al, profilini çıkar:
#     • aile marjı  = en düşük akraba benzerliği - en yüksek dış grup benzerliği
#     • yayılım     = akrabalar arası max - min
#     • max benzerlik = en yakın akrabaya ne kadar yapışık
#   Sonra Dibekgoz'un profili bu GERÇEK dağılıma düşüyor mu, bak.
#   Düşüyorsa Dibekgoz "makul bir tür"dür -- uydurma eşiğe göre değil,
#   gerçeğe göre.
#
# AYRICA: BETA_SEAT taraması. Boş koltuğun ağırlığı arttıkça Dibekgoz tüm
# türlerden uzaklaşır (yayılım düşer) ama aile aidiyeti de zayıflar. En
# tür-benzeri dengeyi ARIYORUZ, tahmin etmiyoruz.
#
# HÂLÂ ENJEKSİYON YOK. Kendi kendine yeter.
# ÇIKTI: dibekgoz_pusula_asama3v3.pt
# =============================================================================

import os, json, math, time
import torch
import torch.nn.functional as F
from transformers import AutoModelForCausalLM, AutoTokenizer

os.environ["TOKENIZERS_PARALLELISM"] = "false"
torch.backends.cudnn.deterministic = True

MODEL_ID = "Qwen/Qwen2.5-7B-Instruct"
OUT_PT   = "/content/dibekgoz_pusula_asama3v3.pt"
OUT_JSON = "/content/dibekgoz_asama3v3_rapor.json"

WINDOW     = list(range(10, 21))
SEED       = 42
SUBSPACE_K = 4
N_SEAT     = 300000
ANATOMY    = {"bipedal": 0.35, "kuyruk": 0.25, "eller": 0.25}
GAMMA_ANAT = 0.30
BETA_GRID  = [0.0, 0.25, 0.40, 0.55, 0.70, 0.85, 1.00, 1.25, 1.50]

print(f"torch: {torch.__version__}  |  CUDA: {torch.version.cuda}")
if not torch.cuda.is_available(): raise SystemExit("❌ GPU yok.")
print(f"✅ GPU: {torch.cuda.get_device_name(0)}\n")

# ==== KONTRASTİF PROMPTLAR (Aşama 1-2 ile aynı) ====
