# =============================================================================
# SONDALAMA
# =============================================================================
print("Model yükleniyor...")
tok = AutoTokenizer.from_pretrained(MODEL_ID)
if tok.pad_token is None: tok.pad_token = tok.eos_token
model = AutoModelForCausalLM.from_pretrained(
    MODEL_ID, device_map="auto", trust_remote_code=True,
    low_cpu_mem_usage=True, dtype=torch.bfloat16, attn_implementation="sdpa")
model.eval()
device = next(model.parameters()).device
HIDDEN = model.config.hidden_size
print(f"✅ Model hazır ({HIDDEN} boyut)\n")

_cap = {}
def _mk(li):
    def h(m, i, o):
        x = o[0] if isinstance(o, tuple) else o
        _cap[li] = x.detach().to(torch.float32).cpu()
    return h
_hs = [model.model.layers[li].register_forward_hook(_mk(li)) for li in WINDOW]

@torch.no_grad()
def probe(t):
    _cap.clear()
    enc = tok(t, return_tensors="pt").to(device)
    model(**enc)
    return {li: _cap[li][0][-1].clone() for li in WINDOW}

SPECIES = {
    "goril":     "A gorilla, a species of great ape native to the forests of central Africa.",
    "sempanze":  "A chimpanzee, a species of great ape native to the forests of equatorial Africa.",
    "orangutan": "An orangutan, a species of great ape native to the rainforests of Borneo and Sumatra.",
    "bonobo":    "A bonobo, a species of great ape native to the forests of the Congo basin.",
    "gibon":     "A gibbon, a species of lesser ape native to the tropical forests of Southeast Asia.",
    "insan":     "A human, a species of great ape native to every continent on Earth.",
}
OUTGROUP = {
    "kuyruklu_maymun": "A spider monkey, a species of monkey with a long prehensile tail.",
    "kopek":           "A dog, a four-legged domesticated mammal with paws and a wagging tail.",
    "ayi":             "A bear, a large furry quadruped mammal with heavy paws.",
    "kertenkele":      "A lizard, a scaly cold-blooded reptile with four short legs and a tail.",
    "kaya":            "A rock, a lifeless lump of grey mineral stone.",
    "robot":           "An industrial robot, a metal machine with hydraulic arms.",
}

AXIS_USE  = ["biyolojik", "primat", "bipedal_yeni", "eller", "kuyruk"]
AXIS_NAME = {"bipedal_yeni": "bipedal"}
AXIS_ORDER = [AXIS_NAME.get(a, a) for a in AXIS_USE]
FLIP = {"kuyruk": -1.0}

t0 = time.time()
raw_axis = {}
for ax in AXIS_USE:
    d = AXES[ax]
    pos = [probe(s) for s in d["pozitif"]]
    neg = [probe(s) for s in d["negatif"]]
    raw_axis[AXIS_NAME.get(ax, ax)] = {
        li: torch.stack([p[li] for p in pos]).mean(0)
           - torch.stack([n[li] for n in neg]).mean(0) for li in WINDOW}
sp_h  = {n: probe(t) for n, t in SPECIES.items()}
out_h = {n: probe(t) for n, t in OUTGROUP.items()}
for h in _hs: h.remove()
print(f"✅ Sondalama tamamlandı ({time.time()-t0:.1f} sn)\n")

def gram_schmidt(vs):
    basis, ret = [], []
    for v in vs:
        w = v.clone()
        for b in basis: w = w - (w @ b) * b
        n = w.norm()
        ret.append(float(n/(v.norm()+1e-9)))
        basis.append(w/(n+1e-9))
    return basis, ret

ortho = {}
for li in WINDOW:
    vs = [F.normalize(raw_axis[a][li]*FLIP.get(a,1.0), dim=0) for a in AXIS_ORDER]
    b, _ = gram_schmidt(vs)
    ortho[li] = {a: b[i] for i, a in enumerate(AXIS_ORDER)}

ALL = {**sp_h, **out_h}
mean_h = {li: torch.stack([ALL[n][li] for n in ALL]).mean(0) for li in WINDOW}
sp_c  = {n: {li: sp_h[n][li]-mean_h[li]  for li in WINDOW} for n in SPECIES}
out_c = {n: {li: out_h[n][li]-mean_h[li] for li in WINDOW} for n in OUTGROUP}

# =============================================================================
# ADIM 1: BİRİNİ DIŞARIDA BIRAK — gerçek türler nasıl duruyor?
# =============================================================================
def cos_mean(vec_by_layer, ref_c):
    return sum(float(F.cosine_similarity(vec_by_layer[li].unsqueeze(0),
                                          ref_c[li].unsqueeze(0)))
               for li in WINDOW) / len(WINDOW)

def profile(scores_family, scores_out):
    """Bir adayın 'tür profili': aile marjı, yayılım, en yüksek benzerlik."""
    fmin, fmax = min(scores_family.values()), max(scores_family.values())
    omax = max(scores_out.values())
    return {"aile_marji": fmin - omax, "yayilim": fmax - fmin, "max_benzerlik": fmax}

print(f"{'='*78}\n  ADIM 1: GERÇEK TÜRLERİN PROFİLLERİ (birini dışarıda bırak)\n{'='*78}")
print("  Her gerçek tür sırayla 'yeni tür' gibi ele alınıp, kalan aileye ve")
print("  dış gruba olan benzerlik profili çıkarılıyor. Dibekgoz'u BUNA göre")
print("  değerlendireceğiz -- uydurma bir eşiğe göre değil.\n")

real_profiles = {}
for X in SPECIES:
    others = {n: cos_mean(sp_c[X], sp_c[n]) for n in SPECIES if n != X}
    outs   = {n: cos_mean(sp_c[X], out_c[n]) for n in OUTGROUP}
    real_profiles[X] = profile(others, outs)

print(f"    {'tür':<14}{'aile marjı':>13}{'yayılım':>11}{'max benz.':>12}")
print("    " + "-"*50)
for X, p in real_profiles.items():
    print(f"    {X:<14}{p['aile_marji']:>+13.3f}{p['yayilim']:>11.3f}{p['max_benzerlik']:>+12.3f}")

def rng_of(key):
    v = [p[key] for p in real_profiles.values()]
    return min(v), max(v), sum(v)/len(v)

r_marj, r_yay, r_max = rng_of("aile_marji"), rng_of("yayilim"), rng_of("max_benzerlik")
print(f"\n  GERÇEK TÜR ARALIKLARI (Dibekgoz'un hedefi bu aralıklar):")
print(f"    aile marjı    : {r_marj[0]:+.3f} .. {r_marj[1]:+.3f}  (ort {r_marj[2]:+.3f})")
print(f"    yayılım       : {r_yay[0]:.3f} .. {r_yay[1]:.3f}  (ort {r_yay[2]:.3f})")
print(f"    max benzerlik : {r_max[0]:+.3f} .. {r_max[1]:+.3f}  (ort {r_max[2]:+.3f})")
print(f"\n  → Aşama 3v2'de K3 eşiğini 0.35 seçmiştim. Gerçek türlerin yayılımı")
print(f"    {r_yay[0]:.3f}-{r_yay[1]:.3f} aralığında. Eşik {'DOĞRUYMUŞ' if r_yay[1] < 0.35 else 'YANLIŞMIŞ -- gerçek türler de bu kadar dengesiz'}.\n")

# =============================================================================
# ADIM 2: BETA TARAMASI — en tür-benzeri Dibekgoz hangisi?
# =============================================================================
g0 = torch.Generator().manual_seed(SEED)
family_dir, seat_dir = {}, {}
for li in WINDOW:
    S = torch.stack([F.normalize(sp_c[n][li], dim=0) for n in SPECIES])
    cen = F.normalize(S.mean(0), dim=0)
    family_dir[li] = cen
    dev = S - (S @ cen).unsqueeze(1) * cen.unsqueeze(0)
    _, _, Vh = torch.linalg.svd(dev, full_matrices=False)
    B = Vh[:min(SUBSPACE_K, Vh.shape[0])]
    coords = dev @ B.T
    coords = coords / (coords.norm(dim=1, keepdim=True) + 1e-9)
    gg = torch.Generator().manual_seed(SEED + li)
    C = torch.randn(N_SEAT, B.shape[0], generator=gg)
    C = C / C.norm(dim=1, keepdim=True)
    worst = (C @ coords.T).abs().max(dim=1).values
    seat_dir[li] = F.normalize(C[int(worst.argmin())] @ B, dim=0)

def build_core(beta, gamma=GAMMA_ANAT):
    c = {}
    for li in WINDOW:
        anat = torch.zeros(HIDDEN)
        for a, w in ANATOMY.items():
            anat = anat + w * ortho[li][a]
        anat = F.normalize(anat, dim=0)
        c[li] = F.normalize(family_dir[li] + beta*seat_dir[li] + gamma*anat, dim=0)
    return c

def eval_core(c):
    fam = {n: cos_mean(c, sp_c[n])  for n in SPECIES}
    out = {n: cos_mean(c, out_c[n]) for n in OUTGROUP}
    return profile(fam, out), fam, out

def in_range(val, lo, hi, tol=0.0):
    return (lo - tol) <= val <= (hi + tol)

print(f"{'='*78}\n  ADIM 2: BETA_SEAT TARAMASI\n{'='*78}")
print("  Boş koltuk ağırlığı arttıkça Dibekgoz tüm türlerden uzaklaşır.")
print("  Hedef: profili GERÇEK türlerin aralığına düşen beta.\n")
print(f"    {'beta':<8}{'aile marjı':>13}{'yayılım':>11}{'max benz.':>12}   {'tür-benzeri?':>14}")
print("    " + "-"*62)

sweep = {}
best = None
for beta in BETA_GRID:
    c = build_core(beta)
    p, fam, out = eval_core(c)
    ok_m = in_range(p["aile_marji"], r_marj[0], r_marj[1], 0.02)
    ok_y = in_range(p["yayilim"], r_yay[0], r_yay[1], 0.02)
    ok_x = in_range(p["max_benzerlik"], r_max[0], r_max[1], 0.02)
    n_ok = sum([ok_m, ok_y, ok_x])
    sweep[beta] = {"profil": p, "n_ok": n_ok, "aile": fam, "dis": out}
    flag = "✅"*n_ok + "·"*(3-n_ok)
    print(f"    {beta:<8.2f}{p['aile_marji']:>+13.3f}{p['yayilim']:>11.3f}"
          f"{p['max_benzerlik']:>+12.3f}   {flag:>14}")
    # skor: kaç kriter tuttu, eşitse aile marjı yüksek olan
    key = (n_ok, p["aile_marji"])
    if best is None or key > best[0]:
        best = (key, beta, p, fam, out)

_, BEST_BETA, bp, bfam, bout = best
print(f"\n  → EN İYİ: beta={BEST_BETA:.2f}  ({bp and sweep[BEST_BETA]['n_ok']}/3 kriter gerçek aralıkta)")
print(f"    aile marjı={bp['aile_marji']:+.3f}  yayılım={bp['yayilim']:.3f}  "
      f"max benz.={bp['max_benzerlik']:+.3f}\n")
# =============================================================================
# ADIM 3: SEÇİLEN ÇEKİRDEĞİN TAM PROFİLİ
# =============================================================================
core = build_core(BEST_BETA)
print(f"{'='*78}\n  ADIM 3: SEÇİLEN DİBEKGOZ (beta={BEST_BETA:.2f})\n{'='*78}")
print("  MAYMUNGİLLER:")
for n, s in sorted(bfam.items(), key=lambda kv: -kv[1]):
    print(f"    {n:<18} {s:+.3f}")
print("\n  DIŞ GRUP:")
for n, s in sorted(bout.items(), key=lambda kv: -kv[1]):
    print(f"    {n:<18} {s:+.3f}")

print(f"\n  --- GERÇEK TÜRLERLE KIYAS ---")
print(f"    {'':<14}{'aile marjı':>13}{'yayılım':>11}{'max benz.':>12}")
print("    " + "-"*50)
for X, p in real_profiles.items():
    print(f"    {X:<14}{p['aile_marji']:>+13.3f}{p['yayilim']:>11.3f}{p['max_benzerlik']:>+12.3f}")
print("    " + "-"*50)
print(f"    {'DİBEKGOZ':<14}{bp['aile_marji']:>+13.3f}{bp['yayilim']:>11.3f}"
      f"{bp['max_benzerlik']:>+12.3f}   <<<")

n_ok = sweep[BEST_BETA]["n_ok"]
print(f"\n  SONUÇ: Dibekgoz'un profili gerçek türlerin aralığında {n_ok}/3 ölçüde.")
if n_ok == 3:
    print("  → Dibekgoz istatistiksel olarak 'makul bir tür' gibi duruyor.")
    print("    Aşama 4'e (enjeksiyon) geçilebilir.")
elif n_ok == 2:
    print("  → Büyük ölçüde tür-benzeri. Aşama 4'e geçilebilir.")
else:
    print("  → ⚠️ Profil gerçek türlerden sapıyor. GAMMA_ANAT de taranmalı.")
print()

payload = {
    "model_id": MODEL_ID, "hidden_size": HIDDEN, "window": WINDOW,
    "axis_order": AXIS_ORDER, "flip": FLIP, "method": "bos_koltuk_v3_LOO",
    "ortho_axes": {li: {a: ortho[li][a] for a in AXIS_ORDER} for li in WINDOW},
    "family_dir": family_dir, "seat_dir": seat_dir,
    "dibekgoz_core": core,
    "params": {"BETA_SEAT": BEST_BETA, "GAMMA_ANAT": GAMMA_ANAT,
               "ANATOMY": ANATOMY, "SUBSPACE_K": SUBSPACE_K, "SEED": SEED},
    "real_species_profiles": real_profiles,
    "real_ranges": {"aile_marji": r_marj, "yayilim": r_yay, "max_benzerlik": r_max},
    "beta_sweep": {str(b): {"profil": v["profil"], "n_ok": v["n_ok"]}
                   for b, v in sweep.items()},
    "dibekgoz_profile": bp, "species_scores": bfam, "outgroup_scores": bout,
    "criteria_in_real_range": n_ok,
    "species_prompts": SPECIES, "outgroup_prompts": OUTGROUP,
    "note": ("AŞAMA 3.6: Dibekgoz, uydurma eşiklerle değil, GERÇEK türlerin "
             "birini-dışarıda-bırak profilleriyle kıyaslanarak doğrulandı. "
             "BETA_SEAT tarandı, en tür-benzeri değer seçildi. ENJEKSİYON YOK."),
}
torch.save(payload, OUT_PT)
jr = {k: v for k, v in payload.items()
      if k not in ("ortho_axes","family_dir","seat_dir","dibekgoz_core")}
