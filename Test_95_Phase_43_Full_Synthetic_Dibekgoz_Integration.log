TABAN_ZOO_KELIME=[kelime(x) for x in TABAN_ZOO_METIN]
FIL_METIN=[uret(CTX_ZOO,q,pu=P_FIL[0],hd=P_FIL[1],ivmeler=[0.15]) for q in SOR_ZOO]
olc_fil=[olc(FIL_METIN[i],TABAN_ZOO_KELIME[i]) for i in range(len(SOR_ZOO))]
ozet_fil=ozet(olc_fil)
R_(f"    fil_ham={ozet_fil['fil_ham']:.2f}  (yoğun={ozet_fil['fil_yogun']:.2f}, referans amaçlı)")
