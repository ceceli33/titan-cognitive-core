# =============================================================================
R_("="*78); R_(f"  3) ÜRETİM DEĞERİ i={IVME_URETIM:.2f} — ESKİ vs YENİ sözlükle NET karşılaştırması")
R_("="*78)
t0=time.time()
BIR_METIN=[uret(CTX_BRIDGE,q,pu=P_BIR[0],hd=P_BIR[1],ivmeler=[IVME_URETIM]) for q in P_TETIK]
