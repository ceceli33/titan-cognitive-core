# =============================================================================
# 18. REAL BLOCK TRANSPORT
# =============================================================================
#
# Important:
#
# We run the actual model.model.layers[10].
#
# baseline:
#
#     y0 = F(h)
#
# perturbed:
#
#     y1 = F(h + epsilon*z at final real token)
#
# response:
#
#     r = y1 - y0
#
# The block receives the same sequence context.
#
# =============================================================================

@torch.inference_mode()
def real_block_response(
    carrier,
    z,
):

    block = model.model.layers[
        BLOCK_INDEX
    ]


    h0 = (
        carrier["hidden"]
        .detach()
        .clone()
    )


    attention_mask = (
        carrier[
            "attention_mask"
        ]
        .detach()
        .clone()
    )


    length = carrier[
        "length"
    ]


    token_index = (
        length - 1
    )


    h_token = (
        h0[
            0,
            token_index,
        ]
        .float()
    )


    h_norm = torch.linalg.vector_norm(
        h_token
    )


    z_device = (
        unit(z)
        .to(
            device=h0.device,
            dtype=torch.float32,
        )
    )


    requested_norm = (
        float(
            h_norm.item()
        )
        *
        PROBE_REL
    )


    delta_fp32 = (
        requested_norm
        *
        z_device
    )


    h1 = (
        h0.clone()
    )


    # Actuator is BF16 because production model is BF16.
    h1[
        0,
        token_index,
    ] = (
        h1[
            0,
            token_index,
        ]
        +
        delta_fp32.to(
            dtype=h1.dtype
        )
    )


    # Measure ACTUAL BF16 perturbation after quantization.
    actual_delta = (
        h1[
            0,
            token_index,
        ].float()
        -
        h0[
            0,
            token_index,
        ].float()
    )


    actual_rel = float(
        torch.linalg.vector_norm(
            actual_delta
        ).item()
        /
        (
            float(
                h_norm.item()
            )
            +
            EPS
        )
    )


    actuator_cos = cosine(
        actual_delta.cpu(),
        z,
    )


    # ---------------------------------------------------------
    # Qwen block invocation compatibility
    # ---------------------------------------------------------
    #
    # Recent transformers versions accept position_embeddings.
    # Instead of manually reconstructing the entire forward
    # argument set, we obtain the block output through a full
    # model forward while replacing ONLY this block's input.
    #
    # This guarantees:
    #   - correct rotary embeddings
    #   - correct attention mask
    #   - correct position_ids
    #   - correct cache_position
    #
    # and avoids version-specific direct-layer call errors.
    #
    # ---------------------------------------------------------

    baseline_out = {
        "token": None
    }


    perturbed_out = {
        "token": None
    }


    # ---------------------------------------------------------
    # BASELINE
    # ---------------------------------------------------------

    def baseline_hook(
        module,
        inp,
        out,
    ):

        y = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        baseline_out["token"] = (
            y[
                0,
                token_index,
            ]
            .detach()
            .float()
            .cpu()
        )


    hb = (
        block.register_forward_hook(
            baseline_hook
        )
    )


    try:

        # Re-run carrier text via stored token state is not enough
        # for full model, therefore the original carrier input
        # sequence is reconstructed below by using the hidden
        # replacement hook on the block.
        pass

    finally:

        hb.remove()


    # ---------------------------------------------------------
    # DIRECT BLOCK CALL IS SAFEST AFTER CAPTURING ALL KWARGS.
    # We therefore use a helper below which captures the exact
    # args/kwargs from a natural model pass.
    # ---------------------------------------------------------

    raise RuntimeError(
        "INTERNAL_PLACEHOLDER_SHOULD_NEVER_EXECUTE"
    )


# =============================================================================
# 19. EXACT BLOCK-CALL CONTEXT CAPTURE
# =============================================================================
#
# Capture:
#
#   args
#   kwargs
#   block input
#
# from the model's own natural invocation.
#
# Then the same kwargs are reused for baseline and perturbation.
#
# =============================================================================

@torch.inference_mode()
def capture_exact_block_context(
    text
):

    enc = tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        max_length=128,
    )


    ids = (
        enc["input_ids"]
        .to(device)
    )


    mask = (
        enc["attention_mask"]
        .to(device)
    )


    captured = {

        "args":
            None,

        "kwargs":
            None,

        "hidden":
            None,

        "length":
            int(
                mask.sum().item()
            ),
    }


    def hook(
        module,
        args,
        kwargs,
    ):

        captured["args"] = args

        captured["kwargs"] = kwargs

        if len(args) > 0:

            captured["hidden"] = (
                args[0]
                .detach()
                .clone()
            )

        elif "hidden_states" in kwargs:

            captured["hidden"] = (
                kwargs[
                    "hidden_states"
                ]
                .detach()
                .clone()
            )

        else:

            raise RuntimeError(
                "No hidden_states found."
            )


    handle = (
        model.model.layers[
            BLOCK_INDEX
        ].register_forward_pre_hook(
            hook,
            with_kwargs=True,
        )
    )


    try:

        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False,
        )

    finally:

        handle.remove()


    if captured["hidden"] is None:

        raise RuntimeError(
            "Exact block context capture failed."
        )


    # We cannot retain computational graph.
    # Tensor kwargs are detached.

    clean_kwargs = {}


    for k, v in (
        captured["kwargs"].items()
    ):

        if torch.is_tensor(v):

            clean_kwargs[k] = (
                v.detach()
                .clone()
            )

        elif isinstance(
            v,
            tuple,
        ):

            clean_kwargs[k] = v

        else:

            clean_kwargs[k] = v


    return {

        "hidden":
            captured["hidden"],

        "kwargs":
            clean_kwargs,

        "length":
            captured["length"],
    }


