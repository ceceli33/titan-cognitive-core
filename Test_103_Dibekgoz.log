# =============================================================================
# 14. ENDOGENOUS CONSENSUS
# =============================================================================

def endogenous_consensus(
    D
):

    D = (
        D.detach()
        .float()
    )


    G = (
        D
        @
        D.T
    )


    evals, evecs = (
        torch.linalg.eigh(
            G
        )
    )


    idx = int(
        torch.argmax(
            evals
        ).item()
    )


    coeff = (
        evecs[
            :, idx
        ]
        .float()
    )


    mean_flow = (
        D.mean(
            dim=0
        )
    )


    candidate = (
        coeff[:, None]
        *
        D
    ).sum(
        dim=0
    )


    if float(
        torch.dot(
            candidate,
            mean_flow
        ).item()
    ) < 0:

        candidate = -candidate
        coeff = -coeff


    direction = unit(
        candidate
    )


    positive_evals = torch.clamp(
        evals,
        min=0,
    )


    spectral_fraction = float(
        evals[idx].item()
        /
        (
            positive_evals.sum().item()
            +
            EPS
        )
    )


    support = (
        D
        @
        direction
    )


    if D.shape[0] > 1:

        mask = ~torch.eye(
            D.shape[0],
            dtype=torch.bool,
        )


        coherence = float(
            G[
                mask
            ].mean().item()
        )

    else:

        coherence = float(
            "nan"
        )


    return {

        "direction":
            direction,

        "coherence":
            coherence,

        "spectral_fraction":
            spectral_fraction,

        "support_positive_fraction":
            float(
                (
                    support > 0
                )
                .float()
                .mean()
                .item()
            ),
    }


print(
    "\n[5/12] Endogenous consensus..."
)


