def fingerprint_at_layer(li):

    va = unit(
        xa[:, li].mean(dim=0)
        -
        xn[:, li].mean(dim=0)
    )


    vb = unit(
        xb[:, li].mean(dim=0)
        -
        xn[:, li].mean(dim=0)
    )


    return cosine(
        va,
        vb,
    )


