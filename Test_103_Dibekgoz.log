# =============================================================================
# 20. REAL BLOCK RESPONSE — FINAL IMPLEMENTATION
# =============================================================================

@torch.inference_mode()
def real_block_response(
    context,
    z,
):

    block = model.model.layers[
        BLOCK_INDEX
    ]


    h0 = (
        context["hidden"]
        .detach()
        .clone()
    )


    kwargs = (
        context["kwargs"]
    )


    length = (
        context["length"]
    )


    token_index = (
        length - 1
    )


    h_token_fp32 = (
        h0[
            0,
            token_index,
        ]
        .float()
    )


    base_norm = float(
        torch.linalg.vector_norm(
            h_token_fp32
        ).item()
    )


    z_cpu = unit(
        z
    )


    z_device = (
        z_cpu
        .to(
            device=h0.device,
            dtype=torch.float32,
        )
    )


    requested_norm = (
        PROBE_REL
        *
        base_norm
    )


    requested_delta = (
        requested_norm
        *
        z_device
    )


    h1 = (
        h0.clone()
    )


    h1[
        0,
        token_index,
    ] = (
        h1[
            0,
            token_index,
        ]
        +
        requested_delta.to(
            dtype=h1.dtype
        )
    )


    actual_delta = (
        h1[
            0,
            token_index,
        ].float()
        -
        h0[
            0,
            token_index,
        ].float()
    )


    actual_norm = float(
        torch.linalg.vector_norm(
            actual_delta
        ).item()
    )


    actual_rel = (
        actual_norm
        /
        (
            base_norm
            +
            EPS
        )
    )


    actuator_cos = cosine(
        actual_delta.cpu(),
        z_cpu,
    )


    # ---------------------------------------------------------
    # Baseline block call
    # ---------------------------------------------------------

    out0 = block(
        h0,
        **kwargs,
    )


    y0 = (
        out0[0]
        if isinstance(
            out0,
            tuple,
        )
        else out0
    )


    # ---------------------------------------------------------
    # Perturbed block call
    # ---------------------------------------------------------

    out1 = block(
        h1,
        **kwargs,
    )


    y1 = (
        out1[0]
        if isinstance(
            out1,
            tuple,
        )
        else out1
    )


    y0_token = (
        y0[
            0,
            token_index,
        ]
        .detach()
        .float()
    )


    y1_token = (
        y1[
            0,
            token_index,
        ]
        .detach()
        .float()
    )


    response = (
        y1_token
        -
        y0_token
    )


    response_norm = float(
        torch.linalg.vector_norm(
            response
        ).item()
    )


    if response_norm <= EPS:

        response_direction = (
            torch.zeros(
                HIDDEN,
                dtype=torch.float32,
            )
        )

    else:

        response_direction = unit(
            response.cpu()
        )


    gain = (
        response_norm
        /
        (
            actual_norm
            +
            EPS
        )
    )


    response_input_cos = cosine(
        response.cpu(),
        actual_delta.cpu(),
    )


    return {

        "response":
            response.cpu(),

        "response_direction":
            response_direction,

        "requested_rel":
            PROBE_REL,

        "actual_rel":
            float(
                actual_rel
            ),

        "actuator_cos":
            actuator_cos,

        "input_delta_norm":
            actual_norm,

        "response_norm":
            response_norm,

        "gain":
            float(
                gain
            ),

        "response_input_cos":
            response_input_cos,
    }


# =============================================================================
# 21. RESPONSE-CONSTRAINED CLOSED-LOOP UPDATE
# =============================================================================
#
# IMPORTANT:
#
# We do NOT simply set:
#
#       z_(t+1) = response
#
# because the response may leave the semantic donor span.
#
# Instead:
#
#   1. actual transformer response r_t
#   2. project r_t into that arm's endogenous donor span
#   3. remove component already represented by z_t
#   4. fixed angular update
#
#
# Therefore the next state requires BOTH:
#
#   - real transformer transport
#   - endogenous donor geometry
#
#
# Dibek is absent.
#
# =============================================================================

def update_from_real_response(
    z,
    response,
    donor_directions,
    eta=ETA,
):

    z = unit(
        z
    )


    r = (
        response.detach()
        .float()
        .reshape(-1)
    )


    projected, rank = project_to_row_span(
        r,
        donor_directions,
    )


    projected_norm = float(
        torch.linalg.vector_norm(
            projected
        ).item()
    )


    response_norm = float(
        torch.linalg.vector_norm(
            r
        ).item()
    )


    retained_fraction = (
        projected_norm
        /
        (
            response_norm
            +
            EPS
        )
    )


    innovation = (
        projected
        -
        torch.dot(
            projected,
            z
        )
        *
        z
    )


    innovation_norm = float(
        torch.linalg.vector_norm(
            innovation
        ).item()
    )


    if (
        innovation_norm
        <=
        EPS
    ):

        return (
            z.clone(),
            {

                "rank":
                    rank,

                "projected_response_norm":
                    projected_norm,

                "response_retained_fraction":
                    retained_fraction,

                "innovation_norm":
                    innovation_norm,

                "update_applied":
                    False,
            },
        )


    u = unit(
        innovation
    )


    z_new = (
        math.cos(
            eta
        )
        *
        z
        +
        math.sin(
            eta
        )
        *
        u
    )


    z_new = unit(
        z_new
    )


    return (
        z_new,
        {

            "rank":
                rank,

            "projected_response_norm":
                projected_norm,

            "response_retained_fraction":
                retained_fraction,

            "innovation_norm":
                innovation_norm,

            "update_applied":
                True,
        },
    )


# =============================================================================
# 22. CLOSED-LOOP RECURRENCE
# =============================================================================

def run_recurrence(
    z0,
    donor_directions,
    contexts,
    n_steps=N_STEPS,
):

    z = unit(
        z0
    )


    states = [
        z.clone()
    ]


    telemetry = []


    for t in range(
        n_steps
    ):

        carrier_index = (
            t
            %
            len(contexts)
        )


        context = contexts[
            carrier_index
        ]


        transport = real_block_response(
            context,
            z,
        )


        z_new, update_info = (
            update_from_real_response(
                z,
                transport[
                    "response"
                ],
                donor_directions,
                eta=ETA,
            )
        )


        telemetry.append(
            {

                "step":
                    t + 1,

                "carrier_index":
                    carrier_index,

                "requested_rel":
                    transport[
                        "requested_rel"
                    ],

                "actual_rel":
                    transport[
                        "actual_rel"
                    ],

                "actuator_cos":
                    transport[
                        "actuator_cos"
                    ],

                "input_delta_norm":
                    transport[
                        "input_delta_norm"
                    ],

                "response_norm":
                    transport[
                        "response_norm"
                    ],

                "gain":
                    transport[
                        "gain"
                    ],

                "response_input_cos":
                    transport[
                        "response_input_cos"
                    ],

                "donor_span_rank":
                    update_info[
                        "rank"
                    ],

                "response_retained_fraction":
                    update_info[
                        "response_retained_fraction"
                    ],

                "innovation_norm":
                    update_info[
                        "innovation_norm"
                    ],

                "update_applied":
                    update_info[
                        "update_applied"
                    ],

                "state_step_cos":
                    cosine(
                        z,
                        z_new,
                    ),
            }
        )


        z = z_new


        states.append(
            z.clone()
        )


    return (
        states,
        telemetry,
    )


