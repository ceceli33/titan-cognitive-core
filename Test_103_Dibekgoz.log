# =============================================================================
# 16. CAPTURE REAL INPUT TO QWEN BLOCK 10
# =============================================================================
#
# We need the ACTUAL input to model.model.layers[10].
#
# This is different from the fingerprint extraction above.
#
# register_forward_pre_hook is appropriate HERE because the object of
# measurement is specifically the INPUT to the real transformer block.
#
# No semantic measurement uses this pre-hook.
#
# =============================================================================

@torch.inference_mode()
def capture_block_input(
    text
):

    enc = tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        max_length=128,
    )


    ids = (
        enc["input_ids"]
        .to(device)
    )


    mask = (
        enc["attention_mask"]
        .to(device)
    )


    captured = {
        "hidden": None
    }


    def pre_hook(
        module,
        args,
        kwargs,
    ):

        if len(args) > 0:

            h = args[0]

        elif "hidden_states" in kwargs:

            h = kwargs[
                "hidden_states"
            ]

        else:

            raise RuntimeError(
                "Could not locate hidden_states "
                "in block pre-hook."
            )


        captured["hidden"] = (
            h.detach()
            .clone()
        )


    handle = (
        model.model.layers[
            BLOCK_INDEX
        ].register_forward_pre_hook(
            pre_hook,
            with_kwargs=True,
        )
    )


    try:

        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False,
        )

    finally:

        handle.remove()


    if captured["hidden"] is None:

        raise RuntimeError(
            "Block input capture failed."
        )


    return {

        "hidden":
            captured["hidden"],

        "attention_mask":
            mask.detach().clone(),

        "length":
            int(
                mask.sum().item()
            ),
    }


