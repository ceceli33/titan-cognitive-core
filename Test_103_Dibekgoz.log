# =============================================================================
# 24. OPEN AYNA
# =============================================================================

print(
    "\n[10/12] "
    "FORMATION FROZEN — AYNA OPEN"
)


DIBEK = (
    SEALED_DIBEK
    .clone()
)


POS_H = (
    SEALED_POS
    .clone()
)


NEG_H = (
    SEALED_NEG
    .clone()
)


def mirror(
    z
):

    z = unit(
        z
    )


    c = cosine(
        z,
        DIBEK,
    )


    p = (
        POS_H
        @
        z
    )


    n = (
        NEG_H
        @
        z
    )


    sep = float(
        (
            p.mean()
            -
            n.mean()
        ).item()
    )


    pooled = torch.cat(
        [
            p,
            n,
        ],
        dim=0,
    )


    pooled_sd = float(
        pooled.std(
            unbiased=True
        ).item()
    )


    standardized = (
        sep
        /
        (
            pooled_sd
            +
            EPS
        )
    )


    return {

        "compass_cos":
            c,

        "pos_minus_neg":
            sep,

        "standardized_separation":
            float(
                standardized
            ),
    }


def evaluate_trajectory(
    states
):

    return [
        mirror(z)
        for z in states
    ]


def consensus_trace(
    states,
    consensus,
):

    return [
        cosine(
            z,
            consensus,
        )
        for z in states
    ]


TARGET_MIRROR = evaluate_trajectory(
    TARGET_STATES
)


ANTI_MIRROR = evaluate_trajectory(
    ANTI_STATES
)


NULL_MIRROR = evaluate_trajectory(
    NULL_STATES
)


TARGET_CONS_TRACE = consensus_trace(
    TARGET_STATES,
    TARGET_CONS[
        "direction"
    ],
)


ANTI_CONS_TRACE = consensus_trace(
    ANTI_STATES,
    ANTI_CONS[
        "direction"
    ],
)


NULL_CONS_TRACE = consensus_trace(
    NULL_STATES,
    NULL_CONS[
        "direction"
    ],
)


# =============================================================================
# 25. SUMMARY
# =============================================================================

def summarize(
    mirror_trace,
    consensus_values,
    telemetry,
):

    c = np.asarray(
        [
            x[
                "compass_cos"
            ]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )


    sep = np.asarray(
        [
            x[
                "pos_minus_neg"
            ]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )


    t = np.arange(
        len(c),
        dtype=np.float64,
    )


    slope = float(
        np.polyfit(
            t,
            c,
            1,
        )[0]
    )


    gains = np.asarray(
        [
            x["gain"]
            for x in telemetry
        ],
        dtype=np.float64,
    )


    retained = np.asarray(
        [
            x[
                "response_retained_fraction"
            ]
            for x in telemetry
        ],
        dtype=np.float64,
    )


    actuator_cos = np.asarray(
        [
            x[
                "actuator_cos"
            ]
            for x in telemetry
        ],
        dtype=np.float64,
    )


    actual_rel = np.asarray(
        [
            x[
                "actual_rel"
            ]
            for x in telemetry
        ],
        dtype=np.float64,
    )


    return {

        "start_cos":
            float(
                c[0]
            ),

        "final_cos":
            float(
                c[-1]
            ),

        "delta_cos":
            float(
                c[-1]
                -
                c[0]
            ),

        "max_cos":
            float(
                c.max()
            ),

        "min_cos":
            float(
                c.min()
            ),

        "linear_slope":
            slope,

        "positive_step_fraction":
            float(
                np.mean(
                    np.diff(c)
                    >
                    0
                )
            ),

