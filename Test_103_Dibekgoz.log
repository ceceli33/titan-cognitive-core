# =============================================================================
# 15. EMPTY SEAT
# =============================================================================

def build_empty_seat(
    donor_directions,
    consensus_direction,
    seed_offset,
):

    D = (
        donor_directions
        .detach()
        .float()
    )


    gen = torch.Generator(
        device="cpu"
    )


    gen.manual_seed(
        SEED
        +
        seed_offset
    )


    r = torch.randn(
        HIDDEN,
        generator=gen,
        dtype=torch.float32,
    )


    r_span, rank = project_to_row_span(
        r,
        D,
    )


    r_neutral = project_out(
        r_span,
        consensus_direction,
    )


    if float(
        torch.linalg.vector_norm(
            r_neutral
        ).item()
    ) <= 1e-8:

        raise RuntimeError(
            "Empty-seat construction collapsed."
        )


    return (
        unit(r_neutral),
        rank,
    )


