# =============================================================================
# 30. RANDOM CARRIER-ORDER CONTROL
# =============================================================================
#
# Unlike TEST141's donor-order control, TEST142's recurrence is driven by
# transformer responses to carrier contexts.
#
# Therefore this control randomizes CARRIER order.
#
# Donor geometry remains fixed.
#
# =============================================================================

print(
    "\n[11/12] Random carrier-order control..."
)


random_deltas = []


rng = random.Random(
    SEED + 7000
)


for ri in range(
    N_RANDOM_ORDER
):

    indices = []


    while len(indices) < N_STEPS:

        block = list(
            range(
                len(
                    BLOCK_CONTEXTS
                )
            )
        )


        rng.shuffle(
            block
        )


        indices.extend(
            block
        )


    indices = (
        indices[
            :N_STEPS
        ]
    )


    random_contexts = [
        BLOCK_CONTEXTS[i]
        for i in indices
    ]


    states, _ = run_recurrence(
        TARGET_Z0,
        TARGET[
            "direction"
        ],
        random_contexts,
        n_steps=N_STEPS,
    )


    trace = evaluate_trajectory(
        states
    )


    delta = (
        trace[-1][
            "compass_cos"
        ]
        -
        trace[0][
            "compass_cos"
        ]
    )


    random_deltas.append(
        float(delta)
    )


random_np = np.asarray(
    random_deltas,
    dtype=np.float64,
)


random_mean = float(
    random_np.mean()
)


random_sd = float(
    random_np.std(
        ddof=1
    )
)


ordered_percentile = float(
    np.mean(
        random_np
        <=
        TARGET_DELTA
    )
)


if random_sd > EPS:

    ordered_z = float(
        (
            TARGET_DELTA
            -
            random_mean
        )
        /
        random_sd
    )

else:

    ordered_z = float(
        "nan"
    )


print(
    f"Ordered TARGET Δ = "
    f"{TARGET_DELTA:+.6f}"
)


print(
    f"Random carrier Δ = "
    f"{random_mean:+.6f} "
    f"± {random_sd:.6f}"
)


print(
    f"Ordered percentile = "
    f"{100.0 * ordered_percentile:.1f}%"
)


print(
    f"Ordered Z = "
    f"{ordered_z:+.4f}"
)


