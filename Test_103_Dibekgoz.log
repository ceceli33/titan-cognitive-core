# =============================================================================
# 3. BASIC MATH
# =============================================================================

def unit(x):

    x = (
        x.detach()
        .float()
        .reshape(-1)
    )

    n = torch.linalg.vector_norm(x)

    if float(n.item()) <= EPS:

        raise RuntimeError(
            "unit(): zero or degenerate vector"
        )

    return x / n


def cosine(a, b):

    a = (
        a.detach()
        .float()
        .reshape(-1)
    )

    b = (
        b.detach()
        .float()
        .reshape(-1)
    )

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if (
        float(na.item()) <= EPS
        or
        float(nb.item()) <= EPS
    ):

        return float("nan")

    return float(
        (
            torch.dot(a, b)
            /
            (na * nb)
        ).item()
    )


def project_out(x, direction):

    x = (
        x.detach()
        .float()
        .reshape(-1)
    )

    d = unit(direction)

    return (
        x
        -
        torch.dot(x, d) * d
    )


def project_to_row_span(x, D):

    x = (
        x.detach()
        .float()
        .reshape(-1)
    )

    D = (
        D.detach()
        .float()
    )

    _, s, Vh = torch.linalg.svd(
        D,
        full_matrices=False,
    )

    tol = (
        float(s.max().item())
        *
        max(D.shape)
        *
        torch.finfo(torch.float32).eps
    )

    rank = int(
        (s > tol)
        .sum()
        .item()
    )

    if rank < 1:

        raise RuntimeError(
            "project_to_row_span(): rank < 1"
        )

    B = Vh[:rank]

    projected = (
        B.T
        @
        (
            B
            @
            x
        )
    )

    return projected, rank


def json_safe(x):

    if torch.is_tensor(x):

        return (
            x.detach()
            .float()
            .cpu()
            .tolist()
        )

    if isinstance(x, np.ndarray):
        return x.tolist()

    if isinstance(x, np.integer):
        return int(x)

    if isinstance(x, np.floating):
        return float(x)

    if isinstance(x, np.bool_):
        return bool(x)

    if isinstance(x, dict):

        return {
            str(k): json_safe(v)
            for k, v in x.items()
        }

    if isinstance(x, (list, tuple)):

        return [
            json_safe(v)
            for v in x
        ]

    return x


