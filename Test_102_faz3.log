print("\n[13/18] DECISION")
print("=" * 160)

back_energy = float(
    cumulative[selected_rank-1]
)

B = GLOBAL["BACKBONE"]
T = GLOBAL["TANGENT"]

back_supported = (
    B["delta_target"]["mean"] > 0
    and B["delta_target"]["ci95"][0] > 0
    and B["positive_layer_fraction"] >= 0.75
)

tangent_supported = (
    T["delta_target"]["mean"] > 0
    and T["delta_target"]["ci95"][0] > 0
    and T["positive_layer_fraction"] >= 0.75
)

match_ok = (
    B["match_abs_error"]["mean"]
    <= MATCH_TOL
    and
    T["match_abs_error"]["mean"]
    <= MATCH_TOL
)

if not match_ok:

    DECISION = (
        "MATCH_QUALITY_INSUFFICIENT"
    )

elif (
    back_supported
    and tangent_supported
):

    DECISION = (
        "BACKBONE_AND_TANGENT_TRANSPORT_SUPPORTED"
    )

elif (
    back_supported
    and not tangent_supported
):

    DECISION = (
        "BACKBONE_DOMINANT_TANGENT_CORRECTION_CANDIDATE"
    )

elif (
    tangent_supported
    and not back_supported
):

    DECISION = (
        "LAYER_TANGENT_TRANSPORT_DOMINANT"
    )

else:

    DECISION = (
        "LOW_RANK_DECOMPOSITION_NOT_SUFFICIENT"
    )

