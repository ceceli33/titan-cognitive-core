# =============================================================================

print("\n[4/18] SVD semantic backbone analizi...")

U, S, VH = torch.linalg.svd(
    V,
    full_matrices=False
)

energy = S.square()
energy_ratio = energy / energy.sum()
cumulative = torch.cumsum(
    energy_ratio,
    dim=0
)

print("\nSingular spectrum:")

for i in range(20):

    print(
        f"PC{i+1:02d} "
        f"singular={float(S[i]):.6f} "
        f"energy={float(energy_ratio[i]):.4f} "
        f"cum={float(cumulative[i]):.4f}"
    )


