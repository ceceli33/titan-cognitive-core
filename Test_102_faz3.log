)


# =============================================================================
# 11. BACKBONE / TANGENT DECOMPOSITION
#
# B: rank-k ortak subspace
#
# s_l = projection of v_l onto B
# t_l = v_l - s_l
# =============================================================================

print("\n[5/18] Katman vektörleri backbone+tangent ayrılıyor...")

BASIS = VH[:selected_rank].T.contiguous()
# [3584, k]

BACKBONE_RAW = {}
BACKBONE_DIR = {}

TANGENT_RAW = {}
TANGENT_DIR = {}

DECOMP = {}

for li in range(VECTOR_LAYERS):

    v = DIBEK[li].float()

    coeff = BASIS.T @ v

    s = BASIS @ coeff
    t = v - s

    s_norm = float(
        torch.linalg.vector_norm(s)
    )

    t_norm = float(
        torch.linalg.vector_norm(t)
    )

    sdir = normalize(s)
    tdir = normalize(t)

    BACKBONE_RAW[li] = s
    TANGENT_RAW[li] = t

    BACKBONE_DIR[li] = sdir
    TANGENT_DIR[li] = tdir

    recon = s + t

    DECOMP[li] = {
        "backbone_norm": s_norm,
        "tangent_norm": t_norm,
        "backbone_energy_fraction":
            s_norm ** 2,
        "tangent_energy_fraction":
            t_norm ** 2,
        "reconstruction_cos":
            cosine(recon, v),
        "backbone_tangent_cos":
            cosine(s, t),
    }

print(
    "Mean backbone energy fraction =",
    f"{np.mean([DECOMP[l]['backbone_energy_fraction'] for l in range(20)]):.6f}"
)

print(
    "Mean tangent energy fraction  =",
    f"{np.mean([DECOMP[l]['tangent_energy_fraction'] for l in range(20)]):.6f}"
)

print(
    "Max reconstruction error cos  =",
    f"{min(DECOMP[l]['reconstruction_cos'] for l in range(20)):.9f}"
)


# =============================================================================
# 12. BASELINE PASS
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(
            **enc,
            use_cache=False
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 13. ONE-STEP FINITE PERTURBATION
# =============================================================================

@torch.no_grad()
def one_step_probe(
    prompt,
    baseline,
    li,
    direction
):

    target = li + 1

    src_base = baseline[li].float()

    q = normalize(direction)

    if q is None:
        raise RuntimeError(
            f"L{li}: sıfır direction"
        )

    requested_norm = (
        PROBE_REL
        * float(
            torch.linalg.vector_norm(
                src_base
            )
        )
    )

    q_gpu = q.to(device)

    cap = {}
    src_delta = {}

    handles = []

    def source_hook(module, inp, out):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        before = h[0, -1].float()

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        realized = (
            hnew[0, -1].float()
            - before
        )

        src_delta["d"] = (
            realized
            .detach()
            .cpu()
            .clone()
        )

        if isinstance(out, tuple):

            return (
                (hnew,)
                + out[1:]
            )

        return hnew

    def target_hook(module, inp, out):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(
            **enc,
            use_cache=False
        )

    finally:

        for h in handles:
            h.remove()

    ds = src_delta["d"]

    dt = (
        cap["h"]
        - baseline[target]
    )

    ds_norm = float(
        torch.linalg.vector_norm(ds)
    )

    dt_norm = float(
        torch.linalg.vector_norm(dt)
    )

    return {
        "ds": ds,
        "dt": dt,

        "realized_relative":
            ds_norm /
            (
                float(
                    torch.linalg.vector_norm(
                        src_base
                    )
                )
                + EPS
            ),

        "realized_direction_cos":
            cosine(ds, q),

        "gain":
            dt_norm / (ds_norm + EPS),
    }


# =============================================================================
# 14. RANDOM DIRECTION AROUND AXIS
#
# Requested candidate is built around semantic axis.
# Acceptance however uses REALIZED BF16 perturbation.
# =============================================================================

def random_around_axis(
    axis,
    requested_cos,
    seed
):

    axis = normalize(axis)

    g = torch.Generator(
        device="cpu"
    )

    g.manual_seed(seed)

    z = torch.randn(
        HIDDEN,
        generator=g,
        dtype=torch.float32
    )

    u = (
        z
        - torch.dot(z, axis) * axis
    )

    u = normalize(u)

    if u is None:
        return None

    c = max(
        -0.999999,
        min(
            0.999999,
            float(requested_cos)
        )
    )

    s = math.sqrt(
        max(
            0.0,
            1.0 - c*c
        )
    )

    return normalize(
        c * axis
        + s * u
    )


# =============================================================================
# 15. REALIZED-MATCHED RANDOM SEARCH
#
# Önce semantic kol çalışır.
# Sonra random adayın BF16 sonrası GERÇEK source cosine'ı semantic kola
# MATCH_TOL içinde gelene kadar candidate search yapılır.
# =============================================================================

def matched_random_controls(
    prompt,
    baseline,
    li,
    axis,
    semantic_source_cos,
    prompt_index,
    arm_code
):

    accepted = []

    # İlk tahmin semantic realized cosine.
    requested_cos = semantic_source_cos

    tries = 0

    # Quantization sonrası sistematik sapmayı iteratif düzeltmek için.
    correction = 0.0

    while (
        len(accepted) < N_MATCHED
        and tries < MAX_MATCH_TRIES
    ):

        tries += 1

        seed = (
            SEED
            + 10000000 * arm_code
            + 100000 * (prompt_index + 1)
            + 1000 * li
            + tries
        )

        q = random_around_axis(
            axis,
            requested_cos + correction,
            seed
        )

        if q is None:
            continue

        rr = one_step_probe(
            prompt,
            baseline,
            li,
            q
        )

        realized_cos = cosine(
            rr["ds"],
            axis
        )

        error = (
            realized_cos
            - semantic_source_cos
        )

        # Tam realized-space acceptance.
        if abs(error) <= MATCH_TOL:

            accepted.append({
                "probe": rr,
                "q": q,
                "realized_axis_cos":
                    realized_cos,
                "match_error":
                    error,
                "tries":
                    tries,
            })

        else:

            # Son hataya göre requested angle'ı hafifçe düzelt.
            correction -= 0.75 * error

            correction = max(
                -0.30,
                min(
                    0.30,
                    correction
                )
            )

    return accepted, tries


# =============================================================================
# 16. MAIN EXPERIMENT
#
# Arms:
#
# FULL     : v_l
# BACKBONE : normalized projection onto common subspace
# TANGENT  : normalized layer-specific residual
#
# Her arm için bir sonraki katmandaki karşılığı ölçülür.
# =============================================================================

print("\n[6/18] Transport deneyi başlıyor...")

print(
    "Arms: FULL / BACKBONE / TANGENT"
)

print(
    "Random controls are accepted only after realized BF16 matching."
)

RAW = []

start = time.time()

match_failures = {
    "FULL": 0,
    "BACKBONE": 0,
    "TANGENT": 0,
}

arm_codes = {
    "FULL": 1,
    "BACKBONE": 2,
    "TANGENT": 3,
}

for pi, prompt in enumerate(PROMPTS):

    baseline = baseline_pass(
        prompt
    )

    row = {
        "prompt_index": pi + 1,
        "context": CONTEXT[pi],
        "prompt": prompt,
        "layers": {},
    }

    for li in SOURCE_LAYERS:

        target = li + 1

        arms = {
            "FULL": (
                DIBEK[li],
                DIBEK[target]
            ),

            "BACKBONE": (
                BACKBONE_DIR[li],
                BACKBONE_DIR[target]
            ),

            "TANGENT": (
                TANGENT_DIR[li],
                TANGENT_DIR[target]
            ),
        }

        layer_row = {}

        for arm_name, (
            source_axis,
            target_axis
        ) in arms.items():

            # Eğer selected rank tüm uzayı açıklarsa tangent olmayabilir.
            if (
                source_axis is None
                or target_axis is None
            ):

                layer_row[arm_name] = {
                    "valid": False
                }

                continue

            sem = one_step_probe(
                prompt,
                baseline,
                li,
                source_axis
            )

            source_cos = cosine(
                sem["ds"],
                source_axis
            )

            response_target = cosine(
                sem["dt"],
                target_axis
            )

            response_source = cosine(
                sem["dt"],
                source_axis
            )

            matched, tries = (
                matched_random_controls(
                    prompt=prompt,
                    baseline=baseline,
                    li=li,
                    axis=source_axis,
                    semantic_source_cos=source_cos,
                    prompt_index=pi,
                    arm_code=arm_codes[arm_name],
                )
            )

            if len(matched) < N_MATCHED:

                match_failures[arm_name] += 1

            random_target = []

            random_source = []

            random_match_error = []

            for m in matched:

                rr = m["probe"]

                random_target.append(
                    cosine(
                        rr["dt"],
                        target_axis
                    )
                )

                random_source.append(
                    cosine(
                        rr["dt"],
                        source_axis
                    )
                )

                random_match_error.append(
                    m["match_error"]
                )

            if len(random_target) > 0:

                rand_target_mean = float(
                    np.mean(random_target)
                )

                delta_target = (
                    response_target
                    - rand_target_mean
                )

                match_abs = float(
                    np.mean(
                        np.abs(
                            random_match_error
                        )
                    )
                )

            else:

                rand_target_mean = float("nan")
                delta_target = float("nan")
                match_abs = float("nan")

            layer_row[arm_name] = {
                "valid": True,

                "response_target":
                    response_target,

                "response_source":
                    response_source,

                "source_realized_cos":
                    source_cos,

                "realized_relative":
                    sem["realized_relative"],

                "realized_direction_cos":
                    sem["realized_direction_cos"],

                "gain":
                    sem["gain"],

                "random_target_mean":
                    rand_target_mean,

                "delta_target":
                    delta_target,

                "matched_n":
                    len(matched),

                "match_abs_error":
                    match_abs,

                "match_total_tries":
                    tries,

                "random_target":
                    random_target,

                "random_source":
                    random_source,

                "random_match_error":
                    random_match_error,
            }

        # Cross-component measurements.
        # Full v_l response hangi parçada sonlanıyor?
        full_dt_probe = one_step_probe(
            prompt,
            baseline,
            li,
            DIBEK[li]
        )

        full_dt = full_dt_probe["dt"]

        layer_row["FULL_DECOMP"] = {
            "to_next_full":
                cosine(
                    full_dt,
                    DIBEK[target]
                ),

            "to_next_backbone":
                cosine(
                    full_dt,
                    BACKBONE_DIR[target]
                ),

            "to_next_tangent":
                cosine(
                    full_dt,
                    TANGENT_DIR[target]
                ),
        }

        row["layers"][str(li)] = (
            layer_row
        )

    RAW.append(row)

    if (pi + 1) % 5 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(PROMPTS)} "
        f"| elapsed="
        f"{(time.time()-start)/60:.1f} min",
        end="\r"
    )

print()

print(
    f"Experiment completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 17. COLLECT
# =============================================================================

def collect(
    li,
    arm,
    key,
    context=None
):

    vals = []

    for row in RAW:

        if (
            context is not None
            and row["context"] != context
        ):
            continue

        a = (
            row["layers"][str(li)]
            .get(arm, {})
        )

        if (
            not a
            or not a.get("valid", True)
        ):
            continue

        v = a.get(
            key,
            float("nan")
        )

        if np.isfinite(v):
            vals.append(v)

    return np.asarray(
        vals,
        dtype=np.float64
    )


