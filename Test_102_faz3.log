for k in BACKBONE_RANKS:

    RANK_TABLE[k] = {
        "explained_energy":
            float(cumulative[k-1])
    }

    print(
        f"Rank {k:02d} -> "
        f"{float(cumulative[k-1])*100:.2f}%"
    )


# En küçük >= hedef enerji rankı.
