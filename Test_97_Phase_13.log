# 10. RANDOM KONTROL
# =============================================================================
#
# Her katman için bağımsız Gaussian yön.
#
# Sonra normalize edilir.
#
# Böylece:
#
#   ||RANDOM_l|| = ||IND_l|| = 1
#
# DRA'nın contribution formülü zaten h normundan büyüklük ürettiği için
# fiziksel giriş ölçeği gerçek yönlerle karşılaştırılabilir kalır.
#
# =============================================================================

print("\n[6/9] RANDOM kontrol yönü oluşturuluyor...")


rng = np.random.default_rng(
    RANDOM_SEED
)


