# =============================================================================
# 11. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        - abs(cosine_value)
    )

    dw = (
        SONUM
        + uncertainty * 0.20
    )

    t = float(layer_idx)

    kb = (
        ZIRVE
        * math.exp(-dw * t)
        * (1.0 + dw * t)
        + TABAN
    )

    envelope = (
        kb
        / (ZIRVE + TABAN)
    )

    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            (1.0 - cosine_value)
            / BRAKE_HIGH_DENOM
        )

    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN

    else:

        brake = 1.0

    return envelope, brake


# =============================================================================
# 12. BASE GENERATION
# =============================================================================

@torch.no_grad()
def baseline_generate(prompt):

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(model.device)

    output = model.generate(
        **encoded,
        max_new_tokens=MAX_NEW_TOKENS,
        do_sample=False,
        repetition_penalty=1.0,
        use_cache=True,
        pad_token_id=tokenizer.eos_token_id,
    )

    prompt_length = (
        encoded["input_ids"].shape[1]
    )

    generated_ids = output[
        0,
        prompt_length:
    ]

    return tokenizer.decode(
        generated_ids,
        skip_special_tokens=True
    )


# =============================================================================
# 13. DRA GENERATION
# =============================================================================

def steered_generate(
    prompt,
    vectors,
    active_layers
):

    handles = []

    telemetry = {
        "cos": [],
        "abs_cos": [],
        "contribution": [],
        "envelope": [],
        "brake": [],
        "hook_steps": 0,
    }


    def make_hook(layer_idx):

        # Hook oluşturulurken yalnızca bir kere tensor yap.
        vector = torch.tensor(
            vectors[layer_idx],
            device=model.device,
            dtype=next(model.parameters()).dtype
        ).unsqueeze(0)


        def hook(
            module,
            inputs,
            output
        ):

            if isinstance(output, tuple):

                hidden = output[0]
                remainder = output[1:]

            else:

                hidden = output
                remainder = None


            # Son token
            h = hidden[:, -1, :]


            h_norm = torch.linalg.norm(
                h,
                dim=-1,
                keepdim=True
            )


            vector_norm = torch.linalg.norm(
                vector,
                dim=-1,
                keepdim=True
            )


            cosine = (
                torch.sum(
                    h * vector,
                    dim=-1,
                    keepdim=True
                )
                /
                (
                    h_norm
                    * vector_norm
                    + 1e-12
                )
            )


            cosine_value = float(
                cosine
                .mean()
                .detach()
                .cpu()
            )


            envelope, brake = (
                dra_parameters(
                    cosine_value,
                    layer_idx
                )
            )


            contribution = (
                IVME
                * h_norm
                / SQRT_K
                * envelope
                * brake
            )


            delta = (
                contribution
                * vector
            )


            hidden_new = hidden.clone()

            hidden_new[
                :,
                -1,
                :
            ] = (
                hidden_new[
                    :,
                    -1,
                    :
                ]
                + delta
            )


            telemetry["cos"].append(
                cosine_value
            )

            telemetry["abs_cos"].append(
                abs(cosine_value)
            )

            telemetry[
                "contribution"
            ].append(
                float(
                    contribution
                    .mean()
                    .detach()
                    .cpu()
                )
            )

            telemetry[
                "envelope"
            ].append(
                float(envelope)
            )

            telemetry[
                "brake"
            ].append(
                float(brake)
            )

            telemetry[
                "hook_steps"
            ] += 1


            if remainder is not None:

                return (
                    hidden_new,
                    *remainder
                )

            return hidden_new


        return hook


    for layer_idx in active_layers:

        handle = (
            model.model.layers[layer_idx]
            .register_forward_hook(
                make_hook(layer_idx)
            )
        )

        handles.append(handle)


    try:

        encoded = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(model.device)


        with torch.no_grad():

            output = model.generate(
                **encoded,
                max_new_tokens=MAX_NEW_TOKENS,
                do_sample=False,
                repetition_penalty=1.0,
                use_cache=True,
                pad_token_id=tokenizer.eos_token_id,
            )


        prompt_length = (
            encoded["input_ids"].shape[1]
        )


        generated_ids = output[
            0,
            prompt_length:
        ]


        generated_text = tokenizer.decode(
            generated_ids,
            skip_special_tokens=True
        )


    finally:

        for handle in handles:
            handle.remove()


    if telemetry["hook_steps"] > 0:

        summary = {

            "mean_cos":
                float(
                    np.mean(
                        telemetry["cos"]
                    )
                ),

            "mean_abs_cos":
                float(
                    np.mean(
                        telemetry["abs_cos"]
                    )
                ),

            "mean_contribution":
                float(
                    np.mean(
                        telemetry[
                            "contribution"
                        ]
                    )
                ),

            "mean_envelope":
                float(
                    np.mean(
                        telemetry[
                            "envelope"
                        ]
                    )
                ),

            "mean_brake":
                float(
                    np.mean(
                        telemetry[
                            "brake"
                        ]
                    )
                ),

            "hook_steps":
                int(
                    telemetry[
                        "hook_steps"
                    ]
                ),
        }

    else:

        summary = {

            "mean_cos": 0.0,
            "mean_abs_cos": 0.0,
            "mean_contribution": 0.0,
            "mean_envelope": 0.0,
            "mean_brake": 0.0,
            "hook_steps": 0,
        }


    return generated_text, summary


# =============================================================================
# 14. METİN ÖLÇÜMÜ
# =============================================================================

def measure_text(
    text,
    telemetry=None
):

    above = count_terms(
        text,
        ABOVE_WORDS
    )

    below = count_terms(
        text,
        BELOW_WORDS
    )

    result = {

        "above": int(above),

        "below": int(below),

        "net": int(
            above - below
        ),

        "words":
            int(
                word_count(text)
            ),

        "repetition":
            float(
                repetition_score(text)
            ),

        "text":
            text,
    }


    if telemetry is not None:
        result.update(telemetry)


    return result


# =============================================================================
# 15. BASELINE — SADECE BİR KEZ
# =============================================================================

print("\n[7/9] BASELINE çalışıyor...")


baseline_prompt_results = []


for prompt_index, prompt in enumerate(
    BEHAVIOR_PROMPTS
):

    text = baseline_generate(
        prompt
    )

    measurement = measure_text(
        text
    )

    measurement[
        "prompt_index"
    ] = prompt_index

    baseline_prompt_results.append(
        measurement
    )


def aggregate_prompt_results(
    results
):

    return {

        "above":
            float(
                np.mean(
                    [x["above"] for x in results]
                )
            ),

        "below":
            float(
                np.mean(
                    [x["below"] for x in results]
                )
            ),

        "net":
            float(
                np.mean(
                    [x["net"] for x in results]
                )
            ),

        "words":
            float(
                np.mean(
                    [x["words"] for x in results]
                )
            ),

        "repetition":
            float(
                np.mean(
                    [x["repetition"] for x in results]
                )
            ),
    }


BASELINE = aggregate_prompt_results(
    baseline_prompt_results
)

BASELINE[
    "prompt_results"
] = baseline_prompt_results


print(
    f"\nBASELINE | "
    f"ABOVE={BASELINE['above']:.4f} | "
    f"BELOW={BASELINE['below']:.4f} | "
    f"NET={BASELINE['net']:+.4f} | "
    f"WORDS={BASELINE['words']:.2f} | "
    f"REP={BASELINE['repetition']:.4f}"
)


# =============================================================================
# 16. ARM ÇALIŞTIRICI
# =============================================================================

def run_steered_arm(
    arm_name,
    vectors,
    active_layers
):

    prompt_results = []


    for prompt_index, prompt in enumerate(
        BEHAVIOR_PROMPTS
    ):

        text, telemetry = steered_generate(
            prompt=prompt,
            vectors=vectors,
            active_layers=active_layers
        )

        measurement = measure_text(
            text,
            telemetry
        )

        measurement[
            "prompt_index"
        ] = prompt_index


        baseline_prompt = (
            BASELINE[
                "prompt_results"
            ][prompt_index]
        )


        measurement[
            "delta_net_vs_baseline"
        ] = float(
            measurement["net"]
            - baseline_prompt["net"]
        )


        measurement[
            "delta_above_vs_baseline"
        ] = float(
            measurement["above"]
            - baseline_prompt["above"]
        )


        measurement[
            "delta_below_vs_baseline"
        ] = float(
            measurement["below"]
            - baseline_prompt["below"]
        )


        prompt_results.append(
            measurement
        )


    agg = aggregate_prompt_results(
        prompt_results
    )


    telemetry_fields = [
        "mean_cos",
        "mean_abs_cos",
        "mean_contribution",
        "mean_envelope",
        "mean_brake",
        "hook_steps",
    ]


    for field in telemetry_fields:

        agg[field] = float(
            np.mean(
                [
                    x[field]
                    for x in prompt_results
                ]
            )
        )


    agg[
        "arm"
    ] = arm_name


    agg[
        "delta_net_vs_baseline"
    ] = float(
        agg["net"]
        - BASELINE["net"]
    )


    agg[
        "delta_above_vs_baseline"
    ] = float(
        agg["above"]
        - BASELINE["above"]
    )


    agg[
        "delta_below_vs_baseline"
    ] = float(
        agg["below"]
        - BASELINE["below"]
    )


    agg[
        "prompt_results"
    ] = prompt_results


    return agg


# =============================================================================
# 17. DÖRT KATMAN ÇİFTİNİ TEST ET
# =============================================================================

print("\n[8/9] Katman çiftleri test ediliyor...")


PAIR_RESULTS = {}


for pair in LAYER_PAIRS:

    pair_name = (
        f"L{pair[0]:02d}+L{pair[1]:02d}"
    )

    active_layers = list(pair)


    print("\n" + "=" * 90)
    print(pair_name)
    print("=" * 90)


    # -------------------------------------------------------------------------
    # ABOVE
    # -------------------------------------------------------------------------

    print("  ABOVE_IND çalışıyor...")

    above_result = run_steered_arm(
        arm_name="ABOVE_IND",
        vectors=IND_ABOVE,
        active_layers=active_layers
    )


    # -------------------------------------------------------------------------
    # BELOW
    # -------------------------------------------------------------------------

    print("  BELOW_IND çalışıyor...")

    below_result = run_steered_arm(
        arm_name="BELOW_IND",
        vectors=IND_BELOW,
        active_layers=active_layers
    )


    # -------------------------------------------------------------------------
    # RANDOM
    # -------------------------------------------------------------------------

    print("  RANDOM çalışıyor...")

    random_result = run_steered_arm(
        arm_name="RANDOM",
        vectors=RANDOM_VECTOR,
        active_layers=active_layers
    )


    # -------------------------------------------------------------------------
    # GLOBAL METRICS
    # -------------------------------------------------------------------------

    delta_a = (
        above_result[
            "delta_net_vs_baseline"
        ]
    )

    delta_b = (
        below_result[
            "delta_net_vs_baseline"
        ]
    )

    delta_r = (
        random_result[
            "delta_net_vs_baseline"
        ]
    )


    # Ana iki yön arasındaki ayrışma
    separation = (
        delta_a - delta_b
    )


    # RANDOM'ın baseline'dan mutlak hareketi
    random_displacement = abs(
        delta_r
    )


    # Gerçek iki yön arasındaki mesafe
    directional_distance = abs(
        delta_a - delta_b
    )


    # RANDOM'a göre ABOVE ve BELOW davranış uzaklığı
    above_vs_random = (
        delta_a - delta_r
    )

    below_vs_random = (
        delta_b - delta_r
    )


    # -------------------------------------------------------------------------
    # PROMPT-LEVEL COMPARISON
    # -------------------------------------------------------------------------

    prompt_comparison = []


    for i in range(
        len(BEHAVIOR_PROMPTS)
    ):

        base_p = (
            BASELINE[
                "prompt_results"
            ][i]
        )

        a_p = (
            above_result[
                "prompt_results"
            ][i]
        )

        b_p = (
            below_result[
                "prompt_results"
            ][i]
        )

        r_p = (
            random_result[
                "prompt_results"
            ][i]
        )


        a_delta = (
            a_p["net"]
            - base_p["net"]
        )

        b_delta = (
            b_p["net"]
            - base_p["net"]
        )

        r_delta = (
            r_p["net"]
            - base_p["net"]
        )


        prompt_comparison.append({

            "prompt_index": i,

            "baseline_net":
                base_p["net"],

            "above_net":
                a_p["net"],

            "below_net":
                b_p["net"],

            "random_net":
                r_p["net"],

            "above_delta":
                float(a_delta),

            "below_delta":
                float(b_delta),

            "random_delta":
                float(r_delta),

            "above_minus_below":
                float(
                    a_delta
                    - b_delta
                ),

            "above_minus_random":
                float(
                    a_delta
                    - r_delta
                ),

            "below_minus_random":
                float(
                    b_delta
                    - r_delta
                ),
        })


    # -------------------------------------------------------------------------
    # COUNTS — yalnızca betimleyici
    # -------------------------------------------------------------------------

    above_positive_prompts = sum(
        p["above_delta"] > 0
        for p in prompt_comparison
    )

    below_negative_prompts = sum(
        p["below_delta"] < 0
        for p in prompt_comparison
    )

    positive_separation_prompts = sum(
        p["above_minus_below"] > 0
        for p in prompt_comparison
    )

    negative_separation_prompts = sum(
        p["above_minus_below"] < 0
        for p in prompt_comparison
    )

    zero_separation_prompts = sum(
        p["above_minus_below"] == 0
        for p in prompt_comparison
    )


    # -------------------------------------------------------------------------
    # STORE
    # -------------------------------------------------------------------------

    PAIR_RESULTS[pair_name] = {

        "layers":
            active_layers,

        "above":
            above_result,

        "below":
            below_result,

        "random":
            random_result,

        "delta_above":
            float(delta_a),

        "delta_below":
            float(delta_b),

        "delta_random":
            float(delta_r),

        "bidirectional_separation":
            float(separation),

        "directional_distance":
            float(directional_distance),

        "random_displacement":
            float(random_displacement),

        "above_vs_random":
            float(above_vs_random),

        "below_vs_random":
            float(below_vs_random),

        "above_positive_prompts":
            int(above_positive_prompts),

        "below_negative_prompts":
            int(below_negative_prompts),

        "positive_separation_prompts":
            int(positive_separation_prompts),

        "negative_separation_prompts":
            int(negative_separation_prompts),

        "zero_separation_prompts":
            int(zero_separation_prompts),

        "prompt_comparison":
            prompt_comparison,
    }


    print(
        f"\n{pair_name}"
    )

    print(
        f"  ABOVE  NET={above_result['net']:+.4f} "
        f"Δ={delta_a:+.4f}"
    )

    print(
        f"  BELOW  NET={below_result['net']:+.4f} "
        f"Δ={delta_b:+.4f}"
    )

    print(
        f"  RANDOM NET={random_result['net']:+.4f} "
        f"Δ={delta_r:+.4f}"
    )

    print(
        f"  SEP(A-B) = {separation:+.4f}"
    )

    print(
        f"  A vs RANDOM = "
        f"{above_vs_random:+.4f}"
    )

    print(
        f"  B vs RANDOM = "
        f"{below_vs_random:+.4f}"
    )

    print(
        f"  prompt SEP signs: "
        f"+{positive_separation_prompts} / "
        f"-{negative_separation_prompts} / "
        f"0={zero_separation_prompts}"
    )


