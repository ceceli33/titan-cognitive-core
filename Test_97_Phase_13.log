# =============================================================================
# 6. YARDIMCI FONKSİYONLAR
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(v, dtype=np.float32)

    norm = np.linalg.norm(v)

    if norm < eps:
        return v.copy()

    return v / norm


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(a, dtype=np.float32)
    b = np.asarray(b, dtype=np.float32)

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b) / (na * nb)
    )


def count_terms(text, terms):

    text_lower = text.lower()

    total = 0

    for term in terms:

        pattern = r"\b" + re.escape(term.lower()) + r"\b"

        total += len(
            re.findall(pattern, text_lower)
        )

    return total


def word_count(text):

    return len(
        re.findall(
            r"\b[\wçğıöşüÇĞİÖŞÜ]+\b",
            text
        )
    )


def repetition_score(text):

    words = re.findall(
        r"\b[\wçğıöşüÇĞİÖŞÜ]+\b",
        text.lower()
    )

    if len(words) < 2:
        return 0.0

    bigrams = list(
        zip(words[:-1], words[1:])
    )

    if not bigrams:
        return 0.0

    counts = Counter(bigrams)

    repeated = sum(
        count - 1
        for count in counts.values()
        if count > 1
    )

    return float(
        repeated / len(bigrams)
    )


