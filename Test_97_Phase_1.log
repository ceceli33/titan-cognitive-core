# =============================================================================
# TEST 97A-B — LAYERWISE PUSULA TEMSİL DOĞRULAMASI
# Qwen2.5-7B-Instruct · A100 · AkbasCore
# -----------------------------------------------------------------------------
# AMAÇ
#   1) Mevcut 8 ABOVE/BELOW eğitim çiftinden layerwise Pusula üretmek
#   2) Yeni ve yüzey yapısı eşleştirilmiş bağımsız probe setinde doğrulamak
#   3) Göreli kontrastı ölçmek
#   4) LOO Pusula kararlılığını ölçmek
#   5) Çoklu random-null dağılımıyla karşılaştırmak
#
# ÖNEMLİ
#   - DRA enjeksiyonu YOKTUR.
#   - Eski TEST 97A'nın sonuçları yeniden üretilmez; referans olarak tutulur.
#   - Random null yalnızca mevcut aktivasyonlar üzerinde hesaplanır.
#   - Hiçbir keyfi "başarı eşiği" tanımlanmaz.
#   - Sonuçlar sonraki deneylere aktarılabilecek RESULTS yapısında saklanır.
# =============================================================================

import os
import json
import math
import random
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

# -----------------------------------------------------------------------------
# 0. AYARLAR
# -----------------------------------------------------------------------------

MODEL_NAME = "Qwen/Qwen2.5-7B-Instruct"

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
DTYPE = torch.bfloat16

N_LAYERS = 20
HIDDEN_DIM = 3584

SEED = 42

# Random-null sayısı bir başarı eşiği değildir.
# Yalnızca null dağılımının Monte-Carlo çözünürlüğünü belirler.
N_RANDOM_NULL = 512

# Aktivasyon batch boyutu
BATCH_SIZE = 8

# -----------------------------------------------------------------------------
# 1. DETERMINISTIC AYAR
# -----------------------------------------------------------------------------

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

torch.backends.cuda.matmul.allow_tf32 = True

print("=" * 78)
print("TEST 97A-B — LAYERWISE PUSULA TEMSİL DOĞRULAMASI")
print("=" * 78)
print(f"Model : {MODEL_NAME}")
print(f"Device: {DEVICE}")
print(f"dtype : {DTYPE}")
print(f"Layers: L0-L{N_LAYERS-1}")
print(f"D     : {HIDDEN_DIM}")
print(f"Seed  : {SEED}")
print(f"Nulls : {N_RANDOM_NULL}")
print()

# -----------------------------------------------------------------------------
# 2. MODEL
# -----------------------------------------------------------------------------

tokenizer = AutoTokenizer.from_pretrained(
    MODEL_NAME,
    trust_remote_code=True
)

model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME,
    torch_dtype=DTYPE,
    device_map="auto",
    trust_remote_code=True
)

model.eval()

print("Model yüklendi.")
print()

# -----------------------------------------------------------------------------
# 3. REFERANS PUSULA EĞİTİM ÇİFTLERİ
#
# Bunlar önceki TEST 97A ile AYNI tutuluyor.
# -----------------------------------------------------------------------------

TRAIN_ABOVE = [
    "Mustafa Dibekgoz is above the bridge.",
    "Mustafa Dibekgoz is positioned above the bridge.",
    "Mustafa Dibekgoz stands above the bridge.",
    "The position of Mustafa Dibekgoz is above the bridge.",
    "Mustafa Dibekgoz remains above the bridge.",
    "Mustafa Dibekgoz is located above the bridge.",
    "Mustafa Dibekgoz occupies a position above the bridge.",
    "The scene places Mustafa Dibekgoz above the bridge.",
]

TRAIN_BELOW = [
    "Mustafa Dibekgoz is below the bridge.",
    "Mustafa Dibekgoz is positioned below the bridge.",
    "Mustafa Dibekgoz stands below the bridge.",
    "The position of Mustafa Dibekgoz is below the bridge.",
    "Mustafa Dibekgoz remains below the bridge.",
    "Mustafa Dibekgoz is located below the bridge.",
    "Mustafa Dibekgoz occupies a position below the bridge.",
    "The scene places Mustafa Dibekgoz below the bridge.",
]

assert len(TRAIN_ABOVE) == len(TRAIN_BELOW)

# -----------------------------------------------------------------------------
# 4. YENİ BAĞIMSIZ PROBE SETİ
#
# Aynı subject/object iskeleti korunuyor.
# ABOVE ↔ BELOW dışında mümkün olduğunca hiçbir şey değişmiyor.
#
# Önceki 97A'daki reverse-syntax probları özellikle kullanılmıyor.
# -----------------------------------------------------------------------------

PROBE_ABOVE = [
    "Mustafa Dibekgoz is standing above the bridge.",
    "Mustafa Dibekgoz is positioned higher than the bridge.",
    "Mustafa Dibekgoz is located above the bridge.",
    "Mustafa Dibekgoz remains above the bridge.",
    "Mustafa Dibekgoz is situated above the bridge.",
    "Mustafa Dibekgoz is directly above the bridge.",
    "Mustafa Dibekgoz is placed above the bridge.",
    "Mustafa Dibekgoz stands higher than the bridge.",
]

PROBE_BELOW = [
    "Mustafa Dibekgoz is standing below the bridge.",
    "Mustafa Dibekgoz is positioned lower than the bridge.",
    "Mustafa Dibekgoz is located below the bridge.",
    "Mustafa Dibekgoz remains below the bridge.",
    "Mustafa Dibekgoz is situated below the bridge.",
    "Mustafa Dibekgoz is directly below the bridge.",
    "Mustafa Dibekgoz is placed below the bridge.",
    "Mustafa Dibekgoz stands lower than the bridge.",
]

assert len(PROBE_ABOVE) == len(PROBE_BELOW)

print(f"Eğitim çifti : {len(TRAIN_ABOVE)}")
print(f"Bağımsız çift: {len(PROBE_ABOVE)}")
print()

# -----------------------------------------------------------------------------
# 5. LAYERWISE AKTİVASYON TOPLAMA
#
# Önceki 97A ile uyumlu olarak gerçek token pozisyonlarının MEAN aktivasyonu
# kullanılıyor.
#
# Her layer için:
#   activation -> [D]
# -----------------------------------------------------------------------------

def collect_layerwise_activations(texts):
    """
    Her cümle için L0-L19 layer aktivasyonlarının gerçek tokenlar
    üzerindeki ortalamasını döndürür.

    Çıktı:
        [N, N_LAYERS, HIDDEN_DIM]
    """

    all_results = []

    for start in range(0, len(texts), BATCH_SIZE):

        batch_texts = texts[start:start + BATCH_SIZE]

        enc = tokenizer(
            batch_texts,
            return_tensors="pt",
            padding=True,
            truncation=True
        )

        input_ids = enc["input_ids"].to(DEVICE)
        attention_mask = enc["attention_mask"].to(DEVICE)

        # hidden_states:
        # embedding + transformer layer outputs
        with torch.no_grad():
            out = model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                output_hidden_states=True,
                use_cache=False
            )

        # [embedding, L0, L1, ..., L27]
        hs = out.hidden_states

        batch_result = []

        for b in range(input_ids.shape[0]):

            mask = attention_mask[b].bool()

            layer_vecs = []

            for layer in range(N_LAYERS):

                # hs[layer + 1] = transformer layer output
                h = hs[layer + 1][b]

                # yalnızca gerçek tokenlar
                h_real = h[mask]

                # önceki 97A ile uyumlu mean activation
                v = h_real.float().mean(dim=0)

                layer_vecs.append(v)

            batch_result.append(
                torch.stack(layer_vecs, dim=0)
            )

        all_results.append(
            torch.stack(batch_result, dim=0).cpu()
        )

        del out, hs, input_ids, attention_mask, enc
        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    return torch.cat(all_results, dim=0)


# -----------------------------------------------------------------------------
# 6. AKTİVASYONLARI ÇIKAR
# -----------------------------------------------------------------------------

print("Aktivasyonlar çıkarılıyor...")
print()

TRAIN_TEXTS = TRAIN_ABOVE + TRAIN_BELOW
PROBE_TEXTS = PROBE_ABOVE + PROBE_BELOW

train_act = collect_layerwise_activations(TRAIN_TEXTS)
probe_act = collect_layerwise_activations(PROBE_TEXTS)

print("Train activation shape:", tuple(train_act.shape))
print("Probe activation shape:", tuple(probe_act.shape))
print()

assert train_act.shape == (
    len(TRAIN_TEXTS),
    N_LAYERS,
    HIDDEN_DIM
)

assert probe_act.shape == (
    len(PROBE_TEXTS),
    N_LAYERS,
    HIDDEN_DIM
)

# -----------------------------------------------------------------------------
# 7. TRAIN / PROBE AYIR
# -----------------------------------------------------------------------------

n_train = len(TRAIN_ABOVE)
n_probe = len(PROBE_ABOVE)

train_above_act = train_act[:n_train]
train_below_act = train_act[n_train:]

probe_above_act = probe_act[:n_probe]
probe_below_act = probe_act[n_probe:]

# -----------------------------------------------------------------------------
# 8. LAYERWISE PUSULA OLUŞTUR
#
# P_l = normalize(mean(ABOVE_l) - mean(BELOW_l))
# -----------------------------------------------------------------------------

train_mean_above = train_above_act.float().mean(dim=0)
train_mean_below = train_below_act.float().mean(dim=0)

raw_pusula = train_mean_above - train_mean_below

pusula_norms = torch.linalg.vector_norm(
    raw_pusula,
    dim=1,
    keepdim=True
)

pusula = raw_pusula / torch.clamp(
    pusula_norms,
    min=1e-12
)

print("Pusula oluşturuldu.")
print()

# -----------------------------------------------------------------------------
# 9. YARDIMCI FONKSİYONLAR
# -----------------------------------------------------------------------------

def cosine_per_layer(A, B):
    """
    A/B: [L,D]
    return: [L]
    """
    return torch.nn.functional.cosine_similarity(
        A.float(),
        B.float(),
        dim=1,
        eps=1e-12
    )


def cosine_batch_layerwise(A, B):
    """
    A/B: [N,L,D]
    return: [N,L]
    """
    return torch.nn.functional.cosine_similarity(
        A.float(),
        B.float(),
        dim=2,
        eps=1e-12
    )


# -----------------------------------------------------------------------------
# 10. TRAIN MARGIN
#
# margin = cos(ABOVE, P) - cos(BELOW, P)
# -----------------------------------------------------------------------------

train_cos_above = cosine_batch_layerwise(
    train_above_act,
    pusula.unsqueeze(0)
)

train_cos_below = cosine_batch_layerwise(
    train_below_act,
    pusula.unsqueeze(0)
)

train_margin_each = train_cos_above - train_cos_below
train_margin = train_margin_each.mean(dim=0)

# -----------------------------------------------------------------------------
# 11. BAĞIMSIZ PROBE MARGIN
# -----------------------------------------------------------------------------

probe_cos_above = cosine_batch_layerwise(
    probe_above_act,
    pusula.unsqueeze(0)
)

probe_cos_below = cosine_batch_layerwise(
    probe_below_act,
    pusula.unsqueeze(0)
)

probe_margin_each = probe_cos_above - probe_cos_below
probe_margin = probe_margin_each.mean(dim=0)

# -----------------------------------------------------------------------------
# 12. GÖRELİ KONTRAST
#
# R_l =
# ||mean(ABOVE)-mean(BELOW)||
# -----------------------------------------
# 0.5*(||mean(ABOVE)|| + ||mean(BELOW)||)
# -----------------------------------------------------------------------------

relative_contrast = (
    torch.linalg.vector_norm(raw_pusula, dim=1)
    /
    (
        0.5 * (
            torch.linalg.vector_norm(train_mean_above, dim=1)
            +
            torch.linalg.vector_norm(train_mean_below, dim=1)
        )
    ).clamp_min(1e-12)
)

# -----------------------------------------------------------------------------
# 13. LOO PUSULA STABILITY
#
# Her eğitim çiftinden biri çıkarılır.
# Sonra LOO pusulasının full Pusula ile cosine'u hesaplanır.
# -----------------------------------------------------------------------------

loo_cosines = torch.zeros(
    n_train,
    N_LAYERS
)

for leave_out in range(n_train):

    keep = [
        i for i in range(n_train)
        if i != leave_out
    ]

    loo_above = train_above_act[keep].float().mean(dim=0)
    loo_below = train_below_act[keep].float().mean(dim=0)

    loo_raw = loo_above - loo_below

    loo_norm = torch.linalg.vector_norm(
        loo_raw,
        dim=1,
        keepdim=True
    )

    loo_p = loo_raw / loo_norm.clamp_min(1e-12)

    loo_cosines[leave_out] = cosine_per_layer(
        loo_p,
        pusula
    )

loo_mean = loo_cosines.mean(dim=0)
loo_std = loo_cosines.std(dim=0, unbiased=False)

# -----------------------------------------------------------------------------
# 14. RANDOM NULL BANKASI
#
# ÖNEMLİ:
# Random vektörler model forward gerektirmez.
#
# Her layer için bağımsız normalized random direction.
#
# Sonuç:
#   random_margin_distribution[null, layer]
# -----------------------------------------------------------------------------

print("Random-null dağılımı hesaplanıyor...")

random_vectors = torch.randn(
    N_RANDOM_NULL,
    N_LAYERS,
    HIDDEN_DIM,
    dtype=torch.float32
)

random_vectors = random_vectors / torch.linalg.vector_norm(
    random_vectors,
    dim=2,
    keepdim=True
).clamp_min(1e-12)

# [Nnull, Nprobe, Nlayer]
random_cos_above = torch.einsum(
    "nld,pld->npl",
    random_vectors,
    probe_above_act.float()
)

random_cos_below = torch.einsum(
    "nld,pld->npl",
    random_vectors,
    probe_below_act.float()
)

random_margin_each = random_cos_above - random_cos_below

# Ortalama probe margin
random_margin = random_margin_each.mean(dim=1)

random_mean = random_margin.mean(dim=0)
random_std = random_margin.std(dim=0, unbiased=False)

random_q025 = torch.quantile(
    random_margin,
    0.025,
    dim=0
)

random_q975 = torch.quantile(
    random_margin,
    0.975,
    dim=0
)

random_q005 = torch.quantile(
    random_margin,
    0.005,
    dim=0
)

random_q995 = torch.quantile(
    random_margin,
    0.995,
    dim=0
)

# Pusula'nın random dağılımındaki ampirik yüzdelik konumu.
random_percentile = (
    (random_margin < probe_margin.unsqueeze(0))
    .float()
    .mean(dim=0)
)

# Random vektörlerin kaç tanesinde margin > 0?
random_positive_fraction = (
    (random_margin > 0)
    .float()
    .mean(dim=0)
)

# -----------------------------------------------------------------------------
# 15. PUSULA'NIN RANDOM'A GÖRE FARKI
# -----------------------------------------------------------------------------

pusula_minus_random = probe_margin - random_mean

# Pusula margin > 0 olan layer sayısı
pusula_positive_layers = int(
    (probe_margin > 0).sum().item()
)

# Random null ortalaması > 0 olan layer sayısı
random_mean_positive_layers = int(
    (random_mean > 0).sum().item()
)

# -----------------------------------------------------------------------------
# 16. TÜM PROBE SONUÇLARI
# -----------------------------------------------------------------------------

probe_pair_positive = (
    probe_margin_each > 0
).sum(dim=0)

probe_pair_fraction_positive = (
    probe_pair_positive.float()
    /
    float(n_probe)
)

# -----------------------------------------------------------------------------
# 17. KÜMÜLATİF DENEY KAYDI
#
# Sonraki testlerin başında bu sözlükten bilgi aktarılabilir.
# -----------------------------------------------------------------------------

RESULTS = {
    "experiment": "TEST_97A_B",
    "version": "1.0",
    "model": MODEL_NAME,
    "device": DEVICE,
    "dtype": str(DTYPE),
    "hidden_dim": HIDDEN_DIM,
    "steering_layers": [0, N_LAYERS - 1],
    "seed": SEED,

    "design": {
        "training_pairs": n_train,
        "independent_probe_pairs": n_probe,
        "random_null_count": N_RANDOM_NULL,
        "activation_aggregation": "mean_over_real_tokens",
        "injection": False,
        "arbitrary_success_threshold": False,
    },

    "pusula": {
        "train_margin": train_margin.tolist(),
        "probe_margin": probe_margin.tolist(),
        "relative_contrast": relative_contrast.tolist(),
        "raw_norm": torch.linalg.vector_norm(
            raw_pusula,
            dim=1
        ).tolist(),
    },

    "loo": {
        "mean": loo_mean.tolist(),
        "std": loo_std.tolist(),
    },

    "random_null": {
        "mean": random_mean.tolist(),
        "std": random_std.tolist(),
        "q0025": random_q025.tolist(),
        "q0975": random_q975.tolist(),
        "q0005": random_q005.tolist(),
        "q0995": random_q995.tolist(),
        "pusula_empirical_percentile": random_percentile.tolist(),
        "positive_fraction": random_positive_fraction.tolist(),
    },

    "comparison": {
        "pusula_minus_random_mean": pusula_minus_random.tolist(),
        "pusula_positive_layers": pusula_positive_layers,
        "random_mean_positive_layers": random_mean_positive_layers,
        "probe_pair_positive_count": probe_pair_positive.tolist(),
        "probe_pair_positive_fraction": probe_pair_fraction_positive.tolist(),
    },

    "reference_previous_97A": {
        "note": "Previous TEST 97A results are treated as historical reference; "
                "they are not regenerated in this run."
    }
}

# -----------------------------------------------------------------------------
# 18. SONUÇ TABLOSU
# -----------------------------------------------------------------------------

print()
print("=" * 112)
print("TEST 97A-B — LAYERWISE SONUÇ")
print("=" * 112)

header = (
    "Layer | "
    "TrainMargin | "
    "ProbeMargin | "
    "RelContrast | "
    "LOOmean | "
    "LOOstd | "
    "NullMean | "
    "NullStd | "
    "Pusula-Null | "
    "Probe+ | "
    "EmpPct"
)

print(header)
print("-" * 112)

for l in range(N_LAYERS):

    print(
        f"L{l:02d}   | "
        f"{train_margin[l].item(): .6f}   | "
        f"{probe_margin[l].item(): .6f}   | "
        f"{relative_contrast[l].item(): .6f}   | "
        f"{loo_mean[l].item(): .6f} | "
        f"{loo_std[l].item(): .6f} | "
        f"{random_mean[l].item(): .6f} | "
        f"{random_std[l].item(): .6f} | "
        f"{pusula_minus_random[l].item(): .6f}   | "
        f"{int(probe_pair_positive[l].item())}/{n_probe}   | "
        f"{random_percentile[l].item(): .4f}"
    )

# -----------------------------------------------------------------------------
# 19. GENEL ÖZET
# -----------------------------------------------------------------------------

overall_probe_margin = probe_margin.mean().item()
overall_random_margin = random_mean.mean().item()
overall_difference = pusula_minus_random.mean().item()

overall_relative_contrast = relative_contrast.mean().item()
overall_loo_mean = loo_mean.mean().item()
overall_loo_std = loo_std.mean().item()

print()
print("=" * 78)
print("GENEL ÖZET")
print("=" * 78)

print(f"Bağımsız probe ortalama Pusula marjini : {overall_probe_margin:+.8f}")
print(f"Random-null ortalama marjin            : {overall_random_margin:+.8f}")
print(f"Pusula - random farkı                  : {overall_difference:+.8f}")
print(f"Ortalama göreli kontrast               : {overall_relative_contrast:.8f}")
print(f"Ortalama LOO cosine                    : {overall_loo_mean:.8f}")
print(f"Ortalama LOO std                        : {overall_loo_std:.8f}")
print(f"Pusula pozitif layer                    : {pusula_positive_layers}/{N_LAYERS}")
print(f"Random-null ortalaması pozitif layer   : "
      f"{random_mean_positive_layers}/{N_LAYERS}")

print()
print("Bağımsız probe çiftlerinde layer başına pozitif oran:")
print(
    [round(x, 3) for x in probe_pair_fraction_positive.tolist()]
)

# -----------------------------------------------------------------------------
# 20. EN ÖNEMLİ NOT
# -----------------------------------------------------------------------------

print()
print("=" * 78)
print("YORUM KURALI")
print("=" * 78)

print(
    "Bu hücre otomatik olarak 'BAŞARILI/BAŞARISIZ' kararı vermiyor."
)
print(
    "Pusula, bağımsız probe ve random-null dağılımı birlikte değerlendirilecek."
)
print(
    "Sonuçlar sonraki testin girdisi olarak RESULTS sözlüğünde tutuluyor."
)

# -----------------------------------------------------------------------------
# 21. KAYDETME
# -----------------------------------------------------------------------------

# Tensorları da sonraki deneylerde yeniden model forward almadan kullanabilmek
# için CPU üzerinde saklıyoruz.
torch.save(
    {
        "train_above_act": train_above_act,
        "train_below_act": train_below_act,
        "probe_above_act": probe_above_act,
        "probe_below_act": probe_below_act,
        "pusula": pusula,
        "raw_pusula": raw_pusula,
        "results": RESULTS,
    },
    "TEST_97A_B_ACTIVATIONS.pt"
)

with open(
    "TEST_97A_B_RESULTS.json",
    "w",
    encoding="utf-8"
) as f:
    json.dump(
        RESULTS,
        f,
        ensure_ascii=False,
        indent=2
    )

print()
print("Dosyalar oluşturuldu:")
print("  TEST_97A_B_ACTIVATIONS.pt")
print("  TEST_97A_B_RESULTS.json")
print()
print("TEST 97A-B TAMAMLANDI.")
