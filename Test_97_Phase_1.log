        for x in HUMAN_METIN
    ]
)

# -----------------------------------------------------------------------------
# İNSAN KAVRAMI İÇİN BASİT LEXICAL KONTROL
#
# Bu ANA ölçüt değildir.
# Sadece aktivasyon sonucunun yüzeyde de bir karşılığı var mı diye yardımcı
# gözlem olarak tutulur.
# -----------------------------------------------------------------------------

HUMAN_WORDS = {
    "human",
    "person",
    "man",
    "woman",
    "people",
    "pedestrian",
    "walker",
    "he",
    "she",
    "his",
    "her"
}

def human_lexical_count(t):

    words = re.findall(
        r"[A-Za-z]+",
        t.lower()
    )

    return sum(
        w in HUMAN_WORDS
        for w in words
    )


BASE_LEX = [
    human_lexical_count(x)
    for x in TABAN_METIN
]

HUMAN_LEX = [
    human_lexical_count(x)
    for x in HUMAN_METIN
]

# -----------------------------------------------------------------------------
# MOTOR KAYDI
# -----------------------------------------------------------------------------

MOTOR_COS = []
MOTOR_ZARF = []
MOTOR_KATKI = []

for i in range(len(HUMAN_LOG)):

    log = HUMAN_LOG[i]

    if log is None:
        MOTOR_COS.append(None)
        MOTOR_ZARF.append(None)
        MOTOR_KATKI.append(None)
        continue

    # katman 0 için:
    MOTOR_COS.append(
        [row[0] for row in log]
    )

    MOTOR_ZARF.append(
        [row[1] for row in log]
    )

    MOTOR_KATKI.append(
        [row[5] for row in log]
    )

