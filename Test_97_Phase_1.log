# -----------------------------------------------------------------------------
# KALİTE KARŞILAŞTIRMASI
# -----------------------------------------------------------------------------

TABAN_KALITE = [
    kalite_kirilim(
        TABAN_METIN[i],
        TABAN_KELIME[i]
    )
    for i in range(len(P_TETIK))
]

HUMAN_KALITE = [
    kalite_kirilim(
        HUMAN_METIN[i],
        TABAN_KELIME[i]
    )
    for i in range(len(P_TETIK))
]

# -----------------------------------------------------------------------------
# İNSAN VEKTÖRÜNE BAĞLANTI ÖLÇÜMÜ
#
# Üretimden sonra metni tekrar modelden geçiriyoruz.
# Böylece:
#
#   TABAN metni       -> insan yönüne cosine
#   HUMAN metni       -> insan yönüne cosine
#
# ayrı ayrı ölçülüyor.
#
# NET COS = HUMAN - TABAN
#
# Pozitif değer, aktivasyonların insan vektörüne doğru kaydığını gösterir.
# -----------------------------------------------------------------------------

print("\n[7/8] Bağımsız aktivasyon / cosine ölçümü...")

@torch.no_grad()
def metin_cosine(t):

    h = oku(
        "<|im_start|>system\n"
        f"{CTX_BRIDGE}"
        "<|im_end|>\n"
        "<|im_start|>user\n"
        f"{t}"
        "<|im_end|>\n"
        "<|im_start|>assistant\n"
    )

    out = {}

    for li in range(N_LAYERS):

        hv = F.normalize(
            h[li],
            dim=0
        )

        v = F.normalize(
            V_HUMAN[li],
            dim=0
        )

        out[li] = float(
            torch.dot(hv, v)
        )

    return out


BASE_COS = []
HUMAN_COS = []

for i in range(len(P_TETIK)):

    print(
        f"  cosine {i:02d}/{len(P_TETIK)-1}"
    )

    BASE_COS.append(
        metin_cosine(
            TABAN_METIN[i]
        )
    )

    HUMAN_COS.append(
        metin_cosine(
            HUMAN_METIN[i]
        )
    )

# -----------------------------------------------------------------------------
# NET COS HESABI
# -----------------------------------------------------------------------------

NET_COS = []

for i in range(len(P_TETIK)):

    NET_COS.append({

        li:
        HUMAN_COS[i][li]
        -
        BASE_COS[i][li]

        for li in range(N_LAYERS)
    })

# Her katman için ortalama
NET_COS_LAYER = {

    li:
    statistics.mean(
        [
            NET_COS[p][li]
            for p in range(len(P_TETIK))
        ]
    )

    for li in range(N_LAYERS)
}

# En güçlü pozitif katman
EN_GUCLU_LAYER = max(
    NET_COS_LAYER,
    key=NET_COS_LAYER.get
)

NET_COS_ORT = statistics.mean(
    [
        x
        for d in NET_COS
        for x in d.values()
    ]
)

NET_COS_MAX = max(
    [
        x
        for d in NET_COS
        for x in d.values()
    ]
)

NET_COS_MIN = min(
    [
        x
        for d in NET_COS
        for x in d.values()
    ]
)

