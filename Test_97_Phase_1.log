# KALİTE İSTATİSTİKLERİ
# -----------------------------------------------------------------------------

TABAN_KALITE_ORT = statistics.mean(
    [x["kalite"] for x in TABAN_KALITE]
)

HUMAN_KALITE_ORT = statistics.mean(
    [x["kalite"] for x in HUMAN_KALITE]
)

KALITE_DEGISIMI = (
    HUMAN_KALITE_ORT
    -
    TABAN_KALITE_ORT
)

TABAN_ORTH = statistics.mean(
    [x["bozulma"] for x in TABAN_KALITE]
)

HUMAN_ORTH = statistics.mean(
    [x["bozulma"] for x in HUMAN_KALITE]
)

TABAN_TEKRAR = statistics.mean(
    [x["tekrar"] for x in TABAN_KALITE]
)

HUMAN_TEKRAR = statistics.mean(
    [x["tekrar"] for x in HUMAN_KALITE]
)

TABAN_COKUS = statistics.mean(
    [x["uzunluk_cokusu"] for x in TABAN_KALITE]
)

HUMAN_COKUS = statistics.mean(
    [x["uzunluk_cokusu"] for x in HUMAN_KALITE]
)

TABAN_LEN = statistics.mean(
