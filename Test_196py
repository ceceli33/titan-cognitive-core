print("\n[22/28] Bootstrap pooled coverage→cosine correlation...")
def boot_corr(x,y,n=N_BOOT,seed=196):
    x=np.asarray(x,float);y=np.asarray(y,float);rng=np.random.default_rng(seed);z=[]
    N=len(x)
    for _ in range(n):
        ix=rng.integers(0,N,N)
        r=pearson(x[ix],y[ix])
        if np.isfinite(r):z.append(r)
    z=np.asarray(z)
    return pearson(x,y),float(np.quantile(z,.025)),float(np.quantile(z,.975))
