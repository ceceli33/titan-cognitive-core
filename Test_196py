            PRE[L].append(.5*(P["pre"][L]-M["pre"][L]))
            RAW[L].append(.5*(P["raw"][L]-M["raw"][L]))
        print(f"       {axis} {label} {i}/8")
    return {L:torch.stack(PRE[L]) for L in TAIL},{L:torch.stack(RAW[L]) for L in TAIL}
