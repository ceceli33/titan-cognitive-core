# =============================================================================
# 4. STATIC DRA ENVELOPE
# =============================================================================

def dra_envelope(L):
    t = float(L)
    kb = ZIRVE * math.exp(-SONUM * t) * (1.0 + SONUM * t) + TABAN
    return kb / (ZIRVE + TABAN)

ENVELOPE = [dra_envelope(L) for L in range(N_LAYERS)]

print("\nStatic normalized DRA envelope:")
for L, env in enumerate(ENVELOPE):
    print(
        f"  L{L:02d}: E={env:.6f} | "
        f"dose={100 * IVME * env:.3f}%"
    )

# =============================================================================
# 5. ACTIVATION COLLECTION
# =============================================================================

@torch.inference_mode()
def collect_hidden_samples(texts):
    samples = [[] for _ in range(N_LAYERS)]

    for text in texts:
        enc = tokenizer(
            text,
            return_tensors="pt",
            add_special_tokens=True
        ).to(DEVICE)

        out = model(
            **enc,
            output_hidden_states=True,
            use_cache=False,
            return_dict=True
        )

        pos = int(enc["attention_mask"][0].sum().item()) - 1

        for L in range(N_LAYERS):
            samples[L].append(
                out.hidden_states[L + 1][0, pos].float().detach()
            )

        del out, enc

    return [torch.stack(x).float() for x in samples]


print("\n[3/8] Extracting matched activation samples...")

positive_samples = collect_hidden_samples(POSITIVE)
negative_samples = collect_hidden_samples(NEGATIVE)

# =============================================================================
# 6. COMPOSITE COMPASS FOUNDRY
# =============================================================================

print("\n[4/8] Composite Compass Foundry...")

actuators = []
fisher_compasses = []
bank_compasses = []
foundry_telemetry = []

for L in range(N_LAYERS):

    Hp = positive_samples[L].float()
    Hn = negative_samples[L].float()

    mu_p = Hp.mean(0)
    mu_n = Hn.mean(0)
    mean_diff = mu_p - mu_n

    # -------------------------------------------------------------------------
    # 3.1 SUBSPACE-FISHER REFERENCE
    # -------------------------------------------------------------------------

    R = torch.cat([
        Hp - mu_p,
        Hn - mu_n
    ], dim=0).float()

    nu = max(int(R.shape[0]) - 2, 1)

    _, S, Vh = torch.linalg.svd(
        R,
        full_matrices=False
    )

    eig = S.square() / float(nu)
    positive_eig = eig[eig > FISHER_EPS]

    eig_scale = (
        torch.median(positive_eig)
        if positive_eig.numel()
        else torch.tensor(1.0, device=DEVICE)
    )

    lam = (
        FISHER_ALPHA * eig_scale
    ).clamp_min(FISHER_EPS)

    V = Vh.T
    projection = V.T @ mean_diff

    correction = (
        (1.0 / (eig + lam) - 1.0 / lam)
        * projection
    )

    fisher = (
        mean_diff / lam
        + V @ correction
    )

    fisher = (
        fisher
        / fisher.norm().clamp_min(FISHER_EPS)
    ).float().contiguous()

    # -------------------------------------------------------------------------
    # 3.2 MATCHED BANK CENTROID
    # -------------------------------------------------------------------------

    pair_dirs = Hp - Hn
    pair_dirs = pair_dirs / pair_dirs.norm(
        dim=-1,
        keepdim=True
    ).clamp_min(FISHER_EPS)

    # Put all matched directions in Fisher's positive hemisphere.
    orientation = pair_dirs @ fisher
    pair_dirs = pair_dirs * torch.where(
        orientation[:, None] < 0,
        -torch.ones_like(orientation[:, None]),
        torch.ones_like(orientation[:, None])
    )

    bank = pair_dirs.mean(0)
    bank = (
        bank
        / bank.norm().clamp_min(FISHER_EPS)
    ).float().contiguous()

    # -------------------------------------------------------------------------
    # FISHER → BANK DECOMPOSITION
    # -------------------------------------------------------------------------

    c = torch.dot(fisher, bank).clamp(-1.0, 1.0)

    if c < 0:
        bank = -bank
        c = -c

    residual_raw = bank - c * fisher
    residual_norm = residual_raw.norm()

    if residual_norm > FISHER_EPS:
        residual = residual_raw / residual_norm
    else:
        residual = torch.zeros_like(fisher)

    # -------------------------------------------------------------------------
    # COMPOSITE COMPASS
    #
    # c*F + beta*sqrt(1-c²)*R
    #
    # beta=1 reconstructs BANK exactly.
    # beta=0 retains Fisher's component direction and normalizes back to F.
    # -------------------------------------------------------------------------

    orth_weight = torch.sqrt(
        torch.clamp(1.0 - c.square(), min=0.0)
    )

    composite = (
        c * fisher
        + BETA * orth_weight * residual
    )

    composite = (
        composite
        / composite.norm().clamp_min(FISHER_EPS)
    ).float().contiguous()

    bank_reconstruction_cos = float(
        torch.dot(composite, bank).item()
    )

    # Effective rank diagnostic.
    threshold = (
        S.max()
        * max(R.shape)
        * torch.finfo(S.dtype).eps
    )

    rank = int((S > threshold).sum().item())

    fisher_compasses.append(fisher)
    bank_compasses.append(bank)
    actuators.append(composite)

    foundry_telemetry.append({
        "rank": rank,
        "lambda": float(lam.item()),
        "fisher_bank_cos": float(c.item()),
        "bank_residual_norm": float(residual_norm.item()),
        "orth_weight": float(orth_weight.item()),
        "composite_bank_cos": bank_reconstruction_cos,
        "unit_norm": float(composite.norm().item()),
    })

    print(
        f"  L{L:02d} | "
        f"rank={rank:02d} | "
        f"cos(F,B)={c.item():+.6f} | "
        f"B⊥F={residual_norm.item():.6f} | "
        f"beta={BETA:.2f} | "
        f"cos(A,B)={bank_reconstruction_cos:.9f}"
    )

del positive_samples, negative_samples
gc.collect()
torch.cuda.empty_cache()

mean_fb = sum(
    x["fisher_bank_cos"]
    for x in foundry_telemetry
) / N_LAYERS

mean_residual = sum(
    x["bank_residual_norm"]
    for x in foundry_telemetry
) / N_LAYERS

mean_reconstruction = sum(
    x["composite_bank_cos"]
    for x in foundry_telemetry
) / N_LAYERS

print(f"\nMean cos(Fisher,BANK)   : {mean_fb:+.6f}")
print(f"Mean BANK residual norm : {mean_residual:.6f}")
print(f"Mean cos(Composite,BANK): {mean_reconstruction:.9f}")

