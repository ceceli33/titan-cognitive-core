CPP_SOURCE = r"""
#include <torch/extension.h>

torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
);

torch::Tensor seasc_inject(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {
    TORCH_CHECK(hidden.is_cuda(), "hidden must be CUDA");
    TORCH_CHECK(actuator.is_cuda(), "actuator must be CUDA");
    TORCH_CHECK(hidden.dim() == 3, "hidden must be [B,S,H]");
    TORCH_CHECK(actuator.dim() == 1, "actuator must be [H]");
    TORCH_CHECK(hidden.size(2) == actuator.size(0), "hidden mismatch");
    TORCH_CHECK(relative_dose >= 0.0, "relative_dose must be non-negative");

    return seasc_inject_cuda(hidden, actuator, relative_dose);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def(
        "seasc_inject",
        &seasc_inject,
        "AkbasCore 3.2 SEASC frozen-norm injection"
    );
}
"""

CUDA_SOURCE = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAException.h>
#include <cuda.h>
#include <cuda_runtime.h>

template <typename scalar_t>
__global__ void seasc_kernel(
    scalar_t* __restrict__ h,
    const float* __restrict__ actuator,
    const int H,
    const int N,
    const float dose
) {
    const int vec = blockIdx.x;
    if (vec >= N) return;

    extern __shared__ float shared[];
    const long long base =
        static_cast<long long>(vec) * static_cast<long long>(H);

    float sum = 0.0f;

    for (int j = threadIdx.x; j < H; j += blockDim.x) {
        const float x = static_cast<float>(h[base + j]);
        sum += x * x;
    }

    shared[threadIdx.x] = sum;
    __syncthreads();

    for (unsigned int s = blockDim.x / 2; s > 0; s >>= 1) {
        if (threadIdx.x < s)
            shared[threadIdx.x] += shared[threadIdx.x + s];
        __syncthreads();
    }

    const float norm0 = sqrtf(fmaxf(shared[0], 1.0e-20f));
    const float scale = dose * norm0;

    __syncthreads();

    for (int j = threadIdx.x; j < H; j += blockDim.x) {
        const float old = static_cast<float>(h[base + j]);
        h[base + j] =
            static_cast<scalar_t>(old + scale * actuator[j]);
    }
}

torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {
    auto out = hidden.contiguous().clone();
    auto act = actuator.to(hidden.device(), torch::kFloat32).contiguous();

    const int H = static_cast<int>(out.size(2));
    const int N = static_cast<int>(out.numel() / H);

    constexpr int THREADS = 256;
    const size_t shared_bytes = THREADS * sizeof(float);
    cudaStream_t stream = at::cuda::getCurrentCUDAStream();

    AT_DISPATCH_FLOATING_TYPES_AND2(
        at::ScalarType::Half,
        at::ScalarType::BFloat16,
        out.scalar_type(),
        "akbascore_seasc_v32_cuda",
        [&] {
            seasc_kernel<scalar_t>
            <<<N, THREADS, shared_bytes, stream>>>(
                out.data_ptr<scalar_t>(),
                act.data_ptr<float>(),
                H,
                N,
                static_cast<float>(relative_dose)
            );
        }
    );

    C10_CUDA_KERNEL_LAUNCH_CHECK();
    return out;
}
"""

