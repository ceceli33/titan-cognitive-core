PROMPT_LENGTH = inputs["input_ids"].shape[1]

def repetition_ratio(ids, n):
    ids = list(map(int, ids))
    if len(ids) < n:
        return 0.0
    grams = [tuple(ids[i:i+n]) for i in range(len(ids)-n+1)]
    return 1.0 - len(set(grams)) / max(len(grams), 1)

def loop_ratio_4gram(ids):
    ids = list(map(int, ids))
    if len(ids) < 4:
        return 0.0
    grams = [tuple(ids[i:i+4]) for i in range(len(ids)-3)]
    counts = Counter(grams)
    repeated = sum(max(0, n-1) for n in counts.values())
    return repeated / max(len(grams), 1)

@torch.inference_mode()
def generate_run(name, steering=False):

    handles = []
    telemetry = [
        {"requested": [], "realized": [], "norm_change": []}
        for _ in range(N_LAYERS)
    ]

    if steering:

        for L in range(N_LAYERS):

            actuator = actuators[L]
            dose = IVME * ENVELOPE[L]

            def make_hook(li, a, d):

                def hook(module, args, output):

                    if isinstance(output, tuple):
                        old, rest = output[0], output[1:]
                    else:
                        old, rest = output, None

                    new = seasc_ext.seasc_inject(
                        old,
                        a,
                        float(d)
                    )

                    x = old[:, -1, :].float()
                    y = new[:, -1, :].float()

                    dx = y - x

                    n0 = x.norm(dim=-1).clamp_min(1e-12)
                    n1 = y.norm(dim=-1)

                    realized = dx.norm(dim=-1) / n0
                    norm_change = (n1 - n0).abs() / n0

                    telemetry[li]["requested"].append(float(d))
                    telemetry[li]["realized"].append(
                        float(realized.mean().item())
                    )
                    telemetry[li]["norm_change"].append(
                        float(norm_change.mean().item())
                    )

                    return new if rest is None else (new,) + rest

                return hook

            handles.append(
                layers[L].register_forward_hook(
                    make_hook(L, actuator, dose)
                )
            )

    try:
        torch.cuda.synchronize()
        start = time.perf_counter()

        generated = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            repetition_penalty=REPETITION_PENALTY,
            use_cache=True,
            pad_token_id=tokenizer.pad_token_id,
            eos_token_id=tokenizer.eos_token_id,
        )

        torch.cuda.synchronize()
        elapsed = time.perf_counter() - start

    finally:
        for h in handles:
            h.remove()

    ids = generated[0, PROMPT_LENGTH:].detach().cpu().tolist()
    text = tokenizer.decode(ids, skip_special_tokens=True)

    result = {
        "name": name,
        "text": text,
        "tokens": len(ids),
        "seconds": elapsed,
        "tok_s": len(ids) / max(elapsed, 1e-12),
        "rep2": repetition_ratio(ids, 2),
        "rep3": repetition_ratio(ids, 3),
        "rep4": repetition_ratio(ids, 4),
        "loop4": loop_ratio_4gram(ids),
        "telemetry": telemetry,
    }

    if steering:
        req, real, nc = [], [], []

        for t in telemetry:
            req.extend(t["requested"])
            real.extend(t["realized"])
            nc.extend(t["norm_change"])

        result["requested_mean"] = sum(req) / len(req)
        result["realized_mean"] = sum(real) / len(real)
        result["norm_change_mean"] = sum(nc) / len(nc)

    del generated
    gc.collect()
    torch.cuda.empty_cache()

    return result

print("\n[5/8] Running BASELINE...")
baseline = generate_run("BASELINE", False)

print("[6/8] Running AkbasCore 3.2...")
seasc = generate_run("AKBASCORE 3.2", True)

