# =============================================================================
# 11. BASELINE
#
# Her promptun L0-L19 son-token hidden durumlarını bir kez kaydediyoruz.
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = out[0] if isinstance(out, tuple) else out

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li].register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(
            **enc,
            use_cache=False
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. TEK GEÇİŞ PROBU
#
# Örnek:
#
#   L11 çıktısına küçük v11 ekle
#   sadece L12'de ne olduğuna bak
#
# Sonraki katmanlara hiçbir ek müdahale yapılmaz.
# =============================================================================

@torch.no_grad()
def one_step_probe(
    prompt,
    baseline,
    source_layer,
    direction
):

    target_layer = source_layer + 1

    src_base = baseline[source_layer].float()

    requested_norm = (
        PROBE_REL *
        float(torch.linalg.vector_norm(src_base))
    )

    q = F.normalize(
        direction.float(),
        dim=0
    ).to(device)

    capture = {}
    source_delta = {}

    handles = []

    def source_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        before = h[0, -1].float()

        requested = before + requested_norm * q

        hnew = h.clone()

        # BF16'ya gerçekten yazılan perturbasyonu ayrıca ölçüyoruz.
        hnew[0, -1] = requested.to(h.dtype)

        realized = (
            hnew[0, -1].float() -
            before
        )

        source_delta["d"] = (
            realized
            .detach()
            .cpu()
            .clone()
        )

        if isinstance(out, tuple):
            return (hnew,) + out[1:]

        return hnew

    def target_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        capture["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[source_layer]
            .register_forward_hook(source_hook)
        )

        handles.append(
            model.model.layers[target_layer]
            .register_forward_hook(target_hook)
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(
            **enc,
            use_cache=False
        )

    finally:

        for h in handles:
            h.remove()

    ds = source_delta["d"]

    dt = (
        capture["h"] -
        baseline[target_layer]
    )

    realized_norm = float(
        torch.linalg.vector_norm(ds)
    )

    target_norm = float(
        torch.linalg.vector_norm(dt)
    )

    # Gerçek BF16 müdahalesinin istenen yöne ne kadar sadık kaldığı.
    realized_dir_cos = cosine(
        ds,
        direction
    )

    gain = (
        target_norm /
        (realized_norm + EPS)
    )

    return {
        "delta_source": ds,
        "delta_target": dt,

        "requested_relative":
            requested_norm /
            (
                float(
                    torch.linalg.vector_norm(
                        src_base
                    )
                ) + EPS
            ),

        "realized_relative":
            realized_norm /
            (
                float(
                    torch.linalg.vector_norm(
                        src_base
                    )
                ) + EPS
            ),

        "realized_direction_cos":
            realized_dir_cos,

        "gain":
            gain,
    }


# =============================================================================
# 13. RANDOM KONTROL
#
# Her prompt ve katman için bağımsız rastgele yönler.
# =============================================================================

def random_direction(prompt_index, layer, random_index):

    g = torch.Generator(device="cpu")

    g.manual_seed(
        SEED
        + 100000 * prompt_index
        + 1000 * layer
        + random_index
    )

    r = torch.randn(
        HIDDEN,
        generator=g,
        dtype=torch.float32
    )

    return F.normalize(r, dim=0)


