def normalize(v):
    v = v.float()
    n = torch.linalg.vector_norm(v)

    if float(n.item()) < EPS:
        return None

    return v / n


def cosine(a, b):
    a = a.float()
    b = b.float()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if float(na.item()) < EPS or float(nb.item()) < EPS:
        return float("nan")

    return float(torch.dot(a, b) / (na * nb))


def stats(x):
    x = np.asarray(x, dtype=np.float64)
    x = x[np.isfinite(x)]

    if len(x) == 0:
        return {
            "n": 0,
            "mean": float("nan"),
            "sd": float("nan"),
            "ci95_descriptive": [float("nan"), float("nan")],
            "positive_fraction": float("nan"),
        }

    mean = float(np.mean(x))
    sd = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0
    se = sd / math.sqrt(len(x)) if len(x) > 1 else 0.0

    return {
        "n": len(x),
        "mean": mean,
        "sd": sd,
        "ci95_descriptive": [
            float(mean - 1.96 * se),
            float(mean + 1.96 * se)
        ],
        "positive_fraction": float(np.mean(x > 0)),
        "min": float(np.min(x)),
        "max": float(np.max(x)),
    }


def ci_text(s):
    return (
        f"[{s['ci95_descriptive'][0]:+.5f},"
        f"{s['ci95_descriptive'][1]:+.5f}]"
    )


