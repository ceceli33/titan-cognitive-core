cos11 = cosine(A11, B11)

drift10 = abs(cos10 - EXPECTED_COS10)
drift11 = abs(cos11 - EXPECTED_COS11)

print(f"L10 cos(A,B) = {cos10:+.6f} | drift {drift10:.3e}")
print(f"L11 cos(A,B) = {cos11:+.6f} | drift {drift11:.3e}")

if drift10 > FINGERPRINT_TOL or drift11 > FINGERPRINT_TOL:
    raise RuntimeError("Fingerprint FAILED.")

print("Fingerprint: PASS")

