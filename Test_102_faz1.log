    for li in SOURCE_LAYERS:

        target = li + 1

        # -------------------------------------------------------------
        # SEMANTIC
        # v_l modelin doğal geçişine bırakılır.
        # -------------------------------------------------------------

        sem = one_step_probe(
            prompt,
            baseline,
            li,
            DIBEK[li]
        )

        ds = sem["delta_source"]
        dt = sem["delta_target"]

        sem_metrics = {
            "A_next":
                cosine(
                    dt,
                    DIBEK[target]
                ),

            "A_same":
                cosine(
                    dt,
                    DIBEK[li]
                ),

            "source_alignment":
                cosine(
                    ds,
                    DIBEK[li]
                ),

            "gain":
                sem["gain"],

            "requested_relative":
                sem["requested_relative"],

            "realized_relative":
                sem["realized_relative"],

            "realized_direction_cos":
                sem["realized_direction_cos"],
        }

        # -------------------------------------------------------------
        # SYNTHETIC
        # Aynı Test-94 vektörü bu geçişte ne kadar taşınıyor?
        # -------------------------------------------------------------

        syn = one_step_probe(
            prompt,
            baseline,
            li,
            SYNTH
        )

        syn_dt = syn["delta_target"]

        synth_metrics = {
            "self":
                cosine(
                    syn_dt,
                    SYNTH
                ),

            "dibek_next":
                cosine(
                    syn_dt,
                    DIBEK[target]
                ),

            "gain":
                syn["gain"],

            "realized_relative":
                syn["realized_relative"],

            "realized_direction_cos":
                syn["realized_direction_cos"],
        }

        # -------------------------------------------------------------
        # RANDOM NULL
        # Aynı büyüklükte rastgele perturbasyonların dağılımı.
        # -------------------------------------------------------------

        random_rows = []

        for ri in range(N_RANDOM):

            rd = random_direction(
                pi + 1,
                li,
                ri
            )

            rr = one_step_probe(
                prompt,
                baseline,
                li,
                rd
            )

            rdt = rr["delta_target"]

            random_rows.append({
                "self":
                    cosine(
                        rdt,
                        rd
                    ),

                "dibek_next":
                    cosine(
                        rdt,
                        DIBEK[target]
                    ),

                "gain":
                    rr["gain"],

                "realized_relative":
                    rr["realized_relative"],

                "realized_direction_cos":
                    rr["realized_direction_cos"],
            })

        random_next = np.asarray(
            [
                r["dibek_next"]
                for r in random_rows
            ],
            dtype=np.float64
        )

        random_self = np.asarray(
            [
                r["self"]
                for r in random_rows
            ],
            dtype=np.float64
        )

        random_gain = np.asarray(
            [
                r["gain"]
                for r in random_rows
            ],
            dtype=np.float64
        )

        # Semantic vektörün random null'a göre avantajı.
        sem_metrics["delta_vs_random_next"] = (
            sem_metrics["A_next"]
            - float(np.mean(random_next))
        )

        sem_metrics["random_next_mean"] = float(
            np.mean(random_next)
        )

        sem_metrics["random_next_sd"] = float(
            np.std(
                random_next,
                ddof=1
            )
        )

        sem_metrics["random_self_mean"] = float(
            np.mean(random_self)
        )

        sem_metrics["random_gain_mean"] = float(
            np.mean(random_gain)
        )

        prompt_result["layers"][str(li)] = {
            "source": li,
            "target": target,
            "semantic": sem_metrics,
            "synthetic": synth_metrics,
            "random": random_rows,
        }

    RAW.append(prompt_result)

    if (pi + 1) % 5 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(PROMPTS)} "
        f"| elapsed {(time.time()-start)/60:.1f} min",
        end="\r"
    )

print(
    f"\nTransport taraması tamamlandı "
    f"({(time.time()-start)/60:.1f} min)"
)


# =============================================================================
# 15. KATMAN BAZLI ANALİZ
# =============================================================================

print("\n[6/15] Katman bazlı transport haritası hazırlanıyor...")


def collect_sem(layer, key, context=None):

    out = []

    for r in RAW:

        if context is not None and r["context"] != context:
            continue

        out.append(
            r["layers"][str(layer)]
            ["semantic"][key]
        )

    return np.asarray(
        out,
        dtype=np.float64
    )


def collect_syn(layer, key, context=None):

    out = []

    for r in RAW:

        if context is not None and r["context"] != context:
            continue

        out.append(
            r["layers"][str(layer)]
            ["synthetic"][key]
        )

    return np.asarray(
        out,
        dtype=np.float64
    )


LAYER_SUMMARY = {}

for li in SOURCE_LAYERS:

    target = li + 1

    A_next = collect_sem(
        li,
        "A_next"
    )

    A_same = collect_sem(
        li,
        "A_same"
    )

    delta_random = collect_sem(
        li,
        "delta_vs_random_next"
    )

    gain = collect_sem(
        li,
        "gain"
    )

    realized_rel = collect_sem(
        li,
        "realized_relative"
    )

    realized_dir = collect_sem(
        li,
        "realized_direction_cos"
    )

    synth_self = collect_syn(
        li,
        "self"
    )

    synth_dibek = collect_syn(
        li,
        "dibek_next"
    )

    # Sözlük geometrisi:
    # v_l ile v_(l+1) zaten ne kadar benziyor?
    dictionary_cos = cosine(
        DIBEK[li],
        DIBEK[target]
    )

    LAYER_SUMMARY[str(li)] = {
        "source": li,
        "target": target,

        "dictionary_cos_vl_vnext":
            dictionary_cos,

        "A_next":
            stats(A_next),

        "A_same":
            stats(A_same),

        "semantic_minus_random_next":
            stats(delta_random),

        "gain":
            stats(gain),

        "realized_relative":
            stats(realized_rel),

        "realized_direction_cos":
            stats(realized_dir),

        "synthetic_self":
            stats(synth_self),

        "synthetic_dibek_next":
            stats(synth_dibek),

        "ZOO_A_next":
            stats(
                collect_sem(
                    li,
                    "A_next",
                    "ZOO"
                )
            ),

        "NEUTRAL_A_next":
            stats(
                collect_sem(
                    li,
                    "A_next",
                    "NEUTRAL"
                )
            ),
    }


# =============================================================================
# 16. ANA TABLO
# =============================================================================

print("\n[7/15] SEMANTIC TRANSPORT CHAIN")
print("=" * 150)

print(
    f"{'STEP':<10}"
    f"{'cos(vl,vn)':>13}"
    f"{'A_next':>12}"
    f"{'A_same':>12}"
    f"{'Δ vs RAND':>13}"
    f"{'GAIN':>11}"
    f"{'SYN self':>12}"
    f"{'SYN→Dibek':>13}"
)

print("-" * 150)

for li in SOURCE_LAYERS:

    s = LAYER_SUMMARY[str(li)]

    print(
        f"L{li}->L{li+1:<4}"
        f"{s['dictionary_cos_vl_vnext']:>+13.5f}"
        f"{s['A_next']['mean']:>+12.5f}"
        f"{s['A_same']['mean']:>+12.5f}"
        f"{s['semantic_minus_random_next']['mean']:>+13.5f}"
        f"{s['gain']['mean']:>11.4f}"
        f"{s['synthetic_self']['mean']:>+12.5f}"
        f"{s['synthetic_dibek_next']['mean']:>+13.5f}"
    )


# =============================================================================
# 17. BF16 AKTÜATÖR DENETİMİ
# =============================================================================

print("\n[8/15] BF16 perturbation integrity...")

all_rel = []
all_dir = []

for li in SOURCE_LAYERS:

    all_rel.extend(
        collect_sem(
            li,
            "realized_relative"
        ).tolist()
    )

    all_dir.extend(
        collect_sem(
            li,
            "realized_direction_cos"
        ).tolist()
    )

REL_STATS = stats(all_rel)
DIR_STATS = stats(all_dir)

print(
    f"Requested relative = {PROBE_REL:.7f}"
)

print(
    f"Realized relative  = "
    f"{REL_STATS['mean']:.7f} ± "
    f"{REL_STATS['sd']:.7f}"
)

print(
    f"Realized dir cos   = "
    f"{DIR_STATS['mean']:+.6f} ± "
    f"{DIR_STATS['sd']:.6f}"
)


# =============================================================================
# 18. ZOO / NÖTR
# =============================================================================

print("\n[9/15] Bağlam etkisi...")

CTX_DIFFS = []

for li in SOURCE_LAYERS:

    s = LAYER_SUMMARY[str(li)]

    z = s["ZOO_A_next"]["mean"]
    n = s["NEUTRAL_A_next"]["mean"]

    CTX_DIFFS.append(z - n)

    print(
        f"L{li:02d}->L{li+1:02d} | "
        f"ZOO={z:+.5f} | "
        f"NEUTRAL={n:+.5f} | "
        f"Δ={z-n:+.5f}"
    )

CTX_STATS = stats(CTX_DIFFS)

print(
    f"\nKatmanlar boyunca ortalama "
    f"ZOO−NEUTRAL = "
    f"{CTX_STATS['mean']:+.6f}"
)


# =============================================================================
# 19. ZİNCİR ÖZETİ
# =============================================================================

print("\n[10/15] Zincir özeti...")

CHAIN_NEXT = np.asarray([
    LAYER_SUMMARY[str(li)]["A_next"]["mean"]
    for li in SOURCE_LAYERS
])

CHAIN_RANDOM_ADV = np.asarray([
    LAYER_SUMMARY[str(li)]
    ["semantic_minus_random_next"]["mean"]
    for li in SOURCE_LAYERS
])

CHAIN_DICT = np.asarray([
    LAYER_SUMMARY[str(li)]
    ["dictionary_cos_vl_vnext"]
    for li in SOURCE_LAYERS
])

CHAIN_SYNTH_DIBEK = np.asarray([
    LAYER_SUMMARY[str(li)]
    ["synthetic_dibek_next"]["mean"]
    for li in SOURCE_LAYERS
])

print(
    f"Mean semantic A_next     = "
    f"{np.mean(CHAIN_NEXT):+.6f}"
)

print(
    f"Mean semantic−random     = "
    f"{np.mean(CHAIN_RANDOM_ADV):+.6f}"
)

print(
    f"Positive semantic steps  = "
    f"{np.mean(CHAIN_NEXT > 0):.3f}"
)

print(
    f"Semantic > random steps  = "
    f"{np.mean(CHAIN_RANDOM_ADV > 0):.3f}"
)

print(
    f"Mean dictionary cos      = "
    f"{np.mean(CHAIN_DICT):+.6f}"
)

print(
    f"Mean SYNTH→Dibek         = "
    f"{np.mean(CHAIN_SYNTH_DIBEK):+.6f}"
)


# =============================================================================
# 20. KRİTİK KARŞILAŞTIRMA
#
# Eğer A_next yalnızca cos(v_l,v_l+1)'i kopyalıyorsa,
# gördüğümüz şey büyük ölçüde sözlük geometrisi olabilir.
#
# Eğer transport davranışı bundan ayrılıyorsa,
# transition operatörünün ek yapısı araştırılmaya değer.
# =============================================================================

print("\n[11/15] Representation geometry vs transport response...")

if (
    np.std(CHAIN_DICT) > 1e-12 and
    np.std(CHAIN_NEXT) > 1e-12
):

    corr_dict_transport = float(
        np.corrcoef(
            CHAIN_DICT,
            CHAIN_NEXT
        )[0, 1]
    )

else:

    corr_dict_transport = float("nan")

print(
    f"corr[ cos(v_l,v_l+1), A_next ] = "
    f"{corr_dict_transport:+.6f}"
)

print(
    "Bu korelasyon tek başına nedensellik veya "
    "transport operatörü tanımlamaz."
)


# =============================================================================
# 21. EN GÜÇLÜ / EN ZAYIF GEÇİŞLER
# =============================================================================

print("\n[12/15] En güçlü ve en zayıf semantic geçişler...")

order = np.argsort(
    -CHAIN_RANDOM_ADV
)

print("\nEn güçlü 5:")

for idx in order[:5]:

    li = SOURCE_LAYERS[int(idx)]

    print(
        f"  L{li}->L{li+1} | "
        f"A_next="
        f"{LAYER_SUMMARY[str(li)]['A_next']['mean']:+.5f} | "
        f"Δrandom="
        f"{LAYER_SUMMARY[str(li)]['semantic_minus_random_next']['mean']:+.5f}"
    )

print("\nEn zayıf 5:")

for idx in order[-5:]:

    li = SOURCE_LAYERS[int(idx)]

    print(
        f"  L{li}->L{li+1} | "
        f"A_next="
        f"{LAYER_SUMMARY[str(li)]['A_next']['mean']:+.5f} | "
        f"Δrandom="
        f"{LAYER_SUMMARY[str(li)]['semantic_minus_random_next']['mean']:+.5f}"
    )


# =============================================================================
# 22. KARAR
#
# Bu karar yalnızca "semantic transition zinciri var mı?"
# sorusuna aittir.
# =============================================================================

print("\n[13/15] PHASE-II DECISION")
print("=" * 150)

step_positive_fraction = float(
    np.mean(
        CHAIN_RANDOM_ADV > 0
    )
)

mean_adv = float(
    np.mean(
        CHAIN_RANDOM_ADV
    )
)

if (
    mean_adv > 0.05 and
    step_positive_fraction >= 0.80
):

    DECISION = (
        "SEMANTIC_TRANSPORT_CHAIN_DEMONSTRATED"
    )

elif (
    mean_adv > 0 and
    step_positive_fraction >= 0.60
):

    DECISION = (
        "SEMANTIC_TRANSPORT_CHAIN_PARTIAL"
    )

else:

    DECISION = (
        "SEMANTIC_TRANSPORT_CHAIN_NOT_DEMONSTRATED"
    )

print(
    f"Mean semantic−random advantage = "
    f"{mean_adv:+.6f}"
)

print(
    f"Positive transition fraction   = "
    f"{step_positive_fraction:.3f}"
)

print(
    f"\nDECISION: {DECISION}"
)


