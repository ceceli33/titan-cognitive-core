print("\n[4/15] Test 94 sentetik kontrol vektörü oluşturuluyor...")


def build_synth_t94():

    rng = random.Random(42)

    def l2n(v):

        n = math.sqrt(sum(x * x for x in v))

        return [x / n for x in v]

    vectors = []

    for _ in range(4):

        vectors.append(
            l2n([
                rng.gauss(0, 1)
                for _ in range(HIDDEN)
            ])
        )

    weights = [
        0.9228,
        0.9372,
        0.8788,
        0.9196
    ]

    raw = [0.0] * HIDDEN

    for vec, w in zip(vectors, weights):

        for i in range(HIDDEN):
            raw[i] += vec[i] * w

    return l2n(raw)


SYNTH = torch.tensor(
    build_synth_t94(),
    dtype=torch.float32
)

SYNTH = F.normalize(SYNTH, dim=0)

print("SYNTH norm =", float(torch.linalg.vector_norm(SYNTH)))

print(
