print("="*78)
print("  SORU 1: İSMİ BAĞLAMA KOYMAK REDDETMEYİ BİTİRDİ Mİ?")
print("="*78)
print("  Aşama 5'in asıl başarısızlığı: model 'fictional species' diyordu.\n")
print(f"    {'alpha':<8}{'bağlam YOK':>16}{'bağlam VAR':>16}   fark")
print("    " + "-"*50)
for a in ALPHAS:
    r0 = R[f"ctx0_a{a}"]["ozet"]["reddetme"]
    r1 = R[f"ctx1_a{a}"]["ozet"]["reddetme"]
    print(f"    {a:<8.2f}{r0[0]:>10.2f}±{r0[1]:<4.1f}{r1[0]:>10.2f}±{r1[1]:<4.1f}"
          f"   {r1[0]-r0[0]:+.2f}")
r0m = statistics.mean([R[f"ctx0_a{a}"]["ozet"]["reddetme"][0] for a in ALPHAS])
r1m = statistics.mean([R[f"ctx1_a{a}"]["ozet"]["reddetme"][0] for a in ALPHAS])
print(f"\n    Ortalama: bağlamsız={r0m:.2f}  bağlamlı={r1m:.2f}")
if r1m < r0m * 0.5:
    print("    ✅ Bağlam reddetmeyi büyük ölçüde bitirdi.")
elif r1m < r0m:
    print("    ⚠️ Kısmen azalttı ama bitirmedi.")
else:
    print("    ❌ Bağlam da işe yaramadı -- model ismi kabul etmiyor.")

print("\n" + "="*78)
print("  SORU 2: STEERING ANATOMİYİ GETİRİYOR MU? (asıl bilimsel soru)")
print("="*78)
print("  Bağlam ismi veriyor ama anatomiden HİÇ bahsetmiyor. O yüzden")
print("  alpha arttıkça maymungil/anatomi artıyorsa, bu STEERING'in eseri.\n")
for ctx in CONTEXTS:
    print(f"    --- bağlam {'VAR' if ctx else 'YOK'} ---")
    print(f"      {'alpha':<8}{'maymungil':>14}{'anatomi':>14}{'insansı':>12}{'yabancı':>12}")
    for a in ALPHAS:
        o = R[f"ctx{int(ctx)}_a{a}"]["ozet"]
        print(f"      {a:<8.2f}{o['maymungil'][0]:>8.1f}±{o['maymungil'][1]:<5.1f}"
              f"{o['anatomi'][0]:>8.1f}±{o['anatomi'][1]:<5.1f}"
              f"{o['insansi'][0]:>12.1f}{o['yabanci'][0]:>12.1f}")
    # eğilim: alpha=0 -> en yüksek alpha
    d_m = (R[f"ctx{int(ctx)}_a{ALPHAS[-1]}"]["ozet"]["maymungil"][0]
           - R[f"ctx{int(ctx)}_a{ALPHAS[0]}"]["ozet"]["maymungil"][0])
    d_a = (R[f"ctx{int(ctx)}_a{ALPHAS[-1]}"]["ozet"]["anatomi"][0]
           - R[f"ctx{int(ctx)}_a{ALPHAS[0]}"]["ozet"]["anatomi"][0])
    print(f"      Δ(alpha 0 -> {ALPHAS[-1]}): maymungil {d_m:+.1f}, anatomi {d_a:+.1f}")
    # yayılıma göre anlamlı mı?
    s = R[f"ctx{int(ctx)}_a{ALPHAS[-1]}"]["ozet"]["maymungil"][1]
    print(f"      (yayılım ±{s:.1f} -- fark yayılımdan "
          f"{'BÜYÜK ✅' if abs(d_m) > s else 'küçük, anlamsız ❌'})")
    print()

