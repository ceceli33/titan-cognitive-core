def bozulma_skoru(t):
    if not t.strip(): return 1.0
    toks = t.split(); n = len(toks)
    cop   = sum(1 for x in toks if not re.search(r'[^\W\d_]{2,}', x)) / n
    sym   = len(re.findall(r'[—\[\]\|\$#~=]', t)) / max(1, len(t))
    kirik = sum(1 for x in toks if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]', x)) / n
    return max(cop, sym*6, kirik*4)

def latin_disi(t):
    L = re.findall(r'[^\W\d_]', t)
    return sum(1 for c in L if ord(c) > 0x2000) / max(1, len(L))

# YENİ: reddetme dedektörü -- Aşama 5'in asıl başarısızlığı buydu
RED_KALIP = [
    "does not correspond", "does not exist", "no known species",
    "not a known", "fictional", "made-up", "made up", "imaginary",
    "hypothetical", "if we were to imagine", "if we were to create",
    "i do not have any", "no reliable information", "appears to be a fictional",
    "böyle bir hayvan", "bilgi veremiyorum", "hayali", "kurgusal",
]
def reddetme(t):
    low = t.lower()
    return sum(1 for k in RED_KALIP if k in low)

