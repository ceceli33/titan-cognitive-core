# En iyi ayarı seç: reddetme düşük + maymungil/anatomi yüksek + sızıntı düşük
print("="*78)
print("  GENEL PUAN")
print("="*78)
print(f"    {'bağlam':<9}{'alpha':<8}{'puan':>8}   (maymun*2 + anat - red*3 - sızıntı*2)")
print("    " + "-"*62)
best = None
for ctx in CONTEXTS:
    for a in ALPHAS:
        o = R[f"ctx{int(ctx)}_a{a}"]["ozet"]
        if o["bozulma_hedef"] > 0.15 or o["bozulma_kontrol"] > 0.15:
            print(f"    {'VAR' if ctx else 'YOK':<9}{a:<8.2f}{'BOZUK':>8}")
            continue
        p = (o["maymungil"][0]*2 + o["anatomi"][0]
             - o["reddetme"][0]*3 - o["sizinti_kontrol"][0]*2)
        print(f"    {'VAR' if ctx else 'YOK':<9}{a:<8.2f}{p:>8.1f}")
        if best is None or p > best[0]: best = (p, ctx, a)
if best:
    print(f"\n    ✅ EN İYİ: bağlam={'VAR' if best[1] else 'YOK'}, alpha={best[2]:.2f}"
          f" (puan={best[0]:.1f})")
    bk = f"ctx{int(best[1])}_a{best[2]}"
    print("\n" + "="*78)
    print(f"  ÖRNEK ÇIKTILAR ({'bağlam VAR' if best[1] else 'bağlam YOK'}, alpha={best[2]})")
    print("="*78)
    for d in R[bk]["hedef"][:3]:
        print(f"\n─── {d['soru']}\n{d['text'][:900]}")
    print(f"\n─── KONTROL: {R[bk]['kontrol'][0]['soru']}")
    print(R[bk]["kontrol"][0]["text"][:600])

