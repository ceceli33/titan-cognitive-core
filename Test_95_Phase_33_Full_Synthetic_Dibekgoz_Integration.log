         "thumb","thumbs","grasping","grip"]
ANTI_K=["tail","tails","tailed","prehensile","quadruped","quadrupedal",
        "four-legged","all fours","snout","muzzle","paws","claws",
        "prosimian","lemur","monkey","monkeys","hooves","scales"]
def say(t,ws):
    low=" "+t.lower()+" "; return sum(low.count(" "+w) for w in ws)
def sahne(d):
    """SAHNE = köprü + fırtına (manifestonun iki bileşeni)"""
    return d["kopru"]+d["firtina"]

P_BIR  =(yigin([msk(V_BIR)]),   yigin([V_BIR]))
P_DIB  =(yigin([msk(V_DIBEK)]), yigin([V_DIBEK]))
P_RAST =(yigin([msk(V_RAST)]),  yigin([V_RAST]))
P_CIFT =(yigin([msk(V_FIR),msk(V_DIBEK)]), yigin([V_FIR,V_DIBEK]))

# ad: (bağlam, prompt seti, paket, ivmeler)
KOLLAR={
 # ===== TABAN KONTROLLERİ (enjeksiyon YOK) — her bağlam × her prompt =====
 "00_TABAN_B0_notr":      ("B0","N",None,   None),
 "01_TABAN_B0_tetik":     ("B0","T",None,   None),
 "02_TABAN_B1_tetik":     ("B1","T",None,   None),
 "03_TABAN_B2_tetik":     ("B2","T",None,   None),
 # ===== BİRLEŞİK VEKTÖR × BAĞLAM MERDİVENİ (tetikleyici prompt) =====
 "04_BIR_B0_tetik_0.15":  ("B0","T",P_BIR, [0.15]),
 "05_BIR_B1_tetik_0.15":  ("B1","T",P_BIR, [0.15]),
 "06_BIR_B1_tetik_0.20":  ("B1","T",P_BIR, [0.20]),
 "07_BIR_B2_tetik_0.15":  ("B2","T",P_BIR, [0.15]),
 # ===== SAF VEKTÖR TESTİ (nötr prompt, sahne sadece vektörden gelmeli) =====
 "08_BIR_B0_notr_0.15":   ("B0","N",P_BIR, [0.15]),
 "09_BIR_B1_notr_0.15":   ("B1","N",P_BIR, [0.15]),
 # ===== KONTROL: iki ayrı eksen (Aşama 14 kıyası) =====
 "10_CIFT_B1_tetik_0.15": ("B1","T",P_CIFT,[0.15,0.15]),
 # ===== KONTROL: sadece dibek (sahne bileşeni yok) =====
 "11_DIB_B1_tetik_0.15":  ("B1","T",P_DIB, [0.15]),
 # ===== NEGATİF KONTROL =====
 "12_RAST_B1_tetik_0.15": ("B1","T",P_RAST,[0.15]),
}

R_("="*78); R_("  ÜRETİM (13 kol × 4 prompt)"); R_("="*78)
R_(f"    {'kol':<26}{'bağ':>4}{'pr':>4}{'köprü':>7}{'fırt':>6}{'SAHNE':>7}"
   f"{'hedef':>7}{'anti':>6}{'NET':>6}{'KALİTE':>8}")
R_("    "+"-"*81)
RES={}; t0=time.time()
for ad,(bg,pr,pak,ivl) in KOLLAR.items():
    try:
        ctx=BAGLAM[bg]; sor=P_NOTR if pr=="N" else P_TETIK
        outs,lg0=[],None
        for i,q in enumerate(sor):
            if pak is None: t_,lg=uret(ctx,q)
            else:           t_,lg=uret(ctx,q,pu=pak[0],hd=pak[1],ivmeler=ivl)
            outs.append(t_)
            if i==0: lg0=lg
        d={"bag":bg,"prompt":pr,"ivme":ivl,
           "kopru":statistics.mean([say(o,KOPRU_K) for o in outs]),
           "firtina":statistics.mean([say(o,FIRTINA_K) for o in outs]),
           "hedef":statistics.mean([say(o,HEDEF_K) for o in outs]),
           "anti":statistics.mean([say(o,ANTI_K) for o in outs]),
           "bozulma":statistics.mean([bozulma(o) for o in outs]),
           "tekrar":statistics.mean([tekrar(o) for o in outs]),
           "kalite":statistics.mean([kalite(o) for o in outs]),
           "latin_disi":statistics.mean([latin_disi(o) for o in outs]),
           "oran_L0":float(lg0[0,5]) if lg0 is not None else float('nan'),
           "log":(lg0.tolist() if lg0 is not None else None),"texts":outs}
        d["net"]=d["hedef"]-d["anti"]; d["sahne"]=sahne(d)
        RES[ad]=d
        R_(f"    {ad:<26}{bg:>4}{pr:>4}{d['kopru']:>7.1f}{d['firtina']:>6.1f}"
           f"{d['sahne']:>7.1f}{d['hedef']:>7.1f}{d['anti']:>6.1f}"
           f"{d['net']:>+6.1f}{d['kalite']:>8.3f}")
    except Exception as ex:
        RES[ad]={"hata":f"{type(ex).__name__}: {ex}"}
        R_(f"    {ad:<26}  ❌ {type(ex).__name__}: {ex}")
R_(f"\n  ✅ üretim {time.time()-t0:.0f} sn\n")
def ok(a): return a in RES and "hata" not in RES[a]

# ========================== DEĞERLENDİRME ====================================
R_("="*78); R_("  SORU 1: MANİFESTO VEKTÖRDEN Mİ GELİYOR? (Δ = steered - taban)")
R_("="*78)
R_("    ⚠️ Tetikleyici prompt tek başına da sahne yazdırır. Ölçüt: FARK.")
R_(f"    {'karşılaştırma':<34}{'SAHNE':>8}{'ΔSAHNE':>9}{'NET':>7}{'ΔNET':>8}")
R_("    "+"-"*66)
for st,tb,et in [("04_BIR_B0_tetik_0.15","01_TABAN_B0_tetik","B0 tetik"),
                 ("05_BIR_B1_tetik_0.15","02_TABAN_B1_tetik","B1 tetik"),
                 ("07_BIR_B2_tetik_0.15","03_TABAN_B2_tetik","B2 tetik"),
                 ("08_BIR_B0_notr_0.15", "00_TABAN_B0_notr", "B0 nötr")]:
    if ok(st) and ok(tb):
        a,b=RES[st],RES[tb]
        R_(f"    {et+' (taban->steered)':<34}"
           f"{b['sahne']:.1f}->{a['sahne']:.1f}{a['sahne']-b['sahne']:>+9.1f}"
           f"{a['net']:>+7.1f}{a['net']-b['net']:>+8.1f}")
_kazanan=[]
for st,tb in [("04_BIR_B0_tetik_0.15","01_TABAN_B0_tetik"),
              ("05_BIR_B1_tetik_0.15","02_TABAN_B1_tetik"),
              ("07_BIR_B2_tetik_0.15","03_TABAN_B2_tetik"),
              ("08_BIR_B0_notr_0.15","00_TABAN_B0_notr")]:
    if ok(st) and ok(tb) and RES[st]["kalite"]<0.15:
        _kazanan.append((st,RES[st]["net"]-RES[tb]["net"],
                            RES[st]["sahne"]-RES[tb]["sahne"]))
if _kazanan:
    _b=max(_kazanan,key=lambda x:x[1])
    R_(f"\n    En yüksek ΔNET: {_b[0]} -> ΔNET={_b[1]:+.1f} ΔSAHNE={_b[2]:+.1f}")
    if _b[1]>=2.0:
        R_("    ✅ VEKTÖR KATKISI GERÇEK — yaratık özellikleri tabanın üstünde.")
    elif _b[1]>0:
        R_("    · küçük ama pozitif katkı.")
    else:
        R_("    ❌ tetikleyici prompt tek başına yeterli; vektör katkı eklemiyor.")

R_("\n"+"="*78); R_("  SORU 2: BAĞLAM MERDİVENİ — NE KADAR ZEMİN GEREKİYOR?")
R_("="*78)
R_(f"    {'bağlam':<8}{'taban SAHNE':>13}{'steered SAHNE':>15}{'taban NET':>11}"
   f"{'steered NET':>13}")
R_("    "+"-"*62)
for bg,tb,st in [("B0","01_TABAN_B0_tetik","04_BIR_B0_tetik_0.15"),
                 ("B1","02_TABAN_B1_tetik","05_BIR_B1_tetik_0.15"),
                 ("B2","03_TABAN_B2_tetik","07_BIR_B2_tetik_0.15")]:
    if ok(tb) and ok(st):
        a,b=RES[tb],RES[st]
        R_(f"    {bg:<8}{a['sahne']:>13.1f}{b['sahne']:>15.1f}"
           f"{a['net']:>+11.1f}{b['net']:>+13.1f}")
R_("    (B0 nötr | B1 gece+köprü ima, fırtına YOK | B2 sahne açık)")

R_("\n"+"="*78); R_("  SORU 3: BİRLEŞİK VEKTÖR vs İKİ AYRI EKSEN"); R_("="*78)
for ad,et in [("05_BIR_B1_tetik_0.15","birleşik tek vektör"),
              ("10_CIFT_B1_tetik_0.15","iki ayrı eksen (sqrt2 bütçe)"),
              ("11_DIB_B1_tetik_0.15","sadece dibek"),
              ("02_TABAN_B1_tetik","taban (enjeksiyon yok)")]:
    if ok(ad):
        d=RES[ad]
        R_(f"    {et:<32} SAHNE={d['sahne']:.1f} NET={d['net']:+.1f} "
           f"kalite={d['kalite']:.3f}")
if ok("05_BIR_B1_tetik_0.15") and ok("10_CIFT_B1_tetik_0.15"):
    a,b=RES["05_BIR_B1_tetik_0.15"],RES["10_CIFT_B1_tetik_0.15"]
    R_("    "+("✅ birleşik vektör iki eksenden İYİ — Aşama 14'ün bütçe kaybı doğrulandı"
               if a["net"]>b["net"]+1.0 or a["sahne"]>b["sahne"]+1.0
               else "· iki yaklaşım benzer"))

R_("\n"+"="*78); R_("  SORU 4: NEGATİF KONTROL"); R_("="*78)
for ad in ["12_RAST_B1_tetik_0.15","02_TABAN_B1_tetik","05_BIR_B1_tetik_0.15"]:
    if ok(ad):
        d=RES[ad]
        R_(f"    {ad:<26} SAHNE={d['sahne']:.1f} NET={d['net']:+.1f} "
           f"kalite={d['kalite']:.3f}")
if ok("05_BIR_B1_tetik_0.15") and ok("12_RAST_B1_tetik_0.15"):
    R_("    "+("✅ birleşik rastgeleden ayrışıyor"
               if RES["05_BIR_B1_tetik_0.15"]["net"]
                  > RES["12_RAST_B1_tetik_0.15"]["net"]+1.5
               else "⚠️ rastgeleden ayrışma zayıf"))

R_("\n"+"="*78); R_("  MANİFESTO METİNLERİ (tam ilk çıktı)"); R_("="*78)
for ad in ["02_TABAN_B1_tetik","05_BIR_B1_tetik_0.15","06_BIR_B1_tetik_0.20",
           "07_BIR_B2_tetik_0.15","08_BIR_B0_notr_0.15"]:
    if ok(ad):
        d=RES[ad]
        R_(f"\n─── {ad} (SAHNE {d['sahne']:.1f}, NET {d['net']:+.1f}, "
           f"kalite {d['kalite']:.3f})")
        R_(d["texts"][0][:700])

