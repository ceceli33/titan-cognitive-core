# 30. FORMAL DECISION
# =============================================================================

print(
    "\n[15/24] FORMAL DECISION"
)

print("=" * 190)


SUPPORTED_HORIZONS = []
RANK_ONLY_HORIZONS = []


for k in valid_horizons:

    h = P_H[
        str(k)
    ]


    nav_positive = (
        h[
            "sem"
        ]["ci95"][0]
        >
        0
    )


    beats_random = (
        h[
            "sem_minus_rnd"
        ]["ci95"][0]
        >
        0
    )


    rho_mean = (
        h[
            "rho"
        ]["mean"]
    )


    rho_positive = (
        np.isfinite(
            rho_mean
        )
        and
        rho_mean > 0.10
    )


    if (
        nav_positive
        and
        beats_random
        and
        rho_positive
    ):

        SUPPORTED_HORIZONS.append(
            k
        )


    elif rho_positive:

        RANK_ONLY_HORIZONS.append(
            k
        )


if len(
    SUPPORTED_HORIZONS
) > 0:

    earliest_supported = min(
        SUPPORTED_HORIZONS
    )

    DECISION = (
        "PRETERMINAL_HORIZON_AWARE_"
        "RADAR_SIGNAL_SUPPORTED"
    )

    NEXT_BRANCH = (
        "FREEZE_EARLIEST_SUPPORTED_HORIZON_"
        "AND_RUN_FRESH_BLIND_REPLICATION"
    )


elif len(
    RANK_ONLY_HORIZONS
) > 0:

    earliest_supported = None

    DECISION = (
        "PRETERMINAL_RANK_INFORMATION_"
        "WITHOUT_PROSPECTIVE_GAIN"
    )

    NEXT_BRANCH = (
        "DO_NOT_CHAIN_YET__"
        "REPLICATE_HORIZON_RANK_STRUCTURE"
    )


else:

    earliest_supported = None

    DECISION = (
        "NO_ROBUST_PRETERMINAL_"
        "HORIZON_SIGNAL"
    )

    NEXT_BRANCH = (
        "PIVOT_AWAY_FROM_DIRECTION_RADAR_"
        "TOWARD_GAIN_DOSE_RADAR"
    )


print(
    f"Supported horizons : "
    f"{SUPPORTED_HORIZONS}"
)

print(
    f"Rank-only horizons : "
    f"{RANK_ONLY_HORIZONS}"
)

print(
    f"DECISION           : "
    f"{DECISION}"
)

print(
    f"NEXT               : "
    f"{NEXT_BRANCH}"
)


