# =============================================================================
# 35. JSON SAFE
# =============================================================================

def json_safe(o):

    if isinstance(
        o,
        np.integer,
    ):
        return int(o)


    if isinstance(
        o,
        np.floating,
    ):
        return float(o)


    if isinstance(
        o,
        np.ndarray,
    ):
        return o.tolist()


    if torch.is_tensor(o):

        return {
            "shape":
                list(o.shape),

            "dtype":
                str(o.dtype),
        }


    if isinstance(
        o,
        dict,
    ):

        return {
            str(k):
                json_safe(v)
            for k, v in
            o.items()
        }


    if isinstance(
        o,
        (list, tuple),
    ):

        return [
            json_safe(v)
            for v in o
        ]


    return o


