    )


    for k in layer[
        "probe_offsets"
    ]:

        counts = np.zeros(
            N_SEMANTIC,
            dtype=np.int64,
        )


        for row in layer[
            "rows"
        ]:

            sid = int(
                row[
                    "sem_selected"
                ][str(k)]
            )

            counts[sid] += 1


        modal = int(
            np.argmax(
                counts
            )
        )


        item = {

            "counts":
                counts.tolist(),

            "unique":
                int(
                    (
                        counts > 0
                    ).sum()
                ),

            "modal_fraction":
                float(
                    counts.max()
                    /
                    N_PROMPTS
                ),

            "modal_label":
                SEM_LABELS[
                    modal
                ],
        }


        DIVERSITY[
            str(li)
        ][str(k)] = item


        print(
            f"  +{k}: "
            f"unique="
            f"{item['unique']}/16 | "
            f"modal="
            f"{item['modal_fraction']:.2f} | "
            f"{item['modal_label']}"
        )


