# 25. PROMPT CLUSTER BOOTSTRAP — PRIMARY PRETERMINAL
# =============================================================================

print(
    "\n[10/24] PRIMARY PRETERMINAL "
    "PROMPT-CLUSTER BOOTSTRAP"
)


PRIMARY_HORIZON = {}


for rel in ACT_DOSES:

    PRIMARY_HORIZON[
        str(rel)
    ] = {}


    print()
    print(
        "-" * 150
    )

    print(
        f"ACT DOSE {rel}"
        +
        (
            " <- PRIMARY"
            if rel
            ==
            ACT_PRIMARY
            else ""
        )
    )


    for k in PROBE_OFFSETS:

        pp_sem = {
            i: []
            for i in range(
                N_PROMPTS
            )
        }

        pp_rnd = {
            i: []
            for i in range(
                N_PROMPTS
            )
        }

        pp_diff = {
            i: []
            for i in range(
                N_PROMPTS
            )
        }

        pp_rho = {
            i: []
            for i in range(
                N_PROMPTS
            )
        }


        for layer in RESULTS:

            li = layer[
                "source_layer"
            ]


            if not preterminal_probe(
                li,
                k,
            ):
                continue


            if (
                k
                not in
                layer["probe_offsets"]
            ):
                continue


            for row in layer[
                "rows"
            ]:

                pi = row[
                    "prompt_index"
                ]


                h = (
                    row[
                        "doses"
                    ][str(rel)][
                        "horizon_eval"
                    ][k]
                )


                pp_sem[pi].append(
                    h[
                        "sem_sel_delta"
                    ]
                )

                pp_rnd[pi].append(
                    h[
                        "rnd_sel_delta"
                    ]
                )

                pp_diff[pi].append(
                    h[
                        "sem_minus_rnd"
                    ]
                )

                pp_rho[pi].append(
                    h[
                        "sem_terminal_spearman"
                    ]
                )


        def prompt_means(d):

            vals = []

            for i in range(
                N_PROMPTS
            ):

                if len(d[i]) > 0:

                    vals.append(
                        float(
                            np.mean(
                                d[i]
                            )
                        )
                    )

            return vals


        sem_pm = prompt_means(
            pp_sem
        )

        rnd_pm = prompt_means(
            pp_rnd
        )

        diff_pm = prompt_means(
            pp_diff
        )

        rho_pm = prompt_means(
            pp_rho
        )


        if len(
            sem_pm
        ) == 0:
            continue


        seed_base = (
            137_000
            +
            int(
                rel * 1000
            )
            +
            k * 100
        )


        B_sem = (
            cluster_bootstrap(
                sem_pm,
                seed_base + 1,
            )
        )

        B_rnd = (
            cluster_bootstrap(
                rnd_pm,
                seed_base + 2,
            )
        )

        B_diff = (
            cluster_bootstrap(
                diff_pm,
                seed_base + 3,
            )
        )

        B_rho = (
            cluster_bootstrap(
                rho_pm,
                seed_base + 4,
            )
        )


        PRIMARY_HORIZON[
            str(rel)
        ][str(k)] = {

            "sem":
                B_sem,

            "rnd":
                B_rnd,

            "sem_minus_rnd":
                B_diff,

            "rho":
                B_rho,

            "prompt_sem":
                sem_pm,

            "prompt_rnd":
                rnd_pm,

            "prompt_diff":
                diff_pm,

            "prompt_rho":
                rho_pm,
        }


        print()
        print(
            f"  FP32 PROBE +{k}"
        )

        print(
            f"    SEM Δ       : "
            f"{B_sem['mean']:+.6f} "
            f"{fmt_ci(B_sem)}"
        )

        print(
            f"    RANDOM Δ    : "
            f"{B_rnd['mean']:+.6f} "
            f"{fmt_ci(B_rnd)}"
        )

        print(
            f"    SEM-RANDOM  : "
            f"{B_diff['mean']:+.6f} "
            f"{fmt_ci(B_diff)}"
        )

        print(
            f"    terminal rho: "
            f"{B_rho['mean']:+.4f} "
            f"{fmt_ci(B_rho)}"
        )


