# =============================================================================
# 12. EQUAL-ANGLE SEMANTIC ATLAS
# =============================================================================

print(
    "\n[5/24] Equal-angle semantic atlas..."
)


theta = math.radians(
    SHELL_DEG
)


SEM_ATLAS = {}
SEM_NATURAL_ANGLES = {}


for li in SOURCE_LAYERS:

    v = unit(
        DIBEK[li]
    )

    rows = []
    nat = []


    for cid in range(
        N_SEMANTIC
    ):

        w = unit(
            SEM_DICTS[cid][li]
        )

        raw_cos = cos(
            w,
            v,
        )


        if raw_cos > IDENTITY_TOL:

            raise RuntimeError(
                f"L{li} candidate "
                f"{cid} identity collapse."
            )


        tangent = (
            w
            -
            torch.dot(
                w,
                v,
            ) * v
        )


        if float(
            torch.linalg.vector_norm(
                tangent
            ).item()
        ) <= 1e-8:

            raise RuntimeError(
                f"L{li} candidate "
                f"{cid} tangent collapse."
            )


        tangent = unit(
            tangent
        )


        q = unit(
            math.cos(theta) * v
            +
            math.sin(theta) * tangent
        )


        na = angle(
            w,
            v,
        )


        rows.append({
            "id": cid,
            "label":
                SEM_LABELS[cid],
            "q": q,
            "raw_cos":
                raw_cos,
            "natural_angle":
                na,
            "requested_angle":
                angle(q, v),
        })


        nat.append(
            na
        )


    SEM_ATLAS[li] = rows
    SEM_NATURAL_ANGLES[li] = nat


    print(
        f"  L{li:02d}: "
        f"requested="
        f"{np.mean([x['requested_angle'] for x in rows]):.4f}° | "
        f"natural=["
        f"{min(nat):.2f}°, "
        f"{max(nat):.2f}°] "
        f"mean={np.mean(nat):.2f}°"
    )


# =============================================================================
# 13. RANDOM SHELL
# =============================================================================

print(
    "\n[6/24] Random shell..."
)


RND_ATLAS = {}


for li in SOURCE_LAYERS:

    v = unit(
        DIBEK[li]
    )

    rows = []


    for cid in range(
        N_RANDOM
    ):

        g = torch.Generator(
            device="cpu"
        )

        g.manual_seed(
            SEED
            +
            1_000_000
            +
            li * 1000
            +
            cid
        )


        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )


        z = (
            z
            -
            torch.dot(z, v) * v
        )


        z = unit(z)


        q = unit(
            math.cos(theta) * v
            +
            math.sin(theta) * z
        )


        rows.append({
            "id": cid,
            "q": q,
        })


    RND_ATLAS[li] = rows


# =============================================================================
# 14. NULL
# =============================================================================

def make_null_dirs(
    li,
    pi,
):

    v = unit(
        DIBEK[li]
    )

    out = []


    for nid in range(
        N_NULL
    ):

        g = torch.Generator(
            device="cpu"
        )

        g.manual_seed(
            SEED
            +
            7_000_000
            +
            100_000 * pi
            +
            1000 * li
            +
            nid
        )


        z = torch.randn(
            HIDDEN,
            generator=g,
            dtype=torch.float32,
        )


        z = (
            z
            -
            torch.dot(z, v) * v
        )


        z = unit(z)


        out.append(
            unit(
                v
                +
                NULL_JITTER_REL * z
            )
        )


    return out


# =============================================================================
# 15. HORIZON HELPERS
# =============================================================================

def valid_probe_offsets(
    source_li
):

    return [
        k
        for k in PROBE_OFFSETS
        if source_li + k <= 19
    ]


def preterminal_probe(
    source_li,
    k,
):

    # L18 excluded from primary terminal inference.
    #
    # source+k == 19 is terminal-touching.
    # Report edilir ama predictive/preterminal primary'e girmez.

    return (
        source_li != 18
        and
        source_li + k < 19
    )


def act_horizons(
    source_li
):

    hs = {
        source_li,
        19,
    }


    for k in valid_probe_offsets(
        source_li
    ):

        hs.add(
            source_li + k
        )


    return sorted(hs)


# =============================================================================
# 16. NESTED CLONE / FP32
# =============================================================================

def clone_nested(x):

    if torch.is_tensor(x):

        return (
            x.detach()
            .clone()
        )


    if isinstance(x, tuple):

        return tuple(
            clone_nested(v)
            for v in x
        )


    if isinstance(x, list):

        return [
            clone_nested(v)
            for v in x
        ]


    if isinstance(x, dict):

        return {
            k: clone_nested(v)
            for k, v in x.items()
        }


    return x


def fp32_nested(x):

    if torch.is_tensor(x):

        if x.is_floating_point():
            return x.float()

        return x


    if isinstance(x, tuple):

        return tuple(
            fp32_nested(v)
            for v in x
        )


    if isinstance(x, list):

        return [
            fp32_nested(v)
            for v in x
        ]


    if isinstance(x, dict):

        return {
            k: fp32_nested(v)
            for k, v in x.items()
        }


    return x


def locate_hidden(
    args,
    kwargs,
):

    if (
        len(args) > 0
        and
        torch.is_tensor(args[0])
        and
        args[0].ndim == 3
    ):

        return (
            "args",
            0,
            args[0],
        )


    if (
        "hidden_states" in kwargs
        and
        torch.is_tensor(
            kwargs["hidden_states"]
        )
    ):

        return (
            "kwargs",
            "hidden_states",
            kwargs["hidden_states"],
        )


    raise RuntimeError(
        "hidden_states bulunamadı."
    )


def set_hidden(
    args,
    kwargs,
    hidden,
):

    args = list(args)
    kwargs = dict(kwargs)


    where, key, _ = locate_hidden(
        args,
        kwargs,
    )


    if where == "args":

        args[key] = hidden

    else:

        kwargs[key] = hidden


    return (
        tuple(args),
        kwargs,
    )


# =============================================================================
# 17. BASELINE + PER-LAYER CALL METADATA
# =============================================================================

@torch.inference_mode()
def baseline_and_calls(
    prompt,
    source_li,
):

    offsets = valid_probe_offsets(
        source_li
    )

    max_offset = max(
        offsets
    )


    needed_outputs = sorted(
        set(
            [source_li, 19]
            +
            [
                source_li + k
                for k in offsets
            ]
        )
    )


    replay_layers = [
        source_li + offset
        for offset in range(
            1,
            max_offset + 1,
        )
    ]


    outputs = {}
    calls = {}

    handles = []


    def make_output_hook(
        lid
    ):

        def hook(
            module,
            args,
            out,
        ):

            h = (
                out[0]
                if isinstance(
                    out,
                    tuple,
                )
                else out
            )


            outputs[lid] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook


    def make_pre_hook(
        lid
    ):

        def hook(
            module,
            args,
            kwargs,
        ):

            calls[lid] = {
                "args":
                    clone_nested(
                        args
                    ),

                "kwargs":
                    clone_nested(
                        kwargs
                    ),
            }

        return hook


    try:

        for lid in needed_outputs:

            handles.append(
                model.model.layers[lid]
                .register_forward_hook(
                    make_output_hook(
                        lid
                    )
                )
            )


        for lid in replay_layers:

            handles.append(
                model.model.layers[lid]
                .register_forward_pre_hook(
                    make_pre_hook(
                        lid
                    ),
                    with_kwargs=True,
                )
            )


        enc = tokenizer(
            prompt,
            return_tensors="pt",
        )


        enc = {
            k: v.to(device)
            for k, v in enc.items()
        }


        model(
            **enc,
            use_cache=False,
        )


    finally:

        for hd in handles:
            hd.remove()


    for lid in replay_layers:

        if lid not in calls:

            raise RuntimeError(
                f"L{lid} forward metadata "
                "yakalanamadı."
            )


    return (
        outputs,
        calls,
    )


# =============================================================================
# 18. SINGLE FP32 BLOCK CALL
# =============================================================================

@torch.inference_mode()
def run_fp32_block(
    block,
    call_meta,
    hidden,
):

    args = fp32_nested(
        call_meta["args"]
    )

    kwargs = fp32_nested(
        call_meta["kwargs"]
    )


    args, kwargs = set_hidden(
        args,
        kwargs,
        hidden,
    )


    if "use_cache" in kwargs:
        kwargs["use_cache"] = False


    out = block(
        *args,
        **kwargs,
    )


    if isinstance(
        out,
        tuple,
    ):

        h = out[0]

    elif hasattr(
        out,
        "last_hidden_state",
    ):

        h = (
            out.last_hidden_state
        )

    else:

        h = out


    return h.float()


# =============================================================================
# 19. MULTI-CANDIDATE FP32 HORIZON RADAR
#
# Tek seferde:
#
# FIXED + 16 SEM + 16 RANDOM = 33 directions
#
# Her direction için:
#
# +eps
# -eps
#
# branch tutulur.
#
# Her decoder katmanı yalnız bir kez FP32'ye kopyalanır.
# =============================================================================

@torch.inference_mode()
def fp32_horizon_radar_all(
    source_li,
    calls,
    directions,
):

    offsets = valid_probe_offsets(
        source_li
    )

    max_offset = max(
        offsets
    )


    first_li = (
        source_li + 1
    )


    base_args = (
        calls[first_li]["args"]
    )

    base_kwargs = (
        calls[first_li]["kwargs"]
    )


    _, _, h_orig = locate_hidden(
        base_args,
        base_kwargs,
    )


    h0 = (
        h_orig
        .detach()
        .float()
        .clone()
    )


    source_norm = float(
        torch.linalg.vector_norm(
            h0[0, -1]
        ).item()
    )


    eps_norm = (
        RADAR_REL
        *
        source_norm
    )


    # -------------------------------------------------------------
    # Initialize +/- branches
    # -------------------------------------------------------------

    branches = []


    for direction in directions:

        q = unit(
            direction
        ).to(
            device=h0.device,
            dtype=torch.float32,
        )


        hp = h0.clone()
        hm = h0.clone()


        hp[0, -1] += (
            eps_norm * q
        )

        hm[0, -1] -= (
            eps_norm * q
        )


        branches.append({
            "hp": hp,
            "hm": hm,
        })


    results = {
        k: {
            "D": [],
            "gain": [],
        }
        for k in offsets
    }


    # -------------------------------------------------------------
    # Walk one FP32 block at a time
    # -------------------------------------------------------------

    for offset in range(
        1,
        max_offset + 1,
    ):

        lid = (
            source_li
            +
            offset
        )


        block_device = (
            next(
                model.model.layers[lid]
                .parameters()
            ).device
        )


        block = (
            copy.deepcopy(
                model.model.layers[lid]
            )
            .to(
                device=block_device,
                dtype=torch.float32,
            )
            .eval()
        )


        for p in block.parameters():
            p.requires_grad_(False)


        call_meta = calls[lid]


        for branch in branches:

            hp = (
                branch["hp"]
                .to(block_device)
            )

            hm = (
                branch["hm"]
                .to(block_device)
            )


            branch["hp"] = (
                run_fp32_block(
                    block,
                    call_meta,
                    hp,
                )
            )


            branch["hm"] = (
                run_fp32_block(
                    block,
                    call_meta,
                    hm,
                )
            )


        # ---------------------------------------------------------
        # Requested horizon reached
        # ---------------------------------------------------------

        if offset in offsets:

            target_v = (
                DIBEK[lid]
            )


            for branch in branches:

                response = (
                    (
                        branch["hp"][0, -1]
                        -
                        branch["hm"][0, -1]
                    )
                    /
                    2.0
                )


                response_cpu = (
                    response
                    .detach()
                    .float()
                    .cpu()
                )


                results[offset][
                    "D"
                ].append(
                    cos(
                        response_cpu,
                        target_v,
                    )
                )


                results[offset][
                    "gain"
                ].append(
                    float(
                        torch.linalg.vector_norm(
                            response_cpu
                        ).item()
                    )
                    /
                    (
                        eps_norm
                        +
                        EPS
                    )
                )


        # ---------------------------------------------------------
        # Delete current FP32 block BEFORE next one
        # ---------------------------------------------------------

        del block

        gc.collect()
        torch.cuda.empty_cache()


    return {
        "eps_norm":
            eps_norm,

        "results":
            results,
    }


# =============================================================================
# 20. BF16 BATCH ACTUATOR
# =============================================================================

@torch.inference_mode()
def full_act_batch(
    prompt,
    source_li,
    directions,
    baseline,
    rel,
):

    B = len(
        directions
    )


    if B == 0:
        raise RuntimeError(
            "Empty direction batch."
        )


    horizons = act_horizons(
        source_li
    )


    q_cpu = torch.stack(
        [
            unit(d)
            for d in directions
        ],
        dim=0,
    )


    q = q_cpu.to(
        device=device,
        dtype=torch.float32,
    )


    src_norm = float(
        torch.linalg.vector_norm(
            baseline[source_li]
        ).item()
    )


    req_norm = (
        rel
        *
        src_norm
    )


    captures = {}
    realized = {}

    handles = []


    def source_hook(
        module,
        args,
        out,
    ):

        h = (
            out[0]
            if isinstance(
                out,
                tuple,
            )
            else out
        )


        hnew = h.clone()


        before = (
            h[:, -1, :]
            .float()
        )


        q_local = q.to(
            before.device
        )


        after = (
            before
            +
            req_norm
            *
            q_local
        )


        hnew[:, -1, :] = (
            after.to(
                dtype=h.dtype
            )
        )


        realized["dx"] = (
            hnew[:, -1, :]
            .float()
            -
            before
        ).detach().cpu()


        if isinstance(
            out,
            tuple,
        ):

            return (
                (hnew,)
                +
                out[1:]
            )


        return hnew


    def make_target_hook(
        lid
    ):

        def hook(
            module,
            args,
            out,
        ):

            h = (
                out[0]
                if isinstance(
                    out,
                    tuple,
                )
                else out
            )


            captures[lid] = (
                h[:, -1, :]
                .detach()
                .float()
                .cpu()
            )

        return hook


    try:

        handles.append(
            model.model.layers[
                source_li
            ]
            .register_forward_hook(
                source_hook
            )
        )


        for lid in horizons:

            if lid == source_li:
                continue

            handles.append(
                model.model.layers[lid]
                .register_forward_hook(
                    make_target_hook(
                        lid
                    )
                )
            )


        enc = tokenizer(
            prompt,
            return_tensors="pt",
        )


        batch_enc = {}


        for k, v in enc.items():

            reps = [
                B
            ] + [
                1
                for _ in range(
                    v.ndim - 1
                )
            ]

            batch_enc[k] = (
                v.repeat(
                    *reps
                )
                .to(device)
            )


        model(
            **batch_enc,
            use_cache=False,
        )


    finally:

        for hd in handles:
            hd.remove()


    if "dx" not in realized:

        raise RuntimeError(
            "BF16 realization "
            "yakalanamadı."
        )


    dx = realized["dx"]


    realized_rel = []
    dir_cos = []
    angle_err = []


    for i in range(B):

        realized_rel.append(
            float(
                torch.linalg.vector_norm(
                    dx[i]
                ).item()
            )
            /
            (
                src_norm
                +
                EPS
            )
        )


        dir_cos.append(
            cos(
                dx[i],
                q_cpu[i],
            )
        )


        angle_err.append(
            angle(
                dx[i],
                q_cpu[i],
            )
        )


    D = {}


    for lid in horizons:

        if lid == source_li:

            # At source layer the intervention itself is dx.
            delta = dx

        else:

            if lid not in captures:

                raise RuntimeError(
                    f"L{lid} capture missing."
                )

            delta = (
                captures[lid]
                -
                baseline[lid]
                .unsqueeze(0)
            )


        D[lid] = [
            cos(
                delta[i],
                DIBEK[lid],
            )
            for i in range(B)
        ]


    return {
        "dx":
            dx,

        "realized_rel":
            realized_rel,

        "dir_cos":
            dir_cos,

        "angle_err":
            angle_err,

        "D":
            D,
    }


# =============================================================================
# 21. MAIN LOOP
# =============================================================================

print(
    "\n[7/24] Main assay..."
)


RESULTS = []

t_main = time.time()


for source_li in SOURCE_LAYERS:

    offsets = valid_probe_offsets(
        source_li
    )


    print()
    print(
        "=" * 100
    )

    print(
        f"SOURCE L{source_li}"
    )

    print(
        f"Probe horizons: {offsets}"
    )


    requested_sem_pair = (
        pair_angle_mean(
            [
                x["q"]
                for x in
                SEM_ATLAS[source_li]
            ]
        )
    )


    layer_rows = []


    for pi, prompt in enumerate(
        PROMPTS
    ):

        # =====================================================================
        # A. BASELINE + REAL PER-LAYER CALL METADATA
        # =====================================================================

        baseline, calls = (
            baseline_and_calls(
                prompt,
                source_li,
            )
        )


        # =====================================================================
        # B. BUILD RADAR DIRECTION LIST
        #
        # index:
        #   0       fixed
        #   1:17    semantic
        #   17:33   random
        # =====================================================================

        radar_dirs = [
            DIBEK[source_li]
        ]


        radar_dirs.extend(
            [
                x["q"]
                for x in
                SEM_ATLAS[source_li]
            ]
        )


        radar_dirs.extend(
            [
                x["q"]
                for x in
                RND_ATLAS[source_li]
            ]
        )


        assert (
            len(radar_dirs)
            ==
            1
            +
            N_SEMANTIC
            +
            N_RANDOM
        )


        # =====================================================================
        # C. FP32 MULTI-HORIZON RADAR
        # =====================================================================

        radar = (
            fp32_horizon_radar_all(
                source_li,
                calls,
                radar_dirs,
            )
        )


        sem_radar = {}
        rnd_radar = {}
        sem_gain = {}
        fixed_radar = {}


        for k in offsets:

            Dvals = np.asarray(
                radar["results"][k]["D"],
                dtype=np.float64,
            )

            Gvals = np.asarray(
                radar["results"][k]["gain"],
                dtype=np.float64,
            )


            fixed_radar[k] = float(
                Dvals[0]
            )


            sem_radar[k] = (
                Dvals[
                    1:
                    1 + N_SEMANTIC
                ]
            )


            rnd_radar[k] = (
                Dvals[
                    1 + N_SEMANTIC:
                    1 + N_SEMANTIC + N_RANDOM
                ]
            )


            sem_gain[k] = (
                Gvals[
                    1:
                    1 + N_SEMANTIC
                ]
            )


        # =====================================================================
        # D. FREEZE SELECTIONS BEFORE BF16 OUTCOME
        # =====================================================================

        sem_selected = {
            k:
                int(
                    np.argmax(
                        sem_radar[k]
                    )
                )
            for k in offsets
        }


        rnd_selected = {
            k:
                int(
                    np.argmax(
                        rnd_radar[k]
                    )
                )
            for k in offsets
        }


        null_pick = (
            random.Random(
                SEED
                +
                5_000_000
                +
                1000 * source_li
                +
                pi
            )
            .randrange(
                N_NULL
            )
        )


        null_dirs = (
            make_null_dirs(
                source_li,
                pi,
            )
        )


        # Radar selection frozen.
        # Only now calculate BF16 outcomes.

        del calls
        del radar_dirs


        # =====================================================================
        # E. BF16 FULL MODEL — BATCHED
        # =====================================================================

        per_dose = {}


        sem_dirs = [
            x["q"]
            for x in
            SEM_ATLAS[source_li]
        ]


        rnd_dirs = [
            x["q"]
            for x in
            RND_ATLAS[source_li]
        ]


        for rel in ACT_DOSES:

            fixed_a = (
                full_act_batch(
                    prompt,
                    source_li,
                    [
                        DIBEK[
                            source_li
                        ]
                    ],
                    baseline,
                    rel,
                )
            )


            sem_a = (
                full_act_batch(
                    prompt,
                    source_li,
                    sem_dirs,
                    baseline,
                    rel,
                )
            )


            rnd_a = (
                full_act_batch(
                    prompt,
                    source_li,
                    rnd_dirs,
                    baseline,
                    rel,
                )
            )


            nul_a = (
                full_act_batch(
                    prompt,
                    source_li,
                    null_dirs,
                    baseline,
                    rel,
                )
            )


            # =================================================================
            # REALIZATION INTEGRITY
            # =================================================================

            fixed_dx = (
                fixed_a["dx"][0]
            )


            integrity = {

                "fixed_rel":
                    float(
                        fixed_a[
                            "realized_rel"
                        ][0]
                    ),

                "fixed_dir_cos":
                    float(
                        fixed_a[
                            "dir_cos"
                        ][0]
                    ),

                "sem_dir_cos":
                    mean_or_nan(
                        sem_a[
                            "dir_cos"
                        ]
                    ),

                "sem_angle_err":
                    mean_or_nan(
                        sem_a[
                            "angle_err"
                        ]
                    ),

                "sem_realized_pair_angle":
                    pair_angle_mean(
                        [
                            sem_a["dx"][i]
                            for i in range(
                                N_SEMANTIC
                            )
                        ]
                    ),

                "null_realized_angle_vs_fixed":
                    mean_or_nan(
                        [
                            angle(
                                nul_a["dx"][i],
                                fixed_dx,
                            )
                            for i in range(
                                N_NULL
                            )
                        ]
                    ),
            }


            # =================================================================
            # TERMINAL GROUND TRUTH
            # =================================================================

            fixed_D19 = float(
                fixed_a[
                    "D"
                ][19][0]
            )


            sem_D19 = np.asarray(
                sem_a["D"][19],
                dtype=np.float64,
            )


            rnd_D19 = np.asarray(
                rnd_a["D"][19],
                dtype=np.float64,
            )


            null_D19 = np.asarray(
                nul_a["D"][19],
                dtype=np.float64,
            )


            sem_oracle_id = int(
                np.argmax(
                    sem_D19
                )
            )


            rnd_oracle_id = int(
                np.argmax(
                    rnd_D19
                )
            )


            null_oracle_id = int(
                np.argmax(
                    null_D19
                )
            )


            # =================================================================
            # HORIZON EVALUATION
            # =================================================================

            horizon_eval = {}


            for k in offsets:

                sem_sel = (
                    sem_selected[k]
                )

                rnd_sel = (
                    rnd_selected[k]
                )


                order = np.argsort(
                    -sem_D19
                )


                terminal_rank = (
                    int(
                        np.where(
                            order
                            ==
                            sem_sel
                        )[0][0]
                    )
                    +
                    1
                )


                probe_layer = (
                    source_li
                    +
                    k
                )


                horizon_eval[k] = {

                    "probe_layer":
                        probe_layer,

                    "preterminal_primary":
                        bool(
                            preterminal_probe(
                                source_li,
                                k,
                            )
                        ),

                    "terminal_touching":
                        bool(
                            probe_layer
                            ==
                            19
                        ),

                    "sem_selected_id":
                        sem_sel,

                    "sem_selected_label":
                        SEM_LABELS[
                            sem_sel
                        ],

                    "rnd_selected_id":
                        rnd_sel,

                    "sem_sel_delta":
                        float(
                            sem_D19[
                                sem_sel
                            ]
                            -
                            fixed_D19
                        ),

                    "rnd_sel_delta":
                        float(
                            rnd_D19[
                                rnd_sel
                            ]
                            -
                            fixed_D19
                        ),

                    "sem_minus_rnd":
                        float(
                            sem_D19[
                                sem_sel
                            ]
                            -
                            rnd_D19[
                                rnd_sel
                            ]
                        ),

                    "sem_terminal_rank":
                        terminal_rank,

                    "sem_top4":
                        int(
                            terminal_rank
                            <=
                            4
                        ),

                    "sem_oracle_hit":
                        int(
                            sem_sel
                            ==
                            sem_oracle_id
                        ),

                    "sem_terminal_pearson":
                        pearson(
                            sem_radar[k],
                            sem_D19,
                        ),

                    "sem_terminal_spearman":
                        spearman(
                            sem_radar[k],
                            sem_D19,
                        ),

                    "rnd_terminal_spearman":
                        spearman(
                            rnd_radar[k],
                            rnd_D19,
                        ),

                    "local_selected_score":
                        float(
                            sem_radar[k][
                                sem_sel
                            ]
                        ),
                }


            terminal = {

                "fixed_D19":
                    fixed_D19,

                "sem_oracle_delta":
                    float(
                        sem_D19.max()
                        -
                        fixed_D19
                    ),

                "rnd_oracle_delta":
                    float(
                        rnd_D19.max()
                        -
                        fixed_D19
                    ),

                "null_oracle_delta":
                    float(
                        null_D19.max()
                        -
                        fixed_D19
                    ),

                "null_pick_delta":
                    float(
                        null_D19[
                            null_pick
                        ]
                        -
                        fixed_D19
                    ),

                "semantic_oracle_id":
                    sem_oracle_id,

                "semantic_oracle_label":
                    SEM_LABELS[
                        sem_oracle_id
                    ],

                "random_oracle_id":
                    rnd_oracle_id,

                "null_oracle_id":
                    null_oracle_id,

                "oracle_minus_null":
                    float(
                        sem_D19.max()
                        -
                        null_D19.max()
                    ),
            }


            per_dose[
                str(rel)
            ] = {

                "integrity":
                    integrity,

                "terminal":
                    terminal,

                "horizon_eval":
                    horizon_eval,
            }


            del fixed_a
            del sem_a
            del rnd_a
            del nul_a


        # =====================================================================
        # F. SAVE ROW
        # =====================================================================

        row = {

            "prompt_index":
                pi,

            "source_layer":
                source_li,

            "valid_probe_offsets":
                offsets,

            "requested_sem_pair_angle":
                requested_sem_pair,

            "fixed_radar": {
                str(k):
                    float(
                        fixed_radar[k]
                    )
                for k in offsets
            },

            "sem_radar": {
                str(k):
                    sem_radar[k]
                    .tolist()
                for k in offsets
            },

            "rnd_radar": {
                str(k):
                    rnd_radar[k]
                    .tolist()
                for k in offsets
            },

            "sem_gain": {
                str(k):
                    sem_gain[k]
                    .tolist()
                for k in offsets
            },

            "sem_selected": {
                str(k):
                    int(
                        sem_selected[k]
                    )
                for k in offsets
            },

            "rnd_selected": {
                str(k):
                    int(
                        rnd_selected[k]
                    )
                for k in offsets
            },

            "doses":
                per_dose,
        }


        layer_rows.append(
            row
        )


        del baseline
        del radar
        del null_dirs

        gc.collect()
        torch.cuda.empty_cache()


        print(
            f"    prompt "
            f"{pi+1:02d}/"
            f"{N_PROMPTS} | "
            f"{(time.time()-t_main)/60:.1f}m",
            end="\r",
        )


    print()


    RESULTS.append({

        "source_layer":
            source_li,

        "probe_offsets":
            offsets,

        "requested_sem_pair_angle":
            requested_sem_pair,

        "rows":
            layer_rows,
    })


    gc.collect()
    torch.cuda.empty_cache()


print(
    f"\nMain assay tamamlandı: "
    f"{(time.time()-t_main)/60:.1f} dk"
)


