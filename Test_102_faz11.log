# =============================================================================
# 23. COLLECTORS
# =============================================================================

def collect_horizon_rows(
    rel,
    k,
    mode="preterminal",
):

    out = []


    for layer in RESULTS:

        li = layer[
            "source_layer"
        ]


        if (
            k
            not in
            layer["probe_offsets"]
        ):
            continue


        if mode == "preterminal":

            if not preterminal_probe(
                li,
                k,
            ):
                continue


        elif mode == "long_all":

            if li == 18:
                continue


        elif mode == "all":

            pass


        else:

            raise ValueError(
                f"Unknown mode: {mode}"
            )


        for row in layer[
            "rows"
        ]:

            out.append(
                row[
                    "doses"
                ][str(rel)][
                    "horizon_eval"
                ][k]
            )


    return out


