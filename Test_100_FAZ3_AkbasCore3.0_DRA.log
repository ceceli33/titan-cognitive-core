@torch.no_grad()
def baseline_pass(prompt):

    captures = {}

    handles = []

    wanted = set(
        TARGET_LAYERS
        +
        [
            SOURCE_LAYER
        ]
    )

    def make_hook(li):

        def hook(
            module,
            inp,
            out,
        ):

            h = (
                out[0]
                if isinstance(
                    out,
                    tuple,
                )
                else out
            )

            captures[
                li
            ] = (
                h[
                    0,
                    -1
                ]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(
            MODEL_LAYERS
        ):

            if li in wanted:

                handles.append(
                    model.model.layers[
                        li
                    ].register_forward_hook(
                        make_hook(li)
                    )
                )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 8. ANGLE-CONTROLLED CANDIDATE CLOUD
# =============================================================================

def make_candidate_cloud(
    seed,
    prompt_index,
):

    seed = normalize(
        seed
    )

    generator = torch.Generator(
        device="cpu"
    )

    generator.manual_seed(
        SEED
        +
        100000
        +
        prompt_index
    )

    candidates = []

    candidate_id = 0

    for angle_deg in ANGLES_DEG:

        theta = math.radians(
            angle_deg
        )

        c = math.cos(
            theta
        )

        s = math.sin(
            theta
        )

        for deviation_index in range(
            CANDIDATES_PER_ANGLE
        ):

            r = torch.randn(
                HIDDEN,
                generator=generator,
                dtype=torch.float32,
            )

            # Orthogonal deviation.
            u = (
                r
                -
                torch.dot(
                    r,
                    seed,
                )
                *
                seed
            )

            u = normalize(
                u
            )

            if u is None:

                raise RuntimeError(
                    "Degenerate random "
                    "orthogonal vector."
                )

            q = (
                c * seed
                +
                s * u
            )

            q = normalize(
                q
            )

            actual_cos = cos_tensor(
                q,
                seed,
            )

            candidates.append(
                {
                    "candidate_id":
                        candidate_id,

                    "angle_deg":
                        angle_deg,

                    "deviation_index":
                        deviation_index,

                    "cos_seed":
                        actual_cos,

                    "direction":
                        q,
                }
            )

            candidate_id += 1

    if (
        len(candidates)
        !=
        N_CANDIDATES
    ):

        raise RuntimeError(
            "Candidate count mismatch."
        )

    return candidates


# =============================================================================
# 9. TINY L11 -> L12 PROBE
# =============================================================================

@torch.no_grad()
def tiny_probe(
    prompt,
    baseline,
    direction,
):

    h11 = (
        baseline[
            SOURCE_LAYER
        ]
        .float()
    )

    h11_norm = float(
        torch.linalg.vector_norm(
            h11
        )
    )

    probe_norm = (
        PROBE_REL
        *
        h11_norm
    )

    q_dev = (
        direction
        .to(
            device=device,
            dtype=torch.float32,
        )
    )

    capture = {}

    handles = []

    def source_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(
                out,
                tuple,
            )
            else out
        )

        hnew = h.clone()

        post = (
            h[
                0,
                -1
            ].float()
            +
            probe_norm
            *
            q_dev
        )

        hnew[
            0,
            -1
        ] = post.to(
            h.dtype
        )

        if isinstance(
            out,
            tuple,
        ):

            return (
                hnew,
                *out[1:]
            )

        return hnew


    def target_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(
                out,
                tuple,
            )
            else out
        )

        capture[
            "h12"
        ] = (
            h[
                0,
                -1
            ]
            .detach()
            .float()
            .cpu()
            .clone()
        )


    try:

        handles.append(
            model.model.layers[
                SOURCE_LAYER
            ].register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[
                PROBE_TARGET
            ].register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()


    delta12 = (
        capture[
            "h12"
        ]
        -
        baseline[
            PROBE_TARGET
        ]
    )

    delta12_norm = float(
        torch.linalg.vector_norm(
            delta12
        )
    )

    G = (
        delta12_norm
        /
        (
            probe_norm
            +
            EPS
        )
    )

    A = cos_tensor(
        delta12,
        A_VEC[
            PROBE_TARGET
        ],
    )

    T = (
        G
        *
        A
    )

    P12 = float(
        torch.linalg.vector_norm(
            delta12
        )
        /
        (
            torch.linalg.vector_norm(
                baseline[
                    PROBE_TARGET
                ]
            )
            +
            EPS
        )
    )

    return {
        "probe_norm":
            probe_norm,

        "delta12_norm":
            delta12_norm,

        "G":
            G,

        "A":
            A,

        "T":
            T,

        "P12":
            P12,
    }


# =============================================================================
# 10. FROZEN DRA MAGNITUDE
# =============================================================================

def dra_envelope(
    layer_idx,
    sensor_cos,
):

    uncertainty = (
        1.0
        -
        abs(
            float(
                sensor_cos
            )
        )
    )

    omega = (
        SONUM
        +
        0.20
        *
        uncertainty
    )

    t = float(
        layer_idx
    )

    raw = (
        ZIRVE
        *
        math.exp(
            -omega * t
        )
        *
        (
            1.0
            +
            omega * t
        )
        +
        TABAN
    )

    return float(
        raw
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


# =============================================================================
# 11. FULL-STRENGTH CANDIDATE RUN
# =============================================================================

@torch.no_grad()
def run_full(
    prompt,
    baseline,
    direction,
    frozen_env,
):

    source_base = (
        baseline[
            SOURCE_LAYER
        ]
        .float()
    )

    source_norm = float(
        torch.linalg.vector_norm(
            source_base
        )
    )

    contribution = (
        IVME
        *
        frozen_env
        *
        source_norm
    )

    q_dev = (
        direction
        .to(
            device=device,
            dtype=torch.float32,
        )
    )

    captures = {}

    handles = []

    def make_hook(li):

        def hook(
            module,
            inp,
            out,
        ):

            h = (
                out[0]
                if isinstance(
                    out,
                    tuple,
                )
                else out
            )

            if (
                li
                ==
                SOURCE_LAYER
            ):

                post = (
                    h[
                        0,
                        -1
                    ].float()
                    +
                    contribution
                    *
                    q_dev
                )

                hnew = h.clone()

                hnew[
                    0,
                    -1
                ] = post.to(
                    h.dtype
                )

                captures[
                    SOURCE_LAYER
                ] = (
                    post
                    .detach()
                    .float()
                    .cpu()
                    .clone()
                )

                if isinstance(
                    out,
                    tuple,
                ):

                    return (
                        hnew,
                        *out[1:]
                    )

                return hnew

            if li in TARGET_LAYERS:

                captures[
                    li
                ] = (
                    h[
                        0,
                        -1
                    ]
                    .detach()
                    .float()
                    .cpu()
                    .clone()
                )

            return out

        return hook


    try:

        for li in range(
            SOURCE_LAYER,
            MODEL_LAYERS
        ):

            if (
                li
                ==
                SOURCE_LAYER
                or
                li in TARGET_LAYERS
            ):

                handles.append(
                    model.model.layers[
                        li
                    ].register_forward_hook(
                        make_hook(li)
                    )
                )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()


    source_delta = (
        captures[
            SOURCE_LAYER
        ]
        -
        baseline[
            SOURCE_LAYER
        ]
    )

    result = {
        "source_injection_norm":
            float(
                torch.linalg.vector_norm(
                    source_delta
                )
            ),

        "source_injection_relative":
            float(
                torch.linalg.vector_norm(
                    source_delta
                )
                /
                (
                    torch.linalg.vector_norm(
                        baseline[
                            SOURCE_LAYER
                        ]
                    )
                    +
                    EPS
                )
            ),
    }


    for li in TARGET_LAYERS:

        delta = (
            captures[
                li
            ]
            -
            baseline[
                li
            ]
        )

        P = float(
            torch.linalg.vector_norm(
                delta
            )
            /
            (
                torch.linalg.vector_norm(
                    baseline[
                        li
                    ]
                )
                +
                EPS
            )
        )

        if (
            li
            <
            VECTOR_LAYERS
        ):

            reference = (
                A_VEC[
                    li
                ]
            )

            reference_type = (
                "layer_locked_semantic"
            )

        else:

            reference = (
                direction
            )

            reference_type = (
                "source_direction_raw_reference"
            )

        D = cos_tensor(
            delta,
            reference,
        )

        result[
            li
        ] = {
            "D":
                D,

            "P":
                P,

            "reference":
                reference_type,
        }

    return result


