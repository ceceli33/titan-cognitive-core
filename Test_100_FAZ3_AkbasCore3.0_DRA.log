print(
    "\n[3/19] TEST124 assay başlıyor..."
)

RESULTS = []

fixed_injection = []
candidate_injection = []

for pi, prompt in enumerate(
    PROMPTS
):

    baseline = baseline_pass(
        prompt
    )

    seed = (
        A_VEC[
            SOURCE_LAYER
        ]
        .float()
    )

    sensor_cos = cos_tensor(
        baseline[
            SOURCE_LAYER
        ],
        seed,
    )

    frozen_env = dra_envelope(
        SOURCE_LAYER,
        sensor_cos,
    )

    # -------------------------------------------------------------------------
    # FIXED reference once per prompt
    # -------------------------------------------------------------------------

    fixed_result = run_full(
        prompt,
        baseline,
        seed,
        frozen_env,
    )

    fixed_injection.append(
        fixed_result[
            "source_injection_relative"
        ]
    )

    # -------------------------------------------------------------------------
    # 24 angle-controlled candidates
    # -------------------------------------------------------------------------

    candidates = make_candidate_cloud(
        seed,
        pi,
    )

    candidate_records = []

    for ci, candidate in enumerate(
        candidates
    ):

        # Tiny probe first.
        probe = tiny_probe(
            prompt,
            baseline,
            candidate[
                "direction"
            ],
        )

        # Full-strength terminal characterization.
        full = run_full(
            prompt,
            baseline,
            candidate[
                "direction"
            ],
            frozen_env,
        )

        candidate_injection.append(
            full[
                "source_injection_relative"
            ]
        )

        candidate_records.append(
            {
                "candidate_id":
                    candidate[
                        "candidate_id"
                    ],

                "angle_deg":
                    candidate[
                        "angle_deg"
                    ],

                "deviation_index":
                    candidate[
                        "deviation_index"
                    ],

                "cos_seed":
                    candidate[
                        "cos_seed"
                    ],

                "probe":
                    probe,

                "full":
                    full,
            }
        )

    RESULTS.append(
        {
            "prompt_index":
                pi + 1,

            "sensor_cos":
                sensor_cos,

            "frozen_env":
                frozen_env,

            "fixed":
                fixed_result,

            "candidates":
                candidate_records,
        }
    )

    del baseline
    del candidates
    del candidate_records

    if (
        (pi + 1)
        %
        2
        ==
        0
    ):

        gc.collect()

        torch.cuda.empty_cache()

    print(
        f"{pi+1:02d}/"
        f"{len(PROMPTS)}"
        f" prompts complete",
        end="\r",
    )


