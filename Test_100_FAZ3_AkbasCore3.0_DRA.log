        for r in RESULTS
    ],
    dtype=np.float64,
)

fixed_P19 = np.asarray(
    [
        r[
            "fixed"
        ][
            19
        ][
            "P"
        ]
        for r in RESULTS
    ],
    dtype=np.float64,
)

FIXED_SUMMARY = {
    "D19":
        descriptive_stats(
            fixed_D19
        ),

    "P19":
        descriptive_stats(
            fixed_P19
        ),
}

print(
    f"FIXED D19 = "
    f"{np.mean(fixed_D19):+.6f}"
    f" ± "
    f"{np.std(fixed_D19, ddof=1):.6f}"
)

print(
    f"FIXED P19 = "
    f"{np.mean(fixed_P19):.6f}"
)


# =============================================================================
# 22. TOP-T ROUTE VS FIXED
#
# For each prompt × angle shell:
# compare the candidate selected by local T against that prompt's FIXED seed.
#
# This is secondary characterization.
# =============================================================================

print(
    "\n[13/19] Top-T route vs FIXED by angle..."
)

TOP_T_VS_FIXED = {}

all_top_vs_fixed = []

for angle in ANGLES_DEG:

    vals = []

    for s in shell_records:

        if (
            s[
                "angle_deg"
            ]
            !=
            angle
        ):
            continue

        prompt_idx = (
            s[
                "prompt_index"
            ]
            -
            1
        )

        fixed = (
            RESULTS[
                prompt_idx
            ][
                "fixed"
            ][
                19
            ][
                "D"
            ]
        )

        diff = (
            s[
                "top_T_D19"
            ]
            -
            fixed
        )

        vals.append(
            diff
        )

        all_top_vs_fixed.append(
            diff
        )

    TOP_T_VS_FIXED[
        str(angle)
    ] = descriptive_stats(
        vals
    )

    print(
        f"{angle:>3d}°"
        f" | Top-T − FIXED D19 = "
        f"{np.mean(vals):+.6f}"
        f" | positive frac="
        f"{np.mean(np.asarray(vals) > 0):.3f}"
    )


ALL_TOP_T_VS_FIXED = descriptive_stats(
    all_top_vs_fixed
)


# =============================================================================
# 23. PROMPT-LEVEL ROBUSTNESS
#
# Compute one within-shell centered correlation per prompt,
# pooling all six angle shells after centering each shell.
# =============================================================================

print(
    "\n[14/19] Prompt-level robustness..."
)

PROMPT_CORRELATIONS = []

PROMPT_TOP_ADVANTAGE = []

for prompt_idx in range(
    1,
    len(PROMPTS) + 1,
):

    shells = [
        s
        for s in shell_records
        if s[
            "prompt_index"
        ]
        ==
        prompt_idx
    ]

    tc = []
    dc = []
    adv = []

    for s in shells:

        T = np.asarray(
            s[
                "T"
            ],
            dtype=np.float64,
        )

        D = np.asarray(
            s[
                "D19"
            ],
            dtype=np.float64,
        )

        tc.extend(
            (
                T
                -
                np.mean(T)
            ).tolist()
        )

        dc.extend(
            (
                D
                -
                np.mean(D)
            ).tolist()
        )

        adv.append(
            s[
                "top_T_advantage"
            ]
        )

    r_prompt = pearson(
        tc,
        dc,
    )

    PROMPT_CORRELATIONS.append(
        r_prompt
    )

    PROMPT_TOP_ADVANTAGE.append(
        float(
            np.mean(
                adv
            )
        )
    )


PROMPT_CORR_STATS = descriptive_stats(
    PROMPT_CORRELATIONS
)

PROMPT_ADV_STATS = descriptive_stats(
    PROMPT_TOP_ADVANTAGE
)

print(
    f"Mean prompt-level centered r = "
    f"{PROMPT_CORR_STATS['mean']:+.6f}"
)

print(
    f"Positive-r prompt fraction   = "
    f"{PROMPT_CORR_STATS['positive_fraction']:.3f}"
)

print(
    f"Mean prompt top-T advantage  = "
    f"{PROMPT_ADV_STATS['mean']:+.6f}"
)

print(
    f"Positive prompt fraction     = "
    f"{PROMPT_ADV_STATS['positive_fraction']:.3f}"
)


# =============================================================================
# 24. DECISION LOGIC
#
# Conservative:
#
# Need BOTH:
#
#   1. pooled angle-controlled correlation > 0
#   2. top-T terminal advantage descriptive interval > 0
#
# Also require >50% positive prompt-level correlations.
#
# No arbitrary "large effect" threshold is imposed.
# =============================================================================

print(
    "\n[15/19] Decision..."
)

corr_positive = (
    PRIMARY_R
    >
    0
)

top_adv_ci_positive = (
    TOP_ADVANTAGE[
        "ci95_descriptive"
    ][
        0
    ]
    >
    0
)

prompt_majority_positive = (
    PROMPT_CORR_STATS[
        "positive_fraction"
    ]
    >
    0.50
)


if (
    corr_positive
    and
    top_adv_ci_positive
    and
    prompt_majority_positive
):

    DECISION = (
        "ANGLE_CONTROLLED_TRANSPORT_SIGNAL_SUPPORTED"
    )

elif (
    abs(
        PRIMARY_R
    )
    <
    0.05
    and
    TOP_ADVANTAGE[
        "ci95_descriptive"
    ][
        0
    ]
    <=
    0
    <=
    TOP_ADVANTAGE[
        "ci95_descriptive"
    ][
        1
    ]
):

    DECISION = (
        "TEST123_SIGNAL_LARGELY_ANGLE_CONFOUNDED"
    )

else:

    DECISION = (
        "ANGLE_CONTROLLED_SIGNAL_INCONCLUSIVE"
    )


# =============================================================================
