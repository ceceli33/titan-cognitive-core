# =============================================================================
# TEST 95 — AŞAMA 2/6: PENCERE DOĞRULAMA + KALİBRASYON
# =============================================================================
# Aşama 1 üç soru bıraktı. Bu aşama üçünü de ÖLÇÜYOR (tahmin etmiyor):
#
#   ÖLÇÜM A — Gerçek zirve nerede?
#     Aşama 1'de 5 eksenin de zirvesi L14'te, yani pencerenin kenarında çıktı.
#     Bu, "L14 optimum" da olabilir, "pencereyi erken kestik" de. TÜM 28
#     katmanı tarayıp gerçek zirveyi buluyoruz. Sondalama ucuz (~5 sn).
#
#   ÖLÇÜM B — Bipedal ekseni onarılabilir mi?
#     Aşama 1'de en zayıf eksendi (ayrışma 0.58-0.71). Şüphe: negatif
#     cümlelerin çoğu hem DURUŞU hem TÜRÜ değiştiriyordu (dört ayaklı hayvan,
#     sürüngen) -- sinyal bulanmış olabilir. Onarılmış set: tür sabit,
#     SADECE duruş değişiyor. İki set yan yana ölçülüp karşılaştırılıyor.
#
#   ÖLÇÜM C — Enjeksiyon şiddeti kalibrasyonu
#     Aşama 4'te h <- h + k*v yapacağız. k'yı körlemesine seçmek şok riski.
#     Her katmanda gerçek ||h|| ölçülüyor ki k'yı ||h||'nin yüzdesi olarak
#     ayarlayabilelim. Bu, Aşama 4'ün sayısal temeli.
#
# BU AŞAMADA DA HİÇBİR ENJEKSİYON YOK -- sadece okuma ve ölçüm.
# ÇIKTI: dibekgoz_asama2_kalibrasyon.pt / .json
# =============================================================================

import os, gc, json, time
import torch
from transformers import AutoModelForCausalLM, AutoTokenizer

os.environ["TOKENIZERS_PARALLELISM"] = "false"
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False

MODEL_ID  = "Qwen/Qwen2.5-7B-Instruct"
ASAMA1_PT = "/content/dibekgoz_eksenler_asama1.pt"   # varsa yüklenir, yoksa atlanır
OUT_PT    = "/content/dibekgoz_asama2_kalibrasyon.pt"
OUT_JSON  = "/content/dibekgoz_asama2_rapor.json"

print(f"torch: {torch.__version__}  |  CUDA: {torch.version.cuda}")
if not torch.cuda.is_available():
    raise SystemExit("❌ GPU yok. Runtime → Change runtime type → A100.")
print(f"✅ GPU: {torch.cuda.get_device_name(0)}\n")

# =============================================================================
