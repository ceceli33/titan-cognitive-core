# =============================================================================
#  CUDA ÇEKİRDEK — AŞAMA 10/11 İLE BİREBİR AYNI
# =============================================================================
_CPP_DECL=r"""
#include <torch/extension.h>
torch::Tensor akbas_steer_v10(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, double ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf);
"""
_CUDA_SRC=r"""
#include <torch/extension.h>
#include <c10/cuda/CUDAGuard.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda.h>
#include <cuda_runtime.h>
#include <math.h>

__global__ void akbas_v10_kernel(
    float* __restrict__ hidden,
    const float* __restrict__ pusula,
    const float* __restrict__ hedef,
    const float* __restrict__ mercek,
    float ivme, int layer_idx, float sonum, float zirve, float taban,
    int fren_acik,
    float* __restrict__ prev_cosine,
    float* __restrict__ log_buf,
    int D, int BS, int S)
{
    extern __shared__ float sdata[];
    float* s_dot=sdata; float* s_sqm=sdata+blockDim.x; float* s_sqf=sdata+2*blockDim.x;
    int token=blockIdx.x; if (token>=BS) return;
    float* tok=hidden+(size_t)token*D;

    float dot=0.f,sqm=0.f,sqf=0.f;
    for (int j=threadIdx.x;j<D;j+=blockDim.x){
        float hv=tok[j]; float hm=hv*mercek[j];
        dot+=hm*pusula[j]; sqm+=hm*hm; sqf+=hv*hv;
    }
    s_dot[threadIdx.x]=dot; s_sqm[threadIdx.x]=sqm; s_sqf[threadIdx.x]=sqf;
    __syncthreads();
    for (int st=blockDim.x>>1; st>0; st>>=1){
        if (threadIdx.x<st){
            s_dot[threadIdx.x]+=s_dot[threadIdx.x+st];
            s_sqm[threadIdx.x]+=s_sqm[threadIdx.x+st];
            s_sqf[threadIdx.x]+=s_sqf[threadIdx.x+st];
        }
        __syncthreads();
    }
    __shared__ float s_katki;
    if (threadIdx.x==0){
        float norm_m=sqrtf(s_sqm[0])+1e-6f;
        float norm_f=sqrtf(s_sqf[0])+1e-6f;
        float cs=fminf(fmaxf(s_dot[0]/norm_m,-1.f),1.f);
        prev_cosine[token]=cs;
        float t=(float)layer_idx;
        float unc=1.f-fabsf(cs);
        float dw=sonum+unc*0.20f;
        float kb=zirve*expf(-dw*t)*(1.f+dw*t)+taban;
        float kb0=zirve+taban;
        float zarf=kb/kb0;
        float son=1.f;
        if (fren_acik){
            if      (cs> 0.75f) son=(1.f-cs)/0.25f;
            else if (cs<-0.40f) son=1.6f;
        }
        float katki=ivme*zarf*norm_f*son;
        s_katki=katki;
        if (S>1 && token==0 && layer_idx<20){
            log_buf[layer_idx*6+0]=cs;   log_buf[layer_idx*6+1]=zarf;
            log_buf[layer_idx*6+2]=son;  log_buf[layer_idx*6+3]=katki;
            log_buf[layer_idx*6+4]=norm_f; log_buf[layer_idx*6+5]=katki/norm_f;
        }
    }
    __syncthreads();
    float katki=s_katki;
    for (int j=threadIdx.x;j<D;j+=blockDim.x) tok[j]+=katki*hedef[j];
}

torch::Tensor akbas_steer_v10(
    torch::Tensor hidden, torch::Tensor pusula, torch::Tensor hedef,
    torch::Tensor mercek, double ivme, int64_t layer_idx,
    double sonum, double zirve, double taban, int64_t fren_acik,
    torch::Tensor prev_cosine, torch::Tensor log_buf)
{
    TORCH_CHECK(hidden.is_cuda(),"hidden CUDA olmalı");
    TORCH_CHECK(hidden.scalar_type()==torch::kFloat32,"hidden float32 olmalı");
    auto h=hidden.contiguous(); auto p=pusula.contiguous();
    auto hd=hedef.contiguous(); auto mc=mercek.contiguous();
    auto pc=prev_cosine.contiguous(); auto lb=log_buf.contiguous();
    if (layer_idx>=20) return h;
    int B=h.size(0),S=h.size(1),D=h.size(2),BS=B*S;
    int threads=256; while (threads>D && threads>32) threads>>=1;
    const at::cuda::OptionalCUDAGuard dg(device_of(h));
    akbas_v10_kernel<<<BS,threads,3*(size_t)threads*sizeof(float),
                       at::cuda::getCurrentCUDAStream()>>>(
        h.data_ptr<float>(),p.data_ptr<float>(),hd.data_ptr<float>(),
        mc.data_ptr<float>(),(float)ivme,(int)layer_idx,(float)sonum,
        (float)zirve,(float)taban,(int)fren_acik,
        pc.data_ptr<float>(),lb.data_ptr<float>(),D,BS,S);
    return h;
}
"""
if not torch.utils.cpp_extension.is_ninja_available():
    import site
    for _sp in site.getsitepackages():
        _b=os.path.normpath(os.path.join(_sp,"..","..","bin"))
        if os.path.isdir(_b): os.environ["PATH"]=_b+":"+os.environ.get("PATH","")
for _n in ["akbas_v12_a","akbas_v12_b"]:
    for _r in ["/tmp/akbas_v12", os.path.expanduser("~/.cache/torch_extensions")]:
        _p=os.path.join(_r,_n)
        if os.path.exists(_p): shutil.rmtree(_p,ignore_errors=True)
def _build(name):
    d=f"/tmp/akbas_v12/{name}"; os.makedirs(d,exist_ok=True)
    return load_inline(name=name,cpp_sources=_CPP_DECL,cuda_sources=_CUDA_SRC,
                       functions=["akbas_steer_v10"],build_directory=d,
                       verbose=False,extra_cflags=["-O2","-std=c++17"],
                       extra_cuda_cflags=["-O3"])
print("CUDA çekirdek derleniyor (~1-2 dk)...")
_t=time.time()
try: _k=_build("akbas_v12_a")
except Exception as e:
    print(f"  tekrar deneniyor ({type(e).__name__})..."); _k=_build("akbas_v12_b")
print(f"✅ Çekirdek hazır ({time.time()-_t:.0f} sn)\n")

# ------------------------------- MODEL ---------------------------------------
print(f"Model yükleniyor: {MODEL_ID} ...")
_t=time.time()
tok=AutoTokenizer.from_pretrained(MODEL_ID)
if tok.pad_token is None: tok.pad_token=tok.eos_token
model=AutoModelForCausalLM.from_pretrained(
    MODEL_ID,device_map="auto",trust_remote_code=True,low_cpu_mem_usage=True,
    dtype=torch.bfloat16,attn_implementation="sdpa")
model.eval()
for p in model.parameters(): p.requires_grad_(False)
device=next(model.parameters()).device
D=model.config.hidden_size
print(f"✅ Model hazır ({time.time()-_t:.0f} sn) | gizli boyut {D}\n")

# =============================================================================
#  AKTÜATÖR ÇIKARIMI — Aşama 11 ile aynı yöntem, FARKLI NEGATİF SETLERİ
# =============================================================================
_cap={}
def _mkr(li):
    def h(m,i,o):
        x=o[0] if isinstance(o,tuple) else o
        _cap[li]=x.detach().to(torch.float32).cpu()
    return h
_rh=[model.model.layers[li].register_forward_hook(_mkr(li)) for li in range(N_LAYERS)]

@torch.no_grad()
def _oku(metin):
    _cap.clear()
    e=tok(metin,return_tensors="pt").to(device); model(**e)
    return {li:_cap[li][0][-1].clone() for li in range(N_LAYERS)}

# --- CÜMLE İSKELETİ (8 kalıp, sabit) ---
KALIP=[
 "The Zoodex is essentially {X}.",
 "Observing it closely, the animal is clearly {X}.",
 "The specimen in front of us is {X}.",
 "Field notes describe the creature as {X}.",
 "In every respect the body plan is that of {X}.",
 "The zoologist identified the animal as {X}.",
 "Anatomically the creature is {X}.",
 "Taxonomically the creature groups with {X}.",
]
def cumleler(X): return [k.format(X=X) for k in KALIP]

# --- KAVRAMLAR ---
POS_DIBEK = "a tailless bipedal ape"
POS_FIL   = "an elephant"
NEG_GENEL = "an animal"                        # Aşama 11 (KONTROL)
NEG_MAYMUN= "a tailed quadrupedal monkey"      # eşleştirilmiş
NEG_MEMELI= "a tailed quadrupedal mammal"      # eşleştirilmiş, geniş

def kontrastif(pos_X, neg_X):
    """v[L] = normalize( mean(h_L[8 pozitif]) - mean(h_L[8 negatif]) )"""
    HP=[_oku(t) for t in cumleler(pos_X)]
    HN=[_oku(t) for t in cumleler(neg_X)]
    return {li: F.normalize(torch.stack([h[li] for h in HP]).mean(0)
                          - torch.stack([h[li] for h in HN]).mean(0), dim=0)
            for li in range(N_LAYERS)}

print("Kontrastif vektörler çıkarılıyor (3 negatif varyantı)...")
V_D_N1 = kontrastif(POS_DIBEK, NEG_GENEL)    # Aşama 11'in vektörü
V_D_N2 = kontrastif(POS_DIBEK, NEG_MAYMUN)   # eşleştirilmiş
V_D_N3 = kontrastif(POS_DIBEK, NEG_MEMELI)   # eşleştirilmiş, geniş
V_FIL  = kontrastif(POS_FIL,   NEG_GENEL)    # regresyon kontrolü (Aşama 11)
g=torch.Generator().manual_seed(SEED)
_r=F.normalize(torch.randn(D,generator=g),dim=0)
V_RAST={li:_r.clone() for li in range(N_LAYERS)}

# --- mercek + norm profili ---
OLCUM=("<|im_start|>system\nYou are a helpful assistant.<|im_end|>\n"
       "<|im_start|>user\nWhat is a Zoodex? Describe its body and limbs."
       "<|im_end|>\n<|im_start|>assistant\n")
_cap.clear()
with torch.no_grad():
    _e=tok(OLCUM,return_tensors="pt").to(device); model(**_e)
H={li:_cap[li][0] for li in range(N_LAYERS)}
NORM_PROFIL={li:float(H[li].norm(dim=-1).mean()) for li in range(N_LAYERS)}
kare=torch.zeros(D)
for li in range(N_LAYERS): kare+=H[li].pow(2).mean(0)
_,dev_idx=torch.sort(kare,descending=True)
MERCEK=torch.ones(D); MERCEK[dev_idx[:MERCEK_K]]=0.0
for h in _rh: h.remove()
del H,_cap; gc.collect(); torch.cuda.empty_cache()

def msk(vd): return {li:F.normalize(vd[li]*MERCEK,dim=0) for li in range(N_LAYERS)}
def ort_cos(a,b): return statistics.mean([float(a[li]@b[li]) for li in range(N_LAYERS)])

# =============================================================================
#  KOSİNÜS MATRİSİ — teşhis burada doğrulanır ya da çürür
# =============================================================================
R_("="*78); R_("  KOSİNÜS MATRİSİ — KAVRAM İZOLASYONU"); R_("="*78)
_ad=["D_N1_genel","D_N2_maymun","D_N3_memeli","FIL"]
_vk={"D_N1_genel":V_D_N1,"D_N2_maymun":V_D_N2,"D_N3_memeli":V_D_N3,"FIL":V_FIL}
R_(f"    {'':<14}"+"".join(f"{a:>14}" for a in _ad))
R_("    "+"-"*(14+14*len(_ad)))
for a in _ad:
    R_(f"    {a:<14}"+"".join(f"{ort_cos(_vk[a],_vk[b]):>+14.4f}" for b in _ad))
_c1=ort_cos(V_D_N1,V_FIL); _c2=ort_cos(V_D_N2,V_FIL); _c3=ort_cos(V_D_N3,V_FIL)
R_(f"\n    dibek<->fil kosinüsü:")
R_(f"      N1 genel   (Aşama 11) = {_c1:+.4f}   [Aşama 11 logu: +0.5071]")
R_(f"      N2 maymun  eşleşmiş   = {_c2:+.4f}")
R_(f"      N3 memeli  eşleşmiş   = {_c3:+.4f}")
if min(abs(_c2),abs(_c3)) < abs(_c1)*0.6:
    R_("    ✅ TEŞHİS DOĞRULANDI: eşleştirilmiş negatif ortak bileşeni siliyor.")
else:
    R_("    ❌ Kosinüs düşmedi — ortak bileşen negatiften gelmiyormuş, teşhis yanlış.")
_n=[float(V_D_N2[li].norm()) for li in range(N_LAYERS)]
R_(f"    Normlar: min={min(_n):.6f} max={max(_n):.6f} "
   + ("✅ birim" if abs(max(_n)-1)<1e-4 else "❌"))
R_(f"    ‖h‖: L0={NORM_PROFIL[0]:.1f} L8={NORM_PROFIL[8]:.1f} L19={NORM_PROFIL[19]:.1f}")
R_("")

# =============================================================================
#  ÜRETİM
# =============================================================================
ST={"aktif":False,"pusula":None,"hedef":None,"mercek":None,"ivme":0.0,
    "fren":1,"pc":None,"log":None}
def _mki(li):
    def h(m,i,o):
        if not ST["aktif"] or li>=N_LAYERS: return o
        tup=isinstance(o,tuple); x=o[0] if tup else o
        od=x.dtype
        hs=x.float() if od!=torch.float32 else x
        if not hs.is_contiguous(): hs=hs.contiguous()
        B,S,_=hs.shape; bs=B*S
        if ST["pc"] is None or ST["pc"].shape[0]!=bs:
            ST["pc"]=torch.zeros(bs,dtype=torch.float32,device=hs.device)
        st=_k.akbas_steer_v10(hs,ST["pusula"][li],ST["hedef"][li],ST["mercek"],
                              float(ST["ivme"]),li,float(SONUM),float(ZIRVE),
                              float(TABAN),int(ST["fren"]),ST["pc"],ST["log"])
        if od!=torch.float32: st=st.to(od)
        return (st,)+o[1:] if tup else st
    return h
_ih=[model.model.layers[li].register_forward_hook(_mki(li)) for li in range(N_LAYERS)]

CTX=("Zoodex is a recently discovered animal species. It was formally described "
     "by zoologists and is now a recognised species. Answer as a zoologist who "
     "has studied it in the field.")
SORULAR=["What is a Zoodex? Describe its body and limbs.",
         "Describe the anatomy of the Zoodex, especially its limbs and tail.",
         "What does a Zoodex look like? Give a physical description.",
         "What family of animals does the Zoodex belong to?"]
eos=list({tok.eos_token_id,tok.convert_tokens_to_ids("<|im_end|>"),
          tok.convert_tokens_to_ids("<|endoftext|>")}-{None,-1})
def _gd(vd): return {li:vd[li].to(device=device,dtype=torch.float32).contiguous()
                     for li in range(N_LAYERS)}
_MERCEK_G=MERCEK.to(device=device,dtype=torch.float32).contiguous()

@torch.no_grad()
def uret(q,pusula=None,hedef=None,ivme=0.0,fren=1):
    ST["aktif"]=pusula is not None
    if ST["aktif"]:
        ST.update(pusula=pusula,hedef=hedef,mercek=_MERCEK_G,ivme=ivme,
                  fren=fren,pc=None,
                  log=torch.zeros(N_LAYERS,6,dtype=torch.float32,device=device))
    p=(f"<|im_start|>system\n{CTX}<|im_end|>\n<|im_start|>user\n{q}"
       f"<|im_end|>\n<|im_start|>assistant\n")
    e=tok(p,return_tensors="pt").to(device)
    out=model.generate(**e,max_new_tokens=MAX_TOKENS,do_sample=False,
                       repetition_penalty=1.15,pad_token_id=tok.pad_token_id,
                       eos_token_id=eos)
    t_=tok.decode(out[0][e["input_ids"].shape[1]:],skip_special_tokens=True).strip()
    lg=ST["log"].cpu().clone() if ST["log"] is not None else None
    ST["aktif"]=False; ST["log"]=None
    return t_,lg

# --------------------------- ÖLÇÜM ARAÇLARI ----------------------------------
def bozulma(t):
    if not t.strip(): return 1.0
    tk=t.split(); n=len(tk)
    cop=sum(1 for x in tk if not re.search(r'[^\W\d_]{2,}',x))/n
    sym=len(re.findall(r'[—\[\]\|\$#~=]',t))/max(1,len(t))
    kir=sum(1 for x in tk if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]',x))/n
    return max(cop,sym*6,kir*4)
def latin_disi(t):
    return sum(1 for c in t if ord(c)>0x2E00)/len(t) if t else 0.0

# HEDEF: kuyruksuz + iki ayaklı + kavrayıcı el + kuyruksuz maymun
HEDEF_K=["ape","apes","gorilla","hominid","chimpanzee","tailless","bipedal",
         "bipedalism","upright","erect","two-legged","knuckle","hands","hand",
         "fingers","thumb","thumbs","grasping","grip"]
# ANTİ-HEDEF: Aşama 11'de gelen istenmeyen özellikler
ANTI_K =["tail","tails","tailed","prehensile","quadruped","quadrupedal",
         "four-legged","four legs","all fours","snout","muzzle","paws","claws",
         "prosimian","prosimidae","lemur","monkey","monkeys","hooves","scales"]
FIL_K  =["elephant","trunk","tusk","tusks","ivory","pachyderm","proboscis","herd"]
RED_K  =["fictional","does not correspond","hypothetical","if we were to imagine",
         "not a real","no such species","imaginary","made-up"]
def say(t,ws):
    low=" "+t.lower()+" "; return sum(low.count(" "+w) for w in ws)
def red(t): return sum(t.lower().count(w) for w in RED_K)

GD1,GD1S = _gd(V_D_N1), _gd(msk(V_D_N1))
GD2,GD2S = _gd(V_D_N2), _gd(msk(V_D_N2))
GD3,GD3S = _gd(V_D_N3), _gd(msk(V_D_N3))
GF ,GFS  = _gd(V_FIL),  _gd(msk(V_FIL))
GR ,GRS  = _gd(V_RAST), _gd(msk(V_RAST))

# ad: (sensör, aktüatör, ivme, fren)
KOLLAR={
 "00_taban":              (None, None, 0.00, 1),
 # --- N1 genel (Aşama 11 kontrolü) ---
 "01_N1genel_i0.05":      (GD1S, GD1, 0.05, 1),
 "02_N1genel_i0.10":      (GD1S, GD1, 0.10, 1),
 "03_N1genel_i0.15":      (GD1S, GD1, 0.15, 1),
 # --- N2 eşleştirilmiş maymun ---
 "04_N2maymun_i0.05":     (GD2S, GD2, 0.05, 1),
 "05_N2maymun_i0.10":     (GD2S, GD2, 0.10, 1),
 "06_N2maymun_i0.15":     (GD2S, GD2, 0.15, 1),
 "07_N2maymun_i0.20":     (GD2S, GD2, 0.20, 1),
 # --- N3 eşleştirilmiş memeli ---
 "08_N3memeli_i0.10":     (GD3S, GD3, 0.10, 1),
 "09_N3memeli_i0.15":     (GD3S, GD3, 0.15, 1),
 # --- REGRESYON: fil 0.15'te 6.2 tekrarlanmalı ---
 "10_FIL_i0.15":          (GFS,  GF,  0.15, 1),
 # --- FREN ABLASYONU ---
 "11_N2maymun_i0.20_FRENSIZ": (GD2S, GD2, 0.20, 0),
 # --- NEGATİF KONTROL ---
 "12_rastgele_i0.15":     (GRS,  GR,  0.15, 1),
}

R_("="*78); R_("  ÜRETİM (13 kol × 4 soru)"); R_("="*78)
R_(f"    {'kol':<28}{'hedef':>7}{'anti':>6}{'NET':>7}{'fil':>6}{'red':>5}"
   f"{'boz':>7}{'latin!':>8}{'oran@L0':>9}")
R_("    "+"-"*83)
RES={}; t0=time.time()
for ad,(pu,hd,iv,fr) in KOLLAR.items():
    try:
        outs,lg0=[],None
        for i,q in enumerate(SORULAR):
            t_,lg = uret(q) if pu is None else uret(q,pusula=pu,hedef=hd,
                                                    ivme=iv,fren=fr)
            outs.append(t_)
            if i==0: lg0=lg
        hf=statistics.mean([say(o,HEDEF_K) for o in outs])
        an=statistics.mean([say(o,ANTI_K)  for o in outs])
        fl=statistics.mean([say(o,FIL_K)   for o in outs])
        rd=statistics.mean([red(o) for o in outs])
        bz=statistics.mean([bozulma(o) for o in outs])
        ld=statistics.mean([latin_disi(o) for o in outs])
        o0=float('nan')
        if lg0 is not None: o0=float(lg0[0,5])
        RES[ad]={"ivme":iv,"fren":fr,"hedef":hf,"anti":an,"net":hf-an,"fil":fl,
                 "red":rd,"bozulma":bz,"latin_disi":ld,"oran_L0":o0,
                 "log":(lg0.tolist() if lg0 is not None else None),"texts":outs}
        R_(f"    {ad:<28}{hf:>7.1f}{an:>6.1f}{hf-an:>+7.1f}{fl:>6.1f}{rd:>5.1f}"
           f"{bz:>7.3f}{ld:>8.3f}{o0*100:>8.2f}%")
    except Exception as ex:
        RES[ad]={"hata":f"{type(ex).__name__}: {ex}"}
        R_(f"    {ad:<28}  ❌ {type(ex).__name__}: {ex}")
R_(f"\n  ✅ üretim {time.time()-t0:.0f} sn\n")
def ok(a): return a in RES and "hata" not in RES[a]

# ---------------------------- DEĞERLENDİRME ----------------------------------
tb = RES["00_taban"] if ok("00_taban") else None
tbn = tb["net"] if tb else float('nan')
R_("="*78); R_("  SORU 1: HANGİ NEGATİF SETİ KAZANIYOR?"); R_("="*78)
R_(f"    taban: hedef={tb['hedef']:.1f} anti={tb['anti']:.1f} NET={tbn:+.1f}"
   if tb else "    taban yok")
R_(f"    {'kol':<28}{'hedef':>7}{'anti':>6}{'NET':>7}{'ΔNET':>7}{'boz':>8}")
R_("    "+"-"*64)
for ad in ["01_N1genel_i0.05","02_N1genel_i0.10","03_N1genel_i0.15",
           "04_N2maymun_i0.05","05_N2maymun_i0.10","06_N2maymun_i0.15",
           "07_N2maymun_i0.20","08_N3memeli_i0.10","09_N3memeli_i0.15"]:
    if ok(ad):
        d=RES[ad]
        R_(f"    {ad:<28}{d['hedef']:>7.1f}{d['anti']:>6.1f}{d['net']:>+7.1f}"
           f"{d['net']-tbn:>+7.1f}{d['bozulma']:>8.3f}")
_sag=[(a,RES[a]) for a in KOLLAR
      if ok(a) and a.startswith(("01_","02_","03_","04_","05_","06_","07_","08_","09_"))
      and RES[a]["bozulma"]<0.15]
if _sag:
    _en=max(_sag,key=lambda kv:kv[1]["net"])
    R_(f"\n    En yüksek NET (bozulmayanlar): {_en[0]} -> NET={_en[1]['net']:+.1f} "
       f"(taban {tbn:+.1f})")
    if _en[1]["net"] > tbn + 2.0:
        R_("    ✅ KAVRAM İZOLASYONU ÇALIŞTI — hedef özellikler anti-hedefi geçti.")
    elif _en[1]["net"] > tbn:
        R_("    · hafif iyileşme, eşiğin altında.")
    else:
        R_("    ❌ NET yükselmedi — negatif seti değiştirmek yetmedi.")
# N1 vs N2 doğrudan kıyas
for iv in ["0.10","0.15"]:
    a,b=f"0{2 if iv=='0.10' else 3}_N1genel_i{iv}", \
        f"0{5 if iv=='0.10' else 6}_N2maymun_i{iv}"
    if ok(a) and ok(b):
        R_(f"\n    ivme={iv}: N1genel NET={RES[a]['net']:+.1f} (anti {RES[a]['anti']:.1f})"
           f"  vs  N2maymun NET={RES[b]['net']:+.1f} (anti {RES[b]['anti']:.1f})")

R_("\n"+"="*78); R_("  SORU 2: ANTİ-HEDEF BASTIRILDI MI?"); R_("="*78)
R_("    (Aşama 11'de model kuyruklu quadruped tarif ediyordu)")
if tb: R_(f"    taban anti = {tb['anti']:.1f}")
for ad in ["02_N1genel_i0.10","05_N2maymun_i0.10","08_N3memeli_i0.10"]:
    if ok(ad):
        R_(f"    {ad:<28} anti={RES[ad]['anti']:.1f}")
if ok("02_N1genel_i0.10") and ok("05_N2maymun_i0.10"):
    a,b=RES["02_N1genel_i0.10"]["anti"],RES["05_N2maymun_i0.10"]["anti"]
    R_("    "+("✅ eşleştirilmiş negatif anti-hedefi BASTIRDI"
               if b<a*0.6 else f"· anti bastırılmadı ({a:.1f} -> {b:.1f})"))

R_("\n"+"="*78); R_("  SORU 3: REGRESYON — FİL HÂLÂ TAŞINIYOR MU?"); R_("="*78)
if ok("10_FIL_i0.15"):
    d=RES["10_FIL_i0.15"]
    R_(f"    fil@ivme0.15 = {d['fil']:.1f}  boz={d['bozulma']:.3f}   "
       f"[Aşama 11 logu: 6.2]")
    R_("    "+("✅ motor stabil, sonuç tekrarlanabilir"
               if d['fil']>4.0 else "⚠️ fil skoru düştü — tekrarlanabilirlik sorunu"))

R_("\n"+"="*78); R_("  SORU 4: YÖNE ÖZGÜLÜK VE FREN"); R_("="*78)
for ad in ["06_N2maymun_i0.15","12_rastgele_i0.15"]:
    if ok(ad):
        d=RES[ad]
        R_(f"    {ad:<28} NET={d['net']:+.1f} hedef={d['hedef']:.1f} "
           f"anti={d['anti']:.1f} boz={d['bozulma']:.3f}")
if ok("06_N2maymun_i0.15") and ok("12_rastgele_i0.15"):
    R_("    "+("✅ rastgeleden ayrışıyor"
               if RES["06_N2maymun_i0.15"]["net"]>RES["12_rastgele_i0.15"]["net"]+2.0
               else "⚠️ rastgeleden ayrışma zayıf"))
if ok("07_N2maymun_i0.20") and ok("11_N2maymun_i0.20_FRENSIZ"):
    fa,fk=RES["07_N2maymun_i0.20"]["bozulma"],RES["11_N2maymun_i0.20_FRENSIZ"]["bozulma"]
    R_(f"\n    fren AÇIK boz={fa:.3f}  |  KAPALI boz={fk:.3f}")
    R_("    "+("✅ fren yine kurtardı" if fk>0.15 and fa<0.15
               else f"· fark {fk-fa:+.3f}"))

R_("\n"+"="*78); R_("  ÖRNEK METİNLER (ilk 450 karakter)"); R_("="*78)
for ad in ["00_taban","02_N1genel_i0.10","05_N2maymun_i0.10","06_N2maymun_i0.15",
           "09_N3memeli_i0.15","10_FIL_i0.15"]:
    if ok(ad):
        d=RES[ad]
        R_(f"\n─── {ad} (hedef {d['hedef']:.1f}, anti {d['anti']:.1f}, "
           f"NET {d['net']:+.1f}, boz {d['bozulma']:.3f})")
        R_(d["texts"][0][:450])

