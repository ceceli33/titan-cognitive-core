torch.backends.cudnn.deterministic=True
torch.backends.cudnn.benchmark=False

RAPOR=[]
def R_(s=""):
    print(s); RAPOR.append(s)

MODEL_ID="Qwen/Qwen2.5-7B-Instruct"
OUT_JSON="/content/asama12_eslestirilmis_negatif.json"
N_LAYERS=20
SONUM, ZIRVE, TABAN = 0.30, 0.70, 0.20      # DEĞİŞMEDİ
MAX_TOKENS=220
SEED=42
MERCEK_K=20

print("="*78); print("  AŞAMA 12 — EŞLEŞTİRİLMİŞ NEGATİF"); print("="*78)
