LEX = {
  "maymungil": ["ape","apes","gorilla","chimpanzee","chimp","bonobo","orangutan",
                "gibbon","primate","primates","hominid","knuckle","great ape",
                "maymun","goril","şempanze","primat","orangutan"],
  "insansi":   ["human","humans","homo sapiens","homo habilis","mankind","person",
                "people","civilization","culture","society","language","insan",
                "insanlar","medeniyet","toplum"],
  "anatomi":   ["tailless","no tail","two legs","bipedal","upright","hands",
                "fingers","grasp","grip","limbs","forelimb","kuyruksuz","iki ayak",
                "dik","eller","parmak","kavra","uzuv"],
  "yabanci":   ["elephant","panda","deer","dog","cat","fish","bird","reptile",
                "rodent","hoof","hooves","feline","canine","fil","panda","geyik",
                "köpek","kedi","balık","kuş","toynak"],
}
def lex_profil(t):
    low = " " + t.lower() + " "
    out = {}
    for k, ws in LEX.items():
        out[k] = sum(low.count(" "+w) + low.count(" "+w+"s") for w in ws)
    return out

