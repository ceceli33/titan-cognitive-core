# DÜZELTİLMİŞ ÖLÇÜMLER
# =============================================================================
def bozulma_skoru(t):
    """Aşama 4'ün metriği sembol salatasını kaçırmıştı. Bu üç sinyali birleştirir.
    Gerçek Aşama 4 çıktılarıyla kalibre edildi."""
    if not t.strip(): return 1.0, {"cop":1.0,"sembol":1.0,"kirik":0.0}
    toks = t.split(); n = len(toks)
    cop   = sum(1 for x in toks if not re.search(r'[^\W\d_]{2,}', x)) / n
    sym   = len(re.findall(r'[—\[\]\|\$#~=]', t)) / max(1, len(t))
    kirik = sum(1 for x in toks if re.search(r'[^\W\d_][_~\[\]]|[_~][^\W\d_]', x)) / n
    return max(cop, sym*6, kirik*4), {"cop":cop, "sembol":sym, "kirik":kirik}

def latin_disi(t):
    """TR->Çince kaymasını yakalar (Aşama 4'te alpha=0.10'da olmuştu)."""
    L = re.findall(r'[^\W\d_]', t)
    return sum(1 for c in L if ord(c) > 0x2000) / max(1, len(L))

