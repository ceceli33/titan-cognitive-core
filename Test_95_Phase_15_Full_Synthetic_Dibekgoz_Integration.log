# EN İYİ AYARI SEÇ VE METİNLERİ GÖSTER
# =============================================================================
print("\n" + "="*78)
print("  DEĞERLENDİRME")
print("="*78)
print("  Hedef: bozulma düşük + maymungil yüksek + insansı düşük")
print("  + kontrol sorusu temiz kalsın\n")

def skor(nw, a):
    """Bir ayarın toplam puanı."""
    d1 = R[str(nw)]["q1"][str(a)]; d2 = R[str(nw)]["q2"][str(a)]
    kc = R[str(nw)]["kontrol"][str(a)]
    if max(d1["bozulma"], d2["bozulma"], kc["bozulma"]) > 0.15: return None
    if max(d1["latin_disi"], d2["latin_disi"]) > 0.2: return None
    # kontrol sorusuna biyoloji sızıntısı cezası
    sizinti = kc["lex"]["maymungil"] + kc["lex"]["anatomi"] + kc["lex"]["yabanci"]
    maymun = d1["lex"]["maymungil"] + d2["lex"]["maymungil"]
    anat   = d1["lex"]["anatomi"]   + d2["lex"]["anatomi"]
    insan  = d1["lex"]["insansi"]   + d2["lex"]["insansi"]
    yab    = d1["lex"]["yabanci"]   + d2["lex"]["yabanci"]
    return maymun*2 + anat - insan*1.5 - yab - sizinti*2

print(f"    {'nw':<7}{'alpha':<8}{'puan':>8}   (yüksek=iyi, '--'=elendi)")
print("    " + "-"*44)
best = None
for nw in NAME_GRID:
    for a in ALPHA_GRID:
        s = skor(nw, a)
        print(f"    {nw:<7.2f}{a:<8.2f}" + (f"{s:>8.1f}" if s is not None else f"{'--':>8}"))
        if s is not None and (best is None or s > best[0]):
            best = (s, nw, a)

if best is None:
    print("\n  ❌ Hiçbir ayar bozulma/sızıntı filtrelerinden geçemedi.")
    print("     Enjeksiyon bandı bu pusulayla çok dar. Aşama 3'e dönüş gerekebilir.")
    BEST_NW, BEST_A = 0.0, 0.0
else:
    _, BEST_NW, BEST_A = best
    print(f"\n  ✅ EN İYİ: isim_bağlayıcı={BEST_NW:.2f}, alpha={BEST_A:.2f} "
          f"(puan={best[0]:.1f})")

