print("="*78)
print("  Her hücre: bozulma skoru + sözcüksel yön profili\n")

R = {}
for nw in NAME_GRID:
    R[str(nw)] = {}
    print(f"\n{'#'*78}\n#  İSİM BAĞLAYICI AĞIRLIĞI = {nw}\n{'#'*78}")
    for qn, q in QS.items():
        R[str(nw)][qn] = {}
        print(f"\n  --- soru: {qn} ---")
        for a in ALPHA_GRID:
            txt, n_out = gen(q, a, nw)
            bs, bd = bozulma_skoru(txt)
            lx = lex_profil(txt)
            ld = latin_disi(txt)
            R[str(nw)][qn][str(a)] = {"text": txt, "n_out": n_out,
                "bozulma": bs, "bozulma_detay": bd, "latin_disi": ld, "lex": lx}
            durum = "SAĞLAM" if bs < 0.15 else ("ŞÜPHELİ" if bs < 0.40 else "BOZUK")
            print(f"    a={a:<5.2f} bozulma={bs:<6.3f}{durum:<9}"
                  f"maymun={lx['maymungil']:<3}insan={lx['insansi']:<3}"
                  f"anat={lx['anatomi']:<3}yabancı={lx['yabanci']:<3}"
                  f"{'  ⚠️ÇİNCE' if ld > 0.2 else ''}")
print()
