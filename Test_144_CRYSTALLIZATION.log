print(
    "\n[6] Building conditional top-K preservation cache..."
)


@torch.inference_mode()
def base_topk(prompt):

    enc = encode_chat(prompt)


    out = base(
        **enc,
        use_cache=False,
        return_dict=True,
    )


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    logits = (
        out.logits[0, pos, :]
        .detach()
        .float()
    )


    values, indices = torch.topk(
        logits,
        k=min(
            PRESERVE_TOP_K,
            logits.numel(),
        ),
    )


    result = {
        "indices": (
            indices
            .cpu()
            .to(torch.int32)
        ),

        "logits": (
            values
            .cpu()
            .to(torch.float16)
        ),
    }


    del out
    del enc


    return result


PRESERVE_CACHE = {}


for i, prompt in enumerate(
    TRAIN_PROMPTS,
