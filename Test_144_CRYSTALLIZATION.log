plt.xticks(
    np.arange(N_LAYERS),
    [
        f"L{i}"
        for i in range(N_LAYERS)
    ],
)


plt.xlabel(
    "Layer"
)

plt.ylabel(
    "Target progress (%)"
)

plt.title(
    f"TEST 144 — BEST Crystallized Layerwise Geometry\n"
    f"Step {BEST_STEP} | Motor OFF"
)

plt.tight_layout()


save_jpeg(
    fig,
    "TEST144_05_LAYERWISE_BEST.jpg",
)


# =============================================================================
# 56. JPEG 6 — COMMON PCA TRAJECTORY
# =============================================================================

PROFILE_INDEX = 0
PROFILE_LAYER = 14


vectors = [
    BASE_NP[
        PROFILE_INDEX,
        PROFILE_LAYER,
    ],

    T0_NP[
        PROFILE_INDEX,
        PROFILE_LAYER,
    ],
]


for step in eval_steps:

    vectors.append(
        EVAL_STATES[
            step
        ][
            PROFILE_INDEX,
            PROFILE_LAYER,
        ]
    )


vectors.append(
    MERGED_STATES[
        PROFILE_INDEX,
        PROFILE_LAYER,
    ]
)


vectors = np.stack(
    vectors,
    axis=0,
)


pca = PCA(
    n_components=2,
    svd_solver="full",
)


xy = pca.fit_transform(
    vectors
)


fig = plt.figure(
    figsize=(13, 10)
)


plt.scatter(
    xy[0, 0],
    xy[0, 1],
    s=130,
    label="Original Vanilla",
)


plt.scatter(
    xy[1, 0],
    xy[1, 1],
    s=190,
    marker="*",
    label="Immutable T0",
)


trajectory = xy[
    2:
    2 + len(eval_steps)
]


plt.plot(
    trajectory[:, 0],
    trajectory[:, 1],
    marker="o",
    linewidth=1.8,
    label="Motor-OFF trajectory",
)


for i, step in enumerate(
    eval_steps
):

    plt.text(
        trajectory[i, 0],
        trajectory[i, 1],
        f" {step}",
        fontsize=7,
    )


plt.scatter(
    xy[-1, 0],
    xy[-1, 1],
    marker="s",
    s=150,
    label="Final merged BEST",
)


plt.xlabel(
    f"PC1 "
    f"({100*pca.explained_variance_ratio_[0]:.2f}%)"
)

plt.ylabel(
    f"PC2 "
    f"({100*pca.explained_variance_ratio_[1]:.2f}%)"
)

plt.title(
    f"TEST 144 — Crystallization Trajectory | L{PROFILE_LAYER}\n"
    "PCA is visualization only; exact metrics are high-dimensional"
)

plt.legend()

plt.tight_layout()


save_jpeg(
    fig,
    "TEST144_06_PCA_CRYSTALLIZATION.jpg",
)


# =============================================================================
