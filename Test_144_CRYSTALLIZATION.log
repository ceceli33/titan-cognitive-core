# 58. JPEG 8 — TOP 50 COORDINATE CHANGES
# =============================================================================

change = F - B


top50 = np.argsort(
    np.abs(change)
)[-50:]


top50 = top50[
    np.argsort(
        np.abs(
            change[top50]
        )
    )
]


fig = plt.figure(
    figsize=(15, 11)
)


plt.barh(
    np.arange(50),
    change[top50],
)


plt.yticks(
    np.arange(50),
    [
        str(int(x))
        for x in top50
    ],
)


plt.axvline(
    0,
    linewidth=0.8,
)


plt.xlabel(
    "Crystallized OFF - Original Vanilla"
)

plt.ylabel(
    "Hidden dimension index"
)

