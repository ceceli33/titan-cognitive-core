@torch.inference_mode()
def generate_response(
    model,
    prompt,
):

    was_training = model.training

    model.eval()


    enc = encode_chat(prompt)


    prompt_len = int(
        enc["input_ids"].shape[1]
    )


    context_limit = int(
        getattr(
            model.config,
            "max_position_embeddings",
            32768,
        )
    )


    ceiling = max(
        1,
        context_limit
        - prompt_len
        - 1,
    )


    ids = model.generate(
        **enc,
        max_new_tokens=ceiling,
        do_sample=False,
        repetition_penalty=REPETITION_PENALTY,
        use_cache=True,
        pad_token_id=tokenizer.pad_token_id,
        eos_token_id=tokenizer.eos_token_id,
    )


    generated = ids[
        0,
        prompt_len:
    ]


    text = tokenizer.decode(
        generated,
        skip_special_tokens=True,
    ).strip()


    if was_training:
        model.train()


    return text


