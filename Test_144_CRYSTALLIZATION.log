def behavioral_snapshot(
    label,
    step,
):

    print(
        "\n" + "-" * 150
    )

    print(
        f"BEHAVIOR SNAPSHOT — {label} — STEP {step}"
    )

    print(
        "-" * 150
    )


    responses = []


    for i, prompt in enumerate(
        HELDOUT_PROMPTS
    ):

        response = generate_response(
            student,
            prompt,
        )


        responses.append(
            response
        )


        base_response = (
            BASE_RESPONSES[i]
        )


        changed = (
            response.strip()
            != base_response.strip()
        )


        BEHAVIOR_LOG.append(
            {
                "label": label,
                "step": int(step),
                "prompt_index": int(i),
                "prompt": prompt,
                "base_response": base_response,
                "current_response": response,
                "changed_from_base": bool(
                    changed
                ),
            }
        )


        print(
            f"[{i:02d}] changed={changed}"
        )


    return responses


# =============================================================================
# 35. STEP ZERO
# =============================================================================

step0 = evaluate_motor_off(
    0
)


if abs(
    step0["progress"]
) > 1e-6:

    raise RuntimeError(
        "Step-0 progress is not zero."
    )


BEST_PROGRESS = step0[
    "progress"
]

BEST_DISTANCE = step0[
    "distance"
]

BEST_ALIGNMENT = step0[
    "alignment"
]

BEST_STEP = 0


save_best_adapter(
    0
)


# =============================================================================
# 36. TRAINING LOOP
#
# IMPORTANT:
# EACH UPDATE:
#
# 1. use current endogenous compass
# 2. create ONE teacher target
# 3. natural motor-OFF student forward
# 4. update LoRA
# 5. re-extract compass immediately
#
# The Pusula therefore follows the model after every question.
# =============================================================================

print(
    "\n" + "=" * 150
)

print(
    "CRYSTALLIZATION TRAINING START"
)

print(
    "PER-UPDATE ENDOGENOUS COMPASS REFRESH"
)

print(
    "=" * 150
)


start_time = time.time()

update = 0

epoch = 0


while update < HARD_MAX_UPDATES:

    epoch += 1


    order = list(
        range(N_TRAIN)
    )


    rng.shuffle(order)


    for idx in order:

        if update >= HARD_MAX_UPDATES:
            break


        update += 1


        prompt = TRAIN_PROMPTS[
            idx
        ]


        # -----------------------------------------------------------------
        # CURRENT PUSULA -> ONE-SHOT TEACHER TARGET
        # -----------------------------------------------------------------

        target = current_teacher_target(
            prompt
        )


        # -----------------------------------------------------------------
        # MOTOR OFF NATURAL LEARNING
        # -----------------------------------------------------------------

        optimizer.zero_grad(
            set_to_none=True
        )


        (
            total_loss,
            geo_loss,
            preserve_loss,
        ) = training_forward(
            prompt,
            target,
        )


        if not torch.isfinite(
            total_loss
        ):

            raise RuntimeError(
                f"Non-finite loss @ {update}"
            )


        total_loss.backward()


        grad_norm = (
            torch.nn.utils
            .clip_grad_norm_(
                TRAINABLE_PARAMS,
                GRAD_CLIP,
            )
        )


        grad_norm_value = float(
            torch.as_tensor(
                grad_norm
            )
            .detach()
            .float()
            .cpu()
            .item()
        )


        if not math.isfinite(
            grad_norm_value
        ):

            raise RuntimeError(
                f"Non-finite gradient @ {update}"
            )


        optimizer.step()


        # -----------------------------------------------------------------
        # IMMEDIATE PUSULA REFRESH
        # -----------------------------------------------------------------

        previous_compass = [
            x.detach()
            .clone()
            for x in CURRENT_COMPASS
        ]


        (
            NEW_COMPASS,
            NEW_RAW_NORMS,
        ) = extract_student_compass()


        (
            mean_cos_initial,
            mean_cos_previous,
        ) = record_compass(
            update,
            previous_compass,
            NEW_COMPASS,
            NEW_RAW_NORMS,
        )


        CURRENT_COMPASS = [
            x.detach()
            .clone()
            .to(DEVICE)
            for x in NEW_COMPASS
        ]


        CURRENT_RAW_NORMS = list(
            NEW_RAW_NORMS
        )


        elapsed = (
            time.time()
            - start_time
        )


        TRAIN_LOG.append(
            {
                "step": int(update),
                "epoch": int(epoch),

                "loss_total": float(
                    total_loss
                    .detach()
                    .cpu()
                    .item()
                ),

                "loss_geometry": float(
                    geo_loss
                    .cpu()
                    .item()
                ),

                "loss_preserve_topk_conditional": float(
                    preserve_loss
                    .cpu()
                    .item()
                ),

                "grad_norm": float(
                    grad_norm_value
                ),

                "mean_compass_cos_initial": float(
                    mean_cos_initial
                ),

                "mean_compass_cos_previous": float(
                    mean_cos_previous
                ),

                "elapsed_seconds": float(
                    elapsed
                ),
            }
        )


        print(
            f"step={update:04d} | "
            f"loss={float(total_loss.detach().cpu()):.7f} | "
            f"geo={float(geo_loss.cpu()):.7f} | "
            f"presK={float(preserve_loss.cpu()):.7f} | "
            f"grad={grad_norm_value:.6f} | "
            f"cos(A0,At)={mean_cos_initial:+.6f} | "
            f"cos(Aprev,At)={mean_cos_previous:+.6f}"
        )


        del target
        del total_loss


        # =================================================================
        # CLOSED-LOOP HELD-OUT EQUILIBRIUM CHECK
        # =================================================================

        if (
            update % EVAL_EVERY == 0
        ):

            metrics = evaluate_motor_off(
                update
            )


            current_progress = metrics[
                "progress"
            ]

            current_distance = metrics[
                "distance"
            ]

            current_alignment = metrics[
                "alignment"
            ]


            # -------------------------------------------------------------
            # NEW BEST DECISION
            #
            # Primary criterion:
            # immutable-target progress.
            #
            # Distance and alignment are retained as supporting metrics.
            # -------------------------------------------------------------

            progress_gain = (
                current_progress
                - BEST_PROGRESS
            )


            relative_distance_gain = (
                (
                    BEST_DISTANCE
                    - current_distance
                )
                / max(
                    BEST_DISTANCE,
                    1e-12,
                )
            )


            alignment_gain = (
                current_alignment
                - BEST_ALIGNMENT
            )


            new_best = (
                current_progress
                > BEST_PROGRESS
                and
                current_alignment
                >= ALIGNMENT_FLOOR
            )


            if new_best:

                BEST_PROGRESS = (
                    current_progress
                )

                BEST_DISTANCE = (
                    current_distance
                )

                BEST_ALIGNMENT = (
                    current_alignment
                )

                BEST_STEP = int(
                    update
                )


                save_best_adapter(
                    BEST_STEP
                )


                NO_IMPROVEMENT_COUNT = 0


                print(
                    "\n>>> NEW CRYSTALLIZATION BEST <<<"
                )

                print(
                    "step      :",
                    BEST_STEP
                )

                print(
                    "progress  :",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                print(
                    "distance  :",
                    f"{BEST_DISTANCE:.8f}"
                )

                print(
                    "alignment :",
                    f"{BEST_ALIGNMENT:+.8f}"
                )


            else:

                meaningful_change = (
                    abs(progress_gain)
                    >= MIN_PROGRESS_IMPROVEMENT
                    or
                    abs(relative_distance_gain)
                    >= MIN_DISTANCE_IMPROVEMENT
                    or
                    abs(alignment_gain)
                    >= MIN_ALIGNMENT_IMPROVEMENT
                )


                # No new best means this evaluation consumes patience.
                NO_IMPROVEMENT_COUNT += 1


                print(
                    "\nNo new best."
                )

                print(
                    "patience:",
                    f"{NO_IMPROVEMENT_COUNT}/{PATIENCE_EVALS}"
                )


            # -------------------------------------------------------------
            # OVERSHOOT GUARD
            # -------------------------------------------------------------

            overshoot = (
                update
                >= MIN_UPDATES_BEFORE_STOP
                and
                (
                    BEST_PROGRESS
                    - current_progress
                )
                >= OVERSHOOT_PROGRESS_DROP
            )


            if overshoot:

                STOP_REASON = (
                    "OVERSHOOT_DETECTED"
                )


                print(
                    "\n>>> OVERSHOOT DETECTED <<<"
                )

                print(
                    "Best progress   :",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                print(
                    "Current progress:",
                    f"{100*current_progress:+.4f}%"
                )

                print(
                    "Returning to BEST state."
                )

                break


            # -------------------------------------------------------------
            # PLATEAU / EQUILIBRIUM
            # -------------------------------------------------------------

            if (
                update
                >= MIN_UPDATES_BEFORE_STOP
                and
                NO_IMPROVEMENT_COUNT
                >= PATIENCE_EVALS
            ):

                STOP_REASON = (
                    "HELDOUT_EQUILIBRIUM"
                )


                print(
                    "\n>>> CRYSTALLIZATION EQUILIBRIUM DETECTED <<<"
                )

                print(
                    "BEST STEP:",
                    BEST_STEP
                )

                print(
                    "BEST PROGRESS:",
                    f"{100*BEST_PROGRESS:+.4f}%"
                )

                print(
                    "BEST ALIGNMENT:",
                    f"{BEST_ALIGNMENT:+.8f}"
                )

                break


        if update % 25 == 0:

            gc.collect()
            torch.cuda.empty_cache()


    if STOP_REASON is not None:
        break


if STOP_REASON is None:
    STOP_REASON = "HARD_MAX_UPDATES"


LAST_STEP = int(update)


# =============================================================================
# 37. SAVE LAST STATE BEFORE ROLLBACK
# =============================================================================

if os.path.exists(LAST_DIR):
    shutil.rmtree(LAST_DIR)


student.save_pretrained(
    LAST_DIR
)


tokenizer.save_pretrained(
    LAST_DIR
)


print(
    "\n" + "=" * 150
)

print(
    "TRAINING STOPPED"
)

print(
    "=" * 150
)

print("Last step :", LAST_STEP)
print("Best step :", BEST_STEP)
print("Reason    :", STOP_REASON)

print(
    "Best progress:",
    f"{100*BEST_PROGRESS:+.4f}%"
)

print(
    "Best alignment:",
    f"{BEST_ALIGNMENT:+.8f}"
)


# =============================================================================
# 38. RELEASE LAST STUDENT AND RELOAD CLEAN BEST STATE
#
# This is a TRUE rollback.
# Optimizer is no longer needed.
# =============================================================================

del optimizer
del student

gc.collect()

torch.cuda.empty_cache()


print(
    "\nReloading clean base + BEST adapter..."
)


best_base = AutoModelForCausalLM.from_pretrained(
    MODEL_ID,
    dtype=torch.bfloat16,
    device_map={"": 0},
    attn_implementation="sdpa",
    trust_remote_code=True,
)


from peft import PeftModel


student = PeftModel.from_pretrained(
    best_base,
    BEST_DIR,
    is_trainable=False,
)


student.eval()


# =============================================================================
# 39. BEST BEHAVIORAL SNAPSHOT
# =============================================================================

BEST_RESPONSES = behavioral_snapshot(
    "BEST",
    BEST_STEP,
)


# =============================================================================
# 40. BEST MOTOR-OFF GEOMETRY RECHECK
# =============================================================================

def capture_best_off(prompt):

    student.eval()


    enc = encode_chat(prompt)


    out = student(
        **enc,
        output_hidden_states=True,
        use_cache=False,
        return_dict=True,
    )


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    states = [
        out.hidden_states[
            L + 1
        ][0, pos, :]
        .detach()
        .float()
        .cpu()
        .clone()

        for L in range(N_LAYERS)
    ]


    del out
    del enc


    return states


BEST_RELOADED_STATES = []


for prompt in HELDOUT_PROMPTS:

    states = capture_best_off(
        prompt
    )


    BEST_RELOADED_STATES.append(
        np.stack(
            [
                x.numpy()
                for x in states
            ],
            axis=0,
        )
    )


BEST_RELOADED_STATES = np.stack(
    BEST_RELOADED_STATES,
    axis=0,
)


# =============================================================================
# 41. MERGE BEST — DO NOT ABORT ON SMALL BF16 DRIFT
# =============================================================================

print(
    "\n" + "=" * 150
)

print(
    "MERGING BEST CRYSTALLIZED STATE"
)

print(
    "=" * 150
)


merged = student.merge_and_unload()

merged.eval()

merged.config.use_cache = True


del student
del best_base

gc.collect()

torch.cuda.empty_cache()


remaining_lora = [
    name
    for name, _
    in merged.named_modules()
    if "lora_" in name.lower()
]


if remaining_lora:
    raise RuntimeError(
        "LoRA modules remain after merge."
    )


print("LoRA runtime : REMOVED")
print("SEASC hooks  : NONE")
print("Motor        : OFF")


# =============================================================================
# 42. MERGED CAPTURE
# =============================================================================

@torch.inference_mode()
def capture_merged(prompt):

    enc = encode_chat(prompt)


    out = merged(
        **enc,
        output_hidden_states=True,
        use_cache=False,
        return_dict=True,
    )


    pos = (
        int(
            enc["attention_mask"][0]
            .sum()
            .item()
        )
        - 1
    )


    states = [
        out.hidden_states[
            L + 1
        ][0, pos, :]
        .detach()
        .float()
        .cpu()
        .clone()

        for L in range(N_LAYERS)
    ]


    del out
    del enc


    return states


MERGED_STATES = []


for prompt in HELDOUT_PROMPTS:

    states = capture_merged(
        prompt
    )


    MERGED_STATES.append(
        np.stack(
            [
                x.numpy()
                for x in states
            ],
            axis=0,
        )
    )


MERGED_STATES = np.stack(
    MERGED_STATES,
    axis=0,
)


MERGE_RELATIVE_DRIFT = float(
    np.linalg.norm(
        MERGED_STATES
        - BEST_RELOADED_STATES
    )
    /
    max(
        np.linalg.norm(
            BEST_RELOADED_STATES
        ),
        1e-12,
    )
)


print(
    "Merge relative hidden drift:",
    f"{MERGE_RELATIVE_DRIFT:.10e}"
)


# Diagnostic classification only.
# It NEVER destroys the completed experiment.

if MERGE_RELATIVE_DRIFT <= 0.005:

    MERGE_STATUS = "TIGHT_EQUIVALENCE"

elif MERGE_RELATIVE_DRIFT <= 0.015:

    MERGE_STATUS = (
        "SMALL_BF16_MERGE_DRIFT"
    )

else:

    MERGE_STATUS = (
        "MERGE_DRIFT_REQUIRES_REVIEW"
    )


print(
    "Merge status:",
    MERGE_STATUS
)


# =============================================================================
# 43. FINAL MERGED GEOMETRY
# =============================================================================

merged_distance = np.zeros(
    N_LAYERS
)

merged_progress = np.zeros(
    N_LAYERS
)

merged_alignment = np.zeros(
    N_LAYERS
)


for i in range(N_HELDOUT):

    for L in range(N_LAYERS):

        B = BASE_HELDOUT[
            i
        ][L].numpy()


        T = T0_HELDOUT[
            i
        ][L].numpy()


        S = MERGED_STATES[
            i,
            L,
        ]


        D0 = max(
            np.linalg.norm(
                B - T
            ),
            1e-12,
        )


        D = np.linalg.norm(
            S - T
        )


        merged_distance[L] += D

        merged_progress[L] += (
            1.0 - D / D0
        )

        merged_alignment[L] += safe_cos(
            S - B,
            T - B,
        )


merged_distance /= N_HELDOUT
merged_progress /= N_HELDOUT
merged_alignment /= N_HELDOUT


FINAL_PROGRESS = float(
    merged_progress.mean()
)

FINAL_DISTANCE = float(
    merged_distance.mean()
)

FINAL_ALIGNMENT = float(
    merged_alignment.mean()
)


print(
    "\nFINAL MERGED MOTOR-OFF:"
)

print(
    "Progress :",
    f"{100*FINAL_PROGRESS:+.4f}%"
)

print(
    "Distance :",
    f"{FINAL_DISTANCE:.8f}"
)

print(
    "Alignment:",
    f"{FINAL_ALIGNMENT:+.8f}"
)


# =============================================================================
# 44. FINAL BEHAVIORAL RESPONSES
# =============================================================================

print(
    "\nRecording FINAL merged responses..."
)


FINAL_RESPONSES = []


for i, prompt in enumerate(
    HELDOUT_PROMPTS
):

    response = generate_response(
        merged,
        prompt,
    )


    FINAL_RESPONSES.append(
        response
    )


    BEHAVIOR_LOG.append(
        {
            "label": "FINAL_MERGED",
            "step": int(BEST_STEP),
            "prompt_index": int(i),
            "prompt": prompt,
            "base_response": BASE_RESPONSES[i],
            "current_response": response,
            "changed_from_base": bool(
                response.strip()
                != BASE_RESPONSES[i].strip()
            ),
        }
    )


# =============================================================================
# 45. BEHAVIORAL COMPARISON TABLE
# =============================================================================

BEHAVIOR_ROWS = []


for i, prompt in enumerate(
    HELDOUT_PROMPTS
):

    base_text = BASE_RESPONSES[i]

    best_text = BEST_RESPONSES[i]

    final_text = FINAL_RESPONSES[i]


    base_tokens = set(
        base_text.lower().split()
    )

    best_tokens = set(
        best_text.lower().split()
    )

    final_tokens = set(
        final_text.lower().split()
    )


    def jaccard(a, b):

        if not a and not b:
            return 1.0

        return (
            len(a & b)
            / max(
                len(a | b),
                1,
            )
        )


    BEHAVIOR_ROWS.append(
        {
            "prompt_index": i,

            "prompt": prompt,

            "base_response": base_text,

            "best_response": best_text,

            "final_merged_response": final_text,

            "best_changed_from_base": (
                best_text.strip()
                != base_text.strip()
            ),

            "final_changed_from_base": (
                final_text.strip()
                != base_text.strip()
            ),

            "base_best_lexical_jaccard": (
                jaccard(
                    base_tokens,
                    best_tokens,
                )
            ),

            "base_final_lexical_jaccard": (
                jaccard(
                    base_tokens,
                    final_tokens,
                )
            ),

            "best_final_lexical_jaccard": (
                jaccard(
                    best_tokens,
                    final_tokens,
                )
            ),
        }
    )


