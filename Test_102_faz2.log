NEG = [x.format(X=NEG_DIBEK) for x in TUR_KALIP]

DIBEK = contrastive_vectors(POS, NEG)

RESIDUAL = {}
GEOMETRY = {}

for li in SOURCE_LAYERS:

    vl = DIBEK[li].float()
    vn = DIBEK[li + 1].float()

    c = cosine(vl, vn)

    raw = vn - torch.dot(vn, vl) * vl
    rn = normalize(raw)

    if rn is None:
        raise RuntimeError(f"L{li}->L{li+1}: residual sıfır.")

    orth = cosine(rn, vl)

    # v_next = c*v_l + s*r_next
    s = float(torch.linalg.vector_norm(raw))

    recon = c * vl + s * rn
    recon_cos = cosine(recon, vn)

    RESIDUAL[li] = rn

    GEOMETRY[li] = {
        "dictionary_cos": c,
        "dictionary_angle_deg": angle_deg_from_cos(c),
        "residual_norm_s": s,
        "residual_orthogonality": orth,
        "reconstruction_cos": recon_cos,
    }

print(
    f"Mean cos(v_l,v_next) = "
    f"{np.mean([GEOMETRY[l]['dictionary_cos'] for l in SOURCE_LAYERS]):+.6f}"
)

print(
    f"Mean residual size s = "
    f"{np.mean([GEOMETRY[l]['residual_norm_s'] for l in SOURCE_LAYERS]):.6f}"
)

print(
    f"Max |cos(r_next,v_l)| = "
    f"{max(abs(GEOMETRY[l]['residual_orthogonality']) for l in SOURCE_LAYERS):.3e}"
)


