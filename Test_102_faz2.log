print("Bu test birkaç dakika sürebilir.")

RAW = []

t_exp = time.time()

for di, probe_rel in enumerate(PROBE_RELS):

    dose_rows = []

    print(f"\n--- DOSE {probe_rel:.4f} ---")

    for pi, prompt in enumerate(PROMPTS):

        baseline = baseline_pass(prompt)

        pr = {
            "prompt_index": pi + 1,
            "context": CONTEXT[pi],
            "prompt": prompt,
            "probe_rel": probe_rel,
            "layers": {}
        }

        for li in SOURCE_LAYERS:

            vl = DIBEK[li]
            vn = DIBEK[li + 1]
            rn = RESIDUAL[li]

            # ---------------------------------------------------------
            # SEMANTIC +v_l
            # ---------------------------------------------------------

            sem = one_step_probe(
                prompt,
                baseline,
                li,
                vl,
                probe_rel
            )

            ds = sem["delta_source"]
            dt = sem["delta_target"]

            sem_source_cos_vl = cosine(ds, vl)

            sem_row = {
                "R_new":
                    cosine(dt, rn),

                "A_next":
                    cosine(dt, vn),

                "A_old":
                    cosine(dt, vl),

                "source_cos_old":
                    sem_source_cos_vl,

                "source_cos_new":
                    cosine(ds, rn),

                "gain":
                    sem["gain"],

                "realized_relative":
                    sem["realized_relative"],

                "realized_direction_cos":
                    sem["realized_direction_cos"],
            }

            # ---------------------------------------------------------
            # SIGN-FLIP -v_l
            #
            # Gerçek yönsel etki varsa ortogonal çıktı işaretinin de
            # ters dönmesi beklenir.
            # ---------------------------------------------------------

            neg = one_step_probe(
                prompt,
                baseline,
                li,
                -vl,
                probe_rel
            )

            neg_dt = neg["delta_target"]

            neg_row = {
                "R_new":
                    cosine(neg_dt, rn),

                "A_next":
                    cosine(neg_dt, vn),

                "A_old":
                    cosine(neg_dt, vl),

                "gain":
                    neg["gain"],

                "realized_relative":
                    neg["realized_relative"],
            }

            # Antisymmetry:
            # +v_l -> +r ve -v_l -> -r ise bu değer pozitif olur.
            sign_symmetry = 0.5 * (
                sem_row["R_new"]
                - neg_row["R_new"]
            )

            # ---------------------------------------------------------
            # SYNTH
            # ---------------------------------------------------------

            syn = one_step_probe(
                prompt,
                baseline,
                li,
                SYNTH,
                probe_rel
            )

            syn_dt = syn["delta_target"]

            syn_row = {
                "R_new":
                    cosine(syn_dt, rn),

                "A_next":
                    cosine(syn_dt, vn),

                "self":
                    cosine(syn_dt, SYNTH),

                "gain":
                    syn["gain"],

                "realized_relative":
                    syn["realized_relative"],
            }

            # ---------------------------------------------------------
            # ANGLE-MATCHED RANDOM NULL
            #
            # Eşleşme hedefi: semantic perturbasyonun GERÇEK BF16
            # source_cos_old değeri.
            # ---------------------------------------------------------

            random_rows = []

            for ri in range(N_MATCHED_RANDOM):

                q = make_angle_matched_direction(
                    vl,
                    sem_source_cos_vl,
                    pi,
                    li,
                    di,
                    ri
                )

                rr = one_step_probe(
                    prompt,
                    baseline,
                    li,
                    q,
                    probe_rel
                )

                rds = rr["delta_source"]
                rdt = rr["delta_target"]

                random_rows.append({
                    "R_new":
                        cosine(rdt, rn),

                    "A_next":
                        cosine(rdt, vn),

                    "A_old":
                        cosine(rdt, vl),

                    "source_cos_old":
                        cosine(rds, vl),

                    "source_cos_new":
                        cosine(rds, rn),

                    "gain":
                        rr["gain"],

                    "realized_relative":
                        rr["realized_relative"],

                    "realized_direction_cos":
                        rr["realized_direction_cos"],
                })

            rand_R = np.asarray(
                [x["R_new"] for x in random_rows],
                dtype=np.float64
            )

            rand_source_cos = np.asarray(
                [x["source_cos_old"] for x in random_rows],
                dtype=np.float64
            )

            rand_A_next = np.asarray(
                [x["A_next"] for x in random_rows],
                dtype=np.float64
            )

            # Ana contrast
            sem_minus_random_R = (
                sem_row["R_new"]
                - float(np.mean(rand_R))
            )

            # BF16 sonrası gerçekten ne kadar iyi eşleşti?
            source_angle_match_error = (
                float(np.mean(rand_source_cos))
                - sem_source_cos_vl
            )

            pr["layers"][str(li)] = {
                "geometry": GEOMETRY[li],

                "semantic": sem_row,

                "negative_semantic": neg_row,

                "sign_symmetry_R":
                    sign_symmetry,

                "synthetic": syn_row,

                "random": random_rows,

                "random_R_mean":
                    float(np.mean(rand_R)),

                "random_R_sd":
                    float(np.std(rand_R, ddof=1)),

                "random_A_next_mean":
                    float(np.mean(rand_A_next)),

                "random_source_cos_old_mean":
                    float(np.mean(rand_source_cos)),

                "source_angle_match_error":
                    source_angle_match_error,

                "semantic_minus_random_R":
                    sem_minus_random_R,
            }

        dose_rows.append(pr)

        if (pi + 1) % 5 == 0:
            gc.collect()
            torch.cuda.empty_cache()

        print(
            f"  {pi+1:02d}/{len(PROMPTS)} "
            f"| total elapsed {(time.time()-t_exp)/60:.1f} min",
            end="\r"
        )

    RAW.append({
        "probe_rel": probe_rel,
        "prompts": dose_rows
    })

    print()


print(
    f"\nDeney tamamlandı: "
    f"{(time.time()-t_exp)/60:.1f} min"
)


# =============================================================================
# 15. ANALYSIS HELPERS
# =============================================================================

def dose_data(dose_index):
    return RAW[dose_index]["prompts"]


def collect(dose_index, li, path, context=None):

    vals = []

    for pr in dose_data(dose_index):

        if context is not None and pr["context"] != context:
            continue

        x = pr["layers"][str(li)]

        for key in path:
            x = x[key]

        vals.append(x)

    return np.asarray(vals, dtype=np.float64)


# =============================================================================
# 16. LAYER TABLES
# =============================================================================

print("\n[6/17] Katman tabloları...")

SUMMARY = {}

for di, probe_rel in enumerate(PROBE_RELS):

    print("\n" + "=" * 155)
    print(f"DOSE = {probe_rel:.4f}")
    print("=" * 155)

    print(
        f"{'STEP':<10}"
        f"{'dict cos':>11}"
        f"{'r size':>10}"
        f"{'R_sem':>11}"
