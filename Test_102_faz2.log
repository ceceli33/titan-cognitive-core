# =============================================================================
# 7. VECTOR EXTRACTION
# =============================================================================

@torch.no_grad()
def extract_vectors(texts):

    enc = tokenizer(
        texts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=128
    )

    ids = enc["input_ids"].to(device)
    mask = enc["attention_mask"].to(device)

    captures = [None] * VECTOR_LAYERS
    handles = []

    def make_hook(li):

        def hook(module, inp, out):
            h = out[0] if isinstance(out, tuple) else out
            captures[li] = h.detach()

        return hook

    try:
        for li in range(VECTOR_LAYERS):
            handles.append(
                model.model.layers[li].register_forward_hook(
                    make_hook(li)
                )
            )

        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False
        )

    finally:
        for h in handles:
            h.remove()

    lengths = mask.sum(1).cpu().numpy()

    result = torch.zeros(
        len(texts),
        VECTOR_LAYERS,
        HIDDEN,
        dtype=torch.float32
    )

    for li in range(VECTOR_LAYERS):

        x = captures[li].float().cpu()

        for i in range(len(texts)):
            result[i, li] = x[i, int(lengths[i]) - 1]

    return result


def contrastive_vectors(pos, neg):

    XP = extract_vectors(pos)
    XN = extract_vectors(neg)

    out = {}

    for li in range(VECTOR_LAYERS):
        d = XP[:, li].mean(0) - XN[:, li].mean(0)
        out[li] = F.normalize(d, dim=0)

    del XP, XN
    return out


