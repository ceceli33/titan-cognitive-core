            di, li,
            ["source_angle_match_error"]
        )

        synR = collect(
            di, li,
            ["synthetic", "R_new"]
        )

        rel = collect(
            di, li,
            ["semantic", "realized_relative"]
        )

        src_cos = collect(
            di, li,
            ["semantic", "source_cos_old"]
        )

        dose_summary[str(li)] = {
            "R_sem": stats(Rsem),
            "R_random": stats(Rrand),
            "delta_R": stats(dR),
            "sign_symmetry_R": stats(sign),
            "A_next": stats(Anext),
            "A_old": stats(Aold),
            "synthetic_R": stats(synR),
            "match_error": stats(match),
            "realized_relative": stats(rel),
            "source_cos_old": stats(src_cos),

            "ZOO_R":
                stats(
                    collect(
                        di, li,
                        ["semantic", "R_new"],
                        "ZOO"
                    )
                ),

            "NEUTRAL_R":
                stats(
                    collect(
                        di, li,
                        ["semantic", "R_new"],
                        "NEUTRAL"
                    )
                ),
        }

        print(
            f"L{li}->L{li+1:<4}"
            f"{GEOMETRY[li]['dictionary_cos']:>+11.4f}"
            f"{GEOMETRY[li]['residual_norm_s']:>10.4f}"
            f"{np.mean(Rsem):>+11.5f}"
            f"{np.mean(Rrand):>+11.5f}"
            f"{np.mean(dR):>+11.5f}"
            f"{np.mean(sign):>+11.5f}"
            f"{np.mean(Anext):>+11.5f}"
            f"{np.mean(Aold):>+11.5f}"
            f"{np.mean(match):>+12.5f}"
        )

    SUMMARY[str(probe_rel)] = dose_summary


# =============================================================================
# 17. GLOBAL DOSE SUMMARY
# =============================================================================

print("\n[7/17] Global dose özeti...")

DOSE_SUMMARY = {}

for di, probe_rel in enumerate(PROBE_RELS):

    all_R = []
    all_rand = []
    all_dR = []
    all_sign = []
    all_syn = []
    all_match = []
    all_rel = []
    all_src_cos = []

    layer_mean_dR = []
    layer_mean_R = []
    layer_mean_sign = []

    for li in SOURCE_LAYERS:

        R = collect(
            di, li,
            ["semantic", "R_new"]
        )

        RR = collect(
            di, li,
            ["random_R_mean"]
        )

        DR = collect(
            di, li,
            ["semantic_minus_random_R"]
        )

        SG = collect(
            di, li,
            ["sign_symmetry_R"]
        )

        SY = collect(
            di, li,
            ["synthetic", "R_new"]
        )

        MA = collect(
            di, li,
            ["source_angle_match_error"]
        )

        RE = collect(
            di, li,
            ["semantic", "realized_relative"]
        )

        SC = collect(
            di, li,
            ["semantic", "source_cos_old"]
        )

        all_R.extend(R.tolist())
        all_rand.extend(RR.tolist())
        all_dR.extend(DR.tolist())
        all_sign.extend(SG.tolist())
        all_syn.extend(SY.tolist())
        all_match.extend(MA.tolist())
        all_rel.extend(RE.tolist())
        all_src_cos.extend(SC.tolist())

        layer_mean_dR.append(float(np.mean(DR)))
        layer_mean_R.append(float(np.mean(R)))
        layer_mean_sign.append(float(np.mean(SG)))

    ds = {
        "R_sem": stats(all_R),
        "R_random": stats(all_rand),
        "delta_R": stats(all_dR),
        "sign_symmetry_R": stats(all_sign),
        "synthetic_R": stats(all_syn),
        "match_error": stats(all_match),
        "realized_relative": stats(all_rel),
        "source_cos_old": stats(all_src_cos),

        "positive_layer_fraction_delta_R":
            float(np.mean(np.asarray(layer_mean_dR) > 0)),

        "positive_layer_fraction_R":
            float(np.mean(np.asarray(layer_mean_R) > 0)),

        "positive_layer_fraction_sign":
            float(np.mean(np.asarray(layer_mean_sign) > 0)),
    }

    DOSE_SUMMARY[str(probe_rel)] = ds

    print(f"\nDOSE {probe_rel:.4f}")
    print(
        f"  R_sem             = "
        f"{ds['R_sem']['mean']:+.6f} "
        f"{ci_text(ds['R_sem'])}"
    )
    print(
        f"  R_random          = "
        f"{ds['R_random']['mean']:+.6f}"
    )
    print(
        f"  semantic-random   = "
        f"{ds['delta_R']['mean']:+.6f} "
        f"{ci_text(ds['delta_R'])}"
    )
    print(
        f"  sign symmetry     = "
        f"{ds['sign_symmetry_R']['mean']:+.6f} "
        f"{ci_text(ds['sign_symmetry_R'])}"
    )
    print(
        f"  SYNTH -> residual = "
        f"{ds['synthetic_R']['mean']:+.6f}"
    )
    print(
        f"  positive ΔR layers= "
        f"{ds['positive_layer_fraction_delta_R']:.3f}"
    )
    print(
        f"  realized REL      = "
        f"{ds['realized_relative']['mean']:.7f}"
    )
    print(
        f"  source cos(v_l)   = "
