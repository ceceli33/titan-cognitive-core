        f"{'A_old':>11}"
        f"{'match err':>12}"
    )

    print("-" * 155)

    dose_summary = {}

    for li in SOURCE_LAYERS:

        Rsem = collect(
            di, li,
            ["semantic", "R_new"]
        )

        Rrand = collect(
            di, li,
            ["random_R_mean"]
        )

        dR = collect(
            di, li,
