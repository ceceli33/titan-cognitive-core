# 9. DIBEKGOZ DICTIONARY + ORTHOGONAL RESIDUALS
#
# r_(l+1), v_(l+1)'in v_l ile açıklanamayan parçasıdır.
# =============================================================================

print("\n[3/17] Dibekgoz sözlüğü ve ortogonal semantic residual'lar...")

