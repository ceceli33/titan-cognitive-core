    )
    print(
        f"  match error       = "
        f"{ds['match_error']['mean']:+.6f}"
    )


# =============================================================================
# 18. DOSE REPLICATION
#
# Aynı katman örüntüsü iki perturbasyon dozunda da çıkıyor mu?
# =============================================================================

print("\n[8/17] İki doz arasındaki katman örüntüsü...")

layer_dR_low = np.asarray([
    SUMMARY[str(PROBE_RELS[0])][str(li)]["delta_R"]["mean"]
    for li in SOURCE_LAYERS
])

layer_dR_high = np.asarray([
    SUMMARY[str(PROBE_RELS[1])][str(li)]["delta_R"]["mean"]
    for li in SOURCE_LAYERS
])

if (
    np.std(layer_dR_low) > 1e-12 and
    np.std(layer_dR_high) > 1e-12
):
    dose_corr = float(
        np.corrcoef(
            layer_dR_low,
            layer_dR_high
        )[0, 1]
    )
else:
    dose_corr = float("nan")

same_sign_fraction = float(
    np.mean(
        np.sign(layer_dR_low)
        ==
        np.sign(layer_dR_high)
    )
)

print(
    f"corr(layer ΔR low, high) = "
    f"{dose_corr:+.6f}"
)

print(
    f"same-sign layer fraction = "
    f"{same_sign_fraction:.3f}"
)


# =============================================================================
# 19. CONTEXT
# =============================================================================

print("\n[9/17] Bağlam kontrolü...")

CONTEXT_SUMMARY = {}

for di, probe_rel in enumerate(PROBE_RELS):

    diffs = []

    print(f"\nDOSE {probe_rel:.4f}")

    for li in SOURCE_LAYERS:

        z = SUMMARY[str(probe_rel)][str(li)]["ZOO_R"]["mean"]
        n = SUMMARY[str(probe_rel)][str(li)]["NEUTRAL_R"]["mean"]

        diffs.append(z - n)

        print(
            f"  L{li:02d}->L{li+1:02d} "
            f"ZOO={z:+.5f} "
            f"NEUTRAL={n:+.5f} "
            f"Δ={z-n:+.5f}"
        )

    CONTEXT_SUMMARY[str(probe_rel)] = stats(diffs)

    print(
        f"  Mean ZOO−NEUTRAL across layers = "
        f"{np.mean(diffs):+.6f}"
    )


# =============================================================================
# 20. GEOMETRY RELATION
#
# Yeni semantic bileşenin büyüklüğü s_l ile gözlenen rotation ilişkili mi?
# =============================================================================

print("\n[10/17] Sözlük dönüşümü ile ölçülen rotation ilişkisi...")

RESIDUAL_SIZE = np.asarray([
    GEOMETRY[li]["residual_norm_s"]
    for li in SOURCE_LAYERS
])

GEOM_CORR = {}

for probe_rel in PROBE_RELS:

    layer_R = np.asarray([
        SUMMARY[str(probe_rel)][str(li)]["R_sem"]["mean"]
        for li in SOURCE_LAYERS
    ])

    layer_dR = np.asarray([
        SUMMARY[str(probe_rel)][str(li)]["delta_R"]["mean"]
        for li in SOURCE_LAYERS
    ])

    corr_R = float(
        np.corrcoef(
            RESIDUAL_SIZE,
            layer_R
        )[0, 1]
    )

    corr_dR = float(
        np.corrcoef(
            RESIDUAL_SIZE,
            layer_dR
        )[0, 1]
    )

    GEOM_CORR[str(probe_rel)] = {
        "residual_size_vs_R": corr_R,
        "residual_size_vs_delta_R": corr_dR,
    }

    print(
        f"DOSE {probe_rel:.4f} | "
        f"corr(s,R)={corr_R:+.5f} | "
        f"corr(s,ΔR)={corr_dR:+.5f}"
    )


# =============================================================================
# 21. STRONGEST / WEAKEST ROTATIONS
# =============================================================================

print("\n[11/17] En güçlü / en zayıf ortogonal dönüşümler...")

for probe_rel in PROBE_RELS:

    vals = np.asarray([
        SUMMARY[str(probe_rel)][str(li)]["delta_R"]["mean"]
        for li in SOURCE_LAYERS
    ])

    order = np.argsort(-vals)

    print(f"\nDOSE {probe_rel:.4f} — strongest")

    for idx in order[:5]:

        li = SOURCE_LAYERS[int(idx)]

        print(
            f"  L{li}->L{li+1}: "
            f"R={SUMMARY[str(probe_rel)][str(li)]['R_sem']['mean']:+.5f} | "
            f"ΔR={vals[idx]:+.5f} | "
            f"s={GEOMETRY[li]['residual_norm_s']:.4f}"
        )

    print(f"DOSE {probe_rel:.4f} — weakest")

    for idx in order[-5:]:

        li = SOURCE_LAYERS[int(idx)]

        print(
            f"  L{li}->L{li+1}: "
            f"R={SUMMARY[str(probe_rel)][str(li)]['R_sem']['mean']:+.5f} | "
            f"ΔR={vals[idx]:+.5f} | "
            f"s={GEOMETRY[li]['residual_norm_s']:.4f}"
        )


# =============================================================================
# 22. DECISION
#
# Eşikler önceden sabit:
#
# ACTIVE:
#   iki dozda da ΔR > 0
#   iki dozda da alt descriptive CI > 0
#   >= 80% katmanda ΔR pozitif
#   sign-flip antisymmetry > 0
#   dozlar arası katman işareti >= 80%
#
# PASSIVE:
#   iki dozda da ortogonal avantaj çok küçük / CI sıfırı içeriyor.
#
# Aradaki durum: MIXED.
# =============================================================================

print("\n[12/17] DECISION")
print("=" * 155)

low = DOSE_SUMMARY[str(PROBE_RELS[0])]
high = DOSE_SUMMARY[str(PROBE_RELS[1])]

active_low = (
    low["delta_R"]["mean"] > 0
    and low["delta_R"]["ci95_descriptive"][0] > 0
    and low["positive_layer_fraction_delta_R"] >= 0.80
    and low["sign_symmetry_R"]["mean"] > 0
)

active_high = (
    high["delta_R"]["mean"] > 0
    and high["delta_R"]["ci95_descriptive"][0] > 0
    and high["positive_layer_fraction_delta_R"] >= 0.80
    and high["sign_symmetry_R"]["mean"] > 0
)

if (
    active_low
    and active_high
    and same_sign_fraction >= 0.80
):

    DECISION = (
        "ORTHOGONAL_SEMANTIC_ROTATION_SUPPORTED"
    )

elif (
    abs(low["delta_R"]["mean"]) < 0.02
    and abs(high["delta_R"]["mean"]) < 0.02
    and low["delta_R"]["ci95_descriptive"][0] <= 0 <= low["delta_R"]["ci95_descriptive"][1]
    and high["delta_R"]["ci95_descriptive"][0] <= 0 <= high["delta_R"]["ci95_descriptive"][1]
):

    DECISION = (
        "PASSIVE_DIRECTIONAL_PERSISTENCE_DOMINANT"
    )

else:

    DECISION = (
        "MIXED_ORTHOGONAL_TRANSPORT_STRUCTURE"
    )

print(f"Low-dose ΔR   : {low['delta_R']['mean']:+.6f} {ci_text(low['delta_R'])}")
print(f"High-dose ΔR  : {high['delta_R']['mean']:+.6f} {ci_text(high['delta_R'])}")

print(
    f"Low positive layers : "
    f"{low['positive_layer_fraction_delta_R']:.3f}"
)

print(
    f"High positive layers: "
    f"{high['positive_layer_fraction_delta_R']:.3f}"
)

print(
    f"Low sign symmetry    : "
    f"{low['sign_symmetry_R']['mean']:+.6f}"
)

print(
    f"High sign symmetry   : "
    f"{high['sign_symmetry_R']['mean']:+.6f}"
)

print(
    f"Dose same-sign layers: "
    f"{same_sign_fraction:.3f}"
)

print()
print("DECISION:")
print(DECISION)


