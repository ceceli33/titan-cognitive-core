print("\n[4/17] Test94 sentetik vektörü...")


def build_synth_t94():

    rng = random.Random(42)

    def l2n(v):
        n = math.sqrt(sum(x*x for x in v))
        return [x/n for x in v]

    vecs = [
        l2n([rng.gauss(0, 1) for _ in range(HIDDEN)])
        for _ in range(4)
    ]

    weights = [0.9228, 0.9372, 0.8788, 0.9196]

    raw = [0.0] * HIDDEN

    for v, w in zip(vecs, weights):
        for i in range(HIDDEN):
            raw[i] += w * v[i]

    return l2n(raw)


SYNTH = torch.tensor(
    build_synth_t94(),
    dtype=torch.float32
)

SYNTH = F.normalize(SYNTH, dim=0)

print(
    "First5:",
    [round(float(x), 10) for x in SYNTH[:5]]
)


# =============================================================================
# 11. BASELINE
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = out[0] if isinstance(out, tuple) else out

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):
            handles.append(
                model.model.layers[li].register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(**enc, use_cache=False)

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. ONE-STEP PROBE
#
# Hem istenen hem BF16'ya gerçekten yazılan perturbasyonu kaydeder.
# =============================================================================

@torch.no_grad()
def one_step_probe(prompt, baseline, li, direction, probe_rel):

    target = li + 1

    src_base = baseline[li].float()

    requested_norm = (
        probe_rel *
        float(torch.linalg.vector_norm(src_base))
    )

    q = F.normalize(
        direction.float(),
        dim=0
    ).to(device)

    cap = {}
    src_delta = {}
    handles = []

    def source_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        before = h[0, -1].float()

        requested_post = before + requested_norm * q

        hnew = h.clone()
        hnew[0, -1] = requested_post.to(h.dtype)

        realized = (
            hnew[0, -1].float() -
            before
        )

        src_delta["d"] = (
            realized
            .detach()
            .cpu()
            .clone()
        )

        if isinstance(out, tuple):
            return (hnew,) + out[1:]

        return hnew

    def target_hook(module, inp, out):

        h = out[0] if isinstance(out, tuple) else out

        cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(source_hook)
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(target_hook)
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(device)

        model(**enc, use_cache=False)

    finally:

        for h in handles:
            h.remove()

    ds = src_delta["d"]

    dt = (
        cap["h"] -
        baseline[target]
    )

    ds_norm = float(torch.linalg.vector_norm(ds))
    dt_norm = float(torch.linalg.vector_norm(dt))

    return {
        "delta_source": ds,
        "delta_target": dt,

        "requested_relative": probe_rel,

        "realized_relative":
            ds_norm /
            (
                float(torch.linalg.vector_norm(src_base))
                + EPS
            ),

        "realized_direction_cos":
            cosine(ds, direction),

        "gain":
            dt_norm / (ds_norm + EPS),
    }


# =============================================================================
# 13. ANGLE-MATCHED RANDOM SOURCE DIRECTION
#
# Semantic BF16 perturbasyonu v_l ile örneğin cos=0.88 yaptıysa,
# random kontrolün requested yönünü de v_l çevresinde aynı açıya kuruyoruz.
#
# Böylece random null, semantic kaynağın BF16 açı bozulmasını taklit eder.
# =============================================================================

def make_angle_matched_direction(
    vl,
    target_cos,
    prompt_index,
    li,
    dose_index,
    random_index
):

    vl = normalize(vl)

    g = torch.Generator(device="cpu")

    g.manual_seed(
        SEED
        + 10000000 * dose_index
        + 100000 * (prompt_index + 1)
        + 1000 * li
        + random_index
    )

    z = torch.randn(
        HIDDEN,
        generator=g,
        dtype=torch.float32
    )

    # v_l'ye dik random tangent
    u = z - torch.dot(z, vl) * vl
    u = normalize(u)

    if u is None:
        raise RuntimeError("Random tangent üretilemedi.")

    c = max(-0.999999, min(0.999999, float(target_cos)))
    s = math.sqrt(max(0.0, 1.0 - c*c))

    q = c * vl + s * u

    return normalize(q)


