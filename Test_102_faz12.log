# 5. ÇIKARIM + SÖZLÜK
# =============================================================================

@torch.inference_mode()
def extract_hidden(texts):
    enc = tokenizer(texts, padding=True, truncation=True, max_length=128, return_tensors="pt")
    ids = enc["input_ids"].to(device); mask = enc["attention_mask"].to(device)
    lengths = mask.sum(dim=1).long()
    cap = [None] * VECTOR_LAYERS
    hs = []

    def mk(li):
        def h(m, i, o):
            cap[li] = (o[0] if isinstance(o, tuple) else o).detach()
        return h

    try:
        for li in range(VECTOR_LAYERS):
            hs.append(model.model.layers[li].register_forward_hook(mk(li)))
        model(input_ids=ids, attention_mask=mask, use_cache=False)
    finally:
        for h in hs:
            h.remove()
    B = ids.shape[0]
    out = torch.empty(B, VECTOR_LAYERS, HIDDEN, dtype=torch.float32)
    for li in range(VECTOR_LAYERS):
        h = cap[li].float()
        rows = torch.arange(B, device=h.device)
        out[:, li] = h[rows, (lengths - 1).to(h.device)].cpu()
    return out


def build_dictionary(pos, neg):
    xp = extract_hidden(pos); xn = extract_hidden(neg)
    d = {li: unit(xp[:, li].mean(0) - xn[:, li].mean(0)) for li in range(VECTOR_LAYERS)}
    del xp, xn
    gc.collect()
    return d


