               "shell_deg": SHELL_DEG, "n_sem": N_SEMANTIC, "n_rnd": N_RANDOM, "n_null": N_NULL,
               "null_jitter_rel": NULL_JITTER_REL, "mercek_k": MERCEK_K,
               "mercek_calib": MERCEK_CALIB, "dev_idx": DEV_IDX.tolist()},
    "fingerprint": {"L10": cos10, "L11": cos11, "status": "PASS"},
    "dibek_fp": DIBEK_FP,
    "batch_mode": BATCH_MODE,
    "integrity": INTEGRITY,
