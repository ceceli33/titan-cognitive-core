                                      [NEG[i] for i in range(8) if i != omit]))
    SEM_LABELS.append(f"LOO_{omit}")
for vi, ph in enumerate(NEG_VARIANTS):
    SEM_DICTS.append(build_dictionary(POS, [t.format(X=ph) for t in TEMPLATES]))
    SEM_LABELS.append(f"NEGVAR_{vi}")
assert len(SEM_DICTS) == N_SEMANTIC
