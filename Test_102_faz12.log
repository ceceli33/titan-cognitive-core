    "capacity": CAPACITY, "capacity_by_source": CAP_BY_SRC, "headroom_pct": HEADROOM_PCT,
    "capture": CAPTURE,
    "horizon_bootstrap": HB,
    "primary": {"rank": RANK_OK, "calibrated": CALIB_OK, "top1": TOP1_OK,
