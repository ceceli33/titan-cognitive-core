# 8. MERCEK KALİBRASYONU (deney promptlarından bağımsız)
# =============================================================================

print("\n[4/24] Mercek kalibrasyonu...")
_cap = {}


def _mkr(li):
    def h(m, i, o):
        x = (o[0] if isinstance(o, tuple) else o).detach().float()
        _cap[li] = _cap.get(li, 0) + x[0].pow(2).sum(0).cpu()
    return h


_hs = [model.model.layers[li].register_forward_hook(_mkr(li)) for li in range(VECTOR_LAYERS)]
with torch.inference_mode():
    for p in MERCEK_CALIB:
        model(**{k: v.to(device) for k, v in tokenizer(p, return_tensors="pt").items()}, use_cache=False)
for h in _hs:
    h.remove()
energy = sum(_cap[li] for li in range(VECTOR_LAYERS))
DEV_IDX = torch.argsort(energy, descending=True)[:MERCEK_K]
MASK = torch.ones(HIDDEN)
MASK[DEV_IDX] = 0.0
del _cap
print(f"  dev boyutlar (ilk 5): {DEV_IDX[:5].tolist()}")


def cos_m(a, b):
    return cos(a.float().reshape(-1) * MASK, b.float().reshape(-1) * MASK)


def dev_energy_frac(a):
    a = a.float().reshape(-1)
    tot = float(a.pow(2).sum())
    return float("nan") if tot <= EPS else float(a[DEV_IDX].pow(2).sum()) / tot


# =============================================================================
# 9. ATLASLAR (v1 ile birebir)
# =============================================================================

print("\n[5/24] Atlaslar...")
theta = math.radians(SHELL_DEG)
SEM_ATLAS, RND_ATLAS = {}, {}
for li in SOURCE_LAYERS:
    v = unit(DIBEK[li])
    rows = []
    for cid in range(N_SEMANTIC):
        w = unit(SEM_DICTS[cid][li])
        rc = cos(w, v)
        if rc > IDENTITY_TOL:
            raise RuntimeError(f"L{li} aday {cid} kimlik çöküşü.")
        t = w - torch.dot(w, v) * v
        if float(torch.linalg.vector_norm(t)) <= 1e-8:
            raise RuntimeError(f"L{li} aday {cid} teğet çöküşü.")
        q = unit(math.cos(theta) * v + math.sin(theta) * unit(t))
        rows.append({"id": cid, "label": SEM_LABELS[cid], "q": q, "raw_cos": rc,
                     "natural_angle": angle(w, v)})
    SEM_ATLAS[li] = rows
    rr = []
    for cid in range(N_RANDOM):
        g = torch.Generator(device="cpu"); g.manual_seed(SEED + 1_000_000 + li * 1000 + cid)
        z = torch.randn(HIDDEN, generator=g, dtype=torch.float32)
        z = unit(z - torch.dot(z, v) * v)
        rr.append({"id": cid, "q": unit(math.cos(theta) * v + math.sin(theta) * z)})
    RND_ATLAS[li] = rr
    nat = [r["natural_angle"] for r in rows]
    print(f"  L{li:02d}: doğal semantik açı [{min(nat):.1f}°, {max(nat):.1f}°] ort {np.mean(nat):.1f}°")


def make_null_dirs(li, pi):
    v = unit(DIBEK[li])
    out = []
    for nid in range(N_NULL):
        g = torch.Generator(device="cpu"); g.manual_seed(SEED + 7_000_000 + 100_000 * pi + 1000 * li + nid)
        z = torch.randn(HIDDEN, generator=g, dtype=torch.float32)
        z = unit(z - torch.dot(z, v) * v)
        out.append(unit(v + NULL_JITTER_REL * z))
    return out


# =============================================================================
# 10. YAKALAMA: baseline çıktıları + her replay katmanının gerçek çağrısı
# =============================================================================

@torch.inference_mode()
def capture_prompt(prompt, src):
    offs = valid_probe_offsets(src)
    out_layers = sorted(set([src, TERMINAL] + [src + k for k in offs]))
    replay = list(range(src + 1, TERMINAL + 1))
    outputs, calls, hs = {}, {}, []

    def mko(lid):
        def h(m, a, o):
            outputs[lid] = (o[0] if isinstance(o, tuple) else o)[0, -1].detach().float().cpu().clone()
        return h

    def mkp(lid):
        def h(m, a, kw):
            calls[lid] = {"args": clone_nested(a), "kwargs": clone_nested(kw)}
        return h

    try:
        for lid in out_layers:
            hs.append(model.model.layers[lid].register_forward_hook(mko(lid)))
        for lid in replay:
            hs.append(model.model.layers[lid].register_forward_pre_hook(mkp(lid), with_kwargs=True))
        model(**{k: v.to(device) for k, v in tokenizer(prompt, return_tensors="pt").items()}, use_cache=False)
    finally:
        for h in hs:
            h.remove()
    for lid in out_layers:
        if lid not in outputs:
            raise RuntimeError(f"L{lid} çıktı yakalanamadı.")
    for lid in replay:
        if lid not in calls:
            raise RuntimeError(f"L{lid} çağrı metadata yakalanamadı.")
    return outputs, calls


# =============================================================================
# 11. FP32 BLOK ÇAĞRISI (batch + güvenlik kilidi)
# =============================================================================

BATCH_MODE = {"mode": None, "check_diff": None}


@torch.inference_mode()
def _block_call(block, meta, X):
    args = fp32_nested(meta["args"]); kwargs = fp32_nested(meta["kwargs"])
    args, kwargs = set_hidden(args, kwargs, X)
    if "use_cache" in kwargs:
        kwargs["use_cache"] = False
    out = block(*args, **kwargs)
    if isinstance(out, tuple):
        out = out[0]
    elif hasattr(out, "last_hidden_state"):
        out = out.last_hidden_state
    return out.float()


@torch.inference_mode()
def run_block(block, meta, X):
    if BATCH_MODE["mode"] is None:
        try:
            yb = _block_call(block, meta, X)
            y1 = _block_call(block, meta, X[0:1])
            diff = float(torch.linalg.vector_norm(yb[0] - y1[0]) /
                         (torch.linalg.vector_norm(y1[0]) + EPS))
            BATCH_MODE["check_diff"] = diff
            BATCH_MODE["mode"] = "batch" if diff < BATCH_CHECK_TOL else "row"
        except Exception as e:
            BATCH_MODE["mode"] = "row"
            BATCH_MODE["check_diff"] = f"batch hata: {type(e).__name__}"
        print(f"    [FP32 dal modu: {BATCH_MODE['mode']} | kontrol farkı {BATCH_MODE['check_diff']}]")
        if BATCH_MODE["mode"] == "batch":
            return yb
    if BATCH_MODE["mode"] == "batch":
        return _block_call(block, meta, X)
    return torch.cat([_block_call(block, meta, X[i:i + 1]) for i in range(X.shape[0])], dim=0)


# =============================================================================
# 12. BF16 TEK-BATCH AKTÜATÖR  [H1 düzeltmesi]
#   satır 0 = baseline (ölçek 0), satır i = rel * ‖h‖ * ölçek_i * q_i
#   delta = satır_i − satır_0 (AYNI batch)
# =============================================================================

@torch.inference_mode()
def act_batch(prompt, src, Q, scales, rel, layers):
    B = Q.shape[0]
    Qd = Q.to(device=device, dtype=torch.float32)
    Sd = scales.to(device=device, dtype=torch.float32).unsqueeze(1)
    caps, rec, hs = {}, {}, []

    def src_hook(m, a, o):
        h = o[0] if isinstance(o, tuple) else o
        hn = h.clone()
        before = h[:, -1, :].float()
        n0 = torch.linalg.vector_norm(before[0])
        hn[:, -1, :] = (before + rel * n0 * Sd * Qd).to(h.dtype)
        rec["dx"] = (hn[:, -1, :].float() - before).detach().cpu()
        rec["src_norm"] = float(n0)
        return ((hn,) + tuple(o[1:])) if isinstance(o, tuple) else hn

    def mkt(lid):
        def h(m, a, o):
            caps[lid] = (o[0] if isinstance(o, tuple) else o)[:, -1, :].detach().float().cpu()
        return h

    try:
        hs.append(model.model.layers[src].register_forward_hook(src_hook))
        for lid in layers:
            if lid != src:
                hs.append(model.model.layers[lid].register_forward_hook(mkt(lid)))
        enc = tokenizer(prompt, return_tensors="pt")
        be = {k: v.repeat(B, *([1] * (v.ndim - 1))).to(device) for k, v in enc.items()}
        model(**be, use_cache=False)
    finally:
        for h in hs:
            h.remove()
    return rec, caps


# =============================================================================
# 13. DEĞERLENDİRME (tek ofset)
# =============================================================================

def eval_offset(sc, sc_m, rsc, sem_delta, rnd_delta, oracle_id):
    order = np.argsort(-sc, kind="mergesort")
    top1 = int(order[0])
    Q4, Q3, Q2, Q1 = order[0:4], order[4:8], order[8:12], order[12:16]
    rtop1 = int(np.argsort(-rsc, kind="mergesort")[0])
    t_order = np.argsort(-sem_delta, kind="mergesort")
    rank = int(np.where(t_order == top1)[0][0]) + 1
    q = [float(np.mean(sem_delta[g])) for g in (Q1, Q2, Q3, Q4)]
    m_order = np.argsort(-sc_m, kind="mergesort")
    mtop1 = int(m_order[0])
    return {
        "top1_id": top1, "top1_label": SEM_LABELS[top1],
        "top1_delta": float(sem_delta[top1]),
        "random_top1_delta": float(rnd_delta[rtop1]),
        "top1_minus_random": float(sem_delta[top1] - rnd_delta[rtop1]),
        "top2_mean_delta": float(np.mean(sem_delta[order[:2]])),
        "top4_mean_delta": float(np.mean(sem_delta[order[:4]])),
        "bottom4_mean_delta": float(np.mean(sem_delta[order[-4:]])),
        "top4_minus_bottom4": float(np.mean(sem_delta[order[:4]]) - np.mean(sem_delta[order[-4:]])),
        "Q1_mean_delta": q[0], "Q2_mean_delta": q[1], "Q3_mean_delta": q[2], "Q4_mean_delta": q[3],
        "Q4_minus_Q1": q[3] - q[0],
        "quartile_trend": pearson([1, 2, 3, 4], q),
        "sem_terminal_spearman": spearman(sc, sem_delta),
        "sem_terminal_pearson": pearson(sc, sem_delta),
        "rnd_terminal_spearman": spearman(rsc, rnd_delta),
        "terminal_rank_of_radar_top1": rank,
        "radar_top1_is_terminal_top4": int(rank <= 4),
        "radar_top1_is_terminal_oracle": int(top1 == oracle_id),
        # mercekli sensör, UNMASKED sonuç
        "rho_masked_sensor": spearman(sc_m, sem_delta),
        "top1_delta_masked_sensor": float(sem_delta[mtop1]),
        "Q4_minus_Q1_masked_sensor": float(np.mean(sem_delta[m_order[0:4]]) - np.mean(sem_delta[m_order[12:16]])),
    }


# =============================================================================
# 14. ANA DENEY — kaynak başına KATMAN-DIŞ döngü
# =============================================================================

print("\n[6/24] Ana deney...")
RESULTS = []
t_main = time.time()

for src in SOURCE_LAYERS:
    offs = valid_probe_offsets(src)
    t19 = TERMINAL - src
    rec_offs = sorted(set(offs + [t19]))
    print(f"\n  KAYNAK L{src} | ufuklar {offs} | FP32→L19 ofseti +{t19}")

    # ---- A. 24 promptu yakala ----
    CAP = [capture_prompt(p, src) for p in PROMPTS]

    # ---- B. radar dallarını kur ----
    Qr = torch.stack([unit(DIBEK[src])] + [c["q"] for c in SEM_ATLAS[src]] +
                     [c["q"] for c in RND_ATLAS[src]]).to(device)
    ND = Qr.shape[0]
    assert ND == 1 + N_SEMANTIC + N_RANDOM
    STATES, EPSN = [], []
    for pi in range(N_PROMPTS):
        meta = CAP[pi][1][src + 1]
        _, _, h = locate_hidden(meta["args"], meta["kwargs"])
        h0 = h.detach().float()
        eps = RADAR_REL * float(torch.linalg.vector_norm(h0[0, -1]))
        X = h0.repeat(2 * ND, 1, 1)
        X[:ND, -1] += eps * Qr
        X[ND:, -1] -= eps * Qr
        STATES.append(X); EPSN.append(eps)

    RADAR = [dict() for _ in range(N_PROMPTS)]

    # ---- C. katman-dış FP32 replay ----
    for lid in range(src + 1, TERMINAL + 1):
        blk = copy.deepcopy(model.model.layers[lid]).to(device=device, dtype=torch.float32).eval()
        for p in blk.parameters():
            p.requires_grad_(False)
        off = lid - src
        for pi in range(N_PROMPTS):
            STATES[pi] = run_block(blk, CAP[pi][1][lid], STATES[pi])
            if off in rec_offs:
                resp = ((STATES[pi][:ND, -1] - STATES[pi][ND:, -1]) / 2.0).detach().float().cpu()
                v = DIBEK[lid]
                RADAR[pi][off] = {
                    "D": np.array([cos(resp[i], v) for i in range(ND)]),
                    "Dm": np.array([cos_m(resp[i], v) for i in range(ND)]),
                    "E": np.array([dev_energy_frac(resp[i]) for i in range(ND)]),
                    "gain": np.array([float(torch.linalg.vector_norm(resp[i])) / (EPSN[pi] + EPS)
                                      for i in range(ND)]),
                }
        del blk
        gc.collect(); torch.cuda.empty_cache()
        print(f"    L{lid} tamam | {(time.time()-t_main)/60:.1f}m", end="\r")
    print()
    del STATES
    gc.collect(); torch.cuda.empty_cache()

    # ================= SEÇİM DONDURULDU (tüm radar, hiçbir BF16 sonuç yok) =================
    FROZEN = []
    for pi in range(N_PROMPTS):
        FROZEN.append({off: {"sem": RADAR[pi][off]["D"][1:1 + N_SEMANTIC].copy(),
                             "sem_m": RADAR[pi][off]["Dm"][1:1 + N_SEMANTIC].copy(),
                             "rnd": RADAR[pi][off]["D"][1 + N_SEMANTIC:].copy()}
                       for off in rec_offs})

    # ---- D. BF16 sonuçları: TEK batch ----
    act_layers = sorted(set([src, TERMINAL] + [src + k for k in offs]))
    rows = []
    for pi, prompt in enumerate(PROMPTS):
        baseline_single = CAP[pi][0]
        null_dirs = make_null_dirs(src, pi)
        v_src = unit(DIBEK[src])
        Q = torch.stack([v_src, v_src] + [c["q"] for c in SEM_ATLAS[src]] +
                        [c["q"] for c in RND_ATLAS[src]] + null_dirs)
        scales = torch.ones(Q.shape[0]); scales[0] = 0.0
        rec, caps = act_batch(prompt, src, Q, scales, ACT_REL, act_layers)

        # satır düzeni: 0 base | 1 fixed | 2:18 sem | 18:34 rnd | 34:50 null
        I_F, I_S, I_R, I_N = 1, slice(2, 18), slice(18, 34), slice(34, 50)
        c19 = caps[TERMINAL]
        d19 = c19 - c19[0:1]
        v19 = DIBEK[TERMINAL]
        D19 = np.array([cos(d19[i], v19) for i in range(Q.shape[0])])
        D19m = np.array([cos_m(d19[i], v19) for i in range(Q.shape[0])])
        E19 = np.array([dev_energy_frac(d19[i]) for i in range(1, Q.shape[0])])

        fixed_D19 = float(D19[I_F])
        sem_delta = D19[I_S] - fixed_D19
        rnd_delta = D19[I_R] - fixed_D19
        nul_delta = D19[I_N] - fixed_D19
        sem_oracle = int(np.argmax(D19[I_S]))

        # ---- [E4] v1 yönteminin sapması ----
        base_batch = c19[0]
        base_single = baseline_single[TERMINAL]
        art = float(torch.linalg.vector_norm(base_batch - base_single))
        sig = float(np.median([float(torch.linalg.vector_norm(d19[i])) for i in range(2, 18)]))
        D19_legacy = np.array([cos(c19[i] - base_single, v19) for i in range(Q.shape[0])])
        legacy_bias = float(np.mean(np.abs(D19_legacy[1:] - D19[1:])))

        # ---- bütünlük ----
        dx = rec["dx"]
        integ = {
            "fixed_realized_rel": float(torch.linalg.vector_norm(dx[I_F])) / (rec["src_norm"] + EPS),
            "fixed_dir_cos": cos(dx[I_F], Q[I_F]),
            "sem_angle_err": mean_or_nan([angle(dx[i], Q[i]) for i in range(2, 18)]),
            "sem_realized_pair_angle": pair_angle_mean([dx[i] for i in range(2, 18)]),
            "requested_sem_pair_angle": pair_angle_mean([Q[i] for i in range(2, 18)]),
            "null_realized_angle_vs_fixed": mean_or_nan([angle(dx[i], dx[I_F]) for i in range(34, 50)]),
            "baseline_row_zero_dx": float(torch.linalg.vector_norm(dx[0])),
        }

        # ---- kapasite ----
        cap_row = {
            "fixed_D19": fixed_D19,
            "fixed_D19_masked": float(D19m[I_F]),
            "fixed_P19": float(torch.linalg.vector_norm(d19[I_F]) / (torch.linalg.vector_norm(base_batch) + EPS)),
            "sem_oracle_delta": float(np.max(sem_delta)),
            "null_oracle_delta": float(np.max(nul_delta)),
            "oracle_minus_null": float(np.max(D19[I_S]) - np.max(D19[I_N])),
            "sem_oracle_label": SEM_LABELS[sem_oracle],
            "delta19_dev_energy": float(np.mean(E19)),
            "batch_artifact_norm": art,
            "sem_delta_norm_median": sig,
            "artifact_over_signal": art / (sig + EPS),
            "legacy_v1_D19_bias": legacy_bias,
        }

        # ---- ofset değerlendirmesi ----
        hz = {}
        for off in rec_offs:
            F_ = FROZEN[pi][off]
            ev = eval_offset(F_["sem"], F_["sem_m"], F_["rnd"], sem_delta, rnd_delta, sem_oracle)
            ev["radar_dev_energy"] = float(np.mean(RADAR[pi][off]["E"][1:1 + N_SEMANTIC]))
            ev["radar_gain_mean"] = float(np.mean(RADAR[pi][off]["gain"][1:1 + N_SEMANTIC]))
            ev["is_t19"] = bool(off == t19)
            ev["preterminal"] = bool(preterminal(src, off))
            hz[off] = ev

        rows.append({"prompt_index": pi, "integrity": integ, "capacity": cap_row, "horizon_eval": hz})
        del caps, rec
        if (pi + 1) % 6 == 0:
            gc.collect(); torch.cuda.empty_cache()

    RESULTS.append({"source": src, "offsets": offs, "t19": t19, "rows": rows})
    del CAP, RADAR, FROZEN
    gc.collect(); torch.cuda.empty_cache()
    print(f"  L{src} bitti | {(time.time()-t_main)/60:.1f}m")

print(f"\nAna deney: {(time.time()-t_main)/60:.1f} dk")


# =============================================================================
# 15. TOPLAYICI
# =============================================================================

def prompt_values(off, metric, mode="preterminal", subset=None, section="horizon_eval"):
    pp = {i: [] for i in range(N_PROMPTS)}
    for L in RESULTS:
        src = L["source"]
        if section == "horizon_eval":
            if off == "T19":
                o = L["t19"]
            else:
                if off not in L["offsets"]:
                    continue
                o = off
                if mode == "preterminal" and not preterminal(src, o):
                    continue
        for r in L["rows"]:
            pi = r["prompt_index"]
            if subset is not None and pi not in subset:
                continue
            val = r["horizon_eval"][o][metric] if section == "horizon_eval" else r[section][metric]
            if np.isfinite(val):
                pp[pi].append(float(val))
    return [float(np.mean(pp[i])) for i in range(N_PROMPTS) if pp[i]]


def boot(off, metric, seed, **kw):
    return cluster_bootstrap(prompt_values(off, metric, **kw), seed)


