print("\n[2/24] Parmak izi...")
xa = extract_hidden(ABOVE); xb = extract_hidden(BELOW); xn = extract_hidden(NEUTRAL)
cos10 = cos(unit(xa[:, 10].mean(0) - xn[:, 10].mean(0)), unit(xb[:, 10].mean(0) - xn[:, 10].mean(0)))
cos11 = cos(unit(xa[:, 11].mean(0) - xn[:, 11].mean(0)), unit(xb[:, 11].mean(0) - xn[:, 11].mean(0)))
d10 = abs(cos10 - EXPECTED_COS10); d11 = abs(cos11 - EXPECTED_COS11)
print(f"L10={cos10:+.6f} drift={d10:.3e} | L11={cos11:+.6f} drift={d11:.3e}")
if d10 > FINGERPRINT_TOL or d11 > FINGERPRINT_TOL:
    raise RuntimeError("FINGERPRINT FAILED.")
print("Fingerprint: PASS")
del xa, xb, xn
gc.collect(); torch.cuda.empty_cache()


