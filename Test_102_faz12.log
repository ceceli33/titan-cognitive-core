# 3. YARDIMCILAR
# =============================================================================

def unit(v):
    v = v.float()
    n = torch.linalg.vector_norm(v)
    if float(n.item()) <= EPS:
        raise RuntimeError("Sıfır vektör.")
    return v / n


def cos(a, b):
    a = a.float().reshape(-1); b = b.float().reshape(-1)
    na = torch.linalg.vector_norm(a); nb = torch.linalg.vector_norm(b)
    if float(na.item()) <= EPS or float(nb.item()) <= EPS:
        return float("nan")
    return float((torch.dot(a, b) / (na * nb)).item())


def angle(a, b):
    c = cos(a, b)
    return float("nan") if not np.isfinite(c) else float(np.degrees(np.arccos(np.clip(c, -1, 1))))


def pearson(a, b):
    a = np.asarray(a, dtype=np.float64); b = np.asarray(b, dtype=np.float64)
    m = np.isfinite(a) & np.isfinite(b)
    a = a[m]; b = b[m]
    if len(a) < 3 or np.std(a) <= EPS or np.std(b) <= EPS:
        return float("nan")
    return float(np.corrcoef(a, b)[0, 1])


def rankdata(x):
    x = np.asarray(x, dtype=np.float64)
    r = np.empty(len(x), dtype=np.float64)
    r[np.argsort(x, kind="mergesort")] = np.arange(len(x), dtype=np.float64)
    return r


def spearman(a, b):
    a = np.asarray(a, dtype=np.float64); b = np.asarray(b, dtype=np.float64)
    m = np.isfinite(a) & np.isfinite(b)
    return float("nan") if int(m.sum()) < 3 else pearson(rankdata(a[m]), rankdata(b[m]))


def mean_or_nan(x):
    x = np.asarray(x, dtype=np.float64)
    x = x[np.isfinite(x)]
    return float(np.mean(x)) if len(x) else float("nan")


def cluster_bootstrap(values, seed, n_boot=N_BOOT):
    x = np.asarray(values, dtype=np.float64)
    x = x[np.isfinite(x)]
    if len(x) == 0:
        return {"mean": float("nan"), "ci95": [float("nan")] * 2,
                "positive_fraction": float("nan"), "n": 0}
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, len(x), size=(n_boot, len(x)))
    boot = x[idx].mean(axis=1)
    return {"mean": float(np.mean(x)),
            "ci95": [float(np.quantile(boot, 0.025)), float(np.quantile(boot, 0.975))],
            "positive_fraction": float(np.mean(x > 0)), "n": int(len(x))}


def fmt_ci(s, d=6):
    return f"[{s['ci95'][0]:+.{d}f},{s['ci95'][1]:+.{d}f}]"


def pair_angle_mean(vs):
    return mean_or_nan([angle(vs[i], vs[j]) for i in range(len(vs)) for j in range(i + 1, len(vs))])


def clone_nested(x):
    if torch.is_tensor(x):
        return x.detach().clone()
    if isinstance(x, tuple):
        return tuple(clone_nested(v) for v in x)
    if isinstance(x, list):
        return [clone_nested(v) for v in x]
    if isinstance(x, dict):
        return {k: clone_nested(v) for k, v in x.items()}
    return x


def fp32_nested(x):
    if torch.is_tensor(x):
        return x.float() if x.is_floating_point() else x
    if isinstance(x, tuple):
        return tuple(fp32_nested(v) for v in x)
    if isinstance(x, list):
        return [fp32_nested(v) for v in x]
    if isinstance(x, dict):
        return {k: fp32_nested(v) for k, v in x.items()}
    return x


def locate_hidden(args, kwargs):
    if len(args) > 0 and torch.is_tensor(args[0]) and args[0].ndim == 3:
        return "args", 0, args[0]
    if "hidden_states" in kwargs and torch.is_tensor(kwargs["hidden_states"]):
        return "kwargs", "hidden_states", kwargs["hidden_states"]
    raise RuntimeError("hidden_states bulunamadı.")


def set_hidden(args, kwargs, hidden):
    args = list(args); kwargs = dict(kwargs)
    where, key, _ = locate_hidden(args, kwargs)
    if where == "args":
        args[key] = hidden
    else:
        kwargs[key] = hidden
    return tuple(args), kwargs


def valid_probe_offsets(src):
    return [k for k in PROBE_OFFSETS if src + k <= TERMINAL]


def preterminal(src, k):
    return src + k < TERMINAL


