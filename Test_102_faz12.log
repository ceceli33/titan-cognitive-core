    "secondary": SECONDARY,
    "fp32_to_L19": T19, "fp32_to_L19_verdict": T19_VERDICT,
    "mercek_verdict": MERCEK_VERDICT,
    "source_map": SRC_MAP, "subgroups": SUBGROUPS, "diversity": DIVERSITY,
    "lock": LOCK, "prompts": PROMPTS, "results": RESULTS,
}
with open(OUT_JSON, "w", encoding="utf-8") as f:
