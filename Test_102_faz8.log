# "Informative FP32" requires ranking + physical selection evidence.
fp32_rank_signal = (
    MEAN_FP32_SPEARMAN >= 0.30
    and MEAN_FP32_RANK < 6.5
)

fp32_selection_signal = (
    S_FP32_SELECTED["ci95"][0] > 0
)

bf16_weak = (
    abs(MEAN_BF16_SPEARMAN) < 0.15
)

null_explains_oracle = (
    S_ORACLE_EXCESS["ci95"][1] <= 0
)

candidate_exceeds_null = (
    S_ORACLE_EXCESS["ci95"][0] > 0
)

if (
    bf16_weak
    and fp32_rank_signal
    and fp32_selection_signal
):

    DECISION = (
        "BF16_MEASUREMENT_FLOOR_SUPPORTED"
    )

elif (
    abs(MEAN_FP32_SPEARMAN) < 0.15
    and not fp32_selection_signal
):

    DECISION = (
        "MICRO_TO_ACT_DIRECTIONAL_TRANSFER_NOT_SUPPORTED"
    )

elif (
    null_explains_oracle
):

    DECISION = (
        "BF16_ORACLE_COMPATIBLE_WITH_REALIZATION_NULL"
    )

elif (
    candidate_exceeds_null
    and not fp32_rank_signal
):

    DECISION = (
        "DIRECTIONAL_OPPORTUNITY_EXCEEDS_NULL_BUT_IS_NOT_MICRO_NAVIGABLE"
    )

else:

    DECISION = (
        "MIXED_PRECISION_MECHANISM_REQUIRES_FOLLOWUP"
    )


