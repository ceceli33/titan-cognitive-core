# =============================================================================
# 15. FP32 LOCAL CONTEXT CAPTURE
#
# We need the INPUT of target layer:
#
# intervention historically occurs at output of layer li,
# therefore transport operator is target layer li+1.
#
# Capture target layer positional arguments + kwargs from an unmodified
# BF16 full forward.
#
# Then evaluate a deep-copied target decoder block in FP32.
#
# NOTE:
# Qwen implementation/version signatures can differ.
# We capture actual runtime args rather than reconstructing them manually.
# =============================================================================

print("\n[7/24] FP32 local-block infrastructure hazırlanıyor...")


@torch.no_grad()
def capture_target_call(prompt, target_li):

    captured = {}

    layer = model.model.layers[target_li]

    # with_kwargs=True lets us preserve actual runtime kwargs.
    def pre_hook(
        module,
        args,
        kwargs,
    ):

        # Clone/detach tensors because original forward continues.
        new_args = []

        for x in args:

            if torch.is_tensor(x):
                new_args.append(
                    x.detach().clone()
                )
            else:
                new_args.append(x)

        new_kwargs = {}

        for k, v in kwargs.items():

            if torch.is_tensor(v):
                new_kwargs[k] = (
                    v.detach().clone()
                )

            elif isinstance(v, tuple):

                vv = []

                for item in v:

                    if torch.is_tensor(item):
                        vv.append(
                            item.detach().clone()
                        )
                    else:
                        vv.append(item)

                new_kwargs[k] = tuple(vv)

            else:
                new_kwargs[k] = v

        captured["args"] = tuple(
            new_args
        )

        captured["kwargs"] = (
            new_kwargs
        )

    handle = layer.register_forward_pre_hook(
        pre_hook,
        with_kwargs=True,
    )

    try:

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:
        handle.remove()

    if "args" not in captured:
        raise RuntimeError(
            f"Target layer {target_li} call capture failed."
        )

    return captured


def cast_nested_fp32(obj):

    if torch.is_tensor(obj):

        if obj.is_floating_point():
            return obj.float()

        return obj

    if isinstance(obj, tuple):

        return tuple(
            cast_nested_fp32(x)
            for x in obj
        )

    if isinstance(obj, list):

        return [
            cast_nested_fp32(x)
            for x in obj
        ]

    if isinstance(obj, dict):

        return {
            k: cast_nested_fp32(v)
            for k, v in obj.items()
        }

    return obj


def replace_hidden_in_call(
    args,
    kwargs,
    hidden,
):

    args = list(args)
    kwargs = dict(kwargs)

    # Qwen decoder normally receives hidden_states as first positional arg.
    if len(args) > 0 and torch.is_tensor(args[0]):

        args[0] = hidden

    elif "hidden_states" in kwargs:

        kwargs["hidden_states"] = hidden

    else:

        raise RuntimeError(
            "hidden_states not found in captured decoder call."
        )

    return tuple(args), kwargs


@torch.no_grad()
def local_block_forward(
    block_fp32,
    captured_call,
    hidden_fp32,
):

    args = cast_nested_fp32(
        captured_call["args"]
    )

    kwargs = cast_nested_fp32(
        captured_call["kwargs"]
    )

    args, kwargs = replace_hidden_in_call(
        args,
        kwargs,
        hidden_fp32,
    )

    out = block_fp32(
        *args,
        **kwargs,
    )

    if isinstance(out, tuple):
        h = out[0]
    else:
        h = out

    return h.float()


# =============================================================================
# 16. FP32 CENTRAL FINITE-SECANT
#
# Input hidden sequence is the actual BF16-produced layer input promoted
# to FP32. Only LAST TOKEN receives ± perturbation.
#
# response:
#
#   y = [F(h + eps q) - F(h - eps q)] / 2
#
# This is symmetric finite response, NOT exact derivative.
# =============================================================================

@torch.no_grad()
def fp32_central_response(
    block_fp32,
    captured_call,
    q,
    rel,
):

    # Hidden state from captured target-layer input.
    args = captured_call["args"]
    kwargs = captured_call["kwargs"]

    if len(args) > 0 and torch.is_tensor(args[0]):
        h0 = args[0].detach().float().clone()
    elif "hidden_states" in kwargs:
        h0 = (
            kwargs["hidden_states"]
            .detach()
            .float()
            .clone()
        )
    else:
        raise RuntimeError(
            "No hidden state in captured call."
        )

    q = normalize(q).to(
        h0.device
    )

    base_last = (
        h0[0, -1]
        .float()
    )

    base_norm = float(
        torch.linalg.vector_norm(
            base_last
        )
    )

    eps_norm = (
        rel * base_norm
    )

    hp = h0.clone()
    hm = h0.clone()

    hp[0, -1] = (
        hp[0, -1]
        + eps_norm * q
    )

    hm[0, -1] = (
        hm[0, -1]
        - eps_norm * q
    )

    yp = local_block_forward(
        block_fp32,
        captured_call,
        hp,
    )

    ym = local_block_forward(
        block_fp32,
        captured_call,
        hm,
    )

    # Last-token symmetric response.
    response = (
        yp[0, -1]
        - ym[0, -1]
    ) / 2.0

    return {
        "response":
            response.detach()
            .float()
            .cpu(),

        "eps_norm":
            eps_norm,

        "base_norm":
            base_norm,

        "response_norm":
            float(
                torch.linalg.vector_norm(
                    response
                )
            ),
    }


# =============================================================================
# 17. FP32 ASSAY
#
# Memory discipline:
# one target layer copied at a time.
#
# For each layer:
#   copy layer li+1 -> FP32
#   run all prompts
#   delete copy
# =============================================================================

print("\n[8/24] PART B — FP32 central finite-secant assay...")

FP32_RESULTS = []

start = time.time()

for li in SOURCE_LAYERS:

    target = li + 1

    print(
        f"\n  L{li}->L{target}: "
        "target block FP32 kopyalanıyor..."
    )

    # -------------------------------------------------------------
    # Deep-copy only ONE decoder block.
    # Keep original model untouched.
    # -------------------------------------------------------------

    block_fp32 = copy.deepcopy(
        model.model.layers[target]
    )

    block_fp32 = (
        block_fp32
        .to(device=device, dtype=torch.float32)
        .eval()
    )

    for p in block_fp32.parameters():
        p.requires_grad_(False)

    layer_rows = []

    for pi, prompt in enumerate(PROMPTS):

        captured = capture_target_call(
            prompt,
            target,
        )

        # Fixed historical compass response.
        fixed_micro = fp32_central_response(
            block_fp32,
            captured,
            DIBEK[li],
            RADAR_REL,
        )

        fixed_act = fp32_central_response(
            block_fp32,
            captured,
            DIBEK[li],
            ACT_REL,
        )

        candidate_rows = []

        micro_scores = []
        act_scores = []

        for candidate in ATLAS[li]:

            micro = fp32_central_response(
                block_fp32,
                captured,
                candidate["q"],
                RADAR_REL,
            )

            act = fp32_central_response(
                block_fp32,
                captured,
                candidate["q"],
                ACT_REL,
            )

            # Target semantic coordinate.
            micro_D = cosine(
                micro["response"],
                DIBEK[target],
            )

            act_D = cosine(
                act["response"],
                DIBEK[target],
            )

            micro_scores.append(
                micro_D
            )

            act_scores.append(
                act_D
            )

            candidate_rows.append({
                "candidate_id":
                    candidate["candidate_id"],

                "micro_D":
                    micro_D,

                "act_D":
                    act_D,

                "micro_response_norm":
                    micro["response_norm"],

                "act_response_norm":
                    act["response_norm"],

                "micro_gain":
                    micro["response_norm"]
                    / (
                        micro["eps_norm"]
                        + EPS
                    ),

                "act_gain":
                    act["response_norm"]
                    / (
                        act["eps_norm"]
                        + EPS
                    ),
            })

        micro_scores = np.asarray(
            micro_scores,
            dtype=np.float64,
        )

        act_scores = np.asarray(
            act_scores,
            dtype=np.float64,
        )

        selected_id = int(
            np.argmax(
                micro_scores
            )
        )

        oracle_id = int(
            np.argmax(
                act_scores
            )
        )

        fixed_micro_D = cosine(
            fixed_micro["response"],
            DIBEK[target],
        )

        fixed_act_D = cosine(
            fixed_act["response"],
            DIBEK[target],
        )

        selected_delta = float(
            act_scores[selected_id]
            - fixed_act_D
        )

        oracle_delta = float(
            act_scores[oracle_id]
            - fixed_act_D
        )

        # Rank of micro-selected candidate at ACT.
        order = np.argsort(
            -act_scores
        )

        selected_rank = int(
            np.where(
                order == selected_id
            )[0][0]
        ) + 1

        layer_rows.append({
            "prompt_index":
                pi,

            "micro_act_pearson":
                safe_corr(
                    micro_scores,
                    act_scores,
                ),

            "micro_act_spearman":
                spearman(
                    micro_scores,
                    act_scores,
                ),

            "fixed_micro_D":
                fixed_micro_D,

            "fixed_act_D":
                fixed_act_D,

            "selected_id":
                selected_id,

            "oracle_id":
                oracle_id,

            "selected_act_delta":
                selected_delta,

            "oracle_act_delta":
                oracle_delta,

            "selected_rank":
                selected_rank,

            "top4":
                int(
                    selected_rank <= 4
                ),

            "oracle_hit":
                int(
                    selected_id
                    == oracle_id
                ),

            "candidates":
                candidate_rows,
        })

        del captured

        if (pi + 1) % 4 == 0:
            torch.cuda.empty_cache()

        print(
            f"    prompt {pi+1:02d}/{N_PROMPTS}",
            end="\r",
        )

    print()

    FP32_RESULTS.append({
        "source_layer":
            li,

        "target_layer":
            target,

        "rows":
            layer_rows,
    })

    del block_fp32

    gc.collect()
    torch.cuda.empty_cache()

print(
    "\nFP32 assay completed:",
    f"{(time.time()-start)/60:.1f} min"
)


