def strip_tensors(obj):

    if torch.is_tensor(obj):
        return {
            "shape":
                list(obj.shape),

            "norm":
                float(
                    torch.linalg.vector_norm(
                        obj.float()
                    )
                ),
        }

    if isinstance(obj, dict):
        return {
            k: strip_tensors(v)
            for k, v in obj.items()
        }

    if isinstance(obj, list):
        return [
            strip_tensors(v)
            for v in obj
        ]

    if isinstance(obj, tuple):
        return [
            strip_tensors(v)
            for v in obj
        ]

    if isinstance(
        obj,
        (
            np.floating,
            np.integer,
        ),
    ):
        return obj.item()

    return obj


# Remove huge source perturbation tensors from BF16 result before save.
BF16_SAVE = []

for row in BF16_RESULTS:

    rr = {
        "prompt_index":
            row["prompt_index"],

        "layers":
            {},
    }

    for li in SOURCE_LAYERS:

        z = row["layers"][str(li)]

        zz = {
            k: v
            for k, v in z.items()
            if k != "candidates"
        }

        zz["candidates"] = []

        for c in z["candidates"]:

            cc = {
                k: v
                for k, v in c.items()
                if k not in (
                    "radar_x",
                    "act_x",
                )
            }

            zz["candidates"].append(
                cc
            )

        rr["layers"][str(li)] = zz

    BF16_SAVE.append(rr)


