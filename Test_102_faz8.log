# =============================================================================
# 10. TANGENT ATLAS
# =============================================================================

print("\n[4/24] 5° tangent atlas oluşturuluyor...")

theta = math.radians(
    REQUESTED_SHELL_DEG
)

ATLAS = {}

for li in SOURCE_LAYERS:

    v = normalize(
        DIBEK[li]
    )

    ATLAS[li] = []

    for cid in range(
        N_CANDIDATES
    ):

        gen = torch.Generator(
            device="cpu"
        )

        gen.manual_seed(
            SEED
            + 100000 * li
            + cid
        )

        z = torch.randn(
            HIDDEN,
            generator=gen,
            dtype=torch.float32,
        )

        u = (
            z
            - torch.dot(z, v) * v
        )

        u = normalize(u)

        q = normalize(
            math.cos(theta) * v
            + math.sin(theta) * u
        )

        ATLAS[li].append({
            "candidate_id": cid,
            "u": u,
            "q": q,
        })

print(
    f"{len(SOURCE_LAYERS)} layers "
    f"× {N_CANDIDATES} candidates"
)


# =============================================================================
# 11. BF16 BASELINE CAPTURE
#
# Capture:
#
#   layer OUTPUT h_l
#
# This matches intervention lineage:
# hook on layers[li] output -> entering layer li+1.
# =============================================================================

@torch.no_grad()
def baseline_outputs(prompt):

    caps = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            caps[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        needed = sorted(
            set(
                SOURCE_LAYERS
                + [x + 1 for x in SOURCE_LAYERS]
            )
        )

        for li in needed:

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return caps


# =============================================================================
# 12. BF16 ONE-STEP INTERVENTION
# =============================================================================

@torch.no_grad()
def bf16_intervention(
    prompt,
    baseline,
    li,
    direction,
    rel,
):

    target = li + 1

    q = normalize(direction)

    src_base = baseline[li]

    src_norm = float(
        torch.linalg.vector_norm(
            src_base
        )
    )

    requested_norm = (
        rel * src_norm
    )

    q_gpu = q.to(device)

    source_delta = {}
    target_cap = {}

    handles = []

    def source_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        before = (
            h[0, -1]
            .float()
        )

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        source_delta["x"] = (
            hnew[0, -1]
            .float()
            - before
        ).detach().cpu().clone()

        if isinstance(out, tuple):
            return (
                (hnew,)
                + out[1:]
            )

        return hnew

    def target_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        target_cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    x = source_delta["x"]

    y = (
        target_cap["h"]
        - baseline[target]
    )

    return {
        "x": x,
        "y": y,

        "D_next":
            cosine(
                y,
                DIBEK[target],
            ),

        "realized_rel":
            float(
                torch.linalg.vector_norm(x)
            ) / (src_norm + EPS),

        "dir_cos":
            cosine(x, q),

        "requested_norm":
            requested_norm,
    }


# =============================================================================
# 13. PART A — BF16 REPEATABILITY + REALIZATION FLOOR
# =============================================================================

print("\n[5/24] PART A — BF16 repeatability / realization floor...")

BF16_RESULTS = []

start = time.time()

for pi, prompt in enumerate(PROMPTS):

    base = baseline_outputs(
        prompt
    )

    prow = {
        "prompt_index": pi,
        "layers": {},
    }

    for li in SOURCE_LAYERS:

        fixed_q = normalize(
            DIBEK[li]
        )

        # -------------------------------------------------------------
        # Exact repeats:
        # deterministic numerical repeatability.
        # -------------------------------------------------------------

        exact_repeats = []

        for rep in range(4):

            z = bf16_intervention(
                prompt,
                base,
                li,
                fixed_q,
                ACT_REL,
            )

            exact_repeats.append(
                z["D_next"]
            )

        repeat_range = float(
            np.max(exact_repeats)
            - np.min(exact_repeats)
        )

        # -------------------------------------------------------------
        # Candidate radar / act
        # -------------------------------------------------------------

        candidate_rows = []

        for candidate in ATLAS[li]:

            rad = bf16_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                RADAR_REL,
            )

            act = bf16_intervention(
                prompt,
                base,
                li,
                candidate["q"],
                ACT_REL,
            )

            candidate_rows.append({
                "candidate_id":
                    candidate["candidate_id"],

                "radar_D":
                    rad["D_next"],

                "act_D":
                    act["D_next"],

                "radar_dir_cos":
                    rad["dir_cos"],

                "act_dir_cos":
                    act["dir_cos"],

                "radar_rel":
                    rad["realized_rel"],

                "act_rel":
                    act["realized_rel"],

                "requested_candidate_angle":
                    angle_deg(
                        candidate["q"],
                        fixed_q,
                    ),

                "realized_radar_vs_requested":
                    angle_deg(
                        rad["x"],
                        candidate["q"],
                    ),

                "realized_act_vs_requested":
                    angle_deg(
                        act["x"],
                        candidate["q"],
                    ),

                "radar_x":
                    rad["x"],

                "act_x":
                    act["x"],
            })

        # -------------------------------------------------------------
        # Realized candidate pair geometry
        # Compare requested candidate pair angles with realized pair angles.
        # -------------------------------------------------------------

        requested_pair_angles = []
        radar_pair_angles = []
        act_pair_angles = []

        for a in range(N_CANDIDATES):

            for b in range(
                a + 1,
                N_CANDIDATES,
            ):

                requested_pair_angles.append(
                    angle_deg(
                        ATLAS[li][a]["q"],
                        ATLAS[li][b]["q"],
                    )
                )

                radar_pair_angles.append(
                    angle_deg(
                        candidate_rows[a]["radar_x"],
                        candidate_rows[b]["radar_x"],
                    )
                )

                act_pair_angles.append(
                    angle_deg(
                        candidate_rows[a]["act_x"],
                        candidate_rows[b]["act_x"],
                    )
                )

        # -------------------------------------------------------------
        # NULL:
        #
        # same semantic FIXED direction plus tiny tangent requested jitter.
        #
        # Important:
        # this is not called "random measurement noise".
        # It is a BF16 realization-sensitivity null.
        # -------------------------------------------------------------

        fixed_act = bf16_intervention(
            prompt,
            base,
            li,
            fixed_q,
            ACT_REL,
        )

        null_D = []
        null_realized_angles = []

        for nid in range(N_NULL):

            gen = torch.Generator(
                device="cpu"
            )

            gen.manual_seed(
                SEED
                + 7000000
                + 100000 * pi
                + 1000 * li
                + nid
            )

            z = torch.randn(
                HIDDEN,
                generator=gen,
                dtype=torch.float32,
            )

            z = (
                z
                - torch.dot(z, fixed_q)
                * fixed_q
            )

            z = normalize(z)

            # Tiny requested tangent deviation.
            #
            # q_null approximately:
            # fixed + NULL_JITTER_REL * tangent
            q_null = normalize(
                fixed_q
                + NULL_JITTER_REL * z
            )

            nz = bf16_intervention(
                prompt,
                base,
                li,
                q_null,
                ACT_REL,
            )

            null_D.append(
                nz["D_next"]
            )

            null_realized_angles.append(
                angle_deg(
                    nz["x"],
                    fixed_act["x"],
                )
            )

        null_oracle = (
            max(null_D)
            - fixed_act["D_next"]
        )

        # -------------------------------------------------------------
        # Candidate oracle vs fixed at ACT
        # -------------------------------------------------------------

        act_D = np.asarray([
            x["act_D"]
            for x in candidate_rows
        ])

        radar_D = np.asarray([
            x["radar_D"]
            for x in candidate_rows
        ])

        candidate_oracle = float(
            np.max(act_D)
            - fixed_act["D_next"]
        )

        row_corr = safe_corr(
            radar_D,
            act_D,
        )

        row_spearman = spearman(
            radar_D,
            act_D,
        )

        prow["layers"][str(li)] = {
            "exact_repeat_range":
                repeat_range,

            "exact_repeats":
                exact_repeats,

            "fixed_act_D":
                fixed_act["D_next"],

            "candidate_oracle":
                candidate_oracle,

            "null_oracle":
                float(null_oracle),

            "bf16_radar_act_pearson":
                row_corr,

            "bf16_radar_act_spearman":
                row_spearman,

            "requested_pair_angle_mean":
                float(
                    np.mean(
                        requested_pair_angles
                    )
                ),

            "radar_pair_angle_mean":
                float(
                    np.mean(
                        radar_pair_angles
                    )
                ),

            "act_pair_angle_mean":
                float(
                    np.mean(
                        act_pair_angles
                    )
                ),

            "pair_geometry_radar_corr":
                safe_corr(
                    requested_pair_angles,
                    radar_pair_angles,
                ),

            "pair_geometry_act_corr":
                safe_corr(
                    requested_pair_angles,
                    act_pair_angles,
                ),

            "null_realized_angle_mean":
                float(
                    np.mean(
                        null_realized_angles
                    )
                ),

            "candidates":
                candidate_rows,
        }

    BF16_RESULTS.append(
        prow
    )

    print(
        f"  BF16 {pi+1:02d}/{N_PROMPTS} "
        f"| {(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
