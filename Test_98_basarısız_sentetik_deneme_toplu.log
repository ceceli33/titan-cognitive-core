            cont_values.append(
                cosine_np(
                    bank[l],
                    bank[l + 1]
                )
            )


    return {

        "pca_mean":
            float(
                np.mean(
                    pca_values
                )
            ),

        "pca_sd":
            float(
                np.std(
                    pca_values
                )
            ),

        "pca_min":
            float(
                np.min(
                    pca_values
                )
            ),

        "pca_max":
            float(
                np.max(
                    pca_values
                )
            ),

        "continuity_mean":
            float(
                np.mean(
                    cont_values
                )
            ),

        "continuity_sd":
            float(
                np.std(
                    cont_values
                )
            ),

        "continuity_min":
            float(
                np.min(
                    cont_values
                )
            ),

        "continuity_max":
