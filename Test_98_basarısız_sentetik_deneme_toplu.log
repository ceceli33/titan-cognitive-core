    MODEL_NAME,
    "| dtype:",
    next(model.parameters()).dtype
)


# =============================================================================
# 3. YARDIMCI FONKSİYONLAR
# =============================================================================

def normalize(v, eps=1e-12):

    n = np.linalg.norm(v)

    if n <= eps:
        return np.zeros_like(v, dtype=np.float32)

    return (v / n).astype(np.float32)


def cosine(a, b, eps=1e-12):

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na <= eps or nb <= eps:
        return 0.0

    return float(np.dot(a, b) / (na * nb))


def describe(x):

    x = np.asarray(x, dtype=np.float64)

    return {
        "mean": float(np.mean(x)),
        "sd": float(np.std(x, ddof=1)) if len(x) > 1 else 0.0,
        "min": float(np.min(x)),
        "max": float(np.max(x)),
        "median": float(np.median(x)),
    }


@torch.no_grad()
def extract_layerwise(texts):

    enc = tokenizer(
        texts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=64
    )

    input_ids = enc["input_ids"].to(model.device)
    attention_mask = enc["attention_mask"].to(model.device)

    captured = [None] * VECTOR_LAYERS
    handles = []


    def make_hook(li):

        def hook(module, inputs, output):

            h = (
                output[0]
                if isinstance(output, tuple)
                else output
            )

            captured[li] = h.detach()

        return hook


    try:

        for l in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[l]
                .register_forward_hook(
                    make_hook(l)
                )
            )

        _ = model(
            input_ids=input_ids,
            attention_mask=attention_mask,
            use_cache=False
        )

    finally:

        for handle in handles:
            handle.remove()


    lengths = attention_mask.sum(dim=1).cpu().numpy()

    result = np.zeros(
        (
            len(texts),
            VECTOR_LAYERS,
            HIDDEN
        ),
        dtype=np.float32
    )


    for l in range(VECTOR_LAYERS):

        x = captured[l].float().cpu().numpy()

        for i in range(len(texts)):

            result[i, l] = x[
                i,
                int(lengths[i]) - 1
            ]


    return result


# =============================================================================
# 4. HIDDEN-STATE PCA BASIS
# =============================================================================

print("\n[2/7] Hidden-state PCA basis yeniden çıkarılıyor...")

HS = extract_layerwise(
    GENERIC_PROMPTS
)

PCA_BASIS = {}


for l in range(VECTOR_LAYERS):

    X = HS[:, l, :].astype(np.float64)

    X -= X.mean(
        axis=0,
        keepdims=True
    )

    _, _, Vt = np.linalg.svd(
        X,
        full_matrices=False
    )

    PCA_BASIS[l] = (
        Vt[:TOP_K_PCA]
        .astype(np.float32)
    )


print("PCA basis hazır.")


# =============================================================================
# 5. ARM A — PCA-CONSTRAINED SYNTHETIC
# =============================================================================
#
# Her layer'da:
#
#   z ~ N(0,I_K)
#
# ve
#
#   v = Σ z_k PC_k
#
# oluşturuyoruz.
#
# Böylece v tamamen modelin o layer'daki top-K hidden-state PCA
# altuzayında bulunur.
#
# ÖNEMLİ:
# Bu kol continuity'yi bilinçli olarak eşleştirmez.
# Her layer bağımsız örneklenir.
#
# Böylece H2 tek başına test edilebilir.
# =============================================================================

print("\n[3/7] ARM A — PCA-constrained synthetic üretiliyor...")


PCA_SYNTH = np.zeros(
    (
        N_SYNTHETIC,
        VECTOR_LAYERS,
        HIDDEN
    ),
    dtype=np.float32
)


for i in range(N_SYNTHETIC):

    for l in range(VECTOR_LAYERS):

        coeff = rng.standard_normal(
            TOP_K_PCA
        ).astype(np.float32)

        v = (
            coeff
            @
            PCA_BASIS[l]
        )

        PCA_SYNTH[i, l] = normalize(v)


# =============================================================================
# 6. ARM B — CONTINUITY-CONSTRAINED SYNTHETIC
# =============================================================================
#
# Amaç:
#
# adjacent-layer cosine ≈ Faz1 semantic continuity (~0.852)
#
# fakat PCA yapısını BİLİNÇLİ olarak kullanmamak.
#
# Başlangıç:
#
#     v_0 = isotropic random
#
# Sonraki layer:
#
#     z_perp = random component orthogonal to v_l
#
#     v_{l+1}
#       =
#       rho * v_l
#       +
#       sqrt(1-rho²) * z_perp
#
# Böylece teorik olarak:
#
#     cos(v_l, v_{l+1}) = rho
#
# olur.
#
# Burada rho Faz 1'deki önceden ölçülen mean continuity'ye kilitlidir.
# =============================================================================

print(
    "\n[4/7] "
    "ARM B — continuity-constrained synthetic üretiliyor..."
)


rho = float(
    TARGET_CONTINUITY
)


CONT_SYNTH = np.zeros(
    (
        N_SYNTHETIC,
        VECTOR_LAYERS,
        HIDDEN
    ),
    dtype=np.float32
)


for i in range(N_SYNTHETIC):

    # Layer 0 isotropic başlangıç
    v = rng.standard_normal(
        HIDDEN
    ).astype(np.float32)

    v = normalize(v)

    CONT_SYNTH[
        i,
        0
    ] = v


    for l in range(
        1,
        VECTOR_LAYERS
    ):

        z = rng.standard_normal(
            HIDDEN
        ).astype(np.float32)


        # Mevcut yöne dik bileşen
        z = (
            z
            -
            np.dot(z, v)
            *
            v
        )


        z = normalize(z)


        next_v = (

            rho
            *
            v

            +

            np.sqrt(
                1.0
                -
                rho ** 2
            )
            *
            z
        )


        next_v = normalize(
            next_v
        )


        CONT_SYNTH[
            i,
            l
        ] = next_v


        v = next_v


# =============================================================================
# 7. ISOTROPIC NULL
# =============================================================================

ISO_SYNTH = rng.standard_normal(
    (
        N_SYNTHETIC,
        VECTOR_LAYERS,
        HIDDEN
    )
).astype(np.float32)


ISO_SYNTH /= (
    np.linalg.norm(
        ISO_SYNTH,
        axis=2,
        keepdims=True
    )
    +
    1e-12
)


# =============================================================================
# 8. STRUCTURAL VALIDATION
# =============================================================================

print(
    "\n[5/7] "
    "Üç kol yapısal olarak doğrulanıyor..."
)


def pca_energy(
    vectors,
    basis
):

    projection = (
        vectors
        @
        basis.T
    )

    return (
        projection ** 2
    ).sum(
        axis=1
    )


def arm_metrics(
    vectors
):

    per_layer = {}

    pca_band = []
    cont_band = []


    for l in range(
        VECTOR_LAYERS
    ):

        pe = pca_energy(
            vectors[:, l, :],
            PCA_BASIS[l]
        )


        if l < VECTOR_LAYERS - 1:

            continuity = np.sum(

                vectors[:, l, :]

                *

                vectors[:, l + 1, :],

                axis=1
            )

        else:

            continuity = None


        per_layer[l] = {

            "pca_energy":
                describe(pe),

            "continuity":
                (
                    describe(
                        continuity
                    )
                    if continuity is not None
                    else None
                ),
        }


        if l in SUMMARY_LAYERS:

            pca_band.extend(
                pe.tolist()
            )


            if continuity is not None:

                cont_band.extend(
                    continuity.tolist()
                )


    return {

        "per_layer":
            per_layer,

        "band_pca":
            describe(
                pca_band
            ),

        "band_continuity":
            describe(
                cont_band
            ),
    }


METRICS = {

    "ISOTROPIC":
        arm_metrics(
            ISO_SYNTH
        ),

    "PCA_ONLY":
        arm_metrics(
            PCA_SYNTH
        ),

    "CONTINUITY_ONLY":
        arm_metrics(
            CONT_SYNTH
        ),
}


