# 10. ORTHOGONALITY / ISOLATION CHECK
# =============================================================================
#
# Başarılı Faz 2 için:
#
# PCA_ONLY:
#   PCA alignment yüksek olmalı,
#   continuity semantic seviyesine yanlışlıkla çıkmamalı.
#
# CONTINUITY_ONLY:
#   continuity semantic seviyesine yakın olmalı,
#   PCA alignment isotropic seviyesine yakın kalmalı.
#
# =============================================================================

PCA_ONLY_RATIO = (
    pca_only_energy
    /
    (
        iso_pca
        +
        1e-12
    )
)


CONT_ONLY_RATIO = (
    cont_only_energy
    /
    (
        iso_pca
        +
        1e-12
    )
)


PCA_ISOLATION_PASS = (

    PCA_ONLY_RATIO > 10.0

    and

    abs(
        pca_only_cont
    ) < 0.10
)


CONT_ISOLATION_PASS = (

    abs(
        cont_only_cont
        -
        TARGET_CONTINUITY
    ) < 0.02

    and

    CONT_ONLY_RATIO < 1.50
)


