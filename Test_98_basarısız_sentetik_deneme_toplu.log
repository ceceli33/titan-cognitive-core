                ]
            )

            for l in ACTIVE_LAYERS
        )


        PREFLIGHT_ROWS.append({

            "arm":
                arm,

            "prompt":
                p_idx,

            "runtime_pca":
                runtime_pca,

            "runtime_cont":
                runtime_cont,

            "max_cos_error":
                max_cos_error,
        })


pre_runtime_pca = float(
    np.mean([
        x["runtime_pca"]
        for x in PREFLIGHT_ROWS
    ])
)


pre_runtime_cont = float(
    np.mean([
        x["runtime_cont"]
        for x in PREFLIGHT_ROWS
    ])
)


pre_runtime_cos_error = float(
    np.max([
        x["max_cos_error"]
        for x in PREFLIGHT_ROWS
    ])
)


print(
    f"Runtime PCA energy   = "
    f"{pre_runtime_pca:.9f}"
)

print(
    f"Target PCA energy    = "
    f"{TARGET_PCA_ENERGY:.9f}"
)

print(
    f"Runtime continuity   = "
    f"{pre_runtime_cont:+.9f}"
)

print(
    f"Target continuity    = "
    f"{TARGET_CONTINUITY:+.9f}"
)

print(
    f"Max |cos error|      = "
    f"{pre_runtime_cos_error:.9e}"
)


if (
    pre_runtime_cos_error
    >
    ONLINE_COS_TOL
):

    raise RuntimeError(
        "Online cosine matching FAILED."
    )


# Do NOT abort here for structural drift.
# We flag it and still save/report the result.
# Final causal-sufficiency classification will only be valid if integrity PASS.

pre_runtime_pca_rel_error = abs(
    pre_runtime_pca
    -
    TARGET_PCA_ENERGY
) / TARGET_PCA_ENERGY


pre_runtime_cont_error = abs(
    pre_runtime_cont
    -
    TARGET_CONTINUITY
)


PREFLIGHT_STRUCTURAL_PASS = bool(

    pre_runtime_pca_rel_error
    <=
    RUNTIME_PCA_REL_TOL

    and

    pre_runtime_cont_error
    <=
    RUNTIME_CONT_ABS_TOL
)


print(
    "Runtime structural preflight:",
    (
        "PASS"
        if PREFLIGHT_STRUCTURAL_PASS
        else "WARNING / DRIFT"
    )
)


