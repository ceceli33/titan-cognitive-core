for l in range(
    VECTOR_LAYERS
):

    X = (
        GENERIC_HS[
            :,
            l,
            :
        ]
        .astype(
            np.float64
        )
    )


    X = (
        X
        -
        X.mean(
            axis=0,
            keepdims=True
        )
    )


    _, _, Vt = np.linalg.svd(
        X,
        full_matrices=False
    )


    PCA_BASIS[l] = (
        Vt[
            :TOP_K_PCA
        ]
        .astype(
            np.float32
        )
    )


print(
    "Top-K:",
    TOP_K_PCA
)

print(
    f"Target PCA energy = "
    f"{TARGET_PCA_ENERGY:.9f}"
)

print(
    f"Target continuity = "
    f"{TARGET_CONTINUITY:+.9f}"
)


# =============================================================================
# 12. JOINT PCA + CONTINUITY SYNTHESIS
# =============================================================================
#
# DESIGN
# ------
# We need one layerwise bank satisfying BOTH:
#
#   PCA energy ≈ alpha
#   adjacent cosine ≈ rho
#
# Construction:
#
#   v_l = sqrt(alpha) * p_l
#       + sqrt(1-alpha) * q_l
#
# p_l lives in the layer's top-K PCA subspace.
# q_l lives in its orthogonal complement.
#
# To impose continuity, the previous full vector is used as a directional
# anchor. For each new layer we construct PCA and non-PCA components that
# are biased toward the corresponding projection of v_{l-1}.
#
# Then a deterministic scalar mixing search adjusts the continuity to rho
# while preserving the desired PCA energy.
#
# This is synthesis/calibration ONLY.
# No transport outcome is used.
# =============================================================================

def pca_energy_np(
    v,
    layer
):

    basis = (
        PCA_BASIS[layer]
        .astype(np.float64)
    )

    v = np.asarray(
        v,
        dtype=np.float64
    )

    proj = (
        v
        @
        basis.T
    )

    return float(
        np.sum(
            proj ** 2
        )
    )


def decompose_to_pca(
    v,
    layer
):

    v = np.asarray(
        v,
        dtype=np.float64
    )

    basis = (
        PCA_BASIS[layer]
        .astype(np.float64)
    )


    p = (
        (v @ basis.T)
        @ basis
    )


    q = v - p


    return p, q


def random_pca_unit(
    layer,
    rng
):

    basis = (
        PCA_BASIS[layer]
        .astype(np.float64)
    )

    coeff = (
        rng.standard_normal(
            TOP_K_PCA
        )
    )


    p = (
        coeff
        @
        basis
    )


    return (
        normalize_np(p)
        .astype(np.float64)
    )


def random_nonpca_unit(
    layer,
    rng
):

    basis = (
        PCA_BASIS[layer]
        .astype(np.float64)
    )


    z = (
        rng.standard_normal(
            HIDDEN
        )
        .astype(np.float64)
    )


    z = (
        z
        -
        (
            (z @ basis.T)
            @ basis
        )
    )


    return (
        normalize_np(z)
        .astype(np.float64)
    )


def compose_fixed_pca_energy(
    p_unit,
    q_unit
):

    return normalize_np(

        math.sqrt(
            TARGET_PCA_ENERGY
        )
        *
        p_unit

        +

        math.sqrt(
            1.0
            -
            TARGET_PCA_ENERGY
        )
        *
        q_unit
    )


def make_joint_bank(
    seed
):

    rng = np.random.default_rng(
        int(seed)
    )


    bank = np.zeros(
        (
            VECTOR_LAYERS,
            HIDDEN
        ),
        dtype=np.float32
    )


    # -------------------------------------------------------------------------
    # L0
    # -------------------------------------------------------------------------

    p0 = random_pca_unit(
        0,
        rng
    )

    q0 = random_nonpca_unit(
        0,
        rng
    )


    bank[0] = (
        compose_fixed_pca_energy(
            p0,
            q0
        )
    )


    # -------------------------------------------------------------------------
    # L1...L19
    # -------------------------------------------------------------------------

    for l in range(
        1,
        VECTOR_LAYERS
    ):

        prev = (
            bank[l - 1]
            .astype(np.float64)
        )


        # Project previous vector into CURRENT layer's PCA basis.
        prev_p, prev_q = (
            decompose_to_pca(
                prev,
                l
            )
        )


        prev_p_norm = (
            np.linalg.norm(
                prev_p
            )
        )

        prev_q_norm = (
            np.linalg.norm(
                prev_q
            )
        )


        if prev_p_norm > 1e-10:

            prev_p_unit = (
                prev_p
                /
                prev_p_norm
            )

        else:

            prev_p_unit = (
                random_pca_unit(
                    l,
                    rng
                )
            )


        if prev_q_norm > 1e-10:

            prev_q_unit = (
                prev_q
                /
                prev_q_norm
            )

        else:

            prev_q_unit = (
                random_nonpca_unit(
                    l,
                    rng
                )
            )


        # Independent directions.
        rand_p = random_pca_unit(
            l,
            rng
        )

        rand_q = random_nonpca_unit(
            l,
            rng
        )


        # Orthogonalize random PCA direction against previous PCA direction.
        rand_p = (
            rand_p
            -
            np.dot(
                rand_p,
                prev_p_unit
            )
            *
            prev_p_unit
        )


        if np.linalg.norm(
            rand_p
        ) < 1e-10:

            rand_p = random_pca_unit(
                l,
                rng
            )


        rand_p = (
            normalize_np(
                rand_p
            )
            .astype(np.float64)
        )


        # Orthogonalize random non-PCA direction against previous q direction.
        rand_q = (
            rand_q
            -
            np.dot(
                rand_q,
                prev_q_unit
            )
            *
            prev_q_unit
        )


        if np.linalg.norm(
            rand_q
        ) < 1e-10:

            rand_q = random_nonpca_unit(
                l,
                rng
            )


        rand_q = (
            normalize_np(
                rand_q
            )
            .astype(np.float64)
        )


        # ---------------------------------------------------------------------
        # Search one continuity mixing coefficient beta.
        #
        # beta=1   -> strongly follows previous orientation
        # beta=0   -> fresh random orientation
        #
        # PCA energy remains fixed by construction.
        # ---------------------------------------------------------------------

        best_v = None
        best_err = float(
            "inf"
        )


        # Dense deterministic search.
        for beta in np.linspace(
            0.0,
            1.0,
            1001
        ):

            p = (
                beta
                *
                prev_p_unit

                +

                math.sqrt(
                    max(
                        0.0,
                        1.0
                        -
                        beta * beta
                    )
                )
                *
                rand_p
            )


            p = (
                normalize_np(p)
                .astype(np.float64)
            )


            q = (
                beta
                *
                prev_q_unit

                +

                math.sqrt(
                    max(
                        0.0,
                        1.0
                        -
                        beta * beta
                    )
                )
                *
                rand_q
            )


            q = (
                normalize_np(q)
                .astype(np.float64)
            )


            candidate = (
                compose_fixed_pca_energy(
                    p,
                    q
                )
            )


            c = cosine_np(
                prev,
                candidate
            )


            err = abs(
                c
                -
                TARGET_CONTINUITY
            )


            if err < best_err:

                best_err = err
                best_v = candidate


        bank[l] = best_v


    return bank


