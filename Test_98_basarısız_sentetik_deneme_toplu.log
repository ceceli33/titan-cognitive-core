    "PCA_ONLY isolates H2       :",
    "PASS"
    if PCA_ISOLATION_PASS
    else "FAIL"
)


print(
    "CONTINUITY_ONLY isolates H3:",
    "PASS"
    if CONT_ISOLATION_PASS
    else "FAIL"
)


if (
    PCA_ISOLATION_PASS
    and
    CONT_ISOLATION_PASS
):

    print(
