# 6. BASIC HELPERS
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(
        v,
        dtype=np.float64
    )

    n = np.linalg.norm(v)

    if n < eps:
        return np.zeros_like(
            v,
            dtype=np.float32
        )

    return (
        v / n
    ).astype(np.float32)


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(
        a,
        dtype=np.float64
    )

    b = np.asarray(
        b,
        dtype=np.float64
    )

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def empirical_position(obs, null):

    null = np.asarray(
        null,
        dtype=np.float64
    )

    upper_count = int(
        np.sum(
            null >= obs
        )
    )

    lower_count = int(
        np.sum(
            null <= obs
        )
    )

    return {

        "obs":
            float(obs),

        "null_mean":
            float(null.mean()),

        "null_sd":
            float(null.std()),

        "null_min":
            float(null.min()),

        "null_max":
            float(null.max()),

        "percentile":
            float(
                100.0
                *
                np.mean(
                    null < obs
                )
            ),

        "upper_count":
            upper_count,

        "upper_plus1":
            float(
                (
                    upper_count + 1
                )
                /
                (
                    len(null) + 1
                )
            ),

        "lower_count":
            lower_count,

        "lower_plus1":
            float(
                (
                    lower_count + 1
                )
                /
                (
                    len(null) + 1
                )
            ),
    }


