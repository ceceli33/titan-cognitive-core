# =============================================================================
# 21. ONLINE STRUCTURAL COSINE MATCH
# =============================================================================
#
# Preserve the structural vector's orientation in the subspace orthogonal
# to the current hidden state, then force the exact semantic cosine:
#
#   r = c*hhat + sqrt(1-c²)*normalize(s_perp)
#
# =============================================================================

def online_match_structural_tensor(
    hlast,
    structural_np,
    target_cos
):

    h32 = (
        hlast
        .detach()
        .float()
    )


    hhat = (

        h32

        /

        (
            torch.linalg.norm(
                h32,
                dim=-1,
                keepdim=True
            )

            +

            EPS
        )
    )


    s = (

        torch.as_tensor(
            structural_np,
            device=hlast.device,
            dtype=torch.float32
        )

        .unsqueeze(0)
    )


    s = (

        s

        /

        (
            torch.linalg.norm(
                s,
                dim=-1,
                keepdim=True
            )

            +

            EPS
        )
    )


    sperp = (

        s

        -

        torch.sum(
            s * hhat,
            dim=-1,
            keepdim=True
        )

        *

        hhat
    )


    if float(
        torch.linalg.norm(
            sperp
        )
        .detach()
        .cpu()
    ) < 1e-10:

        sperp = torch.roll(
            hhat,
            shifts=1,
            dims=-1
        )


        sperp = (

            sperp

            -

            torch.sum(
                sperp * hhat,
                dim=-1,
                keepdim=True
            )

            *

            hhat
        )


    sperp = (

        sperp

        /

        (
            torch.linalg.norm(
                sperp,
                dim=-1,
                keepdim=True
            )

            +

            EPS
        )
    )


    c = float(
        np.clip(
            target_cos,
            -1.0,
            1.0
        )
    )


    r32 = (

        c
        *
        hhat

        +

        math.sqrt(
            max(
                0.0,
                1.0 - c*c
            )
        )

        *

        sperp
    )


    r32 = (

        r32

        /

        (
            torch.linalg.norm(
                r32,
                dim=-1,
                keepdim=True
            )

            +

            EPS
        )
    )


    return r32


# =============================================================================
# 22. JOINT ONLINE FORWARD
# =============================================================================

@torch.no_grad()
def run_joint_matched(
    prompt,
    structural_bank,
    target_telemetry
):

    states = {
        l: None
        for l in range(
            11,
            MODEL_LAYERS
        )
    }


    telemetry = []


    final_capture = {
        "hidden":
            None
    }


    handles = []


    def make_hook(l):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(
                    output,
                    tuple
                )
                else output
            )


            new_hidden = hidden


            if l in ACTIVE_LAYERS:

                hlast = hidden[
                    :,
                    -1,
                    :
                ]


                target_cos = float(

                    target_telemetry[
                        l
                    ][
                        "cos"
                    ]
                )


                r32 = (
                    online_match_structural_tensor(

                        hlast,

                        structural_bank[l],

                        target_cos
                    )
                )


                v = r32.to(
                    dtype=hidden.dtype
                )


                hn = torch.linalg.norm(
                    hlast,
                    dim=-1,
                    keepdim=True
                )


                vn = torch.linalg.norm(
                    v,
                    dim=-1,
                    keepdim=True
                )


                actual_cos_tensor = (

                    torch.sum(
                        hlast * v,
                        dim=-1,
                        keepdim=True
                    )

                    /

                    (
                        hn * vn
                        +
                        EPS
                    )
                )


                actual_cos = float(
                    actual_cos_tensor
                    .mean()
                    .detach()
                    .cpu()
                )


                env, brake = (
                    dra_parameters(
                        actual_cos,
                        l
                    )
                )


                contribution = (

                    IVME

                    *

                    hn

                    /

                    SQRT_K

                    *

                    env

                    *

                    brake
                )


                delta = (
                    contribution
                    *
                    v
                )


                new_hidden = (
                    hidden.clone()
                )


                new_hidden[
                    :,
                    -1,
                    :
                ] += delta


                ref = (
                    target_telemetry[
                        l
                    ]
                )


                telemetry.append({

                    "layer":
                        int(l),

                    "target_cos":
                        target_cos,

                    "actual_cos":
                        actual_cos,

                    "cos_error":
                        float(
                            actual_cos
                            -
                            target_cos
                        ),

                    "target_env":
                        float(
                            ref["env"]
                        ),

                    "actual_env":
                        float(env),

                    "env_error":
                        float(
                            env
                            -
                            ref["env"]
                        ),

                    "target_brake":
                        float(
                            ref["brake"]
                        ),

                    "actual_brake":
                        float(brake),

                    "brake_error":
                        float(
                            brake
                            -
                            ref["brake"]
                        ),

                    # Store only active-layer matched vector.
                    "matched_vector":
                        (
                            r32[
                                0
                            ]
                            .detach()
                            .cpu()
                            .numpy()
                            .astype(
                                np.float32
                            )
                        ),
                })


            if l >= 11:

                states[l] = (

                    new_hidden[
                        0,
                        -1,
                        :
                    ]

                    .detach()
                    .float()
                    .cpu()
                    .numpy()
                    .astype(
                        np.float32
                    )
                )


            if isinstance(
                output,
                tuple
            ):

                return (
                    new_hidden,
                    *output[1:]
                )


            return new_hidden


        return hook


    for l in range(
        MODEL_LAYERS
    ):

        handles.append(

            model.model.layers[l]
            .register_forward_hook(
                make_hook(l)
            )
        )


    def final_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = (
            inputs[0]
            .detach()
        )


    final_handle = (

        model.model.norm
        .register_forward_pre_hook(
            final_pre_hook
        )
    )


    enc = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    try:

        _ = model(
            **enc,
            use_cache=False
        )


        readout = target_readout(

            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


    finally:

        for h in handles:
            h.remove()

        final_handle.remove()


    return {

        "states":
            states,

        "telemetry":
            telemetry,

        "readout":
            readout,
    }


