# 9. LAYERWISE EXTRACTION
# =============================================================================

@torch.no_grad()
def extract_layerwise(
    texts,
    max_length=128
):

    enc = tokenizer(
        texts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=max_length,
    )


    input_ids = (
        enc["input_ids"]
        .to(model.device)
    )

    attention_mask = (
        enc["attention_mask"]
        .to(model.device)
    )


    captured = [
        None
        for _ in range(
            VECTOR_LAYERS
        )
    ]


    handles = []


    def make_hook(l):

        def hook(
            module,
            inputs,
            output
        ):

            h = (
                output[0]
                if isinstance(
                    output,
                    tuple
                )
                else output
            )

            captured[l] = (
                h.detach()
            )

        return hook


    try:

        for l in range(
            VECTOR_LAYERS
        ):

            handles.append(
                model.model.layers[l]
                .register_forward_hook(
                    make_hook(l)
                )
            )


        _ = model(
            input_ids=input_ids,
            attention_mask=attention_mask,
            use_cache=False,
        )


    finally:

        for h in handles:
            h.remove()


    lengths = (
        attention_mask
        .sum(dim=1)
        .cpu()
        .numpy()
    )


    result = np.zeros(
        (
            len(texts),
            VECTOR_LAYERS,
            HIDDEN
        ),
        dtype=np.float32
    )


    for l in range(
        VECTOR_LAYERS
    ):

        x = (
            captured[l]
            .float()
            .cpu()
            .numpy()
        )


        for i in range(
            len(texts)
        ):

            result[
                i,
                l
            ] = x[
                i,
                int(
                    lengths[i]
                ) - 1
            ]


    return result


