    )


    r = (
        SUMMARY[
            "RANDOM"
        ][key]["net"]
        - base
    )


    sep = (
        a - b
    )


    DELTA_SUMMARY[
        key
    ] = {

        "above_delta":
            float(a),

        "below_delta":
            float(b),

        "random_delta":
            float(r),

        "separation":
            float(sep),

        "above_minus_random":
            float(
                a - r
            ),

        "below_minus_random":
            float(
                b - r
            ),
    }


    print(
        f"\n{label}"
    )

    print(
        f"  ABOVE Δ  = {a:+.4f}"
    )

    print(
        f"  BELOW Δ  = {b:+.4f}"
    )

    print(
        f"  RANDOM Δ = {r:+.4f}"
    )

    print(
        f"  SEP A-B  = {sep:+.4f}"
    )

    print(
        f"  A-R      = {a-r:+.4f}"
