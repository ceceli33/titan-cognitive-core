def run_arm(
    arm_name,
    vectors
):

    print(
        f"\n[ARM] {arm_name}"
    )


    results = []


    for i, prompt in enumerate(
        BEHAVIOR_PROMPTS
    ):

        text, telemetry = (
            steered_generate(
                prompt,
                vectors
            )
        )


        result = measure_text(
            text,
            telemetry
        )


        result[
            "prompt_index"
        ] = i


        results.append(
            result
        )


    return results


