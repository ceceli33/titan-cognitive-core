# =============================================================================
# 5. MEASUREMENT VOCABULARY
# =============================================================================

ABOVE_TERMS = [
    "above",
    "overhead",
    "higher",
    "upward",
    "over",
]

BELOW_TERMS = [
    "below",
    "under",
    "underneath",
    "lower",
    "downward",
    "beneath",
]


SUBJECT_TERMS = [
    "mustafa dibekgoz",
    "mustafa",
    "dibekgoz",
    "he",
    "him",
    "his",
]


REFERENCE_TERMS = [
    "bridge",
    "tower",
    "deck",
    "walkway",
    "structure",
    "cables",
    "cable",
    "arch",
    "arches",
    "railing",
]


# =============================================================================
# 6. BASIC HELPERS
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(v, dtype=np.float32)

    n = np.linalg.norm(v)

    if n < eps:
        return v.copy()

    return v / n


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(a, dtype=np.float32)
    b = np.asarray(b, dtype=np.float32)

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        / (na * nb)
    )


def word_count(text):

    return len(
        re.findall(
            r"\b[\w'-]+\b",
            text
        )
    )


def repetition_score(text):

    words = re.findall(
        r"\b[\w'-]+\b",
        text.lower()
    )

    if len(words) < 2:
        return 0.0

    bigrams = list(
        zip(
            words[:-1],
            words[1:]
        )
    )

    if not bigrams:
        return 0.0

    counts = Counter(bigrams)

    repeated = sum(
        n - 1
        for n in counts.values()
        if n > 1
    )

    return float(
        repeated / len(bigrams)
    )


def contains_term(text, term):

    return bool(
        re.search(
            r"\b"
            + re.escape(term)
            + r"\b",
            text,
            flags=re.I
        )
    )


def count_term(text, term):

    return len(
        re.findall(
            r"\b"
            + re.escape(term)
            + r"\b",
            text,
            flags=re.I
        )
    )


def count_term_list(text, terms):

    return sum(
        count_term(text, term)
        for term in terms
    )


# =============================================================================
# 7. SENTENCE SPLITTER
# =============================================================================

def split_sentences(text):

    # Satırları normalize et.
    clean = re.sub(
        r"\s+",
        " ",
        text.strip()
    )

    # Basit ve şeffaf sentence segmentation.
    parts = re.split(
        r"(?<=[.!?])\s+",
        clean
    )

    return [
        x.strip()
        for x in parts
        if x.strip()
    ]


# =============================================================================
# 8. MEASUREMENT LAYER 1 — RAW LEXICAL
# =============================================================================

def raw_lexical_measure(text):

    above = count_term_list(
        text,
        ABOVE_TERMS
    )

    below = count_term_list(
        text,
        BELOW_TERMS
    )

    return {
        "above": int(above),
        "below": int(below),
        "net": int(above - below),
    }


# =============================================================================
# 9. MEASUREMENT LAYER 2 — SUBJECT-CONDITIONED
# =============================================================================
#
# Yalnızca özne/pronoun içeren cümleleri ele alır.
#
# Ayrıca bridge/tower/etc. referansı bulunan cümleler ayrı tutulur.
#
# Böylece:
#
#     "waters far below"
#
# tek başına subject-conditioned puan oluşturmaz.
#
# =============================================================================

def subject_conditioned_measure(text):

    sentences = split_sentences(text)

    subject_sentences = []
    subject_reference_sentences = []

    above = 0
    below = 0

    strict_above = 0
    strict_below = 0


    for sentence in sentences:

        has_subject = any(
            contains_term(
                sentence,
                term
            )
            for term in SUBJECT_TERMS
        )

        if not has_subject:
            continue


        subject_sentences.append(
            sentence
        )


        sentence_above = count_term_list(
            sentence,
            ABOVE_TERMS
        )

        sentence_below = count_term_list(
            sentence,
            BELOW_TERMS
        )


        above += sentence_above
        below += sentence_below


        has_reference = any(
            contains_term(
                sentence,
                term
            )
            for term in REFERENCE_TERMS
        )


        if has_reference:

            subject_reference_sentences.append(
                sentence
            )

            strict_above += sentence_above
            strict_below += sentence_below


    return {

        "above":
            int(above),

        "below":
            int(below),

        "net":
            int(
                above - below
            ),

        "strict_above":
            int(strict_above),

        "strict_below":
            int(strict_below),

        "strict_net":
            int(
                strict_above
                - strict_below
            ),

        "subject_sentences":
            subject_sentences,

        "subject_reference_sentences":
            subject_reference_sentences,
    }


# =============================================================================
# 10. MEASUREMENT LAYER 3 — RELATIONAL PATTERN
# =============================================================================
#
# Daha sıkı ölçüm.
#
# Bir cümlede:
#
#   - subject
#   - spatial direction
#   - bridge-reference
#
# birlikte bulunmalı.
#
# Ayrıca bunların birbirinden aşırı uzak olmaması için token window kullanılır.
#
# Bu bir dependency parser değildir.
# Fakat ölçüm tamamen deterministik ve denetlenebilir.
#
# =============================================================================

def tokenize_words(text):

    return re.findall(
        r"\b[\w'-]+\b",
        text.lower()
    )


def find_phrase_positions(
    words,
    phrase
):

    phrase_words = (
        phrase.lower().split()
    )

    positions = []

    k = len(phrase_words)

    for i in range(
        len(words) - k + 1
    ):

        if (
            words[i:i+k]
            == phrase_words
        ):
            positions.append(i)

    return positions


def all_positions(
    words,
    terms
):

    positions = []

    for term in terms:

        for pos in find_phrase_positions(
            words,
            term
        ):

            positions.append(
                (pos, term)
            )

    return positions


def relational_pattern_measure(
    text,
    max_window=12
):

    sentences = split_sentences(text)

    above_hits = []
    below_hits = []


    for sentence_index, sentence in enumerate(
        sentences
    ):

        words = tokenize_words(
            sentence
        )


        subject_positions = all_positions(
            words,
            SUBJECT_TERMS
        )

        reference_positions = all_positions(
            words,
            REFERENCE_TERMS
        )

        above_positions = all_positions(
            words,
            ABOVE_TERMS
        )

        below_positions = all_positions(
            words,
            BELOW_TERMS
        )


        if (
            not subject_positions
            or not reference_positions
        ):
            continue


        # -------------------------------------------------------------
        # ABOVE
        # -------------------------------------------------------------

        for spatial_pos, spatial_term in above_positions:

            best_subject_distance = min(
                abs(
                    spatial_pos
                    - subject_pos
                )
                for subject_pos, _
                in subject_positions
            )

            best_reference_distance = min(
                abs(
                    spatial_pos
                    - ref_pos
                )
                for ref_pos, _
                in reference_positions
            )


            if (
                best_subject_distance
                <= max_window
                and
                best_reference_distance
                <= max_window
            ):

                above_hits.append({

                    "sentence_index":
                        sentence_index,

                    "term":
                        spatial_term,

                    "subject_distance":
                        int(
                            best_subject_distance
                        ),

                    "reference_distance":
                        int(
                            best_reference_distance
                        ),

                    "sentence":
                        sentence,
                })


        # -------------------------------------------------------------
        # BELOW
        # -------------------------------------------------------------

        for spatial_pos, spatial_term in below_positions:

            best_subject_distance = min(
                abs(
                    spatial_pos
                    - subject_pos
                )
                for subject_pos, _
                in subject_positions
            )

            best_reference_distance = min(
                abs(
                    spatial_pos
                    - ref_pos
                )
                for ref_pos, _
                in reference_positions
            )


            if (
                best_subject_distance
                <= max_window
                and
                best_reference_distance
                <= max_window
            ):

                below_hits.append({

                    "sentence_index":
                        sentence_index,

                    "term":
                        spatial_term,

                    "subject_distance":
                        int(
                            best_subject_distance
                        ),

                    "reference_distance":
                        int(
                            best_reference_distance
                        ),

                    "sentence":
                        sentence,
                })


    above = len(above_hits)
    below = len(below_hits)


    return {

        "above":
            int(above),

        "below":
            int(below),

        "net":
            int(
                above - below
            ),

        "above_hits":
            above_hits,

        "below_hits":
            below_hits,
    }


# =============================================================================
# 11. COMPLETE TEXT MEASUREMENT
# =============================================================================

def measure_text(
    text,
    telemetry=None
):

    raw = raw_lexical_measure(
        text
    )

    subject = subject_conditioned_measure(
        text
    )

    relation = relational_pattern_measure(
        text
    )


    result = {

        "raw":
            raw,

        "subject":
            subject,

        "relation":
            relation,

        "words":
            int(
                word_count(text)
            ),

        "repetition":
            float(
                repetition_score(text)
            ),

        "text":
            text,
    }


    if telemetry is not None:

        result[
            "telemetry"
        ] = telemetry


    return result


