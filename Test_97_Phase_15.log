# =============================================================================
# 16. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        - abs(cosine_value)
    )


    dw = (
        SONUM
        + uncertainty * 0.20
    )


    t = float(
        layer_idx
    )


    kb = (
        ZIRVE
        * math.exp(
            -dw * t
        )
        * (
            1.0
            + dw * t
        )
        + TABAN
    )


    envelope = (
        kb
        / (
            ZIRVE
            + TABAN
        )
    )


    if (
        cosine_value
        > COS_BRAKE_HIGH
    ):

        brake = (
            (
                1.0
                - cosine_value
            )
            / BRAKE_HIGH_DENOM
        )


    elif (
        cosine_value
        < COS_BRAKE_LOW
    ):

        brake = (
            BRAKE_LOW_GAIN
        )


    else:

        brake = 1.0


    return (
        envelope,
        brake
    )


# =============================================================================
# 17. BASELINE GENERATION
# =============================================================================

@torch.no_grad()
def baseline_generate(prompt):

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    output = model.generate(

        **encoded,

        max_new_tokens=
            MAX_NEW_TOKENS,

        do_sample=False,

        repetition_penalty=1.0,

        use_cache=True,

        pad_token_id=
            tokenizer.eos_token_id,
    )


    prompt_len = (
        encoded[
            "input_ids"
        ].shape[1]
    )


    generated = output[
        0,
        prompt_len:
    ]


    return tokenizer.decode(
        generated,
        skip_special_tokens=True
    )


# =============================================================================
# 18. STEERED GENERATION
# =============================================================================

def steered_generate(
    prompt,
    vectors
):

    handles = []


    telemetry = {

        "cos": [],
        "abs_cos": [],
        "contribution": [],
        "envelope": [],
        "brake": [],
        "hook_steps": 0,
    }


    def make_hook(
        layer_idx
    ):

        vector = torch.tensor(
            vectors[layer_idx],
            device=model.device,
            dtype=next(
                model.parameters()
            ).dtype
        ).unsqueeze(0)


        def hook(
            module,
            inputs,
            output
        ):

            if isinstance(
                output,
                tuple
            ):

                hidden = output[0]
                remainder = output[1:]

            else:

                hidden = output
                remainder = None


            h = hidden[
                :,
                -1,
                :
            ]


            h_norm = (
                torch.linalg.norm(
                    h,
                    dim=-1,
                    keepdim=True
                )
            )


            v_norm = (
                torch.linalg.norm(
                    vector,
                    dim=-1,
                    keepdim=True
                )
            )


            cosine = (
                torch.sum(
                    h * vector,
                    dim=-1,
                    keepdim=True
                )
                /
                (
                    h_norm
                    * v_norm
                    + 1e-12
                )
            )


            cosine_value = float(
                cosine.mean()
                .detach()
                .cpu()
            )


            envelope, brake = (
                dra_parameters(
                    cosine_value,
                    layer_idx
                )
            )


            contribution = (

                IVME

                * h_norm

                / SQRT_K

                * envelope

                * brake
            )


            delta = (
                contribution
                * vector
            )


            hidden_new = (
                hidden.clone()
            )


            hidden_new[
                :,
                -1,
                :
            ] = (

                hidden_new[
                    :,
                    -1,
                    :
                ]

                + delta
            )


            telemetry[
                "cos"
            ].append(
                cosine_value
            )


            telemetry[
                "abs_cos"
            ].append(
                abs(
                    cosine_value
                )
            )


            telemetry[
                "contribution"
            ].append(

                float(
                    contribution
                    .mean()
                    .detach()
                    .cpu()
                )
            )


            telemetry[
                "envelope"
            ].append(
                float(
                    envelope
                )
            )


            telemetry[
                "brake"
            ].append(
                float(
                    brake
                )
            )


            telemetry[
                "hook_steps"
            ] += 1


            if (
                remainder
                is not None
            ):

                return (
                    hidden_new,
                    *remainder
                )


            return hidden_new


        return hook


    for layer_idx in ACTIVE_LAYERS:

        handles.append(

            model.model.layers[
                layer_idx
            ].register_forward_hook(

                make_hook(
                    layer_idx
                )
            )
        )


    try:

        encoded = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(
            model.device
        )


        with torch.no_grad():

            output = model.generate(

                **encoded,

                max_new_tokens=
                    MAX_NEW_TOKENS,

                do_sample=False,

                repetition_penalty=1.0,

                use_cache=True,

                pad_token_id=
                    tokenizer.eos_token_id,
            )


        prompt_len = (
            encoded[
                "input_ids"
            ].shape[1]
        )


        generated = output[
            0,
            prompt_len:
        ]


        text = tokenizer.decode(
            generated,
            skip_special_tokens=True
        )


    finally:

        for h in handles:
            h.remove()


    def safe_mean(values):

        if not values:
            return 0.0

        return float(
            np.mean(values)
        )


    summary = {

        "mean_cos":
            safe_mean(
                telemetry["cos"]
            ),

        "mean_abs_cos":
            safe_mean(
                telemetry["abs_cos"]
            ),

        "mean_contribution":
            safe_mean(
                telemetry[
                    "contribution"
                ]
            ),

        "mean_envelope":
            safe_mean(
                telemetry[
                    "envelope"
                ]
            ),

        "mean_brake":
            safe_mean(
                telemetry[
                    "brake"
                ]
            ),

        "hook_steps":
            int(
                telemetry[
                    "hook_steps"
                ]
            ),
    }


    return (
        text,
        summary
    )


