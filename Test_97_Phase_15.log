    "BELOW_IND":
        BELOW_RESULTS,

    "RANDOM":
        RANDOM_RESULTS,
}


def aggregate_arm(
    results
):

    output = {}


    for metric_name in [
        "raw",
        "subject",
        "relation"
    ]:

        output[
            metric_name
        ] = {

            "above":
                float(
                    np.mean([
                        x[metric_name][
                            "above"
                        ]
                        for x in results
                    ])
                ),

            "below":
                float(
                    np.mean([
                        x[metric_name][
                            "below"
                        ]
                        for x in results
                    ])
                ),

            "net":
                float(
                    np.mean([
                        x[metric_name][
                            "net"
                        ]
                        for x in results
                    ])
                ),
        }


    # subject strict metric
    output[
        "subject_strict"
    ] = {

        "above":
            float(
                np.mean([
                    x["subject"][
                        "strict_above"
                    ]
                    for x in results
                ])
            ),

        "below":
            float(
                np.mean([
                    x["subject"][
                        "strict_below"
                    ]
                    for x in results
                ])
            ),

        "net":
            float(
                np.mean([
                    x["subject"][
                        "strict_net"
                    ]
                    for x in results
                ])
            ),
    }


    output[
        "words"
    ] = float(
        np.mean([
            x["words"]
            for x in results
        ])
    )


    output[
        "repetition"
    ] = float(
        np.mean([
            x["repetition"]
            for x in results
        ])
    )


    if (
        "telemetry"
        in results[0]
    ):

        for key in [
            "mean_cos",
            "mean_abs_cos",
            "mean_contribution",
            "mean_envelope",
            "mean_brake",
        ]:

            output[key] = float(
                np.mean([
                    x["telemetry"][key]
                    for x in results
                ])
            )


    return output


SUMMARY = {

    name:
        aggregate_arm(
            results
        )

    for name, results
    in ARMS.items()
}


