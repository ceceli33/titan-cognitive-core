# =============================================================================
# 5. HELPERS
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(v, dtype=np.float32)

    n = np.linalg.norm(v)

    if n < eps:
        return v.copy()

    return v / n


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(a, dtype=np.float32)
    b = np.asarray(b, dtype=np.float32)

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def mean_value(values):

    return float(
        np.mean(values)
    )


def median_value(values):

    return float(
        np.median(values)
    )


def std_value(values):

    if len(values) < 2:
        return 0.0

    return float(
        np.std(
            values,
            ddof=1
        )
    )


def sign_counts(values, eps=0.0):

    pos = sum(
        x > eps
        for x in values
    )

    neg = sum(
        x < -eps
        for x in values
    )

    zero = (
        len(values)
        - pos
        - neg
    )

    return {
        "positive": int(pos),
        "negative": int(neg),
        "zero": int(zero),
    }


