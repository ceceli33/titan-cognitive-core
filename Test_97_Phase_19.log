)


for layer_idx in range(N_LAYERS):

    RANDOM_VECTOR[layer_idx] = normalize_np(
        RANDOM_VECTOR[layer_idx]
    )


print("\nGeometrik kontrol:")


for layer_idx in ACTIVE_LAYERS:

    print(
        f"L{layer_idx:02d} | "
        f"cos(A,B)="
        f"{cosine_np(IND_ABOVE[layer_idx], IND_BELOW[layer_idx]):+.6f} | "
        f"cos(A,R)="
        f"{cosine_np(IND_ABOVE[layer_idx], RANDOM_VECTOR[layer_idx]):+.6f} | "
        f"cos(B,R)="
        f"{cosine_np(IND_BELOW[layer_idx], RANDOM_VECTOR[layer_idx]):+.6f}"
    )


# =============================================================================
# 11. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        - abs(cosine_value)
    )


    dw = (
        SONUM
        + uncertainty * 0.20
    )


    t = float(
        layer_idx
    )


    kb = (
        ZIRVE
        * math.exp(
            -dw * t
        )
        * (
            1.0
            + dw * t
        )
        + TABAN
    )


    envelope = (
        kb
        /
        (
            ZIRVE
            + TABAN
        )
    )


    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            (1.0 - cosine_value)
            /
            BRAKE_HIGH_DENOM
        )


    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN


    else:

        brake = 1.0


    return (
        envelope,
        brake
    )


# =============================================================================
# 12. GET LAST-TOKEN LOGITS — BASELINE
# =============================================================================

@torch.no_grad()
def baseline_logits(prompt):

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(model.device)


    outputs = model(
        **encoded,
        use_cache=False,
    )


    logits = (
        outputs.logits[
            0,
            -1,
            :
        ]
        .float()
    )


    return logits


# =============================================================================
# 13. GET LAST-TOKEN LOGITS — STEERED
# =============================================================================

@torch.no_grad()
def steered_logits(
    prompt,
    vectors
):

    handles = []


    telemetry = {
        "cos": [],
        "abs_cos": [],
        "contribution": [],
        "envelope": [],
        "brake": [],
        "hook_steps": 0,
    }


    def make_hook(layer_idx):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            # Vector doğrudan hidden tensor'ın device/dtype'ına taşınır.
            vector = torch.as_tensor(
                vectors[layer_idx],
                device=hidden.device,
                dtype=hidden.dtype
            ).unsqueeze(0)


            h = hidden[
                :,
                -1,
                :
            ]


            h_norm = torch.linalg.norm(
                h,
                dim=-1,
                keepdim=True
            )


            v_norm = torch.linalg.norm(
                vector,
                dim=-1,
                keepdim=True
            )


            cosine = (
                torch.sum(
                    h * vector,
                    dim=-1,
                    keepdim=True
                )
                /
                (
                    h_norm
                    * v_norm
                    + 1e-12
                )
            )


            cosine_value = float(
                cosine.mean()
                .detach()
                .cpu()
            )


            envelope, brake = (
                dra_parameters(
                    cosine_value,
                    layer_idx
                )
            )


            contribution = (
                IVME
                * h_norm
                / SQRT_K
                * envelope
                * brake
            )


            delta = (
                contribution
                * vector
            )


            hidden_new = hidden.clone()


            hidden_new[
                :,
                -1,
                :
            ] = (
                hidden_new[
                    :,
                    -1,
                    :
                ]
                + delta
            )


            telemetry[
                "cos"
            ].append(
                cosine_value
            )


            telemetry[
                "abs_cos"
            ].append(
                abs(cosine_value)
            )


            telemetry[
                "contribution"
            ].append(
                float(
                    contribution
                    .mean()
                    .detach()
                    .cpu()
                )
            )


            telemetry[
                "envelope"
            ].append(
                float(envelope)
            )


            telemetry[
                "brake"
            ].append(
                float(brake)
            )


            telemetry[
                "hook_steps"
            ] += 1


            if isinstance(output, tuple):

                return (
                    hidden_new,
                    *output[1:]
                )

            return hidden_new


        return hook


    for layer_idx in ACTIVE_LAYERS:

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_hook(
                make_hook(layer_idx)
            )
        )


    try:

        encoded = tokenizer(
            prompt,
            return_tensors="pt"
        ).to(model.device)


        outputs = model(
            **encoded,
            use_cache=False,
        )


        logits = (
            outputs.logits[
                0,
                -1,
                :
            ]
            .float()
        )


    finally:

        for handle in handles:
            handle.remove()


    summary = {
        "mean_cos":
            mean_or_zero(
                telemetry["cos"]
            ),

        "mean_abs_cos":
            mean_or_zero(
                telemetry["abs_cos"]
            ),

        "mean_contribution":
            mean_or_zero(
                telemetry["contribution"]
            ),

        "mean_envelope":
            mean_or_zero(
                telemetry["envelope"]
            ),

        "mean_brake":
            mean_or_zero(
                telemetry["brake"]
            ),

        "hook_steps":
            int(
                telemetry["hook_steps"]
            ),
    }


    return (
        logits,
        summary
    )


# =============================================================================
# 14. LOG-PROB / DLM MEASUREMENT
# =============================================================================

def measure_logits(logits):

    log_probs = torch.log_softmax(
        logits,
        dim=-1
    )


    lp_above = float(
        log_probs[
            TARGET_IDS["above"]
        ]
        .detach()
        .cpu()
    )


    lp_below = float(
        log_probs[
            TARGET_IDS["below"]
        ]
        .detach()
        .cpu()
    )


    lp_over = float(
        log_probs[
            TARGET_IDS["over"]
        ]
        .detach()
        .cpu()
    )


    lp_under = float(
        log_probs[
            TARGET_IDS["under"]
        ]
        .detach()
        .cpu()
    )


    dlm_above_below = (
        lp_above
        - lp_below
    )


    dlm_over_under = (
        lp_over
        - lp_under
    )


    # İki aday arasındaki normalize edilmiş conditional probability.
    #
    # Bu tüm vocabulary üzerindeki probability değildir.
    # Sadece ABOVE-vs-BELOW ikili aday uzayındaki normalize edilmiş olasılıktır.
    #
    pair_above_prob = float(
        torch.softmax(
            torch.tensor(
                [
                    lp_above,
                    lp_below
                ],
                dtype=torch.float64
            ),
            dim=0
        )[0]
    )


    pair_over_prob = float(
        torch.softmax(
            torch.tensor(
                [
                    lp_over,
                    lp_under
                ],
                dtype=torch.float64
            ),
            dim=0
        )[0]
    )


    return {
        "logp_above":
            lp_above,

        "logp_below":
            lp_below,

        "dlm_above_below":
            float(
                dlm_above_below
            ),

        "pair_p_above":
            pair_above_prob,

        "logp_over":
            lp_over,

        "logp_under":
            lp_under,

        "dlm_over_under":
            float(
                dlm_over_under
            ),

        "pair_p_over":
            pair_over_prob,
    }


# =============================================================================
# 15. RUN BASELINE
# =============================================================================

print(
    "\n[5/9] BASELINE logit ölçümleri..."
)


BASELINE_RESULTS = []


for i, prompt in enumerate(
