def paired_bootstrap_mean_ci(
    values,
    n_boot=10000,
    seed=12345
):

    values = np.asarray(
        values,
        dtype=np.float64
    )


    rng = np.random.default_rng(
        seed
    )


    n = len(values)


    boot_means = np.empty(
        n_boot,
        dtype=np.float64
    )


    for b in range(
        n_boot
    ):

        idx = rng.integers(
            0,
            n,
            size=n
        )


        boot_means[b] = (
            values[idx]
            .mean()
        )


    lower = float(
        np.percentile(
            boot_means,
            2.5
        )
    )


    upper = float(
        np.percentile(
            boot_means,
            97.5
        )
    )


    return {
        "observed_mean":
            float(
                values.mean()
            ),

        "bootstrap_mean":
            float(
                boot_means.mean()
            ),

        "ci95_lower":
            lower,

        "ci95_upper":
            upper,

        "n_bootstrap":
            int(n_boot),
    }


BOOTSTRAP_AB = (
