)


IND_ABOVE = (
    MEAN_ABOVE
    - MEAN_NEUTRAL
).astype(np.float32)


IND_BELOW = (
    MEAN_BELOW
    - MEAN_NEUTRAL
).astype(np.float32)


for layer_idx in range(N_LAYERS):

    IND_ABOVE[layer_idx] = normalize_np(
        IND_ABOVE[layer_idx]
    )

    IND_BELOW[layer_idx] = normalize_np(
        IND_BELOW[layer_idx]
    )


