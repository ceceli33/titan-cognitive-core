# 16. RUN STEERED ARM
# =============================================================================

def run_steered_arm(
    name,
    vectors
):

    print(
        f"\n{name} çalışıyor..."
    )


    results = []


    for i, prompt in enumerate(
        EVAL_PROMPTS
    ):

        logits, telemetry = (
            steered_logits(
                prompt,
                vectors
            )
        )


        measurement = measure_logits(
            logits
        )


        measurement[
            "prompt_index"
        ] = i + 1


        measurement[
            "prompt"
        ] = prompt


        measurement[
            "telemetry"
        ] = telemetry


        results.append(
            measurement
        )


    return results


