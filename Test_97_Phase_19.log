    "BELOW_IND":
        BELOW_RESULTS,

    "RANDOM":
        RANDOM_RESULTS,
}


def aggregate_metric(
    results,
    key
):

    values = [
        float(x[key])
        for x in results
    ]


    return {
        "mean":
            mean_or_zero(values),

        "median":
            median_or_zero(values),

        "std":
            std_or_zero(values),

        "min":
            float(
                min(values)
            ),

        "max":
            float(
                max(values)
            ),
    }


def aggregate_arm(
    results
):

    output = {
        "dlm_above_below":
            aggregate_metric(
                results,
                "dlm_above_below"
            ),

        "dlm_over_under":
            aggregate_metric(
                results,
                "dlm_over_under"
            ),

        "pair_p_above":
            aggregate_metric(
                results,
                "pair_p_above"
            ),

        "pair_p_over":
            aggregate_metric(
                results,
                "pair_p_over"
            ),
    }


    if "telemetry" in results[0]:

        for key in [
            "mean_cos",
            "mean_abs_cos",
            "mean_contribution",
            "mean_envelope",
            "mean_brake",
        ]:

            values = [
                x["telemetry"][key]
                for x in results
            ]

            output[key] = (
                mean_or_zero(values)
            )


    return output


SUMMARY = {
    name:
        aggregate_arm(results)

    for name, results
    in ARMS.items()
}


# =============================================================================
# 18. PROMPT-LEVEL DELTAS
# =============================================================================

PROMPT_RESULTS = []


for i in range(
    len(EVAL_PROMPTS)
):

    base = BASELINE_RESULTS[i]
    above = ABOVE_RESULTS[i]
    below = BELOW_RESULTS[i]
    rand = RANDOM_RESULTS[i]


    # -------------------------------------------------------------------------
    # ABOVE vs BELOW
    # -------------------------------------------------------------------------

    base_dlm = (
        base[
            "dlm_above_below"
        ]
    )

    a_dlm = (
        above[
            "dlm_above_below"
        ]
    )

    b_dlm = (
        below[
            "dlm_above_below"
        ]
    )

    r_dlm = (
        rand[
            "dlm_above_below"
        ]
    )


    delta_a = (
        a_dlm - base_dlm
    )

    delta_b = (
        b_dlm - base_dlm
    )

    delta_r = (
        r_dlm - base_dlm
    )


    dds = (
        delta_a
        - delta_b
    )


    # -------------------------------------------------------------------------
    # OVER vs UNDER
    # -------------------------------------------------------------------------

    base_cross = (
        base[
            "dlm_over_under"
        ]
    )

    a_cross = (
        above[
            "dlm_over_under"
        ]
    )

    b_cross = (
        below[
            "dlm_over_under"
        ]
    )

    r_cross = (
        rand[
            "dlm_over_under"
        ]
    )


    delta_a_cross = (
        a_cross
        - base_cross
    )

    delta_b_cross = (
        b_cross
        - base_cross
    )

    delta_r_cross = (
        r_cross
        - base_cross
    )


    dds_cross = (
        delta_a_cross
        - delta_b_cross
    )


    PROMPT_RESULTS.append({

        "prompt_index":
            i + 1,

        "prompt":
            EVAL_PROMPTS[i],

        "above_below": {

            "baseline_dlm":
                float(base_dlm),

            "above_dlm":
                float(a_dlm),

            "below_dlm":
                float(b_dlm),

            "random_dlm":
                float(r_dlm),

            "delta_above":
                float(delta_a),

            "delta_below":
                float(delta_b),

            "delta_random":
                float(delta_r),

            "dds":
                float(dds),

            "above_minus_random":
                float(
                    delta_a
                    - delta_r
                ),

            "below_minus_random":
                float(
                    delta_b
                    - delta_r
                ),
        },

        "over_under": {

            "baseline_dlm":
                float(base_cross),

            "above_dlm":
                float(a_cross),

            "below_dlm":
                float(b_cross),

            "random_dlm":
                float(r_cross),

            "delta_above":
                float(
                    delta_a_cross
                ),

            "delta_below":
                float(
                    delta_b_cross
                ),

            "delta_random":
                float(
                    delta_r_cross
                ),

            "dds":
                float(
                    dds_cross
                ),
        },
    })


# =============================================================================
# 19. GLOBAL DELTA STATISTICS
# =============================================================================

def summarize_prompt_field(
    family,
    field
):

    values = [
        x[family][field]
        for x in PROMPT_RESULTS
    ]


    return {
        "mean":
            mean_or_zero(values),

        "median":
            median_or_zero(values),

        "std":
            std_or_zero(values),

        "min":
            float(
                min(values)
            ),

        "max":
            float(
                max(values)
            ),

        "positive_count":
            int(
                sum(
                    x > 0
                    for x in values
                )
            ),

        "negative_count":
            int(
                sum(
                    x < 0
                    for x in values
                )
            ),

        "zero_count":
            int(
                sum(
                    x == 0
                    for x in values
                )
            ),
    }


GLOBAL = {
