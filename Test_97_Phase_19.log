# TEST 103/104 scaling aynen korunuyor.
SQRT_K = math.sqrt(N_LAYERS)


# DRA
SONUM = 0.30
ZIRVE = 0.70
TABAN = 0.20

COS_BRAKE_HIGH = 0.75
COS_BRAKE_LOW = -0.40

BRAKE_HIGH_DENOM = 0.25
BRAKE_LOW_GAIN = 1.60


