def summarize_telemetry(
    rows
):

    flat = []

    for group in rows:

        if isinstance(
            group,
            list
        ):
            flat.extend(group)
        else:
            flat.append(group)


    result = {}


    for key in [
        "mean_cos",
        "mean_abs_cos",
        "mean_contribution",
        "mean_envelope",
        "mean_brake",
    ]:

        vals = [
            x[key]
            for x in flat
        ]


        result[key] = {
            "mean":
                mean_value(vals),

            "std":
                std_value(vals),

            "min":
                float(
                    min(vals)
                ),

            "max":
                float(
                    max(vals)
                ),
        }


    return result


