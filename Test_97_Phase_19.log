def empirical_comparison(
    observed,
    null_values
):

    null_values = np.asarray(
        null_values,
        dtype=np.float64
    )


    # One-sided orientation:
    # fraction of null >= observed.
    upper_tail = (
        np.sum(
            null_values
            >= observed
        )
        + 1
    ) / (
        len(null_values)
        + 1
    )


    # Symmetric magnitude comparison.
    two_sided_magnitude = (
        np.sum(
            np.abs(
                null_values
            )
            >= abs(
                observed
            )
        )
        + 1
    ) / (
        len(null_values)
        + 1
    )


    percentile = (
        np.sum(
            null_values
            < observed
        )
        / len(
            null_values
        )
        * 100.0
    )


    return {
        "observed":
            float(observed),

        "null_n":
            int(
                len(
                    null_values
                )
            ),

        "null_mean":
            float(
                null_values.mean()
            ),

        "null_median":
            float(
                np.median(
                    null_values
                )
            ),

        "null_std":
            float(
                null_values.std(
                    ddof=1
                )
            )
            if len(
                null_values
            ) > 1
            else 0.0,

        "null_min":
            float(
                null_values.min()
            ),

        "null_max":
            float(
                null_values.max()
            ),

        "observed_percentile":
            float(
                percentile
            ),

        "upper_tail_fraction_plus1":
            float(
                upper_tail
            ),

        "two_sided_magnitude_fraction_plus1":
            float(
                two_sided_magnitude
            ),
    }


# Primary:
