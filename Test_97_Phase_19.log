# =============================================================================
# 5. BASIC HELPERS
# =============================================================================

def normalize_np(v, eps=1e-12):

    v = np.asarray(
        v,
        dtype=np.float32
    )

    n = np.linalg.norm(v)

    if n < eps:
        return v.copy()

    return v / n


def cosine_np(a, b, eps=1e-12):

    a = np.asarray(
        a,
        dtype=np.float32
    )

    b = np.asarray(
        b,
        dtype=np.float32
    )

    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)

    if na < eps or nb < eps:
        return 0.0

    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def mean_or_zero(values):

    if not values:
        return 0.0

    return float(
        np.mean(values)
    )


def median_or_zero(values):

    if not values:
        return 0.0

    return float(
        np.median(values)
    )


def std_or_zero(values):

    if len(values) < 2:
        return 0.0

    return float(
        np.std(
            values,
            ddof=1
        )
    )


