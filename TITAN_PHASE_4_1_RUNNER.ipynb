import math

def render_phase_4_1_cockpit(prompt, response, stats):
    cos_val = stats.get('last_cos', 0)
    rate = stats.get('intervention_rate', 0)
    
    # Renk paleti (Faz 4.1 mühürlü renkleri)
    if cos_val > 0.3: main_color = '#00ff88'; status = '🔱 KERNEL ALIGNED'
    elif cos_val > -0.1: main_color = '#44ccff'; status = '🔵 STABLE'
    else: main_color = '#ff4466'; status = '⚠️ KERNEL STEERING'
    
    html = f'''
    <div style='font-family:"Courier New",monospace;background:#0a0e17;color:#c9d4e0;
                border:2px solid {main_color};border-radius:12px;padding:20px;margin:15px 0;
                box-shadow: 0 0 15px {main_color}44;'>
        <div style='display:flex;justify-content:space-between;border-bottom:1px solid {main_color};padding-bottom:8px;'>
            <div style='font-size:14px;font-weight:bold;color:{main_color};letter-spacing:2px;'>🔱 TITAN PHASE 4.1 | KERNEL</div>
            <div style='font-size:10px;color:#5a7080;'>{status}</div>
        </div>
        
        <div style='display:flex;gap:15px;margin:15px 0;'>
            <div style='flex:1;background:#0d1117;border-radius:8px;padding:12px;text-align:center;'>
                <div style='font-size:9px;color:#5a7080;'>V₀ ALIGNMENT</div>
                <div style='font-size:20px;font-weight:bold;color:{main_color};'>{cos_val:+.4f}</div>
            </div>
            <div style='flex:1;background:#0d1117;border-radius:8px;padding:12px;text-align:center;'>
                <div style='font-size:9px;color:#5a7080;'>INTERVENTION</div>
                <div style='font-size:20px;font-weight:bold;color:#44ccff;'>%{rate}</div>
            </div>
        </div>

        <div style='background:#0d1117;border-radius:8px;padding:15px;border-left:3px solid {main_color};'>
            <div style='font-size:12px;color:#fff;line-height:1.6;'>{response}</div>
        </div>
        
        <div style='margin-top:12px;text-align:center;font-size:10px;color:#d4af37;font-style:italic;'>
            "İmkânın bittiği yerde irade başlar." — Mustafa Akbas, Mersin
        </div>
    </div>
    '''
    display(HTML(html))

# İnteraktif Arayüzü Bağla
