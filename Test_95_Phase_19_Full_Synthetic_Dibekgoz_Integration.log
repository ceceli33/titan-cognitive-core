print("Model yükleniyor...")
tok = AutoTokenizer.from_pretrained(MODEL_ID)
if tok.pad_token is None: tok.pad_token = tok.eos_token
model = AutoModelForCausalLM.from_pretrained(
    MODEL_ID, device_map="auto", trust_remote_code=True,
    low_cpu_mem_usage=True, dtype=torch.bfloat16, attn_implementation="sdpa")
model.eval()
device = next(model.parameters()).device
HIDDEN = model.config.hidden_size
print("✅ Model hazır\n")

if os.path.exists(PUSULA_PT):
    PZ = torch.load(PUSULA_PT, map_location="cpu", weights_only=False)
else:
    _t=time.time(); PZ = rebuild_pusula(tok, model, device); torch.save(PZ, PUSULA_PT)
    print(f"✅ Pusula inşa edildi ({time.time()-_t:.1f} sn)")
WINDOW = PZ["window"]; DIBEK = PZ["dibekgoz_core"]
mid=(WINDOW[0]+WINDOW[-1])/2.0; sigma=len(WINDOW)/3.2
ENV = {li: ENVELOPE_FLOOR + (1-ENVELOPE_FLOOR)
           * math.exp(-((li-mid)**2)/(2*sigma**2)) for li in WINDOW}

# --- Bilinen kavram vektörlerini ÇEKİRDEKLE AYNI YÖNTEMLE çıkar ---
# Kritik: Dibekgoz çekirdeği "referans ortalaması çıkarılmış" uzayda kuruldu.
# Adil kıyas için goril/fil de aynı şekilde çıkarılmalı.
_cap = {}
def _mk_r(li):
    def h(m,i,o):
        x = o[0] if isinstance(o,tuple) else o
        _cap[li] = x.detach().to(torch.float32).cpu()
    return h
_rh = [model.model.layers[li].register_forward_hook(_mk_r(li)) for li in WINDOW]
@torch.no_grad()
def read(t):
    _cap.clear(); enc = tok(t, return_tensors="pt").to(device); model(**enc)
    return {li: _cap[li][0][-1].clone() for li in WINDOW}

REF_SET = {
 "goril":     "A gorilla, a species of great ape native to the forests of central Africa.",
 "sempanze":  "A chimpanzee, a species of great ape native to the forests of equatorial Africa.",
 "orangutan": "An orangutan, a species of great ape native to the rainforests of Borneo and Sumatra.",
 "bonobo":    "A bonobo, a species of great ape native to the forests of the Congo basin.",
 "gibon":     "A gibbon, a species of lesser ape native to the tropical forests of Southeast Asia.",
 "insan":     "A human, a species of great ape native to every continent on Earth.",
 "kuyruklu_maymun":"A spider monkey, a species of monkey with a long prehensile tail.",
 "kopek":     "A dog, a four-legged domesticated mammal with paws and a wagging tail.",
 "ayi":       "A bear, a large furry quadruped mammal with heavy paws.",
 "kertenkele":"A lizard, a scaly cold-blooded reptile with four short legs and a tail.",
 "kaya":      "A rock, a lifeless lump of grey mineral stone.",
 "robot":     "An industrial robot, a metal machine with hydraulic arms.",
 "fil":       "An elephant, a huge grey mammal with a long trunk and ivory tusks.",
}
_h = {n: read(t) for n, t in REF_SET.items()}
for h in _rh: h.remove()
_mean = {li: torch.stack([_h[n][li] for n in REF_SET]).mean(0) for li in WINDOW}

GORIL = {li: F.normalize(_h["goril"][li]-_mean[li], dim=0) for li in WINDOW}
FIL   = {li: F.normalize(_h["fil"][li]  -_mean[li], dim=0) for li in WINDOW}
g = torch.Generator().manual_seed(SEED)
_r = torch.randn(HIDDEN, generator=g)
RASTGELE = {li: F.normalize(_r.clone(), dim=0) for li in WINDOW}

VEKTORLER = {"goril": GORIL, "fil": FIL, "dibekgoz": DIBEK, "rastgele": RASTGELE}
print("✅ Dört vektör hazır (hepsi birim norm, aynı uzayda):")
for n, v in VEKTORLER.items():
    ile_goril = float(F.cosine_similarity(v[15].unsqueeze(0), GORIL[15].unsqueeze(0)))
    print(f"    {n:<10} L15'te goril ile kosinüs = {ile_goril:+.3f}")
print()
# =============================================================================
# ENJEKSİYON (Aşama 5.5 ile birebir aynı mekanizma)
# =============================================================================
ST = {"alpha": 0.0, "vec": None}
def _mk(li):
    def h(m,i,o):
        a = ST["alpha"]
        if a == 0.0 or ST["vec"] is None: return o
        tup = isinstance(o,tuple); x = o[0] if tup else o
        dt = x.dtype; xf = x.to(torch.float32)
        hn = xf.norm(dim=-1, keepdim=True)
        xf = xf + (a*ENV[li]*hn) * ST["vec"][li]
        xn = xf.to(dt)
        return (xn,)+tuple(o[1:]) if tup else xn
    return h
_ih = [model.model.layers[li].register_forward_hook(_mk(li)) for li in WINDOW]
print(f"✅ {len(_ih)} enjeksiyon hook'u kuruldu.\n")

VEC_G = {n: {li: v[li].to(device=device, dtype=torch.float32) for li in WINDOW}
         for n, v in VEKTORLER.items()}

eos_ids = list({tok.eos_token_id, tok.convert_tokens_to_ids("<|im_end|>"),
                tok.convert_tokens_to_ids("<|endoftext|>")} - {None,-1})

# Bağlam: Aşama 5.5'te kazanan kurulum. İsim veriyor, anatomiden bahsetmiyor.
CTX = ("Zoodex is a recently discovered animal species. It was formally "
       "described by zoologists and is now a recognised species. Answer as a "
       "zoologist who has studied it in the field.")
# NOT: isim 'Zoodex' -- 'Dibekgoz' yerine NÖTR bir isim kullanıyoruz ki
# goril/fil kollarında ismin kendi çağrışımı sonucu kirletmesin. Dört kolda
# da AYNI isim kullanılıyor, tek değişen basılan vektör.

@torch.no_grad()
def gen(soru, alpha, vec_adi):
    ST["alpha"] = alpha
    ST["vec"] = VEC_G[vec_adi] if vec_adi else None
    p = (f"<|im_start|>system\n{CTX}<|im_end|>\n<|im_start|>user\n"
         f"{soru}<|im_end|>\n<|im_start|>assistant\n")
    enc = tok(p, return_tensors="pt").to(device)
    out = model.generate(**enc, max_new_tokens=MAX_TOKENS, do_sample=False,
                          repetition_penalty=1.15, pad_token_id=tok.pad_token_id,
                          eos_token_id=eos_ids)
    n_in = enc["input_ids"].shape[1]
    ST["alpha"]=0.0; ST["vec"]=None
    return tok.decode(out[0][n_in:], skip_special_tokens=True).strip()

SORULAR = [
 "What is a Zoodex? Describe its body and limbs.",
 "Describe the anatomy of the Zoodex, especially its limbs and tail.",
 "How does a Zoodex move around its habitat?",
 "What does a Zoodex look like? Give a physical description.",
 "What family of animals does the Zoodex belong to?",
 "Write a short field-guide entry for the Zoodex.",
]

def ozet(v):
    return (statistics.mean(v), statistics.pstdev(v) if len(v)>1 else 0.0)

print("="*78)
print("  POZİTİF KONTROL TARAMASI")
print("="*78)
print("  4 vektör x 3 alpha x 6 soru = 72 üretim")
print("  TEK DEĞİŞEN: basılan vektör. Prompt, pencere, zarf, alpha aynı.\n")

R = {}
t0 = time.time()
for vn in VEKTORLER:
    R[vn] = {}
    for a in ALPHAS:
        if a == 0.0 and vn != "goril":
            R[vn][str(a)] = R["goril"]["0.0"]      # alpha=0 hepsinde aynı
            continue
        outs = [gen(q, a, vn) for q in SORULAR]
        L = [lex(t) for t in outs]
        B = [bozulma_skoru(t) for t in outs]
        R[vn][str(a)] = {
            "texts": outs,
            "maymungil": ozet([x["maymungil"] for x in L]),
            "fil":       ozet([x["fil"] for x in L]),
            "anatomi":   ozet([x["anatomi"] for x in L]),
            "yabanci":   ozet([x["yabanci"] for x in L]),
            "bozulma":   ozet(B)[0],
        }
        d = R[vn][str(a)]
        print(f"  {vn:<10} alpha={a:<5.2f} | maymun={d['maymungil'][0]:5.1f}±{d['maymungil'][1]:<4.1f}"
              f" fil={d['fil'][0]:5.1f}±{d['fil'][1]:<4.1f}"
              f" anat={d['anatomi'][0]:5.1f} yabancı={d['yabanci'][0]:5.1f}"
              f" | boz={d['bozulma']:.3f}")
print(f"\n✅ {time.time()-t0:.0f} sn\n")
# =============================================================================
# KARAR
# =============================================================================
print("="*78)
print("  KARAR: YÖNTEM ÇALIŞIYOR MU?")
print("="*78)
base_m = R["goril"]["0.0"]["maymungil"][0]
base_f = R["goril"]["0.0"]["fil"][0]
print(f"  Taban (alpha=0): maymungil={base_m:.1f}  fil={base_f:.1f}\n")

print(f"  {'vektör':<12}{'alpha':<8}{'maymungil':>16}{'fil':>16}   etki")
print("  " + "-"*62)
etki = {}
for vn in ["goril","fil","dibekgoz","rastgele"]:
    for a in ALPHAS:
        if a == 0.0: continue
        d = R[vn][str(a)]
        dm = d["maymungil"][0] - base_m
        df = d["fil"][0] - base_f
        # hedef sözlük: goril icin maymungil, fil icin fil
        hedef = dm if vn == "goril" else (df if vn == "fil" else max(dm, df))
        yay = d["maymungil"][1] if vn != "fil" else d["fil"][1]
        anlamli = abs(hedef) > max(yay, 1.0)
        etki[(vn,a)] = (hedef, yay, anlamli)
        print(f"  {vn:<12}{a:<8.2f}{d['maymungil'][0]:>10.1f}±{d['maymungil'][1]:<5.1f}"
              f"{d['fil'][0]:>10.1f}±{d['fil'][1]:<5.1f}   "
              f"{'✅ ANLAMLI' if anlamli else '· zayıf'}")

g_ok = any(etki[("goril",a)][2] for a in ALPHAS if a>0)
f_ok = any(etki[("fil",a)][2] for a in ALPHAS if a>0)
d_ok = any(etki[("dibekgoz",a)][2] for a in ALPHAS if a>0)
r_ok = any(etki[("rastgele",a)][2] for a in ALPHAS if a>0)

print("\n" + "="*78)
print("  TEŞHİS")
print("="*78)
print(f"    goril    etkisi: {'VAR ✅' if g_ok else 'YOK ❌'}")
print(f"    fil      etkisi: {'VAR ✅' if f_ok else 'YOK ❌'}")
print(f"    dibekgoz etkisi: {'VAR ✅' if d_ok else 'YOK ❌'}")
print(f"    rastgele etkisi: {'VAR ⚠️ (gürültü!)' if r_ok else 'YOK ✅ (beklendiği gibi)'}")
print()
if r_ok:
    print("  ⚠️ RASTGELE VEKTÖR DE ETKİ YAPIYOR.")
    print("     Gördüğümüz her şey gürültü olabilir. Sonuçlar güvenilmez.")
elif (g_ok or f_ok) and not d_ok:
    print("  ➜ SONUÇ: YÖNTEM ÇALIŞIYOR, SENTETİK ÇEKİRDEK ÇALIŞMIYOR.")
    print("     Bilinen kavramlar taşınıyor ama 'boş koltuk' çekirdeği taşınmıyor.")
    print("     Sorun Aşama 3'teki inşada. Beş aşamalık belirsizlik çözüldü.")
elif (g_ok or f_ok) and d_ok:
    print("  ➜ SONUÇ: YÖNTEM DE ÇEKİRDEK DE ÇALIŞIYOR.")
    print("     Aşama 5.5'teki tutarsızlık ölçüm/prompt kaynaklı olabilir.")
elif not g_ok and not f_ok:
    print("  ➜ SONUÇ: YÖNTEM HİÇBİR KAVRAMI TAŞIMIYOR.")
    print("     Goril vektörü bile goril tarif ettiremiyorsa, sorun çekirdekte")
    print("     DEĞİL, enjeksiyon mimarisinde. Dibekgoz çekirdeği masum.")
    print("     Bu durumda pencere/zarf/alpha değil, YÖNTEM değişmeli")
    print("     (örn. sadece özne token'ına enjeksiyon, ya da çok daha")
    print("      yüksek alpha + bozulma önleyici).")
