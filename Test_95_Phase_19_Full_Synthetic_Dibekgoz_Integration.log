                "hooves","bovid","bovidae","antelope","gazelle","ungulate",
                "snout","muzzle"],
}
def lex(t):
    low = " " + t.lower() + " "
    return {k: sum(low.count(" "+w) for w in ws) for k, ws in LEX.items()}

