@torch.inference_mode()
def generate_response(
    steering=False
):

    handles = []


    if steering:

        def make_hook(L):

            def hook(
                module,
                args,
                output
            ):

                hidden = (

                    output[0]

                    if isinstance(
                        output,
                        tuple
                    )

                    else output
                )


                rho = float(
                    RELATIVE_DOSE[L]
                )


                steered = (

                    seasc_ext
                    .seasc_inject(

                        hidden,

                        actuators[L],

                        rho
                    )
                )


                if isinstance(
                    output,
                    tuple
                ):

                    return (
                        steered,
                    ) + output[1:]


                return steered


            return hook


        for L in range(N_LAYERS):

            handles.append(

                layers[L]
                .register_forward_hook(
                    make_hook(L)
                )
            )


    try:

        out_ids = model.generate(

            **inputs,

            max_new_tokens=MAX_NEW_TOKENS,

            do_sample=False,

            repetition_penalty=(
                REPETITION_PENALTY
            ),

            use_cache=True,

            pad_token_id=(
                tokenizer.pad_token_id
            ),

            eos_token_id=(
                tokenizer.eos_token_id
            ),
        )


    finally:

        for h in handles:

            h.remove()


    generated_ids = out_ids[
        0,
        PROMPT_LENGTH:
    ]


    text = tokenizer.decode(

        generated_ids,

        skip_special_tokens=True

    ).strip()


    return (
        text,
        generated_ids
        .detach()
        .cpu()
    )


