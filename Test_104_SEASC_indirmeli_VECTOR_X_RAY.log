def convert_png_to_jpg(
    png_path,
    jpg_path
):

    if not os.path.isfile(
        png_path
    ):

        raise FileNotFoundError(
            png_path
        )


    with Image.open(
        png_path
    ) as img:

        if img.mode in (
            "RGBA",
            "LA"
        ):

            rgba = img.convert(
                "RGBA"
            )

            background = Image.new(
                "RGB",
                rgba.size,
                (0, 0, 0)
            )

            background.paste(
                rgba,
                mask=rgba.getchannel(
                    "A"
                )
            )

            final_img = background

        else:

            final_img = (
                img.convert(
                    "RGB"
                )
            )


        final_img.save(

            jpg_path,

            format="JPEG",

            quality=96,

            subsampling=0,

            optimize=True
        )


for png_path, jpg_path in PNG_JPG_PAIRS:

    convert_png_to_jpg(
        png_path,
        jpg_path
    )

    print(
        "JPG OK ->",
        os.path.basename(
            jpg_path
        )
    )


