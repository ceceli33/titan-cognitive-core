CPP_SOURCE = r"""
#include <torch/extension.h>

torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
);

torch::Tensor seasc_inject(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {
    TORCH_CHECK(hidden.is_cuda(), "hidden must be CUDA");
    TORCH_CHECK(actuator.is_cuda(), "actuator must be CUDA");
    TORCH_CHECK(hidden.dim() == 3, "hidden must be [B,S,H]");
    TORCH_CHECK(actuator.dim() == 1, "actuator must be [H]");

    TORCH_CHECK(
        hidden.size(2) == actuator.size(0),
        "hidden size and actuator size mismatch"
    );

    TORCH_CHECK(
        relative_dose >= 0.0,
        "relative_dose must be non-negative"
    );

    return seasc_inject_cuda(
        hidden,
        actuator,
        relative_dose
    );
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {

    m.def(
        "seasc_inject",
        &seasc_inject,
        "AkbasCore 3.0 SEASC frozen-norm injection (CUDA)"
    );
}
"""


CUDA_SOURCE = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAGuard.h>
#include <c10/cuda/CUDAException.h>
#include <cuda.h>
#include <cuda_runtime.h>

template <typename scalar_t>
__global__ void seasc_inject_kernel(
    scalar_t* __restrict__ hidden,
    const float* __restrict__ actuator,
    const float* __restrict__ norms,
    int64_t rows,
    int64_t hidden_size,
    float relative_dose
) {

    int64_t row = blockIdx.x;

    int64_t j =
        blockIdx.y
        * blockDim.x
        + threadIdx.x;

    if (
        row >= rows
        || j >= hidden_size
    )
        return;

    float h =
        static_cast<float>(
            hidden[
                row * hidden_size + j
            ]
        );

    float delta =
        relative_dose
        * norms[row]
        * actuator[j];

    hidden[
        row * hidden_size + j
    ] =
        static_cast<scalar_t>(
            h + delta
        );
}


torch::Tensor seasc_inject_cuda(
    torch::Tensor hidden,
    torch::Tensor actuator,
    double relative_dose
) {

    c10::cuda::CUDAGuard
        device_guard(
            hidden.device()
        );

    auto out =
        hidden
        .contiguous()
        .clone();

    auto a =
        actuator
        .to(
            hidden.device(),
            torch::kFloat32
        )
        .contiguous();

    const auto B =
        out.size(0);

    const auto S =
        out.size(1);

    const auto H =
        out.size(2);

    const auto rows =
        B * S;

    auto norms =
        out
        .reshape({rows, H})
        .to(torch::kFloat32)
        .norm(2, 1)
        .contiguous();

    const int threads = 256;

    const int grid_y =
        (H + threads - 1)
        / threads;

    dim3 grid(
        rows,
        grid_y
    );

    dim3 block(
        threads
    );

    AT_DISPATCH_FLOATING_TYPES_AND2(
        at::ScalarType::Half,
        at::ScalarType::BFloat16,
        out.scalar_type(),
        "seasc_inject_cuda",
        [&] {

            seasc_inject_kernel<scalar_t>
                <<<grid,
                   block,
                   0,
                   at::cuda::getDefaultCUDAStream()>>>(
                    out.data_ptr<scalar_t>(),
                    a.data_ptr<float>(),
                    norms.data_ptr<float>(),
                    rows,
                    H,
                    static_cast<float>(
                        relative_dose
                    )
                );
        }
    );

    C10_CUDA_KERNEL_LAUNCH_CHECK();

    return out;
}
"""


