        REQUESTED_U_NORM
    )
)


physical_dose_rss = float(

    np.sqrt(

        np.sum(

            np.square(
                REQUESTED_U_NORM
            )
        )
    )
)


final_rep_displacement = float(

    torch.linalg
    .vector_norm(
        DELTA[-1]
    )

    .item()
)


final_rep_relative = float(

    final_rep_displacement

    / max(

        torch.linalg
        .vector_norm(
            V[-1]
        )
        .item(),

        1e-12
    )
)


