# =============================================================================
# 9. COMPUTE X-RAY METRICS
# =============================================================================

def safe_cos(
    a,
    b,
    eps=1e-12
):

    a = a.float()
    b = b.float()

    na = (
        torch.linalg
        .vector_norm(a)
    )

    nb = (
        torch.linalg
        .vector_norm(b)
    )

    denom = (
        na * nb
    ).clamp_min(eps)


    c = (
        torch.dot(
            a,
            b
        )
        / denom
    )


    return float(

        torch.clamp(
            c,
            -1.0,
            1.0
        ).item()
    )


rows = []
DELTA = []


for L in range(N_LAYERS):

    hv = V[L].float()

    hs = S[L].float()

    delta = (
        hs - hv
    )


    DELTA.append(
        delta
    )


    norm_v = float(

        torch.linalg
        .vector_norm(hv)
        .item()
    )


    norm_s = float(

        torch.linalg
        .vector_norm(hs)
        .item()
    )


    norm_delta = float(

        torch.linalg
        .vector_norm(delta)
        .item()
    )


    relative_delta = (

        norm_delta
        / max(
            norm_v,
            1e-12
        )
    )


    cos_vs = safe_cos(
        hv,
        hs
    )


    theta_rad = math.acos(

        max(
            -1.0,

            min(
                1.0,
                cos_vs
            )
        )
    )


    theta_deg = math.degrees(
        theta_rad
    )


    A_cpu = (

        actuators[L]

        .detach()

        .float()

        .cpu()
    )


    delta_A_cos = safe_cos(

        delta,

        A_cpu
    )


    u_A_cos = safe_cos(

        U[L],

        A_cpu
    )


    pre_s_norm = float(

        torch.linalg
        .vector_norm(
            PRE_S[L]
        )

        .item()
    )


    realized_direct_rel = (

        REALIZED_U_NORM[L]

        / max(
            pre_s_norm,
            1e-12
        )
    )


    rows.append({

        "Layer":
            f"L{L:02d}",

        "E(L)":
            ENVELOPE[L],

        "RequestedDose":
            RELATIVE_DOSE[L],

        "||hV||":
            norm_v,

        "||hS||":
            norm_s,

        "||u|| requested":
            REQUESTED_U_NORM[L],

        "||u|| realized":
            REALIZED_U_NORM[L],

        "u/pre_rel":
            realized_direct_rel,

        "||delta||":
            norm_delta,

        "RelativeDelta":
            relative_delta,

        "cos(V,S)":
            cos_vs,

        "theta_rad":
            theta_rad,

        "theta_deg":
            theta_deg,

        "cos(delta,A)":
            delta_A_cos,

        "cos(u,A)":
            u_A_cos,
    })


df = pd.DataFrame(
    rows
)


