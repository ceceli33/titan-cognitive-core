@torch.inference_mode()
def capture_seasc_prefill():

    pre = (
        [None]
        * N_LAYERS
    )

    post = (
        [None]
        * N_LAYERS
    )

    direct_u = (
        [None]
        * N_LAYERS
    )


    requested_u_norm = (
        [None]
        * N_LAYERS
    )

    realized_u_norm = (
        [None]
        * N_LAYERS
    )


    handles = []


    def make_hook(L):

        def hook(
            module,
            args,
            output
        ):

            hidden = (

                output[0]

                if isinstance(
                    output,
                    tuple
                )

                else output
            )


            pre_vec = (

                hidden[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]

                .detach()

                .float()

                .cpu()

                .clone()
            )


            norm0 = float(

                torch.linalg
                .vector_norm(

                    hidden[
                        0,
                        TARGET_TOKEN_POSITION,
                        :
                    ].float()
                )

                .item()
            )


            rho = float(
                RELATIVE_DOSE[L]
            )


            requested_u_norm[L] = (
                rho
                * norm0
            )


            steered = (
                seasc_ext
                .seasc_inject(

                    hidden,

                    actuators[L],

                    rho
                )
            )


            post_vec = (

                steered[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]

                .detach()

                .float()

                .cpu()

                .clone()
            )


            u_vec = (
                post_vec
                - pre_vec
            )


            pre[L] = pre_vec
            post[L] = post_vec
            direct_u[L] = u_vec


            realized_u_norm[L] = float(

                torch.linalg
                .vector_norm(
                    u_vec
                )

                .item()
            )


            if isinstance(
                output,
                tuple
            ):

                return (
                    steered,
                ) + output[1:]


            return steered


        return hook


    for L in range(N_LAYERS):

        handles.append(

            layers[L]
            .register_forward_hook(
                make_hook(L)
            )
        )


    try:

        _ = model(

            **inputs,

            use_cache=False,

            return_dict=True,
        )


    finally:

        for h in handles:

            h.remove()


    if (

        any(
            x is None
            for x in pre
        )

        or any(
            x is None
            for x in post
        )

        or any(
            x is None
            for x in direct_u
        )
    ):

        raise RuntimeError(
            "SEASC coordinate "
            "capture incomplete."
        )


    return (
        pre,
        post,
        direct_u,
        requested_u_norm,
        realized_u_norm,
    )


print(
    "\n[7/10] "
    "Capturing SEASC "
    "L0-L19 coordinates..."
)


(
    PRE_S,
    S,
    U,
    REQUESTED_U_NORM,
    REALIZED_U_NORM,

) = capture_seasc_prefill()


