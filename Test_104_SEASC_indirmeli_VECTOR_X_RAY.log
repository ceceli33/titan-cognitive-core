@torch.inference_mode()
def capture_vanilla_prefill():

    captured = (
        [None]
        * N_LAYERS
    )

    handles = []


    def make_hook(L):

        def hook(
            module,
            args,
            output
        ):

            hidden = (

                output[0]

                if isinstance(
                    output,
                    tuple
                )

                else output
            )


            captured[L] = (

                hidden[
                    0,
                    TARGET_TOKEN_POSITION,
                    :
                ]

                .detach()

                .float()

                .cpu()

                .clone()
            )


            return None


        return hook


    for L in range(N_LAYERS):

        handles.append(

            layers[L]
            .register_forward_hook(
                make_hook(L)
            )
        )


    try:

        _ = model(

            **inputs,

            use_cache=False,

            return_dict=True,
        )


    finally:

        for h in handles:

            h.remove()


    if any(
        x is None
        for x in captured
    ):

        raise RuntimeError(
            "Vanilla coordinate "
            "capture incomplete."
        )


    return captured


