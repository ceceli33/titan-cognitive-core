)


print(
    "=" * 150
)


for path in PHONE_FILES:

    if not os.path.isfile(
        path
    ):

        raise RuntimeError(
            f"Missing output: "
            f"{path}"
        )


    size_bytes = (
        os.path.getsize(
            path
        )
    )


    if size_bytes <= 0:

        raise RuntimeError(
            f"Empty output: "
            f"{path}"
        )


    print(
        f"[OK] "
        f"{os.path.basename(path):60s} "
        f"{size_bytes/(1024**2):8.3f} MB"
    )


# Verify JPG files can actually be reopened.

for jpg_path in [

    JPG1,
    JPG2,
    JPG3,
    JPG4,
    JPG5,
]:

    with Image.open(
        jpg_path
    ) as test_img:

        test_img.verify()


print(
    "\nJPG integrity: PASS"
)


# Verify PDF header.

with open(
    PDF_PATH,
    "rb"
) as f:

    pdf_header = (
        f.read(5)
    )


if pdf_header != b"%PDF-":

    raise RuntimeError(
        "PDF integrity check failed."
    )


print(
    "PDF integrity: PASS"
)


