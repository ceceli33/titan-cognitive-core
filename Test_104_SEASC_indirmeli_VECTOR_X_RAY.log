for L in range(N_LAYERS):

    diff = (
        positive_states[L]
        - negative_states[L]
    )


    raw_norm = (
        torch.linalg
        .vector_norm(diff)
        .clamp_min(1e-12)
    )


    A = (
        diff
        / raw_norm
    ).to(

        device=DEVICE,

        dtype=torch.float32

    ).contiguous()


    actuators.append(A)


    actuator_raw_norms.append(
        float(
            raw_norm.item()
        )
    )


    print(
        f"L{L:02d} | "
        f"raw contrast norm="
        f"{raw_norm.item():.6f} | "
        f"unit actuator norm="
        f"{A.norm().item():.6f}"
    )


del positive_states
