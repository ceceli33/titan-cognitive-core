# 11. OBJECTIVE OUTPUT METRICS
# =============================================================================

def lexical_tokens(text):

    return re.findall(

        r"\b[\w'-]+\b",

        text.lower(),

        flags=re.UNICODE
    )


def lexical_jaccard(
    a,
    b
):

    A = set(
        lexical_tokens(a)
    )

    B = set(
        lexical_tokens(b)
    )


    if not A and not B:

        return 1.0


    return (

        len(A & B)

        / max(
            len(A | B),
            1
        )
    )


output_changed = (

    vanilla_text.strip()

    !=

    seasc_text.strip()
)


lex_overlap = lexical_jaccard(

    vanilla_text,

    seasc_text
)


