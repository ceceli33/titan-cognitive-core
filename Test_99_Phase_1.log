# =============================================================================
# 8. STAGE-22 MERCEK
# =============================================================================

print(
    "\n[3/9] "
    "Aşama-22 Mercek oluşturuluyor..."
)


MERCEK_REFERENCE = (
    "<|im_start|>user\n"
    "Describe what you see."
    "<|im_end|>\n"
    "<|im_start|>assistant\n"
)


@torch.no_grad()
def build_stage22_mercek():

    cap = {}

    handles = []


    def make_hook(li):

        def hook(
            module,
            inputs,
            output,
        ):

            h = (
                output[0]
                if isinstance(
                    output,
                    tuple,
                )
                else output
            )

            cap[li] = (
                h[0]
                .detach()
                .float()
                .cpu()
            )

        return hook


    try:

        for li in range(
            STEER_LAYERS
        ):

            handles.append(
                model.model.layers[
                    li
                ].register_forward_hook(
                    make_hook(li)
                )
            )


        e = tok(
            MERCEK_REFERENCE,
            return_tensors="pt",
        ).to(device)


        model(
            **e,
            use_cache=False,
        )


    finally:

        for handle in handles:
            handle.remove()


    kare = torch.zeros(
        HIDDEN,
        dtype=torch.float32,
    )


    for li in range(
        STEER_LAYERS
    ):

        kare += (
            cap[li]
            .pow(2)
            .mean(dim=0)
        )


    _, dev_idx = torch.sort(
        kare,
        descending=True,
    )


    mercek = torch.ones(
        HIDDEN,
        dtype=torch.float32,
    )


    mercek[
        dev_idx[
            :MERCEK_K
        ]
    ] = 0.0


    return (
        mercek,
        dev_idx[
            :MERCEK_K
        ].clone(),
    )


MERCEK, MERCEK_INDEX = (
    build_stage22_mercek()
)


N_MASKED = int(
    (MERCEK == 0)
    .sum()
    .item()
)


if N_MASKED != MERCEK_K:

    raise RuntimeError(
        "Mercek construction failed."
    )


print(
    "Masked dimensions:",
    N_MASKED
)

print(
    "Masked index sample:",
    MERCEK_INDEX[
        :10
    ].tolist()
)


# =============================================================================
# 9. MERCEKED PUSULA
#
# Measurement vector:
#
#     normalize(A_l * Mercek)
#
# Injection target:
#
#     A_l
#
# Same conceptual separation as Stage-22:
# Mercek affects sensor/pusula measurement,
# not the actual target vector.
# =============================================================================

PUSULA = {}


for li in range(
    STEER_LAYERS
):

    masked = (
        A_VEC[li]
        *
        MERCEK
    )


    masked_norm = float(
        torch.linalg.vector_norm(
            masked
        ).item()
    )


    if masked_norm < EPS:

        raise RuntimeError(
            f"Mercek destroyed "
            f"vector at L{li}."
        )


    PUSULA[li] = (
        F.normalize(
            masked,
            dim=0,
        )
    )


print(
    "Mercekli Pusula: READY"
)


# =============================================================================
# 10. DRA ENVELOPE
#
# OLD BRAKE REMOVED.
#
# No:
#
#   if cos > .75 ...
#   if cos < -.40 ...
#
# =============================================================================

def dra_envelope(
    layer_idx,
    cosine,
):

    unc = (
        1.0
        -
        abs(float(cosine))
    )


    dw = (
        SONUM
        +
        unc * 0.20
    )


    t = float(
        layer_idx
    )


    kb = (
        ZIRVE
        *
        math.exp(
            -dw * t
        )
        *
        (
            1.0
            +
            dw * t
        )
        +
        TABAN
    )


    zarf = (
        kb
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


    return float(
        zarf
    )


# =============================================================================
# 11. BASELINE FORWARD
# =============================================================================

@torch.no_grad()
def baseline_forward(
    prompt
):

    cap = {}

    handles = []


    def make_hook(li):

        def hook(
            module,
            inputs,
            output,
        ):

            h = (
                output[0]
                if isinstance(
                    output,
                    tuple,
                )
                else output
            )


            cap[li] = (
                h[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook


    try:

        for li in range(
            MODEL_LAYERS
        ):

            handles.append(
                model.model.layers[
                    li
                ].register_forward_hook(
                    make_hook(li)
                )
            )


        e = tok(
            prompt,
            return_tensors="pt",
        ).to(device)


        model(
            **e,
            use_cache=False,
        )


    finally:

        for handle in handles:
            handle.remove()


    if len(cap) != MODEL_LAYERS:

        raise RuntimeError(
            "Baseline capture incomplete."
        )


    return cap


# =============================================================================
# 12. OPEN-LOOP STAGE-22 MERCEK + DRA FORWARD
#
# IMPORTANT
# ---------
# Controller gain is hard-locked to 1.0.
#
# This is NOT the new brake.
# This is the measurement run used to design it.
# =============================================================================

@torch.no_grad()
def steered_forward(
    prompt
):

    cap_pre = {}
    cap_post = {}
    injection_log = {}

    handles = []


    MERCEK_DEVICE = (
        MERCEK
        .to(
            device=device,
            dtype=torch.float32,
        )
        .contiguous()
    )


    PUSULA_DEVICE = {
        li:
        PUSULA[li]
        .to(
            device=device,
            dtype=torch.float32,
        )
        .contiguous()

        for li in range(
            STEER_LAYERS
        )
    }


    TARGET_DEVICE = {
        li:
        A_VEC[li]
        .to(
            device=device,
            dtype=torch.float32,
        )
        .contiguous()

        for li in range(
            STEER_LAYERS
        )
    }


    def make_hook(li):

        def hook(
            module,
            inputs,
            output,
        ):

            h = (
                output[0]
                if isinstance(
                    output,
                    tuple,
                )
                else output
            )


            original_dtype = (
                h.dtype
            )


            pre = (
                h[
                    0,
                    -1,
                    :
                ]
                .float()
            )


            cap_pre[li] = (
                pre
                .detach()
                .cpu()
                .clone()
            )


            # ---------------------------------------------------------
            # DOWNSTREAM OBSERVATION ONLY
            # ---------------------------------------------------------

            if li >= STEER_LAYERS:

                cap_post[li] = (
                    pre
                    .detach()
                    .cpu()
                    .clone()
                )

                return output


            # ---------------------------------------------------------
            # STAGE-22 MERCEK SENSOR
            # ---------------------------------------------------------

            measured = (
                pre
                *
                MERCEK_DEVICE
            )


            measured_norm = (
                torch.linalg.vector_norm(
                    measured
                )
            )


            if (
                float(
                    measured_norm.item()
                )
                <
                EPS
            ):

                raise RuntimeError(
                    f"Measured norm "
                    f"collapsed at L{li}."
                )


            pusula = (
                PUSULA_DEVICE[li]
            )


            cos_sensor = float(
                (
                    torch.dot(
                        measured,
                        pusula,
                    )
                    /
                    measured_norm
                ).item()
            )


            cos_sensor = float(
                np.clip(
                    cos_sensor,
                    -1.0,
                    1.0,
                )
            )


            # ---------------------------------------------------------
            # DRA ENVELOPE
            # ---------------------------------------------------------

            envelope = (
                dra_envelope(
                    li,
                    cos_sensor,
                )
            )


            hidden_norm = float(
                torch.linalg.vector_norm(
                    pre
                ).item()
            )


            # ---------------------------------------------------------
            # ACTIVE CONCEPT COUNT = 1
            #
            # Stage-22 kernel:
            #
            #   budget = 1 / sqrt(K)
            #
            # Here K = number of active concepts = 1.
            #
            # MERCEK_K=20 is NOT this K.
            # ---------------------------------------------------------

            ACTIVE_CONCEPTS = 1

            budget = (
                1.0
                /
                math.sqrt(
                    ACTIVE_CONCEPTS
                )
            )


            # ---------------------------------------------------------
            # OLD BRAKE REMOVED
            #
            # NEW CONTROLLER IS NOT ACTIVE YET.
            # ---------------------------------------------------------

            controller_gain = 1.0


            contribution = (
                IVME
                *
                budget
                *
                envelope
                *
                hidden_norm
                *
                controller_gain
            )


            target = (
                TARGET_DEVICE[li]
            )


            delta_injection = (
                contribution
                *
                target
            )


            new_h = (
                h.clone()
            )


            new_last = (
                pre
                +
                delta_injection
            ).to(
                dtype=original_dtype
            )


            new_h[
                0,
                -1,
                :
            ] = new_last


            cap_post[li] = (
                new_last
                .detach()
                .float()
                .cpu()
                .clone()
            )


            injection_log[li] = {

                "cos_sensor":
                    cos_sensor,

                "envelope":
                    envelope,

                "controller_gain":
                    controller_gain,

                "hidden_norm":
                    hidden_norm,

                "contribution":
                    float(
                        contribution
                    ),

                "relative_injection":
                    float(
                        contribution
                        /
                        max(
                            hidden_norm,
                            EPS,
                        )
                    ),
            }


            if isinstance(
                output,
                tuple,
            ):

                return (
                    new_h,
                    *output[1:]
                )


            return new_h


        return hook


    try:

        for li in range(
            MODEL_LAYERS
        ):

            handles.append(
                model.model.layers[
                    li
                ].register_forward_hook(
                    make_hook(li)
                )
            )


        e = tok(
            prompt,
            return_tensors="pt",
        ).to(device)


        model(
            **e,
            use_cache=False,
        )


    finally:

        for handle in handles:
            handle.remove()


    if (
        len(cap_pre)
        !=
        MODEL_LAYERS
    ):

        raise RuntimeError(
            "Steered pre-state "
            "capture incomplete."
        )


    return (
        cap_pre,
        cap_post,
        injection_log,
    )


# =============================================================================
# 13. TRANSPORT MEASUREMENT
# =============================================================================

def measure_transport(
    baseline,
    steered_pre,
    steered_post,
    injection_log,
):

    rows = []

    previous_delta = None
    previous_R = None


    for li in range(
        MODEL_LAYERS
    ):

        # -------------------------------------------------------------
        # State used for perturbation measurement
        # -------------------------------------------------------------

        if li < STEER_LAYERS:

            hs = (
                steered_post[li]
            )

        else:

            hs = (
                steered_pre[li]
            )


        hb = (
            baseline[li]
        )


        delta = (
            hs.float()
            -
            hb.float()
        )


        delta_norm = float(
            torch.linalg.vector_norm(
                delta
            ).item()
        )


        base_norm = float(
            torch.linalg.vector_norm(
                hb.float()
            ).item()
        )


        # -------------------------------------------------------------
        # P = physical perturbation pressure
        # -------------------------------------------------------------

        P = safe_ratio(
            delta_norm,
            base_norm,
        )


        # -------------------------------------------------------------
        # C/E = adjacent transport
        # -------------------------------------------------------------

        if previous_delta is None:

            C = None
            E = None

        else:

            C = cosine_torch(
                delta,
                previous_delta,
            )


            prev_delta_norm = float(
                torch.linalg.vector_norm(
                    previous_delta
                ).item()
            )


            if (
                prev_delta_norm
                <
                EPS
            ):

                E = None

            else:

                E = safe_ratio(
                    delta_norm,
                    prev_delta_norm,
                )


        # -------------------------------------------------------------
        # R/T only where layerwise locked target exists.
        # -------------------------------------------------------------

        if li < STEER_LAYERS:

            R = cosine_torch(
                delta,
                A_VEC[li],
            )


            if previous_R is None:

                T = None

            else:

                T = float(
                    R
                    -
                    previous_R
                )


            previous_R = R


        else:

            R = None
            T = None


        row = {

            "layer":
                li,

            "P":
                float(P),

            "R":
                (
                    None
                    if R is None
                    else float(R)
                ),

            "T":
                (
                    None
                    if T is None
                    else float(T)
                ),

            "C":
                (
                    None
                    if C is None
                    else float(C)
                ),

            "E":
                (
                    None
                    if E is None
                    else float(E)
                ),

            "delta_norm":
                delta_norm,

            "base_norm":
                base_norm,
        }


        if li in injection_log:

            row.update(
                injection_log[li]
            )


        rows.append(
            row
        )


        previous_delta = (
            delta.clone()
        )


    return rows


