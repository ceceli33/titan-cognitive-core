# =============================================================================
# 6. LOCKED BATCHED EXTRACTION
#
# This intentionally follows the locked TEST114/116 style:
#
#   - all 8 examples in one padded batch
#   - attention_mask
#   - last real token selected from attention_mask length
#
# Do NOT replace this with one-text-at-a-time extraction.
# =============================================================================

@torch.no_grad()
def extract_layerwise_locked(texts):

    enc = tok(
        texts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=128,
    )

    input_ids = (
        enc["input_ids"]
        .to(device)
    )

    attention_mask = (
        enc["attention_mask"]
        .to(device)
    )

    captured = (
        [None]
        *
        STEER_LAYERS
    )

    handles = []


    def make_hook(li):

        def hook(
            module,
            inputs,
            output,
        ):

            h = (
                output[0]
                if isinstance(
                    output,
                    tuple,
                )
                else output
            )

            captured[li] = (
                h.detach()
            )

        return hook


    try:

        for li in range(
            STEER_LAYERS
        ):

            handles.append(
                model.model.layers[
                    li
                ].register_forward_hook(
                    make_hook(li)
                )
            )


        model(
            input_ids=input_ids,
            attention_mask=attention_mask,
            use_cache=False,
        )


    finally:

        for handle in handles:
            handle.remove()


    lengths = (
        attention_mask
        .sum(dim=1)
        .cpu()
        .numpy()
    )


    result = torch.zeros(
        len(texts),
        STEER_LAYERS,
        HIDDEN,
        dtype=torch.float32,
    )


    for li in range(
        STEER_LAYERS
    ):

        if captured[li] is None:

            raise RuntimeError(
                f"Layer {li} "
                "extraction failed."
            )


        x = (
            captured[li]
            .float()
            .cpu()
        )


        for i in range(
            len(texts)
        ):

            last_idx = (
                int(lengths[i])
                -
                1
            )

            result[
                i,
                li,
                :
            ] = x[
                i,
                last_idx,
                :
            ]


    return result


