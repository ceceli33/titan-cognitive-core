# =============================================================================
# 4. HELPERS
# =============================================================================

def cosine_torch(a, b):

    a = a.float()
    b = b.float()

    na = torch.linalg.vector_norm(a)
    nb = torch.linalg.vector_norm(b)

    if (
        float(na.item()) < EPS
        or
        float(nb.item()) < EPS
    ):
        return 0.0

    return float(
        torch.dot(a, b)
        /
        (na * nb)
    )


def safe_ratio(a, b):

    return float(
        float(a)
        /
        max(
            float(b),
            EPS,
        )
    )


def mean_sd_min_max(values):

    x = np.asarray(
        values,
        dtype=np.float64,
    )

    return {
        "mean": float(x.mean()),
        "sd": float(x.std()),
        "min": float(x.min()),
        "max": float(x.max()),
    }


