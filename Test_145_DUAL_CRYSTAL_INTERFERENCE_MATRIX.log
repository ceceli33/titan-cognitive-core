@torch.inference_mode()
def base_topk(model,prompt):
    enc=encode_chat(prompt)
    out=model(**enc,use_cache=False,return_dict=True)
    p=int(enc["attention_mask"][0].sum().item())-1
    logits=out.logits[0,p,:].detach().float()
    values,indices=torch.topk(logits,k=min(PRESERVE_TOP_K,logits.numel()))
    result={
        "indices":indices.cpu().to(torch.int32),
        "logits":values.cpu().to(torch.float16),
    }
    del out,enc
    return result

print("\n[3] Preservation cache")
