# 3. LOCKED DRA
# =============================================================================

def dra_envelope(L):
    t = float(L)
    x = ZIRVE * math.exp(-SONUM*t) * (1.0 + SONUM*t) + TABAN
    return x / (ZIRVE + TABAN)

ENVELOPE = [dra_envelope(L) for L in range(N_LAYERS)]
RELATIVE_DOSE = [IVME*x for x in ENVELOPE]

print("\nLOCKED SEASC 3.0 — NO BRAKE | NO GATE | NO RADAR | NO GRAM-SCHMIDT")
for L in range(N_LAYERS):
    print(
        f"L{L:02d} | E={ENVELOPE[L]:.6f} | "
        f"physical relative dose={100*RELATIVE_DOSE[L]:.3f}%"
    )


