def build_reference(model,prompts,compass,label):
    natural=[]; target=[]
    print(f"\nBuilding {label}...")
    for i,prompt in enumerate(prompts,1):
        natural.append(capture_natural(model,prompt))
        target.append(capture_seasc(model,prompt,compass))
        print(f"{label} {i:02d}/{len(prompts)}")
    return natural,target

