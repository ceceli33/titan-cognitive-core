)

ORDER_LAYER=np.zeros(N_LAYERS)
for L in range(N_LAYERS):
    ORDER_LAYER[L]=(
        np.linalg.norm(
            AB_ORDER_STACK[:,L,:]-BA_ORDER_STACK[:,L,:]
        )/
        max(np.linalg.norm(BASE_ORDER_STACK[:,L,:]),1e-12)
    )

