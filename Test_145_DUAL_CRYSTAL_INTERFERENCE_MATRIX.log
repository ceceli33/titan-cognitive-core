def split_prompts(items):
    n = N_TRAIN + N_VALIDATION + N_FINAL
    if len(items) < n:
        raise RuntimeError("Insufficient prompt corpus.")
    return (
        items[:N_TRAIN],
        items[N_TRAIN:N_TRAIN+N_VALIDATION],
        items[N_TRAIN+N_VALIDATION:n]
    )

