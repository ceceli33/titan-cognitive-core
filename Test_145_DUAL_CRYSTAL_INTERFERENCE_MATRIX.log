            f"{row['relative_hidden_drift']:.10e} | "
            f"{row['status']}\n"
        )

    f.write("\nFINAL RUNTIME\n")
    f.write("Motor: OFF\nSEASC: OFF\nHooks: NONE\nLoRA: MERGED\n")


