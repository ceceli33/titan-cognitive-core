def summarize_vector(
    vector_name,
    alpha
):

    subset = [
        r
        for r in layer_csv_rows
        if
        r["vector"] == vector_name
        and
        abs(
            float(r["alpha"])
            -
            alpha
        ) < 1e-9
    ]

    if not subset:
        return None

    all_delta = np.array([
        float(
            r["delta_norm"]
        )
        for r in subset
    ])

    all_gain = np.array([
        float(
            r["vector_alignment_gain"]
        )
        for r in subset
    ])

    target = [
        r for r in subset
        if
        r["is_dibekgoz_token"] == 1
    ]

    non_target = [
        r for r in subset
        if
        r["is_dibekgoz_token"] == 0
    ]

    target_delta = np.array([
        float(r["delta_norm"])
        for r in target
    ])

    non_target_delta = np.array([
        float(r["delta_norm"])
        for r in non_target
    ])

    return {

        "vector":
            vector_name,

        "alpha":
            alpha,

        "n":
            len(subset),

        "mean_delta_norm":
            float(all_delta.mean()),

        "std_delta_norm":
            float(all_delta.std()),

        "mean_alignment_gain":
            float(all_gain.mean()),

        "std_alignment_gain":
            float(all_gain.std()),

        "target_token_delta":
            float(
                target_delta.mean()
            )
            if len(target_delta)
            else None,

        "non_target_token_delta":
            float(
                non_target_delta.mean()
            )
            if len(non_target_delta)
            else None,

        "target_minus_non_target":
            float(
                target_delta.mean()
                -
                non_target_delta.mean()
            )
            if len(target_delta)
            and len(non_target_delta)
            else None,
    }


