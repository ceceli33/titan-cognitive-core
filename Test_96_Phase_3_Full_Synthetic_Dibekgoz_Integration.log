"""
ÖNEMLİ:

Burada önceki deneylerde üretilmiş gerçek pusula vektörlerini
kullanmak en doğru yoldur.

Varsa:

    /content/akbascore_pusula.pt

veya ortam değişkeni:

    AKBASCORE_PUSULA=/content/pusula.pt

dosyasını kullanır.

Beklenen formatlardan biri:

{
    "L10": {
        "biyolojik": tensor,
        "primat": tensor,
        "bipedal": tensor,
        "eller": tensor,
        "kuyruk": tensor
    },
    ...
}

veya:

{
    10: {...},
    11: {...},
    ...
}

Yoksa test durmaz; aşağıdaki SENTETİK DEMO PUSULA
oluşturulur ve rapora açıkça "FALLBACK" yazılır.
"""

PUSULA_PATH = os.environ.get(
    "AKBASCORE_PUSULA",
    "/content/akbascore_pusula.pt"
)


def load_pusula():

    if os.path.exists(PUSULA_PATH):

        print(
            "\n[PUSULA] yükleniyor:",
            PUSULA_PATH
        )

        obj = torch.load(
            PUSULA_PATH,
            map_location="cpu"
        )

        return obj, "FILE"

    print(
        "\n[PUSULA] dosyası bulunamadı."
    )

    print(
        "[PUSULA] Bu deney için "
        "fallback çekirdek oluşturulacak."
    )

    return None, "FALLBACK"


PUSULA, PUSULA_SOURCE = load_pusula()


# ================================================================
# 9. HIDDEN STATE ÇEKME
# ================================================================

@torch.no_grad()
def collect_hidden_states(text):

    inputs = tokenizer(
        text,
        return_tensors="pt"
    )

    inputs = {
        k: v.to(model.device)
        for k, v in inputs.items()
    }

    outputs = model(
        **inputs,
        output_hidden_states=True,
        use_cache=False
    )

    # hidden_states:
    # [embedding, layer1, layer2, ...]
    hs = outputs.hidden_states

    return inputs, hs, outputs


# ================================================================
# 10. TOKEN KONUMLARINI BULMA
# ================================================================

def token_positions_for_text(
    input_ids,
    text
):

    ids = input_ids[0].tolist()

    target = tokenizer.encode(
        text,
        add_special_tokens=False
    )

    positions = []

    for i in range(
        0,
        len(ids) - len(target) + 1
    ):

        if ids[i:i + len(target)] == target:

            positions.extend(
                range(
                    i,
                    i + len(target)
                )
            )

    return positions


# ================================================================
# 11. ÇEKİRDEK OLUŞTURMA
# ================================================================

def normalize(v):

    return F.normalize(
        v.float(),
        dim=-1
    )


def get_layer_vector_from_file(
    layer_idx,
    name
):

    if PUSULA is None:
        return None

    keys = [
        layer_idx,
        str(layer_idx),
        f"L{layer_idx}",
        f"layer_{layer_idx}",
    ]

    layer_obj = None

    for key in keys:

        if isinstance(PUSULA, dict) and key in PUSULA:

            layer_obj = PUSULA[key]
            break

    if layer_obj is None:
        return None

    if isinstance(layer_obj, dict):

        if name in layer_obj:
            return layer_obj[name]

    return None


def construct_dibekgoz_core(
    layer_idx,
    hidden_size
):

    """
    Test 95 karar defteri:

    core =
        aile_merkezi
        + 1.0 * boş_koltuk
        + 0.3 * anatomi

    Fakat Test 96'da bu formül sadece karşılaştırma
    referansı olarak korunuyor.

    Ayrıca kompozit alternatif de üretiliyor.
    """

    names = [
        "biyolojik",
        "primat",
        "bipedal",
        "eller",
        "kuyruk",
    ]

    vecs = {}

    for name in names:

        v = get_layer_vector_from_file(
            layer_idx,
            name
        )

        if v is not None:

            v = torch.as_tensor(
                v,
                dtype=torch.float32
            )

            if v.numel() == hidden_size:

                vecs[name] = v

    if len(vecs) < 5:

        # Fallback:
        # sıfırdan rastgele değil;
        # seed sabit olduğundan yalnızca test altyapısı
        # için deterministik placeholder.

        g = torch.Generator()
        g.manual_seed(
            SEED + layer_idx
        )

        core = torch.randn(
            hidden_size,
            generator=g
        )

        return normalize(core), {
            "source": "FALLBACK_RANDOM_DEMO",
            "layer": layer_idx
        }

    biological = normalize(
        vecs["biyolojik"]
    )

    primate = normalize(
        vecs["primat"]
    )

    bipedal = normalize(
        vecs["bipedal"]
    )

    hands = normalize(
        vecs["eller"]
    )

    tail = normalize(
        vecs["kuyruk"]
    )

    # Aile merkezi
    family = normalize(
        (
            primate
            + 0.50 * biological
        )
    )

    anatomy = normalize(
        0.35 * bipedal
        + 0.25 * (-tail)
        + 0.25 * hands
    )

    # Boş koltuk:
    # aile ekseninden ayrıştırılmış yön
    seat = normalize(
        primate - biological
    )

    core = normalize(
        family
        + 1.00 * seat
        + 0.30 * anatomy
    )

    return core, {
        "source": "TEST95_FORMULA",
        "layer": layer_idx,
        "family_weight": 1.0,
        "seat_weight": 1.0,
        "anatomy_weight": 0.30,
    }


# ================================================================
# 12. BİLİNEN KAVRAM VEKTÖRLERİ
# ================================================================

def construct_known_vector(
    layer_idx,
    concept
):

    """
    Pozitif kontrol.

    Gerçek pusulada goril / fil vektörleri varsa onları kullan.
    """

    candidates = [
        concept,
        concept.lower(),
        f"{concept}_core",
        f"{concept}_vector",
    ]

    for c in candidates:

        v = get_layer_vector_from_file(
            layer_idx,
            c
        )

        if v is not None:

            return normalize(
                torch.as_tensor(v)
            )

    # Eğer kayıt yoksa Dibekgoz ile aynı
    # rastgele fallback kullanılmaz.
    # Ayrı deterministic kontrol üretilir.

    g = torch.Generator()
    g.manual_seed(
        SEED
        + 100000
        + layer_idx * 100
        + sum(ord(c) for c in concept)
    )

    return normalize(
        torch.randn(
            HIDDEN_SIZE,
            generator=g
        )
    )


def construct_random_vector(layer_idx):

    g = torch.Generator()

    g.manual_seed(
        SEED
        + 900000
        + layer_idx
    )

    return normalize(
        torch.randn(
            HIDDEN_SIZE,
            generator=g
        )
    )


# ================================================================
# 13. DRA INTERVENTION CAPSULE
# ================================================================

class InterventionCapsule:

    def __init__(
        self,
        target_layers,
        vector_name,
        alpha,
        vector_builder
    ):

        self.target_layers = set(
            target_layers
        )

        self.vector_name = vector_name

        self.alpha = alpha

        self.vector_builder = vector_builder

        self.handles = []

        self.records = []

        self.pre_states = {}

        self.post_states = {}

        self.vectors = {}

    def install(self):

        for layer_idx in self.target_layers:

            module = LAYERS_MODULE[layer_idx]

            handle = module.register_forward_hook(
                self._make_hook(layer_idx)
            )

            self.handles.append(handle)

    def _make_hook(self, layer_idx):

        def hook(module, inputs, output):

            # Qwen decoder layer output:
            # tuple veya tensor olabilir.

            if isinstance(output, tuple):

                hidden = output[0]

            else:

                hidden = output

            if not torch.is_tensor(hidden):
                return output

            # ------------------------------------------------
            # Müdahale vektörü
            # ------------------------------------------------

            vector = self.vector_builder(
                layer_idx,
                hidden.shape[-1]
            )

            vector = vector.to(
                device=hidden.device,
                dtype=hidden.dtype
            )

            self.vectors[layer_idx] = (
                vector.detach().float().cpu()
            )

            # ------------------------------------------------
            # hidden state
            # ------------------------------------------------

            pre = hidden.detach().float()

            # ------------------------------------------------
            # norm ölçümü
            # ------------------------------------------------

            hnorm = torch.linalg.vector_norm(
                pre,
                dim=-1,
                keepdim=True
            )

            # ------------------------------------------------
            # Katman zarfı
            # ------------------------------------------------

            envelope = layer_envelope(
                layer_idx
            )

            # ------------------------------------------------
            # alpha = 0 sham
            # ------------------------------------------------

            strength = (
                self.alpha
                * envelope
            )

            # ------------------------------------------------
            # ||h|| oranlı enjeksiyon
            # ------------------------------------------------

            if NORM_RELATIVE:

                direction = vector.view(
                    1,
                    1,
                    -1
                )

                direction = F.normalize(
                    direction.float(),
                    dim=-1
                ).to(hidden.dtype)

                delta = (
                    strength
                    * hnorm.to(hidden.dtype)
                    * direction
                )

            else:

                delta = (
                    strength
                    * vector.view(
                        1,
                        1,
                        -1
                    )
                )

            post = hidden + delta

            # ------------------------------------------------
            # TELEMETRY
            # ------------------------------------------------

            delta_norm = torch.linalg.vector_norm(
                delta.float(),
                dim=-1
            )

            hidden_norm = torch.linalg.vector_norm(
                hidden.float(),
                dim=-1
            )

            mean_cos = F.cosine_similarity(
                hidden.float(),
                delta.float(),
                dim=-1
            ).mean().item()

            self.records.append({

                "layer": layer_idx,

                "alpha": self.alpha,

                "envelope": envelope,

                "vector_name": self.vector_name,

                "hidden_norm_mean":
                    hidden_norm.mean().item(),

                "delta_norm_mean":
                    delta_norm.mean().item(),

                "relative_delta_mean":
                    (
                        delta_norm
                        /
                        (hidden_norm + 1e-12)
                    ).mean().item(),

                "cos_hidden_delta":
                    mean_cos,

                "pre_hash":
                    tensor_hash(hidden),

                "post_hash":
                    tensor_hash(post),

            })

            return (
                (post,) + output[1:]
                if isinstance(output, tuple)
                else post
            )

        return hook

    def remove(self):

        for h in self.handles:
            h.remove()

        self.handles = []


# ================================================================
# 14. LOGIT ÖLÇÜMÜ
# ================================================================

def logit_metrics(
    vanilla_logits,
    steered_logits
):

    v = vanilla_logits.float()
    s = steered_logits.float()

    diff = s - v

    return {

        "logit_delta_l2":
            torch.linalg.vector_norm(
                diff
            ).item(),

        "logit_delta_max":
            diff.abs().max().item(),

        "logit_cosine":
            F.cosine_similarity(
                v.flatten(),
                s.flatten(),
                dim=0
            ).item(),

        "kl_vanilla_to_steered":
            F.kl_div(
                F.log_softmax(s, dim=-1),
                F.softmax(v, dim=-1),
                reduction="batchmean"
            ).item(),

        "top1_changed":
            int(
                torch.argmax(v, dim=-1)
                !=
                torch.argmax(s, dim=-1)
            ),

    }


# ================================================================
# 15. VANILLA BASELINE
# ================================================================

@torch.no_grad()
def run_vanilla(text):

    inputs, hs, outputs = collect_hidden_states(
        text
    )

    return {
        "inputs": inputs,
        "hidden_states": hs,
        "logits": outputs.logits[:, -1, :],
        "full_logits": outputs.logits,
    }


# ================================================================
# 16. STEERED RUN
# ================================================================

@torch.no_grad()
def run_steered(
    text,
    vector_name,
    alpha,
    vector_builder,
    target_layers
):

    capsule = InterventionCapsule(
        target_layers=target_layers,
        vector_name=vector_name,
        alpha=alpha,
        vector_builder=vector_builder
    )

    capsule.install()

    try:

        inputs = tokenizer(
            text,
            return_tensors="pt"
        )

        inputs = {
            k: v.to(model.device)
            for k, v in inputs.items()
        }

        outputs = model(
            **inputs,
            output_hidden_states=True,
            use_cache=False
        )

        hidden_states = outputs.hidden_states

        logits = outputs.logits[:, -1, :]

    finally:

        capsule.remove()

    return {
        "inputs": inputs,
        "hidden_states": hidden_states,
        "logits": logits,
        "full_logits": outputs.logits,
        "telemetry": capsule.records,
    }


# ================================================================
# 17. HIDDEN STATE KARŞILAŞTIRMASI
# ================================================================

def compare_hidden_states(
    vanilla,
    steered,
    vector_builder,
    target_layers,
    token_positions
):

    rows = []

    for layer_idx in target_layers:

        # hidden_states[0] = embedding
        hv = vanilla["hidden_states"][
            layer_idx
        ]

        hs = steered["hidden_states"][
            layer_idx
        ]

        # --------------------------------------------------------
        # bütün tokenlar
        # --------------------------------------------------------

        for pos in range(
            hv.shape[1]
        ):

            a = hv[0, pos]
            b = hs[0, pos]

            v = vector_builder(
                layer_idx,
                hv.shape[-1]
            ).to(
                hv.device
            )

            delta = b.float() - a.float()

            rows.append({

                "layer":
                    layer_idx,

                "token_position":
                    pos,

                "is_dibekgoz_token":
                    int(
                        pos in token_positions
                    ),

                "hidden_norm_vanilla":
                    l2(a),

                "hidden_norm_steered":
                    l2(b),

                "delta_norm":
                    l2(delta),

                "relative_delta":
                    relative_change(
                        a,
                        b
                    ),

                "cos_delta_vector":
                    cosine(
                        delta,
                        v
                    ),

                "cos_pre_vector":
                    cosine(
                        a,
                        v
                    ),

                "cos_post_vector":
                    cosine(
                        b,
                        v
                    ),

                "vector_alignment_gain":
                    (
                        cosine(b, v)
                        -
                        cosine(a, v)
                    ),

            })

    return rows


