# ================================================================
# 6. YARDIMCI METRİKLER
# ================================================================

def cosine(a, b, eps=1e-12):

    a = a.float()
    b = b.float()

    denom = (
        torch.linalg.vector_norm(a)
        * torch.linalg.vector_norm(b)
        + eps
    )

    return (
        torch.dot(a, b) / denom
    ).item()


def l2(x):
    return torch.linalg.vector_norm(
        x.float()
    ).item()


def relative_change(a, b):

    a = a.float()
    b = b.float()

    return (
        torch.linalg.vector_norm(b - a)
        /
        (torch.linalg.vector_norm(a) + 1e-12)
    ).item()


def tensor_hash(x):

    arr = (
        x.detach()
        .float()
        .cpu()
        .numpy()
    )

    return hashlib.sha256(
        arr.tobytes()
    ).hexdigest()


# ================================================================
# 7. DRA KATMAN ZARFI
# ================================================================

def layer_envelope(layer_idx):

    if not USE_GAUSSIAN_ENVELOPE:
        return 1.0

    return math.exp(
        -0.5 *
        ((layer_idx - GAUSS_CENTER) / GAUSS_SIGMA) ** 2
    )


