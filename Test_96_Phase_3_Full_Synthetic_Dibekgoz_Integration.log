fil = summary["results"]["fil"]

rnd = summary["results"]["random"]


def mean_metric(
    table,
    metric
):

    values = []

    for alpha in table.values():

        if alpha is None:
            continue

        value = alpha.get(metric)

        if value is not None:
            values.append(
                float(value)
            )

    return (
        float(np.mean(values))
        if values
        else None
    )


