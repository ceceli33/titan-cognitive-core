def get_transformer_layers(model):

    candidates = [
        getattr(model, "model", None),
        getattr(model, "transformer", None),
    ]

    for root in candidates:

        if root is None:
            continue

        if hasattr(root, "layers"):
            return root.layers

        if hasattr(root, "h"):
            return root.h

    raise RuntimeError(
        "Transformer layer listesi bulunamadı."
    )


