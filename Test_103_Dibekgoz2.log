def mirror(z):

    z = unit(z)

    c = cosine(
        z,
        DIBEK
    )

    pp = POS_H @ z
    np_ = NEG_H @ z

    sep = float(
        (
            pp.mean()
            -
            np_.mean()
        ).item()
    )

    pooled = torch.cat(
        [pp, np_]
    )

    sd = float(
        pooled.std(
            unbiased=True
        ).item()
    )

    return {
        "compass_cos":
            c,

        "pos_minus_neg":
            sep,

        "standardized_separation":
            float(
                sep
                /
                (sd + EPS)
            ),
    }


def evaluate_trajectory(states):

    return [
        mirror(z)
        for z in states
    ]


TARGET_MIRROR = evaluate_trajectory(
    TARGET_STATES
)

ANTI_MIRROR = evaluate_trajectory(
    ANTI_STATES
)

NULL_MIRROR = evaluate_trajectory(
    NULL_STATES
)


# =============================================================================
# 16. ENDOGENOUS INTERNAL GEOMETRY
#
# These values are not target evaluation.
# =============================================================================

def internal_trajectory(
    states,
    consensus,
):

    return [
        cosine(
            z,
            consensus
        )
        for z in states
    ]


TARGET_INTERNAL_CONS = internal_trajectory(
    TARGET_STATES,
    TARGET_CONS["direction"],
)

ANTI_INTERNAL_CONS = internal_trajectory(
    ANTI_STATES,
    ANTI_CONS["direction"],
)

NULL_INTERNAL_CONS = internal_trajectory(
    NULL_STATES,
    NULL_CONS["direction"],
)


# =============================================================================
# 17. TRAJECTORY SUMMARY
# =============================================================================

def summarize(
    mirror_trace,
    internal_trace,
):

    c = np.asarray(
        [
            x["compass_cos"]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )

    sep = np.asarray(
        [
            x["pos_minus_neg"]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )

    steps = np.arange(
        len(c),
        dtype=np.float64,
    )

    slope = float(
        np.polyfit(
            steps,
            c,
            1,
        )[0]
    )

    positive_step_fraction = float(
        np.mean(
            np.diff(c) > 0
        )
    )

    return {
        "start_cos":
            float(c[0]),

        "final_cos":
            float(c[-1]),

        "delta_cos":
            float(
                c[-1] - c[0]
            ),

        "max_cos":
            float(
                np.max(c)
            ),

        "min_cos":
            float(
                np.min(c)
            ),

        "linear_slope":
            slope,

        "positive_step_fraction":
            positive_step_fraction,

        "start_separation":
            float(sep[0]),

        "final_separation":
            float(sep[-1]),

        "delta_separation":
            float(
                sep[-1] - sep[0]
            ),

        "internal_consensus_start":
            float(
                internal_trace[0]
            ),

        "internal_consensus_final":
            float(
                internal_trace[-1]
            ),

        "internal_consensus_delta":
            float(
                internal_trace[-1]
                -
                internal_trace[0]
            ),
    }


SUM_TARGET = summarize(
    TARGET_MIRROR,
    TARGET_INTERNAL_CONS,
)

SUM_ANTI = summarize(
    ANTI_MIRROR,
    ANTI_INTERNAL_CONS,
)

SUM_NULL = summarize(
    NULL_MIRROR,
    NULL_INTERNAL_CONS,
)


