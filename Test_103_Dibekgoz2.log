)

xn = extract_hidden(
    NEUTRAL
)


def fingerprint_at_layer(li):

    va = (
        xa[:, li].mean(dim=0)
        -
        xn[:, li].mean(dim=0)
    )


    vb = (
        xb[:, li].mean(dim=0)
        -
        xn[:, li].mean(dim=0)
    )


    va = unit(va)
    vb = unit(vb)


    return cosine(
        va,
        vb,
    )


