DIBEK = (
    SEALED_DIBEK
    .clone()
)


POS_H = (
    SEALED_POS
    .clone()
)


NEG_H = (
    SEALED_NEG
    .clone()
)


def mirror(
    z
):

    z = unit(
        z
    )


    c = cosine(
        z,
        DIBEK,
    )


    p = (
        POS_H
        @
        z
    )


    n = (
        NEG_H
        @
        z
    )


    sep = float(
        (
            p.mean()
            -
            n.mean()
        ).item()
    )


    pooled = torch.cat(
        [
            p,
            n,
        ],
        dim=0,
    )


    pooled_sd = float(
        pooled.std(
            unbiased=True
        ).item()
    )


    std_sep = float(
        sep
        /
        (
            pooled_sd
            +
            EPS
        )
    )


    return {

        "compass_cos":
            c,

        "pos_minus_neg":
            sep,

        "standardized_separation":
            std_sep,
    }


def evaluate_trajectory(
    states
):

    return [
        mirror(z)
        for z in states
    ]


