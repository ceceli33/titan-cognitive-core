def endogenous_consensus(D):

    D = D.float()

    G = D @ D.T

    evals, evecs = torch.linalg.eigh(
        G
    )

    idx = int(
        torch.argmax(evals).item()
    )

    coeff = evecs[:, idx].float()

    mean_flow = D.mean(0)

    candidate = (
        coeff[:, None] * D
    ).sum(0)

    # Eigenvector sign determined ONLY by donor mean.
    if float(
        torch.dot(
            candidate,
            mean_flow
        ).item()
    ) < 0:

        coeff = -coeff
        candidate = -candidate

    return {
        "direction":
            unit(candidate),

        "coeff":
            coeff,

        "lambda1":
            float(
                evals[idx].item()
            ),

        "spectral_fraction":
            float(
                evals[idx].item()
                /
                (
                    torch.clamp(
                        evals,
                        min=0
                    ).sum().item()
                    + EPS
                )
            ),
    }


