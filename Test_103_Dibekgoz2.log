# =============================================================================
# 7. HIDDEN EXTRACTION
# =============================================================================

@torch.inference_mode()
def extract_hidden(texts):

    enc = tokenizer(
        texts,
        padding=True,
        truncation=True,
        max_length=128,
        return_tensors="pt",
    )

    ids = enc["input_ids"].to(device)
    mask = enc["attention_mask"].to(device)

    lengths = mask.sum(dim=1).long()

    captures = [
        None
        for _ in range(VECTOR_LAYERS)
    ]

    hooks = []

    def make_hook(li):

        def hook(module, inp, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            captures[li] = h.detach()

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            hooks.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False,
        )

    finally:

        for h in hooks:
            h.remove()

    B = ids.shape[0]

    output = torch.empty(
        B,
        VECTOR_LAYERS,
        HIDDEN,
        dtype=torch.float32,
    )

    rows = torch.arange(
        B,
        device=device,
    )

    for li in range(VECTOR_LAYERS):

        h = captures[li].float()

        output[:, li] = (
            h[
                rows,
                (lengths - 1).to(h.device),
            ]
            .cpu()
        )

    return output


