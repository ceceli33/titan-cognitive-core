# =============================================================================
# 12. BUILD BLIND "EMPTY SEAT"
#
# IMPORTANT:
#
# z0 must NOT be Dibekgoz-orthogonalized.
# That would leak the target into initialization.
#
# Instead:
#
# 1. deterministic random vector
# 2. project it into TARGET donor span
# 3. remove TARGET consensus component
#
# Thus z0 belongs to the same endogenous local donor subspace,
# but contains zero TARGET-CONSENSUS component by construction.
#
# Dibekgoz is never consulted.
# =============================================================================

def build_empty_seat(
    donor_directions,
    consensus_direction,
):

    D = donor_directions.float()

    gen = torch.Generator(
        device="cpu"
    )

    gen.manual_seed(
        SEED + 9001
    )

    r = torch.randn(
        HIDDEN,
        generator=gen,
        dtype=torch.float32,
    )

    # -------------------------------------------------------------------------
    # Projection into row-span(D)
    #
    # SVD gives an orthonormal basis for the donor input span.
    # -------------------------------------------------------------------------

    _, s, Vh = torch.linalg.svd(
        D,
        full_matrices=False,
    )

    tol = (
        float(s.max().item())
        * max(D.shape)
        * torch.finfo(
            torch.float32
        ).eps
    )

    rank = int(
        (s > tol)
        .sum()
        .item()
    )

    B = Vh[:rank]

    r_span = (
        (B @ r)[:, None]
        * B
    ).sum(0)

    # Remove consensus component.
    r_neutral = project_out(
        r_span,
        consensus_direction,
    )

    if float(
        torch.linalg.vector_norm(
            r_neutral
        ).item()
    ) <= 1e-8:

        raise RuntimeError(
            "Empty-seat construction collapsed."
        )

    return (
        unit(r_neutral),
        rank,
    )


