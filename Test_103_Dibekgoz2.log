# =============================================================================
# 13. CRYSTALLIZATION UPDATE
#
# Critical:
#
# update(z, donor) sees ONLY:
#
#   z
#   donor movement
#
# It cannot see:
#
#   Dibekgoz
#   mirror score
#   POS / NEG
#
#
# We do NOT simply:
#
#       z <- z + eta * fixed_consensus
#
# because that would trivially converge to TEST140's already-computed spark.
#
# Instead each step receives ONE natural donor movement.
#
# The update extracts the donor component not already represented by z:
#
#       innovation = d - <d,z>z
#
# and performs a fixed angular move toward that endogenous innovation.
#
# This produces an actual sequential formation trajectory.
# =============================================================================

def crystallize(
    z0,
    donor_directions,
    n_steps=N_STEPS,
    eta=ETA,
):

    z = unit(z0)

    D = donor_directions.float()

    states = [
        z.clone()
    ]

    internal = []

    for t in range(n_steps):

        idx = (
            t
            % D.shape[0]
        )

        d = unit(
            D[idx]
        )

        alignment_before = cosine(
            z,
            d,
        )

        innovation = (
            d
            -
            torch.dot(d, z) * z
        )

        innovation_norm = float(
            torch.linalg.vector_norm(
                innovation
            ).item()
        )

        if innovation_norm > EPS:

            u = unit(
                innovation
            )

            # Fixed geodesic-like local rotation.
            #
            # eta is an angle in radians.
            z_new = (
                math.cos(eta) * z
                +
                math.sin(eta) * u
            )

            z_new = unit(
                z_new
            )

        else:

            z_new = z.clone()

        internal.append(
            {
                "step":
                    t + 1,

                "donor_index":
                    idx,

                "donor_alignment_before":
                    alignment_before,

                "innovation_norm":
                    innovation_norm,

                "step_cos":
                    cosine(
                        z,
                        z_new,
                    ),
            }
        )

        z = z_new

        states.append(
            z.clone()
        )

    return states, internal


