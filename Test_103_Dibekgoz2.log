# =============================================================================
# 13. ENDOGENOUS CONSENSUS
# =============================================================================
#
# IMPORTANT:
# Dibekgoz does not enter this function.
#
# =============================================================================

def endogenous_consensus(
    D
):

    D = (
        D.detach()
        .float()
    )


    G = (
        D
        @
        D.T
    )


    evals, evecs = (
        torch.linalg.eigh(
            G
        )
    )


    idx = int(
        torch.argmax(
            evals
        ).item()
    )


    coeff = (
        evecs[
            :, idx
        ]
        .float()
    )


    mean_flow = (
        D.mean(
            dim=0
        )
    )


    candidate = (
        coeff[:, None]
        *
        D
    ).sum(
        dim=0
    )


    # Eigenvector sign is arbitrary.
    # Resolve it only from donor geometry.

    if float(
        torch.dot(
            candidate,
            mean_flow
        ).item()
    ) < 0:

        coeff = -coeff
        candidate = -candidate


    direction = unit(
        candidate
    )


    positive_evals = torch.clamp(
        evals,
        min=0,
    )


    spectral_fraction = float(
        evals[idx].item()
        /
        (
            positive_evals.sum().item()
            +
            EPS
        )
    )


    support = (
        D
        @
        direction
    )


    if D.shape[0] > 1:

        mask = ~torch.eye(
            D.shape[0],
            dtype=torch.bool,
        )


        coherence = float(
            G[
                mask
            ].mean().item()
        )

    else:

        coherence = float(
            "nan"
        )


    return {

        "direction":
            direction,

        "coeff":
            coeff,

        "lambda1":
            float(
                evals[
                    idx
                ].item()
            ),

        "spectral_fraction":
            spectral_fraction,

        "coherence":
            coherence,

        "support_mean":
            float(
                support.mean().item()
            ),

        "support_positive_fraction":
            float(
                (
                    support
                    >
                    0
                )
                .float()
                .mean()
                .item()
            ),
    }


