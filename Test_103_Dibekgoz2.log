# =============================================================================
# 23. RANDOM TARGET SEQUENCE-ORDER CONTROL
# =============================================================================
#
# Same TARGET donors.
# Only order changes.
#
# This is an ORDER control, not a semantic-null control.
#
# =============================================================================

random_final = []
random_delta = []
random_slope = []


rng = torch.Generator(
    device="cpu"
)


rng.manual_seed(
    SEED
    +
    5000
)


D = (
    TARGET[
        "direction"
    ]
)


for ri in range(
    N_RANDOM_ORDER
):

    seq_parts = []


    n_epochs = math.ceil(
        N_STEPS
        /
        D.shape[0]
    )


    for ep in range(
        n_epochs
    ):

        perm = torch.randperm(
            D.shape[0],
            generator=rng,
        )


        seq_parts.append(
            D[
                perm
            ]
        )


    seq = torch.cat(
        seq_parts,
        dim=0,
    )[
        :N_STEPS
    ]


    states, _ = crystallize(
        TARGET_Z0,
        seq,
        n_steps=N_STEPS,
        eta=ETA,
    )


    trace = evaluate_trajectory(
        states
    )


    c = np.asarray(
        [
            x[
                "compass_cos"
            ]
            for x in trace
        ],
        dtype=np.float64,
    )


    random_final.append(
        float(
            c[-1]
        )
    )


    random_delta.append(
        float(
            c[-1]
            -
            c[0]
        )
    )


    random_slope.append(
        float(
            np.polyfit(
                np.arange(
                    len(c),
                    dtype=np.float64,
                ),
                c,
                1,
            )[0]
        )
    )


random_delta_np = np.asarray(
    random_delta,
    dtype=np.float64,
)


random_mean = float(
    random_delta_np.mean()
)


random_sd = float(
    random_delta_np.std(
        ddof=1
    )
)


ordered_percentile = float(
    np.mean(
