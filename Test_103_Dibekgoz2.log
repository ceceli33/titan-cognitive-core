# =============================================================================
# 14. BUILD ENDOGENOUS EMPTY SEAT
# =============================================================================
#
# NO DIBEK INFORMATION.
#
# 1. deterministic random vector
# 2. project into donor row-span
# 3. remove endogenous consensus component
#
# =============================================================================

def build_empty_seat(
    donor_directions,
    consensus_direction,
    seed_offset,
):

    D = (
        donor_directions
        .detach()
        .float()
    )


    gen = torch.Generator(
        device="cpu"
    )


    gen.manual_seed(
        SEED
        +
        seed_offset
    )


    r = torch.randn(
        HIDDEN,
        generator=gen,
        dtype=torch.float32,
    )


    _, s, Vh = (
        torch.linalg.svd(
            D,
            full_matrices=False,
        )
    )


    tol = (
        float(
            s.max().item()
        )
        *
        max(
            D.shape
        )
        *
        torch.finfo(
            torch.float32
        ).eps
    )


    rank = int(
        (
            s
            >
            tol
        )
        .sum()
        .item()
    )


    if rank < 2:

        raise RuntimeError(
            "Donor span rank < 2."
        )


    B = (
        Vh[
            :rank
        ]
    )


    r_span = (
        B.T
        @
        (
            B
            @
            r
        )
    )


    r_neutral = project_out(
        r_span,
        consensus_direction,
    )


    norm_neutral = float(
        torch.linalg.vector_norm(
            r_neutral
        ).item()
    )


    if (
        norm_neutral
        <=
        1e-8
    ):

        raise RuntimeError(
            "Empty-seat construction collapsed."
        )


    z0 = unit(
        r_neutral
    )


    return (
        z0,
        rank,
    )


