# 12. EXTRACT NATURAL DONOR MOVEMENTS
# =============================================================================

def extract_movements(
    pairs
):

    before_texts = [
        x[0]
        for x in pairs
    ]


    after_texts = [
        x[1]
        for x in pairs
    ]


    before = (
        extract_hidden(
            before_texts
        )[:, LAYER]
    )


    after = (
        extract_hidden(
            after_texts
        )[:, LAYER]
    )


    delta = (
        after
        -
        before
    )


    directions = torch.stack(
        [
            unit(x)
            for x in delta
        ],
        dim=0,
    )


    return {

        "before":
            before,

        "after":
            after,

        "delta":
            delta,

        "direction":
            directions,
    }


