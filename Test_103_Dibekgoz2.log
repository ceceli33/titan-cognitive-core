# =============================================================================
# 20. RANDOM-SEQUENCE CONTROL
#
# Same TARGET donor vectors.
# Only sequence order is randomized.
#
# This asks whether formation depends strongly on the chosen sequence.
# It does NOT replace semantic null controls.
# =============================================================================

N_RANDOM_ORDER = 128

random_final = []
random_delta = []
random_slope = []

gen = torch.Generator(
    device="cpu"
)

gen.manual_seed(
    SEED + 5000
)

D = TARGET[
    "direction"
]

for ri in range(
    N_RANDOM_ORDER
):

    # Build a deterministic 24-step sequence by independently
    # permuting the 12 TARGET donors for each epoch.

    seq_parts = []

    n_epochs = math.ceil(
        N_STEPS
        /
        D.shape[0]
    )

    for ep in range(
        n_epochs
    ):

        perm = torch.randperm(
            D.shape[0],
            generator=gen,
        )

        seq_parts.append(
            D[perm]
        )

    seq = torch.cat(
        seq_parts,
        dim=0,
    )[:N_STEPS]

    # crystallize() cycles through supplied rows.
    states, _ = crystallize(
        TARGET_Z0,
        seq,
        n_steps=N_STEPS,
        eta=ETA,
    )

    m = evaluate_trajectory(
        states
    )

    c = np.asarray(
        [
            x["compass_cos"]
            for x in m
        ],
        dtype=np.float64,
    )

    random_final.append(
        float(c[-1])
    )

    random_delta.append(
        float(
            c[-1] - c[0]
        )
    )

    random_slope.append(
        float(
            np.polyfit(
                np.arange(len(c)),
                c,
                1,
            )[0]
        )
    )


ordered_percentile = float(
    np.mean(
        np.asarray(
            random_delta
        )
        <= birth_target
    )
)


print(
