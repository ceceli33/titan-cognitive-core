# =============================================================================
# 15. TARGET-BLIND CRYSTALLIZATION UPDATE
# =============================================================================
#
# d_t = endogenous donor movement
#
# innovation:
#
#   u_t =
#       d_t
#       -
#       <d_t,z_t> z_t
#
# fixed angular update:
#
#   z_(t+1)
#       =
#       cos(eta) z_t
#       +
#       sin(eta) unit(u_t)
#
# =============================================================================

def crystallize(
    z0,
    donor_sequence,
    n_steps=N_STEPS,
    eta=ETA,
):

    z = unit(
        z0
    )


    D = (
        donor_sequence
        .detach()
        .float()
    )


    states = [
        z.clone()
    ]


    telemetry = []


    for t in range(
        n_steps
    ):

        idx = (
            t
            %
            D.shape[0]
        )


        d = unit(
            D[
                idx
            ]
        )


        alignment_before = cosine(
            z,
            d,
        )


        innovation = (
            d
            -
            torch.dot(
                d,
                z
            )
            *
            z
        )


        innovation_norm = float(
            torch.linalg.vector_norm(
                innovation
            ).item()
        )


        if (
            innovation_norm
            >
            EPS
        ):

            u = unit(
                innovation
            )


            z_new = (
                math.cos(
                    eta
                )
                *
                z
                +
                math.sin(
                    eta
                )
                *
                u
            )


            z_new = unit(
                z_new
            )


        else:

            z_new = (
                z.clone()
            )


        telemetry.append(
            {

                "step":
                    t + 1,

                "donor_index":
                    idx,

                "donor_alignment_before":
                    alignment_before,

                "innovation_norm":
                    innovation_norm,

                "state_step_cos":
                    cosine(
                        z,
                        z_new,
                    ),
            }
        )


        z = z_new


        states.append(
            z.clone()
        )


    return (
        states,
        telemetry,
    )


