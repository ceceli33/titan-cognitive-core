def extract_movements(pairs):

    before = extract_hidden(
        [x[0] for x in pairs]
    )[:, LAYER]

    after = extract_hidden(
        [x[1] for x in pairs]
    )[:, LAYER]

    delta = (
        after - before
    )

    directions = torch.stack(
        [
            unit(x)
            for x in delta
        ],
        dim=0,
    )

    return {
        "before": before,
        "after": after,
        "delta": delta,
        "direction": directions,
    }


