# =============================================================================
# 9. LOCKED HIDDEN EXTRACTION
# =============================================================================
#
# - RIGHT PADDING
# - DECODER LAYER OUTPUT
# - register_forward_hook
# - LAST REAL TOKEN
#
# =============================================================================

@torch.inference_mode()
def extract_hidden(texts):

    enc = tokenizer(
        texts,
        padding=True,
        truncation=True,
        max_length=128,
        return_tensors="pt",
    )


    ids = (
        enc["input_ids"]
        .to(device)
    )


    mask = (
        enc["attention_mask"]
        .to(device)
    )


    lengths = (
        mask.sum(dim=1)
        .long()
    )


    captures = [
        None
        for _ in range(
            VECTOR_LAYERS
        )
    ]


    hooks = []


    def make_hook(li):

        def hook(
            module,
            inp,
            out,
        ):

            if isinstance(
                out,
                tuple,
            ):

                h = out[0]

            else:

                h = out


            captures[li] = (
                h.detach()
            )

        return hook


    try:

        for li in range(
            VECTOR_LAYERS
        ):

            handle = (
                model.model.layers[
                    li
                ].register_forward_hook(
                    make_hook(li)
                )
            )

            hooks.append(
                handle
            )


        model(
            input_ids=ids,
            attention_mask=mask,
            use_cache=False,
        )


    finally:

        for handle in hooks:

            handle.remove()


    B = ids.shape[0]


    output = torch.empty(
        B,
        VECTOR_LAYERS,
        HIDDEN,
        dtype=torch.float32,
    )


    rows = torch.arange(
        B,
        device=device,
    )


    for li in range(
        VECTOR_LAYERS
    ):

        if captures[li] is None:

            raise RuntimeError(
                f"Layer {li} capture failed."
            )


        h = (
            captures[li]
            .float()
        )


        last_idx = (
            lengths - 1
        ).to(
            h.device
        )


        output[:, li] = (
            h[
                rows,
                last_idx,
            ]
            .cpu()
        )


    return output


