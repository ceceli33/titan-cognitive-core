# =============================================================================
# 19. SUMMARIZE
# =============================================================================

def summarize(
    mirror_trace,
    consensus_values,
):

    c = np.asarray(
        [
            x[
                "compass_cos"
            ]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )


    sep = np.asarray(
        [
            x[
                "pos_minus_neg"
            ]
            for x in mirror_trace
        ],
        dtype=np.float64,
    )


    t = np.arange(
        len(c),
        dtype=np.float64,
    )


    slope = float(
        np.polyfit(
            t,
            c,
            1,
        )[0]
    )


    positive_step_fraction = float(
        np.mean(
            np.diff(
                c
            )
            >
            0
        )
    )


    return {

        "start_cos":
            float(
                c[0]
            ),

        "final_cos":
            float(
                c[-1]
            ),

        "delta_cos":
            float(
                c[-1]
                -
                c[0]
            ),

        "max_cos":
            float(
                c.max()
            ),

        "min_cos":
            float(
                c.min()
            ),

        "linear_slope":
            slope,

        "positive_step_fraction":
            positive_step_fraction,

        "start_separation":
            float(
                sep[0]
            ),

        "final_separation":
            float(
                sep[-1]
            ),

        "delta_separation":
            float(
                sep[-1]
                -
                sep[0]
            ),

        "internal_consensus_start":
            float(
                consensus_values[
                    0
                ]
            ),

        "internal_consensus_final":
            float(
                consensus_values[
                    -1
                ]
            ),

        "internal_consensus_delta":
            float(
                consensus_values[
                    -1
                ]
                -
                consensus_values[
                    0
                ]
            ),
    }


SUM_TARGET = summarize(
