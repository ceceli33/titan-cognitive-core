        "mean_contribution": b_contrib,
        "mean_envelope": b_env,
        "mean_brake": b_brake,
        "steps": b_steps
    }

    # ---------------------------------------------------------------------
    # ÇİFT YÖN AYRIŞMASI
    #
    # Pozitif:
    #   ABOVE yönü ile BELOW yönü arasında ayrışma artıyor.
    #
    # Negatif:
    #   BELOW tarafındaki değişim daha negatif.
    #
    # Bu bir "başarı puanı" değildir; yönlerin birbirinden ayrışmasını
    # tek sayıda takip etmek için geometrik/behavioral özet ölçüdür.
    # ---------------------------------------------------------------------

    bidirectional_separation = a_delta - b_delta

    pair_record["bidirectional_separation"] = float(
        bidirectional_separation
    )

    results["pairs"].append(pair_record)

    print(
        f"  BELOW | "
        f"NET={b_net:+.4f} | "
        f"ΔNET={b_delta:+.4f} | "
        f"COS={b_cos:+.4f} | "
        f"CONTRIB={b_contrib:.4f}"
    )

    print(
        f"  AYRIŞMA | "
        f"ΔABOVE - ΔBELOW = "
        f"{bidirectional_separation:+.4f}"
    )

    # GPU belleğini rahatlat
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()

# -----------------------------------------------------------------------------
# 15) SIRALAMA / ÖZET
# -----------------------------------------------------------------------------

def fmt(x):
    return f"{x:+.4f}"


summary = []

for p in results["pairs"]:

    l1, l2 = p["layers"]

    a = p["above"]
    b = p["below"]

    summary.append({
        "pair": f"L{l1:02d}+L{l2:02d}",

        "ABOVE_NET": a["net_mean"],
        "ABOVE_dNET": a["delta_net"],

        "BELOW_NET": b["net_mean"],
        "BELOW_dNET": b["delta_net"],

        "SEPARATION": p["bidirectional_separation"],

        "ABOVE_COS": a["mean_cos"],
        "BELOW_COS": b["mean_cos"],

        "ABOVE_CONTRIB": a["mean_contribution"],
        "BELOW_CONTRIB": b["mean_contribution"],

        "ABOVE_WORDS": a["words_mean"],
        "BELOW_WORDS": b["words_mean"],

        "ABOVE_REP": a["repetition_mean"],
        "BELOW_REP": b["repetition_mean"]
    })

# -----------------------------------------------------------------------------
# 16) AYRI AYRI SIRALI GÖSTERİM
# -----------------------------------------------------------------------------

print("\n" + "=" * 110)
print("TEST 101 — KOMŞU ÇİFT SONUÇLARI")
print("=" * 110)

header = (
    f"{'PAIR':<9}"
