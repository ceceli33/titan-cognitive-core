#     EN NEGATİF BELOW ΔNET
# -----------------------------------------------------------------------------

print("\n" + "=" * 100)
print("BELOW YÖNÜ — ΔNET EN NEGATİFTEN EN POZİTİFE")
print("=" * 100)

below_sorted = sorted(
    summary,
    key=lambda x: x["BELOW_dNET"]
)

for i, r in enumerate(below_sorted, start=1):

    print(
        f"{i:02d}. {r['pair']:<9} "
        f"ΔBELOW={r['BELOW_dNET']:+.4f} | "
        f"BELOW_NET={r['BELOW_NET']:+.4f} | "
        f"SEP={r['SEPARATION']:+.4f}"
    )

# -----------------------------------------------------------------------------
# 18) ABOVE YÖNÜ — ΔNET EN POZİTİFTEN EN NEGATİFE
# -----------------------------------------------------------------------------

print("\n" + "=" * 100)
print("ABOVE YÖNÜ — ΔNET EN POZİTİFTEN EN NEGATİFE")
print("=" * 100)

above_sorted = sorted(
    summary,
    key=lambda x: x["ABOVE_dNET"],
    reverse=True
)

for i, r in enumerate(above_sorted, start=1):

    print(
        f"{i:02d}. {r['pair']:<9} "
        f"ΔABOVE={r['ABOVE_dNET']:+.4f} | "
        f"ABOVE_NET={r['ABOVE_NET']:+.4f} | "
        f"SEP={r['SEPARATION']:+.4f}"
    )

# -----------------------------------------------------------------------------
