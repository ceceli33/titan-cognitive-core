    f"{'ΔA':>9}"
    f"{'B_NET':>9}"
    f"{'ΔB':>9}"
    f"{'SEP':>9}"
    f"{'A_COS':>9}"
    f"{'B_COS':>9}"
)

print(header)
print("-" * len(header))

for r in summary:

    print(
        f"{r['pair']:<9}"
        f"{fmt(r['ABOVE_NET']):>9}"
        f"{fmt(r['ABOVE_dNET']):>9}"
        f"{fmt(r['BELOW_NET']):>9}"
        f"{fmt(r['BELOW_dNET']):>9}"
        f"{fmt(r['SEPARATION']):>9}"
        f"{fmt(r['ABOVE_COS']):>9}"
        f"{fmt(r['BELOW_COS']):>9}"
    )

# -----------------------------------------------------------------------------
