# -----------------------------------------------------------------------------
# 7) LAYERWISE BAĞIMSIZ YÖNLER
# -----------------------------------------------------------------------------

def normalize(v, eps=1e-12):
    n = torch.linalg.vector_norm(v)
    return v / torch.clamp(n, min=eps)


IND_ABOVE = []
IND_BELOW = []

for li in range(N_LAYERS):

    mean_a = ACT_ABOVE[:, li, :].mean(dim=0)
    mean_b = ACT_BELOW[:, li, :].mean(dim=0)
    mean_n = ACT_NEUTRAL[:, li, :].mean(dim=0)

    v_a = normalize(mean_a - mean_n)
    v_b = normalize(mean_b - mean_n)

    IND_ABOVE.append(v_a)
    IND_BELOW.append(v_b)

IND_ABOVE = torch.stack(IND_ABOVE)
IND_BELOW = torch.stack(IND_BELOW)

print("\nLayerwise vector shape:")
print("IND_ABOVE:", tuple(IND_ABOVE.shape))
print("IND_BELOW:", tuple(IND_BELOW.shape))

# -----------------------------------------------------------------------------
# 8) BASİT KELİME SAYACI
# -----------------------------------------------------------------------------

ABOVE_WORDS = [
    "above",
    "over",
    "higher",
    "up",
    "upper",
    "overhead"
]

BELOW_WORDS = [
    "below",
    "under",
    "lower",
    "down",
    "beneath"
]

REPEAT_N = 3


def count_direction(text):
    t = text.lower()

    above = sum(t.count(w) for w in ABOVE_WORDS)
    below = sum(t.count(w) for w in BELOW_WORDS)

    return above, below


def repetition_score(text):
    words = text.lower().split()

    if len(words) < 4:
        return 0.0

    counts = Counter(words)

    repeated = sum(
        max(0, c - 1)
        for c in counts.values()
    )

    return repeated / max(1, len(words))


def word_count(text):
    return len(text.split())


# -----------------------------------------------------------------------------
# 9) DRA MOTORU
# -----------------------------------------------------------------------------

def dra_envelope(layer_idx, cos_val):

    unc = 1.0 - abs(cos_val)

    dw = SONUM + unc * UNC_WEIGHT

    t = float(layer_idx)

    kb = (
        ZIRVE
        * math.exp(-dw * t)
        * (1.0 + dw * t)
        + TABAN
    )

    zarf = kb / (ZIRVE + TABAN)

    # Fren
    brake = 1.0

    if cos_val > BRAKE_HIGH:
        brake = (1.0 - cos_val) / (1.0 - BRAKE_HIGH)

    elif cos_val < BRAKE_LOW:
        brake = 1.6

    return zarf, brake


# -----------------------------------------------------------------------------
# 10) GENERATION MOTORU
# -----------------------------------------------------------------------------

def build_prompt_text(prompt):
    """
    Qwen chat template.
    """

    messages = [
        {
            "role": "user",
            "content": prompt
        }
    ]

    return tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True
    )


@torch.no_grad()
def generate_arm(prompt, active_layers, direction):

    """
    active_layers:
        örn. [8,9]

    direction:
        "ABOVE"
        "BELOW"
    """

    if direction == "ABOVE":
        vectors = IND_ABOVE
    elif direction == "BELOW":
        vectors = IND_BELOW
    else:
        raise ValueError(direction)

    encoded = tokenizer(
        build_prompt_text(prompt),
        return_tensors="pt"
    )

    encoded = {
        k: v.to(device)
        for k, v in encoded.items()
    }

    telemetry = {
        "cos": [],
        "abs_cos": [],
        "contribution": [],
        "envelope": [],
        "brake": [],
        "steps": 0
    }

    hooks = []

    # -------------------------------------------------------------------------
    # HER AKTİF KATMAN İÇİN HOOK
    # -------------------------------------------------------------------------

    for layer_idx in active_layers:

        try:
            layer_module = model.model.layers[layer_idx]
        except Exception:
            layer_module = model.transformer.h[layer_idx]

        vec = vectors[layer_idx].to(
            device=device,
            dtype=torch.bfloat16
        )

        def make_hook(li, v):

            def hook(module, inputs, output):

                # HF transformer layer output genellikle tuple:
                # output[0] = hidden states
                if isinstance(output, tuple):
                    h = output[0]
                else:
                    h = output

                # Sadece son token
                last = h[:, -1, :]

                # cosine
                v_float = v.float()
                last_float = last.float()

                v_norm = torch.linalg.vector_norm(
                    v_float,
                    dim=-1,
                    keepdim=True
                ).clamp_min(1e-12)

                h_norm = torch.linalg.vector_norm(
                    last_float,
                    dim=-1,
                    keepdim=True
                ).clamp_min(1e-12)

                cos_tensor = (
                    (last_float * v_float).sum(dim=-1, keepdim=True)
                    / (h_norm * v_norm)
                )

                cos_val = float(
                    cos_tensor.mean().detach().cpu()
                )

                zarf, brake = dra_envelope(
                    li,
                    cos_val
                )

                # -----------------------------------------------------------------
                # TEST 100 MOTORU:
                #
                # ivme * ||h|| / sqrt(20) * zarf * brake
                #
                # Yön cosine ile çarpılmıyor.
                # Cosine yalnızca governor.
                # -----------------------------------------------------------------

                hnorm_scalar = torch.linalg.vector_norm(
                    last_float,
                    dim=-1,
                    keepdim=True
                ).clamp_min(1e-12)

                contribution_scalar = (
                    IVME
                    * hnorm_scalar
                    / SQRT_K
                    * zarf
                    * brake
                )

                # v normalize edilmiş durumda
                injection = (
                    v_float.unsqueeze(0)
                    * contribution_scalar.unsqueeze(-1)
                )

                new_last = last_float + injection

                h_new = h.clone()

                h_new[:, -1, :] = new_last.to(
                    dtype=h.dtype
                )

                telemetry["cos"].append(cos_val)
                telemetry["abs_cos"].append(abs(cos_val))
                telemetry["contribution"].append(
                    float(contribution_scalar.mean().detach().cpu())
                )
                telemetry["envelope"].append(float(zarf))
                telemetry["brake"].append(float(brake))
                telemetry["steps"] += int(h.shape[0])

                if isinstance(output, tuple):
                    return (h_new,) + output[1:]

                return h_new

            return hook

        hooks.append(
            layer_module.register_forward_hook(
                make_hook(layer_idx, vec)
            )
        )

    # -------------------------------------------------------------------------
    # GENERATE
    # -------------------------------------------------------------------------

    try:

        generated = model.generate(
            **encoded,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            use_cache=True,
            pad_token_id=tokenizer.eos_token_id
        )

        input_len = encoded["input_ids"].shape[1]

        new_tokens = generated[0, input_len:]

        text = tokenizer.decode(
            new_tokens,
            skip_special_tokens=True
        )

    finally:

        for h in hooks:
            h.remove()

    above, below = count_direction(text)

    telemetry["above"] = above
    telemetry["below"] = below
    telemetry["net"] = above - below
    telemetry["words"] = word_count(text)
    telemetry["repetition"] = repetition_score(text)

    if telemetry["cos"]:
        telemetry["mean_cos"] = float(
            np.mean(telemetry["cos"])
        )
        telemetry["mean_abs_cos"] = float(
            np.mean(telemetry["abs_cos"])
        )
        telemetry["mean_contribution"] = float(
            np.mean(telemetry["contribution"])
        )
        telemetry["mean_envelope"] = float(
            np.mean(telemetry["envelope"])
        )
        telemetry["mean_brake"] = float(
            np.mean(telemetry["brake"])
        )
    else:
        telemetry["mean_cos"] = 0.0
        telemetry["mean_abs_cos"] = 0.0
        telemetry["mean_contribution"] = 0.0
        telemetry["mean_envelope"] = 0.0
        telemetry["mean_brake"] = 1.0

    return text, telemetry


