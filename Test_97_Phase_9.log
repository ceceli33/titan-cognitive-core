results["summary"] = summary

results["notes"] = {
    "interpretation": [
        "Adjacent pair scan only; no 3-layer or 4-layer inference is made.",
        "The motor denominator remains sqrt(20), matching TEST 100.",
        "Two active layers therefore may produce greater total physical injection than a single active layer.",
        "delta_net is a coarse behavioral keyword metric and must be interpreted together with generated text.",
        "bidirectional_separation = delta_net_ABOVE - delta_net_BELOW.",
        "No arbitrary success threshold is applied."
    ],
