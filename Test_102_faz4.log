# =============================================================================
# 11. BASELINE
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. ONE STEP PROBE
# =============================================================================

@torch.no_grad()
def one_step_probe(
    prompt,
    baseline,
    li,
    direction,
):

    target = li + 1

    q = normalize(direction)

    if q is None:
        raise RuntimeError(
            "Zero direction"
        )

    src_base = baseline[li].float()

    requested_norm = (
        PROBE_REL
        * float(
            torch.linalg.vector_norm(
                src_base
            )
        )
    )

    q_gpu = q.to(device)

    source_delta = {}
    target_cap = {}

    handles = []

    def source_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        before = (
            h[0, -1]
            .float()
        )

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        ds = (
            hnew[0, -1].float()
            - before
        )

        source_delta["x"] = (
            ds.detach()
            .cpu()
            .clone()
        )

        if isinstance(out, tuple):

            return (
                (hnew,)
                + out[1:]
            )

        return hnew

    def target_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        target_cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    x = source_delta["x"]

    y = (
        target_cap["h"]
        - baseline[target]
    )

    return {
        "x": x,
        "y": y,

        "realized_rel":
            float(
                torch.linalg.vector_norm(x)
            )
            /
            (
                float(
                    torch.linalg.vector_norm(
                        src_base
                    )
                )
                + EPS
            ),

        "dir_cos":
            cosine(
                x,
                q,
            ),

        "gain":
            float(
                torch.linalg.vector_norm(y)
            )
            /
            (
                float(
                    torch.linalg.vector_norm(x)
                )
                + EPS
            ),
    }


# =============================================================================
# 13. RANDOM TANGENT DIRECTIONS
# =============================================================================

def random_orthogonal(
    v,
    seed,
):

    v = normalize(v)

    g = torch.Generator(
        device="cpu"
    )

    g.manual_seed(seed)

    z = torch.randn(
        HIDDEN,
        generator=g,
        dtype=torch.float32,
    )

    u = (
        z
        - torch.dot(z, v) * v
    )

    return normalize(u)


def make_angle_direction(
    seed_vec,
    angle,
    seed,
):

    v = normalize(seed_vec)

    u = random_orthogonal(
        v,
        seed,
    )

    th = math.radians(angle)

    q = (
        math.cos(th) * v
        + math.sin(th) * u
    )

    return normalize(q)


