# 14. TRAIN SECANT ATLAS
# =============================================================================

print("\n[4/20] TRAIN finite-secant atlas oluşturuluyor...")

TRAIN_DATA = {
    li: []
    for li in SOURCE_LAYERS
}

start = time.time()

for pi, prompt in enumerate(TRAIN_PROMPTS):

    base = baseline_pass(prompt)

    for li in SOURCE_LAYERS:

        # Semantic
        sem = one_step_probe(
            prompt,
            base,
            li,
            DIBEK[li],
        )

        TRAIN_DATA[li].append({
            "prompt_index": pi,
            "kind": "semantic",
            "angle": 0.0,
            "x": sem["x"],
            "y": sem["y"],
        })

        # Atlas
        for ri in range(N_RANDOM_TRAIN):

            angle = TRAIN_ANGLES_DEG[
                ri % len(TRAIN_ANGLES_DEG)
            ]

            q = make_angle_direction(
                DIBEK[li],
                angle,
                SEED
                + 100000 * (pi + 1)
                + 1000 * li
                + ri,
            )

            rr = one_step_probe(
                prompt,
                base,
                li,
                q,
            )

            TRAIN_DATA[li].append({
                "prompt_index": pi,
                "kind": "random",
                "angle": angle,
                "x": rr["x"],
                "y": rr["y"],
            })

    if (pi + 1) % 5 == 0:
        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(TRAIN_PROMPTS)} "
        f"| elapsed={(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"Atlas completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 15. LOW-RANK LINEAR SECANT OPERATOR
# =============================================================================

def fit_operator(
    X,
    Y,
    rank,
    ridge,
):

    X = X.float()
    Y = Y.float()

    mx = X.mean(
        dim=0,
        keepdim=True,
    )

    my = Y.mean(
        dim=0,
        keepdim=True,
    )

    Xc = X - mx
    Yc = Y - my

    _, _, Vhx = torch.linalg.svd(
        Xc,
        full_matrices=False,
    )

    _, _, Vhy = torch.linalg.svd(
        Yc,
        full_matrices=False,
    )

    r = min(
        rank,
        Vhx.shape[0],
        Vhy.shape[0],
    )

    Bx = (
        Vhx[:r]
        .T.contiguous()
    )

    By = (
        Vhy[:r]
        .T.contiguous()
    )

    Zx = Xc @ Bx
    Zy = Yc @ By

    I = torch.eye(
        r,
        dtype=torch.float32,
    )

    A = torch.linalg.solve(
        Zx.T @ Zx
        + ridge * I,
        Zx.T @ Zy,
    )

    return {
        "mx": mx.squeeze(0),
        "my": my.squeeze(0),
        "Bx": Bx,
        "By": By,
        "A": A,
        "rank": int(r),
        "ridge": float(ridge),
    }


def predict_operator(
    op,
    x,
):

    xc = (
        x.float()
        - op["mx"]
    )

    zx = xc @ op["Bx"]

    zy = zx @ op["A"]

    return (
        op["my"]
        + zy @ op["By"].T
    )


# =============================================================================
# 16. FORWARD MODEL SELECTION
# =============================================================================

print("\n[5/20] Forward transport operator seçiliyor...")

OPERATORS = {}
MODEL_SELECTION = {}

n_inner = int(
    round(
        len(TRAIN_PROMPTS)
        * INNER_TRAIN_FRAC
    )
)

inner_train = set(
    range(n_inner)
)

inner_val = set(
    range(
        n_inner,
        len(TRAIN_PROMPTS)
    )
)

for li in SOURCE_LAYERS:

    records = TRAIN_DATA[li]

    tr = [
        r for r in records
        if r["prompt_index"]
        in inner_train
    ]

    va = [
        r for r in records
        if r["prompt_index"]
        in inner_val
    ]

    Xtr = torch.stack([
        r["x"]
        for r in tr
    ])

    Ytr = torch.stack([
        r["y"]
        for r in tr
    ])

    candidates = []

    for rank in RANK_CANDIDATES:

        for ridge in RIDGE_CANDIDATES:

            op = fit_operator(
                Xtr,
                Ytr,
                rank,
                ridge,
            )

            vals = []

            for r in va:

                yh = predict_operator(
                    op,
                    r["x"],
                )

                vals.append(
                    cosine(
                        yh,
                        r["y"],
                    )
                )

            candidates.append({
                "rank":
                    op["rank"],
                "ridge":
                    ridge,
                "score":
                    float(
                        np.mean(vals)
                    ),
            })

    candidates.sort(
        key=lambda x:
            x["score"],
        reverse=True,
    )

    best = candidates[0]

    allX = torch.stack([
        r["x"]
        for r in records
    ])

    allY = torch.stack([
        r["y"]
        for r in records
    ])

    OPERATORS[li] = fit_operator(
        allX,
        allY,
        best["rank"],
        best["ridge"],
    )

    MODEL_SELECTION[li] = best

    print(
        f"L{li:02d}->L{li+1:02d} "
        f"rank={best['rank']:02d} "
        f"ridge={best['ridge']:.4g} "
        f"val={best['score']:+.4f}"
    )


# =============================================================================
# 17. INVERSE NAVIGATION
#
# Low-rank centered linear part:
#
#   z_y = z_x A
#
# Desired output target direction projected into By:
#
#   t_y = v_next @ By
#
# Solve row-vector ridge inverse:
#
#   z* = argmin ||z A - t_y||² + λ ||z||²
#
# Closed form:
#
#   z* = t_y A^T (A A^T + λI)^-1
#
# Then:
#
#   q_raw = z* Bx^T
#
# Finally constrain correction angle relative to historical v_l.
# =============================================================================

def inverse_direction(
    op,
    source_seed,
    target_seed,
    inv_lambda,
):

    A = op["A"].float()

    Bx = op["Bx"].float()
    By = op["By"].float()

    t = normalize(
        target_seed
    )

    # target coordinates in learned output subspace
    ty = (
        t @ By
    )

    r = A.shape[0]

    I = torch.eye(
        r,
        dtype=torch.float32,
    )

    # row-vector inverse solution
    z = (
        ty
        @ A.T
        @ torch.linalg.inv(
            A @ A.T
            + inv_lambda * I
        )
    )

    q_raw = (
        z @ Bx.T
    )

    q_raw = normalize(
        q_raw
    )

    if q_raw is None:
        return normalize(source_seed)

    v = normalize(
        source_seed
    )

    # orient same hemisphere
    if cosine(q_raw, v) < 0:
        q_raw = -q_raw

    theta = angle_deg(
        q_raw,
        v,
    )

    # Cap navigator deviation from historical seed.
    if theta > MAX_NAV_ANGLE_DEG:

        tangent = (
            q_raw
            - torch.dot(q_raw, v) * v
        )

        tangent = normalize(
            tangent
        )

        if tangent is None:
            return v

        th = math.radians(
            MAX_NAV_ANGLE_DEG
        )

        q_raw = normalize(
            math.cos(th) * v
            + math.sin(th) * tangent
        )

    return q_raw


# =============================================================================
# 18. CHOOSE INVERSE λ USING TRAIN-ONLY HELD-OUT PROMPTS
#
# Important:
# BLIND set is untouched.
# =============================================================================

print("\n[6/20] Inverse regularization train-only seçiliyor...")

INVERSE_SELECTION = {}
NAV_DIRECTIONS = {}

for li in SOURCE_LAYERS:

    # Use already selected forward operator geometry.
    # For lambda selection we evaluate whether the candidate direction,
    # according to held-out measured secants, is locally supported.
    #
    # Since exact candidate q was not physically probed in inner-val,
    # selection criterion is conservative:
    # predicted target alignment + proximity to historical seed.
    #
    # Actual causal test remains BLIND physical intervention.

    op = OPERATORS[li]

    rows = []

    for lam in INVERSE_LAMBDAS:

        q = inverse_direction(
            op,
            DIBEK[li],
            DIBEK[li + 1],
            lam,
        )

        # Forward prediction of navigator direction.
        #
        # Scale q approximately to mean realized training x norm,
        # because operator was fitted on finite perturbations.
        train_x_norm = float(
            np.mean([
                torch.linalg.vector_norm(
                    r["x"]
                ).item()
                for r in TRAIN_DATA[li]
            ])
        )

        x_sim = (
            train_x_norm
            * q
        )

        yhat = predict_operator(
            op,
            x_sim,
        )

        pred_target = cosine(
            yhat,
            DIBEK[li + 1],
        )

        nav_angle = angle_deg(
            q,
            DIBEK[li],
        )

        # Selection score is deliberately simple.
        # Primary experiment does NOT rely on this score;
        # physical blind intervention decides.
        score = (
            pred_target
            - 0.001 * nav_angle
        )

        rows.append({
            "lambda": lam,
            "pred_target":
                pred_target,
            "nav_angle":
                nav_angle,
            "score":
                score,
        })

    rows.sort(
        key=lambda z:
            z["score"],
        reverse=True,
    )

    best = rows[0]

    qbest = inverse_direction(
        op,
        DIBEK[li],
        DIBEK[li + 1],
        best["lambda"],
    )

    NAV_DIRECTIONS[li] = qbest

    INVERSE_SELECTION[li] = {
        "best":
            best,
        "candidates":
            rows,
    }

    print(
        f"L{li:02d}->L{li+1:02d} "
        f"lambda={best['lambda']:.4g} "
        f"angle={best['nav_angle']:.2f}° "
        f"pred={best['pred_target']:+.4f}"
    )


# =============================================================================
# 19. BUILD ANGLE-MATCHED RANDOM + REVERSE DIRECTIONS
# =============================================================================

ANGLE_RANDOM = {}
REVERSE = {}

for li in SOURCE_LAYERS:

    v = normalize(
        DIBEK[li]
    )

    q = normalize(
        NAV_DIRECTIONS[li]
    )

    theta = angle_deg(
        q,
        v,
    )

    # Random null with exactly same requested angle from seed.
    ANGLE_RANDOM[li] = make_angle_direction(
        v,
        theta,
        SEED + 900000 + li,
    )

    # Reverse the navigator correction tangent.
    tangent = (
        q
        - torch.dot(q, v) * v
    )

    tangent = normalize(
        tangent
    )

    if tangent is None:

        REVERSE[li] = v.clone()

    else:

        th = math.radians(theta)

        REVERSE[li] = normalize(
            math.cos(th) * v
            - math.sin(th) * tangent
        )


# =============================================================================
# 20. BLIND CAUSAL INTERVENTION
# =============================================================================

print("\n[7/20] BLIND causal navigation assay...")

BLIND_RESULTS = []

start = time.time()

for pi, prompt in enumerate(
    BLIND_PROMPTS
):

    base = baseline_pass(
        prompt
    )

    row = {
        "prompt_index": pi,
        "prompt": prompt,
        "layers": {},
    }

    for li in SOURCE_LAYERS:

        target = li + 1

        arms = {
            "FIXED":
                DIBEK[li],

            "NAVIGATOR":
                NAV_DIRECTIONS[li],

            "RANDOM":
                ANGLE_RANDOM[li],

            "REVERSE":
                REVERSE[li],
        }

        layer = {}

        for arm_name, direction in arms.items():

            rr = one_step_probe(
                prompt,
                base,
                li,
                direction,
            )

            dnext = cosine(
                rr["y"],
                DIBEK[target],
            )

            dold = cosine(
                rr["y"],
                DIBEK[li],
            )

            layer[arm_name] = {
                "D_next":
                    dnext,

                "D_old":
                    dold,

                "gain":
                    rr["gain"],

                "realized_rel":
                    rr["realized_rel"],

                "realized_dir_cos":
                    rr["dir_cos"],
            }

        # paired causal contrasts
        layer["CONTRASTS"] = {
            "NAV_MINUS_FIXED":
                layer["NAVIGATOR"]["D_next"]
                - layer["FIXED"]["D_next"],

            "NAV_MINUS_RANDOM":
                layer["NAVIGATOR"]["D_next"]
                - layer["RANDOM"]["D_next"],

            "NAV_MINUS_REVERSE":
                layer["NAVIGATOR"]["D_next"]
                - layer["REVERSE"]["D_next"],

            "FIXED_MINUS_RANDOM":
                layer["FIXED"]["D_next"]
                - layer["RANDOM"]["D_next"],
        }

        row["layers"][str(li)] = layer

    BLIND_RESULTS.append(row)

    if (pi + 1) % 5 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(BLIND_PROMPTS)} "
        f"| elapsed={(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"Blind assay completed in "
    f"{(time.time()-start)/60:.1f} min"
)


