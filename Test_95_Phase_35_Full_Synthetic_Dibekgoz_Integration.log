 # ===== FIRTINA TEK — uzunluk çöküşü birleşiğe mi özgü? =====
 "07_FIR_i0.08":          (S_BRIDGE,P_FIR, [0.08]),
 "08_FIR_i0.15":          (S_BRIDGE,P_FIR, [0.15]),
 # ===== DİBEK TEK, köprü bağlamında (Aşama 15'te uzunluğu korumuştu) =====
 "09_DIB_i0.08":          (S_BRIDGE,P_DIB, [0.08]),
 "10_DIB_i0.15":          (S_BRIDGE,P_DIB, [0.15]),
 # ===== NEGATİF KONTROL =====
 "11_RAST_i0.08":         (S_BRIDGE,P_RAST,[0.08]),
 "12_RAST_i0.15":         (S_BRIDGE,P_RAST,[0.15]),
 # ===== ZOO BAĞLAMI REGRESYONU (Aşama 14: NET +5.8) =====
 "13_DIB_zoo_i0.15":      (S_ZOO,  P_DIB,  [0.15]),
 "14_BIR_zoo_i0.15":      (S_ZOO,  P_BIR,  [0.15]),
}

R_("="*78); R_("  ÜRETİM (15 kol × 4 prompt)  — YOĞUNLUK = 100 kelime başına")
R_("="*78)
R_(f"    {'kol':<22}{'kel':>5}{'Δkel%':>7}{'köprü':>7}{'fırt':>6}{'SAHNE':>7}"
   f"{'hedef':>7}{'NET':>6}{'uzÇök':>7}{'KALİTE':>8}")
R_("    "+"-"*82)
RES={}; t0=time.time()
# önce tabanlar (uzunluk referansı için)
TABAN_KEL={}
for ad,(sn,pak,ivl) in KOLLAR.items():
    if pak is not None: continue
    ctx,sor=(CTX_B1,P_TETIK) if sn==S_BRIDGE else (CTX_ZOO,P_ZOO)
    outs=[uret(ctx,q)[0] for q in sor]
    TABAN_KEL[sn]=statistics.mean([kelime(o) for o in outs])
    RES[ad]={"sahne_seti":sn,"ivme":None,"texts":outs}
for ad,(sn,pak,ivl) in KOLLAR.items():
    try:
        ctx,sor=(CTX_B1,P_TETIK) if sn==S_BRIDGE else (CTX_ZOO,P_ZOO)
        if pak is None:
            outs=RES[ad]["texts"]; lg0=None
        else:
            outs,lg0=[],None
            for i,q in enumerate(sor):
                t_,lg=uret(ctx,q,pu=pak[0],hd=pak[1],ivmeler=ivl)
                outs.append(t_)
                if i==0: lg0=lg
        tk=TABAN_KEL[sn]
        d={"sahne_seti":sn,"ivme":ivl,
           "kelime":statistics.mean([kelime(o) for o in outs]),
           "kopru":statistics.mean([yogun(o,KOPRU_K) for o in outs]),
           "firtina":statistics.mean([yogun(o,FIRTINA_K) for o in outs]),
           "hedef":statistics.mean([yogun(o,HEDEF_K) for o in outs]),
           "anti":statistics.mean([yogun(o,ANTI_K) for o in outs]),
           "kopru_ham":statistics.mean([ham(o,KOPRU_K) for o in outs]),
           "firtina_ham":statistics.mean([ham(o,FIRTINA_K) for o in outs]),
           "hedef_ham":statistics.mean([ham(o,HEDEF_K) for o in outs]),
           "bozulma":statistics.mean([bozulma(o) for o in outs]),
           "tekrar":statistics.mean([tekrar(o) for o in outs]),
           "uz_cokus":statistics.mean([uzunluk_cokusu(o,tk) for o in outs]),
           "latin_disi":statistics.mean([latin_disi(o) for o in outs]),
           "oran_L0":float(lg0[0,5]) if lg0 is not None else float('nan'),
           "log":(lg0.tolist() if lg0 is not None else None),"texts":outs}
        d["net"]=d["hedef"]-d["anti"]
        d["sahne"]=d["kopru"]+d["firtina"]
        d["kalite"]=max(d["bozulma"],d["tekrar"],d["uz_cokus"])
        d["dkel"]=100.0*(d["kelime"]-tk)/max(tk,1e-6)
        RES[ad]=d
        R_(f"    {ad:<22}{d['kelime']:>5.0f}{d['dkel']:>+7.0f}{d['kopru']:>7.2f}"
           f"{d['firtina']:>6.2f}{d['sahne']:>7.2f}{d['hedef']:>7.2f}"
           f"{d['net']:>+6.2f}{d['uz_cokus']:>7.2f}{d['kalite']:>8.3f}")
    except Exception as ex:
        RES[ad]={"hata":f"{type(ex).__name__}: {ex}"}
        R_(f"    {ad:<22}  ❌ {type(ex).__name__}: {ex}")
R_(f"\n  ✅ üretim {time.time()-t0:.0f} sn\n")
def ok(a): return a in RES and "hata" not in RES[a] and "kalite" in RES[a]

