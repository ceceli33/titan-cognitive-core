# =============================================================================
# TEST 95 — AŞAMA 3 v2/6: "BOŞ KOLTUK" YÖNTEMİYLE DİBEKGOZ ÇEKİRDEĞİ
# =============================================================================
# NEDEN v2? İlk sürümde Dibekgoz'u "özelliklerin toplamı" (canlı+primat+
# bipedal+eller+kuyruksuz) olarak kurmuştuk. Doğrulama testi bunun aslında bir
# İNSAN tarifi olduğunu gösterdi (insan +0.246, goril +0.056). Çünkü
# özelliklerin toplamı matematiksel olarak MEVCUT kavramların arasına düşer.
#
# Ama Dibekgoz ne insan ne goril -- onlarla AKRABA, ayrı bir TÜR.
# Bu, "özellik toplamı" değil, "ailede boş bir koltuk" problemidir.
#
# YENİ YÖNTEM:
#   1. Gerçek maymun türlerini sondala (goril, şempanze, orangutan, bonobo,
#      gibon, insan) -> bunların MERKEZİ = "maymungillik" (aile aidiyeti)
#   2. Merkezden SAPMALARI = "tür-farklılık altuzayı" (bir tür diğerinden
#      nasıl ayrışır)
#   3. Bu altuzayda HİÇBİR gerçek türün oturmadığı yönü ara = BOŞ KOLTUK
#      (sentetik testte: rastgele yön en yakın türe 0.932, boş koltuk 0.276)
#   4. Dibekgoz = aile merkezi + boş koltuk + anatomik düzeltme
#      (bipedal + kuyruksuz + eller)
#
#   Yani "yenilik" bileşeni artık rastgele bir süs değil, gerçek türlerin
#   ayrışma uzayında ölçülmüş, boş bir konum. İşin ÖZÜ bu.
#
# DOĞRULAMA KRİTERİ DE DEĞİŞTİ:
#   Eski: "goril en yüksek olsun" (yanlış -- Dibekgoz goril değil)
#   Yeni: tüm maymunlara DENGELİ orta yakınlık, maymun-olmayanlara belirgin
#         uzaklık, ve hiçbir türe YAPIŞIK olmama.
#
# HÂLÂ ENJEKSİYON YOK. Kendi kendine yeter (dosya yoksa yeniden sondalar).
# ÇIKTI: dibekgoz_pusula_asama3v2.pt
# =============================================================================

import os, json, math, time
import torch
import torch.nn.functional as F
from transformers import AutoModelForCausalLM, AutoTokenizer

os.environ["TOKENIZERS_PARALLELISM"] = "false"
torch.backends.cudnn.deterministic = True

MODEL_ID = "Qwen/Qwen2.5-7B-Instruct"
OUT_PT   = "/content/dibekgoz_pusula_asama3v2.pt"
OUT_JSON = "/content/dibekgoz_asama3v2_rapor.json"

WINDOW    = list(range(10, 21))    # L10..L20 (Aşama 2 kararı)
SEED      = 42
SUBSPACE_K = 4        # tür-farklılık altuzayının boyutu
N_SEAT_SAMPLES = 300000

# Dibekgoz'un anatomik düzeltmeleri (aile merkezinden sapması)
# Bunlar Dibekgoz'u "insan yapmak" için değil, tarifteki ayırt edici
# özellikleri (iki ayak, kuyruksuz, kavrayan eller) vurgulamak için.
ANATOMY = {"bipedal": 0.35, "kuyruk": 0.25, "eller": 0.25}
BETA_SEAT = 0.55      # boş koltuğun ağırlığı: ne kadar "yeni tür"
GAMMA_ANAT = 0.30     # anatomik düzeltmenin ağırlığı

print(f"torch: {torch.__version__}  |  CUDA: {torch.version.cuda}")
if not torch.cuda.is_available():
    raise SystemExit("❌ GPU yok.")
print(f"✅ GPU: {torch.cuda.get_device_name(0)}\n")

# =============================================================================
