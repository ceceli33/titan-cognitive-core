# ---- Compass extraction: A_L = normalize(mean h_L(A) − mean h_L(B)), last prompt token, L0–L19 ----
@torch.inference_mode()
def capture20(text):
    e=tok(chat(text),return_tensors="pt").to(DEVICE)
    o=model(**e,output_hidden_states=True,use_cache=False,return_dict=True)
    p=int(e.attention_mask[0].sum())-1
    r=torch.stack([o.hidden_states[L+1][0,p].float().detach() for L in range(STEER_LAYERS)])  # hidden_states[L+1] = output of layer L
    del o;return r

def build_compass(ea,eb):
    A,B=lines(ea),lines(eb)
    if len(A)<2 or len(B)<2:raise gr.Error("Use at least two example sentences on each side.")
    if len(A)!=len(B):raise gr.Error(f"SIDE A has {len(A)} sentences and SIDE B has {len(B)}. They must be matched pairs, so use the same count.")
    if len(A)>32:raise gr.Error("Use at most 32 matched pairs.")
    if max(map(len,A+B))>400:raise gr.Error("Keep each example sentence under 400 characters.")
    HA=torch.stack([capture20(x) for x in A]);HB=torch.stack([capture20(x) for x in B])
    raw=HA.mean(0)-HB.mean(0);compass=norm(raw).contiguous()
    return compass,raw,A,B

# ---- SEASC hooks: registered on L0–L19 ONLY. L20–L27 never receive a hook. ----
def seasc_hooks(compass,sign,scale,telemetry=None,counter=None):
    def mk(li):
        def hk(m,args,out):
            raw=out[0] if isinstance(out,tuple) else out;B=raw.shape[0]
            a=(float(sign)*compass[li][None].expand(B,-1)).float().contiguous()
            dose=float(RHO[li])*float(scale)
            d=torch.full((B,),dose,device=raw.device,dtype=torch.float32)
            if telemetry is not None and li not in telemetry:
                hn=float(raw[0,-1].float().norm())   # norm of exactly the tensor handed to the kernel (pre-injection)
                telemetry[li]={"hidden_norm":hn,"rho":float(RHO[li]),"scale":float(scale),"effective_dose":dose,"injection_norm":hn*dose}
            if counter is not None:counter[li]=counter.get(li,0)+1
            new=seasc_ext.seasc_batch(raw,a,d)
            return new if not isinstance(out,tuple) else (new,)+tuple(out[1:])
        return hk
    hooks=[]
    try:
        for L in range(STEER_LAYERS):hooks.append(layers[L].register_forward_hook(mk(L)))
    except Exception:
        for h in hooks:h.remove()
        raise
    return hooks

# ---- X-Ray: vanilla vs steered hidden state at the last prompt token, all 28 layers ----
@torch.inference_mode()
def xray_prompt(prompt,compass,sign,scale):
    e=tok(chat(prompt),return_tensors="pt").to(DEVICE);pos=int(e.attention_mask[0].sum())-1
    def cap(store):
        def mk(li):
            def hk(m,args,out):
                h=out[0] if isinstance(out,tuple) else out
                store[li]=h[0,pos].float().detach().clone()
            return hk
        return [layers[L].register_forward_hook(mk(L)) for L in range(TOTAL_LAYERS)]
    vanilla,steered,telemetry={},{},{}
    hooks=[]
    try:
        hooks+=cap(vanilla);model(**e,use_cache=False,return_dict=True)
    finally:
        for h in hooks:h.remove()
    hooks=[]
    try:  # SEASC hooks registered FIRST → capture hooks see the already-injected output
        hooks+=seasc_hooks(compass,sign,scale,telemetry);hooks+=cap(steered)
        model(**e,use_cache=False,return_dict=True)
    finally:
        for h in hooks:h.remove()
    disp=[float((steered[L]-vanilla[L]).norm()/vanilla[L].norm().clamp_min(EPS)) for L in range(TOTAL_LAYERS)]
    return telemetry,disp

# ---- Generation: greedy, identical config for both runs. With use_cache=True the prefill injects all
#      prompt positions and every decode step injects the new token in L0–L19. ----
@torch.inference_mode()
def generate_text(prompt,compass=None,sign=1,scale=.5,max_new=96,counter=None):
    e=tok(chat(prompt),return_tensors="pt").to(DEVICE);n=e.input_ids.shape[1];hooks=[]
    try:
        if compass is not None and scale>0:hooks=seasc_hooks(compass,sign,scale,counter=counter)
        out=model.generate(**e,max_new_tokens=int(max_new),do_sample=False,temperature=None,top_p=None,top_k=None,
                           use_cache=True,pad_token_id=tok.pad_token_id,eos_token_id=tok.eos_token_id)
    finally:
        for h in hooks:h.remove()
    return tok.decode(out[0,n:],skip_special_tokens=True).strip(),int(out.shape[1]-n)

