print()

# Zarfı gerçek pencereye göre yeniden hesapla (güvenlik)
mid = (WINDOW[0] + WINDOW[-1]) / 2.0
sigma = len(WINDOW) / 3.2
ENV = {li: ENVELOPE_FLOOR + (1.0 - ENVELOPE_FLOOR)
           * math.exp(-((li - mid) ** 2) / (2 * sigma ** 2)) for li in WINDOW}

# Çekirdeği GPU'ya taşı
CORE_GPU = {li: CORE[li].to(device=device, dtype=torch.float32) for li in WINDOW}

STATE = {"alpha": 0.0, "stats": []}

def _make_inject_hook(li):
    def _hook(module, inputs, output):
        alpha = STATE["alpha"]
        if alpha == 0.0:
            return output                      # müdahale yok, aynen geç
        is_tuple = isinstance(output, tuple)
        h = output[0] if is_tuple else output
        orig_dtype = h.dtype
        hf = h.to(torch.float32)
        # ||h|| CANLI ölçülüyor: [batch, seq, 1]
        hn = hf.norm(dim=-1, keepdim=True)
        k = alpha * ENV[li] * hn               # oransal şiddet
        hf = hf + k * CORE_GPU[li]
        STATE["stats"].append((li, float(hn.mean()), float((k).mean())))
        h_new = hf.to(orig_dtype)
        if is_tuple:
            return (h_new,) + tuple(output[1:])
        return h_new
    return _hook

_handles = [model.model.layers[li].register_forward_hook(_make_inject_hook(li))
            for li in WINDOW]
print(f"✅ {len(_handles)} adet ENJEKSİYON hook'u kuruldu "
      f"(bu sefer gerçekten yazıyor).\n")

eos_ids = list({tok.eos_token_id,
                tok.convert_tokens_to_ids("<|im_end|>"),
                tok.convert_tokens_to_ids("<|endoftext|>")} - {None, -1})

@torch.no_grad()
def generate(question, alpha):
    STATE["alpha"] = alpha
    STATE["stats"] = []
    prompt = (f"<|im_start|>system\nYou are a helpful, accurate, and thoughtful "
              f"assistant.<|im_end|>\n<|im_start|>user\n{question}"
              f"<|im_end|>\n<|im_start|>assistant\n")
    enc = tok(prompt, return_tensors="pt").to(device)
    t0 = time.time()
    out = model.generate(**enc, max_new_tokens=MAX_TOKENS, do_sample=False,
                          repetition_penalty=1.15, pad_token_id=tok.pad_token_id,
                          eos_token_id=eos_ids)
    ms = (time.time() - t0) * 1000
    n_in = enc["input_ids"].shape[1]
    n_out = out.shape[1] - n_in
    text = tok.decode(out[0][n_in:], skip_special_tokens=True).strip()
    # ortalama müdahale oranı
    if STATE["stats"]:
        ratios = [k / (h + 1e-9) for _, h, k in STATE["stats"]]
        mean_ratio = sum(ratios) / len(ratios)
        mean_hn = sum(h for _, h, _ in STATE["stats"]) / len(STATE["stats"])
    else:
        mean_ratio, mean_hn = 0.0, 0.0
    STATE["alpha"] = 0.0
    return text, n_out, ms, mean_ratio, mean_hn

def repetition_score(text):
    """Bozulmanın ilk işareti: aynı 5-gram kaç kez tekrarlıyor."""
    w = re.findall(r"\w+", text.lower())
    if len(w) < 12: return 0.0
    grams = [" ".join(w[i:i+5]) for i in range(len(w)-4)]
    c = Counter(grams)
    return (sum(v-1 for v in c.values() if v > 1)) / max(1, len(grams))

