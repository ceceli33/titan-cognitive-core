print("  'kontrol' sorusu Dibekgoz ile ilgisiz -- enjeksiyonun genel dili")
print("  bozup bozmadığını görmek için. Orada bozulma başlarsa alpha fazla.\n")

results = {}
for qname, q in QUESTIONS.items():
    print(f"\n{'#'*78}")
    print(f"# SORU: {qname}")
    print(f"# {q}")
    print(f"{'#'*78}")
    results[qname] = {}
    for alpha in ALPHA_GRID:
        text, n_out, ms, ratio, hn = generate(q, alpha)
        rep = repetition_score(text)
        results[qname][str(alpha)] = {
            "text": text, "n_out": n_out, "ms": ms,
            "mudahale_orani": ratio, "ortalama_h_norm": hn,
            "tekrar_orani": rep,
        }
        flag = ""
        if rep > 0.25: flag = "  ⚠️ YÜKSEK TEKRAR (bozulma?)"
        elif rep > 0.12: flag = "  ⚠️ tekrar artıyor"
        print(f"\n{'─'*78}")
        print(f"  alpha={alpha:<6.2f} | müdahale={ratio*100:5.2f}% of ||h|| "
              f"| {n_out:>3} token | tekrar={rep:.3f}{flag}")
        print(f"{'─'*78}")
        print(text[:1400] + ("..." if len(text) > 1400 else ""))
        gc_ok = True
    print()

