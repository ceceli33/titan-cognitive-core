sigma = len(WINDOW) / 3.2
ENV = {}
for li in WINDOW:
    g = math.exp(-((li - mid) ** 2) / (2 * sigma ** 2))
    ENV[li] = ENVELOPE_FLOOR + (1.0 - ENVELOPE_FLOOR) * g

print("Katman zarfı (müdahale profili):")
for li in WINDOW:
    print(f"  L{li:<4} {ENV[li]:.3f}  {'█'*int(ENV[li]*40)}")
