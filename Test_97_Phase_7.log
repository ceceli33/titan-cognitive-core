    MODEL_NAME,
    trust_remote_code=True
)

model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME,
    torch_dtype=DTYPE,
    device_map="auto",
    trust_remote_code=True
)

model.eval()

try:
    layers = model.model.layers
except AttributeError:
    layers = model.transformer.h

print(f"Model hazır.")
print(f"Katman sayısı: {len(layers)}")

