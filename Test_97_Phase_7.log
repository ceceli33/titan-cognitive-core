# 4 — AKTİVASYONLARI ÇIKAR
# =============================================================================

print("\n[4/8] 24 AKTİVASYON SETİ ÇIKARILIYOR")

def collect_layerwise_activations(texts):

    all_batches = []

    for start in range(
        0,
        len(texts),
        ACT_BATCH_SIZE
    ):

        batch_texts = texts[
            start:start + ACT_BATCH_SIZE
        ]

        enc = tokenizer(
            batch_texts,
            return_tensors="pt",
            padding=True,
            truncation=True
        )

        input_ids = enc["input_ids"].to(DEVICE)
        attention_mask = enc["attention_mask"].to(DEVICE)

        with torch.no_grad():

            out = model(
                input_ids=input_ids,
                attention_mask=attention_mask,
                output_hidden_states=True,
                use_cache=False
            )

        hs = out.hidden_states

        batch_result = []

        for b in range(input_ids.shape[0]):

            mask = attention_mask[b].bool()

            layer_result = []

            for layer_idx in range(N_LAYERS):

                h = hs[layer_idx + 1][b]

                v = h[mask].float().mean(dim=0)

                layer_result.append(v)

            batch_result.append(
                torch.stack(
                    layer_result,
                    dim=0
                )
            )

        all_batches.append(
            torch.stack(
                batch_result,
                dim=0
            ).cpu()
        )

        del out
        del hs
        del input_ids
        del attention_mask
        del enc

        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    return torch.cat(
        all_batches,
        dim=0
    )


act_above = collect_layerwise_activations(
    TRAIN_ABOVE
).float()

act_below = collect_layerwise_activations(
    TRAIN_BELOW
).float()

act_neutral = collect_layerwise_activations(
    TRAIN_NEUTRAL
).float()

print("Aktivasyon şekilleri:")
