print("\n[7/8] GENERATION MOTORU HAZIR")

ABOVE_TERMS = [
    "above",
    "over",
    "higher",
    "atop",
    "overhead",
    "upper"
]

BELOW_TERMS = [
    "below",
    "under",
    "lower",
    "beneath",
    "underneath"
]

def count_terms(
    text,
    terms
):

    low = text.lower()

    return sum(
        low.count(term)
        for term in terms
    )


def run_arm(
    arm_name,
    vector=None,
    active_layer=None
):

    print(
        f"\n{'=' * 80}"
    )

    print(
        f"{arm_name}"
        + (
            f"  |  AKTİF KATMAN L{active_layer}"
            if active_layer is not None
            else ""
        )
    )

    print(
        f"{'=' * 80}"
    )

    state = None
    handle = None

    if vector is not None:

        state = DRAState(
            vector=vector,
            ivme=IVME
        )

        handle = layers[
            active_layer
        ].register_forward_hook(
            make_hook(
                active_layer,
                state
            )
        )

    outputs = []

    try:

        for prompt_index, prompt in enumerate(
            PROMPTS
        ):

            messages = [
                {
                    "role": "user",
                    "content": prompt
                }
            ]

            chat_text = tokenizer.apply_chat_template(
                messages,
                tokenize=False,
                add_generation_prompt=True
            )

            inputs = tokenizer(
                chat_text,
                return_tensors="pt"
            )

            inputs = {
                k: v.to(DEVICE)
                for k, v in inputs.items()
            }

            with torch.no_grad():

                generated = model.generate(
                    **inputs,
                    max_new_tokens=MAX_NEW_TOKENS,
                    do_sample=False,
                    repetition_penalty=REPETITION_PENALTY,
                    use_cache=True
                )

            prompt_len = (
                inputs[
                    "input_ids"
                ].shape[1]
            )

            answer = tokenizer.decode(
                generated[
                    0,
                    prompt_len:
                ],
                skip_special_tokens=True
            ).strip()

            outputs.append(
                answer
            )

            print(
                f"  prompt "
                f"{prompt_index + 1}/"
                f"{len(PROMPTS)}"
                f" tamam"
            )

    finally:

        if handle is not None:
            handle.remove()

        if torch.cuda.is_available():
            torch.cuda.empty_cache()

        gc.collect()

    above_counts = [
        count_terms(
            x,
            ABOVE_TERMS
        )
        for x in outputs
    ]

    below_counts = [
        count_terms(
            x,
            BELOW_TERMS
        )
        for x in outputs
    ]

    net_counts = [
        a - b
        for a, b in zip(
            above_counts,
            below_counts
        )
    ]

    word_counts = [
        len(x.split())
        for x in outputs
    ]

    repetition = [
        1.0
        - (
            len(
                set(
                    x.lower().split()
                )
            )
            / max(
                1,
                len(
                    x.split()
                )
            )
        )
        for x in outputs
    ]

    result = {

        "arm": arm_name,

        "active_layer":
            active_layer,

        "ivme":
            0.0
            if vector is None
            else IVME,

        "outputs":
            outputs,

        "above_counts":
            above_counts,

        "below_counts":
            below_counts,

        "net_counts":
            net_counts,

        "mean_above":
            float(
                np.mean(
                    above_counts
                )
            ),

        "mean_below":
            float(
                np.mean(
                    below_counts
                )
            ),

        "mean_net":
            float(
                np.mean(
                    net_counts
                )
            ),

        "mean_words":
            float(
                np.mean(
                    word_counts
                )
            ),

        "mean_repetition_ratio":
            float(
                np.mean(
                    repetition
                )
            )
    }

    if state is not None:

        all_cos = torch.cat(
            state.cos_history
        )

        all_contribution = torch.cat(
            state.contribution_history
        )

        result["dra"] = {

            "mean_cos":
                float(
                    all_cos.mean()
                ),

            "mean_abs_cos":
                float(
                    all_cos.abs().mean()
                ),

            "mean_contribution":
                float(
                    all_contribution.mean()
                ),

            "mean_envelope":
                float(
                    np.mean(
                        state.envelope_history
                    )
                ),

            "mean_brake":
                float(
                    np.mean(
                        state.brake_history
                    )
                ),

            "steps":
                state.step_count
        }

    return result

