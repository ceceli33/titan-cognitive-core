print("\n[5/8] IND_ABOVE / IND_BELOW OLUŞTURULUYOR")

mean_above = act_above.mean(dim=0)
mean_below = act_below.mean(dim=0)
mean_neutral = act_neutral.mean(dim=0)

def normalize_layerwise(v):

    return v / torch.linalg.vector_norm(
        v,
        dim=-1,
        keepdim=True
    ).clamp_min(1e-12)

# TEST 99 ile aynı:
#
# ABOVE = ABOVE - NEUTRAL
# BELOW = BELOW - NEUTRAL
#
# Böylece BELOW artık -PUSULA değildir.

IND_ABOVE = normalize_layerwise(
    mean_above - mean_neutral
)

IND_BELOW = normalize_layerwise(
    mean_below - mean_neutral
)

assert tuple(IND_ABOVE.shape) == (
    N_LAYERS,
    HIDDEN_DIM
)

assert tuple(IND_BELOW.shape) == (
    N_LAYERS,
    HIDDEN_DIM
)

print(
    "IND_ABOVE:",
    tuple(IND_ABOVE.shape)
)

print(
    "IND_BELOW:",
    tuple(IND_BELOW.shape)
)

# =============================================================================
# 6 — DRA MOTORU
# =============================================================================

print("\n[6/8] DRA MOTORU HAZIRLANIYOR")

def dra_envelope(
    layer_idx,
    cos_value
):

    unc = 1.0 - abs(cos_value)

    dw = (
        SONUM
        + unc * UNC_GAIN
    )

    kb = (
        ZIRVE
        * math.exp(
            -dw * layer_idx
        )
        * (
            1.0
            + dw * layer_idx
        )
        + TABAN
    )

    return kb / (
        ZIRVE + TABAN
    )


class DRAState:

    def __init__(
        self,
        vector,
        ivme
    ):

        self.vector = vector.to(
            DEVICE
        ).float()

        self.ivme = ivme

        self.cos_history = []
        self.contribution_history = []
        self.envelope_history = []
        self.brake_history = []

        self.step_count = 0


def make_hook(
    active_layer,
    state
):

    def hook(
        module,
        inputs,
        output
    ):

        tuple_mode = isinstance(
            output,
            tuple
        )

        h = (
            output[0]
            if tuple_mode
            else output
        )

        last_h = h[:, -1, :].float()

        p = state.vector[
            active_layer
        ]

        h_norm = torch.linalg.vector_norm(
            last_h,
            dim=-1,
            keepdim=True
        ).clamp_min(1e-12)

        p_norm = torch.linalg.vector_norm(
            p
        ).clamp_min(1e-12)

        cos = (
            torch.sum(
                last_h * p,
                dim=-1,
                keepdim=True
            )
            / (
                h_norm
                * p_norm
            )
        ).clamp(
            -1.0,
            1.0
        )

        cos_scalar = (
            cos.detach()
            .float()
            .mean()
            .item()
        )

        zarf = dra_envelope(
            active_layer,
            cos_scalar
        )

        # TEST 99 ile aynı brake
        if cos_scalar > COS_SAT:

            brake = (
                1.0 - cos_scalar
            ) / (
                1.0 - COS_SAT
            )

        elif cos_scalar < COS_NEG:

            brake = 1.6

        else:

            brake = 1.0

        magnitude = (
            state.ivme
            * h_norm
            / SQRT_K
            * zarf
            * brake
        )

        delta = (
            magnitude
            * p.view(
                1,
                1,
                -1
            )
        )

        h_new = h.clone()

        h_new[:, -1:, :] = (
            h_new[:, -1:, :]
            + delta.to(
                h_new.dtype
            )
        )

        state.cos_history.append(
            cos.detach()
            .float()
            .cpu()
        )

        state.contribution_history.append(
            magnitude.detach()
            .float()
            .cpu()
        )

        state.envelope_history.append(
            float(zarf)
        )

        state.brake_history.append(
            float(brake)
        )

        state.step_count += 1

        if tuple_mode:

            return (
                h_new,
            ) + output[1:]

        return h_new

    return hook

