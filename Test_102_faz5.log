# =============================================================================
# 10. FIXED TANGENT ATLAS
#
# Critical:
# candidate ID means the SAME tangent direction across all prompts
# for a given layer.
#
# Therefore:
#
#   oracle prompt-specific candidate
#   vs
#   global best candidate
#
# is meaningful.
# =============================================================================

print("\n[4/22] Sabit tangent atlas oluşturuluyor...")

ATLAS = {}

for li in SOURCE_LAYERS:

    v = normalize(
        DIBEK[li]
    )

    ATLAS[li] = {}

    for shell in SHELLS_DEG:

        shell_dirs = []

        for di in range(
            N_DIRECTIONS_PER_SHELL
        ):

            g = torch.Generator(
                device="cpu"
            )

            g.manual_seed(
                SEED
                + 100000 * li
                + 1000 * int(shell * 10)
                + di
            )

            z = torch.randn(
                HIDDEN,
                generator=g,
                dtype=torch.float32,
            )

            u = (
                z
                - torch.dot(z, v) * v
            )

            u = normalize(u)

            th = math.radians(shell)

            q = normalize(
                math.cos(th) * v
                + math.sin(th) * u
            )

            shell_dirs.append({
                "candidate_id":
                    di,

                "requested_angle":
                    shell,

                "tangent":
                    u,

                "direction":
                    q,
            })

        ATLAS[li][shell] = shell_dirs

print(
    "Atlas:",
    len(SOURCE_LAYERS),
    "layers ×",
    len(SHELLS_DEG),
    "shells ×",
    N_DIRECTIONS_PER_SHELL,
    "directions",
)


# =============================================================================
# 11. BASELINE PASS
# =============================================================================

@torch.no_grad()
def baseline_pass(prompt):

    captures = {}
    handles = []

    def make_hook(li):

        def hook(module, inp, out):

            h = (
                out[0]
                if isinstance(out, tuple)
                else out
            )

            captures[li] = (
                h[0, -1]
                .detach()
                .float()
                .cpu()
                .clone()
            )

        return hook

    try:

        for li in range(VECTOR_LAYERS):

            handles.append(
                model.model.layers[li]
                .register_forward_hook(
                    make_hook(li)
                )
            )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    return captures


# =============================================================================
# 12. ONE-STEP PHYSICAL PROBE
# =============================================================================

@torch.no_grad()
def one_step_probe(
    prompt,
    baseline,
    li,
    direction,
):

    target = li + 1

    q = normalize(direction)

    if q is None:
        raise RuntimeError(
            "Zero direction"
        )

    src_base = baseline[li].float()

    requested_norm = (
        PROBE_REL
        * float(
            torch.linalg.vector_norm(
                src_base
            )
        )
    )

    q_gpu = q.to(device)

    source_delta = {}
    target_cap = {}

    handles = []

    def source_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        before = (
            h[0, -1]
            .float()
        )

        hnew = h.clone()

        hnew[0, -1] = (
            before
            + requested_norm * q_gpu
        ).to(h.dtype)

        ds = (
            hnew[0, -1].float()
            - before
        )

        source_delta["x"] = (
            ds.detach()
            .cpu()
            .clone()
        )

        if isinstance(out, tuple):

            return (
                (hnew,)
                + out[1:]
            )

        return hnew

    def target_hook(
        module,
        inp,
        out,
    ):

        h = (
            out[0]
            if isinstance(out, tuple)
            else out
        )

        target_cap["h"] = (
            h[0, -1]
            .detach()
            .float()
            .cpu()
            .clone()
        )

    try:

        handles.append(
            model.model.layers[li]
            .register_forward_hook(
                source_hook
            )
        )

        handles.append(
            model.model.layers[target]
            .register_forward_hook(
                target_hook
            )
        )

        enc = tokenizer(
            prompt,
            return_tensors="pt",
        ).to(device)

        model(
            **enc,
            use_cache=False,
        )

    finally:

        for h in handles:
            h.remove()

    x = source_delta["x"]

    y = (
        target_cap["h"]
        - baseline[target]
    )

    xnorm = float(
        torch.linalg.vector_norm(x)
    )

    ynorm = float(
        torch.linalg.vector_norm(y)
    )

    srcnorm = float(
        torch.linalg.vector_norm(
            src_base
        )
    )

    return {
        "x":
            x,

        "y":
            y,

        "realized_rel":
            xnorm
            / (srcnorm + EPS),

        "requested_dir_cos":
            cosine(
                x,
                q,
            ),

        "gain":
            ynorm
            / (xnorm + EPS),

        "D_next":
            cosine(
                y,
                DIBEK[target],
            ),

        "D_old":
            cosine(
                y,
                DIBEK[li],
            ),
    }


