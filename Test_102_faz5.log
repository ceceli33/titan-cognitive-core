    )


# =============================================================================
# 16. GLOBAL-BEST CANDIDATE PER LAYER/SHELL
#
# Important:
#
# Oracle:
#   each prompt may choose a different candidate.
#
# Global best:
#   one candidate ID is chosen using ALL prompts for a given layer+shell.
#
# If oracle >> global-best:
#   possible prompt dependence.
#
# But same-data global selection is optimistic.
# Therefore this is SYSTEM-ID evidence only.
# =============================================================================

print("\n[8/22] Prompt oracle vs global fixed correction...")

GLOBAL_BEST = {}

for li in SOURCE_LAYERS:

    GLOBAL_BEST[str(li)] = {}

    for shell in SHELLS_DEG:

        candidate_means = []

        for cid in range(
            N_DIRECTIONS_PER_SHELL
        ):

            vals = []

            for row in RESULTS:

                candidates = (
                    row["layers"][str(li)]
                    ["shells"][str(shell)]
                    ["candidates"]
                )

                c = candidates[cid]

                assert (
                    c["candidate_id"]
                    == cid
                )

                vals.append(
                    c["delta_vs_fixed"]
                )

            candidate_means.append(
                safe_mean(vals)
            )

        best_id = int(
            np.argmax(
                candidate_means
            )
        )

        GLOBAL_BEST[str(li)][str(shell)] = {
            "candidate_id":
                best_id,

            "mean_delta":
                float(
                    candidate_means[
                        best_id
                    ]
                ),

            "all_candidate_means":
                [
                    float(x)
                    for x
                    in candidate_means
                ],
        }


# =============================================================================
# 17. ORACLE vs GLOBAL-BEST GAP
# =============================================================================

ORACLE_GLOBAL_GAP = {}

for shell in SHELLS_DEG:

    oracle_vals = []
    global_vals = []

    for row in RESULTS:

        for li in SOURCE_LAYERS:

            sh = (
                row["layers"][str(li)]
                ["shells"][str(shell)]
            )

            oracle_vals.append(
                sh[
                    "oracle_delta_vs_fixed"
                ]
            )

            best_id = (
                GLOBAL_BEST[str(li)]
                [str(shell)]
                ["candidate_id"]
            )

            global_candidate = (
                sh["candidates"][
                    best_id
                ]
            )

            global_vals.append(
                global_candidate[
                    "delta_vs_fixed"
                ]
            )

    oracle_vals = np.asarray(
        oracle_vals,
        dtype=np.float64,
    )

    global_vals = np.asarray(
        global_vals,
        dtype=np.float64,
    )

    gap = (
        oracle_vals
        - global_vals
    )

    ORACLE_GLOBAL_GAP[str(shell)] = {
        "oracle":
            stats(oracle_vals),

        "global_best":
            stats(global_vals),

        "oracle_minus_global":
            stats(gap),
    }


print("\n[9/22] ORACLE vs GLOBAL FIXED")
print("=" * 150)

print(
    f"{'SHELL':<10}"
    f"{'ORACLE Δ':>15}"
    f"{'GLOBAL Δ':>15}"
    f"{'O-G GAP':>15}"
    f"{'GLOBAL +':>12}"
)

print("-" * 150)

for shell in SHELLS_DEG:

    z = (
        ORACLE_GLOBAL_GAP[
            str(shell)
        ]
    )

    print(
        f"{shell:<10.1f}"
        f"{z['oracle']['mean']:>+15.6f}"
        f"{z['global_best']['mean']:>+15.6f}"
        f"{z['oracle_minus_global']['mean']:>+15.6f}"
        f"{z['global_best']['positive_fraction']:>12.3f}"
    )


# =============================================================================
# 18. PROMPT-SPECIFIC WINNER DIVERSITY
#
# If one ID wins almost everywhere, state conditioning is weak.
#
# If many IDs win, that alone is NOT proof:
# winner noise can also create diversity.
#
# We therefore report:
#
#   unique IDs
#   modal winner fraction
#   entropy
#
# as descriptive diagnostics.
# =============================================================================

print("\n[10/22] Winner diversity...")

WINNER_DIVERSITY = {}

for shell in SHELLS_DEG:

    all_winners = []

    per_layer = {}

    for li in SOURCE_LAYERS:

        winners = []

        for row in RESULTS:

            winners.append(
                row["layers"][str(li)]
                ["shells"][str(shell)]
                ["oracle_candidate_id"]
            )

        counts = np.bincount(
            winners,
            minlength=
                N_DIRECTIONS_PER_SHELL,
        )

        probs = (
            counts
            / np.sum(counts)
        )

        nz = probs[
            probs > 0
        ]

        entropy = float(
            -np.sum(
                nz * np.log(nz)
            )
        )

        entropy_norm = (
            entropy
            / math.log(
                N_DIRECTIONS_PER_SHELL
            )
        )

        per_layer[str(li)] = {
            "unique_winners":
                int(
                    np.sum(counts > 0)
                ),

            "modal_fraction":
                float(
                    np.max(probs)
                ),

            "normalized_entropy":
                float(
                    entropy_norm
                ),

            "counts":
                counts.tolist(),
        }

        all_winners.extend(
            winners
        )

    counts_all = np.bincount(
        all_winners,
        minlength=
            N_DIRECTIONS_PER_SHELL,
    )

    probs_all = (
        counts_all
        / np.sum(counts_all)
    )

    nz = probs_all[
        probs_all > 0
    ]

    ent = float(
        -np.sum(
            nz * np.log(nz)
        )
    )

    ent_norm = (
        ent
        / math.log(
            N_DIRECTIONS_PER_SHELL
        )
    )

    WINNER_DIVERSITY[str(shell)] = {
        "overall_unique":
            int(
                np.sum(
                    counts_all > 0
                )
            ),

        "overall_modal_fraction":
            float(
                np.max(
                    probs_all
                )
            ),

        "overall_normalized_entropy":
            float(
                ent_norm
            ),

        "per_layer":
            per_layer,
    }

    print(
        f"{shell:>4.1f}° | "
        f"unique="
        f"{WINNER_DIVERSITY[str(shell)]['overall_unique']}"
        f"/{N_DIRECTIONS_PER_SHELL} "
        f"| modal="
        f"{WINNER_DIVERSITY[str(shell)]['overall_modal_fraction']:.3f} "
        f"| entropy="
        f"{WINNER_DIVERSITY[str(shell)]['overall_normalized_entropy']:.3f}"
    )


# =============================================================================
# 19. CROSS-PROMPT SPLIT VALIDATION
#
# This is crucial.
#
# First 20 prompts choose the best candidate ID for each layer/shell.
# Second 20 prompts evaluate it.
#
# Then reverse:
# second 20 choose -> first 20 evaluate.
#
# This tests whether there is a globally useful correction that generalizes.
#
# If oracle is positive but split-global is ~0:
# candidate benefit is likely prompt-specific OR winner noise.
#
# State dependence is NOT proven until a state sensor predicts the winner
# on later blind prompts.
# =============================================================================

print("\n[11/22] Cross-prompt fixed-correction validation...")

SPLIT_VALIDATION = {}

HALF_A = list(range(20))
HALF_B = list(range(20, 40))


def select_candidate(
    li,
    shell,
    train_indices,
):

    means = []

    for cid in range(
        N_DIRECTIONS_PER_SHELL
    ):

        vals = []

        for pi in train_indices:

            c = (
                RESULTS[pi]
                ["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"][cid]
            )

            vals.append(
                c["delta_vs_fixed"]
            )

        means.append(
            safe_mean(vals)
        )

    return int(
        np.argmax(means)
    )


for shell in SHELLS_DEG:

    heldout_values = []

    directions = []

    # A -> B
    for li in SOURCE_LAYERS:

        cid = select_candidate(
            li,
            shell,
            HALF_A,
        )

        directions.append({
            "direction":
                "A_to_B",
            "layer":
                li,
            "candidate_id":
                cid,
        })

        for pi in HALF_B:

            c = (
                RESULTS[pi]
                ["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"][cid]
            )

            heldout_values.append(
                c["delta_vs_fixed"]
            )

    # B -> A
    for li in SOURCE_LAYERS:

        cid = select_candidate(
            li,
            shell,
            HALF_B,
        )

        directions.append({
            "direction":
                "B_to_A",
            "layer":
                li,
            "candidate_id":
                cid,
        })

        for pi in HALF_A:

            c = (
                RESULTS[pi]
                ["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"][cid]
            )

            heldout_values.append(
                c["delta_vs_fixed"]
            )

    SPLIT_VALIDATION[str(shell)] = {
        "heldout_delta":
            stats(
                heldout_values
            ),

        "selected":
            directions,
    }

    s = (
        SPLIT_VALIDATION[
            str(shell)
        ]["heldout_delta"]
    )

    print(
        f"{shell:>4.1f}° "
        f"held-out fixed correction Δ="
        f"{s['mean']:+.6f} "
        f"{ci(s)} "
        f"| positive="
        f"{s['positive_fraction']:.3f}"
    )


# =============================================================================
# 20. PROMPT-SPECIFICITY / REPEATABILITY TEST
#
# Stronger diagnostic:
#
# Split candidate IDs into two independent sub-atlases:
#
#   even IDs
#   odd IDs
#
# Ask whether prompts that benefit strongly in one sub-atlas also
# benefit strongly in the other.
#
# This avoids using exactly the same candidate winner twice.
#
# We compute, within each layer+shell:
#
#   oracle_even(prompt)
#   oracle_odd(prompt)
#
# and their correlation across prompts.
#
# Positive repeatability means some prompts genuinely have more local
# correction opportunity than others.
#
# It does NOT yet predict WHICH direction is best.
# =============================================================================

print("\n[12/22] Prompt-level opportunity repeatability...")

REPEATABILITY = {}

for shell in SHELLS_DEG:

    layer_corrs = []

    layer_details = {}

    for li in SOURCE_LAYERS:

        even_oracle = []
        odd_oracle = []

        for row in RESULTS:

            candidates = (
                row["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"]
            )

            even = [
                c["delta_vs_fixed"]
                for c in candidates
                if c["candidate_id"] % 2 == 0
            ]

            odd = [
                c["delta_vs_fixed"]
                for c in candidates
                if c["candidate_id"] % 2 == 1
            ]

            even_oracle.append(
                max(even)
            )

            odd_oracle.append(
                max(odd)
            )

        x = np.asarray(
            even_oracle,
            dtype=np.float64,
        )

        y = np.asarray(
            odd_oracle,
            dtype=np.float64,
        )

        if (
            np.std(x) > 0
            and np.std(y) > 0
        ):

            r = float(
                np.corrcoef(
                    x,
                    y,
                )[0, 1]
            )

        else:

            r = float("nan")

        layer_corrs.append(r)

        layer_details[str(li)] = {
            "pearson":
                r,

            "even_mean":
                safe_mean(x),

            "odd_mean":
                safe_mean(y),
        }

    REPEATABILITY[str(shell)] = {
        "mean_layer_correlation":
            safe_mean(
                layer_corrs
            ),

        "positive_layer_fraction":
            float(
                np.mean(
                    np.asarray(
                        layer_corrs
                    ) > 0
                )
            ),

        "layers":
            layer_details,
    }

    print(
        f"{shell:>4.1f}° | "
        f"mean layer r="
        f"{REPEATABILITY[str(shell)]['mean_layer_correlation']:+.4f} "
        f"| positive layers="
        f"{REPEATABILITY[str(shell)]['positive_layer_fraction']:.3f}"
    )


# =============================================================================
# 21. LAYER-WISE ORACLE OPPORTUNITY
# =============================================================================

print("\n[13/22] Layer-wise local opportunity...")

LAYER_OPPORTUNITY = {}

for li in SOURCE_LAYERS:

    LAYER_OPPORTUNITY[str(li)] = {}

    print(
        f"\nL{li}->L{li+1}"
    )

    for shell in SHELLS_DEG:

        vals = [
            row["layers"][str(li)]
            ["shells"][str(shell)]
            ["oracle_delta_vs_fixed"]
            for row in RESULTS
        ]

        s = stats(vals)

        LAYER_OPPORTUNITY[
            str(li)
        ][str(shell)] = s

        print(
            f"  {shell:>4.1f}° "
            f"oracle Δ="
            f"{s['mean']:+.6f} "
            f"{ci(s)} "
            f"| +="
            f"{s['positive_fraction']:.3f}"
        )


# =============================================================================
# 22. CONTEXT DESCRIPTIVE CHECK
#
# NOT causal because animal and neutral prompts are unmatched.
# =============================================================================

print("\n[14/22] Context descriptive check...")

CONTEXT = {}

for shell in SHELLS_DEG:

    animal = []
    neutral = []

    for row in RESULTS:

        for li in SOURCE_LAYERS:

            val = (
                row["layers"][str(li)]
                ["shells"][str(shell)]
                ["oracle_delta_vs_fixed"]
            )

            if row["group"] == "ANIMAL":
                animal.append(val)
            else:
                neutral.append(val)

    a = safe_mean(animal)
    n = safe_mean(neutral)

    CONTEXT[str(shell)] = {
        "animal":
            a,

        "neutral":
            n,

        "difference":
            a - n,
    }

    print(
        f"{shell:>4.1f}° "
        f"ANIMAL={a:+.6f} "
        f"NEUTRAL={n:+.6f} "
        f"diff={a-n:+.6f}"
    )


# =============================================================================
# 23. ACTUATOR AUDIT
# =============================================================================

print("\n[15/22] Actuator audit...")

FIXED_REL = []
FIXED_DIR = []

CAND_REL = []
CAND_DIR = []

for row in RESULTS:

    for li in SOURCE_LAYERS:

        f = (
            row["layers"][str(li)]
            ["FIXED"]
        )

        FIXED_REL.append(
            f["realized_rel"]
        )

        FIXED_DIR.append(
            f["requested_dir_cos"]
        )

        for shell in SHELLS_DEG:

            for c in (
                row["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"]
            ):

                CAND_REL.append(
                    c["realized_rel"]
                )

                CAND_DIR.append(
                    c["requested_dir_cos"]
                )

FIXED_REL_S = stats(
    FIXED_REL
)

FIXED_DIR_S = stats(
    FIXED_DIR
)

CAND_REL_S = stats(
    CAND_REL
)

CAND_DIR_S = stats(
    CAND_DIR
)

print(
    f"FIXED rel      = "
    f"{FIXED_REL_S['mean']:.7f}"
)

print(
    f"CAND rel       = "
    f"{CAND_REL_S['mean']:.7f}"
)

print(
    f"FIXED dir cos  = "
    f"{FIXED_DIR_S['mean']:+.6f}"
)

print(
    f"CAND dir cos   = "
    f"{CAND_DIR_S['mean']:+.6f}"
)


# =============================================================================
# 24. DECISION LOGIC
#
# Conservative:
#
# A) First ask whether local oracle opportunity exists.
#
# B) Then ask whether one fixed correction generalizes.
#
# C) If oracle exists but fixed correction does NOT generalize,
#    state-conditioned branch becomes worth testing.
#
# This STILL does not prove h_l can predict the correction.
# That is TEST133.
# =============================================================================

print("\n[16/22] DECISION")
print("=" * 176)

# Best shell chosen by ORACLE mean only for system-ID description.
best_shell = max(
    SHELLS_DEG,
    key=lambda sh:
        SHELL_SUMMARY[
            str(sh)
        ]["oracle_delta"]["mean"],
)

BEST_ORACLE = (
    SHELL_SUMMARY[
        str(best_shell)
    ]["oracle_delta"]
)

BEST_SPLIT = (
    SPLIT_VALIDATION[
        str(best_shell)
    ]["heldout_delta"]
)

BEST_GAP = (
    ORACLE_GLOBAL_GAP[
        str(best_shell)
    ]["oracle_minus_global"]
)

BEST_REPEAT = (
    REPEATABILITY[
        str(best_shell)
    ]
)

print(
    f"Best descriptive shell : "
    f"{best_shell:.1f}°"
)

print(
    f"Oracle Δ               : "
    f"{BEST_ORACLE['mean']:+.6f} "
    f"{ci(BEST_ORACLE)}"
)

print(
    f"Split fixed Δ          : "
    f"{BEST_SPLIT['mean']:+.6f} "
    f"{ci(BEST_SPLIT)}"
)

print(
    f"Oracle-global gap      : "
    f"{BEST_GAP['mean']:+.6f} "
    f"{ci(BEST_GAP)}"
)

print(
    f"Opportunity repeat r   : "
    f"{BEST_REPEAT['mean_layer_correlation']:+.4f}"
)

# Conservative branch classification
oracle_exists = (
    BEST_ORACLE["mean"] > 0
    and BEST_ORACLE["ci95"][0] > 0
    and BEST_ORACLE["positive_fraction"] >= 0.70
)

fixed_generalizes = (
    BEST_SPLIT["mean"] > 0
    and BEST_SPLIT["ci95"][0] > 0
)

oracle_exceeds_global = (
    BEST_GAP["mean"] > 0
    and BEST_GAP["ci95"][0] > 0
)

repeatable_opportunity = (
    BEST_REPEAT[
        "mean_layer_correlation"
    ] > 0.10
)

if (
    oracle_exists
    and oracle_exceeds_global
    and not fixed_generalizes
):

    DECISION = (
        "STATE_CONDITIONED_CORRECTION_OPPORTUNITY"
    )

elif (
    oracle_exists
    and fixed_generalizes
):

    DECISION = (
        "FIXED_MICRO_CORRECTION_MAY_BE_SUFFICIENT"
    )

else:

    DECISION = (
        "NO_ROBUST_LOCAL_CORRECTION_OPPORTUNITY"
    )

print()

print("DECISION:")
print(DECISION)


# =============================================================================
# 25. NEXT BRANCH
# =============================================================================

print("\n[17/22] NEXT BRANCH")

if (
    DECISION
    == "STATE_CONDITIONED_CORRECTION_OPPORTUNITY"
):

