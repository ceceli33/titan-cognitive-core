    for li in SOURCE_LAYERS:

        # ---------------------------------------------------------------------
        # FIXED historical compass
        # ---------------------------------------------------------------------

        fixed = one_step_probe(
            prompt,
            base,
            li,
            DIBEK[li],
        )

        layer = {
            "FIXED": {
                "D_next":
                    fixed["D_next"],

                "D_old":
                    fixed["D_old"],

                "gain":
                    fixed["gain"],

                "realized_rel":
                    fixed["realized_rel"],

                "requested_dir_cos":
                    fixed["requested_dir_cos"],
            },

            "shells": {},
        }

        x_fixed = fixed["x"]

        # ---------------------------------------------------------------------
        # Each angle independently
        # ---------------------------------------------------------------------

        for shell in SHELLS_DEG:

            candidates = []

            for item in ATLAS[li][shell]:

                rr = one_step_probe(
                    prompt,
                    base,
                    li,
                    item["direction"],
                )

                realized_angle_to_fixed = (
                    angle_deg(
                        rr["x"],
                        x_fixed,
                    )
                )

                delta = (
                    rr["D_next"]
                    - fixed["D_next"]
                )

                candidates.append({
                    "candidate_id":
                        item["candidate_id"],

                    "requested_angle":
                        shell,

                    "realized_angle_to_fixed":
                        realized_angle_to_fixed,

                    "D_next":
                        rr["D_next"],

                    "D_old":
                        rr["D_old"],

                    "delta_vs_fixed":
                        delta,

                    "gain":
                        rr["gain"],

                    "realized_rel":
                        rr["realized_rel"],

                    "requested_dir_cos":
                        rr["requested_dir_cos"],
                })

            # Oracle within THIS shell only
            oracle = max(
                candidates,
                key=lambda z:
                    z["D_next"],
            )

            mean_delta = safe_mean([
                c["delta_vs_fixed"]
                for c in candidates
            ])

            layer["shells"][
                str(shell)
            ] = {
                "candidates":
                    candidates,

                "oracle_candidate_id":
                    oracle["candidate_id"],

                "oracle_D_next":
                    oracle["D_next"],

                "oracle_delta_vs_fixed":
                    oracle["delta_vs_fixed"],

                "mean_delta_vs_fixed":
                    mean_delta,

                "mean_realized_angle":
                    safe_mean([
                        c[
                            "realized_angle_to_fixed"
                        ]
                        for c in candidates
                    ]),
            }

        prow["layers"][str(li)] = layer

    RESULTS.append(prow)

    if (pi + 1) % 5 == 0:

        gc.collect()
        torch.cuda.empty_cache()

    print(
        f"  {pi+1:02d}/{len(PROMPTS)} "
        f"| elapsed="
        f"{(time.time()-start)/60:.1f}m",
        end="\r",
    )

print()

print(
    f"Experiment completed in "
    f"{(time.time()-start)/60:.1f} min"
)


# =============================================================================
# 14. REALIZED ANGLE AUDIT
# =============================================================================

print("\n[6/22] BF16 realized-angle audit...")

ANGLE_AUDIT = {}

for shell in SHELLS_DEG:

    vals = []

    for row in RESULTS:

        for li in SOURCE_LAYERS:

            vals.extend([
                c["realized_angle_to_fixed"]
                for c in
                row["layers"][str(li)]
                ["shells"][str(shell)]
                ["candidates"]
            ])

    s = stats(vals)

    ANGLE_AUDIT[str(shell)] = s

    print(
        f"Requested {shell:>4.1f}° "
        f"-> realized "
        f"{s['mean']:.4f}° "
        f"± {s['sd']:.4f}° "
        f"| range "
        f"{s['min']:.4f}.."
        f"{s['max']:.4f}"
    )


# =============================================================================
# 15. SHELL-WISE ORACLE ANALYSIS
#
# NO cross-angle pooling.
# =============================================================================

print("\n[7/22] Shell-wise oracle analysis...")

SHELL_SUMMARY = {}

for shell in SHELLS_DEG:

    oracle_delta = []
    mean_delta = []

    for row in RESULTS:

        for li in SOURCE_LAYERS:

            sh = (
                row["layers"][str(li)]
                ["shells"][str(shell)]
            )

            oracle_delta.append(
                sh[
                    "oracle_delta_vs_fixed"
                ]
            )

            mean_delta.append(
