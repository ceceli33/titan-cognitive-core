        R_(f"    {ad:<18} fil={d['fil']:.1f}  boz={d['bozulma']:.3f}  "
           f"oran@L0=%{d['oran_L0']*100:.2f}")
if ok("08_FIL_i0.10") and ok("00_taban"):
    f1=max(RES[a]["fil"] for a in ["08_FIL_i0.10","09_FIL_i0.15"] if ok(a))
    R_("    "+("✅ BORU SAĞLAM — fil taşındı, yöntem çalışıyor"
               if f1 > RES["00_taban"]["fil"]+1.0 else
               "❌ fil hâlâ taşınmıyor — sorun enjeksiyon miktarında değil"))

R_("\n"+"="*78); R_("  SORU 4: ETKİ GERÇEK Mİ? (negatif kontrolden ayrışma)"); R_("="*78)
for ad in ["03_dibek_i0.10","10_rastgele_i0.10","12_CIFT_sentetik_i0.10"]:
    if ok(ad):
        d=RES[ad]
        R_(f"    {ad:<26} maymun={d['maymun']:.1f} boz={d['bozulma']:.3f} "
           f"red={d['red']:.1f}")
if ok("03_dibek_i0.10") and ok("10_rastgele_i0.10"):
    dk,rk = RES["03_dibek_i0.10"]["maymun"], RES["10_rastgele_i0.10"]["maymun"]
    R_("    "+("✅ dibek rastgeleden AYRIŞIYOR — etki yöne özgü"
               if dk > rk+1.0 else
               "⚠️ dibek rastgeleden ayrışmıyor — gözlenen fark yöne özgü değil"))

R_("\n"+"="*78); R_("  ÖRNEK METİNLER (ilk 420 karakter)"); R_("="*78)
_goster=["00_taban","03_dibek_i0.10","04_dibek_i0.15","06_dibek_i0.15_FRENSIZ",
