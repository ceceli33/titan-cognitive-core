def get_layer_metric(
    arm,
    layer_idx,
    metric
):

    return np.asarray(
        [
            item[
                arm
            ][
                "semantic_layers"
            ][
                layer_idx
            ][
                metric
            ]
            for item in RESULTS
        ],
        dtype=np.float64
    )


def get_local_metric(
    arm,
    layer_idx,
    metric
):

    return np.asarray(
        [
            item[
                arm
            ][
                "local_intervention"
            ][
                str(layer_idx)
            ][
                metric
            ]
            for item in RESULTS
        ],
        dtype=np.float64
    )


