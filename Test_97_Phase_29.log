# 14. RUN 40 PROMPTS
# =============================================================================

print(
    "\n[5/15] 40 prompt için BASELINE / ABOVE / BELOW trajectories çalıştırılıyor..."
)


RESULTS = []


for prompt_idx, prompt in enumerate(
    PROMPTS
):

    family = FAMILIES[
        prompt_idx // 8
    ]


    baseline = trajectory_forward(
        prompt,
        vectors=None,
        arm_name="BASELINE"
    )


    above = trajectory_forward(
        prompt,
        vectors=IND_ABOVE,
        arm_name="ABOVE"
    )


    below = trajectory_forward(
        prompt,
        vectors=IND_BELOW,
        arm_name="BELOW"
    )


    above_analysis = analyze_arm(
        baseline,
        above,
        "ABOVE"
    )


    below_analysis = analyze_arm(
        baseline,
        below,
        "BELOW"
    )


    dds_ab = (
        above[
            "readout"
        ][
            "AB"
        ]
        -
        below[
            "readout"
        ][
            "AB"
        ]
    )


    dds_ou = (
        above[
            "readout"
        ][
            "OU"
        ]
        -
        below[
            "readout"
        ][
            "OU"
        ]
    )


    RESULTS.append({

        "prompt_index":
            int(
                prompt_idx + 1
            ),

        "family":
            family,

        "prompt":
            prompt,

        "baseline_readout":
            baseline[
                "readout"
            ],

        "above_readout":
            above[
                "readout"
            ],

        "below_readout":
            below[
                "readout"
            ],

        "DDS_AB":
            float(dds_ab),

        "DDS_OU":
            float(dds_ou),

        "ABOVE":
            above_analysis,

        "BELOW":
            below_analysis,

        "ABOVE_telemetry":
            above[
                "telemetry"
            ],

        "BELOW_telemetry":
            below[
                "telemetry"
            ],
    })


    print(
        f"{prompt_idx+1:02d}/40 | "
        f"{family:<22} | "
        f"DDS_AB={dds_ab:+.6f} | "
        f"DDS_OU={dds_ou:+.6f}",
        end="\r"
    )


print(
