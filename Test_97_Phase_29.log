# =============================================================================
# 10. DRA
# =============================================================================

def dra_parameters(
    cosine_value,
    layer_idx
):

    uncertainty = (
        1.0
        -
        abs(cosine_value)
    )


    dw = (
        SONUM
        +
        uncertainty
        * 0.20
    )


    t = float(layer_idx)


    kb = (
        ZIRVE
        *
        math.exp(
            -dw * t
        )
        *
        (
            1.0
            +
            dw * t
        )
        +
        TABAN
    )


    envelope = (
        kb
        /
        (
            ZIRVE
            +
            TABAN
        )
    )


    if cosine_value > COS_BRAKE_HIGH:

        brake = (
            (
                1.0
                -
                cosine_value
            )
            /
            BRAKE_HIGH_DENOM
        )

    elif cosine_value < COS_BRAKE_LOW:

        brake = BRAKE_LOW_GAIN

    else:

        brake = 1.0


    return (
        envelope,
        brake
    )


# =============================================================================
# 11. FP32 FINAL READOUT
# =============================================================================

def qwen_rmsnorm_fp32(
    hidden_fp32
):

    norm_module = model.model.norm

    weight = (
        norm_module.weight
        .detach()
        .float()
    )

    eps = float(
        norm_module.variance_epsilon
    )


    variance = (
        hidden_fp32
        .pow(2)
        .mean(
            dim=-1,
            keepdim=True
        )
    )


    normalized = (
        hidden_fp32
        *
        torch.rsqrt(
            variance + eps
        )
    )


    return normalized * weight


@torch.no_grad()
def hp_target_logits(
    final_hidden_last
):

    h = final_hidden_last.float()

    h_norm = qwen_rmsnorm_fp32(
        h
    )


    target_weights = (
        model.lm_head.weight[
            TARGET_ID_LIST
        ]
        .detach()
        .float()
    )


    logits = torch.matmul(
        target_weights,
        h_norm
    )


    return {
        "above": float(logits[0].cpu()),
        "below": float(logits[1].cpu()),
        "over": float(logits[2].cpu()),
        "under": float(logits[3].cpu()),
    }


def make_readout(
    logits
):

    return {
        "AB": float(
            logits["above"]
            -
            logits["below"]
        ),

        "OU": float(
            logits["over"]
            -
            logits["under"]
        ),
    }


# =============================================================================
# 12. FULL TRAJECTORY FORWARD
# =============================================================================

@torch.no_grad()
def trajectory_forward(
    prompt,
    vectors=None,
    arm_name="BASELINE"
):

    # -------------------------------------------------------------------------
    # layer_input[l]
    #     input residual stream entering transformer layer l
    #
    # layer_pre[l]
    #     raw transformer layer output BEFORE steering hook modification
    #
    # layer_post[l]
    #     actual output leaving layer after optional steering
    #
    # -------------------------------------------------------------------------

    layer_input = [
        None
        for _ in range(MODEL_LAYERS)
    ]

    layer_pre = [
        None
        for _ in range(MODEL_LAYERS)
    ]

    layer_post = [
        None
        for _ in range(MODEL_LAYERS)
    ]


    telemetry = []


    final_capture = {
        "hidden": None
    }


    handles = []


    # -------------------------------------------------------------------------
    # INPUT PRE-HOOK
    # -------------------------------------------------------------------------

    def make_input_hook(
        layer_idx
    ):

        def pre_hook(
            module,
            inputs
        ):

            h = inputs[0]

            layer_input[
                layer_idx
            ] = (
                h[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .numpy()
                .astype(np.float64)
            )

        return pre_hook


    # -------------------------------------------------------------------------
    # OUTPUT + STEERING HOOK
    # -------------------------------------------------------------------------

    def make_output_hook(
        layer_idx
    ):

        def hook(
            module,
            inputs,
            output
        ):

            hidden = (
                output[0]
                if isinstance(output, tuple)
                else output
            )


            # -------------------------------------------------------------
            # PRE-STEERING layer output
            # -------------------------------------------------------------

            pre_last = (
                hidden[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .numpy()
                .astype(np.float64)
            )


            layer_pre[
                layer_idx
            ] = pre_last


            hidden_new = hidden


            # -------------------------------------------------------------
            # APPLY DRA ONLY L10/L11
            # -------------------------------------------------------------

            if (
                vectors is not None
                and
                layer_idx in ACTIVE_LAYERS
            ):

                vector = (
                    torch.as_tensor(
                        vectors[
                            layer_idx
                        ],
                        device=hidden.device,
                        dtype=hidden.dtype,
                    )
                    .unsqueeze(0)
                )


                h = hidden[
                    :,
                    -1,
                    :
                ]


                h_norm = (
                    torch.linalg.norm(
                        h,
                        dim=-1,
                        keepdim=True
                    )
                )


                v_norm = (
                    torch.linalg.norm(
                        vector,
                        dim=-1,
                        keepdim=True
                    )
                )


                cosine = (
                    torch.sum(
                        h * vector,
                        dim=-1,
                        keepdim=True
                    )
                    /
                    (
                        h_norm
                        *
                        v_norm
                        +
                        1e-12
                    )
                )


                cosine_value = float(
                    cosine
                    .mean()
                    .detach()
                    .cpu()
                )


                envelope, brake = (
                    dra_parameters(
                        cosine_value,
                        layer_idx
                    )
                )


                contribution = (
                    IVME
                    *
                    h_norm
                    /
                    SQRT_K
                    *
                    envelope
                    *
                    brake
                )


                delta = (
                    contribution
                    *
                    vector
                )


                hidden_new = hidden.clone()


                hidden_new[
                    :,
                    -1,
                    :
                ] = (
                    hidden_new[
                        :,
                        -1,
                        :
                    ]
                    +
                    delta
                )


                delta_norm = (
                    torch.linalg.norm(
                        delta,
                        dim=-1
                    )
                )


                relative_delta = (
                    delta_norm
                    /
                    (
                        h_norm.squeeze(-1)
                        +
                        1e-12
                    )
                )


                telemetry.append({
                    "arm": arm_name,
                    "layer": int(layer_idx),
                    "cosine": cosine_value,
                    "envelope": float(envelope),
                    "brake": float(brake),
                    "contribution": float(
                        contribution
                        .mean()
                        .detach()
                        .cpu()
                    ),
                    "direct_delta_norm": float(
                        delta_norm
                        .mean()
                        .detach()
                        .cpu()
                    ),
                    "direct_relative_delta": float(
                        relative_delta
                        .mean()
                        .detach()
                        .cpu()
                    ),
                })


            # -------------------------------------------------------------
            # POST-STEERING ACTUAL OUTPUT
            # -------------------------------------------------------------

            post_last = (
                hidden_new[
                    0,
                    -1,
                    :
                ]
                .detach()
                .float()
                .cpu()
                .numpy()
                .astype(np.float64)
            )


            layer_post[
                layer_idx
            ] = post_last


            if isinstance(output, tuple):

                return (
                    hidden_new,
                    *output[1:]
                )


            return hidden_new


        return hook


    # -------------------------------------------------------------------------
    # REGISTER
    # -------------------------------------------------------------------------

    for layer_idx in range(
        MODEL_LAYERS
    ):

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_pre_hook(
                make_input_hook(
                    layer_idx
                )
            )
        )

        handles.append(
            model.model.layers[
                layer_idx
            ].register_forward_hook(
                make_output_hook(
                    layer_idx
                )
            )
        )


    # -------------------------------------------------------------------------
    # FINAL NORM PRE-HOOK
    # -------------------------------------------------------------------------

    def final_norm_pre_hook(
        module,
        inputs
    ):

        final_capture[
            "hidden"
        ] = (
            inputs[0]
            .detach()
        )


    final_handle = (
        model.model.norm
        .register_forward_pre_hook(
            final_norm_pre_hook
        )
    )


    # -------------------------------------------------------------------------
    # FORWARD
    # -------------------------------------------------------------------------

    encoded = tokenizer(
        prompt,
        return_tensors="pt"
    ).to(
        model.device
    )


    try:

        _ = model(
            **encoded,
            use_cache=False
        )


        final_hidden = (
            final_capture[
                "hidden"
            ][
                0,
                -1,
                :
            ]
        )


        logits = hp_target_logits(
            final_hidden
        )


        readout = make_readout(
            logits
        )


    finally:

        for handle in handles:
            handle.remove()

        final_handle.remove()


    return {
        "layer_input": layer_input,
        "layer_pre": layer_pre,
        "layer_post": layer_post,
        "telemetry": telemetry,
        "logits": logits,
        "readout": readout,
    }


# =============================================================================
# 13. SYSTEM IDENTIFICATION METRICS
# =============================================================================

def analyze_arm(
    baseline,
    steered,
    arm
):

    assert arm in (
        "ABOVE",
        "BELOW"
    )


    target_sign = (
        +1.0
        if arm == "ABOVE"
        else -1.0
    )


    rows = []


    # -------------------------------------------------------------------------
    # Semantic trajectory L0–L19
    # -------------------------------------------------------------------------

    for layer_idx in range(
        VECTOR_LAYERS
    ):

        h0 = baseline[
            "layer_post"
        ][
            layer_idx
        ]


        hs = steered[
            "layer_post"
        ][
            layer_idx
        ]


        sep = SEPARATOR[
            layer_idx
        ].astype(np.float64)


        com = COMMON[
            layer_idx
        ].astype(np.float64)


        # ---------------------------------------------------------------------
        # Coordinates
        # ---------------------------------------------------------------------

        e0 = cosine_np(
            h0,
            sep
        )

        es = cosine_np(
            hs,
            sep
        )


        c0 = cosine_np(
            h0,
            com
        )

        cs = cosine_np(
            hs,
            com
        )


        delta_e = (
            es
            -
            e0
        )


        delta_common = (
            cs
            -
            c0
        )


        # ---------------------------------------------------------------------
        # Physical trajectory displacement
        # ---------------------------------------------------------------------

        physical_delta = (
            hs
            -
            h0
        )


        physical_delta_norm = float(
            np.linalg.norm(
                physical_delta
            )
        )


        baseline_norm = float(
            np.linalg.norm(
                h0
            )
        )


        relative_physical = (
            physical_delta_norm
            /
            (
                baseline_norm
                +
                EPS
            )
        )


        # ---------------------------------------------------------------------
        # Response
        # ---------------------------------------------------------------------

        response = (
            delta_e
            /
            (
                relative_physical
                +
                EPS
            )
        )


        target_aligned_delta = (
            target_sign
            *
            delta_e
        )


        target_response = (
            target_aligned_delta
            /
            (
                relative_physical
                +
                EPS
            )
        )


        rows.append({
            "layer": int(layer_idx),

            "baseline_separator_cos":
                float(e0),

            "steered_separator_cos":
                float(es),

            "delta_separator":
                float(delta_e),

            "target_aligned_delta_separator":
                float(target_aligned_delta),

            "baseline_common_cos":
                float(c0),

            "steered_common_cos":
                float(cs),

            "delta_common":
                float(delta_common),

            "physical_delta_norm":
                float(physical_delta_norm),

            "baseline_hidden_norm":
                float(baseline_norm),

            "relative_physical_delta":
                float(relative_physical),

            "response_R":
                float(response),

            "target_response_R":
                float(target_response),
        })


    # -------------------------------------------------------------------------
    # Transmission
    # -------------------------------------------------------------------------

    for layer_idx in range(
        VECTOR_LAYERS
    ):

        if layer_idx == 0:

            rows[
                layer_idx
            ][
                "transmission_raw_from_prev"
            ] = None

            rows[
                layer_idx
            ][
                "transmission_stable_from_prev"
            ] = None

        else:

            prev = rows[
                layer_idx - 1
            ][
                "delta_separator"
            ]

            curr = rows[
                layer_idx
            ][
                "delta_separator"
            ]


            signed_eps = (
                EPS
                if prev >= 0
                else -EPS
            )


            raw_t = (
                curr
                /
                (
                    prev
                    +
                    signed_eps
                )
            )


            stable_t = (
                safe_signed_transmission(
                    prev,
                    curr,
                    EPS
                )
            )


            rows[
                layer_idx
            ][
                "transmission_raw_from_prev"
            ] = float(raw_t)


            rows[
                layer_idx
            ][
                "transmission_stable_from_prev"
            ] = float(stable_t)


    # -------------------------------------------------------------------------
    # Survival relative to L11
    # -------------------------------------------------------------------------

    reference_layer = 11

    reference_delta = rows[
        reference_layer
    ][
        "delta_separator"
    ]


    for layer_idx in range(
        VECTOR_LAYERS
    ):

        delta = rows[
            layer_idx
        ][
            "delta_separator"
        ]


        rows[
            layer_idx
        ][
            "absolute_survival_vs_L11"
        ] = float(
            abs(delta)
            /
            (
                abs(reference_delta)
                +
                EPS
            )
        )


        rows[
            layer_idx
        ][
            "signed_survival_vs_L11"
        ] = float(
            delta
            /
            (
                reference_delta
                +
                (
                    EPS
                    if reference_delta >= 0
                    else -EPS
                )
            )
        )


    # -------------------------------------------------------------------------
    # Local direct intervention at L10/L11
    #
    # IMPORTANT:
    #
    # steered.layer_pre  = before injection
    # steered.layer_post = after injection
    #
    # This is different from trajectory delta vs baseline.
    # -------------------------------------------------------------------------

    local = {}


    for layer_idx in ACTIVE_LAYERS:

        pre = steered[
            "layer_pre"
        ][
            layer_idx
        ]


        post = steered[
            "layer_post"
        ][
            layer_idx
        ]


        direct_delta = (
            post
            -
            pre
        )


        direct_rel = (
            np.linalg.norm(
                direct_delta
            )
            /
            (
                np.linalg.norm(
                    pre
                )
                +
                EPS
            )
        )


        sep = SEPARATOR[
            layer_idx
        ].astype(np.float64)


        pre_e = cosine_np(
            pre,
            sep
        )


        post_e = cosine_np(
            post,
            sep
        )


        direct_delta_e = (
            post_e
            -
            pre_e
        )


        direct_R = (
            direct_delta_e
            /
            (
                direct_rel
                +
                EPS
            )
        )


        direct_target_R = (
            target_sign
            *
            direct_delta_e
            /
            (
                direct_rel
                +
                EPS
            )
        )


        local[
            str(layer_idx)
        ] = {

            "pre_separator_cos":
                float(pre_e),

            "post_separator_cos":
                float(post_e),

            "direct_delta_separator":
                float(direct_delta_e),

            "target_aligned_direct_delta_separator":
                float(
                    target_sign
                    *
                    direct_delta_e
                ),

            "direct_relative_physical_delta":
                float(direct_rel),

            "direct_response_R":
                float(direct_R),

            "direct_target_response_R":
                float(direct_target_R),
        }


    # -------------------------------------------------------------------------
    # Full physical propagation L0–L27
    # -------------------------------------------------------------------------

    physical_all_layers = []


    for layer_idx in range(
        MODEL_LAYERS
    ):

        h0 = baseline[
            "layer_post"
        ][
            layer_idx
        ]


        hs = steered[
            "layer_post"
        ][
            layer_idx
        ]


        diff = (
            hs
            -
            h0
        )


        diff_norm = float(
            np.linalg.norm(
                diff
            )
        )


        base_norm = float(
            np.linalg.norm(
                h0
            )
        )


        rel = (
            diff_norm
            /
            (
                base_norm
                +
                EPS
            )
        )


        physical_all_layers.append({

            "layer":
                int(layer_idx),

            "physical_delta_norm":
                diff_norm,

            "baseline_hidden_norm":
                base_norm,

            "relative_physical_delta":
                float(rel),
        })


    return {
        "semantic_layers": rows,
        "local_intervention": local,
        "physical_all_layers": physical_all_layers,
    }


