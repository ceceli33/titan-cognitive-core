# =============================================================================
# 25. EMPIRICAL NULL ANALYSIS
# =============================================================================

def empirical_null_analysis(
    observed,
    null_values
):

    null_values = np.asarray(
        null_values,
        dtype=np.float64
    )


    n = len(
        null_values
    )


    n_ge = int(
        np.sum(
            null_values
            >= observed
        )
    )


    n_abs_ge = int(
        np.sum(
            np.abs(
                null_values
            )
            >= abs(
                observed
            )
        )
    )


    n_less = int(
        np.sum(
            null_values
            < observed
        )
    )


    percentile = (
        100.0
        * n_less
        / n
    )


    upper_tail_plus1 = (

        n_ge + 1

    ) / (

        n + 1
    )


    two_sided_plus1 = (

        n_abs_ge + 1

    ) / (

        n + 1
    )


    return {

        "observed":
            float(
                observed
            ),

        "null_n":
            int(n),

        "null_mean":
            float(
                null_values.mean()
            ),

        "null_median":
            float(
                np.median(
                    null_values
                )
            ),

        "null_std":
            safe_std(
                null_values
            ),

        "null_min":
            float(
                null_values.min()
            ),

        "null_max":
            float(
                null_values.max()
            ),

        "null_ge_observed_count":
            n_ge,

        "null_abs_ge_observed_count":
            n_abs_ge,

        "observed_percentile":
            float(
                percentile
            ),

        "upper_tail_fraction_plus1":
            float(
                upper_tail_plus1
            ),

        "two_sided_magnitude_fraction_plus1":
            float(
                two_sided_plus1
            ),
    }


SEMANTIC_MEAN_AB = float(
    SEMANTIC_DDS_AB.mean()
)


SEMANTIC_MEAN_OU = float(
    SEMANTIC_DDS_OU.mean()
)


