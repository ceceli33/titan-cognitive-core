# =============================================================================
# 5. BASIC HELPERS
# =============================================================================

def normalize_np(
    vector,
    eps=1e-12
):

    vector = np.asarray(
        vector,
        dtype=np.float32
    )

    norm = np.linalg.norm(
        vector
    )

    if norm < eps:

        return vector.copy()

    return (
        vector
        / norm
    )


def cosine_np(
    a,
    b,
    eps=1e-12
):

    a = np.asarray(
        a,
        dtype=np.float32
    )

    b = np.asarray(
        b,
        dtype=np.float32
    )


    na = np.linalg.norm(a)
    nb = np.linalg.norm(b)


    if (
        na < eps
        or
        nb < eps
    ):

        return 0.0


    return float(
        np.dot(a, b)
        /
        (na * nb)
    )


def sign_counts(
    values,
    eps=0.0
):

    values = np.asarray(
        values,
        dtype=np.float64
    )


    positive = int(
        np.sum(
            values > eps
        )
    )

    negative = int(
        np.sum(
            values < -eps
        )
    )

    zero = int(
        len(values)
        - positive
        - negative
    )


    return {
        "positive": positive,
        "negative": negative,
        "zero": zero,
    }


def safe_std(values):

    values = np.asarray(
        values,
        dtype=np.float64
    )

    if len(values) < 2:

        return 0.0

    return float(
        np.std(
            values,
            ddof=1
        )
    )


