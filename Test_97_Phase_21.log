def telemetry_summary(
    telemetry_groups
):

    flattened = []


    for item in (
        telemetry_groups
    ):

        if isinstance(
            item,
            list
        ):

            flattened.extend(
                item
            )

        else:

            flattened.append(
                item
            )


    keys = [

        "mean_cos",

        "mean_abs_cos",

        "mean_contribution",

        "mean_envelope",

        "mean_brake",
    ]


    output = {}


    for key in keys:

        values = np.asarray(
            [
                row[key]
                for row in flattened
            ],
            dtype=np.float64
        )


        output[key] = {

            "mean":
                float(
                    values.mean()
                ),

            "std":
                safe_std(
                    values
                ),

            "min":
                float(
                    values.min()
                ),

            "max":
                float(
                    values.max()
                ),
        }


    return output


