# =============================================================================
# 24. PAIRED BOOTSTRAP
# =============================================================================

def paired_bootstrap(
    values,
    n_boot,
    seed
):

    values = np.asarray(
        values,
        dtype=np.float64
    )


    rng = (
        np.random.default_rng(
            seed
        )
    )


    n = len(
        values
    )


    bootstrap_means = np.empty(
        n_boot,
        dtype=np.float64
    )


    for idx in range(
        n_boot
    ):

        sample_indices = (
            rng.integers(
                0,
                n,
                size=n
            )
        )


        bootstrap_means[
            idx
        ] = (
            values[
                sample_indices
            ]
            .mean()
        )


    return {

        "observed_mean":
            float(
                values.mean()
            ),

        "bootstrap_mean":
            float(
                bootstrap_means.mean()
            ),

        "ci95_lower":
            float(
                np.percentile(
                    bootstrap_means,
                    2.5
                )
            ),

        "ci95_upper":
            float(
                np.percentile(
                    bootstrap_means,
                    97.5
                )
            ),

        "n_bootstrap":
            int(
                n_boot
            ),
    }


