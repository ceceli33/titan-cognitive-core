# =============================================================================
# TEST 102 — SEÇİLMİŞ KATMAN ÇİFTLERİNİN 3 OTURUMLU TEKRARLANABİLİRLİK TESTİ
# =============================================================================
# Amaç:
# TEST 101'de görülen katman çiftlerinin davranışsal etkisinin
# bağımsız model yüklemelerinde tekrar edip etmediğini ölçmek.
#
# Aday çiftler:
#   L2+L3   -> güçlü pozitif ayrışma örneği
#   L10+L11 -> ikinci pozitif ayrışma örneği
#   L8+L9   -> orta/negatif ayrışma örneği
#   L0+L1   -> ters ayrışma örneği
#   L16+L17 -> ters ayrışma örneği
#
# HER OTURUM:
#   BASELINE
#   ABOVE_IND
#   BELOW_IND
#
# 3 bağımsız model yüklemesi
# Aynı model / tokenizer / prompt / seed / DRA
# IVME = 0.10
#
# ÖNEMLİ:
# Bu test hiçbir "başarı eşiği" dayatmaz.
# Amaç gözlenen etkinin oturumlar arasında tekrarlanıp tekrarlanmadığını
# ve prompt bazında ne kadar tutarlı olduğunu ölçmektir.
# =============================================================================

import os
import gc
import json
import math
import random
import time
import re
from collections import Counter

import numpy as np
import torch

from transformers import AutoTokenizer, AutoModelForCausalLM


# =============================================================================
# 0) SABİTLER
# =============================================================================

MODEL_NAME = "Qwen/Qwen2.5-7B-Instruct"

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
DTYPE = torch.bfloat16

SEED = 42

N_LAYERS = 20
HIDDEN = 3584

IVME = 0.10

# TEST 101 ile aynı
SQRT_K = math.sqrt(N_LAYERS)

SONUM = 0.30
ZIRVE = 0.70
TABAN = 0.20

COS_BRAKE_HIGH = 0.75
COS_BRAKE_LOW = -0.40

BRAKE_HIGH_DENOM = 0.25
BRAKE_LOW_GAIN = 1.60

# 3 bağımsız model yüklemesi
N_SESSIONS = 3

# TEST 101'de seçilen katman çiftleri
LAYER_PAIRS = [
    (2, 3),
    (10, 11),
    (8, 9),
    (0, 1),
    (16, 17),
]

# =============================================================================
# 1) AYNI TEST 99 EĞİTİM VERİSİ
# =============================================================================

ABOVE_TRAIN = [
    "a person standing above a bridge",
    "a person positioned above a tower",
    "an object located above the roof",
    "a bird flying above the mountain",
    "a light appearing above the building",
    "a person looking from above the valley",
    "a structure extending above the wall",
    "a signal coming from above the surface",
]

BELOW_TRAIN = [
    "a person standing below a bridge",
    "a person positioned below a tower",
    "an object located below the roof",
    "a bird flying below the mountain",
    "a light appearing below the building",
    "a person looking from below the valley",
    "a structure extending below the wall",
    "a signal coming from below the surface",
]

NEUTRAL_TRAIN = [
    "a person standing beside a bridge",
    "a person positioned near a tower",
    "an object located near the roof",
    "a bird flying near the mountain",
    "a light appearing near the building",
    "a person looking across the valley",
    "a structure extending beside the wall",
    "a signal coming across the surface",
]


# =============================================================================
# 2) AYNI 8 DAVRANIŞ PROMPTU
# =============================================================================

